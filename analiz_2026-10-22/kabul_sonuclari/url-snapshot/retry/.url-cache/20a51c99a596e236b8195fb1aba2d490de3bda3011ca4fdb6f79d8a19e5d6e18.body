					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="nl" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><table class="infobox" cellpadding="1" cellspacing="1" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox stadion\n","href":"./Sjabloon:Infobox_stadion"},"params":{"afbeelding":{"wt":"Jan Louwers Stadion_1.jpg"},"naam stadion":{"wt":"Jan Louwers Stadion"},"naam":{"wt":"Jan Louwers Stadion"},"bijnaam":{"wt":""},"plaats":{"wt":"[[Eindhoven]]"},"capaciteit":{"wt":"4.200"},"bespelers":{"wt":"[[FC Eindhoven]], [[Jong PSV]]"},"adres":{"wt":"Charles Roelslaan 1, Eindhoven"},"opening":{"wt":"zaterdag 27 augustus 1994"},"eigenaar":{"wt":"Gemeente Eindhoven"},"Ondergrond":{"wt":"[[kunstgras]]"},"vorigenamen":{"wt":"Aalsterweg (1934–1994)"}},"i":0}}]}'> 
