<li about="#cite_note-2" id="cite_note-2" data-mw-footnote-number="2"><span class="mw-cite-backlink" id="mwMA"><a href="#cite_ref-2" rel="mw:referencedBy" id="mwMQ"><span class="mw-linkback-text" id="mwMg">↑</span></a></span> <span id="mw-reference-text-cite_note-2" class="mw-reference-text reference-text"><span class="citation" about="#mwt3" typeof="mw:Transclusion" id="mwMw" data-mw='{"parts":[{"template":{"target":{"wt":"Citeer web","href":"./Sjabloon:Citeer_web"},"params":{"url":{"wt":"https://www.transfermarkt.nl/fc-eindhoven/besucherzahlenentwicklung/verein/3892"},"titel":{"wt":"FC Eindhoven - Ontwikkeling toeschouwersaantallen"},"bezochtdatum":{"wt":"2022-05-19"},"werk":{"wt":"www.transfermarkt.nl"},"taal":{"wt":"nl"}},"i":0}}]}'><a rel="mw:ExtLink nofollow" href="https://www.transfermarkt.nl/fc-eindhoven/besucherzahlenentwicklung/verein/3892" class="external text" id="mwNA">FC Eindhoven - Ontwikkeling toeschouwersaantallen</a>.<span typeof="mw:Entity" id="mwNQ"> </span><i id="mwNg">www.transfermarkt.nl</i>.<span typeof="mw:Entity" id="mwNw"> </span>Geraadpleegd op <span class="mw-formatted-date" title="2022-05-19" id="mwOA">19 mei 2022</span>.    </span></span></li>
