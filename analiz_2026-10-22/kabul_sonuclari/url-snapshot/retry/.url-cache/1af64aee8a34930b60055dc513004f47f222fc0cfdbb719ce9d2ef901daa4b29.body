  <section class="t-layout t-layout--theme-white">
    <div class="t-container u-pt--collapse">
      
      

                    <h1>Energie</h1>

                
                          <div class="h-font-weight-bold">  <p>De ACM houdt toezicht op de energiemarkt. Bekijk de belangrijkste regels voor energieleveranciers en rechten van zakelijke afnemers.</p>
</div>
                  </div>
          
  



  




  <div data-theme="white" class="t-layout t-layout--theme-white u-pt--collapse">
    <div class="t-container">
      
                    
  




  <div class="h-flow-space--large">
    <ul class="t-grid t-grid--cols-full-height u-list--bare">
                    <li class="t-grid__col h-flow t-grid__col--12 t-grid__col--6@small t-grid__col--4@medium">

                    







  


<div data-theme="outline" class="m-card m-card--is-clickable js-clickable m-card--theme-outline">
  <div class="m-card__main">
    <div class="m-card__content">
              
                  <h2 class="m-card__title h-underline-links">
                          <a href="/nl/energie/elektriciteit-en-gas" class="js-clickable__target">Elektriciteit en gas</a>
                      </h2>
        
        
      
      
              <div class="m-card__body">              <div class="h-inverted-links h-flow">
                Tarieven, rechten afnemers, netbeheerkosten, opzegvergoeding, aansluiting, tariefwijziging als leverancier, verkoop, groothandelsmarkt
              </div>
            </div>
      
          </div>

      </div>

  </div>

        </li>
