.net\u002Fmedia\u002Fpages\u002Fmission\u002Fhome\u002Fae567b7b18-1742293351\u002F2.-jphb20220709138-mediumres-2560x.webp 2560w, https:\u002F\u002Fcms.nextnature.net\u002Fmedia\u002Fpages\u002Fmission\u002Fhome\u002Fae567b7b18-1742293351\u002F2.-jphb20220709138-mediumres-3840x.webp 3840w",[],[283,311,335,375,418,457,502,533,561,590,610,634,653,676,695,740,760,783,801,827,847,991],{"attrs":284,"columns":287,"id":310},{"layout_id":9,"class":9,"layout_background":132,"layout_text_color":132,"column_colors":132,"reverse":285,"column_height":9,"margin_top":275,"margin_bottom":286},"left","true",[288],{"blocks":289,"id":308,"width":309},[290,296,303],{"content":291,"id":294,"isHidden":50,"type":295},{"level":292,"text":293,"class":9,"alignment":285},"h2","Hallo aardbewoner","65018951-9ed6-437b-bf0a-bc1cb6a1280e","heading",{"content":297,"id":301,"isHidden":50,"type":302},{"text":298,"class":9,"alignment":285,"resolved":299},"\u003Cp>De planeet is aan het veranderen. Klimaatverandering, kunstmatige intelligentie, verstedelijking. Menselijke aanwezigheid is alom voelbaar. Next Nature vertelt het verhaal van de mens die haar wereld verandert met de vruchten van kennis, design en technologie. Wij zijn open, hoopvolle, toekomstgerichte mensen die niet terug, maar \u003Cem>vooruit\u003C\u002Fem> naar de natuur willen. We maken wereldwijd impact, met leden in 44 landen. In ons \u003Cu>\u003Ca href=\"\u002Fnl\u002F@\u002Fpage\u002FNnT4JogFfIWqKZMA\" target=\"_blank\">toekomstmuseum\u003C\u002Fa>\u003C\u002Fu> in Eindhoven, ervaar je de visie in ‘real life’.\u003C\u002Fp>",{"text":300},"\u003Cp>De planeet is aan het veranderen. Klimaatverandering, kunstmatige intelligentie, verstedelijking. Menselijke aanwezigheid is alom voelbaar. Next Nature vertelt het verhaal van de mens die haar wereld verandert met de vruchten van kennis, design en technologie. Wij zijn open, hoopvolle, toekomstgerichte mensen die niet terug, maar \u003Cem>vooruit\u003C\u002Fem> naar de natuur willen. We maken wereldwijd impact, met leden in 44 landen. In ons \u003Cu>\u003Ca href=\"\u002Fnl\u002Fmuseum\u002Fon-show\" target=\"_blank\">toekomstmuseum\u003C\u002Fa>\u003C\u002Fu> in Eindhoven, ervaar je de visie in ‘real life’.\u003C\u002Fp>","8f9d3034-1d22-4cb6-8fdb-748c591edc2c","text",{"content":304,"id":306,"isHidden":50,"type":307},{"class":9,"height":305},2,"3ce89081-645e-44d1-8797-4c9eaae38f90","spacer","61980e91-55d9-4728-a658-9497b38859e3","1\u002F1","b35a329d-8ed2-4c5a-a250-0125e57f78e0",{"attrs":312,"columns":313,"id":334},{"layout_id":9,"class":9,"layout_background":132,"layout_text_color":132,"column_colors":132,"reverse":285,"column_height":9,"margin_top":275,"margin_bottom":286},[314],{"blocks":315,"id":333,"width":309},[316],{"content":317,"id":332,"isHidden":50,"type":262},{"location":318,"image":319,"src":9,"credits":9,"alt":9,"caption":9,"class":9,"link":9,"ratio":9,"crop":275,"fit":321,"hero":286,"set_height":322,"height_val":323,"resolved":324},"kirby",[320],"file:\u002F\u002F1H8buEH98pEx6BE0","cover","yes",60,{"image":325},[326],{"url":327,"width":328,"height":329,"srcset":330,"alt":132,"focus":331},"https:\u002F\u002Fcms.nextnature.net\u002Fmedia\u002Fpages\u002Fmission\u002Fhome\u002F0779853e9c-1788877849\u002Flogo-banner.png",1921,500,"https:\u002F\u002Fcms.nextnature.net\u002Fmedia\u002Fpages\u002Fmission\u002Fhome\u002F0779853e9c-1788877849\u002Flogo-banner-360x.webp 360w, https:\u002F\u002Fcms.nextnature.net\u002Fmedia\u002Fpages\u002Fmission\u002Fhome\u002F0779853e9c-1788877849\u002Flogo-banner-480x.webp 480w, https:\u002F\u002Fcms.nextnature.net\u002Fmedia\u002Fpages\u002Fmission\u002Fhome\u002F0779853e9c-1788877849\u002Flogo-banner-640x.webp 640w, https:\u002F\u002Fcms.nextnature.net\u002Fmedia\u002Fpages\u002Fmission\u002Fhome\u002F0779853e9c-1788877849\u002Flogo-banner-768x.webp 768w, https:\u002F\u002Fcms.nextnature.net\u002Fmedia\u002Fpages\u002Fmission\u002Fhome\u002F0779853e9c-1788877849\u002Flogo-banner-960x.webp 960w, https:\u002F\u0