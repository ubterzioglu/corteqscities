    <div class="c-modal-view" id="modal" style="display:none;">
    <div class="c-modal-view__modal">
        <div class="c-modal-view__modal-content">
            <button class="c-modal-view__modal-close c-nav__toggle is-open" id="modal-close">
                <div class="c-nav__toggle__icon"></div>
            </button>
            <figure class="c-page__image-wrapper">
                <img class="c-modal-view__modal-img" alt="" id="modal-image"/>
                <figcaption class="c-modal-view__modal-caption" id="modal-summary"></figcaption>
            </figure>
            
        </div>
    </div>
    <div class="c-modal-view__overlay" id="overlay"></div>
</div>



<script type="text/javascript" nonce="959I3W8YOhDAGwZXqXNC">
    const modal = document.getElementById("modal");
    const image = document.getElementById("modal-image");
    const summary = document.getElementById("modal-summary");
    const close = document.getElementById("modal-close");
    const overlay = document.getElementById("overlay");

    function showmodal(src, summaryText) {
        image.src = src;
        summary.innerHTML = summaryText;
        modal.style.display = "block";
    };

    // Close modal on clicking the close button
    close.addEventListener("click", function () {
        modal.style.display = "none";
    });

    // Close modal on clicking outside the modal
    overlay.addEventListener("click", function () {
        modal.style.display = "none";
    });

    document.body.addEventListener("keyup", (event) => { 
        if (event.key === "Escape") { 
            modal.style.display = "none";
        }
    });
</script>


		
