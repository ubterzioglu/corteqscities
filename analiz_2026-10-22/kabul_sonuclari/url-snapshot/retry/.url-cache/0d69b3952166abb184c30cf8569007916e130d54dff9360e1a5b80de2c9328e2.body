ndSpeedBft":2,"maxWindSpeedMs":3,"minWindSpeedBft":3,"minWindSpeedMs":3}}},"digits":{"activities":{"barbecue":5,"beach":2,"bicycle":9,"golf":8,"hockey":8,"iceSkating":1,"running":10,"tennis":7,"terrace":5,"walking":10,"waterSport":7,"winterSport":8,"gardening":9},"health":{"hayFever":{"grasses":{"ambrosia":0,"grasses":0,"mugwort":0,"nettle":0,"plantain":0,"rye":0,"sorrel":0},"maxGrasses":0,"maxTotal":0,"maxTrees":0,"message":"Zeer kleine kans op klachten","trees":{"alder":0,"ash":0,"beech":0,"birch":0,"cypress":0,"elm":0,"hazel":0,"oak":0,"poplar":0,"willow":0}},"migraine":3,"pressureDiff":"Snel stijgend","relativeHumidity":82,"rheumatism":2,"uvIndex":1,"maxUvIndex":1},"commercial":0,"photography":{"digit":7,"reductions":[]},"weather":10},"precipitation":{"amount":0.6,"probability":20},"intervalStart":{"formatted":"2026-10-28T01:00:00+01:00","millis":1793145600000},"sunshine":{"minutes":553,"percentage":90},"temperature":{"feelsLike":13,"min":8,"max":14},"wind":{"direction":"W","speed":{"bft":3,"ms":5}},"weatherSymbol":{"cloudCoverage":"Unclouded","code":"S0000000","dayOrNight":"Day","fogPresence":"NoFog","legacy":"so","precipitation":{"amount":"NoDrops","type":"Stratiform","kind":"Rain"},"thunder":false,"windGusts":false}}],"countryText":{"date":"2026-10-22T11:51:58.412Z","fields":{"countryName":"Nederland","countryId":135,"countryTitle":"Onstuimige en natte periode breekt aan","countrySummary":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"De komende dagen staan in het teken van onstuimig herfstweer. Vandaag trekken al enkele stevige buien over het land en waait het flink door. Aan zee zijn zware windstoten mogelijk. Vrijdag wordt een natte dag en vooral vrijdagavond kan het als gevolg van storm Austen zeer onstuimig worden. Ook in het weekend wordt het vervolgens zeker niet rustig en blijven talrijke buiensystemen over ons land trekken in combinatie met veel wind. ","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"author":{"id":"1B8jYu0VMQFe97xL2ahdGV","environment":"master","type":"author","createdAt":"2021-09-06T13:47:27.080Z","updatedAt":"2026-03-18T14:52:24.764Z","locale":"nl","fields":{"fullName":"Berend van Straaten","nickName":"Berend ","authorImage":{"id":"3eVDSrceCbOoecROMnFhCR","environment":"master","type":"Asset","createdAt":"2025-03-12T12:46:33.634Z","updatedAt":"2025-03-12T12:46:33.634Z","locale":"nl","fields":{"title":"Berend van Straaten","description":"Berend van Straaten","file":{"url":"//cdn.weeronline.nl/3eVDSrceCbOoecROMnFhCR/11c2050c01fb8b40d025915676f6f825/Berend_5_00000.png","details":{"size":214592,"image":{"width":500,"height":500}},"fileName":"Berend_5_00000.png","contentType":"image/png"}}},"authorTitle":"Meteoroloog","slug":"berend-van-straaten"}},"countryClimate":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Nederland heeft een gematigd zeeklimaat, met koele zomers en milde winters. Onder invloed van een zuidwestelijke stroming wordt het hele jaar door vochtige zeelucht naar het land gevoerd. Regen valt er dus in elk jaargetijde, extreem nat is het land niet. Gemiddeld loopt de temperatuur in de zomer op tot 23°C. In het zuiden is het iets warmer dan in het noorden. Aan de kust schijnt de zon het meest. In het zuidoosten is de minste zon te vinden. Strenge vorstperiodes komen niet vaak voor in Nederland. In de winter is het overdag 6°C en is het vaak mistig of bewolkt. De gemiddelde nachttemperatuur ligt in het noordoosten rond het vriespunt. Tijdens vorstperiodes kan hier doorgaans het eerste worden geschaatst.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"hayFeverTitle":"Voorlopig geen hooikoortsklachten","hayFeverSummary":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Het hooikoortsseizoen is voorbij. In de loop van december neemt de kans op hooikoortsklachten weer toe zodra de hazelaar in bloei treedt.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"hayFeverFullText":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Afhankelijk van hoe warm december verloopt zal het volgende hooikoortsseizoen nog dit jaar van start gaan. Bij zacht weer zal net als de voorgaande jaren al rond de kerst kans zijn op hooikoortsklachten door de bloei van de eerste hazelaars.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}},"isInternational":false,"type":"CMSCountry"},"weatherAlarm":{"Id":"f1d3ff8443297732","Title":"Er zijn nu geen waarschuwingen","SubTitle":"","Url":"/waarschuwing/","Active":false,"Color":"green","Text":"Er is momenteel geen waarschuwing.","Type":null,"EndDayName":"Sat","Elements":[{"Type":"Wind","Color":"green","HighestColor":"yellow","Title":"Zware windstoten","MobileTitle":"","Image":"","ImageName":"","Text":"Vrijdagavond en in de nacht naar zaterdag is er kans op zware windstoten op de Zeeuwse en Zuid-Hollandse eilanden en in Noord-Brabant en Limburg. Doordat de bomen nog in het blad staan kunnen er takken afbreken, met vooral hinder voor het verkeer. De wind wordt veroorzaakt door stormdepressie Austen. ","ExtraText":"","Timestamps":[{"StartDate":1792671685,"EndDate":1792774800,"Color":"green"},{"StartDate":1792774800,"EndDate":1792807200,"Color":"yellow"}]}]},"snowData":null,"snowHistory":null,"snowByCountry":null,"weatherAdvice":{"id":"ThereIsSunshineThisAfternoonGreaterThanOrEquals10","animationId":1,"link":"48_h","message":"Het belooft een stralende middag te worden. Ideaal om naar buiten te gaan.","replacements":{},"score":7},"articleCollection":{"pagination":{"total":10637,"skip":0,"limit":5},"articles":[{"pinned":true,"id":"7vuKDuwVf6KFdQZ0Uo76WJ","environment":"master","type":"news","createdAt":"2026-10-21T06:54:58.411Z","updatedAt":"2026-10-21T11:13:53.071Z","locale":"nl","fields":{"title":"Wintertijd gaat onstuimig van start: dit kun je verwachten","slug":"21-10-2026-wintertijd-gaat-onstuimig-van-start","summary":"De overgang naar de wintertijd verloopt dit jaar allesbehalve rustig. Regen en een stevige wind zorgen voor een onstuimige start.","publicationDate":"2026-10-21T08:55+02:00","mainImage":{"fields":{"file":{"url":"//cdn.weeronline.nl/1Eeg3hVLg3yLCPrXBzkp8L/a89c0df51a34e26d5c0edb29bf56867c/tQ4Vft6Y5VbVd3djFwTzg5RAwvZuxCfjhSZaGCBW_raw.jpg"}}},"tags":[{"id":"jw15YCEzZUIKCxCk7622B","fields":{"slug":"tijd-en-seizoenen","title":"Tijd en seizoenen"}},{"id":"4kwzQPass9cqQ73GyHI4Xg","fields":{"slug":"binnenland","title":"Binnenland"}},{"id":"1E9xaM8uPvMWF6IM6PupNL","fields":{"slug":"actueel","title":"Actueel"}}]}},{"pinned":true,"id":"5hUWOdZldnnNBuklsR8dRf","environment":"master","type":"news","createdAt":"2026-10-21T05:36:22.141Z","updatedAt":"2026-10-21T11:15:25.852Z","locale":"nl","fields":{"title":"Orioniden op komst: wanneer kun je het beste vallende sterren zien?","slug":"21-10-2026-orioniden-wanneer-kun-je-het-beste-vallende-sterren-zien","summary":"De komende dagen is de meteorenzwerm de Orioniden actief. Het weer werkt alleen niet altijd mee om de vallende sterren te kunnen zien.","publicationDate":"2026-10-21T07:30+02:00","mainImage":{"fields":{"file":{"url":"//cdn.weeronline.nl/2AhfchE6XJtzgSQWtLWFu5/c8eb98a62c6b06be1a146bcd99691f9c/AdobeStock_96218433.jpeg"}}},"tags":[{"id":"5jnIHi0zhEOdBDeTLsV60P","fields":{"slug":"astronomie","title":"Astronomie"}},{"id":"4kwzQPass9cqQ73GyHI4Xg","fields":{"slug":"binnenland","title":"Binnenland"}}]}},{"id":"3tZcWJ7a4IN3XYXl6oRtBe","fields":{"title":"Dit zijn de vijf beste zonbestemmingen voor de winter","slug":"dit-zijn-de-vijf-beste-zonbestemmingen-voor-de-winter","summary":"De beste plekken om een weekje of langer de zon op te zoeken tijdens de wintermaanden zijn die met minstens vijf zonuren per dag en op maximaal zes uur vliegen.","publicationDate":"2026-10-22T07:17+02:00","mainImage":{"fields":{"file":{"url":"//cdn.weeronline.nl/4m3NNOgwVXGexe65ctlLyD/720896cfa3d518ddf1c9440f528a1f9b/AdobeStock_Luiz.jpeg"}}},"tags":[{"id":"2ZOfrIj43zzZffTkVvF9ub","fields":{