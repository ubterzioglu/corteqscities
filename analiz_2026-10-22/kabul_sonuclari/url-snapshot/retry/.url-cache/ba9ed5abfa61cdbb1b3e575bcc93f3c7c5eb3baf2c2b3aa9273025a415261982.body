"filterIsFeatured\":false,\"enableDateFilter\":false,\"parentPage\":null,\"reviewState\":\"published\",\"sortField\":\"eventStarts\",\"sortOrder\":\"desc\",\"limit\":null,\"showTag\":false,\"showDate\":true,\"showCount\":false,\"showContentType\":false,\"showNotFound\":false,\"blockName\":null,\"dateFilters\":[{\"id\":\"6a3bdd738b1e2b4c5abee9da\",\"dateField\":\"eventEnds\",\"operator\":\"afterToday\",\"value\":null,\"valueFrom\":null,\"valueTo\":null}],\"blockType\":\"collections-block\",\"headline\":\"Rondleidingen\",\"cta\":{\"enableCta\":false,\"linkType\":\"internal\",\"label\":null,\"externalUrl\":null,\"openInNewTab\":false,\"url\":null},\"tag\":[4],\"selected_pages\":[],\"selected_events\":[],\"selected_artworks\":[],\"selected_authors\":[],\"selected_exhibitions\":[],\"selected_publications\":[]},{\"id\":\"6a047675feb7e00001fc187c\",\"variation\":\"cards\",\"headlineSize\":\"big\",\"collectionType\":\"events\",\"selectionMode\":\"all\",\"filterType\":null,\"filterIsFeatured\":false,\"enableDateFilter\":false,\"parentPage\":null,\"reviewState\":\"published\",\"sortField\":\"eventStarts\",\"sortOrder\":\"asc\",\"limit\":null,\"showTag\":false,\"showDate\":true,\"showCount\":false,\"showContentType\":false,\"showNotFound\":false,\"blockName\":null,\"dateFilters\":[{\"id\":\"6a3bdd608b1e2b4c5abee9d9\",\"dateField\":\"eventEnds\",\"operator\":\"afterToday\",\"value\":null,\"valueFrom\":null,\"valueTo\":null}],\"blockType\":\"collections-block\",\"headline\":\"Onbeperkt Van Abbe\",\"cta\":{\"enableCta\":false,\"linkType\":\"internal\",\"label\":null,\"externalUrl\":null,\"openInNewTab\":false,\"url\":null},\"tag\":[5],\"selected_pages\":[],\"selected_events\":[],\"selected_artworks\":[],\"selected_authors\":[],\"selected_exhibitions\":[],\"selected_publications\":[]}],\"taxonomies\":{\"tags\":[]},\"parent\":9,\"breadcrumbs\":[{\"doc\":9,\"url\":\"zien-en-doen\",\"label\":\"zien \u0026 doen\",\"id\":\"70e966941d3f81b9be8bda51\"},{\"doc\":11,\"url\":\"zien-en-doen/activiteiten\",\"label\":\"Activiteiten\",\"id\":\"0cfda4dfd391e3d2207be2d2\"}],\"meta\":{\"title\":null,\"description\":null,\"image\":null,\"noindex\":false,\"nofollow\":false},\"updatedAt\":\"2026-10-07T11:18:48.491Z\",\"createdAt\":\"2026-04-22T17:16:38.161Z\",\"_status\":\"published\"},\"fullPath\":\"zien-en-doen/activiteiten/opening-collectie-als-kosmos\",\"eventStarts\":\"2026-06-06T09:00:00.000Z\",\"eventEnds\":\"2026-06-06T16:00:00.000Z\",\"wholeDay\":true,\"openEnd\":false,\"location\":null,\"contactName\":null,\"contactEmail\":null,\"recurrenceDescription\":null,\"recurrence\":null,\"changeNote\":null,\"isFeatured\":false,\"publishingDate\":null,\"expirationDate\":null,\"tags\":[{\"id\":2,\"name\":\"activiteit\",\"generateSlug\":false,\"slug\":\"activiteit\",\"updatedAt\":\"2026-04-22T17:03:47.942Z\",\"createdAt\":\"2026-04-22T17:03:47.942Z\"},{\"id\":6,\"name\":\"overig\",\"generateSlug\":false,\"slug\":\"overig\",\"updatedAt\":\"2026-04-22T17:05:13.114Z\",\"createdAt\":\"2026-04-22T17:05:13.114Z\"}],\"relatedItems\":[{\"id\":23,\"title\":\"Collectie als kosmos\",\"summary\":\"Een andere kijk op tijd in de nieuwe collectiepresentatie\",\"featuredImage\":23434,\"layout\":[{\"id\":\"6a0312ef07dd6cdf95aa90ec\",\"blockName\":null,\"blockType\":\"content-block\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" gaat over tijd en de verhalen die kunst kan vertellen. De tentoonstelling doorbreekt het idee van kunstgeschiedenis als een lange tijdlijn: in plaats van tijd te meten in één rechte lijn, kijken we naar de verbanden die kunstwerken met elkaar kunnen vormen, over verschillende tijden heen. Te r gelegenheid van het 90-jarig bestaan in 2026 presenteert het Van Abbemuseum een nieuwe collectiepresentatie die een frisse kijk biedt op tijd en de collectie in een ander licht zet.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Als sterrenbeelden aan de nachtelijke hemel zijn 250 kunstwerken verspreid over de drie verdiepingen van het museum. Ze volgen geen vaste lijn of chronologische volgorde. Door persoonlijke verhalen te verbinden met grotere cycli brengt de tentoonstelling verschillende ritmes van tijd samen, van menselijke geschiedenissen tot tijd op een kosmische schaal. Met \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" neemt het Van Abbemuseum afstand van één enkel verhaal dat zich langs een rechte lijn door de tijd beweegt. In plaats daarvan ontstaat ruimte waarin verschillende tijden en verhalen naast elkaar bestaan. De tentoonstelling wekt verwondering, nodigt uit om anders te kijken en brengt een levendig gesprek met tijd op gang.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Vier manieren om tijd te ervaren\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" presenteert de museumcollectie op een open, dynamische manier. Met vier invalshoeken nodigen we je uit om tijd op andere manieren te ervaren:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Onchronologische tijd\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Door de chronologische volgorde los te laten, ontstaat er ruimte voor nieuwe verhalen. Negentig buren van het museum leveren een bijdrage aan de tentoonstelling door een voorwerp uit hun dagelijks leven in bruikleen te geven. Aan de hand van hun objecten nemen deze negentig verhalenvertellers je mee op een reis door de tijd. De voorwerpen werken als schakels: ze verbinden persoonlijke verhalen en herinneringen met kunstwerken uit de collectie. Zo is een roze wekker gekoppeld aan het schilderij \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"JULY 4, 1973 ‘Wednesday’\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" van On Kawara. Deze werkwijze is ontwikkeld samen met de Johannesburg-werkgroep van Another Roadmap Africa Cluster (ARAC).\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Regeneratieve tijd\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Leven en dood, vreugde en verlies. In haar werk onderzoekt kunstenaar en doodsonderzoeker G hoe verdriet en rouw eruit kunnen zien. Hoe gaan we om met deze momenten in de cyclus van het leven? En wat betekenen ze in een museum dat kunstwerken verzamelt, met zorg bewaart en soms ook weer afstoot? Hoe neem je afscheid van een kunstwerk?\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Publieke tijd\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Hoe kunnen we de buitenwereld ervaren in een museum? Deze invalshoek zet vraagtekens bij vaste museumkaders, zoals muren en openingstijden. Een zaal is ingericht als een bos vol beelden en installaties. Bij binnenkomst loop je onder een opblaasbare boog door, geïnspireerd op de finish van een marathon. In dit werk bouwt Ima-Abasi Okon voort op ideeën uit haar solotentoonstelling in 2025, waarin ze vanuit haar hardlooppraktijk andere manieren van tijd meten onderzoekt.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kosmische tijd\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Wat heeft de nachtelijke hemel te maken met het land en de landbouw? Deze manier van kijken naar tijd volgt de cycli van zaaien en oogsten en laat zien hoe kosmische en aardse ritmes met elkaar verbonden zijn. Deze invalshoek is ontwikkeld met kunstenaar Nolan Oswald Dennis en gebaseerd op hun installatie \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Black Liberation Zodiac (Khunuseti). \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"In de zaal die is gewijd aan kosmische tijd, word je omringd door wanden vol landschappen uit verschillende tijden.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kunst en samenleving komen samen\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Terwijl \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" zich afspeelt op de bovenste drie verdiepingen van het Collectiegebouw, is het Dommelplein op de begane grond een plek voor ontmoeting en samenwerking. Kunstenaars, ontwerpers, bezoekers en denkers werken hier samen met lokale partners zoals Archipel, Design Academy Eindhoven, Studio Woensel West en Tante Netty. Hier ontmoeten kunst en samenleving elkaar in nieuwe manieren van maken, verzamelen en ervaren.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kunstenaars\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"In \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" zijn meer dan 250 kunstwerken te zien van: Can Altay, Brook Andrew, Karel Appel, Rasheed Araeen, Mercedes Azpilicueta, Francis Bacon, Jo Baer, Gerrit van Bakel, Ernst Barlach, Robert Barry, Max Beckmann, Marcel van den Berg, Pieke Bergmans, Joseph Beuys, Rossella Biscotti, Ansuya Blom, Georges Braque, Marcel Broodthaers, stanley brouwn, Günter Brus, Simnikiwe Buhlungu, Kees Buurman, André Cadere, Heinrich Campendonk, Hendrik Chabot, Marc Chagall, Edgar Cleijne, Constant, Jan Elburg \u0026 Constant, Angelo Custodio, Wim van Dam, René Daniëls, Yael Davids, Nolan Oswald Dennis, Jan Dibbets, Rineke Dijkstra, Theo van Doesburg, Jean Dubuffet, Marlene Dumas,\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":8,\"version\":1},{\"mode\":\"normal\",\"text\":\"$15\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Deze collectiepresentatie wordt mede mogelijk gemaakt door:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"block\",\"fields\":{\"id\":\"6a0312fe5ccdb79d5c7eda20\",\"images\":[{\"id\":\"6a03132407dd6cdf95aa90ed\",\"link\":{\"label\":\"mondriaan fonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.mondriaanfonds.nl/\",\"openInNewTab\":true},\"image\":18926},{\"id\":\"6a03134f07dd6cdf95aa90ee\",\"link\":{\"label\":\"bartimeus\",\"linkType\":\"external\",\"externalUrl\":\"https://bartimeusfonds.nl/\",\"openInNewTab\":true},\"image\":23411},{\"id\":\"6a0313ae07dd6cdf95aa90ef\",\"link\":{\"label\":\"het cultuurfonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.cultuurfonds.nl/\",\"openInNewTab\":true},\"image\":23412},{\"id\":\"6a0313e507dd6cdf95aa90f0\",\"link\":{\"label\":\"zabawas\",\"linkType\":\"external\",\"externalUrl\":\"https://www.zabawas.nl/\",\"openInNewTab\":false},\"image\":23413}],\"blockName\":\"\",\"blockType\":\"partners-logos\",\"logosHeight\":40},\"format\":\"\",\"version\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Het Dommelplein wordt mede mogelijk gemaakt door:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"block\",\"fields\":{\"id\":\"6a03130f5ccdb79d5c7eda21\",\"images\":[{\"id\":\"6a03141007dd6cdf95aa90f1\",\"link\":{\"label\":\"vsb fonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.vsbfonds.nl/\",\"openInNewTab\":true},\"image\":18932},{\"id\":\"6a03142f07dd6cdf95aa90f2\",\"link\":{\"label\":\"mondriaan fonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.mondriaanfonds.nl/\",\"openInNewTab\":true},\"image\":18926},{\"id\":\"6a03145007dd6cdf95aa90f3\",\"link\":{\"label\":\"cultuurfonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.cultuurfonds.nl/\",\"openInNewTab\":true},\"image\":23412},{\"id\":\"6a03146707dd6cdf95aa90f4\",\"link\":{\"label\":\"bartimeus\",\"linkType\":\"external\",\"externalUrl\":\"https://bartimeusfonds.nl/\",\"openInNewTab\":true},\"image\":23411},{\"id\":\"6a03148a07dd6cdf95aa90f5\",\"link\":{\"label\":\"korea arts management service\",\"linkType\":\"external\",\"externalUrl\":\"https://www.gokams.or.kr/eng/main/main.aspx\",\"openInNewTab\":true},\"image\":23415}],\"blockName\":\"\",\"blockType\":\"partners-logos\",\"logosHeight\":40},\"format\":\"\",\"version\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"De nieuwe museumtuin wordt mede mogelijk gemaakt door:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"block\",\"fields\":{\"id\":\"6a0314f55ccdb79d5c7eda22\",\"images\":[{\"id\":\"6a0314f907dd6cdf95aa90f7\",\"link\":{\"label\":\"bdp cultuurfonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.bpdcultuurfonds.nl/\",\"openInNewTab\":true},\"image\":23410}],\"blockName\":\"\",\"blockType\":\"partners-logos\",\"logosHeight\":40},\"format\":\"\",\"version\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}},{\"id\":\"6a1d51e313551e0e5c3d9aad\",\"blockName\":null,\"items\":[{\"id\":\"6a1d51e713551e0e5c3d9aae\",\"title\":\"Colofon\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Colofon / Colophon\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"$16\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kunstenaars als gesprekspartners / Artist Interlocutors\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"De tentoonstelling is rond vier onderzoekslijnen georganiseerd, samen met kunstenaars als onderzoekers die hun werk implementeerden tijdens de onderzoeksfase en de onderliggende structuur van de tentoonstelling vormgaven. “Onchronologische Tijd,” ontwikkeld in samenwerking met Another Road Map Africa Cluster (ARAC), verbindt de bezoeker met de collectie via plaatsen, geschiedenissen en herinneringen. “Regeneratieve Tijd,” ontwikkeld met kunstenaar en doodsonderzoeker G, verkent de cycli van leven en dood voor zowel materiële objecten als immateriële systemen. “Publieke Tijd,” ontwikkeld met kunstenaar Ima-Abasi Okon, belicht de rol van kunst in publieke ruimten buiten de openingstijden van het museum. “Kosmische Tijden,” ontwikkeld met Nolan Oswald Dennis, onderzoekt planetaire tijdsdimensies en gebruikt de kosmos en de nachtelijke hemel om lokale vraagstukken aan te kaarten.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Artistiek Team / Artistic Team\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Concept \u0026 Lead by Yolande Zola Zoli van der Heide (senior curator) in samenwerking met / in collaboration with Defne Ayas (directeur / director), Steven ten Thije (hoofd collecties / head of collections), Abril Cisneros Ramírez (assistent curator), Anna Truntaeva (curator stagiaire)\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Projectleider / Project Manager\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Nikita Hurkmans\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ruimtelijk Ontwerp / Spatial Design\",\"type\":\"text\",\"style\":\"\",\"de