lesize\":30559,\"width\":800,\"height\":308,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/het_cultuurfonds-350x350.png\",\"width\":350,\"height\":350,\"mimeType\":\"image/png\",\"filesize\":12486,\"filename\":\"het_cultuurfonds-350x350.png\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/het_cultuurfonds-480x185.png\",\"width\":480,\"height\":185,\"mimeType\":\"image/png\",\"filesize\":14749,\"filename\":\"het_cultuurfonds-480x185.png\"},\"tablet\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/het_cultuurfonds-768x296.png\",\"width\":768,\"height\":296,\"mimeType\":\"image/png\",\"filesize\":29436,\"filename\":\"het_cultuurfonds-768x296.png\"},\"hero\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}}}},{\"id\":\"6a03146707dd6cdf95aa90f4\",\"link\":{\"label\":\"bartimeus\",\"linkType\":\"external\",\"externalUrl\":\"https://bartimeusfonds.nl/\",\"openInNewTab\":true},\"image\":{\"id\":23411,\"alt\":\"bartimeus\",\"copyright\":null,\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-12T11:48:25.394Z\",\"createdAt\":\"2026-05-12T11:48:25.214Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/bartimeus_fonds.png\",\"thumbnailURL\":null,\"filename\":\"bartimeus_fonds.png\",\"mimeType\":\"image/png\",\"filesize\":62474,\"width\":800,\"height\":156,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/bartimeus_fonds-350x350.png\",\"width\":350,\"height\":350,\"mimeType\":\"image/png\",\"filesize\":56153,\"filename\":\"bartimeus_fonds-350x350.png\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/bartimeus_fonds-480x94.png\",\"width\":480,\"height\":94,\"mimeType\":\"image/png\",\"filesize\":28091,\"filename\":\"bartimeus_fonds-480x94.png\"},\"tablet\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/bartimeus_fonds-768x150.png\",\"width\":768,\"height\":150,\"mimeType\":\"image/png\",\"filesize\":58902,\"filename\":\"bartimeus_fonds-768x150.png\"},\"hero\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}}}},{\"id\":\"6a03148a07dd6cdf95aa90f5\",\"link\":{\"label\":\"korea arts management service\",\"linkType\":\"external\",\"externalUrl\":\"https://www.gokams.or.kr/eng/main/main.aspx\",\"openInNewTab\":true},\"image\":{\"id\":23415,\"alt\":\"korea arts management service\",\"copyright\":null,\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-12T11:53:13.415Z\",\"createdAt\":\"2026-05-12T11:53:13.026Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/korea_arts_management_service.png\",\"thumbnailURL\":null,\"filename\":\"korea_arts_management_service.png\",\"mimeType\":\"image/png\",\"filesize\":74910,\"width\":547,\"height\":278,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/korea_arts_management_service-350x350.png\",\"width\":350,\"height\":350,\"mimeType\":\"image/png\",\"filesize\":61462,\"filename\":\"korea_arts_management_service-350x350.png\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/korea_arts_management_service-480x244.png\",\"width\":480,\"height\":244,\"mimeType\":\"image/png\",\"filesize\":46347,\"filename\":\"korea_arts_management_service-480x244.png\"},\"tablet\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null},\"hero\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}}}}],\"blockName\":\"\",\"blockType\":\"partners-logos\",\"logosHeight\":40},\"format\":\"\",\"version\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"De nieuwe museumtuin wordt mede mogelijk gemaakt door:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"block\",\"fields\":{\"id\":\"6a0314f55ccdb79d5c7eda22\",\"images\":[{\"id\":\"6a0314f907dd6cdf95aa90f7\",\"link\":{\"label\":\"bdp cultuurfonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.bpdcultuurfonds.nl/\",\"openInNewTab\":true},\"image\":{\"id\":23410,\"alt\":\"bdp fonds\",\"copyright\":null,\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-12T11:34:50.903Z\",\"createdAt\":\"2026-05-12T11:34:50.717Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/bdp_cultuurfonds.png\",\"thumbnailURL\":null,\"filename\":\"bdp_cultuurfonds.png\",\"mimeType\":\"image/png\",\"filesize\":52541,\"width\":800,\"height\":149,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/bdp_cultuurfonds-350x350.png\",\"width\":350,\"height\":350,\"mimeType\":\"image/png\",\"filesize\":21986,\"filename\":\"bdp_cultuurfonds-350x350.png\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/bdp_cultuurfonds-480x89.png\",\"width\":480,\"height\":89,\"mimeType\":\"image/png\",\"filesize\":18850,\"filename\":\"bdp_cultuurfonds-480x89.png\"},\"tablet\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/bdp_cultuurfonds-768x143.png\",\"width\":768,\"height\":143,\"mimeType\":\"image/png\",\"filesize\":42860,\"filename\":\"bdp_cultuurfonds-768x143.png\"},\"hero\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}}}}],\"blockName\":\"\",\"blockType\":\"partners-logos\",\"logosHeight\":40},\"format\":\"\",\"version\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}},{\"id\":\"6a1d51e313551e0e5c3d9aad\",\"blockName\":null,\"items\":[{\"id\":\"6a1d51e713551e0e5c3d9aae\",\"title\":\"Colofon\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Colofon / Colophon\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"$14\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kunstenaars als gesprekspartners / Artist Interlocutors\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"De tentoonstelling is rond vier onderzoekslijnen georganiseerd, samen met kunstenaars als onderzoekers die hun werk implementeerden tijdens de onderzoeksfase en de onderliggende structuur van de tentoonstelling vormgaven. “Onchronologische Tijd,” ontwikkeld in samenwerking met Another Road Map Africa Cluster (ARAC), verbindt de bezoeker met de collectie via plaatsen, geschiedenissen en herinneringen. “Regeneratieve Tijd,” ontwikkeld met kunstenaar en doodsonderzoeker G, verkent de cycli van leven en dood voor zowel materiële objecten als immateriële systemen. “Publieke Tijd,” ontwikkeld met kunstenaar Ima-Abasi Okon, belicht de rol van kunst in publieke ruimten buiten de openingstijden van het museum. “Kosmische Tijden,” ontwikkeld met Nolan Oswald Dennis, onderzoekt planetaire tijdsdimensies en gebruikt de kosmos en de nachtelijke hemel om lokale vraagstukken aan te kaarten.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Artistiek Team / Artistic Team\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Concept \u0026 Lead by Yolande Zola Zoli van der Heide (senior curator) in samenwerking met / in collaboration with Defne Ayas (directeur / director), Steven ten Thije (hoofd collecties / head of collections), Abril Cisneros Ramírez (assistent curator), Anna Truntaeva (curator stagiaire)\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Projectleider / Project Manager\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Nikita Hurkmans\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ruimtelijk Ontwerp / Spatial Design\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Studio Matilde Cassani (Matilde Cassani, Leonardo Gatti, Cecilia da Pozzo)\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Grafisch Ontwerp / Graphic Design\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Studio Pupilla\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Zakelijk Directeur / Business Director\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Anastasia van Gennip\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Hoofd Productie \u0026 Presentatie / Head of Production \u0026 Presentation\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Antoine Derksen\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Hoofd Opbouw \u0026 Technische Coördinator /\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Head Installation \u0026 Technical Coordination\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Diederik Koppelmans, Mark van der Gronden\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Technisch Tekenaar / Technical Engineer\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Benno Hartjes\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Technische Dienst / Installation Team\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Hadewych Bartelds, Gijs Blankers, Matthieu Brekelmans, Stef van der Dungen, Perry van Duijnhoven, Tom Frencken, Joost Gehem, Tyson Goudsmit, Paul Heijnen, Ivi van Keulen, Sjoerd van Lankveld, Thijs Linmans, Sander Lucas, Bram Mijnders, Aagje Linssen, Angelo Shuhmacher, Leon Vos, Jeroen Vrijsen\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"AV \u0026 Lichtontwerp / AV \u0026 Light Design\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Bart van Geldrop\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Collectieteam / Collection Team\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Marit Jacobs, Michaela Groeneveld, Chantal Kleinmeulman, Aurora Loerakker, Angeliki Petropoulos, Dieke Ribbers, Michel van Weegberg\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Archief \u0026 Bibliotheek / Archive \u0026 Library\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Relinde ter Borg, Annebel Kuperus, Rebecca Niculae, Odilia van Roij, Maria Samailiuk, Nelleke Slofstra, Anna Tchitcherine\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Fondsenwerving / Fundraising\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Joy Ravenwaaij, Roos Ticheler\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Publieksbemiddeling \u0026 Educatie / Mediation \u0026 Education\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Yda Sinaij, Glenda Pattipeilohy, Ilse van de Wetering, Nayara Lekkerkerk (stagiairs / interns)\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Alle teksten zijn bewerkt tot B1 niveau door een externe redacteur. / All exhibition texts have been externally edited to B1 level for accessibility.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Constituent Organisator / Organiser\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Vivian Vasilda-Heyms\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Multisensorische Ontwikkeling / Multisensory Development\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"ADEZIV network (Daisy Dawson, Marie- Luise Charlotte Weier, Simon van Vliet, Oskar Zulauf, Mehdi Greefhorst, Nick Monroe Maeres, Willemijn Kuipers, Kaylee Rosaline, Maartje Vos-Swinkels, Menko Dijksterhuis, Miriam Wolter), Hossam Althakali, CBB, Jeanette Chedda, Angelo Custódio, Eindhoven Toegankelijk (Paula de Ruiter, Marc Jacobs, Ingrid Schoenmakers), EzWayz, Femke Herregraven, InGebaren, Tamara van Laarhoven, Steffie Maas, Benny Nilsen, Helga Pladek, Shay Raviv, Studio Matilde Cassani, Studio Pupilla, Stichting Accessibility (Séverine Kas, Jolijn Jansen, Sandra Vernooij), The Snifferoo ( Frank Bloem), Jesse Vermeulen, Videlio (John Willemse, George Kabel)\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Projectorganisatie 90 Vertellers / Project Organisation 90 Narrators\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Abril Cisneros Ramírez, Blanka Gyulai, Zohra Peels, Chala Westerman\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Marketing \u0026 Communicatie / Marketing \u0026 Communication\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Maud Bongers, Kelly Hamers, Chloe van der Schmitte, Sabine Spierenburg. Zoe Okonkwo Prada \u0026 Pia Seidel (stagiairs / interns)\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Management Assistant / Assistent\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Marit Pulles\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Museumgidsen / Museum Guides\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Jocelyn Baah, Claudia den Boer, Fleur Brom, Ángela Castaño Estévez, Salman Dirir, Tessa van den Eeden, Laury van Eerd, Julia Fidder, Vitor Van Gaever, Marjon de Groot, Atakan Gür, Diewke van den Heuvel, Nini Hoang, Loïs Lentz, Lieke Mangindaan, Jacqueline Nas, Marjolein Nolles, Laura Papke, Sanne Prevoo, Mariam Razkallah, Leonie Schepers, Trienette Stevens, Rimanta Tavo, Sabina Timmermans, Marieke Verberne, Maartje Vos-Swinkels, Roos Wijma, Miranda van der Zandt\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Met dank aan / With thanks to\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"l