15.V084a_2560-480x320.jpg\"},\"tablet\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/11.07.15.V084a_2560-768x512.jpg\",\"width\":768,\"height\":512,\"mimeType\":\"image/jpeg\",\"filesize\":133953,\"filename\":\"11.07.15.V084a_2560-768x512.jpg\"},\"hero\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/11.07.15.V084a_2560-1280x620.jpg\",\"width\":1280,\"height\":620,\"mimeType\":\"image/jpeg\",\"filesize\":254791,\"filename\":\"11.07.15.V084a_2560-1280x620.jpg\"}}},\"hideFeaturedImageOnDetail\":true,\"layout\":[{\"id\":\"69e8e120e6de108cb57792ad\",\"videoSource\":\"local\",\"vimeoUrl\":null,\"youtubeUrl\":null,\"localVideo\":{\"id\":18829,\"alt\":\"Collectie als kosmos\",\"copyright\":\"Van Abbemuseum\",\"source\":null,\"prefix\":\"media\",\"folder\":14,\"updatedAt\":\"2026-09-16T14:25:07.009Z\",\"createdAt\":\"2026-05-04T22:34:29.633Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/Collectie%20Als%20Kosmos%20852x480.mp4\",\"thumbnailURL\":null,\"filename\":\"Collectie Als Kosmos 852x480.mp4\",\"mimeType\":\"video/mp4\",\"filesize\":4016971,\"width\":null,\"height\":null,\"focalX\":null,\"focalY\":null,\"sizes\":{\"thumbnail\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null},\"card\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null},\"tablet\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null},\"hero\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}}},\"blockName\":null,\"blockType\":\"hero-intro-block\",\"headline\":{\"text\":\"Welkom\",\"level\":\"h2\"},\"cta\":{\"enableCta\":true,\"linkType\":\"internal\",\"internalPage\":{\"relationTo\":\"events\",\"value\":{\"id\":23,\"title\":\"Collectie als kosmos\",\"summary\":\"Een andere kijk op tijd in de nieuwe collectiepresentatie\",\"featuredImage\":{\"id\":23434,\"alt\":\"Collectie als /kosmos\",\"copyright\":\"Foto: Lisa van Katwijk\",\"source\":null,\"prefix\":\"media\",\"folder\":4,\"updatedAt\":\"2026-05-12T15:30:21.341Z\",\"createdAt\":\"2026-05-12T15:25:43.626Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/Collectie%20als%20Kosmos.jpeg\",\"thumbnailURL\":null,\"filename\":\"Collectie als Kosmos.jpeg\",\"mimeType\":\"image/jpeg\",\"filesize\":3145093,\"width\":3599,\"height\":2705,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/Collectie%20als%20Kosmos-350x350.jpg\",\"width\":350,\"height\":350,\"mimeType\":\"image/jpeg\",\"filesize\":16440,\"filename\":\"Collectie als Kosmos-350x350.jpg\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/Collectie%20als%20Kosmos-480x361.jpg\",\"width\":480,\"height\":361,\"mimeType\":\"image/jpeg\",\"filesize\":21010,\"filename\":\"Collectie als Kosmos-480x361.jpg\"},\"tablet\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/Collectie%20als%20Kosmos-768x577.jpg\",\"width\":768,\"height\":577,\"mimeType\":\"image/jpeg\",\"filesize\":46141,\"filename\":\"Collectie als Kosmos-768x577.jpg\"},\"hero\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/Collectie%20als%20Kosmos-1280x620.jpg\",\"width\":1280,\"height\":620,\"mimeType\":\"image/jpeg\",\"filesize\":87349,\"filename\":\"Collectie als Kosmos-1280x620.jpg\"}}},\"layout\":[{\"id\":\"6a0312ef07dd6cdf95aa90ec\",\"blockName\":null,\"blockType\":\"content-block\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" gaat over tijd en de verhalen die kunst kan vertellen. De tentoonstelling doorbreekt het idee van kunstgeschiedenis als een lange tijdlijn: in plaats van tijd te meten in één rechte lijn, kijken we naar de verbanden die kunstwerken met elkaar kunnen vormen, over verschillende tijden heen. Te r gelegenheid van het 90-jarig bestaan in 2026 presenteert het Van Abbemuseum een nieuwe collectiepresentatie die een frisse kijk biedt op tijd en de collectie in een ander licht zet.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Als sterrenbeelden aan de nachtelijke hemel zijn 250 kunstwerken verspreid over de drie verdiepingen van het museum. Ze volgen geen vaste lijn of chronologische volgorde. Door persoonlijke verhalen te verbinden met grotere cycli brengt de tentoonstelling verschillende ritmes van tijd samen, van menselijke geschiedenissen tot tijd op een kosmische schaal. Met \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" neemt het Van Abbemuseum afstand van één enkel verhaal dat zich langs een rechte lijn door de tijd beweegt. In plaats daarvan ontstaat ruimte waarin verschillende tijden en verhalen naast elkaar bestaan. De tentoonstelling wekt verwondering, nodigt uit om anders te kijken en brengt een levendig gesprek met tijd op gang.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Vier manieren om tijd te ervaren\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" presenteert de museumcollectie op een open, dynamische manier. Met vier invalshoeken nodigen we je uit om tijd op andere manieren te ervaren:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Onchronologische tijd\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Door de chronologische volgorde los te laten, ontstaat er ruimte voor nieuwe verhalen. Negentig buren van het museum leveren een bijdrage aan de tentoonstelling door een voorwerp uit hun dagelijks leven in bruikleen te geven. Aan de hand van hun objecten nemen deze negentig verhalenvertellers je mee op een reis door de tijd. De voorwerpen werken als schakels: ze verbinden persoonlijke verhalen en herinneringen met kunstwerken uit de collectie. Zo is een roze wekker gekoppeld aan het schilderij \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"JULY 4, 1973 ‘Wednesday’\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" van On Kawara. Deze werkwijze is ontwikkeld samen met de Johannesburg-werkgroep van Another Roadmap Africa Cluster (ARAC).\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Regeneratieve tijd\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Leven en dood, vreugde en verlies. In haar werk onderzoekt kunstenaar en doodsonderzoeker G hoe verdriet en rouw eruit kunnen zien. Hoe gaan we om met deze momenten in de cyclus van het leven? En wat betekenen ze in een museum dat kunstwerken verzamelt, met zorg bewaart en soms ook weer afstoot? Hoe neem je afscheid van een kunstwerk?\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Publieke tijd\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Hoe kunnen we de buitenwereld ervaren in een museum? Deze invalshoek zet vraagtekens bij vaste museumkaders, zoals muren en openingstijden. Een zaal is ingericht als een bos vol beelden en installaties. Bij binnenkomst loop je onder een opblaasbare boog door, geïnspireerd op de finish van een marathon. In dit werk bouwt Ima-Abasi Okon voort op ideeën uit haar solotentoonstelling in 2025, waarin ze vanuit haar hardlooppraktijk andere manieren van tijd meten onderzoekt.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kosmische tijd\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Wat heeft de nachtelijke hemel te maken met het land en de landbouw? Deze manier van kijken naar tijd volgt de cycli van zaaien en oogsten en laat zien hoe kosmische en aardse ritmes met elkaar verbonden zijn. Deze invalshoek is ontwikkeld met kunstenaar Nolan Oswald Dennis en gebaseerd op hun installatie \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Black Liberation Zodiac (Khunuseti). \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"In de zaal die is gewijd aan kosmische tijd, word je omringd door wanden vol landschappen uit verschillende tijden.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kunst en samenleving komen samen\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Terwijl \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" zich afspeelt op de bovenste drie verdiepingen van het Collectiegebouw, is het Dommelplein op de begane grond een plek voor ontmoeting en samenwerking. Kunstenaars, ontwerpers, bezoekers en denkers werken hier samen met lokale partners zoals Archipel, Design Academy Eindhoven, Studio Woensel West en Tante Netty. Hier ontmoeten kunst en samenleving elkaar in nieuwe manieren van maken, verzamelen en ervaren.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kunstenaars\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"In \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" zijn meer dan 250 kunstwerken te zien van: Can Altay, Brook Andrew, Karel Appel, Rasheed Araeen, Mercedes Azpilicueta, Francis Bacon, Jo Baer, Gerrit van Bakel, Ernst Barlach, Robert Barry, Max Beckmann, Marcel van den Berg, Pieke Bergmans, Joseph Beuys, Rossella Biscotti, Ansuya Blom, Georges Braque, Marcel Broodthaers, stanley brouwn, Günter Brus, Simnikiwe Buhlungu, Kees Buurman, André Cadere, Heinrich Campendonk, Hendrik Chabot, Marc Chagall, Edgar Cleijne, Constant, Jan Elburg \u0026 Constant, Angelo Custodio, Wim van Dam, René Daniëls, Yael Davids, Nolan Oswald Dennis, Jan Dibbets, Rineke Dijkstra, Theo van Doesburg, Jean Dubuffet, Marlene Dumas,\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":8,\"version\":1},{\"mode\":\"normal\",\"text\":\"$13\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Deze collectiepresentatie wordt mede mogelijk gemaakt door:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"block\",\"fields\":{\"id\":\"6a0312fe5ccdb79d5c7eda20\",\"images\":[{\"id\":\"6a03132407dd6cdf95aa90ed\",\"link\":{\"label\":\"mondriaan fonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.mondriaanfonds.nl/\",\"openInNewTab\":true},\"image\":{\"id\":18926,\"alt\":\"mondriaan fonds\",\"copyright\":null,\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-07T09:01:39.300Z\",\"createdAt\":\"2026-05-07T09:01:39.124Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/mondriaan_fonds.png\",\"thumbnailURL\":null,\"filename\":\"mondriaan_fonds.png\",\"mimeType\":\"image/png\",\"filesize\":4310,\"width\":358,\"height\":376,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/mondriaan_fonds-350x350.png\",\"width\":350,\"height\":350,\"mimeType\":\"image/png\",\"filesize\":16498,\"filename\":\"mondriaan_fonds-350x350.png\"},\"card\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null},\"tablet\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null},\"hero\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}}}},{\"id\":\"6a03134f07dd6cdf95aa90ee\",\"link\":{\"label\":\"bartimeus\",\"linkType\":\"external\",\"externalUrl\":\"https://bartimeusfonds.nl/\",\"openInNewTab\":true},\"image\":{\"id\":23411,\"alt\":\"bartimeus\",\"copyright\":null,\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-12T11:48:25.394Z\",\"createdAt\":\"2026-05-12T11:48:25.214Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/bartimeus_fonds.png\",\"thumbnailURL\":null,\"filename\":\"bartimeus_fonds.png\",\"mimeType\":\"image/png\",\"filesize\":62474,\"width\":800,\"height\":156,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/bartimeus_fonds-350x350.png\",\"width\":350,\"height\":350,\"mimeType\":\"image/png\",\"filesize\":56153,\"filename\":\"bartimeus_fonds-350x350.png\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/bartimeus_fonds-480x94.png\",\"width\":480,\"height\":94,\"mimeType\":\"image/png\",\"filesize\":28091,\"filename\":\"bartimeus_fonds-480x94.png\"},\"tablet\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/bartimeus_fonds-768x150.png\",\"width\":768,\"height\":150,\"mimeType\":\"image/png\",\"filesize\":58902,\"filename\":\"bartimeus_fonds-768x150.png\"},\"hero\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}}}},{\"id\":\"6a0313ae07dd6cdf95aa90ef\",\"link\":{\"label\":\"het cultuurfonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.cultuurfonds.nl/\",\"openInNewTab\":true},\"image\":{\"id\":23412,\"alt\":\"het cultuurfonds\",\"copyright\":null,\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-12T11:49:19.110Z\",\"createdAt\":\"2026-05-12T11:49:18.420Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/het_cultuurfonds.png\",\"thumbnailURL\":null,\"filename\":\"het_cultuurfonds.png\",\"mimeType\":\"image/png\",\"filesize\":30559,\"width\":800,\"height\":308,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/het_cultuurfonds-350x350.png\",\"width\":350,\"height\":350,\"mimeType\":\"image/png\",\"filesize\":12486,\"filename\":\"het_cultuurfonds-350x350.png\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/het_cultuurfonds-480x185.png\",\"width\":480,\"height\":185,\"mimeType\":\"image/png\",\"filesize\":14749,\"filename\":\"het_cultuurfonds-480x185.png\"},\"tablet\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/het_cultuurfonds-768x296.png\",\"width\":768,\"height\":296,\"mimeType\":\"image/png\",\"filesize\":29436,\"filename\":\"het_cultuurfonds-768x296.png\"},\"hero\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}}}},{\"id\":\"6a0313e507dd6cdf95aa90f0\",\"link\":{\"label\":\"zabawas\",\"linkType\":\"external\",\"externalUrl\":\"https://www.zabawas.nl/\",\"openInNewTab\":false},\"image\":{\"id\":23413,\"alt\":\"zabawas\",\"copyright\":null,\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-12T11:50:13.918Z\",\"createdAt\":\"2026-05-12T11:50:12.920Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/zabawas.png\",\"thumbnailURL\":null,\"filename\":\"zabawas.png\",\"mimeType\":\"image/png\",\"filesize\":74410,\"width\":552,\"height\":142,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/zabawas-350x350.png\",\"width\":350,\"height\":350,\"mimeType\":\"image/png\",\"filesize\":67291,\"filename\":\"zabawas-350x350.png\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/zabawas-480x123.png\",\"width\":480,\"height\":123,\"mimeType\":\"image/png\",\"filesize\":47182,\"filename\":\"zabawas-480x123.png\"},\"tablet\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null},\"hero\":{\"url\":null,\"width\":null,\"height\":null,\"mimeType\":null,\"filesize\":null,\"filename\":null}}}}],\"blockName\":\"\",\"blockType\":\"partners-logos\",\"logosHeight\":40},\"format\":\"\",\"version\":2},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Het Dommelplein wordt mede mogelijk gemaakt door:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"block\",\"fields\":{\"id\":\"6a03130f5ccdb79d5c7eda21\",\"images\":[{\"id\":\"6a03141007dd6cdf95aa90f1\",\"link\":{\"label\":\"vsb fonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.vsbfonds.nl/\",\"openInNewTab\":true},\"image\":{\"id\":18932,\"alt\":\"vsb fonds\",\"copyright\":null,\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-07T09:23:54.999Z\",\"createdAt\":\"2026-05-07T09:23:54.826Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/vsb_fonds.png\",\"thumbnailURL\":null,\"filename\":\"vsb_fonds.png\",\"mimeType\":\"image/png\",\"filesize\":51878,\"width\":626,\"height\":140,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/vsb_fonds-350x350.png\",\"width\":350,\"height\":350,\"mimeType\":\"image/png\",\"filesize\":51974,\"filename\":\"vsb_fonds-350x350.png\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/vsb_fonds-480x107.png\",\"width\":480,\"height\":107,\"mimeType\":\"image