ze\":\"big\",\"collectionType\":\"events\",\"selectionMode\":\"all\",\"filterType\":null,\"filterIsFeatured\":false,\"enableDateFilter\":false,\"parentPage\":null,\"reviewState\":\"published\",\"sortField\":\"title\",\"sortOrder\":\"asc\",\"limit\":null,\"showTag\":false,\"showDate\":false,\"showCount\":false,\"showContentType\":false,\"showNotFound\":false,\"blockName\":null,\"dateFilters\":[{\"id\":\"6a2aa3c35122eacae97cf787\",\"dateField\":\"eventStarts\",\"operator\":\"beforeToday\",\"value\":null,\"valueFrom\":null,\"valueTo\":null},{\"id\":\"6a9aca45aa25fe42d769db80\",\"dateField\":\"eventEnds\",\"operator\":\"afterToday\",\"value\":null,\"valueFrom\":null,\"valueTo\":null}],\"blockType\":\"collections-block\",\"headline\":\"Tentoonstellingen Dommelplein\",\"cta\":{\"enableCta\":false,\"linkType\":\"internal\",\"label\":null,\"externalUrl\":null,\"openInNewTab\":false,\"url\":null},\"tag\":[{\"id\":32,\"name\":\"dommelplein\",\"generateSlug\":false,\"slug\":\"dommelplein\",\"updatedAt\":\"2026-05-12T12:25:27.256Z\",\"createdAt\":\"2026-05-12T12:25:27.256Z\"}],\"selected_pages\":[],\"selected_events\":[],\"selected_artworks\":[],\"selected_authors\":[],\"selected_exhibitions\":[],\"selected_publications\":[]},{\"id\":\"6ab38955e87d383883f21d96\",\"variation\":\"cards\",\"headlineSize\":\"big\",\"collectionType\":\"events\",\"selectionMode\":\"all\",\"filterType\":null,\"filterIsFeatured\":false,\"enableDateFilter\":false,\"parentPage\":null,\"reviewState\":\"published\",\"sortField\":\"createdAt\",\"sortOrder\":\"asc\",\"limit\":null,\"showTag\":false,\"showDate\":false,\"showCount\":false,\"showContentType\":false,\"showNotFound\":false,\"blockName\":null,\"dateFilters\":[],\"blockType\":\"collections-block\",\"headline\":\"Doorlopend\",\"cta\":{\"enableCta\":false,\"linkType\":\"internal\",\"label\":null,\"externalUrl\":null,\"openInNewTab\":false,\"url\":null},\"tag\":[{\"id\":47,\"name\":\"doorlopend tentoonstelling\",\"generateSlug\":false,\"slug\":\"doorlopend-tentoonstelling\",\"updatedAt\":\"2026-09-23T08:13:00.948Z\",\"createdAt\":\"2026-09-23T08:13:00.948Z\"}],\"selected_pages\":[],\"selected_events\":[],\"selected_artworks\":[],\"selected_authors\":[],\"selected_exhibitions\":[],\"selected_publications\":[]},{\"id\":\"6a9acaaeaa25fe42d769db82\",\"variation\":\"big-cards\",\"headlineSize\":\"big\",\"collectionType\":\"events\",\"selectionMode\":\"manual\",\"filterType\":null,\"filterIsFeatured\":false,\"enableDateFilter\":false,\"parentPage\":null,\"reviewState\":\"any\",\"sortField\":null,\"sortOrder\":\"asc\",\"limit\":null,\"showTag\":false,\"showDate\":true,\"showCount\":false,\"showContentType\":false,\"showNotFound\":false,\"blockName\":null,\"dateFilters\":[],\"blockType\":\"collections-block\",\"headline\":\"Binnenkort\",\"cta\":{\"enableCta\":false,\"linkType\":\"internal\",\"label\":null,\"externalUrl\":null,\"openInNewTab\":false,\"url\":null},\"tag\":[],\"selected_pages\":[],\"selected_events\":[{\"id\":203,\"title\":\"Museum als Zonnewijzer\",\"summary\":\"Wat als een museum zou werken als een zonnewijzer? \",\"featuredImage\":25417,\"layout\":[{\"id\":\"6a96a7def2d7cef4807c469b\",\"blockName\":null,\"blockType\":\"content-block\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Wat als een museum zou werken als een zonnewijzer? Niet alleen door de tijd aan te geven, maar ook door ons te helpen begrijpen wat onze plek is in de wereld. Museum as Sundial is door directeur Defne Ayas ontwikkeld als een oefening in opnieuw richting vinden. Het project brengt hedendaagse kunst, design, archeologie en spel samen met collectieve manieren van leren en leven.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Dit najaar presenteert het Van Abbemuseum \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Museum als Zonnewijzer, \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"dat opent tijdens\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"Dutch Design Week. Het project benadert de zonnewijzer als eeuwenoude technologie en als hedendaags ontwerpprincipe: een manier om onze lichamen, onze gebouwen en onze communities te verbinden met de beweging van de zon, de grond onder onze voeten en de wereld buiten de muren van het museum.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Een museum gericht op de zon\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Toen het Van Abbemuseum negentig jaar geleden werd ontworpen, was het gebouw op de zon gericht. De architectuur was afgestemd op de cycli van licht en schaduw. Door verbouwingen en veranderend gebruik zijn sporen daarvan in de loop der jaren uit het zicht verdwenen. \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Museum als Zonnewijzer\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" brengt deze oorspronkelijke relatie met de zon opnieuw naar voren en stelt een actuele vraag: hoe kan een museum ons helpen richting te vinden in een tijd van grote sociale, technologische en ecologische veranderingen?\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Nieuwe manieren om ons te oriënteren\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"“Een zonnewijzer verbindt hemel en aarde. Geïnspireerd door de oorspronkelijke architectuur van het Van Abbemuseum, vragen we ons af hoe we samen nieuwe manieren kunnen ontwikkelen om richting te bepalen voor de komende tien jaar. Samen met een groep bijzondere kunstenaars en ontwerpers keren we terug naar een van de oudste manieren waarop de mens richting bepaalt: de zon. De zon is daarbij niet alleen een maat voor tijd, maar ook een bron van energie die ons met elkaar verbindt.”— Defne Ayas, Director, Van Abbemuseum\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Het museum als zonnewijzer\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Van eeuwenoude monumenten zoals Göbekli Tepe, Tiel en Stonehenge tot hedendaagse architectuur en stedenbouw: de zon helpt samenlevingen al eeuwenlang om hun positie in tijd en ruimte te bepalen. In het Van Abbemuseum wordt het gebouw zelf een zonnewijzer. De centrale museumzaal fungeert als oriëntatiepunt. Van daaruit strekken de omliggende zalen zich als vectoren naar buiten uit en verbinden ze kunstwerken en ideeën met locaties in Eindhoven en ver daarbuiten.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kunstenaars, ontwerpers en collecties\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Deelnemende kunstenaars, ontwerpers en System Thinkers zijn Ana María Millán, ADEZIV Network, EDHV, Kiki \u0026 Joost, Adele Dipasquale, Gala Porras-Kim, Michael Portnoy, Paul Panhuysen, Ayumi Paul, Ei Arakawa-Nash en John Körmeling. Het archief- en collectiemateriaal omvat werken uit de Rhoda Kellogg International Child Art Collection, ABC-boeken van kunstenaars, het Nationaal Archief van Brabantse Volksliederen en mandalatekeningen van Anne Frank, in bruikleen van Anne Frank Huis. Het ruimtelijk ontwerp is van Studio Diogo Passarinho, met een grafische interventie van Studio Remco van Bladel en architectonische installatie The Fifth Place door Christian Wassmann.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Samenstelling en curatie credits\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Onder leiding van Defne Ayas, gezamenlijk geïnspireerd en ontwikkeld. Gecoördineerd door Abril Cisneros Ramírez (assistent-curator), met genereuze bijdragen van Yolande Zola Zoli van der Heide (senior curator), Steven ten Thije (hoofd Collectie en momenteel interim-bedrijfsdirecteur), Maziar Afrassiabi (curator) en anderen. Het project is ontwikkeld in dialoog met het museumteam, waaronder het museumkoor en de vrijwilligers.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Met speciale dank aan het Anne Frank Museum, Boekenberg Eindhoven, Christian van der Linde, Helène en Raphael Panhuysen, Magda Boutique Eindhoven, Nico Arts en The Watermill Center.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"block\",\"fields\":{\"id\":\"6aa941774e1f977b357a8f8e\",\"images\":[{\"id\":\"6aa941d96399868c8353090c\",\"link\":{\"label\":\"Mondriaan Fonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.mondriaanfonds.nl/\",\"openInNewTab\":true},\"image\":21102},{\"id\":\"6aa942066399868c8353090d\",\"link\":{\"label\":\"Vrienden Loterij\",\"linkType\":\"external\",\"externalUrl\":\"https://www.vriendenloterij.nl/\",\"openInNewTab\":true},\"image\":26966}],\"blockName\":\"\",\"blockType\":\"partners-logos\",\"logosHeight\":60},\"format\":\"\",\"version\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"generateSlug\":false,\"slug\":\"museum-als-zonnewijzer\",\"urlParentPage\":10,\"fullPath\":\"zien-en-doen/tentoonstellingen/museum-als-zonnewijzer\",\"eventStarts\":\"2026-10-17T09:00:00.000Z\",\"eventEnds\":\"2027-02-21T16:00:00.000Z\",\"wholeDay\":false,\"openEnd\":false,\"location\":\"Oudbouw\",\"contactName\":null,\"contactEmail\":null,\"recurrenceDescription\":null,\"recurrence\":null,\"changeNote\":null,\"isFeatured\":false,\"publishingDate\":null,\"expirationDate\":null,\"tags\":[1],\"relatedItems\":[205,213,208,216,215,209],\"meta\":{\"title\":null,\"description\":null,\"image\":null,\"noindex\":false,\"nofollow\":false},\"updatedAt\":\"2026-10-15T10:08:51.552Z\",\"createdAt\":\"2026-09-01T10:24:20.011Z\",\"_status\":\"published\"}],\"selected_artworks\":[],\"selected_authors\":[],\"selected_exhibitions\":[],\"selected_publications\":[]}],\"taxonomies\":{\"tags\":[]},\"parent\":9,\"breadcrumbs\":[{\"doc\":9,\"url\":\"zien-en-doen\",\"label\":\"zien \u0026 doen\",\"id\":\"def16673553d032b74c1e6d0\"},{\"doc\":10,\"url\":\"zien-en-doen/tentoonstellingen\",\"label\":\"Tentoonstellingen\",\"id\":\"b721eb115eccf91c53a01631\"}],\"meta\":{\"title\":null,\"description\":null,\"image\":null,\"noindex\":false,\"nofollow\":false},\"updatedAt\":\"2026-09-23T08:17:14.615Z\",\"createdAt\":\"2026-04-22T16:53:12.165Z\",\"_status\":\"published\"},\"fullPath\":\"zien-en-doen/tentoonstellingen/collectie-als-kosmos\",\"eventStarts\":\"2026-06-05T22:00:00.000Z\",\"eventEnds\":\"2030-05-02T15:00:00.000Z\",\"wholeDay\":true,\"openEnd\":false,\"location\":null,\"contactName\":null,\"contactEmail\":null,\"recurrenceDescription\":\"\",\"recurrence\":null,\"changeNote\":null,\"isFeatured\":true,\"publishingDate\":null,\"expirationDate\":null,\"tags\":[{\"id\":1,\"name\":\"Tentoonstelling\",\"generateSlug\":false,\"slug\":\"tentoonstelling\",\"updatedAt\":\"2026-04-22T17:01:46.460Z\",\"createdAt\":\"2026-04-22T17:01:46.459Z\"}],\"relatedItems\":[{\"id\":16,\"title\":\"Opening Collectie als kosmos\",\"summary\":\"Op zaterdag 6 juni 2026 opent het Van Abbemuseum feestelijk opnieuw zijn deuren!\",\"featuredImage\":{\"id\":23498,\"alt\":null,\"copyright\":\"Foto: Lisa van Katwijk\",\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-13T13:10:48.805Z\",\"createdAt\":\"2026-05-13T13:10:46.792Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889.jpeg\",\"thumbnailURL\":null,\"filename\":\"preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889.jpeg\",\"mimeType\":\"image/jpeg\",\"filesize\":3145093,\"width\":3599,\"height\":2705,\"focalX\":50,\"focalY\":50,\"sizes\":{\"thumbnail\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889-350x350.jpg\",\"width\":350,\"height\":350,\"mimeType\":\"image/jpeg\",\"filesize\":16440,\"filename\":\"preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889-350x350.jpg\"},\"card\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889-480x361.jpg\",\"width\":480,\"height\":361,\"mimeType\":\"image/jpeg\",\"filesize\":21010,\"filename\":\"preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889-480x361.jpg\"},\"tablet\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889-768x577.jpg\",\"width\":768,\"height\":577,\"mimeType\":\"image/jpeg\",\"filesize\":46141,\"filename\":\"preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889-768x577.jpg\"},\"hero\":{\"url\":\"https://cdn.vanabbemuseum.nl/media/preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889-1280x620.jpg\",\"width\":1280,\"height\":620,\"mimeType\":\"image/jpeg\",\"filesize\":87349,\"filename\":\"preview_image-3599-d1a55a9e2dc60fd8882d4be33f438889-1280x620.jpg\"}}},\"layout\":[{\"id\":\"6a02ed6cc06b56110405f006\",\"blockName\":null,\"blockType\":\"content-block\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Het museum wordt 90 jaar en we nodigen je graag uit om samen met ons dit bijzondere moment te vieren. Op deze dag presenteren we een volledig vernieuwd museum: de opening van \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a02ed709d1d016fb010ad23\",\"type\":\"link\",\"fields\":{\"url\":\"https://vanabbemuseum.nl/nl/zien-en-doen/tentoonstellingen/collectie-als-kosmos\",\"newTab\":false,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":10,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\", onze nieuwe collectiepresentatie; \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a02ed709d1d016fb010ad24\",\"type\":\"link\",\"fields\":{\"url\":\"https://vanabbemuseum.nl/nl/zien-en-doen/tentoonstellingen/dommelplein\",\"newTab\":false,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"Dommelplein\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":10,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\", onze nieuwe publieke begane grond; een opnieuw ontworpen entreegebied en een vernieuwd café. Een mijlpaal voor het museum én voor de stad Eindhoven.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Een nieuwe collectiepresentatie: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Collectie als kosmos\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" laat je anders kijken naar kunst én naar tijd. Waar musea kunstwerken vaak op een vaste tijdlijn presenteren, brengt deze tentoonstelling werken uit verschillende periodes samen, alsof het sterren aan een hemel zijn. Geïnspireerd door de Griekse betekenis van het woord ‘kosmos’, dat zowel ‘orde’ als ‘versiering’ betekent, zijn in de zalen ‘sterrenbeelden’ van kunstwerken opgesteld, waarmee nieuwe manieren om tijd te beleven ontstaan. De tentoonstelling opent met \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Andromeda\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" van de Italiaanse barokschilder Guercino en eindigt bij de Pleiaden: een sterrencluster dat onderdeel is van een werk van Nolan Oswald Dennis. Onderweg kom je onder meer een \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"grotto\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" tegen met persoonlijke objecten. Deze voorwerpen werden uitgeleend door 90 museumvrienden die hun persoonlijke verhalen verbonden aan werken uit de collectie. In de museumtoren vind je de 24 meter lange \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Sonic Celestial Rope – Dodecagon Infinite Curl in Red Staccato \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"van Haegue Yang, waarvan de bellen dagelijks rinkelen wanneer de zon recht boven Eindhoven staat. Zo wordt voelbaar dat de kosmos niet ver weg is, maar zich ook hier bevindt: te midden van de kunstwerken, boven en onder onze voeten.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Dommelplein\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\": de nieuwe publieke begane grond\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Dommelplein \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"is de nieuwe, publieke begane grond van het museum, die volop kansen biedt voor artistiek en maatschappelijk experiment. Er is plek voor langlopende projecten die zich gaandeweg blijven ontwikkelen. Zo is er het dagelijkse waterritueel\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"L’Atelier Aquarelle dans l’eau \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"van Sarkis, de \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Feminist School of Painting \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"van Ad Minoliti - een vierjarig traject voor collectief leren, opgezet samen met lokale kunstenaars, activisten en onderzoekers - en \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Ghost Feed\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" van john gerrard. Ook \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Geo—Design\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\", een project van Design Academy Eindhoven, gecureerd door Merve Bedir en Metahaven, maakt deel uit van het programma. Daarnaast werkt Ayoung Kim hier aan een nieuwe versie van haar speculatieve \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Delivery Dancer\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"-universum, waarin zij haar eigen kosmologie rond tijd, migratie en simulatie verder uitbouwt. \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Dommelplein \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"is bovendien een plek voor samenwerkingen met lokale partners zoals ADEZIV, Archipel, Studio Woensel-West en Tante Netty. Zo profileert het museum zich steeds meer als een gedeelde publieke ruimte voor experiment, zorg en ontmoeting.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Een vernieuwd Van Abbe café\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Een gerenoveerd museumcafé, ontworpen door Daphna Laurens, wordt een warme, eigentijdse ontmoetingsplek voor bezoekers en buurtbewoners. Met uitzicht op de Dommel is het een fijne plek om te pauzeren of een goed gesprek te voeren. Op de menukaart staan ​de lekkerste soepen van het seizoen, verse broodjes, uitstekende koffie en een zorgvuldig samengestelde wijnselectie.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Entreegebied\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Een uitnodigende, open entree, ontworpen door Van Eijk \u0026 Van der Lubbe, die het museum toegankelijker maakt en aansluit bij onze missie om een fijne ontmoetingsplaats te zijn.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ben je erbij?\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"We hopen je op zaterdag 6 juni 2026 te mogen verwelkomen. Noteer deze datum alvast in je agenda. Binnenkort maken we het volledige programma op onze website bekend en kun je je aanmelden.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Collectie als kosmos \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"wordt mede mogelijk gemaakt door:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"block\",\"fields\":{\"id\":\"6a1e043096e7fd2dec07cfdf\",\"images\":[{\"id\":\"6a1e0433e758c123ad016f19\",\"link\":{\"label\":\"mondriaan fonds\",\"linkType\":\"external\",\"externalUrl\":\"https://www.mondriaanfonds.nl/\",\"openInNewTab\":true},\"image\":{\"id\":18926,\"alt\":\"mondriaan fonds\",\"copyright\":null,\"source\":null,\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2026-05-07T09:01:39.300Z\",\"createdAt\":\"2026-05-07T09:01:39.124Z\",\"url\":\"https://cdn.vanabbemuseum.nl/media/mondriaan_fonds.png\",\"thumbnailURL\":null,\"filename\":\"