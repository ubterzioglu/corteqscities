         (max-width: 983px) 33vw,                                 
         640px" srcSet="/_next/image?url=https%3A%2F%2Fwww.mensenrechten.nl%2Fsite%2Fbinaries%2Fcontent%2Fgallery%2Fsite-content%2Fcontent-afbeeldingen%2Frechtsstaat%2Fhighres-pydhmvn-binnenhof-vanaf-vijverberg.jpg&amp;w=256&amp;q=70 256w, /_next/image?url=https%3A%2F%2Fwww.mensenrechten.nl%2Fsite%2Fbinaries%2Fcontent%2Fgallery%2Fsite-content%2Fcontent-afbeeldingen%2Frechtsstaat%2Fhighres-pydhmvn-binnenhof-vanaf-vijverberg.jpg&amp;w=384&amp;q=70 384w, /_next/image?url=https%3A%2F%2Fwww.mensenrechten.nl%2Fsite%2Fbinaries%2Fcontent%2Fgallery%2Fsite-content%2Fcontent-afbeeldingen%2Frechtsstaat%2Fhighres-pydhmvn-binnenhof-vanaf-vijverberg.jpg&amp;w=860&amp;q=70 860w, /_next/image?url=https%3A%2F%2Fwww.mensenrechten.nl%2Fsite%2Fbinaries%2Fcontent%2Fgallery%2Fsite-content%2Fcontent-afbeeldingen%2Frechtsstaat%2Fhighres-pydhmvn-binnenhof-vanaf-vijverberg.jpg&amp;w=1536&amp;q=70 1536w, /_next/image?url=https%3A%2F%2Fwww.mensenrechten.nl%2Fsite%2Fbinaries%2Fcontent%2Fgallery%2Fsite-content%2Fcontent-afbeeldingen%2Frechtsstaat%2Fhighres-pydhmvn-binnenhof-vanaf-vijverberg.jpg&amp;w=2560&amp;q=70 2560w" src="/_next/image?url=https%3A%2F%2Fwww.mensenrechten.nl%2Fsite%2Fbinaries%2Fcontent%2Fgallery%2Fsite-content%2Fcontent-afbeeldingen%2Frechtsstaat%2Fhighres-pydhmvn-binnenhof-vanaf-vijverberg.jpg&amp;w=2560&amp;q=70"/></div></figure><div class="card__content"><h3 class="card__title">De rechtsstaat beschermt ons allemaal</h3><div class=""><p class="card__text">Mensenrechten vormen de basis van de democratische rechtsstaat. Ontdek hoe de rechtsstaat werkt en hoe die onze rechten beschermt.</p><div class="meta-data card__meta-data"><span>Beeld: © Rijksvastgoedbedrijf / Robin Hoogervorst</span></div></div><div class="link-plus card__more-link"><i class="svg-icon chevron-right link-plus__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="320" height="512" viewBox="0 0 320 512" role="presentation" aria-hidden="true"><path d="M46.46,459.63h0c-14.46-10.84-18.08-32.53