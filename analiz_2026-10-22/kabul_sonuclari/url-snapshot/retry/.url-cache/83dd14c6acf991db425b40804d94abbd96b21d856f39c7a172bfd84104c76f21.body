    <style>
        .module-masthead-video{
	position: relative;

	&:after{
		content: '';
		position: absolute;
		z-index: 6;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba($color-black, 0.2);
	}
	.ratio{
		&:before{
			@include break-up(md){
				padding-top: calc(100vh - 14rem);
			}
		}
	}
	&__content{
		position: absolute;
		z-index: 8;
		bottom: 1rem;
		left: 1rem;
		width: calc(100% - 3rem);

		@include break-up(md){
			bottom: 4rem;
			left: 4rem;
			width: calc(100% - 4rem);
		}
	}
	&__controls{
		position: absolute;
		z-index: 8;
		top: calc(50% - 2rem);
		@include translate(0, -50%);
		right: 0;
		background: $color-white;
		border-radius: 1rem 0 0 1rem;
		padding: 0.5rem 0;

		@include break-up(md){
			top: calc(50% - 3rem);
		}

		i{
			width: 2rem;
			padding: 0.5rem 0;
			font-size: 1rem;
			color: $color-black;

			@include break-up(md){
				width: 3rem;
				font-size: 1.5rem;
			}
		}			
	}
	&__video-control{
		&--play{
			display: none;
		}
		&--pause{
			display: block;
		}		
	}
	&__audio-control{	
		&--unmute{
			display: block;
		}
		&--mute{
			display: none;
		}		
	}
	&__breadcrumbs{
		position: relative;
		z-index: 8;
		padding: 1rem 1.25rem;
		background-color: $color-white;
		p{
			margin: 0;
		}
		.separator{
			padding: 0 .2rem;
		}
	}

	.scroll-icon{
		position: absolute;
		top: calc(100% - 1.75rem);
		height: auto;
		z-index: 9;
		width: 3.5rem;
		display: block;
		left: 50%;
		opacity: 1;
		@include translate(-50%, 0);		
		@include transition(all, 200ms, ease-in-out);

		&.minified{
			opacity: 0;
		}
	}	
	.module-masthead-video__content {
		position: absolute;
		z-index: 8;
		bottom: 1rem;
		left: 1rem;
		width: calc(100% - 3rem);
		.wysiwyg{
            margin: 0;
			color: #fff !important;
			h1,p,h2,h3,h4,h5,button,a{
				color: #fff !important;
				text-shadow: 2px 2px 0px rgba(0, 0, 0, .3);
			}
		}
	}
    @media (min-width: 768px) {
		.module-masthead-video__content {
			bottom: 4rem;
			left: 4rem;
			width: calc(100% - 4rem);
		}
	}
}

    </style>
