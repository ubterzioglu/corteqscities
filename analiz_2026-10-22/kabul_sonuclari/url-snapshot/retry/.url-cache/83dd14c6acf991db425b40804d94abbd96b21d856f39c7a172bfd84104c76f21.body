        <script>
            (function() {
                function initAcfPopup() {
                    var el = document.getElementById('acfPopup');
                    if (!el || !window.bootstrap || !bootstrap.Modal) {
                        return;
                    }

                    el.addEventListener('hidden.bs.modal', function() {
                        // Stel een sessie-item in om de pop-up niet opnieuw te tonen in dezelfde sessie
                        sessionStorage.setItem('popup_closed', 'true');
                    });

                    // Controleren of de pop-up al is gesloten in de huidige sessie
                    if (!sessionStorage.getItem('popup_closed')) {
                        bootstrap.Modal.getOrCreateInstance(el).show();
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initAcfPopup);
                } else {
                    initAcfPopup();
                }
            })();
        </script>
