<section class="col-12 col-lg-8 pane pane--default" data-pane-type="nationalities-select">
  <div class="container ">
    <div class="no-gutters row">
      <div class="col-12">
                                                      <div class="pane__content">
            <div class="nationality-select">
          <div id="nationalities-select-form"><form class="ind-purpose-of-stay-select-one-nationality ind-purpose-of-stay-select-nationalities-step1" data-number-of-nationalities="1" data-drupal-selector="ind-purpose-of-stay-select-one-nationality" action="/en/residence-permits/work/residence-permit-for-orientation-year" method="post" id="ind-purpose-of-stay-select-one-nationality" accept-charset="UTF-8">
  <h2>Your situation</h2><div class="data-disclaimer"><p><span>We will first ask you a few questions. We use your answers to give you information that applies to your situation. Your details will not be saved or shared with others.</span></p></div>


<div class="form-item js-form-item form-item-nationality-1 form-type-purpose-of-stay-entity-autocomplete">
      <label for="edit-nationality-1">What is your nationality?
      </label>
  
  

  
  
    <input  data-drupal-selector="edit-nationality-1" class="form-autocomplete form-text" data-autocomplete-path="/en/entity_reference_autocomplete/taxonomy_term/default/m-CW5-CBriGTJoxwKw7YSELC6Vsw3lTeKTifuqhaxHs" type="text" id="edit-nationality-1" name="nationality_1" value="" maxlength="128">

  
  
