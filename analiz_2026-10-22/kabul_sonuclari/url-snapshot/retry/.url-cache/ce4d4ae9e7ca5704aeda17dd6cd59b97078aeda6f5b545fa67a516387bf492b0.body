					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="nl" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><table class="infobox" cellpadding="1" cellspacing="1" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox molen\n","href":"./Sjabloon:Infobox_molen"},"params":{"naam":{"wt":"Genneper watermolen"},"afbeelding":{"wt":"Gennepermolen-1.jpg"},"onderschrift":{"wt":"De watermolen"},"plaats":{"wt":"Eindhoven-Gestel"},"bouwjaar":{"wt":"vóór 1249"},"type":{"wt":"[[Watermolen (door water aangedreven molen)|watermolen]]"},"kenmerken":{"wt":"onderslagmolen"},"rad":{"wt":"6 m"},"functie":{"wt":"[[korenmolen]]"},"bestemming":{"wt":""},"restauraties":{"wt":"1963"},"oorspronkelijk gebruik":{"wt":""},"huidig gebruik":{"wt":""},"monumentnummer":{"wt":"14639"},"molendatabase-nl":{"wt":"517"},"molendatabase-Hollandsche Molen":{"wt":"&lt;!--was het verkeerde nummer-->"},"website":{"wt":""},"afbeelding2":{"wt":"Gennepermolen-2.jpg"},"onderschrift2":{"wt":"Het rad van de watermolen"}},"i":0}}]}'> 
<tbody><tr><th class="infobox-kop notheme" style="background-color:lightgrey; color:inherit; text-align:center; font-size:120%;" colspan="3">Genneper watermolen</th></tr>
