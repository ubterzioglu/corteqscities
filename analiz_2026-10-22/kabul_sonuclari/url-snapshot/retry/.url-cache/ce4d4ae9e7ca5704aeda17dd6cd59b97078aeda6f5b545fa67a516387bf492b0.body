<td style="text-align:center; padding:0;" colspan="3"><span typeof="mw:File"><a href="https://nl.wikipedia.org/wiki/Bestand:Gennepermolen-1.jpg" class="mw-file-description"><img resource="https://nl.wikipedia.org/wiki/Bestand:Gennepermolen-1.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Gennepermolen-1.jpg/330px-Gennepermolen-1.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Gennepermolen-1.jpg/960px-Gennepermolen-1.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="De watermolen" data-file-width="3008" data-file-height="2000" data-file-type="bitmap" height="177" width="266" class="mw-file-element"/></a></span></td></tr>
<tr>
<td style="text-align:center;" colspan="3"><div style="font-size:90%">De watermolen</div></td></tr>
<tr>












<th class="infobox-kop notheme" style="background-color:lightgrey; color:inherit; text-align:center;" colspan="3">Basisgegevens</th></tr>
