					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="nl" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><table class="infobox" cellpadding="1" cellspacing="1" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox straat\n","href":"./Sjabloon:Infobox_straat"},"params":{"afbeelding":{"wt":"Stadhuisplein Eindhoven panorama (2025).jpg"},"onderschrift":{"wt":"Het Stadhuisplein in 2025"},"locatie":{"wt":"[[Eindhoven]]"},"stadsdeel":{"wt":"[[Eindhoven Centrum|Centrum]]"},"lat_deg":{"wt":"51"},"lat_min":{"wt":"26"},"lat_sec":{"wt":"07.6"},"lat_dir":{"wt":"N"},"lon_deg":{"wt":"5"},"lon_min":{"wt":"28"},"lon_sec":{"wt":"48.5"},"lon_dir":{"wt":"E"},"postcode":{"wt":"5611 EM"}},"i":0}}]}'> 
<tbody><tr><th class="infobox-kop notheme" style="background-color:#ece5ca; color:inherit; text-align:center; font-size:120%;" colspan="3">Stadhuisplein</th></tr>
<tr>











<td style="text-align:center; padding:0;" colspan="3"><span typeof="mw:File"><a href="https://nl.wikipedia.org/wiki/Bestand:Stadhuisplein_Eindhoven_panorama_(2025).jpg" class="mw-file-description"><img resource="https://nl.wikipedia.org/wiki/Bestand:Stadhuisplein_Eindhoven_panorama_(2025).jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Stadhuisplein_Eindhoven_panorama_%282025%29.jpg/330px-Stadhuisplein_Eindhoven_panorama_%282025%29.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Stadhuisplein_Eindhoven_panorama_%282025%29.jpg/960px-Stadhuisplein_Eindhoven_panorama_%282025%29.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Het Stadhuisplein in 2025" data-file-width="8336" data-file-height="2496" data-file-type="bitmap" height="80" width="266" class="mw-file-element"/></a></span></td></tr>
<tr>
<td style="text-align:center;" colspan="3"><div style="font-size:90%">Het Stadhuisplein in 2025</div></td></tr>
<tr>









<th class="infobox-kop notheme" style="background-color:#ece5ca; color:inherit; text-align:center;" colspan="3">Locatie</th></tr>
<tr>


<th>Land</th>
<td colspan="2"><span class="mw-image-border noviewer notpageimage" typeof="mw:File" data-mw='{"caption":"Vlag van Nederland"}'><a href="https://nl.wikipedia.org/wiki/Bestand:Flag_of_the_Netherlands.svg" class="mw-file-description" title="Vlag van Nederland"><img resource="https://nl.wikipedia.org/wiki/Bestand:Flag_of_the_Netherlands.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Flag_of_the_Netherlands.svg/20px-Flag_of_the_Netherlands.svg.png?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Flag_of_the_Netherlands.svg/40px-Flag_of_the_Netherlands.svg.png?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Vlag van Nederland" data-file-width="900" data-file-height="600" data-file-type="drawing" height="13" width="20" class="mw-file-element"/></a></span><span typeof="mw:Entity"> </span><a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/Nederland_(hoofdbetekenis)" title="Nederland (hoofdbetekenis)" class="mw-redirect">Nederland</a></td></tr>
<tr>
