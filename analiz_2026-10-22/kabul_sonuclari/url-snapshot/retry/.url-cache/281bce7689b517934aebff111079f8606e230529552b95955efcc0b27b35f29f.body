					<div id="cmplz-manage-consent" data-nosnippet="true"><button class="cmplz-btn cmplz-hidden cmplz-manage-consent manage-consent-1" aria-haspopup="dialog" aria-controls="cmplz-cookiebanner-1-optin">Beheer toestemming</button>

</div>		<script>
			// [push_knop] en [push_afmeld_knop] sturen de Perfecty SDK aan. Perfecty heeft
			// geen publieke JS-API, dus we klikken op de elementen van de SDK en gebruiken
			// de localStorage-vlaggen van de SDK om te zien wanneer die klaar is.
			// Gecontroleerd tegen Perfecty Push 1.6.5: opnieuw testen na elke plugin-update.
			document.addEventListener("DOMContentLoaded", function() {

				var ondersteund = ("PushManager" in window && "serviceWorker" in navigator && "Notification" in window);
				var nietGeladen = "De meldingen-service is nog niet geladen. Probeer het over een paar seconden opnieuw. Lukt het dan nog niet, dan blokkeert mogelijk een adblocker het script.";

				// De SDK tekent vinkje, bel en aanmelddialoog altijd tegelijk, na window load.
				function sdkVinkje() {
					return document.getElementById("perfecty-push-settings-subscribed");
				}

				// Hier zet de SDK zijn foutmelding als aan- of afmelden via het vinkje mislukt.
				function sdkMelding() {
					return document.getElementById("perfecty-push-settings-notification");
				}

				// Vraagt elke 250 ms check() om een status; null betekent nog bezig.
				function wachtOpSdk(knop, tekst, check, klaar) {
					var origineel = knop.innerHTML;
					knop.disabled = true;
					knop.innerHTML = tekst;
					knop.style.opacity = "0.5";
					knop.style.cursor = "wait";

					var timer = setInterval(function() {
						var status = check();
						if (status === null) return;

						clearInterval(timer);
						knop.disabled = false;
						knop.innerHTML = origineel;
						knop.style.opacity = "";
						knop.style.cursor = "";
						klaar(status);
					}, 250);
				}

				// ==========================================
				// AANMELDEN
				// ==========================================
				document.querySelectorAll(".perfecty-trigger-aanmeld").forEach(function(knop) {
					knop.addEventListener("click", function(e) {
						e.preventDefault();

						if (!ondersteund) {
							alert("Uw browser ondersteunt geen pushmeldingen. Op een iPhone of iPad werkt dit alleen als u de site eerst aan uw beginscherm toevoegt.");
							return;
						}
						if (Notification.permission === "denied") {
							alert("U hebt pushmeldingen eerder geblokkeerd. Pas uw browser-instellingen aan om dit te deblokkeren.");
							return;
						}

						var vinkje = sdkVinkje();
						var dialoogKnop = document.getElementById("perfecty-push-dialog-subscribe");
						if (!vinkje || !dialoogKnop) {
							alert(nietGeladen);
							return;
						}

						var hadToestemming = (Notification.permission === "granted");
						if (hadToestemming && vinkje.checked) {
							alert("U bent al geabonneerd op onze meldingen.");
							return;
						}

						// De SDK zet deze vlag op "no" zodra de server de aanmelding heeft opgeslagen.
						localStorage.setItem("perfecty_register_again", "yes");
						sdkMelding().textContent = "";

						if (hadToestemming) {
							// Eerder afgemeld: via het vinkje, want alleen dat pad wist de afgemeld-vlag.
							vinkje.click();
						} else {
							// Nog geen toestemming: de dialoogknop laat de browser om toestemming vragen.
							// Die knop wist de afgemeld-vlag niet, dus dat doen we zelf.
							localStorage.setItem("perfecty_opted_out", "no");
							dialoogKnop.click();
						}

						var start = Date.now();
						var toestemmingSinds = hadToestemming ? start : 0;

						wachtOpSdk(knop, "Aanmelden verwerken...", function() {
							if (localStorage.getItem("perfecty_register_again") === "no") return "ok";
							if (sdkMelding().textContent) return "fout";

							var toestemming = Notification.permission;
							if (toestemming === "denied") return "gestopt";
							if (toestemming === "granted") {
								if (!toestemmingSinds) toestemmingSinds = Date.now();
								return Date.now() - toestemmingSinds > 15000 ? "fout" : null;
							}
							// Toestemmingsvenster nog open, of weggeklikt zonder keuze.
							return Date.now() - start > 30000 ? "gestopt" : null;
						}, function(status) {
							if (status === "ok") {
								alert("U bent geabonneerd op onze alerts.");
							} else if (status === "fout") {
								if (hadToestemming) vinkje.checked = false;
								alert("Aanmelden is niet gelukt. Probeer het later opnieuw.");
							}
						});
					});
				});

				// ==========================================
				// AFMELDEN
				// ==========================================
				document.querySelectorAll(".perfecty-trigger-afmeld").forEach(function(knop) {
					knop.addEventListener("click", function(e) {
						e.preventDefault();

						if (!ondersteund || Notification.permission !== "granted") {
							alert("U bent momenteel niet geabonneerd op onze alerts.");
							return;
						}

						var vinkje = sdkVinkje();
						if (!vinkje) {
							alert(nietGeladen);
							return;
						}
						if (!vinkje.checked) {
							alert("U bent momenteel niet geabonneerd op onze alerts.");
							return;
						}

						// De SDK zet deze vlag pas op "yes" als de server de afmelding heeft verwerkt.
						// Eerst op "no", anders zien we een oude "yes" aan voor een geslaagde afmelding.
						localStorage.setItem("perfecty_opted_out", "no");
						sdkMelding().textContent = "";
						vinkje.click();

						var start = Date.now();
						wachtOpSdk(knop, "Afmelding verwerken...", function() {
							if (localStorage.getItem("perfecty_opted_out") === "yes") return "ok";
							if (sdkMelding().textContent || Date.now() - start > 15000) return "fout";
							return null;
						}, function(status) {
							if (status === "ok") {
								alert("U bent afgemeld. U ontvangt geen meldingen meer.");
							} else {
								vinkje.checked = true;
								alert("Afmelden is niet gelukt. Probeer het later opnieuw.");
							}
						});
					});
				});

			});
		</script>
