 en partners voor ruim 70.000 bewoners in Eindhoven, Helmond en omstreken.","links":[{"$component":"link","icon":[{"id":"4BD1D168-6F50-459D-9D79-8EC9565879BA","type":"file","label":"Beeldtaal WB_reparatie","fileName":"Beeldtaal WB_reparatie.png","linkingDocuments":[],"url":"https://api.iris.databalk.app/download/media/4BD1D168-6F50-459D-9D79-8EC9565879BA","focus":"","indexable":false,"mimeType":"image/png","fileSize":38297,"tags":[],"isIcon":false,"height":945,"width":945,"updatedAt":"2026-01-08T13:46:22.618Z","title":"","alt":""}],"title":"Reparatie aanvragen","url":{"label":"","type":"collection","value":{"collection":"page","id":"c61a88bc-1ef2-415a-8191-b5a8eb4f5b25","slug":"reparatie-aanvragen","fullPath":"ik-huur/reparatie-aanvragen"},"target":"_self"}},{"$component":"link","icon":[{"id":"81D4BBCD-F475-43C3-8CF8-FDCA6D8C3F53","type":"file","label":"Beeldtaal WB_Huur en betalen (003)","fileName":"Beeldtaal WB_Huur en betalen (003).png","linkingDocuments":[],"url":"https://api.iris.databalk.app/download/media/81D4BBCD-F475-43C3-8CF8-FDCA6D8C3F53","focus":"","indexable":false,"mimeType":"image/png","fileSize":39648,"tags":[],"isIcon":false,"height":945,"width":945,"updatedAt":"2026-01-09T12:49:22.227Z","title":"","alt":""}],"title":"Huur en betalen","url":{"label":"","type":"internal","value":"/ik-huur#huren-en-betalen","target":"_self"}},{"$component":"link","icon":[{"id":"090AC91F-4846-4F5D-807E-2AE038F5DEF3","type":"file","label":"Beeldtaal WB_Buren en buurt (003)","fileName":"Beeldtaal WB_Buren en buurt (003).png","linkingDocuments":[],"url":"https://api.iris.databalk.app/download/media/090AC91F-4846-4F5D-807E-2AE038F5DEF3","focus":"","indexable":false,"mimeType":"image/png","fileSize":35246,"tags":[],"isIcon":false,"height":945,"width":1004,"updatedAt":"2026-01-09T12:49:40.307Z","title":"","alt":""}],"title":"Buren en buurt","url":{"label":"","type":"internal","value":"/ik-huur#buren-en-buurt","target":"_self"}},{"$component":"link","icon":[{"id":"A0F64482-860E-4CC8-AD21-EBACDD5416D4","type":"file","label":"Beeldtaal WB_Woning en contract (004)","fileName":"Beeldtaal WB_Woning en contract (004).png","linkingDocuments":[],"url":"https://api.iris.databalk.app/download/media/A0F64482-860E-4CC8-AD21-EBACDD5416D4","focus":"","indexable":false,"mimeType":"image/png","fileSize":27713,"tags":[],"isIcon":false,"height":945,"width":945,"updatedAt":"2026-01-09T12:50:08.518Z","title":"","alt":""}],"title":"Woning en contract","url":{"label":"","type":"internal","value":"/ik-huur#wonen-en-verhuizen","target":"_self"}}],"images":[{"$component":"media","image":[{"id":"ACD5BDF6-6F6B-4BBC-9EB0-12A504C23585","type":"file","label":"LR_Woonbedrijf_Herfst_232_LR","fileName":"LR_Woonbedrijf_Herfst_232_LR.jpg","thumbnailFileName":null,"linkingDocuments":[{"collectionSlug":"page","id":"bb4241cc-3495-4aef-bc87-d89b9b699931","displayName":"Buurten","isDraft":true,"publishedAt":"2026-05-11T10:38:48.019Z","publishStart":"2025-04-07T13:16:24.453Z","publishEnd":""},{"collectionSlug":"page","id":"bb4241cc-3495-4aef-bc87-d89b9b699931","displayName":"Buurten","isDraft":false,"publishedAt":"2026-05-11T10:38:48.019Z","publishStart":"2025-04-07T13:16:24.453Z","publishEnd":""}],"url":"https://api.iris.databalk.app/download/media/ACD5BDF6-6F6B-4BBC-9EB0-12A504C23585","focus":"","indexable":false,"tags":[],"isIcon":false,"height":1572,"width":2303,"mimeType":"image/jpeg","fileSize":1311164,"updatedAt":"2025-12-22T23:33:22.996Z","title":"","alt":""}]}],"$id":"f52edd29-f39f-4656-83bf-173d61a6e3ae","backgroundVideo":{"$component":"backgroundVideo","title":"","source":"","active":false}},{"$component":"featuredImage","title":"Uitgelicht: Ouderen Vakantieweek brengt buurtbewoners in Tongelre samen","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":"left","condition":null,"indent":null},"content":[{"type":"text","marks":[{"type":"textStyle","attrs":{"color":"rgb(86, 95, 103)"}}],"text":"“Ik woon al 44 jaar in Tongelre en heb mezelf nooit echt thuis gevoeld. Maar nu... voel ik me thuis.” Deze uitspraak deelde een oudere bewoner uit Tongelre. Hij kwam naar de Ouderen Vakantieweek bij woongemeenschap ‘t Rondeel en vond het fantastisch."}]}]},"callToAction":{"$component":"callToAction","title":"","description":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":"left","indent":null}}]},"url":{"label":"Lees meer","type":"collection","value":{"collection":"stories","id":"989751e0-79c2-4954-8691-c18fa690065b","slug":"ouderen-vakantieweek-brengt-buurtbewoners-in-tongelre-samen","fullPath":"ouderen-vakantieweek-brengt-buurtbewoners-in-tongelre-samen"},"target":"_self"}},"image":[{"id":"926991C7-06E6-438D-9EDF-741FAC7EE52A","type":"file","label":"ouderen-vakantieweek","fileName":"ouderen-vakantieweek.jpg","thumbnailFileName":null,"linkingDocuments":[{"collectionSlug":"stories","id":"989751e0-79c2-4954-8691-c18fa690065b","displayName":"Ouderen Vakantieweek brengt buurtbewoners in Tongelre samen","isDraft":true,"publishedAt":"2026-08-20T08:40:01.453Z","publishStart":"2026-08-20T08:39:49.728Z","publishEnd":""},{"collectionSlug":"stories","id":"989751e0-79c2-4954-8691-c18fa690065b","displayName":"Ouderen Vakantieweek brengt buurtbewoners in Tongelre samen","isDraft":false,"publishedAt":"2026-08-20T08:40:01.453Z","publishStart":"2026-08-20T08:39:49.728Z","publishEnd":""}],"url":"https://api.iris.databalk.app/download/media/926991C7-06E6-438D-9EDF-741FAC7EE52A","focus":"","indexable":false,"tags":[],"isIcon":false,"height":1536,"width":2048,"mimeType":"image/jpeg","fileSize":514727,"updatedAt":"2026-08-20T08:38:52.477Z","title":"","alt":""}],"id":"c4a033a0-37ed-4fbd-8298-2f31ed02e873","imagePosition":{"key":"right","value":"Rechts","slug":""}},{"$component":"newsOverview","title":"Actueel","limit":"3","moreButtonLabel":"Alles bekijken","$data":[{"id":"ae4ee790-0888-4232-b3e6-ef6c1b34c207","title":"De herfst is in volle gang! Zo houd je je woning in goede staat ","slug":"de-herfst-is-in-volle-gang-zo-houd-je-je-woning-in-goede-staat","image":[{"id":"61F26E4A-01C1-4662-B1D7-0BA71D56805A","type":"file","label":"LR_Woonbedrijf_Herfst_232_LR","fileName":"LR_Woonbedrijf_Herfst_232_LR.webp","title":"","alt":"","focus":"","mimeType":"image/webp","fileSize":587424,"tags":[],"indexable":false,"isIcon":false,"height":1572,"width":2303,"url":"https://api.iris.databalk.app/download/media/61F26E4A-01C1-4662-B1D7-0BA71D56805A","updatedAt":"2025-12-22T23:33:22.996Z"}],"date":"2026-10-21T09:09:01.335Z","excerpt":"Het is weer herfst! Dat betekent dat er weer koude en natte dagen aankomen. Dat hoort bij het seizoen, maar kan soms ook voor overlast en schade zorgen. \n\nOp deze pagina lees je waar je in de herfst op kunt letten en wat je kunt doen als je toch problemen ervaart. "},{"id":"434df7dd-74a5-4ac4-b160-26104df879f2","title":"Woonbedrijf toont eerste blik op Schellens\u0026Co tijdens Dutch Design Week","slug":"woonbedrijf-toont-eerste-blik-op-schellensco-tijdens-dutch-design-week","image":[{"id":"67D2A043-2C8D-4312-8C6B-F7BD32BD2CF3","type":"file","label":"Schellens\u0026Co_plein brouwerij_pub","fileName":"Schellens\u0026Co_plein brouwerij_pub.jpg","title":"","alt":"","focus":"","mimeType":"image/jpeg","fileSize":932233,"tags":[],"indexable":false,"isIcon":false,"height":3072,"width":5504,"url":"https://api.iris.databalk.app/download/media/67D2A043-2C8D-4312-8C6B-F7BD32BD2CF3","updatedAt":"2026-10-15T14:37:08.673Z"}],"date":"2026-10-15T14:37:28.146Z","excerpt":"Woonbedrijf toont eerste blik op nieuwbouwproject Schellens\u0026Co tijdens Dutch Design Week in Eindhoven"},{"id":"5fa2024c-7bb7-4b03-9e71-478a62e469c2","title":"Nieuwe landelijke website helpt woningzoekenden sneller naar juiste website voor sociale huurwoningen ","slug":"nieuwe-landelijke-website-helpt-woningzoekenden-sneller-naar-juiste-website-voor-sociale-huurwoninge","image":[{"id":"A9C1BA4D-48AE-40E1-BD4C-7EFFD4FC2FC5","type":"file","label":"socialehuurwoning - woordmerk","fileName":"socialehuurwoning - woordmerk.jpg","title":"","alt":"","focus":"","mimeType":"image/jpeg","fileSize":47376,"tags":[],"indexable":false,"isIcon":false,"height":1276,"width":1276,"url":"https://api.iris.databalk.app/download/media/A9C1BA4D-48AE-40E1-BD4C-7EFFD4FC2FC5","updatedAt":"2026-10-06T11:44:31.222Z"}],"date":"2026-10-06T11:59:22.562Z","excerpt":"Via de nieuwe website www.socialehuurwoning.nl worden woningzoekenden alleen doorgelinkt naar de betrouwbare (regionale) verhuurwebsites waar woningcorporaties hun woningen op adverteren."}]},{"$component":"bewonersverhalenOverview","title":"Buurt- en bewonersverhalen","limit":"3","category":[],"$data":[{"id":"6bb8a5f8-2e30-4256-9ed8-b2ee89a14cf9","title":"Expositie wandkleed van bewoners bij Woonbedrijf","slug":"expositie-wandkleed-van-bewoners-bij-woonbedrijf","image":[{"id":"21E000F3-EE29-4B0F-8CD4-6092CA95454C","type":"file","label":"wandkleed header","fileName":"wandkleed header.jpg","title":"","alt":"","focus":"56.4px54.6p","mimeType":"image/jpeg","fileSize":3464099,"tags":[],"indexable":false,"isIcon":false,"height":3766,"width":5548,"url":"https://api.iris.databalk.app/download/media/21E000F3-EE29-4B0F-8CD4-6092CA95454C","updatedAt":"2026-09-09T13:03:03.198Z"}],"date":"2026-09-09T13:08:01.287Z","excerpt":"Sinds september hangt er een kleurrijk wandkleed in onze Woonwinkel aan de Wal. Het bestaat uit allemaal kleine haakwerkjes van 15 x 15 centimeter. Deze zijn gemaakt door buurtbewoners (vooral uit Woensel-Zuid). Daarna zijn ze aan elkaar gemaakt en vormt het een groot kleurrijk kleed van 6 x 4 meter. Kinderen van een Islamitische basisschool hebben de vlechtjes hangend aan het kleed gemaakt."},{"id":"f1181d18-883a-4349-9c04-cdfb9a5cda01","title":"Een goede buur zijn: volgens Tiny hoeft het niet moeilijk te zijn","slug":"een-goede-buur-zijn-volgens-tiny-hoeft-het-niet-moeilijk-te-zijn","image":[{"id":"12784F72-0E06-4724-B70B-0A2FDC3AB8C1","type":"file","label":"processed-7A469F19-9581-40DB-9D17-6D20B18BFE98","fileName":"processed-7A469F19-9581-40DB-9D17-6D20B18BFE98.jpeg","title":"","alt":"","focus":"","mimeType":"image/jpeg","fileSize":183612,"tags":[],"indexable":false,"isIcon":false,"height":682,"width":1221,"url":"https://api.iris.databalk.app/download/media/12784F72-0E06-4724-B70B-0A2FDC3AB8C1","updatedAt":"2026-08-27T12:24:48.250Z"}],"date":"2026-08-27T12:23:07.360Z","excerpt":"Is het warm in de achtertuin? Dan zit Tiny het liefste in de voortuin, in de schaduw. Zo kan ze gezellig met andere bewoners uit de buurt kletsen."},{"id":"c165f2d0-3ac1-4823-9da0-2d64b287d64c","title":"Meneer Groenen: “Iedereen wilde mijn duiven kopen maar ik ga niet tegen m’n eigen duiven vliegen!” ","slug":"meneer-groenen-iedereen-wilde-mijn-duiven-kopen-maar-ik-ga-niet-tegen-mn-eigen-duiven-vliegen","image":[{"id":"242DA93E-55CB-4D3C-962B-F3408E029FAC","type":"file","label":"processed-97C67CC8-208F-42CD-B077-8FD93C94001E","fileName":"processed-97C67CC8-208F-42CD-B077-8FD93C94001E.jpeg","title":"","alt":"","focus":"","mimeType":"image/jpeg","fileSize":386543,"tags":[],"indexable":false,"isIcon":false,"height":1816,"width":2420,"url":"https://api.iris.databalk.app/download/media/242DA93E-55CB-4D3C-962B-F3408E029FAC","updatedAt":"2026-08-27T12:05:49.703Z"}],"date":"2026-08-27T12:12:01.096Z","excerpt":"Tijdens een reparatieverzoek maken we een praatje met bewoner Kees Groenen. Hij woont al meer dan 60 jaar in Eindhoven en heeft een bijzondere verzameling aan trofeeën. "}]}],"requireAuth":false,"seo":{"$component":"seo","title":null,"description":null,"tags":null,"isNotIndexable":false}},"__tenant":"woonbedrijf","__page":"index","__slug":[]}},"page":"/_sites/[tenant]","query":{"tenant":"woonbedrijf"},"buildId":"8GRpTx-VEG-gCoTmkHRpa","isFallback":false,"isExperimentalCompile":false,"dynamicIds":[662649,837877,327947],"gsp":true,"appGip":true,"scriptLoader":[]}</script></body></html>