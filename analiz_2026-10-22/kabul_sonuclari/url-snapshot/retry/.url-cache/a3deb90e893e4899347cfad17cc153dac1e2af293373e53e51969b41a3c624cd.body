</section><section data-mw-section-id="8" id="mwcQ" aria-labelledby="Externe_links"><div class="mw-heading mw-heading2"><h2 id="Externe_links">Externe links</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Sint-Catharinakerk_(Eindhoven)&amp;veaction=edit&amp;section=8" title="Bewerk dit kopje: Externe links" class="mw-editsection-visualeditor"><span>bewerken</span></a><span class="mw-editsection-divider"> | </span><a href="/w/index.php?title=Sint-Catharinakerk_(Eindhoven)&amp;action=edit&amp;section=8" title="De broncode bewerken van de sectie: Externe links"><span>brontekst bewerken</span></a><span class="mw-editsection-bracket">]</span></span></div>
<ul id="mwcg"><li id="mwcw"><a rel="mw:ExtLink nofollow" href="http://www.meertens.knaw.nl/bedevaart/bol/plaats/200" class="external text" id="mwdA">Meertens Instituut</a></li>
<li id="mwdQ"><span typeof="mw:Transclusion mw:File" about="#mwt8" id="mwdg" data-mw='{"caption":"Pdf-document","parts":[{"template":{"target":{"wt":"pdf","href":"./Sjabloon:Pdf"},"params":{},"i":0}}]}'><span title="Pdf-document"><img resource="https://nl.wikipedia.org/wiki/Bestand:Icons-mini-file_pdf.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Icons-mini-file_pdf.svg/20px-Icons-mini-file_pdf.svg.png?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Icons-mini-file_pdf.svg/40px-Icons-mini-file_pdf.svg.png?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Pdf-document" data-file-width="16" data-file-height="16" data-file-type="drawing" height="16" width="16" class="mw-file-element"/></span></span> <a rel="mw:ExtLink nofollow" href="http://www.eindhoveninbeeld.com/UserFiles/files/Fotopaginas/34873%20pdf.pdf" class="external text" id="mwdw">beschrijving glas-in-loodramen</a></li></ul>

