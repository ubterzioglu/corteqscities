:\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/10/SNAKEPIT-1-aspect-ratio-1485.6-1142.4.jpg\"},\"tabletImage\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/10/SNAKEPIT-1-aspect-ratio-1204.8-1062.jpg\"},\"mobileImage\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/10/SNAKEPIT-1-aspect-ratio-508.8-904.8.jpg\"},\"video\":null,\"button\":{\"target\":\"_blank\",\"title\":\"Meer informatie\",\"url\":\"https://www.klokgebouw.nl/agenda/snakepit-2026\"}},\"allAgendaLocations\":{\"nodes\":[{\"name\":\"Klokgebouw\"}]}},{\"title\":\"Danny Vera\",\"acfAgenda\":{\"startDate\":\"31 October 2026\",\"endDate\":\"31 October 2026\",\"description\":\"\u003cp\u003eLaat je meeslepen door de karakteristieke stem en tijdloze sound van Danny Vera. Een avond vol Americana, rock-’n-roll en songs die nog lang blijven hangen.\u003c/p\u003e\\n\",\"image\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/08/20240907_DannyVera_ZiggoDome_Photo-Ben-Houdijk_lr_28827-scaled_web_001-1-aspect-ratio-1485.6-1142.4.jpg\"},\"tabletImage\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/08/20240907_DannyVera_ZiggoDome_Photo-Ben-Houdijk_lr_28827-scaled_web_001-1-aspect-ratio-1204.8-1062-1.jpg\"},\"mobileImage\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/08/20240907_DannyVera_ZiggoDome_Photo-Ben-Houdijk_lr_28827-scaled_web_001-1-aspect-ratio-508.8-904.8.jpg\"},\"video\":null,\"button\":{\"target\":\"_blank\",\"title\":\"Meer informatie\",\"url\":\"https://www.klokgebouw.nl/agenda/danny-vera-2026\"}},\"allAgendaLocations\":{\"nodes\":[{\"name\":\"Klokgebouw\"}]}},{\"title\":\"We zien het wel even\",\"acfAgenda\":{\"startDate\":\"30 October 2026\",\"endDate\":\"30 October 2026\",\"description\":\"\u003cp\u003eHokjesdenker brengt razendsnelle, absurde sketches over onze collectieve paniek. Een avond vol scherpe humor, herkenbare chaos en de troostende gedachte: we zien het wel even.\u003c/p\u003e\\n\",\"image\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/08/Hokjesdenker-We-zien-het-wel-even-Casper-Koster-2-scaled_web_001-1-aspect-ratio-1485.6-1142.4.jpg\"},\"tabletImage\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/08/Hokjesdenker-We-zien-het-wel-even-Casper-Koster-2-scaled_web_001-1-aspect-ratio-1204.8-1062.jpg\"},\"mobileImage\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/08/Hokjesdenker-We-zien-het-wel-even-Casper-Koster-2-scaled_web_001-1-aspect-ratio-508.8-904.8.jpg\"},\"video\":null,\"button\":{\"target\":\"_blank\",\"title\":\"Meer informatie\",\"url\":\"https://www.natlab.nl/nl/programma/we-zien-het-wel-even-1zbt\"}},\"allAgendaLocations\":{\"nodes\":[{\"name\":\"Natlab\"}]}},{\"title\":\"Dutch Design Week\",\"acfAgenda\":{\"startDate\":\"17 October 2026\",\"endDate\":\"25 October 2026\",\"description\":\"\u003cp\u003eTijdens Dutch Design Week 2026 komt design, innovatie en creativiteit samen op Strijp-S. Ontdek inspirerende projecten, nieuwe ideeën en verrassende perspectieven van ontwerpers en makers. Een plek om te kijken, te ontdekken en je te laten inspireren.\u003c/p\u003e\\n\",\"image\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/08/ddw_2026_edit_web_001-1-aspect-ratio-1485.6-1142.4.jpg\"},\"tabletImage\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/08/ddw_2026_edit_web_001-1-aspect-ratio-1204.8-1062.jpg\"},\"mobileImage\":{\"altText\":\"\",\"mediaItemUrl\":\"https://admin.strijp-s.nl/wp-content/uploads/2026/08/ddw_2026_edit_web_001-1-aspect-ratio-508.8-904.8.jpg\"},\"video\":null,\"button\":{\"target\":\"_blank\",\"title\":\"Meer informatie\",\"url\":\"https://ddw.nl/\"}},\"allAgendaLocations\":{\"nodes\":[{\"name\":\"St