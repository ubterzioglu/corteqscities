<th id="mwfA">Competitie</th>
<th id="mwfQ">Bezoekers</th></tr>
<tr id="mwfg">
<td id="mwfw"><b id="mwgA">1</b></td><td id="mwgQ">9 mei 1978</td><td id="mwgg"><a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/PSV_(voetbalclub)" title="PSV (voetbalclub)" id="mwgw">PSV</a> – <a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/SC_Bastia" title="SC Bastia" id="mwhA">SC Bastia</a></td><td id="mwhQ">3 – 0</td><td id="mwhg"><a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/Finale_UEFA_Cup_1978" title="Finale UEFA Cup 1978" id="mwhw">UEFA Cup 1978</a> (terugwedstrijd)</td><td id="mwiA">27.000</td></tr>
<tr id="mwiQ">
<td id="mwig"><b id="mwiw">2</b></td><td id="mwjA">10 mei 2006</td><td id="mwjQ"><a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/Middlesbrough_FC" title="Middlesbrough FC" id="mwjg">Middlesbrough</a> – <a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/Sevilla_FC" title="Sevilla FC" id="mwjw">Sevilla FC</a></td><td id="mwkA">0 – 4</td><td id="mwkQ"><a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/Finale_UEFA_Cup_2006" title="Finale UEFA Cup 2006" id="mwkg">UEFA Cup 2006</a></td><td id="mwkw">31.300</td></tr>
<tr id="mwlA">
<td id="mwlQ"><b id="mwlg">3</b></td><td id="mwlw">3 juni 2023</td><td id="mwmA"><a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/FC_Barcelona_Femení" title="FC Barcelona Femení" id="mwmQ">FC Barcelona</a> – <a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/VfL_Wolfsburg_(vrouwenvoetbal)" title="VfL Wolfsburg (vrouwenvoetbal)" id="mwmg">VfL Wolfsburg</a></td><td id="mwmw">3 – 2</td><td id="mwnA"><a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/Finale_UEFA_Women's_Champions_League_2023" title="Finale UEFA Women's Champions League 2023" id="mwnQ">UEFA Women's Champions League 2023</a></td><td id="mwng">33.147</td></tr>
</tbody></table>

