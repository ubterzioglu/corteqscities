		<script>
		/**
		 * GA4 Form Submission Tracking
		 *
		 * Listens for all form submissions on the page (delegated, capture phase)
		 * and pushes a `form_submit` event into window.dataLayer with the form's
		 * ID, a human-readable title, and the detected provider (gravityforms /
		 * hubspot / generic). This works regardless of how many forms exist on the
		 * page and picks up forms injected after initial render.
		 */
		(function() {

			/**
			 * Detect the form provider for additional context in the event payload.
			 * Checks for Gravity Forms (id="gform_N") and HubSpot (class hs-form/hsForm).
			 *
			 * @param {HTMLFormElement} form
			 * @returns {string}
			 */
			function detectProvider(form) {
				if (/^gform_\d+$/.test(form.id) || form.classList.contains('gf_form')) {
					return 'gravityforms';
				}
				if (form.classList.contains('hs-form') || form.classList.contains('hsForm')) {
					return 'hubspot';
				}
				return 'generic';
			}

			/**
			 * Resolve a stable form ID.
			 * Priority: form.id → form.name → gform_N CSS class → 'unknown_form'
			 *
			 * @param {HTMLFormElement} form
			 * @returns {string}
			 */
			function resolveFormId(form) {
				if (form.id) {
					return form.id;
				}
				if (form.name) {
					return form.name;
				}
				// Gravity Forms may carry the numeric ID in a CSS class (e.g. gform_1)
				// even when the form element itself has no id attribute.
				var classMatch = form.className.match(/\bgform_(\d+)\b/);
				if (classMatch) {
					return 'gform_' + classMatch[1];
				}
				return 'unknown_form';
			}

			/**
			 * Resolve a human-readable form title from available DOM signals.
			 * Priority:
			 *   1. data-form-title attribute  — explicit override by content editors
			 *   2. aria-label attribute        — accessible name
			 *   3. First <legend> in the form  — standard HTML grouping label
			 *   4. .gform_title in the nearest .gform_wrapper — Gravity Forms heading
			 *   5. Nearest preceding sibling heading (h1–h3)
			 *   6. Resolved form ID            — last resort, never empty
			 *
			 * @param {HTMLFormElement} form
			 * @returns {string}
			 */
			function resolveFormTitle(form) {
				// 1. Explicit override via data attribute.
				if (form.dataset && form.dataset.formTitle) {
					return form.dataset.formTitle.trim();
				}

				// 2. Accessible label.
				var ariaLabel = form.getAttribute('aria-label');
				if (ariaLabel && ariaLabel.trim()) {
					return ariaLabel.trim();
				}

				// 3. First <legend> — standard form section label.
				var legend = form.querySelector('legend');
				if (legend && legend.textContent.trim()) {
					return legend.textContent.trim();
				}

				// 4. Gravity Forms renders the form title in .gform_title inside .gform_wrapper,
				// which wraps the <form> element, so we walk up to find it.
				var wrapper = form.closest ? form.closest('.gform_wrapper') : null;
				if (wrapper) {
					var gfTitle = wrapper.querySelector('.gform_title');
					if (gfTitle && gfTitle.textContent.trim()) {
						return gfTitle.textContent.trim();
					}
				}

				// 5. Nearest preceding heading (h1–h3) within the same container,
				// limited to 5 siblings to avoid false positives far up the DOM.
				var sibling = form.previousElementSibling;
				var steps = 0;
				while (sibling && steps < 5) {
					if (/^H[1-3]$/i.test(sibling.tagName) && sibling.textContent.trim()) {
						return sibling.textContent.trim();
					}
					sibling = sibling.previousElementSibling;
					steps++;
				}

				// 6. Fall back to form ID — always a non-empty string.
				return resolveFormId(form);
			}

			/**
			 * Push a GA4-ready form_submission event to window.dataLayer.
			 * Initializes dataLayer defensively; wrapped in try/catch so tracking
			 * failures can never block or break the form submission.
			 *
			 * @param {HTMLFormElement} form
			 */
			function pushFormSubmission(form) {
				try {
					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push({
						'event': 'form_submission',
						'form_id': resolveFormId(form),
						'form_title': resolveFormTitle(form),
						'form_provider': detectProvider(form),
					});
				} catch (e) {
					// Silently swallow — tracking must never interrupt form submission.
				}
			}

			/**
			 * Event Registration Tracking for gform_6 (multi-step event registration form).
			 *
			 * Gravity Forms multi-step forms may not render all fields in the final step's
			 * DOM. We maintain a module-level cache of the last known event type value,
			 * updated whenever the user interacts with field input_6_13. This ensures the
			 * value is available at final-step submit time even when the field is not
			 * currently in the active step.
			 *
			 * The cache is keyed to the form ID so it remains isolated if multiple
			 * registration forms ever appear on the same page.
			 */
			var _ioEventTypeCache = {};

			/**
			 * Resolve the selected event type value for gform_6.
			 * Priority:
			 *   1. Direct DOM read of #input_6_13 (present in current step).
			 *   2. First focusable control inside #field_6_13 (alternate GF markup).
			 *   3. Module-level cache set on last user change (multi-step fallback).
			 *   4. 'unknown' — keeps payload stable, never an empty string.
			 *
			 * @param {HTMLFormElement} form
			 * @returns {string}
			 */
			function resolveEventType(form) {
				// 1. Direct field read — present when the field is in the active step.
				var directField = form.querySelector('#input_6_13');
				if (directField && directField.value && directField.value.trim()) {
					return directField.value.trim();
				}

				// 2. GF sometimes wraps the input inside a container div with the field id.
				// Covers select, radio group, and text inputs equally.
				var fieldContainer = form.querySelector('#field_6_13');
				if (fieldContainer) {
					var control = fieldContainer.querySelector('input:checked, select, input[type="text"]');
					if (control && control.value && control.value.trim()) {
						return control.value.trim();
					}
				}

				// 3. Multi-step fallback: use the cached value from the last change event.
				var cachedValue = _ioEventTypeCache['gform_6'];
				if (cachedValue && cachedValue.trim()) {
					return cachedValue.trim();
				}

				// 4. Safe fallback — always returns a non-empty, stable string.
				return 'unknown';
			}

			/**
			 * Push a GA4-ready event_registration event to window.dataLayer.
			 * Called only for gform_6; includes the selected event type alongside the
			 * standard form context fields.
			 *
			 * @param {HTMLFormElement} form
			 */
			function pushEventRegistration(form) {
				try {
					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push({
						'event': 'event_registration',
						'event_type': resolveEventType(form),
						'form_id': resolveFormId(form),
						'form_title': resolveFormTitle(form),
						'form_provider': detectProvider(form),
					});
				} catch (e) {
					// Silently swallow — tracking must never interrupt form submission.
				}
			}

			/**
			 * Multi-step cache listener for gform_6 / field input_6_13.
			 *
			 * GF re-renders pages on next/prev navigation, so we watch for change events
			 * on the document (delegated) and store the value whenever the user selects
			 * or changes input_6_13. This value is then available in resolveEventType()
			 * at final-step submit time, even if the field is no longer in the DOM.
			 */
			document.addEventListener('change', function(event) {
				var target = event.target;
				// Match the specific field by id; GF select inputs use id="input_6_13".
				if (target && target.id === 'input_6_13') {
					_ioEventTypeCache['gform_6'] = target.value || '';
				}
			}, false /* bubble phase — sufficient for change events */ );

			/**
			 * Single delegated submit listener on document, capture phase.
			 *
			 * Using capture (third arg = true) ensures we run before any plugin
			 * listener that might call stopPropagation on the form element itself.
			 *
			 * Duplicate-submit guard: store the last tracked timestamp on the form
			 * element. If the same form fires submit again within 500 ms (e.g. from
			 * a double-click or a plugin-triggered synthetic event), skip the push.
			 */
			document.addEventListener('submit', function(event) {
				var form = event.target;

				// Bail early if the event target is not a form element.
				if (!form || form.tagName !== 'FORM') {
					return;
				}

				// Duplicate-submit guard.
				var now = Date.now();
				if (form._gtmLastSubmit && (now - form._gtmLastSubmit) < 500) {
					return;
				}
				form._gtmLastSubmit = now;

				// Generic form submission event for all forms.
				pushFormSubmission(form);

				// Additional event_registration push, scoped to the event registration
				// multi-step form only (gform_6).
				if (form.id === 'gform_6') {
					pushEventRegistration(form);
				}
			}, true /* capture phase */ );

		}());
	</script>
