_deg":{"wt":"5"},"lon_min":{"wt":"28"},"verkeersader":{"wt":"{{Pictogram weg Nederland A-weg|2}}{{Pictogram weg Nederland N-weg|2}}{{Pictogram weg Europa E-weg|25|||NL}}, {{Pictogram weg Nederland A-weg|50}}, {{Pictogram weg Nederland A-weg|58}}{{Pictogram weg Europa E-weg|312|||NL}}, {{Pictogram weg Nederland A-weg|67}}{{Pictogram weg Europa E-weg|34|||NL}}, {{Pictogram weg Nederland A-weg|270}}{{Pictogram weg Nederland N-weg|270}}, {{Pictogram weg Nederland RING-weg|||Eindhoven}}, [[Randweg Eindhoven]], [[Spoorlijn Eindhoven - Weert]], [[Spoorlijn Breda - Maastricht|Staatslijn E]]"},"station":{"wt":"[[Station Eindhoven Centraal|Centraal]], [[Halte Eindhoven Stadion|Stadion]], [[Station Eindhoven Strijp-S|Strijp-S]]"},"netnummer":{"wt":"040"},"CBS":{"wt":"0772"},"postcode":{"wt":"5600-5658"},"religiejaar":{"wt":"2010-2015&lt;ref name=\"religieus\">{{Citeer web |url=https://www.cbs.nl/nl-nl/nieuws/2016/51/helft-nederlanders-is-kerkelijk-of-religieus |titel=Helft Nederlanders is kerkelijk of religieus |auteur= |uitgever=CBS |datum=22 december 2016 |bezochtdatum=24 mei 2020|archiefurl=https://web.archive.org/web/20200815054833/https://www.cbs.nl/nl-nl/nieuws/2016/51/helft-nederlanders-is-kerkelijk-of-religieus|archiefdatum=2020-08-15|dodeurl=nee}}&lt;/ref>"},"religie":{"wt":"46,2% geen [[Religie|gezindte]]&lt;br />35,7% [[Rooms-Katholieke Kerk|rooms-katholiek]]&lt;br />8,0% [[moslim]]&lt;br>4,9% [[Protestantisme|protestant]]&lt;br>3,8% overige [[Religie|gezindte]] &lt;br>0,8% [[Hindoeïsme|hindoe]]&lt;br>0,5% [[Boeddhisme|boeddhist]]"},"COROP":{"wt":"[[Zuidoost-Noord-Brabant]]"},"bijnaam":{"wt":"&apos;&apos;De Lichtstad&apos;&apos;\n&apos;&apos;[[Lampegat]]&apos;&apos; ([[Lijst van alternatieve Nederlandse plaatsnamen tijdens carnaval|Carnaval]])"},"extra portaal":{"wt":"Eindhoven"}},"i":0}}]}'></span><table class="infobox" cellpadding="1" cellspacing="1" about="#mwt1">
