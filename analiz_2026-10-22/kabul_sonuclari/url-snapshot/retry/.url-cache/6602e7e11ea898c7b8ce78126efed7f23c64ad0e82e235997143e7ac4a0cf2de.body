n-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1280px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"pb-3 pt-5\",\"children\":[\"$\",\"hr\",null,{\"className\":\"m-0 border-0 border-t border-black/60\"}]}]}]}]}]\n34:[\"$\",\"section\",\"9c977d25edba\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L30\",null,{\"cta\":\"$undefined\",\"eyebrow\":\"This is Eindhoven\",\"fullBleed\":false,\"items\":[{\"description\":\"Check out our extensive selection of hotspots, highlights, events and other activities and discover Eindhoven like you never did before!\",\"href\":\"/en/see-and-do\",\"imageAlt\":\"(re)discover Eindhoven\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Nick Bookelaar\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/6ccc09bae54475a113dc89b0f49556b8f3315aac-1638x1092.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"(re)discover Eindhoven\"},{\"description\":\"Eindhoven is home to numerous inspiring companies, great educational institutions, and creative breeding grounds. On this page, you will find everything about working \u0026 studying in Eindhoven!\",\"href\":\"/en/work-and-study\",\"imageAlt\":\"Study in Eindhoven\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/9b72eb25488d9d9c19d07cf02153f80cc5e7b48e-1750x1167.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"Study in Eindhoven\"},{\"description\":\"On this page, you'll find everything you need to make Eindhoven your home.\",\"href\":\"/en/city-life/feeling-at-home\",\"imageAlt\":\"Make Eindhoven my home\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/9b33ddf9c064422bf6e3b6940fc87859ca964c66-2048x1365.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"Make Eindhoven my home\"},{\"description\":\"Planning a day trip or weekend getaway to Eindhoven? From practical information to the necessary inspiration, planning your trip starts here!\",\"href\":\"/en/see-and-do/plan-your-trip\",\"imageAlt\":\"Plan my trip\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/fbc51d665b8f6daff67a50514d2ce405003a08ff-2500x1875.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"Plan my trip\"}],\"labels\":{\"next\":\"Next\",\"previous\":\"Previous\",\"dotLabel\":\"Go to slide\",\"dotsAriaLabel\":\"Slide selector\",\"carouselLabel\":\"Articles carousel\"},\"theme\":\"blue\",\"title\":\"What would you like to do?\",\"variant\":\"square\"}]}]\n35:[\"$\",\"section\",\"d531bd9ba3a3\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1280px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"pb-3 pt-5\",\"children\":[\"$\",\"hr\",null,{\"className\":\"m-0 border-0 border-t border-black/60\"}]}]}]}]}]\n36:[\"$\",\"section\",\"d791670a2106\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L30\",null,{\"cta\":\"$undefined\",\"eyebrow\":\"This is Eindhoven\",\"fullBleed\":false,\"items\":[{\"description\":\"Eindhoven is the perfect city to get your dose of culture and design. Visit our top museums, design studios, and art centers, and discover why we are the design capital of the Netherlands!\",\"href\":\"/en/see-and-do/culture-and-design\",\"imageAlt\":\"Culture \u0026 design\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Max Kneefel\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/92ab9b2681da9ab1835d523aeb8342dea5b63ed9-799x533.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"Culture \u0026 design\"},{\"description\":\"There are plenty of things to do and experience in Eindhoven. Discover what the city has to offer!\",\"href\":\"/en/see-and-do/fun-things-to-do\",\"imageAlt\":\"Fun activities\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Studio Baybee\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/7066351657c59047a6a79aa012664751ecbb324d-1280x1920.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"Fun activities\"},{\"description\":\"Check out our culinary hotspots and discover what Eindhoven has to offer when it comes to food and drinks.\",\"href\":\"/en/see-and-do/food-and-drinks\",\"imageAlt\":\"Undiscovered food spots\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Studio Baybee\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/509804b1f6c2961f7918c6a7c09ac3fdb0123502-1393x929.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"Undiscovered food spots\"},{\"description\":\"Eindhoven is the shopping city of the south of the Netherlands, offering high fashion, Dutch design, local markets, and vintage stores.\",\"href\":\"/en/see-and-do/shopping\",\"imageAlt\":\"Shopping inspiration\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Max Kneefel\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/dcaa4ef54acf2bac253af620e8cb16ad697656b7-2000x3000.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"Shopping inspiration\"}],\"labels\":{\"next\":\"Next\",\"previous\":\"Previous\",\"dotLabel\":\"Go to slide\",\"dotsAriaLabel\":\"Slide selector\",\"carouselLabel\":\"Articles carousel\"},\"theme\":\"blue\",\"title\":\"What are you looking for?\",\"variant\":\"square\"}]}]\n37:[\"$\",\"section\",\"27848eaa6f22\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1280px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"pb-3 pt-5\",\"children\":[\"$\",\"hr\",null,{\"className\":\"m-0 border-0 border-t border-black/60\"}]}]}]}]}]\n38:[\"$\",\"section\",\"1ddaec61f478\",{\"className\":\"scroll-mt-24\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L30\",null,{\"cta\":\"$undefined\",\"eyebrow\":\"Fun things to do\",\"fullBleed\":true,\"items\":[{\"description\":\"Feel like shopping and looking for the best stores with exciting brands? Here's a list of eleven great local boutiques!\",\"href\":\"/en/see-and-do/shopping/local-boutiques\",\"imageAlt\":\"11x Local boutiques\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Max Kneefel\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/b7d649272d519993a69e750bb430ec1e508d366f-1920x1280.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Shopping\",\"target\":\"$undefined\",\"title\":\"11x Local boutiques\"},{\"description\":\"You don't have to go far in Eindhoven for a breath of fresh air with one of these fifteen beautiful parks!\",\"href\":\"/en/see-and-do/fun-things-to-do/evergeen-eindhoven-parks\",\"imageAlt\":\"Evergreen: 15x Eindhoven parks\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/e1195a4bbdbfff6dbc22bc3d4dab0b2ec97bed93-2048x1365.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Recreation\",\"target\":\"$undefined\",\"title\":\"Evergreen: 15x Eindhoven parks\"},{\"description\":\"Check out our tips for awesome tour guides and fun walks!\",\"href\":\"/en/see-and-do/fun-things-to-do/6x-toffe-citytours-en-wandelroutes\",\"imageAlt\":\"6x Cool city tours and walking routes\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Nick Bookelaar\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/c30b56d500f28bd9011576e1d505e30ada9c62ba-500x333.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Recreation\",\"target\":\"$undefined\",\"title\":\"6x Cool city tours and walking routes\"},{\"description\":\"Whether you are heading out with a curious toddler or a teenager who is not easily impressed, there are plenty of fun activities for kids in Eindhoven. We have collected some of the happiest hotspots for you. Enjoy!\",\"href\":\"/en/see-and-do/fun-things-to-do/happiest-spots-for-kids\",\"imageAlt\":\"11x Happiest spots for kids\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Almicheal Fraay\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/b7e8e43be94c0ed5bfa1e6c80ced33ceec701a3e-1280x853.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Recreation\",\"target\":\"$undefined\",\"title\":\"11x Happiest spots for kids\"},{\"description\":\"In Eindhoven, we enjoy games to sharpen the mind. That's why you can go to all sorts of places for an evening of trivia. Check them all out!\",\"href\":\"/en/see-and-do/fun-things-to-do/places-for-a-quiz-night\",\"imageAlt\":\"6x Places for a quiz night\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/64f3c15f7d362167ed80e89f17c1fb5ff0c35281-1280x853.png\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Recreation\",\"target\":\"$undefined\",\"title\":\"6x Places for a quiz night\"}],\"labels\":{\"next\":\"Next\",\"previous\":\"Previous\",\"dotLabel\":\"Go to slide\",\"dotsAriaLabel\":\"Slide selector\",\"carouselLabel\":\"Articles carousel\"},\"theme\":\"blue\",\"title\":\"A dose of Eindhoven inspiration\",\"variant\":\"slider\"}]}]\n39:[\"$\",\"section\",\"6272e0d79fdd\",{\"className\":\"scroll-mt-24\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L3d\",null,{\"articles\":[{\"href\":\"/en/see-and-do/transportation\",\"id\":\"f0b2617fc80f\",\"imageAlt\":\"Train\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Cleo Goossens\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/a987a4d1658d3b877b2a6c9349132a50b9a36cdc-1371x979.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"City life\",\"target\":\"$undefined\",\"title\":\"Getting around\"},{\"href\":\"/en/see-and-do/dynamic-districts\",\"id\":\"6bf85d024e80\",\"imageAlt\":\"Volta Galvani\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Nick Bookelaar\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/2f159f3ea1f64e5fef802c129bc397bc13004c6b-2048x1366.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Districts\",\"target\":\"$undefined\",\"title\":\"Dynamic districts\"},{\"href\":\"/en/see-and-do/plan-your-trip/practical-information-for-your-trip\",\"id\":\"3433d9b436db\",\"imageAlt\":\"Ketelhuisplein\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Studio Baybee\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/c089bec2cb91c2756eb0d1218ec06a345e2fe1ef-1280x1920.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Practical info\",\"target\":\"$undefined\",\"title\":\"Practical information for your trip\"},{\"href\":\"/en/see-and-do/plan-your-trip\",\"id\":\"333ee8b7222a\",\"imageAlt\":\"Blob\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Nadia ten Wolde\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/39b537f6bb186587ae79c0df3c333ec4cb1db992-1667x1111.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":