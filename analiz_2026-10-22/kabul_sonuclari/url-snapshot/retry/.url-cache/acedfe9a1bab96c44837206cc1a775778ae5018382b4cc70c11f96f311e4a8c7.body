</section><section data-mw-section-id="7" id="mwtQ" aria-labelledby="Bekende_alumni"><div class="mw-heading mw-heading2"><h2 id="Bekende_alumni">Bekende alumni</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Technische_Universiteit_Eindhoven&amp;veaction=edit&amp;section=7" title="Bewerk dit kopje: Bekende alumni" class="mw-editsection-visualeditor"><span>bewerken</span></a><span class="mw-editsection-divider"> | </span><a href="/w/index.php?title=Technische_Universiteit_Eindhoven&amp;action=edit&amp;section=7" title="De broncode bewerken van de sectie: Bekende alumni"><span>brontekst bewerken</span></a><span class="mw-editsection-bracket">]</span></span></div>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwtg"><a href="https://nl.wikipedia.org/wiki/Bestand:Schouhamerimmink.jpg" class="mw-file-description" id="mwtw"><img resource="https://nl.wikipedia.org/wiki/Bestand:Schouhamerimmink.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/Schouhamerimmink.jpg/250px-Schouhamerimmink.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/commons/2/2a/Schouhamerimmink.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x" data-file-width="498" data-file-height="760" data-file-type="bitmap" height="290" width="190" class="mw-file-element mw-file-upright" style="--mw-file-upright: 0.75" id="mwuA"/></a><figcaption id="mwuQ"><a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/Kees_Schouhamer_Immink" title="Kees Schouhamer Immink" id="mwug">Kees Schouhamer Immink</a></figcaption></figure>
