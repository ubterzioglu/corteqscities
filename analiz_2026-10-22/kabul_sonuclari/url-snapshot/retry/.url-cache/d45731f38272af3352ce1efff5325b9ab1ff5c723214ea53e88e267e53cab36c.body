					<div class="flex relative col-span-4 sm:col-span-3 lg:col-span-4 [&#038;:nth-child(2)]:sm:translate-y-10 [&#038;:nth-child(2)]:lg:translate-y-32 [&#038;:nth-child(1)]:lg:translate-y-16 [&#038;:nth-child(n+2)]:hidden sm:[&#038;:nth-child(n+2)]:flex sm:[&#038;:nth-child(n+3)]:hidden lg:[&#038;:nth-child(n+3)]:flex lg:[&#038;:nth-child(n+4)]:hidden invisible js-quote text-zoom-xl:col-span-full text-zoom-xl:[&#038;:nth-child(1)]:translate-y-0 text-zoom-xl:[&#038;:nth-child(2)]:translate-y-0">
