					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="nl" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><table class="infobox" cellpadding="1" cellspacing="1" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox museum\n","href":"./Sjabloon:Infobox_museum"},"params":{"naam":{"wt":"Philips Museum"},"oorspronkelijke_naam":{"wt":""},"afbeelding":{"wt":"Philipsfabriekje.jpg"},"onderschrift":{"wt":"De eerste Philipsfabriek"},"opgericht":{"wt":""},"locatie":{"wt":"[[Eerste gloeilampenfabriek van Philips|Emmasingel 31]], [[Eindhoven]]"},"oppervlakte":{"wt":""},"type":{"wt":""},"thema":{"wt":"bedrijfsgeschiedenis"},"directeur":{"wt":"Olga Coolen&lt;ref name=\"Jaarverslag 2018\">Jaarverslag Philips Museum 2018&lt;/ref>"},"conservator":{"wt":"Sergio Derks&lt;ref name=\"Jaarverslag 2018\" />"},"medewerkers":{"wt":"6, met daarnaast 100 vrijwilligers&lt;ref name=\"Jaarverslag 2018\" />"},"monumentstatus":{"wt":"Rijksmonument"},"monumentnummer":{"wt":"518719"},"architect":{"wt":""},"gebouwd":{"wt":"1888"},"openingsdatum":{"wt":"2013"},"sluiting":{"wt":""},"bezoekers":{"wt":"80.897 (2018)&lt;ref name=\"Jaarverslag 2018\" />"},"lid van":{"wt":""},"website":{"wt":"http://www.philips-museum.com"},"mapname":{"wt":""},"lat_deg":{"wt":""},"lat_min":{"wt":""},"lat_sec":{"wt":""},"lat_dir":{"wt":""},"lon_deg":{"wt":""},"lon_min":{"wt":""},"lon_sec":{"wt":""},"lon_dir":{"wt":""}},"i":0}}]}'> 
<tbody><tr><th class="infobox-kop notheme" style="background-color:firebrick; color:white; text-align:center; font-size:120%;" colspan="3">Philips Museum</th></tr>
<tr>











<td style="text-align:center; padding:0;" colspan="3"><span typeof="mw:File"><a href="https://nl.wikipedia.org/wiki/Bestand:Philipsfabriekje.jpg" class="mw-file-description"><img resource="https://nl.wikipedia.org/wiki/Bestand:Philipsfabriekje.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b8/Philipsfabriekje.jpg/330px-Philipsfabriekje.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b8/Philipsfabriekje.jpg/960px-Philipsfabriekje.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="De eerste Philipsfabriek" data-file-width="991" data-file-height="745" data-file-type="bitmap" height="200" width="266" class="mw-file-element"/></a></span></td></tr>
<tr>
<td style="text-align:center;" colspan="3"><div style="font-size:90%">De eerste Philipsfabriek</div></td></tr>
<tr>









<th class="infobox-kop notheme" style="background-color:firebrick; color:white; text-align:center;" colspan="3">Locatie</th></tr>
<tr>


<th>Locatie</th>
<td colspan="2"><a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/Eerste_gloeilampenfabriek_van_Philips" title="Eerste gloeilampenfabriek van Philips">Emmasingel 31</a>, <a rel="mw:WikiLink" href="https://nl.wikipedia.org/wiki/Eindhoven" title="Eindhoven">Eindhoven</a></td></tr>
<tr>
<th>Adres</th>
<td colspan="2">Emmasingel 31, Emmasingel 31<span style="float:right"><span class="mw-valign-text-top" typeof="mw:File/Frameless" data-mw='{"caption":"Bewerken op Wikidata"}'><a href="https://www.wikidata.org/wiki/Q2303873?uselang=nl#P6375" title="Bewerken op Wikidata"><img resource="https://nl.wikipedia.org/wiki/Bestand:OOjs_UI_icon_edit-ltr-progressive.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr-progressive.svg/20px-OOjs_UI_icon_edit-ltr-progressive.svg.png?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" alt="Bewerken op Wikidata" data-file-width="20" data-file-height="20" data-file-type="drawing" height="10" width="10" class="mw-file-element"/></a></span></span></td></tr>
<tr>











<th class="infobox-kop notheme" style="background-color:firebrick; color:white;" colspan="3">Thema en expositie</th></tr>
<tr>




<th>Thema</th>
<td colspan="2">bedrijfsgeschiedenis</td></tr>
<tr>










<th class="infobox-kop notheme" style="background-color:firebrick; color:white;" colspan="3">Status en tijdlijn</th></tr>
<tr>




<th>Opening</th>
<td colspan="2">2013</td></tr>
<tr>










<th class="infobox-kop notheme" style="background-color:firebrick; color:white;" colspan="3">Personen en statistieken</th></tr>
<tr>



<th>Directeur(s)</th>
<td colspan="2">Olga Coolen<sup about="#mwt2" class="mw-ref reference" id="cite_ref-Jaarverslag_2018_1-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Jaarverslag 2018"},"body":{"id":"mw-reference-text-cite_note-Jaarverslag_2018-1"}}'><a href="#cite_note-Jaarverslag_2018-1" id="mwAw"><span class="mw-reflink-text" id="mwBA"><span class="cite-bracket" id="mwBQ">[</span>1<span class="cite-bracket" id="mwBg">]</span></span></a></sup></td></tr>
