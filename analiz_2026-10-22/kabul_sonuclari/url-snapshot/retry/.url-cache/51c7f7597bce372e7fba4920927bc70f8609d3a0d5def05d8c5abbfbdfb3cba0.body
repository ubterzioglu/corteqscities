<tbody><tr><th class="infobox-kop notheme" style=" color:inherit; text-align:center; font-size:120%;" colspan="3">Parktheater Eindhoven</th></tr>
<tr>








<td style="text-align:center; padding:0;" colspan="3"><span typeof="mw:File"><a href="https://nl.wikipedia.org/wiki/Bestand:Schouwburg_Eindhoven.jpg" class="mw-file-description"><img resource="https://nl.wikipedia.org/wiki/Bestand:Schouwburg_Eindhoven.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Schouwburg_Eindhoven.jpg/330px-Schouwburg_Eindhoven.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Schouwburg_Eindhoven.jpg/960px-Schouwburg_Eindhoven.jpg?utm_source=nl.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Parktheater in Eindhoven" data-file-width="1412" data-file-height="924" data-file-type="bitmap" height="174" width="266" class="mw-file-element"/></a></span></td></tr>
<tr>
<td style="text-align:center;" colspan="3"><div style="font-size:90%">Parktheater in Eindhoven</div></td></tr>
