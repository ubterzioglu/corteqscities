pensioen te gaan? Of besluit je toch nog door te gaan op een manier die bij je past? We helpen je om de juiste keuze te maken.","metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"editorialPublicationDateWithDefault":1784279520000,"editorialModificationDate":null,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"readingTime":2,"contentType":"kvkwebsite:metadata","editorialPublicationDate":1784279520000,"mostRecentChangeDate":1784279520000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","key":"6","label":"Stoppen en uitschrijven","contentType":"selection:listitem","id":"a45fcc76-fd4e-4d34-8120-2d98cdcccad2"}],"theme":[],"transaction":[],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","key":"48","label":"Strategie","contentType":"selection:listitem","id":"323c2464-2a26-4098-91ad-e0ca508585bb"}],"sector":[],"audience":[],"articleType":{"name":"selection:listitem","displayName":"selection:listitem","key":"6","label":"Kwestie van kiezen","contentType":"selection:listitem","id":"ca1084d6-0146-4a4e-9584-76d13697acc3"},"author":[{"name":"selection:listitem","displayName":"selection:listitem","key":"hajar-scholten","label":"Hajar Scholten","contentType":"selection:listitem","id":"b6183787-4d09-430c-9a3f-57a8da034ca9"}],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","key":"stoppen","label":"Stoppen","contentType":"selection:listitem","id":"7fec2ef5-1a24-4817-8070-e64658c0680a"}],"lawOpenGovernment":[null]},"title":"Je denkt na over met pensioen gaan: doorgaan of stoppen?","image":{"$ref":"#u6eb8afcf05394a0cbd15e84e0d13b067"},"teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Wanneer is het tijd om met pensioen te gaan? Of besluit je toch nog door te gaan op een manier die bij je past? We helpen je om de juiste keuze te maken.","t