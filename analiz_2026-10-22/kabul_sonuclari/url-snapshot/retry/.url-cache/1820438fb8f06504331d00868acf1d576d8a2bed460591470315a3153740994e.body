x-w-5xl"><h1 class="text-white md:break-normal header1 mb-1.5 md:mb-2 ">Parking</h1><p class="text-white big "> Curious about the parking options at Eindhoven Airport or do you want to make a reservation directly? Business parking, Kiss &amp; ride or parking for the mobility impaired. More information can be found on this page.</p></div></div><div class="header_header__img-container__xlRnL  after:opacity-50 relative  !h-[300px] lg:!h-[492px]"><img alt="" fetchPriority="high" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://images.ctfassets.net/80dqdqpre1qk/2UXn32ewIm2MJR53ObL12y/ae84d16742d35bdaa504f02ae4fce336/20220630_Eindhoven_Airport_004_9360.jpg?fm=webp"/></div></div><div class="container_container__NQ5De "><div class="w-full"><div class="flex items-center justify-between mb-3 md:mb-4"></div><div class="grid grid-cols-1 gap-2 lg:gap-3 md:grid-cols-2"><div class="rounded bg-white shadow-small group hover:shadow-mediumHovered transition  cursor-pointer"><a class="block h-full" href="/en/reserve-parking"><div class="min-h-full relative bg-cover bg-center transition p-2 md:p-3 lg:flex false border rounded  bg-white group-hover:bg-blue09 "><div class=" lg:w-[60px] lg:mr-2.5 lg:mb-0 mb-1.5 mb-2"><svg width="60" height="60" fill="#202834" xmlns="http://www.w3.org/2000/svg" name="park" class="mr-1.5 fill-blue03" viewBox="-3 0 30 25"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.942 21.587c-.434 0-.76.11-.942.522v.328c.078.272.266.445.516.563h18.97c.248-.117.433-.293.515-.563v-.28c-.142-.427-.444-.568-.882-.568h-.786c-2.822.003-4.233.005-7.333.005h-.28v-7.142h5.164a1.28 1.28 0 0 0 .324-.028c.36-.096.523-.36.523-.834-.005-3.895-.003-7.79.005-11.688.002-.43-.134-.74-.546-.902H5.815c-.414.161-.546.472-.546.903.003 3.898.005 7.795.005 11.693 0 .6.257.859.851.859h5.158v7.139H8.746c-1.926.001-3.311.002-5.804-.007Zm3.752-8.549V2.417H17.31v10.621H6.694ZM11.2