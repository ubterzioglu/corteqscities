a.rte:hover,a.rte:active,a.rte:focus{-webkit-text-decoration:none;text-decoration:none;}/*!sc*/
a[name]:not([href]),a[id]:not([href]){color:inherit;cursor:inherit;-webkit-text-decoration:none;text-decoration:none;}/*!sc*/
