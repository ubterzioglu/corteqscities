,[592,593],[643,644],"\u002Fpolitie2018\u002Fassets\u002Fimages\u002Fsocial-icons\u002Finstagram.svg","icon-instagram","https:\u002F\u002Fwww.instagram.com\u002Fpolitie","Instagram",{"icon-class-2014":644,"image-url":643},[],{"site":650},{"href":645,"type":101},{"type":187,"links":652,"meta":653,"data":654},{},{},{"name":221,"siteMenuItems":655},[656,662,675,686,697,703,712,723],{"depth":364,"repositoryBased":87,"properties":657,"name":551,"expanded":87,"selected":87,"parameters":658,"childMenuItems":659,"links":660},{"hst:externallink":550},{},[],{"site":661},{"href":550,"type":101},{"depth":364,"repositoryBased":87,"properties":663,"name":669,"expanded":87,"selected":87,"parameters":670,"childMenuItems":671,"links":672},{"hst:referencesitemapitem":664,"hst:parameternames":665,"hst:parametervalues":667},"algemeen\u002Fdisclaimer.html",[666],"location",[668],"bottom","Disclaimer",{"location":668},[],{"site":673},{"href":674,"type":103},"\u002Falgemeen\u002Fdisclaimer.html",{"depth":364,"repositoryBased":87,"properties":676,"name":680,"expanded":87,"selected":87,"parameters":681,"childMenuItems":682,"links":683},{"hst:referencesitemapitem":677,"hst:parameternames":678,"hst:parametervalues":679},"algemeen\u002Fprivacyverklaring.html",[666],[668],"Privacyverklaring",{"location":668},[],{"site":684},{"href":685,"type":103},"\u002Falgemeen\u002Fprivacyverklaring.html",{"depth":364,"repositoryBased":87,"properties":687,"name":691,"expanded":87,"selected":87,"parameters":692,"childMenuItems":693,"links":694},{"hst:referencesitemapitem":688,"hst:parameternames":689,"hst:parametervalues":690},"algemeen\u002Fcookies.html",[666],[668],"Cookies",{"location":668},[],{"site":695},{"href":696,"type":103},"\u002Falgemeen\u002Fcookies.html",{"depth":364,"repositoryBased":87,"properties":698,"name":559,"expanded":87,"selected":87,"parameters":699,"childMenuItems":700,"links":701},{"hst:referencesitemapitem":558},{},[],{"site":702},{"href":564,"type":103},{"depth":364,"repositoryBased":87,"properties":704,"name":568,"expanded":87,"selected":87,"parameters":708,"childMenuItems":709,"links":710},{"hst:referencesitemapitem":567,"hst:parameternames":705,"hst:parametervalues":706},[666],[707],"top",{"location":707},[],{"site":711},{"href":573,"type":103},{"depth":364,"repositoryBased":87,"properties":713,"name":717,"expanded":87,"selected":87,"parameters":718,"childMenuItems":719,"links":720},{"hst:referencesitemapitem":714,"hst:parameternames":715,"hst:parametervalues":716},"algemeen\u002Ftoegankelijkheid.html",[666],[707],"Toegankelijkheid",{"location":707},[],{"site":721},{"href":722,"type":103},"\u002Falgemeen\u002Ftoegankelijkheid.html",{"depth":364,"repositoryBased":87,"properties":724,"name":537,"expanded":87,"selected":87,"parameters":726,"childMenuItems":727,"links":728},{"hst:referencesitemapitem":368,"hst:mountalias":725},"politie2014-en-site",{},[],{"site":729},{"href":536,"type":101},{"type":187,"links":731,"meta":732,"data":733},{},{},{"name":734,"siteMenuItems":735},"metaMenu",[736,742,748,754],{"depth":364,"repositoryBased":87,"properties":737,"name":669,"expanded":87,"selected":87,"parameters":738,"childMenuItems":739,"links":740},{"hst:referencesitemapitem":664},{},[],{"site":741},{"href":674,"type":103},{"depth":364,"repositoryBased":87,"properties":743,"name":680,"expanded":87,"selected":87,"parameters":744,"childMenuItems":745,"links":746},{"hst:referencesitemapitem":677},{},[],{"site":747},{"href":685,"type":103},{"depth":364,"repositoryBased":87,"properties":749,"name":691,"expanded":87,"selected":87,"parameters":750,"childMenuItems":751,"links":752},{"hst:referencesitemapitem":688},{},[],{"site":753},{"href":696,"type":103},{"depth":364,"repositoryBased":87,"properties":755,"name":717,"expanded":87,"selected":87,"parameters":756,"childMenuItems":757,"links":758},{"hst:referencesitemapitem":714},{},[],{"site":759},{"href":722,"type":103},{"type":185,"links":761,"meta":763,"data":764},{"site":762},{"href":314,"type":103},{},{"name":765,"displayName":766,"tekst":767,"formulierLink":240,"metaDescription":86,"titel":769,"introductie":86,"contentBlokken":770,"gerelateerdeVragenDto":240,"gerelateerdeVragen":861,"contentType":862,"secure":87,"enterpriseFormulier":240,"formConfirmFeedback":240,"formIntroFeedback":240,"formFeedback":240,"infoDesk":240,"attachmentInfodesk":87,"attachmentOntvanger":87,"beperkendeVragen":240,"hasFormulier":87,"preferredFormIntroFeedback":240,"localeString":85,"type":863,"lastModifiedDate":864,"sortableDate":865,"publicatieDatum":865,"id":866},"aangifte-van-diefstal-fiets","Aangifte van diefstal fiets",{"contentType":295,"value":768},"\u003Cp>U kunt hiervan aangifte doen. Let op:\u003C\u002Fp>\n\n\u003Cul>\n \u003Cli>Als u merkt dat uw fiets weg is, kan het zijn dat de gemeente hem heeft verwijderd. Hij hoeft dus niet gestolen te zijn. Voordat u aangifte doet, neemt u eerst contact op met het fietsdepot van de gemeente. Via \u003Ca href=\"https:\u002F\u002Fwww.verlorenofgevonden.nl\u002F\">deze link\u003C\u002Fa>&#160;zijn alle fietsendepots te raadplegen.&#160;Staat de fiets daar niet, dan is aangifte mogelijk.\u003C\u002Fli>\n \u003Cli>Het is belangrijk dat u het framenummer opgeeft. Dan kan de politie de fiets sneller terugvinden.&#160;Ook voor de verzekering is dit vaak verplicht.&#160;Dit nummer staat meestal op het eigendomsbewijs dat u&#160;van de fietsenhandelaar krijgt.\u003C\u002Fli>\n\u003C\u002Ful>","Mijn fiets is gestolen",[771,857],{"name":301,"displayName":301,"title":772,"beperkendeVragen":773,"postParameters":836,"beperkendeVragenName":851,"buttonIcon":852,"buttonTitle":854,"buttonDescription":855,"showEnqueteVraag":20,"contentType":856},"Online aangifte",[774,794,813,825],{"name":775,"displayName":775,"feedback":776,"vraag":792,"antwoord":87,"contentType":793},"politie:vraagantwoord",{"name":777,"displayName":777,"message":778,"type":780,"title":781,"actieBlok":782,"nextActionLabel":790,"contentType":791},"politie:feedback",{"contentType":295,"value":779},"\u003Cp>Bel om een afspraak te maken.\u003C\u002Fp>","info","De politie wil graag uw aangifte persoonlijk met u opnemen.",{"name":783,"displayName":783,"spoedDTO":784,"actiesDTO":785,"acties":786,"spoed":787,"titel":332,"formBlok":240,"contentType":333},"politie2018:actions",[],[],[],[788],{"name":327,"displayName":328,"label":306,"icon":305,"tekst":86,"ariaLabel":307,"titel":304,"link":789,"contentType":331},{"name":321,"displayName":321,"externalLink":308,"contentType":330},"---CLOSE-BUTTON---","politie2018:vraagantwoordFeedback","Is er geweld gebruikt tegen u of iemand anders?","politie:vraagantwoordIA",{"name":775,"displayName":775,"feedback":795,"vraag":812,"antwoord":87,"contentType":793},{"name":777,"displayName":777,"message":796,"type":780,"title":798,"actieBlok":799,"nextActionLabel":790,"contentType":791},{"contentType":295,"value":797},"\u003Cp>Klik op de link voor meer informatie.\u003C\u002Fp>","De politie heeft hiervoor een ander formulier",{"name":783,"displayName":783,"spoedDTO":800,"actiesDTO":801,"acties":802,"spoed":811,"titel":332,"formBlok":240,"contentType":333},[],[],[803],{"name":804,"displayName":805,"icon":313,"ondertitel":806,"titel":807,"contentType":319,"link":808},"inbraak-in-schuur-of-garage","Inbraak in schuur of garage online","Online aangifte doen","Aangifte inbraak in kelder, schuur of garage",{"name":321,"displayName":321,"anchor":86,"internalLink":809,"sendParameters":87,"contentType":324},{"uuid":810},"d55f1eea-6b69-4866-a61e-d4b02ad1dfa7",[],"Is de fiets gestolen uit een schuur, kelderbox of garage die niet via een woning te bereiken is?",{"name":775,"displayName":775,"feedback":814,"vraag":824,"antwoord":87,"contentType":793},{"name":777,"displayName":777,"message":815,"type":780,"title":781,"actieBlok":817,"nextActionLabel":790,"contentType":791},{"contentType":295,"value":816},"\u003Cp>Is er bij u thuis ingebroken of is dat geprobeerd, dan komt de politie in principe langs.&#160;Bel om de inbraak te melden.\u003C\u002Fp>",{"name":783,"displayName":783,"spoedDTO":818,"actiesDTO":819,"acties":820,"spoed":821,"titel":332,"formBlok":240,"contentType":333},[],[],[],[822],{"name":327,"displayName":328,"label":306,"icon":305,"tekst":86,"ariaLabel":307,"titel":304,"link":823,"contentType":331},{"name":321,"displayName":321,"externalLink":308,"contentType":330},"Is de fiets gestolen uit een woning, of uit een schuur, kelderbox of garage die via de woning te bereiken is?",{"name":775,"displayName":775,"feedback":826,"vraag":835,"antwoord":87,"contentType":793},{"name":777,"displayName":777,"message":827,"type":780,"title":781,"actieBlok":828,"nextActionLabel":790,"contentType":791},{"contentType":295,"value":779},{"name":783,"displayName":783,"spoedDTO":829,"actiesDTO":830,"acties":831,"spoed":832,"titel":332,"formBlok":240,"contentType":333},[],[],[],[833],{"name":327,"displayName":328,"label":306,"icon":305,"tekst":86,"ariaLabel":307,"titel":304,"link":834,"contentType":331},{"name":321,"displayName":321,"externalLink":308,"contentType":330},"Is dit langer dan een jaar geleden gebeurd?",[837,842,845,848],{"name":838,"displayName":838,"label":839,"waarde":840,"hasLabel":20,"contentType":841},"politie:postparameters","delictCategorie","DIEFSTAL","politie:keyvalue",{"name":838,"displayName":838,"label":843,"waarde":844,"hasLabel":20,"contentType":841},"goedCategorie","VOERTUIG",{"name":838,"displayName":838,"label":846,"waarde":847,"hasLabel":20,"contentType":841},"goedRol","GESTOLEN",{"name":838,"displayName":838,"label":849,"waarde":850,"hasLabel":20,"contentType":841},"goedType","FIETS","diefstal-fiets",{"$ref":853},"\u002Fpage\u002Fu9e1e06c4806b4958a15e4adefd66de7a","Start aangifte","U heeft uw DigiD nodig om online aangifte te kunnen doen.","politie2018:beperkendevragenblok",{"name":301,"displayName":301,"tekst":858,"contentType":860},{"contentType":295,"value":859},"\u003Ch2>Hulp nodig?\u003C\u002Fh2>\n\n\u003Cul>\n \u003Cli>Voordat u aangifte doet, vertelt de politie u graag wat uw \u003Ca href=\"\u002Fonderwerpen\u002Fslachtofferrechten.html\" data-type=\"internal\">rechten\u003C\u002Fa>&#160;als slachtoffer zijn.\u003C\u002Fli>\n \u003Cli>Heeft u nog geen DigiD? Vraag het online aan&#160;via \u003Ca href=\"http:\u002F\u002Fdigid.nl\u002Faanvragen\">DigiD\u003C\u002Fa>.\u003C\u002Fli>\n \u003Cli>Doet u liever persoonlijk aangifte? Bel 0900 - 8844 (\u003Ca href=\"\u002Fonderwerpen\u002Fbelkosten.html\" data-type=\"internal\">belkosten\u003C\u002Fa>) om een afspraak te maken.\u003C\u002Fli>\n\u003C\u002Ful>","common:tekstblok",[],"politie2018:contentdocument","contentdocument",1727183413505,1727183416183,"0552e23d-f600-4795-ab69-4e1770896be3",{"type":868,"links":869,"meta":870,"data":871},"imageset",{},{},{"name":872,"displayName":873,"actualImage":874,"w130h98":240,"w240h180":240,"w300h400":886,"w400h300":895,"w98h130":903,"w400h225":912,"w800h450":919,"w400h400":927,"fileName":872,"description":933,"thumbnail":934,"original":942,"contentType":950,"localeString":240,"id":951},"0f682971-b9fb-4f98-8709-73c29daf3419.jpg","Diefstal fiets 003cms.jpg",{"name":875,"displayName":875,"width":876,"height":877,"lastModified":878,"mimeType":879,"filename":240,"contentType":880,"size":881,"links":882},"politie2018imageset:genericlandscape",864,576,1792058384993,"image\u002Fjpeg","hippogallery:image",139300,{"site":883},{"href":884,"type":885},"https:\u002F\u002Fwww.politie.nl\u002Fbinaries\u002Fcontent\u002Fgallery\u002Fpolitie\u002Fonderwerpen\u002Fd\u002Fdiefstal-fiets\u002F0f682971-b9fb-4f98-8709-73c29daf3419.jpg\u002F0f682971-b9fb-4f98-8709-73c29daf3419.jpg\u002Fpolitie2018imageset%3Agenericlandscape","resource",{"name":887,"displayName":887,"width":888,"height":889,"lastModified":890,"mimeType":879,"filename":240,"contentType":880,"size":891,"links":892},"politieimageset:w300h400",300,400,1618826015134,46315,{"site":893},{"href":894,"type":885},"https:\u002F\u002Fwww.politie.nl\u002Fbinaries\u002Fw300h400\u002Fcontent\u002Fgallery\u002Fpolitie\u002Fo