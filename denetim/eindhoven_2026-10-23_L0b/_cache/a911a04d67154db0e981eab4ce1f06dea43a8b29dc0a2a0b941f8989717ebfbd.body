4f346946c863929aadd9",100,{"id":279,"links":280,"meta":283,"name":124,"type":126,"componentClass":273,"models":285},"r124_r9",{"self":281},{"href":282,"type":101},"https:\u002F\u002Fwww.politie.nl\u002Fheadless-api\u002Finformatie\u002Ffiets-gestolen-doe-aangifte.html?_hn:type=component-rendering&_hn:ref=r124_r9",{"params":284},{"path":123,"botName":124},{"chatbotRetain":240,"chatbotUrl":286,"chatbotJobChannelId":276,"chatbotEnabled":148,"chatbotChance":277},"https:\u002F\u002Fwww.politie.nl",{"type":185,"links":288,"meta":290,"data":291},{"site":289},{"href":21,"type":103},{},{"name":292,"displayName":293,"tekst":294,"metaDescription":297,"titel":293,"introductie":298,"contentBlokken":299,"gerelateerdeVragenDto":240,"gerelateerdeVragen":341,"gerelateerdeOnderwerpenDto":342,"gerelateerdeOnderwerpen":349,"contentType":352,"type":353,"lastModifiedDate":354,"sortableDate":355,"publicatieDatum":355,"localeString":85,"id":356},"fiets-gestolen-doe-aangifte","Fiets gestolen? Doe aangifte!",{"contentType":295,"value":296},"hippostd:html","\u003Cp>Doe altijd aangifte bij de politie (onderaan deze pagina).&#160;\u003Ca href=\"https:\u002F\u002Fwww.politie.nl\u002Faangifte-of-melding-doen\u002Faangifte-van-diefstal-fiets.html\">Aangifte doen kan online\u003C\u002Fa>&#160;of op een politiebureau. Alleen dan wordt uw fiets opgenomen in het&#160;\u003Ca href=\"https:\u002F\u002Ffdr.rdw.nl\u002F\">fietsdiefstalregister\u003C\u002Fa>. Dat helpt om uw fiets terug te vinden en om de dief en heler op te sporen. In overleg kan de fiets, als deze wordt achterhaald, ook bij u terugbezorgd worden. Zonder het doen van aangifte is er geen kans om uw fiets terug te krijgen via de politie.\u003C\u002Fp>","Doe altijd aangifte bij de politie (onderaan deze pagina). Aangifte doen kan online of op een politiebureau. Alleen dan wordt uw fiets opgenomen in het fietsdiefstalregister. Dat helpt om uw fiets terug te vinden en om de dief en heler op te sporen. In overleg kan de fiets, als deze wordt achterhaald, ook bij u terugbezorgd worden. Zonder het doen van aangifte is er geen kans om uw fiets terug te krijgen via de politie.","\u003Cp>Doe altijd aangifte bij de politie (onderaan deze pagina).&nbsp;\u003Ca href=\"https:\u002F\u002Fwww.politie.nl\u002Faangifte-of-melding-doen\u002Faangifte-van-diefstal-fiets.html\">Aangifte doen kan online\u003C\u002Fa>&nbsp;of op een politiebureau. Alleen dan wordt uw fiets opgenomen in het&nbsp;\u003Ca href=\"https:\u002F\u002Ffdr.rdw.nl\u002F\">fietsdiefstalregister\u003C\u002Fa>. Dat helpt om uw fiets terug te vinden en om de dief en heler op te sporen. In overleg kan de fiets, als deze wordt achterhaald, ook bij u terugbezorgd worden. Zonder het doen van aangifte is er geen kans om uw fiets terug te krijgen via de politie.\u003C\u002Fp>",[300,334],{"name":301,"displayName":301,"spoedDTO":302,"actiesDTO":309,"acties":315,"spoed":325,"titel":332,"formBlok":240,"contentType":333},"politie2018:contentblokken",[303],{"titel":304,"text":86,"icon":305,"label":306,"ariaLabel":307,"url":308},"Bel de politie","ic-telefoon","0900-8844","Bel 0 9 0 0 8 8 4 4","tel:09008844",[310],{"title":311,"subTitle":312,"icon":313,"url":314},"Aangifte fietsendiefstal","Doe online aangifte","ic-aangifte","\u002Faangifte-of-melding-doen\u002Faangifte-van-diefstal-fiets.html",[316],{"name":317,"displayName":318,"icon":313,"ondertitel":312,"titel":311,"contentType":319,"link":320},"fietsendiefstal-online","Fietsendiefstal Online","common:linktegel",{"name":321,"displayName":321,"anchor":86,"internalLink":322,"sendParameters":87,"contentType":324},"common:linkblokken",{"$ref":323},"\u002Fpage\u002Fu0552e23df6004795ab694e1770896be3","common:internelinkblok",[326],{"name":327,"displayName":328,"label":306,"icon":305,"tekst":86,"ariaLabel":307,"titel":304,"link":329,"contentType":331},"bel-0900-8844","Bel 0900-8844",{"name":321,"displayName":321,"externalLink":308,"contentType":330},"common:externelinkblok","common:linkparagraph","Reageer online","politi