<div id="weather" class="wrapper">
  <div class="columns filled-main-content">
    <div class="col-sm-12 col-md-10 col-md-offset-1">
      <div class="title-with-links is-oneline is-large">
    <h1 class="title-with-links__title margin-bottom-0">Verwachtingen</h1>
  <ul class="title-with-links__list is-inline">
	    	<li><a href="/nederland-nu/weer/waarschuwingen">Bekijk waarschuwingen</a></li>
