k_logo_dark.BgF1Q5O4.svg" alt="Logo Museumpark Vonk" class="header-image" data-v-b3dd928a><span class="visually-hidden" data-v-b3dd928a>- Home pagina</span><!--]--></a><div class="flex flex-nowrap align-center flex-nowrap" data-v-b3dd928a><nav class="site-menu" aria-label="Hoofdmenu navigatie mobiel" data-v-b3dd928a><ul class="no-bullets flex align-center flex-gap-8" data-v-b3dd928a><li data-v-b3dd928a><a class="btn btn-primary yellow" href="https://tickets.vonk.nl/" target="_blank" data-v-b3dd928a>Tickets</a></li><li data-v-b3dd928a><button aria-label="Open zoekbalk" class="search-button button-icon navbar-icon" data-v-b3dd928a><i class="UIIconComponent icon icon-search" data-v-b3dd928a></i></button></li><li data-v-b3dd928a><button class="button-icon navbar-icon" data-v-b3dd928a><i class="UIIconComponent icon icon-menu faq-icon" data-v-b3dd928a></i></button></li></ul></nav><!----></div></div></div></div></div></div><div class="search-results-wrapper" data-v-b3dd928a><div class="grid" data-v-b3dd928a><dialog class="search-dialog" data-v-b3dd928a data-v-40e572f8><div class="search-dialog__top mb-xs" data-v-40e572f8><div class="flex align-center justify-end mb-xxs" data-v-40e572f8><button class="search-dialog__close flex flex-nowrap align-center flex-gap-8" type="button" aria-label="Sluit zoekvenster" data-v-40e572f8><span class="inline-flex mr-xxs" aria-hidden="true" data-v-40e572f8> Sluiten </span><i class="UIIconComponent icon icon-close" aria-hidden="true" data-v-40e572f8></i></button></div></div><div class="search-dialog__content" data-v-40e572f8><div class="search-results-input" data-v-40e572f8><div class="UISearchInput" data-v-40e572f8 data-v-ed354e26><div class="search-wrapper flex align-center flex-nowrap justyify-space-between" data-v-ed354e26><div class="icon-container" data-v-ed354e26><i class="UIIconComponent icon icon-search search-icon" data-v-ed354e26></i></div><input id="search-input" value="" type="text" placeholder="Zoeken door de website" aria-label="Zoeken door de website" class="search-input" data-v-ed354e26></div></div></div><div class="search-results-wrapper" data-v-40e572f8><!----></div></div></dialog></div></div></header><!--]--><div class="nuxt-loading-indicator" style="position:fixed;top:0;right:0;left:0;pointer-events:none;width:auto;height:3px;opacity:0;background:repeating-linear-gradient(to right,#00dc82 0%,#34cdfe 50%,#0047e1 100%);background-size:0% auto;transform:scaleX(0%);transform-origin:left;transition:transform 0.1s, height 0.4s, opacity 0.4s;z-index:999999;" data-v-7104cc27></div><main data-v-7104cc27><!--[--><div><div class="contentblocksPageContainer"><div class="ContentBlockContainer"><!--[--><div class="contentblock-wrapper"><div class="HeaderContentBlock relative contentblock-item" id="1074" data-v-44a1c1b9><div class="grid" data-v-44a1c1b9><div class="col-6-12 sm-col-1-1" data-v-44a1c1b9><div class="text mb-xxxlg sm-mb-0" data-v-44a1c1b9><h1 class="content-title heading-1 anim-word-split" data-v-44a1c1b9>Contact</h1><div class="hide sm-show mb-xlg" data-v-44a1c1b9><!----><div class="btn-container flex align-center flex-gap-8 sm-mt-xs" data-v-44a1c1b9><!----><!----></div></div><p class="intro-text anim-line-split" data-anim-delay="600" data-v-44a1c1b9></p></div><div class="btn-container flex align-center flex-gap-8 sm-hide" data-v-44a1c1b9><!----><!----></div></div><div class="col-6-12 sm-col-1-1 flex align-end justify-end sm-hide" data-v-44a1c1b9><!----></div></div><div class="hero-circle" data-v-44a1c1b9><div class="ImageComponent header-image relative" fetchpriority="high" data-v-44a1c1b9><div class="image-wrapper"><picture class="img-w-align"><source sizes="100vw" srcset="https://vonk.nl/prod/media/vonk-overview.jpg?guid=aebf8614-403e-4a0c-abf7-9fdd5b4a3aa6&amp;width=400&amp;height=400&amp;format=webp 400w, https://vonk.nl/prod/media/vonk-overview.jpg?guid=aebf8614-403e-4a0c-abf7-9fdd5b4a3aa6&amp;width=800&amp;height=800&amp;format=webp 800w, https://vonk.nl/prod/media/vonk-overview.jpg?guid=aebf8614-403e-4a0c-abf7-9fdd5b4a3aa6&amp;width=1600&amp;height=1600&amp;format=webp 1600w, https://vonk.nl/prod/media/vonk-overview.jpg?guid=aebf8614-403e-4a0c-abf7-9fdd5b4a3aa6&amp;width=2000&amp;height=2000&amp;format=webp 2000w" type="image/webp"><img src="https://vonk.nl/prod/media/vonk-overview.jpg?guid=aebf8614-403e-4a0c-abf7-9fdd5b4a3aa6&amp;width=400&amp;height=400" class="has-alignment focus-50%-50% header-image relative" sizes="100vw" srcset="https://vonk.nl/prod/media/vonk-overview.jpg?guid=aebf8614-403e-4a0c-abf7-9fdd5b4a3aa6&amp;width=400&amp;height=400&amp;format=webp 400w, https://vonk.nl/prod/media/vonk-overview.jpg?guid=aebf8614-403e-4a0c-abf7-9fdd5b4a3aa6&amp;width=800&amp;height=800&amp;format=webp 800w, https://vonk.nl/prod/media/vonk-overview.jpg?guid=aebf8614-403e-4a0c-abf7-9fdd5b4a3aa6&amp;width=1600&amp;height=1600&amp;format=webp 1600w, https://vonk.nl/prod/media/vonk-overview.jpg?guid=aebf8614-403e-4a0c-abf7-9fdd5b4a3aa6&amp;width=2000&amp;height=2000&amp;format=webp 2000w" style="object-position:50% 50%;" fetchpriority="high" alt="Artist impression overview van Museumpark VONK."></picture><!----></div></div><!----></div></div></div><div class="contentblock-wrapper"><div class="TextOneColumnContentBlock contentblock-item" id="1075"><div class="grid"><div class="col-9-12 sm-col-1-1"><!----><div class="text raw"><h3>Bezoekadres</h3><p>Boutenslaan 161 B<br>5644 TV Eindhoven</p><h3>Telefoonnummer</h3><p>Algemeen telefoonnummer: <a href="tel: 040-252 22 81">040-252 22 81</a></p><h3>E-mailadres</h3><p>Algemeen e-mailadres: <a href="mailto:info@vonk.nl" target="_blank">info@vonk.nl</a></p><h3>Groepen</h3><p>Heb je vragen over groepsarrangementen of <a href="/nl/zien-doen/kinderfeestjes">kinderfeestjes</a>? Bekijk onze pagina over <a href="/zien-doen/groepen">groepsarrangementen</a>.&nbsp;</p><h3>Educatie</h3><p>Vragen over een educatief museumbezoek of schoolkamp? Bezoek onze pagina <a href="/nl/educatief/voor-scholen">voor scholen</a> voor meer informatie.&nbsp;</p><h3>Zakelijk</h3><p>Heb je vragen over de verhuur van het museum, het auditorium, de werkplaats of de brasserie? Bekijk onze pagina over <a href="/nl/zakelijk/plan-je-event">zakelijke arrangementen.</a></p><h3>Pers</h3><p>Voor persvragen, mediaverzoeken en aanvragen voor toegang tot het museum voor journalistieke doeleinden kun je contact opnemen met:&nbsp;</p><p>Monique Vernooij 040-252 22 81</p><h3>Vacatures</h3><p>Wil je graag bij VONK werken? Op onze <a href="/nl/over-ons/vacatures">vacature</a>-pagina vind je meer informatie over betaalde en vrijwillige functies.</p></div><!----></div></div></div></div><div class="contentblock-wrapper"><div class="FormContentBlock contentblock-item" id="1070" data-v-ba3df3e8><div class="grid" data-v-ba3df3e8><div class="col-1-2 sm-col-1-1 sm-mb-xxlg" data-v-ba3df3e8><h2 class="content-title heading-2 content-title" data-v-ba3df3e8>We helpen je graag verder</h2><span class="col-8-12 sm-col-1-1 no-p subtitle flex mb-md" data-v-ba3df3e8><div class="text raw" data-v-ba3df3e8><p>Heb je een vraag over je bezoek, onze collectie of een van onze activiteiten? De meeste antwoorden vind je bij de <a href="/nl/over-ons/veelgestelde-vragen">veelgestelde vragen</a>. Staat jouw vraag er niet tussen? Laat dan een bericht achter via het contactformulier. We reageren zo snel mogelijk.</p></div></span></div><div class="col-1-2 sm-col-1-1" data-v-ba3df3e8><span data-v-ba3df3e8></span></div></div></div></div><!--]--></div></div></div><!--teleport start--><!--teleport end--><!--]--></main><footer id="footer" class="footer q-mt-xl" data-v-7104cc27 data-v-593ab8d7><div class="main-footer mb-xxlg" data-v-593ab8d7><div class="grid" data-v-593ab8d7><div class="footer-container" data-v-593ab8d7><a href="/" class="logo" data-v-593ab8d7><!--[--><img src="/_nuxt/vonk_logo.BuLe2M33.svg" alt="Museumpark Vonk Logo" data-v-593ab8d7><!--]--></a><nav class="footer-nav" data-v-593ab8d7><div class="footer-nav-group" data-v-593ab8d7><