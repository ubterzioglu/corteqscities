ubugu sona bırakanlar, soba üstünde kestane yiyenler ve top kek sevenler.. Çocukluk anılarınız, ilk aşkınız, büyüdüğünüz yer, hayalleriniz, oyuncaklarınız... 90'larin ve 2000'lerin en guzel muzikleriyle eglenceli bir geceye hazir olun.\u0026nbsp;\u003c/p\u003e\u003cp\u003eHollandali dostlarinizi, ailenizi de getirin hep birlikte dunu ve bugun bizi biz yapan gunlerimizin melodilerini paylasalim!\u003c/p\u003e\u003cp\u003e\u003cem\u003eDikkat: Turkish Pop Night 18 yaşından büyükler içindir! Kapıda kimlik sorulabilir.\u0026nbsp;\u003c/em\u003e\u003c/p\u003e","links":null}},{"type":"embed","id":"6696d023-3e02-4dfd-91f3-a92edc9cb7ef","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/cpp69ghR1IM?si=brPWcxq0xWnnknHN\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724642985,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-turkish-pop-night-nl","queryHash":"[\"AgendaDetail-turkish-pop-night-nl\"]"},{"state":{"data":{"statusCode":404,"type":"ERROR"},"dataUpdateCount":1,"dataUpdatedAt":1792724638692,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"PageDetail-hybrid-music-vibes-2-pxrple-jazz-nl","queryHash":"[\"PageDetail-hybrid-music-vibes-2-pxrple-jazz-nl\"]"},{"state":{"data":{"statusCode":404,"type":"ERROR"},"dataUpdateCount":1,"dataUpdatedAt":1792724639664,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"f