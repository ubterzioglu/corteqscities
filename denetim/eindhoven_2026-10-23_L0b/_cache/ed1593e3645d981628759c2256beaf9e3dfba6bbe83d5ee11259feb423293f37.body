"genres":[{"id":48,"title":"indie"},{"id":121,"title":"Pop / Rock"},{"id":125,"title":"Upcoming"}],"club_card_event":false,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":true,"restaurant_reservation":true,"related_events":[]}]}},{"type":"featured_paragraph","id":"373d9a8e-41ac-4f05-9c0a-ab6d342ece78","header":{"title":"About Fuzz Club"},"content":{"content":"\u003cp\u003eFuzz Club is an independent record label established in 2012 and based in London, UK. Since its inception Fuzz Club has become a crucial catalyst in the European psych community and is now home to the likes of The Jesus and Mary Chain, Night Beats, Tess Parks, The Men, The Telescopes, Elephant Stone and The Vacant Lots, to name a few, and has previously put out releases by the likes of The Black Angels, A Place To Bury Strangers, Holy Wave, Dead Skeletons, Alan Vega, Anton Newcombe and many more.\u003c/p\u003e\r\n","image":{"image":{"alt":"Fuzz Club","src":"https://d12y285rxlbnxt.cloudfront.net/2023-12/Naamloos.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-12/Naamloos.png?itok=X0GiS_GL","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-12/Naamloos.png?itok=YbhPYFv7","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-12/Naamloos.png?itok=yoW8Bj92","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-12/Naamloos.png?itok=zX6n7pZd","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-12/Naamloos.png?itok=x9p4fVSi","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-12/Naamloos.png?itok=w-eprXbV"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-12/Naamloos.png?itok=X0GiS_GL 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-12/Naamloos.png?itok=YbhPYFv7 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-12/Naamloos.png?itok=yoW8Bj92 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-12/Naamloos.png?ito