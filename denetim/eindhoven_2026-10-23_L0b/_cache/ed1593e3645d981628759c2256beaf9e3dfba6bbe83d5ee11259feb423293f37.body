0%93%20Square%20afbeelding%20only%20mothers%20cak.png?itok=I5OhSCjW 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-08/%20%E2%80%93%20Square%20afbeelding%20only%20mothers%20cak.png?itok=dzq3xpfJ 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"+ Yeast Machine","upper_title":null,"tickets":[],"tags":[],"date":{"timestamp":1801267200,"machine":"2027-01-30"},"presale":null,"times":{"starts_at":"20:30","ends_at":null,"opens_at":"20:00"},"locations":[],"facebook_event":null,"genres":[],"club_card_event":true,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[]},{"type":"event","nid":1902,"slug":"/agenda/tramhaus-12feb","endpoint":"/nl/agenda/tramhaus-12feb","translations":{"nl":"/agenda/tramhaus-12feb","en":null},"title":"Tramhaus","content":"\u003cp\u003eNa het succes van debuutplaat ‘The First Exit’ zijn de Rotterdamse post-punkers van Tramhaus terug met het gloednieuwe album 'Blister’. Tramhaus floreert in het onbekende en zoekt daarin graag de grenzen van het gebruikelijke op. Geïnspireerd door bands Viagra Boys en Pissed Jeans, stoppen ze (post)punk in een nieuw jasje. Eerder hebben ze onze podia veroverd tijdens o.a. Come As You Are, Hit The City en een headliner show  in de Kleine Zaal. Nu staat de band te trappelen om ook de Grote Zaal te laten moshen.\u003c/p\u003e","meta":{"title":"Tramhaus | Effenaar","description":"Op 12 februari komt de Rotterdamse post-punkband Tramhaus terug naar Effenaar! Na Come As You Are, Hit The City en de Kleine Zaal, staat de band te trappelen om ook de Grote Zaal te veroveren. Verwacht ongetemde punk energie, snijdende gitaren en een charismatische frontman.","image":null},"publish_date":{"timestamp":1778842753,"machine":"2026-05-15T10:59:13+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Tramhaus header","src":"https://d12y285rxlbnxt.cloudfront.net/2026-05/_%E2%80%93%201920x1080%20Websi