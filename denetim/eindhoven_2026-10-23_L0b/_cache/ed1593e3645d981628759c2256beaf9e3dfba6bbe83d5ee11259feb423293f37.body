0w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/287301613_10161353703267985_2611610590945850500_n.jpg?itok=cnO1ygp9","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/287301613_10161353703267985_2611610590945850500_n.jpg?itok=WO5uqkrC"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/287301613_10161353703267985_2611610590945850500_n.jpg?itok=cYUfpKQV 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/287301613_10161353703267985_2611610590945850500_n.jpg?itok=DGSguKDB 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/287301613_10161353703267985_2611610590945850500_n.jpg?itok=dmGAWyNv 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/287301613_10161353703267985_2611610590945850500_n.jpg?itok=P7TB3C2y 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/287301613_10161353703267985_2611610590945850500_n.jpg?itok=cnO1ygp9 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/287301613_10161353703267985_2611610590945850500_n.jpg?itok=WO5uqkrC 720w"]},"source":"door Patrick Spruytenburg","source_link":null}]}},{"type":"embed","id":"01babd7b-eb8a-45e5-bd13-c89083df4d16","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/NaWGSAayPI0\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724692536,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-effenaar-t-wasven-dag-2-nl","queryHash":"[\"AgendaDetail-effenaar-t-wasven-dag-2-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":547,"slug":"/agenda/effenaar-t-wasven-dag-3","endpoint":"/nl/agenda/effenaar-t-wasven-dag-3","translations":{"nl":"/agenda/effenaar-t-wasven-dag-3","en":null},"title":"Effenaar 't Wasven | dag 3","content":"\u003cp\u003eDe zomer is in aantocht en dat betekent dat er ook dit jaar weer tijd is voor nieuwe edities van Effenaar ‘t Wasven. Zoals vanouds vinden de zomermiddagen plaats op het gezellige terrein van Groendomein ‘t Wasven. Op drie zomerse zondagen in juni, juli en augustus kun je komen genieten van livemuziek onder het genot van een lekker hapje en drankje. Trek je slippers en picknickkleed uit de kast, en dompel jezelf onder in het onovertroffen Effenaar ’t Wasven zomergevoel. De entree is gratis!\u003c/p\u003e\r\n","meta":{"title":"Effenaar 't Wasven | dag 3","description":"De zomer is in aantocht en dat betekent dat er ook dit jaar weer tijd is voor nieuwe edities van Effenaar ‘t Wasven. Zoals vanouds vinden de zomermiddagen plaats op het gezellige terrein van Groendomein ‘t Wasven. Op drie zomerse zondagen in juni, juli en augustus kun je komen genieten van livemuziek onder het genot van een lekker hapje en drankje. Trek je slippers en picknickkleed uit de kast, en dompel jezelf onder in het onovertroffen Effenaar ’t Wasven zomergevoel. De entree is gratis!","image":{"image":{"alt":"wasven23 square","src":"https://d12y285rxlbnxt.cloudfront.net/2023-05/Square.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/Square.png?itok=3fWIpUEi","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/Square.png?itok=0_6zf3dZ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/Square.png?itok=uz0ns9-l","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/Square.png?itok=5UsMH5W7","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/Square.png?itok=pUh8G7aJ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720