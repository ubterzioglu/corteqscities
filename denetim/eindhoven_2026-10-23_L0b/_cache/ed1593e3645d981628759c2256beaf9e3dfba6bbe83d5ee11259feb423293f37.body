lbnxt.cloudfront.net/styles/2510w/s3/2026-05/Discophonic.png?itok=nXUSroTy","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/Discophonic.png?itok=6qR79GD1","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/Discophonic.png?itok=_Kzj5IhU","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/Discophonic.png?itok=vCu9S1mp"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/Discophonic.png?itok=xo9k6dwi 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/Discophonic.png?itok=SBmyJOzn 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/Discophonic.png?itok=nXUSroTy 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/Discophonic.png?itok=6qR79GD1 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/Discophonic.png?itok=_Kzj5IhU 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/Discophonic.png?itok=vCu9S1mp 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#F7A920","background_color":"#2A2859","text_color":"#FFFFFF"}}],"blocks":[{"type":"paragraph","id":"4c2e044a-125e-459d-9d80-07f6ac8ee993","header":{"title":null},"content":{"content":"\u003cp\u003eDe stem, uitstraling en podiumact van Jürgen Wendelen - half Brits, half Belgisch - komen eng dicht in de buurt van de legendarische frontman in zijn hoogtijdagen. Compleet met band die vol precisie en overgave speelt, is dit een briljant eerbetoon en een avond vol nostalgie. Wie niet de kans had om in Amsterdam in 1984 het enige Nederlandse optreden ooit van The Smiths bij te wonen, of wie er graag nog eens aan herinnerd wordt, reist op zaterdag 30 januari met deze charming men terug de tijd in!\u003c/p\u003e","links":null}},{"type":"embed","id":"47637949-879c-4ce9-8e17-816e062a1a82","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/cqvhnLxD_Pk?si=xwTvc1ia4rSqXuaj\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"related_event","id":"772960d4-ae37-4e9c-93d2-3f22d2c4d2d4","header":{"title":"80's Anders","description":"\u003cp\u003eOp zaterdag 30 januari geniet je na The Smiths Presumably helemaal gratis van de lekkerste tracks uit de 80's. De DJ's van 80's Anders kammen hun vinylcollectie nog een keer goed uit en brengen de vetste songs van bands als Joy Divison, The Cure, Depeche Mode, New Order, The Clash, Anne Clark, The Specials, RUN DMC, Yazoo, Soft Cell, Simple Minds, The Smiths, The Cramps en nog veel meer!\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLet op: voor deze avond geldt een minimale leeftijd van 18 jaar\u003c/strong\u003e\u003c/p\u003e"},"content":{"items":[{"type":"event","nid":2033,"slug":"/agenda/80sanders-30jan","endpoint":"/nl/agenda/80sanders-30jan","translations":{"nl":"/agenda/80sanders-30jan","en":null},"title":"80's Anders","content":"\u003cp\u003eOp zaterdag 30 januari geniet je helemaal gratis van de lekkerste tracks uit de 80's. De DJ's van 80's Anders kammen hun vinylcollectie nog een keer goed uit en brengen de vetste songs van bands als Joy Divison, The Cure, Depeche Mode, New Order, The Clash, Anne Clark, The Specials, RUN DMC, Yazoo, Soft Cell, Simple Minds, The Smiths, The Cramps en nog veel meer!\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLet op: voor deze avond geldt een minimale leeftijd van 18 jaar.\u003c/strong\u003e\u003c/p\u003e","meta":{"title":"80's Anders in Effenaar","description":"Geniet helemaal gratis van de lekkerste tracks uit de 80's. De DJ's van 80's Anders kammen hun vinylcollectie nog een keer goed uit en brengen de 