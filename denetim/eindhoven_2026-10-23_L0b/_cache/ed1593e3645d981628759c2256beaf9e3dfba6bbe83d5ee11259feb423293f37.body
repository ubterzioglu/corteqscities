loudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"31bbff14-a2f5-4610-a9c4-142d841977a0","header":{"title":null},"content":{"content":"\u003cp\u003eHAMMOK is een gloednieuw noise trio uit Noorwegen, dat elke associatie met de serene landschappen en idyllisch besneeuwde bergtoppen van het land ver achter zich laat. In plaats daarvan brengen ze je noisy punk/rock en post-hardcore met een akelige intensiteit en wreedheid, waarin ze niet schromen de grenzen van het genre op te rekken. Aan de chaotische mix worden grooves, knappe ritmewisselingen en een hiphop attitude toegevoegd. Maar absoluut hoogtepunt zijn hun live-shows, waar frontman Tobias Maxwell Osland monitorspeakers, het publiek, de bar, al crowdsurfend trotseert zonder ook maar een noot te missen. Moshpits gegarandeerd, dus wees erbij op zaterdag 30 maart in het Stroomhuis.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"917509b4-0f6e-4d13-b557-7db331c94721","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e20:00 uur: Deuren open\u003cbr /\u003e\r\n20:30 uur: Show Wrong Man\u003cbr /\u003e\r\n21:30 uur: Show HAMMOK\u003cbr /\u003e\r\n(tijden zijn onder voorbehoud)\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_quote","id":"12bc2770-b0c1-4501-a4b8-122a5378e1a1","header":{"title":null,"description":null},"content":{"quote":"Jumping/Dancing/Fighting is a polished introduction that posits Hammok not merely as noise-rock newcomers, but also erudite students of the genre who hit the ground running.","author":"Pitchfork"}},{"type":"embed","id":"49a891fb-8a90-44f3-a0ab-9044dc2e9d0c","header":{"title":null,"description":null},"content":{"embed":" \u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/_S0lj-RDdgk?si=tKPCiPMgyDuqcfHp\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"aa0d9862-534b-4c80-9f1a-382b48df24fd","header":{"title":"Wrong Man"},"content":{"content":"\u003cp\u003eWrong Man werd in 2021 opgericht door een groep vrienden met een gedeelde liefde voor een breed scala aan muziek en een gezamenlijke achtergrond in hardcore/punk. Het resultaat is een geluid dat gedijt op de spanning tussen luide gitaren, subtiele melodieën en een bluesy groove. In hun nummers hoor je invloeden van post-hardcore, post-punk, MTV’s 120 minutes’ alternatieve rock en flarden van Fugazi, Quicksand, Swiz, Rollins Band \u0026amp; The Jesus Lizard terug. Luister zelf en kijk wat je vindt; deze avond spelen ze de support voor HAMMOK!\u003c/p\u003e\r\n","image":{"image":{"alt":"Wrong Man square","src":"https://d12y285rxlbnxt.cloudfront.net/2024-02/Wrong%20Man.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/Wrong%20Man.png?itok=xWD1yZ8O","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/Wrong%20Man.png?itok=0QLxkTrl","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/Wrong%20Man.png?itok=hI5BuLdF","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/Wrong%20Man.png?itok=8dQVsOBe","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/Wrong%20Man.png?itok=qX9VK6zQ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/Wrong%20Man.png?itok=sbmKGXev"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/Wrong%20Man.png?itok=xWD1yZ8O 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/Wrong%20Man.png?itok=0QLxkTrl 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/Wrong%20Man.png?itok=hI5BuLdF 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/Wrong%20Man.png?itok=8dQVsOBe 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/Wrong%20Man.png?itok=qX9VK6zQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/Wrong%20Man.png?itok=sbmKGXev 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724619705,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-hammok-nl","queryHash":"[\"AgendaDetail-hammok-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":859,"slug":"/agenda/cucamaras","endpoint":"/nl/agenda/cucamaras","translations":{"nl":"/agenda/cucamaras","en":null},"title":"Cucamaras","content":"\u003cp\u003e\u003cstrong\u003eLet op: deze show was oorspronkelijk een middagshow in Altstadt, maar is naar de avond verplaatst. De nieuwe locatie is Stroomhuis en de show wordt een double bill met Beige Banquet:\u003c/strong\u003e\u003c/p\u003e\r\n","meta":{"title":"Cucamaras","description":"Na het succes van hun eerste twee releases en een druk liveschema, is het indie/post-punkkwartet Cucamaras klaar om een stap verder te gaan met hun aankomende EP ‘Soft Soap’. De band, bestaande uit Josh Hart, Olly Bowley, Dan McGrath en Joe Newton, heeft een sterke interesse ontwikkeld vanuit de lokale scene in Nottingham, waar ze The Bodega uitverkochten in 2021. De nieuwste EP demonstreert de uitbreiding van de richting van de band en biedt een kijkje in hun toekomst. Tijdens afgelopen ESNS wisten ze Huize Maas tot de nok toe te vullen, het is nu tijd voor een bezoekje aan Altstadt!","image":{"image":{"alt":"cuca square","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/square%20cucamaras.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/square%20cucamaras.jpg?itok=YfbBhm_4","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/square%20cucamaras.jpg?itok=Cl4Cq2Xs","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/square%20cucamaras.jpg?itok=Lri5RaR5","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/square%20cucamaras.jpg?itok=jaEyd33H","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/square%20cucamaras.jpg?itok=flyfdECe","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/square%20cucamaras.jpg?itok=fb_hySBd"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/square%20cucamaras.jpg?itok=YfbBhm_4 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/square%20cucamaras.jpg?itok=Cl4Cq2Xs 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/square%20cucamaras.jpg?itok=Lri5RaR5 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/square%20cucamaras.jpg?itok=jaEyd33H 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/square%20cucama