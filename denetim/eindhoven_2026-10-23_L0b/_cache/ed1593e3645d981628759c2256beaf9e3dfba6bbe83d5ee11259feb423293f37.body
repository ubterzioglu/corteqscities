udfront.net/styles/720w/s3/2026-05/effenaar%201080x1080.jpg?itok=cPJMIIG8"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/effenaar%201080x1080.jpg?itok=3ltegrN5 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/effenaar%201080x1080.jpg?itok=aOhwLyuA 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/effenaar%201080x1080.jpg?itok=lLhSrh_A 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/effenaar%201080x1080.jpg?itok=uN23JmK0 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/effenaar%201080x1080.jpg?itok=E1dKNIT_ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/effenaar%201080x1080.jpg?itok=cPJMIIG8 720w"]},"source":null,"source_link":null},"locations":[{"id":183,"title":"Klokgebouw","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#fb9101","background_color":"#f0d5ba","text_color":"#000000"}}],"blocks":[{"type":"featured_paragraph","id":"f04ecfb4-576f-41a9-a0e1-1f7f1fd1c1dd","header":{"title":"14:00-14:45 Gos Rosling"},"content":{"content":"\u003cp\u003eGooi de sound van Phoebe Bridgers, RHODES en James Hersey in een blender en je krijgt de unieke stijl van de uit Sittard afkomstige singer-songwriter Gos Rosling. Eerder verzorgde hij de support voor o.a. BOAZ en Jesse Barnet (Stick To Your Guns) en nu is het tijd om het groendomein van ‘t Wasven te komen betoveren!\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"gos rosling png","src":"https://d12y285rxlbnxt.cloudfront.net/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=fUFDiXIm","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=21ky-PPd","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=Gatffg8d","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=S_tL8b3r","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=Qg20G15D","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=OsCiR40c"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=fUFDiXIm 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=21ky-PPd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=Gatffg8d 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=S_tL8b3r 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=Qg20G15D 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/GOS%20ROSLING%20-%20PRESS%20PICTURE%20002_0.png?itok=OsCiR40c 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"featured_paragraph","id":"fee8b12f-942a-443b-99a2-f6eb20351cb2","header":{"title":"15:15-16:00 Lotte Walda"},"content":{"content":"\u003cp\u003eLotte wil graag een optimistische kleur geven aan het straatbeeld en pure muziek maken om met verschillende mensen in aanraking te komen. Met haar stemgeluid en gitaarwerk ontregelt de zangeres de vibraties in de lucht met een duidelijk doel: haar medemens raken, troosten of aan te sporen om het leven dieper te verkennen. Geïnspireerd door de geluiden van de 60’s en 70’s, voeren thema’s als oprechtheid, spiritualiteit, liefde en saamhorigheid de boventoon in haar warme, soulvolle liedjes.\u003c/p\u003e\r\n","image":{"image":{"alt":"lotte walda png","src":"https://d12y285rxlbnxt.cloudfront.net/2023-06/i-want-fearless-eyes-1200x802.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=49RDwVrj","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=D8koE965","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=If1xl6cA","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=uO5fo1mn","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=PCte0exi","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=W6hVDQ3-"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=49RDwVrj 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=D8koE965 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=If1xl6cA 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=uO5fo1mn 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=PCte0exi 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/i-want-fearless-eyes-1200x802.png?itok=W6hVDQ3- 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"featured_paragraph","id":"57040ba6-671e-454d-8acd-7f1f4b63a6f9","header":{"title":"16:30-17:15 Muylike"},"content":{"content":"\u003cp\u003eMuylike (moeilijk) is het project van de Utrechtse songwriter en producer Stijn Post. Verwacht zonnige, opgewekte indiepop, aangesterkt door energieke koortjes en melodieuze gitaarlijnen. Op het podium weet Muylike een aanstekelijke show te geven waarbij je lastig stil kunt staan.\u003c/p\u003e\r\n","image":{"image":{"alt":"muylike ","src":"https://d12y285rxlbnxt.cloudfront.net/2023-06/Muylike%20PressPhoto.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/Muylike%20PressPhoto.png?itok=sIHCSbdY","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/Muylike%20PressPhoto.png?itok=_FLEv15r","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/Muylike%20PressPhoto.png?itok=EMw4TZaV","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/Muylike%20PressPhoto.png?itok=YhukXtvA","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/Muylike%20PressPhoto.png?itok=XX0JbeCf","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/Muylike%20PressPhoto.png?itok=pja-Cur6"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/Muylike%20PressPhoto.png?itok=sIHCSbdY 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/Muylike%20PressPhoto.png?itok=_FLEv15r 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/Muylike%20PressPhoto.png?itok=EMw4TZaV 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/Muylike%20PressPhoto.png?itok=YhukXtvA 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/Muylike%20PressPhoto.png?itok=XX0JbeCf 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/Muylike%20PressPhoto.png?itok=pja-Cur6 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"6ea22eed-bd10-4d02-b5c9-d6b0690fcc64","header":{"title":"Duurzaamheid"},"content":{"content":"\u003cp\u003eMet het oog op duurzaamheid, verzoekt de organisatie van Groendomein 't Wasven zoveel mogelijk gasten met de fiets te komen. Ook wordt er gebruik gemaakt van hardcups, om wegwerpplastic tegen te gaan.\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"263479ed-7cab-4fd8-b6be-bad8d6c9de29","