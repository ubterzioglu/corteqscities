gram%20afbeelding%20onlykpop.png?itok=NQhupPl4 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#70cef6","background_color":"#000000","text_color":"#FFFFFF"}}],"blocks":[{"type":"paragraph","id":"bc43f979-3536-432d-8191-a2b6f64ece52","header":{"title":"ENG"},"content":{"content":"\u003cp\u003eISOLATED descends into EFFENAAR, EINDHOVEN for a night dedicated to the raw essence of Schranz and Industrial Hard Techno.\u003c/p\u003e\u003cp\u003eAn intimate boiler-room setting, a heavy atmosphere, and uncompromising sound will shape a night of pure intensity.\u003c/p\u003e\u003cp\u003eExpect to feel the music, lose yourself in the energy, and become part of a crowd locked into the moment from start to finish. With international debuts, the return of a hard techno legend, and a strict No Phone Policy, this night is built around full immersion.\u003c/p\u003e\u003cp\u003eGet ready to live in the moment, ISOLATED from the outside world.\u003c/p\u003e","links":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724605085,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-isolated-nl","queryHash":"[\"AgendaDetail-isolated-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1653,"slug":"/agenda/outerspass-9mei","endpoint":"/nl/agenda/outerspass-9mei","translations":{"nl":"/agenda/outerspass-9mei","en":null},"title":"Outerspass","content":"\u003cp\u003eNa een mega succesvolle show in onze Kleine Zaal komen de mannen van Outerspass terug naar Effenaar! Geboren en getogen in een Duisburgse Laufhaus, creëert het maniakale duo van Outerspass een eigen taal en genre door hun hedonistische teksten in het Duits, gemixt met Nederlandse en Engelstalige slang uit volle borst te schreeuwen over beukende, aardbevingveroorzakende beats, waarop menig fervent moshpit-deelnemer zonder twijfel volledig aan zijn of haar trekken zal komen. Kauf schnell die tickets ja? \u003c/p\u003e\u003cp\u003e\u003cstrong\u003eTijdschema\u003c/strong\u003e\u003cbr\u003e19:30 Deuren open\u003cbr\u003e20:15 - 20:45 Kleine Crack + Slagter\u003cbr\u003e21:00 - 22:00 Outerspass\u003c/p\u003e\u003cp\u003e(Let op: tijden onder voorbehoud)\u003c/p\u003e\u003cp\u003e \u003c/p\u003e","meta":{"title":"Outerspass | Effenaar","description":"Na een mega succesvolle show in onze Kleine Zaal komen de mannen van Outerspass terug naar Effenaar! Met een eigen taal die ergens tussen Duits, Nederland en Engels ligt maken ze bizar harde hiphop die je uitnodigt voor moshpits en vuisten in de lucht. Kauf die tickets schnell ja?","image":{"image":{"alt":"Outerspass","src":"https://d12y285rxlbnxt.cloudfront.net/2025-10/%20%E2%80%93%201920x1080%20WebsiteOuterspass.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteOuterspass.png?itok=uVc9nxZi","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteOuterspass.png?itok=sOW9St6n","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteOuterspass.png?itok=gdXg7fxe","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteOuterspass.png?itok=OSyq37Oa","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteOuterspass.png?itok=rjQ56eSu","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteOuterspass.png?itok=Sp7JARHy"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteOuterspass.png?itok=uVc9nxZi 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-10/%20%E2%80%93%201920x1