erke interesse ontwikkeld vanuit de lokale scene in Nottingham, waar ze The Bodega uitverkochten in 2021. De nieuwste EP demonstreert de uitbreiding van de richting van de band en biedt een kijkje in hun toekomst.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"580d3ce0-d9cc-4bb0-8627-fa7b05660f20","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/qi6NOKAHSGs?si=MHo7WLUCe3p5u5Sk\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"embed","id":"f4e41891-7fa7-4563-bf6d-d7579849e7d8","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/1omvo1hvCG4XzDRmreWjLJ?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724620330,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-cucamaras-nl","queryHash":"[\"AgendaDetail-cucamaras-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":800,"slug":"/agenda/beige-banquet-cucamaras","endpoint":"/nl/agenda/beige-banquet-cucamaras","translations":{"nl":"/agenda/beige-banquet-cucamaras","en":null},"title":"Beige Banquet + Cucamaras","content":"\u003cp\u003eWelkom in de hoekige wereld van Beige Banquet. Het is gevuld met grillige gitaren, grooves en scherpe herhalingen.\u003c/p\u003e\r\n","meta":{"title":