ben-hillen","date":{"timestamp":1803600000,"machine":"2027-02-26"},"thumbnail_image":{"image":{"alt":"Ruben Hillen square","src":"https://d12y285rxlbnxt.cloudfront.net/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=cGp5L1LS","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=mp2EcSqv","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=7QWM55WD","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=6a_qtZwK","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=OgWJY5W8","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=9eransCP"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=cGp5L1LS 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=mp2EcSqv 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=7QWM55WD 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=6a_qtZwK 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=OgWJY5W8 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/%20%E2%80%93%20Square%20afbeelding%20only_2.png?itok=9eransCP 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#c6c8bd","background_color":"#40583c","text_color":"#ffffff"}}],"blocks":[{"type":"paragraph","id":"88cd89fe-71d2-4e7a-8efe-865d212335ee","header":{"title":null},"content":{"content":"\u003cp\u003eNa een korte pauze verscheen eerder in 2026 het vierde album 'EXIT', tien jaar na het debuut van de band. Op deze plaat klink Bazart minder bezig met bewijzen en meer met vertrouwen op intuïtie. Thema’s als loslaten, opnieuw beginnen, afstand en jezelf terugvinden lopen als een rode draad door de plaat. Toch blijft er altijd licht binnenvallen. Songs als ‘Begin Opnieuw’, ‘Nooduitgang’ en ‘Nacht In Amsterdam’ bewegen voortdurend tussen melancholie en hoop, alsof de band geleerd heeft dat die twee perfect naast elkaar kunnen bestaan.\u003c/p\u003e","links":null}},{"type":"embed","id":"2d3df1a8-1cb7-42cd-a4a9-fdea92dbc466","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/mom1TVIF4Os?si=pQAWPwp3OWUFl2ar\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724657122,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-bazart-nl","queryHash":"[\"AgendaDetail-bazart-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1212,"slug":"/agenda/fuzz-club-festival-2025-0","endpoint":"/nl/agenda/fuzz-club-festival-2025-0","translations":{"nl":"/agenda/fuzz-club-festival-2025-0","en":null},"title":"Fuzz Club Festival 2025","content":"\u003cp\u003eEindhoven will once again dive into two days of the best of psych, dystopian visuals and vinyl. For those who love everything fuzz, reverb, and drone, we’re excited to announce a collaboration with London-based indie label Fuzz Club for a new edition of Fuzz Club festival. Join us on Friday, May 9, and Saturday, May 10, with performances by Goat, Los Bitchos, Sonic Boom, Orions Belte, Rose City Band, The KVB, MIEN and many more. \u003c/p\u003e\r\n","meta":{"title":"Fuzz Club Festival 2025","description":"","image":null},"publish_date":{"timestamp":1729691700,"machine":"2024-10-23T13:55:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Los Bitchos header","src":"https://d12y285rxlbnxt.cloudfront.net/2025-02/los%20bitchos%20header.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-02/los%20bitchos%20header.jpg?itok=ldpgXPVr","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-02/los%20bitchos%20header.jpg?itok=ZsfC_rt5","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-02/los%20bitchos%20header.jpg?itok=Jlqe-Irq","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-02/los%20bitchos%20header.jpg?itok=IBEnW_PD","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-02/los%20bitchos%20header.jpg?itok=OKwJ3Jv6","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-02/los%20bitchos%20header.jpg?itok=zDYn-OzK"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-02/los%20bitchos%20header.jpg?itok=ldpgXPVr 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-02/los%20bitchos%20header.jpg?itok=ZsfC_rt5 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-02/los%20bitchos%20header.jpg?itok=Jlqe-Irq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-02/los%20bitchos%20header.jpg?itok=IBEnW_PD 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-02/los%20bitchos%20header.jpg?itok=OKwJ3Jv6 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-02/los%20bitchos%20h