0Square%20afbeelding%20only_7.png?itok=CdcCbEvO","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-02/%20%E2%80%93%20Square%20afbeelding%20only_7.png?itok=CxZLIdJ2","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-02/%20%E2%80%93%20Square%20afbeelding%20only_7.png?itok=TljcFZYn"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-02/%20%E2%80%93%20Square%20afbeelding%20only_7.png?itok=jLoj565G 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-02/%20%E2%80%93%20Square%20afbeelding%20only_7.png?itok=fYrJ5DNz 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-02/%20%E2%80%93%20Square%20afbeelding%20only_7.png?itok=zS6zFdg1 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-02/%20%E2%80%93%20Square%20afbeelding%20only_7.png?itok=CdcCbEvO 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-02/%20%E2%80%93%20Square%20afbeelding%20only_7.png?itok=CxZLIdJ2 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-02/%20%E2%80%93%20Square%20afbeelding%20only_7.png?itok=TljcFZYn 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"Enige NL show van Japanse rockgrootheden gehuld in wolvenmaskers | + Hands Like Houses","upper_title":null,"tickets":[],"tags":[],"date":{"timestamp":1760054400,"machine":"2025-10-10"},"presale":null,"times":{"starts_at":"20:15","ends_at":null,"opens_at":"19:30"},"locations":[],"facebook_event":{"uri":"https://www.facebook.com/events/1275998480364827","title":"","options":{"url":"https://www.facebook.com/events/1275998480364827"}},"genres":[],"club_card_event":false,"ticket_url":{"uri":"https://www.ticketmaster.nl/event/1876790772?CAMEFROM=EFFENAAR\u0026brand=nl_effenaar","title":"","options":{"url":"https://www.ticketmaster.nl/event/1876790772?CAMEFROM=EFFENAAR\u0026brand=nl_effenaar"}},"ticket_price":"38.00","state":null,"locker_reservation":false,"restaurant_reservation":true,"related_events":[]},{"type":"event","nid":1516,"slug":"/agenda/ist-ist","endpoint":"/nl/agenda/ist-ist","translations":{"nl":"/agenda/ist-ist","en":null},"title":"IST IST","content":"\u003cp\u003eReken er maar op dat postpunk anno 2025 nog altijd springlevend is, zeker als het aan IST IST ligt. Deze Britse band uit Manchester, de bakermat van het legendarische Factory Records (het label dat onder andere Joy Division en New Order uitbracht), maakt muziek die net zo grauw is als hun omgeving. De diepe stem van frontman Adam Houghton roept dan ook vaak vergelijkingen op met Ian Curtis, maar vergis je niet: IST IST klinkt vooral heel eigen, frisser en minder zwaar op de hand dan hun invloeden. Met veel new wave-achtige synths, galmende gitaren en zowel melancholische als grootse refreinen.\u003c/p\u003e","meta":{"title":"IST IST in Effenaar","description":"Reken maar dat postpunk anno 2025 springlevend is, zeker als het aan IST IST ligt. Deze Britse band timmert hard aan de weg met een meeslepend geluid dat net zo goed klinkt in je koptelefoon als op het grote podium. Dat laatste ervaar je zelf op vrijdag 17 oktober in onze Grote Zaal. Fans van Editors, Interpol, Joy Division, Whispering Sons en Bauhaus: zet het maar op je lijstje!","image":null},"publish_date":{"timestamp":1751363400,"machine":"2025-07-01T09:50:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"IST IST header","src":"https://d12y285rxlbnxt.cloudfront.net/2025-06/%20%E2%80%93%201920x1080%20Website_4.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-06/%20%E2%80%93%201920x1080%20Website_4.jpg?itok=H6HjjB0p","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-06/%20%E2%80%93%201920x1080%20Website_4.jpg?itok=vT_k8zhD","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-06/%20%E2%80%93%201920x1080%20Website_4.jpg?itok=Q9GC9Oei","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-06/%20%E2%80%93%201920x1080%20Website_4.jpg?itok=-nMek