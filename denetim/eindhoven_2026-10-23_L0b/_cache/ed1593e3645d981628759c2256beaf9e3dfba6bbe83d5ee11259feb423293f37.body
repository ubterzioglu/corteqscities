y%20gallowstr.png?itok=EyMLiGdS","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=dzKzM-eD","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=EFGl8O8l","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=nM2oREar","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=bJBaYU1j"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=V7Fp0_u4 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=EyMLiGdS 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=dzKzM-eD 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=EFGl8O8l 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=nM2oREar 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=bJBaYU1j 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":"last_tickets","club_card_event":true,"colors":{"accent_color":"#F28F6B","background_color":"#011826","text_color":"#ffffff"}}],"blocks":[{"type":"paragraph","id":"0f722f6c-b2d6-45da-bf72-a95d841909bf","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:30 uur: Deuren open\u003cbr /\u003e\r\n20:00 uur: Show Vieux Farka Touré\u003cbr /\u003e\r\n(tijden onder voorbehoud)\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"602ae25d-d828-45e4-b5d5-c01f518b6f19","header":{"title":"Zo vader, zo zoon"},"content":{"content":"\u003cp\u003eHij is de zoon van Ali Farka Touré, één van de meest gevierde gitaarhelden van Mali en het hele Afrikaanse continent. Eigenlijk wilde de in 2006 overleden gitaarheld niet dat zijn zoon in zijn voetsporen zou treden. Toch deed hij het. En met verve. Van een Jordi Cruijff-complex heeft Vieux allerminst last: hij bouwt gestaag aan zijn oeuvre en heeft zijn eigen prachtige gitaargeluid geboetseerd. Ritmisch avontuurlijk, bezwerend, dansbaar en onconventioneel. Het geluid van de woestijn, gevangen door zes snaren. Samen met Khruangbin bracht Vieux in 2022 een hommage aan zijn overleden vader uit. Luister naar het album ‘Ali’ en je hebt meteen door wat de magie van zowel vader als zoon is.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"c5ffd80c-e0c0-4c90-878f-0b392f716535","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/artist/4PmxbsWP1u0TnvqcrIA9ze?utm_source=generator\u0026theme=0\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"cta","id":"57558dd3-3aa3-4dc6-a098-9677a01001de","header":{"title":null,"description":null},"content":{"cta_title":"Meer info en de laatste updates over BRIDGE Guitar Festival bekijken?","cta_description":null,"url":{"uri":"https://bridgefestival.com/","title":"Bezoek hier de website van BRIDGE! ","options":{"url":"https://bridgefestival.com/"}},"description":null,"title":null}},{"type":"cta","id":"aef5ba54-d62f-400a-a050-147bf3c59fcd","header":{"title":null,"description":null},"content":{"cta_title":"Alvast een locker reserveren?","cta_description":null,"url":{"uri":"https://effenaar.elockers.shop/effenaar/