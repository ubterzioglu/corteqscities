rozenknop_0.png?itok=m6shhWU0"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-09/thumbrozenknop_0.png?itok=dKzXZHI1 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-09/thumbrozenknop_0.png?itok=jxufPGAe 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-09/thumbrozenknop_0.png?itok=IP9x7NTs 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-09/thumbrozenknop_0.png?itok=H54i9pHJ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-09/thumbrozenknop_0.png?itok=ZI50bKVq 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-09/thumbrozenknop_0.png?itok=m6shhWU0 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F8DFC0","background_color":"#590202","text_color":"#FFFFFF"},"tags":[],"related_events":[]},{"type":"longread","nid":994,"slug":"/artikelen/cafe-wilhelmina-staat-de-tijd-stil-maar-tikt-de-klok-door","endpoint":"/nl/artikelen/cafe-wilhelmina-staat-de-tijd-stil-maar-tikt-de-klok-door","translations":{"nl":"/artikelen/cafe-wilhelmina-staat-de-tijd-stil-maar-tikt-de-klok-door","en":null},"title":"‘In Café Wilhelmina staat de tijd stil, maar tikt de klok door’","content":"\u003cp\u003eKoos Cornelissen (71) noemt zichzelf een ‘brave’ gitarist, maar is tegelijkertijd rijk aan wilde verhalen over spelen voor een zaal met boze Hells Angels en als openingsact spelen voor The Clash en Iggy Pop als gitarist van de Eindhovense punkband Flyin’ Spiderz. Dankzij Koos vonden grote namen uit de jazz- en blueswereld hun weg naar het podium in Café Wilhelmina. “Maar ik kwam als mopperende klant binnen, hoor.”\u003c/p\u003e\r\n","meta":{"title":"‘In Café Wilhelmina staat de tijd stil, maar tikt de klok door’","description":"Lees hier het hele interview met Koos Cornelissen van Café Wilhelmina.","image":null},"publish_date":{"timestamp":1714552632,"machine":"2024-05-01T08:37:12+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Wilhelmina","src":"https://d12y285rxlbnxt.cloudfront.net/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=Dif7_wkC","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=jrjPhXWY","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=uAiLUOiJ","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=i7Lr3Pjq","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=H5zFi5bN","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=uAwvMn0f"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=Dif7_wkC 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=jrjPhXWY 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=uAiLUOiJ 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=i7Lr3Pjq 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=H5zFi5bN 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=uAwvMn0f 720w"]},"source":"Foto: Max Kneefel | Koos Cornelissen aan de bar van Café Wilhelmina","source_link":null},"breadcrumb":null,"subtitle":"Door Zoran Bogdanovic","thumbnail_image":{"image":{"alt":"Wilhelmina","src":"https://d12y285rxlbnxt.cloudfront.net/2024-05/Thumbwilhelmina.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/Thumbwilhelmina.png?itok=vWZ1uDGB","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/Thumbwilhelmina.png?itok=2OA0y1yG","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/Thumbwilhelmina.png?itok=gE0A71sv","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/Thumbwilhelmina.png?itok=8qlKDs69","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/Thumbwilhelmina.png?itok=gaDwDrKm","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/Thumbwilhelmina.png?itok=7RMHJyyu"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/Thumbwilhelmina.png?itok=vWZ1uDGB 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/Thumbwilhelmina.png?itok=2OA0y1yG 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/Thumbwilhelmina.png?itok=gE0A71sv 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/Thumbwilhelmina.png?itok=8qlKDs69 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/Thumbwilhelmina.png?itok=gaDwDrKm 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/Thumbwilhelmina.png?itok=7RMHJyyu 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F2E6D8","background_color":"#8C4A2A","text_color":"#FFFFFF"},"tags":[],"related_events":[]},{"type":"longread","nid":264,"slug":"/artikelen/het-stroomhuis-niet-alles-hoeft-zo-gelikt-te-zijn","endpoint":"/nl/artikelen/het-stroomhuis-niet-alles-hoeft-zo-gelikt-te-zijn","translations":{"nl":"/artikelen/het-stroomhuis-niet-alles-hoeft-zo-gelikt-te-zijn","en":null},"title":"Het Stroomhuis: \"Niet alles hoeft zo gelikt te zijn\"","content":"\u003cp\u003eWe hadden \u003ca href=\"https://www.effenaar.nl/artikelen/van-punkhol-naar-professionele-popzaal-50-jaar-effenaar\"\u003ehet er al even over;\u003c/a\u003e van de jaren ’70 en ’80 krakers mentaliteit is er anno nu nog maar weinig over hier in Eindhoven. Krakkemikkige panden worden massaal verruild voor nieuwbouwcomplexen, die als paddestoelen uit de grond groeien en de naam designstad eer aan doen. Indrukwekkend en broodnodig, maar het is ook allemaal zo perfect. Toch is er één plek waar het net even wat anders gaat. Waar er niet zo binnen de lijntjes wordt gekleurd. Ik sprak documentairemaker Abeltje Vrijdag en hét Stroomhuis-duo Koen en Martijn over het Stroomhuis. \u003c/p\u003e\r\n","meta":{"title":"Stroomhuis Eindhoven","description":"Er is een plek in Eindhoven waar het net even wat anders gaat. Waar er niet zo binnen de lijntjes wordt gekleurd. Effenaar sprak documentairemaker Abeltje Vrijdag en hét Stroomhuis-duo Koen en Martijn over het Stroomhuis. ","image":null},"publish_date":{"timestamp":1666952789,"machine":"2022-10-28T10:26:29+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Stroomhuis header","src":"https://d12y285rxlbnxt.cloudfront.net/2022-10/stroomhuis%20header.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/stroomhuis%20header.jpg?itok=kBYiysXe","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/stroomhuis%20header.jpg?itok=OxRm24J5","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/stroomhuis%20header.jpg?itok=8Wq8kKx7","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/stroomhuis%20header.jpg?itok=JsawvF7E","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/stroomhuis%20header.jpg?itok=JsDIz8NY","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/stroomhuis%20header.jpg?itok=XEJ5kYDD"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/stroomhuis%20header.jpg?itok=kBYiysXe 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/stroomhuis%20header.jpg?itok=OxRm24J5 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/stroomhuis%20header.jpg?itok=8Wq8kKx7 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/stroomhuis%20header.jpg?itok=JsawvF7E 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/stroomhuis%20header.jpg?itok=JsDIz8NY 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/stroomhuis%20header.jpg?itok=XEJ5kYDD 720w"]},"source":"Fotograaf: Davy de Lepper","source_link":null},"breadcrumb":null,"subtitle":"Door Renia Heeringa","thumbnail_image":{"image":{"alt":"Stroomhuis square","src":"https://d12y285rxlbnxt.cloudfront.net/2022-10/square.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/square.jpg?itok=IrX81oBs","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/square.jpg?itok=8AMVyF0s","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/square.jpg?itok=4lW_tUoY","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/square.jpg?itok=Z5m7HOVg","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/square.jpg?itok=y8VDcJbx","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/square.jpg?itok=LMjKHOcP"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/square.jpg?itok=IrX81oBs 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/square.jpg?itok=8AMVyF0s 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/square.jpg?itok=4lW_tUoY 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/square.jpg?itok=Z5m7HOVg 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/square.jpg?itok=y8VDcJbx 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/square.jpg?itok=LMjKHOcP 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F24405","background_color":"#BBC7C7","text_color":"#000000"},"tags":[],"related_events":[]}]}}],"subtitle":"Door Zoran Bogdanovic","thumbnail_image":{"image":{"alt":"the jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/thumbthejack.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/thumbthejack.png?itok=6p0CPPx6","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/thumbthejack.png?itok=vfUL_cTz","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/thumbthejack.png?itok=EHeF1dZs","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/thumbthejack.png?itok=5njKO525","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/thumbthejack.png?itok=0jEuNq9V","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/thumbthejack.png?itok=8uYm41KF"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/thumbthejack.png?itok=6p0CPPx6 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/thumbthejack.png?itok=vfUL_cTz 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/thumbthejack.png?itok=EHeF1dZs 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/thumbthejack.png?itok=5njKO525 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/thumbthejack.png?itok=0jEuNq9V 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/thumbthejack.png?itok=8uYm41KF 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F2522E","background_color":"#400D01","text_color":"#FFFFFF"},"tags":[],"related_events":[]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724666389,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"LongReads-cafe-jack-je-hebt-rock-je-hebt-metal-en-je-hebt-niek-nl","queryHash":"[\"LongReads-cafe-jack-je-hebt-rock-je-hebt-metal-en-je-hebt-niek-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"longread","nid":1377,"slug":"/artikelen/de-meester-van-melancholie-syml-over-verdriet-lana-del-rey-en-zijn-virale-hit","endpoint":"/nl/artikelen/de-meester-van-melancholie-syml-over-verdriet-lana-del-rey-en-zijn-virale-hit","translations":{"nl":"/artikelen/de-meester-van-melancholie-syml-over-verdriet-lana-del-rey-en-zijn-virale-hit","en":null},"title":"De meester van melancholie: SYML over verdriet, Lana Del Rey en zijn virale hit","content":"\u003cp\u003eWapen je met een pak tissues, een warme kop thee en kussen om te knuffelen, want de Amerikaanse singer-songwriter SYML komt met een nieuw album. En verdriet klonk nog nooit zó fijn. Als voorproefje voor zijn stijf uitverkochte \u003cem\u003estripped down\u003c/em\u003e show in Effenaar op dinsdag 25 maart, neemt de Where Is My Love-zanger je mee door zijn nieuwe plaat ‘Nobody Lives Here’, verlies en loslaten, en zijn samenwerking met Lana Del Rey.\u003c/p\u003e\r\n","meta":{"title":"De meester van melancholie: SYML over verdriet, Lana Del Rey en zijn virale hit","description":"Lees het interview met SYML op het platform SPACES van Effenaar.","image":{"image":{"alt":"SYML","src":"https://d12y285rxlbnxt.cloudfront.net/2025-03/SYML_1.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/SYML_1.jpg?itok=tmkofrsB","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/SYML_1.jpg?itok=6aOyNHy_","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/SYML_1.jpg?itok=XITSMRz3","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/SYML_1.jpg?itok=rgZNM6zc","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/SYML_1.jpg?itok=MEueyeKJ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/SYML_1.jpg?itok=hXLj3pw8"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/SYML_1.jpg?itok=tmkofrsB 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/SYML_1.jpg?itok=6aOyNHy_ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/SYML_1.jpg?itok=XITSMRz3 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/SYML_1.jpg?itok=rgZNM6zc 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/SYML_1.jpg?itok=MEueyeKJ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/SYML_1.jpg?itok=hXLj3pw8 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1741856752,"machine":"2025-03-13T09:05:52+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"SYML","src":"https://d12y285rxlbnxt.cloudfront.net/2025-03/SYML_1.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/SYML_1.png?itok=eUEc9Ynz","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/SYML_1.png?itok=ZV67zAJc","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/SYML_1.png?itok=n18w6eoM","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/SYML_1.png?itok=aLQ5RaET","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/SYML_1.png?itok=31ULq1gn","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/SYML_1.png?itok=HSPJQi5Z"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/SYML_1.png?itok=eUEc9Ynz 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/SYML_1.png?itok=ZV67zAJc 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/SYML_1.png?itok=n18w6eoM 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/SYML_1.png?itok=aLQ5RaET 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/SYML_1.png?itok=31ULq1gn 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/SYML_1.png?itok=HSPJQi5Z 720w"]},"source":"Foto: Perskit SYML","source_link":null},"breadcrumb":null,"blocks":[{"type":"paragraph","id":"df48ef9b-774d-4d02-90e2-ad4c496421f8","header":{"title":null},"content":{"content":"\u003cp\u003eTerwijl in Nederland de zon al onder is, heeft Brian Fennell –beter bekend als SYML- aan de andere kant van de lijn zijn ontbijt net achter zijn kiezen. Hij maakt het zich gemakkelijk in zijn studio, waar het daglicht maar mondjesmaat binnendringt. In Seattle -waar de zanger woont- is het een groot gedeelte van het jaar grijs, nat en donker. \"Wellicht komt dat terug in mijn muziek\", grapt de singer-songwriter die bekend staat om zijn melancholische nummers.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"7605edba-331a-4446-abb2-d248d2f8ab68","header":{"title":null},"content":{"content":"\u003cp\u003eDe stad is al sinds zijn kindertijd het decor voor zijn muzikale vorming. En dat betekent ook opgroeien tussen het geluid van grunge-formaties als Nirvana en Soundgarden. \"Als jongetje wilde ik rock maken, maar ik wilde ook dat het mooi en melodisch was. Smashing Pumpkins en al die andere bands hadden waanzinnige melodieën, maar vrij harde teksten.\" Wanneer hij wat ouder is komt hij in aanraking met het werk van Jeff Buckley, die laat zien dat singer-songwriters ook uit een donkerdere hoek kunnen komen.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"06f2d27a-bba8-4e74-9377-811ae265c502","header":{"title":null},"content":{"content":"\u003cp\u003eMet het pianospel in de vingers en melancholiek die door hem heen sijpelt, ziet in 2016 zijn act SYML het levenslicht met de release van de EP 'Hurt For Me'. Hoewel de ballade 'Where's My Love' al te vinden is op de EP, raakt de zanger pas in een stroomversnelling wanneer hij in 2017 een nieuwe versie van het nummer uitbrengt. Met deze track, in al zijn versies, heeft hij tot en met vandaag een luttele 1,1 miljard streams behaald.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"c29aa353-16b5-434a-aafb-2788b8b3fd6c","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/lPA_npG1WUc?si=PzDi8e_Ld_7SEOww\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"f1c6eed7-a727-434d-b8ad-0b9e63397be0","header":{"title":"Samenwerking met Lana Del Rey"},"content":{"content":"\u003cp\u003eInmiddels telt het oeuvre van SYML twee studioalbums én een samenwerking met niemand minder dan Lana Del Rey. Op haar album 'Did You Know That There's a Tunnel Under Ocean Blvd' uit 2023 \u003cem\u003eshined \u003c/em\u003ede\u003cem\u003e \u003c/em\u003einstrumentale SYML-track 'I Wanted To Leave' als fundament van haar nummer 'Paris, Texas'.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"9dd77b8e-f32e-45a1-8205-67b1b79d0506","header":{"title":null},"content":{"content":"\u003cp\u003e\"Ze had mijn nummer gehoord op TikTok of Instagram en \u003cem\u003etracked me down. \u003c/em\u003eZij heeft er lyrics bij geschreven. Sinds dag één is ze het meest lieve persoon, zeker op het gebied van het respectvol behandelen van mijn muziek en het ook écht zien als mijn muziek. Ze is \u003cem\u003eamazing\u003c/em\u003e. Het artiestschap wat ze meebrengt is echt speciaal. Om daar een klein deel van uit te mogen maken is heel mooi.\"\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"9eac98c0-93d7-4815-a396-a90ed9aec4b2","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/track/0Oqxt6JixieLHbwMfnJGWO?utm_source=generator\" width=\"100%\" height=\"152\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"deb9ce19-4e35-464c-87c9-464c1ec3f7bb","header":{"title":"Moeilijke gevoelens ontdekken"},"content":{"content":"\u003cp\u003eOp vrijdag 4 april voegt de singer-songwriter het derde studioalbum ‘Nobody Lives Here’ toe aan zijn collectie. Het is de opvolger van het intieme 'The Day My Father Died', een plaat over het verlies van zijn vader na een strijd tegen kanker. \"Dat album was heel belangrijk voor mij om te verwerken wat er was gebeurd.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"babb3a3b-004e-4500-817f-302a9279458f","header":{"title":null},"content":{"content":"\u003cp\u003eFennel kan in zijn muziek een deel van zichzelf kwijt, waar hij anders niet zo goed van weet wat hij ermee aan moet. \"Zoals iedereen heb ik momenten van verdriet en rouw, of van het proberen te begrijpen hoe de wereld werkt. Ik heb de neiging om me niet heel erg open te stellen, zelfs niet bij mijn familie en goede vrienden. Muziek is voor mij een goede manier om moeilijke gevoelens te ontdekken. Soms is het therapie, en soms is het leuk.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"d8554986-6c3b-4d05-854e-e5f891a69659","header":{"title":null},"content":{"content":"\u003cp\u003eMet de nieuwe plaat 'Nobody Lives Here' onderzoekt hij de gevoelens van moraliteit en de vergankelijkheid van het leven. \"Ik voel mezelf ouder worden, ik zie het aan mijn kinderen en vrienden. Je knippert met je ogen en je bent zo vier jaar verder. Het leven is kort en we zijn hier allemaal slechts tijdelijk. Iets kan prachtig zijn, maar soms gaat het voorbij en moet je weer door. Dat kan je op veel verschillende dingen toepassen in het leven: relaties, banen of geluk.” \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"9ce38c5b-5d28-40e0-b12c-baab891b3430","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"SYML","src":"https://d12y285rxlbnxt.cloudfront.net/2025-03/SYML2.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/SYML2.png?itok=ItZ3Z_Sb","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/SYML2.png?itok=BU2cz3xf","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/SYML2.png?itok=zxSJgUGc","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/SYML2.png?itok=wA1RMdFA","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/SYML2.png?itok=_PG1Krrv","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/SYML2.png?itok=pTOUKaGd"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/SYML2.png?itok=ItZ3Z_Sb 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/SYML2.png?itok=BU2cz3xf 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/SYML2.png?itok=zxSJgUGc 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/SYML2.png?itok=wA1RMdFA 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/SYML2.png?itok=_PG1Krrv 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/SYML2.png?itok=pTOUKaGd 720w"]},"source":"Foto: Perskit SYML","source_link":null},"is_fullscreen":true}},{"type":"paragraph","id":"ec95ae4b-4120-4f7f-8aeb-8a5c906abf4d","header":{"title":"Zoals het was, zal het nooit meer zijn"},"content":{"content":"\u003cp\u003eDat melancholische, doch wonderlijke gevoel van momenten die vervliegen tot herinneringen heeft de singer-songwriter onder andere verpakt in de single 'How It Was It Will Never Be Again'. \"Als je ouder wordt kan je niet meer hetzelfde als toen je jonger was. Kinderen krijgen is ook een heel goed voorbeeld van \u003cem\u003ehow it was it will never be again. \u003c/em\u003eEn je kunt jezelf ook weer beter zien door hen. Je voelt je humaniteit en moraliteit op een heel speciale wijze.\"\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"69125f15-8026-4a85-96ba-36892aeda7bf","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/track/3woSAwAhXte942SmXGdH9Q?utm_source=generator\" width=\"100%\" height=\"152\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"24f3333b-56b4-4b97-be8b-175858bd31d5","header":{"title":null},"content":{"content":"\u003cp\u003eNiet alleen omstandigheden zijn veranderlijk, ook personen, waardoor je soms ook afscheid moet nemen van versies van mensen die je liefhebt. Daarover zingt Fennel in zijn persoonlijke favoriet 'Heavy Hearts', waar we nog even op moeten wachten. \"Toen ik ging trouwen was ik bang dat ik geen verdrietige nummers meer over liefde zou kunnen schrijven, maar samen ga je door seizoenen. Je ziet de ander zich herontdekken, en om dat te kunnen doen moet je ook kunnen loslaten hoe dingen waren en realiseren dat ze voorbij zijn. Het is een bemoedigend lied, maar ik weet dat mensen het gaan luisteren en denken 'dit is zo triest'.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"fea6829f-97be-4e5d-b00a-d5b5a051603b","header":{"title":null},"content":{"content":"\u003cp\u003eOok de nog uit te brengen titeltrack gaat over loslaten, ditmaal van de liefde zelf. Volgens Fennel waarschijnlijk het meest droevige lied van het album. \"Het is niet overdreven verdrietig, maar ik zou liegen als ik zou zeggen dat er geen verdriet achter zit.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"f93dac6a-680d-4ae4-bbc5-5eb47e0c9487","header":{"title":null},"content":{"content":"\u003cp\u003eEen nummer dat hij wel al heeft gedeeld met de wereld is de single 'Careful', een track over zijn eigen carrière. In dit nummer zingt hij \"\u003cem\u003eI can't escape it, honestly, I hate this place\u003c/em\u003e\", waarmee de zanger refereert naar zijn eigen brein en neiging om zichzelf te vergelijken en zaken te overdenken.\u003c/p\u003e\r\n\r\n\u003cp\u003e\"Dat leidt alleen maar tot verdriet en teleurstelling. Ik breng niet meer veel tijd door in die ruimte, \u003cem\u003ebut I have\u003c/em\u003e. Met dit nummer schud ik mezelf wakker en realiseer ik dat mijn leven supermooi is. Dat ik muziek kan maken, en ook nog als baan, is echt een gift. Bewust aanwezig zijn in het moment is wel het onderwerp dat als rode draad door alle nummers loopt.\"\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"fa823060-a5a4-49da-a367-fd7fc30f9dc2","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/zKdLBOWcG8c?si=SGy2XVU6lbDxwvBf\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"7a293b3c-2e99-493f-9ba1-e502d141c2a0","header":{"title":"Sommige dingen blijven onveranderd"},"content":{"content":"\u003cp\u003eTegenover de momenten en relaties die vervliegen waarover Fennel zingt, staat zijn vriendschap met Brain Eichelberger die al sinds de middelbare school de tand des tijds doorstaat. Niet alleen zijn ze beste vrienden, Eichelberger is ook de producer van SYML's nieuwste wapenfeit.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"38975def-da80-4492-b39a-11a47fbfc31a","header":{"title":null},"content":{"content":"\u003cp\u003e\"Hij is mijn belangrijkste samenwerkingspartner. Hij en ik hebben het hele werk samen gemaakt. Dat is ook hoe we ooit zijn begonnen. Toen we op de middelbare school zaten werkte hij in een muziekstudio en mocht ik in de hoek zitten en hem helpen. Dat is hoe ik ben begonnen met het schrijven en opnemen van songs. Om dat nu als volwassenen weer te doen, was heel erg bijzonder.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"f40b936e-f673-490f-b36f-325b4dc83b98","header":{"title":null},"content":{"content":"\u003cp\u003eDoordat de Amerikaanse singer-songwriter tegenwoordig \u003cem\u003eindependent\u003c/em\u003e door het leven gaat, heeft er geen druk achter het opleveren of de sound van het album gezeten. \"Het voelde alsof er geen verwachtingen waren. Ik denk dat dat voor artiesten altijd goed is. Het voelde erg organisch en moeiteloos.\"\u003c/p\u003e\r\n\r\n\u003cp\u003eAl betekent dat niet dat ieder nummer er zonder \u003cem\u003estruggles\u003c/em\u003e is uitgerold. Het is 'Something Beautiful and Bright' waar de zanger bij de maak van dit album op blijft steken. \"Ik had het refrein en een soort pre-chorus, maar ik wist niet waar het heen moest gaan. Soms moet je de ruimte dan vullen met onzin om alles op zijn plek te krijgen, maar wanneer een nummer speciaal aanvoelt wil je het bijna niet ten schande maken door er onzin in te stoppen. Dan moet ik er afstand van nemen totdat iets zich openbaart. Ik denk dat het één van de magische onderdelen van schrijven is, dat je er geen controle over hebt. Het zijn dingen die om je heen zweven. De enige manier is om open te blijven, \u003cem\u003eso it can hit you in the face\u003c/em\u003e.\"\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"3832d05d-170a-407c-8676-60edeebdd64b","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"SYML","src":"https://d12y285rxlbnxt.cloudfront.net/2025-03/a3661671587_65.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/a3661671587_65.png?itok=BQ0OlHNc","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/a3661671587_65.png?itok=WWnPFAqX","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/a3661671587_65.png?itok=51E6m2MV","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/a3661671587_65.png?itok=FR4H0q4Q","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/a3661671587_65.png?itok=o9Ezguvz","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/a3661671587_65.png?itok=R2NBZ2pP"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/a3661671587_65.png?itok=BQ0OlHNc 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/a3661671587_65.png?itok=WWnPFAqX 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/a3661671587_65.png?itok=51E6m2MV 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/a3661671587_65.png?itok=FR4H0q4Q 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/a3661671587_65.png?itok=o9Ezguvz 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/a3661671587_65.png?itok=R2NBZ2pP 720w"]},"source":"Afbeelding: albumhoes 'Nobody Lives Here' van SYML","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"72ce24f5-94ae-4ffe-aaf8-5b55e3dec45f","header":{"title":"Een live listening party voor fans"},"content":{"content":"\u003cp\u003eEr zit een strik om 'Nobody Lives Here', en het album ligt klaar voor de release begin april. Maar op dinsdag 25 maart komt SYML al naar de Grote Zaal van Effenaar om zijn nieuwe nummers voor het eerst live te delen met fans. Maar dan wel in een speciale intieme setting. \"Ik wilde niet dat het te groot zou zijn. Ik wil meer kunnen vertellen en delen over het verhaal. Het wordt een hele speciale manier voor fans om de muziek voor het eerst te ervaren. Al zullen we ook oude liedjes spelen.”\u003c/p\u003e\r\n","links":null}},{"type":"related_event","id":"520ef2e9-6879-4e14-a73d-203721b26667","header":{"title":"Op dinsdag 25 maart speelt SYML in een uitverkochte Grote Zaal. Geen ticket kunnen scoren of nog een keer lekker wegdromen? Misschien zijn deze shows wat voor jou:","description":null},"content":{"items":[{"type":"event","nid":1245,"slug":"/agenda/vanwyck","endpoint":"/nl/agenda/vanwyck","translations":{"nl":"/agenda/vanwyck","en":null},"title":"VanWyck","content":"\u003cp\u003eDe Amsterdamse singer-songwriter VanWyck maakt bedwelmende alt-folk songs. Van breekbaar en intiem tot donker rockend en krachtig. In korte tijd bouwde ze een eigenzinnig oeuvre op waarmee ze tot ver over de landsgrenzen bewondering oogst. Met haar warme stem verweeft ze verhalen in haar nummers. Verhalen over de problemen van vrouwen, fluisterende vuilnismannen of boze godinnen.\u003c/p\u003e\r\n","meta":{"title":"VanWyck | Café Wilhelmina","description":"De Amsterdamse singer-songwriter VanWyck maakt bedwelmende alt-folk songs. Van breekbaar en intiem tot donker rockend en krachtig. In korte tijd bouwde ze een eigenzinnig oeuvre op waarmee ze tot ver over de landsgrenzen bewondering oogst. Met haar warme stem verweeft ze verhalen in haar nummers. Verhalen over de problemen van vrouwen, fluisterende vuilnismannen of boze godinnen.","image":null},"publish_date":{"timestamp":1732104633,"machine":"2024-11-20T12:10:33+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"VanWyck header","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=Pea1d4YM","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=sCzNs8-4","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=g6VXw22d","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=bIz2CUTa","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=-z2w-4S8","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=Tr7KUVA4"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=Pea1d4YM 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=sCzNs8-4 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=g6VXw22d 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=bIz2CUTa 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=-z2w-4S8 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/VanWyck%20%E2%80%93%201920x1080%20Website.jpg?itok=Tr7KUVA4 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#000000","background_color":"#aaacae","text_color":"#000000"},"thumbnail_image":{"image":{"alt":"VanWyck","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/VanWyck%20%E2%80%93%20Square%20Instagram%20afbeelding%20only.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/VanWyck%20%E2%80%93%20Square%20Instagram%20afbeelding%20only.jpg?itok=lHldV3XP","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/VanWyck%20%E2%80%93%20Square%20Instagram%20afbeelding%20only.jpg?itok=Q6EbQtGO","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/VanWyck%20%E2%80%93%20Square%20Instagram%20afbeelding%20only.jpg?itok=gAGs-sPD","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/VanWyck%20%E2%80%93%20Square%20Instagram%20afbeelding%20only.jpg?itok=8moI00hA","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/VanWyck%20%E2%80%93%20Square%20Instagram%20afbeelding%20only.jpg?itok=RO9IrDOA","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/VanWyck%20%E2%80%93%20Square%20Instagram%20afbeelding%20only.jpg?itok=lB4Stng0"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/VanWyck%20%E2%80%93%20Square%20Instagram%20afbeelding%20only.jpg?itok=lHldV3XP 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/VanWyck%20%E2%80%93%20Square%20Instagram%20afbeelding%20only.jpg?itok=Q6EbQtGO 1920w","https://d12y285rxlbnxt.cloud