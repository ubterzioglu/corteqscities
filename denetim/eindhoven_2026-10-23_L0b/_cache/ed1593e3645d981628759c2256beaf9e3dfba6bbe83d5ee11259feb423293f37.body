d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=YGlywYmi 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=uzQDBLq3 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=1FvUPuAR 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#585956","background_color":"#F2F2F2","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":1284,"slug":"/artikelen/effenaar-tipt-jouw-cheat-sheet-voor-het-nieuwe-jaar","endpoint":"/nl/artikelen/effenaar-tipt-jouw-cheat-sheet-voor-het-nieuwe-jaar","translations":{"nl":"/artikelen/effenaar-tipt-jouw-cheat-sheet-voor-het-nieuwe-jaar","en":null},"title":"Effenaar tipt: Jouw cheat sheet voor het nieuwe jaar","content":"\u003cp\u003e2025 is van start! En je weet wat ze zeggen; een goed begin is het halve werk. Gelukkig is er de komende tijd weer een hoop moois te zien in Eindhoven. Wil je je eens laten verrassen of zie je door het bomvolle programma het bos niet meer? De muziekfanaten van Effenaar helpen je op weg met een vliegende start. Check hier welke acts je niet wil missen!  \u003c/p\u003e\r\n","meta":{"title":"Effenaar tipt: Jouw cheat sheet voor het nieuwe jaar","description":"Deze acts wil je niet missen!","image":null},"publish_date":{"timestamp":1735560840,"machine":"2024-12-30T12:14:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Lambrini Girls","src":"https://d12y285rxlbnxt.cloudfront.net/2025-01/LG%20%E2%80%93%201920x1080%20Website.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-01/LG%20%E2%80%93%201920x1080%20Website.jpg?itok=V4Wy-sdT","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-01/LG%20%E2%80%93%201920x1080%20Website.jpg?itok=JvqQks