ource_link":null},"header_text_size":"small","subtitle":"Eindhoven Guitar Festival","upper_title":null,"tickets":[],"tags":[{"id":159,"title":"Gitaarfestival"}],"date":{"timestamp":1683849600,"machine":"2023-05-12"},"presale":{"timestamp":1669334400,"machine":"2022-11-25"},"times":{"starts_at":"12:00","ends_at":null,"opens_at":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false},{"id":118,"title":"Café Wilhelmina","is_external":false},{"id":141,"title":"Altstadt","is_external":false},{"id":129,"title":"'t Rozenknopje","is_external":false},{"id":158,"title":"The Jack","is_external":false},{"id":140,"title":"Muziekgebouw","is_external":false}],"facebook_event":{"uri":"https://www.facebook.com/events/921305865755757/","title":"","options":{"url":"https://www.facebook.com/events/921305865755757/"}},"genres":[{"id":121,"title":"Pop / Rock"},{"id":54,"title":"heavy"},{"id":117,"title":"Singer – songwriter / Americana"},{"id":122,"title":"Funk / Soul / Jazz / Reggae"}],"club_card_event":false,"ticket_url":{"uri":"http://www.bridgefestival.com/","title":"","options":{"url":"http://www.bridgefestival.com/"}},"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[]},{"type":"event","nid":286,"slug":"/agenda/bridge-free-city-festival-za-13-mei","endpoint":"/nl/agenda/bridge-free-city-festival-za-13-mei","translations":{"nl":"/agenda/bridge-free-city-festival-za-13-mei","en":null},"title":"BRIDGE FREE CITY FESTIVAL - za 13 mei","content":"\u003cp\u003eEindhoven is een festival rijker: vanaf 10 mei 2023 staat de gitaar 5 dagen lang centraal tijdens het nieuwe \u003ca href=\"https://bridgefestival.com/\"\u003eBRIDGE\u003c/a\u003e! Het meerdaagse, allround gitaarfestival is uniek in zijn soort: van klassiek tot blues, van jazz tot rock, van flamenco tot pop, alles komt aan bod. Livemuziek speelt tijdens BRIDGE een grote rol, vele gitaristen zullen in verschillende formats afreizen naar het festival. Daarnaast worden volop andere programma’s aangeboden zoals workshops, masterclasses, een omvangrijke beurs, huiskamerconcerten en meerdere on- en offline activiteiten. En dat alles onder de noemer van een aantal pijlers: innovatie, educatie, participatie, inclusie en natuurlijk de grote gezamenlijke liefhebberij van de gitaar. Hiermee wordt er voldaan aan de behoefte binnen de gehele Brainport regio: verbinding, mét elkaar, vóór elkaar. Met andere woorden: we slaan van 10 tot en met 14 mei 2023 sámen een brug, BRIDGE is geboren! \u003c/p\u003e\r\n","meta":{"title":"BRIDGE","description":"Eindhoven is een festival rijker: vanaf 10 mei 2023 staat de gitaar 5 dagen lang centraal tijdens het nieuwe BRIDGE! Het meerdaagse, allround gitaarfestival is uniek in zijn soort: van klassiek tot blues, van jazz tot rock, van flamenco tot pop, alles komt aan bod. Livemuziek speelt tijdens BRIDGE een grote rol, vele gitaristen zullen in verschillende formats afreizen naar het festival. Daarnaast worden volop andere programma’s aangeboden zoals workshops, masterclasses, een omvangrijke beurs, huiskamerconcerten en meerdere on- en offline activiteiten. En dat alles onder de noemer van een aantal pijlers: innovatie, educatie, participatie, inclusie en natuurlijk de grote gezamenlijke liefhebberij van de gitaar. Hiermee wordt er voldaan aan de behoefte binnen de gehele Brainport regio: verbinding, mét elkaar, vóór elkaar. Met andere woorden: we slaan van 10 tot en met 14 mei 2023 sámen een brug, BRIDGE is geboren! ","image":null},"publish_date":{"timestamp":1669028400,"machine":"2022-11-21T11:00:00+00:00"},"published":false,"sticky":false,"header_image":{"image":{"alt":"Bridge Gitaarfestival Eindhoven","src":"https://d12y285rxlbnxt.cloudfront.net/2023-01/Header%20BRIDGE%202.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-01/Header%20BRIDGE%202.jpg?itok=lHiuCEx0","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-01/Header%20BRIDGE%202.jpg?itok=