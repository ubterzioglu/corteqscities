es/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=WSBGu7Vz 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=IXLO9ado 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=waQNUMpd 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#000000","background_color":"#fc7356","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"7d531f90-21df-4cd0-bdc5-f52070361771","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:30 Deuren open\u003cbr\u003e20:00-20:30 Fellatio\u003cbr\u003e21:00-22:00 Iguana Death Cult\u003cbr\u003e(tijden zijn onder voorbehoud)\u003c/p\u003e","links":null}},{"type":"paragraph","id":"48f57ebd-6278-49dd-bd18-6aa2c88965d2","header":{"title":"Guns Out"},"content":{"content":"\u003cp\u003eOp het nieuwe album Guns Out duiken ze in eerlijke zelfreflectie, waarin thema's als escapisme, mentale spanning en creatieve vernieuwing verwerkt zijn. Met een sound die zowel stoer als introspectief is, zoekt Iguana Death Cult de balans op tussen hun eigen evolutie en de turbulente wereld eromheen.\u0026nbsp;\u003c/p\u003e","links":null}},{"type":"embed","id":"aa69cc09-423e-45b8-a61a-f4884d936e46","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/UNVseJp0vE8?si=lgQZIPQ6vAo13eAN\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"embed","id":"1d8393e6-1c13-4600-924d-0b143775cb78","header":{"title":null,"description":null},"content