"upper_title":null,"tickets":[],"tags":[],"date":{"timestamp":1790812800,"machine":"2026-10-01"},"presale":null,"times":{"starts_at":"20:30","ends_at":null,"opens_at":"20:00"},"locations":[],"facebook_event":{"uri":"https://www.facebook.com/events/2429787324203815","title":"","options":{"url":"https://www.facebook.com/events/2429787324203815"}},"genres":[],"club_card_event":true,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[]},{"type":"event","nid":1981,"slug":"/agenda/an-evening-with-knives-3okt","endpoint":"/nl/agenda/an-evening-with-knives-3okt","translations":{"nl":"/agenda/an-evening-with-knives-3okt","en":null},"title":"An Evening With Knives","content":"\u003cp\u003e An Evening With Knives staat bekend om een zwaar en gevarieerd geluid, een krachtige mix van psychedelische elementen, heavy riffs en teksten. Dit Eindhovense psychedelische post-metaltrio brengt na het recente album 'End of Time' een nieuwe EP uit. Op 'The Rabbit \u0026 The Mistake' staan twee tracks die de band niet langer voor zich kon houden. Zwaar en actueel, zonder de krachtige sound te verliezen.\u003c/p\u003e","meta":{"title":"An Evening With Knives | Café The Jack","description":"Op zaterdag 3 oktober staat de Eindhovense post-metalband An Evening With Knives met een nieuw EP in Café The Jack! Met 'The Mistake \u0026 The Rabbit' brengt de band twee nieuwe nummers tot leven die zwaar, actueel en psychedelisch zijn. ","image":null},"publish_date":{"timestamp":1786447849,"machine":"2026-08-11T11:30:49+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"An Evening With Knives","src":"https://d12y285rxlbnxt.cloudfront.net/2026-08/%20%E2%80%93%201920x1080%20WebsiteAEWK.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-08/%20%E2%80%93%201920x1080%20WebsiteAEWK.png?itok=TTqHrjmp","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-08/%20%E2%80%93%20