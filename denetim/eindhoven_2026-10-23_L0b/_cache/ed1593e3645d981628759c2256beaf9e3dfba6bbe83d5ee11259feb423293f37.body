"uri":"https://www.facebook.com/events/2288535385219528?acontext=%7B%22event_action_history%22%3A[%7B%22surface%22%3A%22home%22%7D%2C%7B%22mechanism%22%3A%22search_results%22%2C%22surface%22%3A%22search%22%7D]%2C%22ref_notif_type%22%3Anull%7D","title":"","options":{"url":"https://www.facebook.com/events/2288535385219528?acontext=%7B%22event_action_history%22%3A[%7B%22surface%22%3A%22home%22%7D%2C%7B%22mechanism%22%3A%22search_results%22%2C%22surface%22%3A%22search%22%7D]%2C%22ref_notif_type%22%3Anull%7D"}},"genres":[],"club_card_event":true,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":true,"related_events":[]}],"related_news":[{"type":"news","nid":1994,"slug":"/nieuws/recordeditie-hit-city-48500-bezoeken-en-een-stad-vol-ontdekkingen","endpoint":"/nl/nieuws/recordeditie-hit-city-48500-bezoeken-en-een-stad-vol-ontdekkingen","translations":{"nl":"/nieuws/recordeditie-hit-city-48500-bezoeken-en-een-stad-vol-ontdekkingen","en":null},"title":"Recordeditie Hit The City: 48.500 bezoeken en een stad vol ontdekkingen","content":"","meta":{"title":"Recordeditie Hit The City: 48.500 bezoeken en een stad vol ontdekkingen","description":"Gratis stadsfestival groeit fors en laat publiek nieuwe muziek én nieuwe plekken in Eindhoven ontdekken.","image":null},"publish_date":{"timestamp":1788337035,"machine":"2026-09-02T08:17:15+00:00"},"published":true,"sticky":true,"header_image":null,"breadcrumb":null,"location":null,"colors":{"accent_color":"#000000","background_color":"#FFFFFF","text_color":"#000000"}},{"type":"news","nid":1971,"slug":"/nieuws/geen-kunst-zonder-vrijheid-geen-vrijheid-zonder-veiligheid","endpoint":"/nl/nieuws/geen-kunst-zonder-vrijheid-geen-vrijheid-zonder-veiligheid","translations":{"nl":"/nieuws/geen-kunst-zonder-vrijheid-geen-vrijheid-zonder-veiligheid","en":null},"title":"Geen kunst zonder vrijheid, geen vrijheid zonder veiligheid","content":"","meta":{"title":"Geen kunst zonder vrijheid, geen vrijheid zonder veiligheid","description":"Kunst en muziek mogen schuren, uitdagen en ongemak oproepen. Ze kunnen gebruikmaken van symboliek, fictie, overdrijving en perspectiefwisseling om vragen te stellen, andere perspectieven te laten zien of maatschappelijke ongelijkheid zichtbaar te maken. Juist daarin ligt hun kracht en betekenis.","image":null},"publish_date":{"timestamp":1785143770,"machine":"2026-07-27T09:16:10+00:00"},"published":true,"sticky":true,"header_image":null,"breadcrumb":null,"location":"Eindhoven","colors":{"accent_color":"#000000","background_color":"#FFFFFF","text_color":"#000000"}},{"type":"news","nid":1937,"slug":"/nieuws/open-call-effenaar-maakt-ruimte-voor-de-makers-van-de-nacht","endpoint":"/nl/nieuws/open-call-effenaar-maakt-ruimte-voor-de-makers-van-de-nacht","translations":{"nl":"/nieuws/open-call-effenaar-maakt-ruimte-voor-de-makers-van-de-nacht","en":null},"title":"OPEN CALL: Effenaar maakt ruimte voor de makers van de nacht","content":"","meta":{"title":"Effenaar maakt ruimte voor de makers van de nacht","description":"Met de komst van een Nachtprogrammeur bij Effenaar, die zelf uit de Eindhovense scene komt, ontstaat er opnieuw ruimte om te investeren in wat hier al leeft. Niet om iets nieuws van bovenaf te bedenken, maar om aan te sluiten bij de energie die er al is. Om makers, organisatoren en communities weer een plek te geven waar ideeën kunnen ontstaan, nachten kunnen groeien en nieuwe verbindingen worden gelegd. Zoals Effenaar voor velen ooit een plek was om te ontdekken, te experimenteren en elkaar te vinden.","image":null},"publish_date":{"timestamp":1781278158,"machine":"2026-06-12T15:29:18+00:00"},"published":true,"sticky":true,"header_image":null,"breadcrumb":null,"location":"Eindhoven","colors":{"accent_color":"#000000","background_color":"#FFFFFF","text_color":"#000000"}},{"type":"news","nid":1959,"slug":"/nieuws/hit-city-maakt-de-line-compleet-met-43-nieuwe-namen-waaronder-mula-en-snapped-ankles","endpoint":"/nl/nieuws/hit-city-maakt-de-line-compleet-met-43-nieuwe-namen-waaronder-mula-en-snapped-ankles","translations":{"nl":"/nieuws/hit-city-maakt-de-line-compleet-met-43-nieuwe-namen-waaronder-mula-en-snapped-ankles","en":null},"title":"Hit The City maakt de line-up compleet met 43 nieuwe namen, waaronder Mula en Snapped Ankles","content":"","meta":{"title":"Hit The City maakt de line-up compleet met 43 nieuwe namen, waaronder Mula en Snapped Ankles","description":"Het programma van het gratis toegankelijke stadsfestival in Eindhoven was al stevig gevuld met namen als Typhoon, Jonna Fraser, S10, DEADLETTER en Lambrini Girls, maar met de bevestiging van de laatste namen is de line-up van in totaal 121 acts compleet. Naast headliner Mula op Ketelhuisplein, voegen Snapped Ankles, Gender Reveal Atomic Bomb, Olkan \u0026 La Vipère Rouge, Julia Sabaté, LEMONSUCKR, Parbleu en Arabella Memdouh zich bij het stadsprogramma.\r\n","image":null},"publish_date":{"timestamp":1782917667,"machine":"2026-07-01T14:54:27+00:00"},"published":true,"sticky":true,"header_image":null,"breadcrumb":null,"location":"Eindhoven","colors":{"accent_color":"#000000","background_color":"#FFFFFF","text_color":"#000000"}},{"type":"news","nid":1786,"slug":"/nieuws/zelfde-liefde-voor-livemuziek-met-een-nieuwe-route-ernaartoe","endpoint":"/nl/nieuws/zelfde-liefde-voor-livemuziek-met-een-nieuwe-route-ernaartoe","translations":{"nl":"/nieuws/zelfde-liefde-voor-livemuziek-met-een-nieuwe-route-ernaartoe","en":null},"title":"Zelfde liefde voor livemuziek, met een nieuwe route ernaartoe","content":"","meta":{"title":"Zelfde liefde voor livemuziek, met een nieuwe route ernaartoe","description":"Vanaf februari 2026 bestel je je tickets voor Effenaar niet meer via Ticketmaster, maar via CM.com. ","image":null},"publish_date":{"timestamp":1770211308,"machine":"2026-02-04T13:21:48+00:00"},"published":true,"sticky":true,"header_image":null,"breadcrumb":null,"location":null,"colors":{"accent_color":"#000000","background_color":"#FFFFFF","text_color":"#000000"}}],"related_stories_title":"Spaces","related_stories_slug":null,"related_stories_content":{"value":"\u003cp\u003e\u003ca href=\"https://www.effenaar.nl/spaces\"\u003eInhoudelijke verhalen over ons programma, innovatie op het gebied van (live) muziekbeleving en onze samenwerkingen.\u003c/a\u003e\u003c/p\u003e","format":"basic_html","processed":{"web":"\u003cp\u003e\u003ca href=\"https://www.effenaar.nl/spaces\"\u003eInhoudelijke verhalen over ons programma, innovatie op het gebied van (live) muziekbeleving en onze samenwerkingen.\u003c/a\u003e\u003c/p\u003e\n","app":"Inhoudelijke verhalen over ons programma, innovatie op het gebied van (live) muziekbeleving en onze samenwerkingen.\n"}},"related_stories":[{"type":"longread","nid":2030,"slug":"/artikelen/drie-artiesten-om-tafel-waarom-zij-hard-gaan-op-nederlandstalig","endpoint":"/nl/artikelen/drie-artiesten-om-tafel-waarom-zij-hard-gaan-op-nederlandstalig","translations":{"nl":"/artikelen/drie-artiesten-om-tafel-waarom-zij-hard-gaan-op-nederlandstalig","en":null},"title":"Drie artiesten om tafel: Waarom zij hard gaan op Nederlandstalig","content":"\u003cp\u003e“Als je goed om je heen kijkt, zie je dat alles gekleurd is”, dichtte K. Schippers ooit. Een zin die mij is bijgebleven, zeker met betrekking tot taal. Want zelfs bij de meest alledaagse teksten, gaat vaak toch een hele wereld schuil tussen de regels. Van 10 tot en met 18 oktober is het de Week van het Nederlands. En waar anders komt de taal zo mooi tot zijn recht als in de muziek. We spreken met Hans van der Werf (Hiigo), Isabèl Usher en Scott Beekhuizen (Prins S. en De Geit). Drie artiesten met ieder een eigen stijl; over schrijven, inspiratie en zinnen die blijven hangen, lang nadat de muziek is gestopt.\u003c/p\u003e","meta":{"title":"Drie artiesten om tafel: Waarom zij hard gaan op Nederlandstalig","description":"Hiigo, Prins S. en de Geit en Isabèl Usher over schrijven, inspiratie en hun liefde voor taal.","image":null},"publish_date