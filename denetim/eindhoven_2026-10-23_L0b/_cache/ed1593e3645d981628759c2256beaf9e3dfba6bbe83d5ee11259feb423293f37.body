12/Schermafbeelding%202025-12-18%20124925.png?itok=esiMKcAO","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=xJ16JQGg","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=j4krj_ra","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=a3zoXw3J","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=93NzdgKp"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=AQg3OOvz 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=esiMKcAO 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=xJ16JQGg 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=j4krj_ra 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=a3zoXw3J 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-12/Schermafbeelding%202025-12-18%20124925.png?itok=93NzdgKp 720w"]},"source":null,"source_link":null},"is_fullscreen":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724593645,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-legends-rock-tribute-festival-xl-nl","queryHash":"[\"AgendaDetail-legends-rock-tribute-festival-xl-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1837,"slug":"/agenda/1000mods","endpoint":"/nl/agenda/1000mods","translations":{"nl":"/agenda/1000mods","en":null},"title":"1000mods","content":"\u003cp\u003eDe Griekse heavy rocksensatie 1000mods combineert psychedelische riffs met spacey stonerrock in de traditie van Kyuss en Black Sabbath. Wat begon met het baanbrekende 'Super Van Vacation' groeide uit tot een internationale zegetocht vol uitverkochte zalen, gedragen door klassiekers als ‘Electric Carve’ en ‘Vidage’ en een live-reputatie die zijn gelijke niet kent.\u003c/p\u003e","meta":{"title":"1000mods op zondag 27 september in Effenaar! ","description":"De Griekse heavy rocksensatie 1000mods combineert psychedelische riffs met spacey stonerrock in de traditie van Kyuss en Black Sabbath. Wat begon met het baanbrekende Super Van Vacation groeide uit tot een internationale zegetocht vol uitverkochte zalen, gedragen door klassiekers als ‘Electric Carve’ en ‘Vidage’ en een live-reputatie die zijn gelijke niet kent.","image":{"image":{"alt":"1000mods","src":"https://d12y285rxlbnxt.cloudfront.net/2026-03/%20%E2%80%93%201920x1080%20Website_0.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-03/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=yAFabxha","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-03/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=YZlRgyZK","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-03/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=PlabWsK9","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-03/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=1uS-NT7C","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-03/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=N1y1EY2j","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-03/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=hJV9IlCP"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-03/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=yAFabxha 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-03/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=YZlRgyZK 1920w","https://d12