al":false}],"state":null,"club_card_event":true,"colors":{"accent_color":"#a26b9d","background_color":"#FFFFFF","text_color":"#000000"}}],"blocks":[{"type":"featured_paragraph","id":"c7556124-ea5a-4f77-af05-b6f1ef361dc7","header":{"title":"Sababa 5"},"content":{"content":"\u003cp\u003eSababa 5 is een in Parijs gevestigde band die bekendstaat om hun hypnotiserende mix van Midden-Oosterse\u003cbr\u003epsychedelica, mediterrane funk en analoge groove. Hun geluid combineert wervelende orgels, surfgitaren\u003cbr\u003een onweerstaanbare ritmes tot een stijl die zowel nostalgisch als vooruitstrevend is. Geworteld in\u003cbr\u003evintageklanken, maar altijd in ontwikkeling.\u003c/p\u003e","image":{"image":{"alt":"Sababa 5","src":"https://d12y285rxlbnxt.cloudfront.net/2026-08/21_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-08/21_0.png?itok=ftlr_N5o","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-08/21_0.png?itok=zMnKOh0O","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-08/21_0.png?itok=JpuC374F","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-08/21_0.png?itok=tdMLcVlB","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-08/21_0.png?itok=nyGUap_r","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-08/21_0.png?itok=vMM838q2"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-08/21_0.png?itok=ftlr_N5o 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-08/21_0.png?itok=zMnKOh0O 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-08/21_0.png?itok=JpuC374F 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-08/21_0.png?itok=tdMLcVlB 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-08/21_0.png?itok=nyGUap_r 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-08/21_0.png?itok=vMM838q2 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"36a1b5cb-5063-4ce5-8818-5beeaeaea4ee","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/rmQa763-nh4?si=BOEBA7W1pdGD2tfp\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"86f28a2f-f0d6-41c6-8f75-9e5ac2c89483","header":{"title":"Zajal"},"content":{"content":"\u003cp\u003eZajal is een duo dat een droge, warme wind rechtstreeks uit West-Azië en Noord-Oost-Afrika met zich meebrengt. De magie van machines, vermengd met de saz en derbouka’s, ontvouwt zich op de dansvloer in een hypnotiserende en transcendente hedendaagse folklore. Een liveconcert dat je meevoert op ritmes die je nog 1001 nachten in je hoofd zullen blijven hangen.\u003c/p\u003e","image":{"image":{"alt":"Zajal","src":"https://d12y285rxlbnxt.cloudfront.net/2026-08/19_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-08/19_0.png?itok=eu-sJ1tI","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-08/19_0.png?itok=Y5adufL7","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-08/19_0.png?itok=PmLFCydK","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-08/19_0.png?itok=9WGQXtPF","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-08/19_0.png?itok=JY9G17AK","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-08/19_0.png?itok=0vx95EPa"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-08/19_0.png?itok=eu-sJ1tI 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-08/19_0.png?itok=Y5adufL7 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-08/19_0.png?itok=PmLFCydK 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-08/19_0.png?itok=9WGQXtPF 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-08/19_0.png?itok=JY9G17AK 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-08/19_0.png?itok=0vx95EPa 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"80028e8b-6796-43be-af92-9f2684eac15e","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe data-testid=\"embed-iframe\" style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/artist/0nXZJnYk9Z8ngoqAU6bsAC?utm_source=generator\u0026theme=0\u0026si=47d6f8f4e66d4183\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"3e03186e-7b47-497f-b250-88b2f9ccd39d","header":{"title":"Trackvogels"},"content":{"content":"\u003cp\u003eDit Amsterdamse collectief vliegt als een vlucht vogels over het podium: energiek, speels, hypnotiserend en vooral met doelgerichte precisie. Trackvogels zijn altijd in beweging en dat hoor je ook terug in de muziek. Of ze nu in de verste uithoeken van de wereld zitten of gewoon in hun studio in Amsterdam-Noord, overal vinden ze wel inspiratie om hun buitengewone mix van verschillende muziekstijlen nog net dat tikkeltje specialer te maken.Door traditionele invloeden uit verschillende delen van de wereld te combineren met een intergalactische touch, jagen ze de temperatuur zo de hoogte in.\u003c/p\u003e","image":{"image":{"alt":"Trackvogels","src":"https://d12y285rxlbnxt.cloudfront.net/2026-08/20_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-08/20_0.png?itok=jvwA1HnQ","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-08/20_0.png?itok=BMRj7wVN","2510w":"https://d12y285rxlbnxt.cloudfront.net/styl