lbnxt.cloudfront.net/styles/720w/s3/2025-01/Logo%20Heavy%20Hossen.png?itok=iQxC1REQ"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-01/Logo%20Heavy%20Hossen.png?itok=KPDzdPFt 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-01/Logo%20Heavy%20Hossen.png?itok=J9okVKEy 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-01/Logo%20Heavy%20Hossen.png?itok=RDDFdxm- 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-01/Logo%20Heavy%20Hossen.png?itok=IC8BOnsX 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-01/Logo%20Heavy%20Hossen.png?itok=Z326l7dE 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-01/Logo%20Heavy%20Hossen.png?itok=iQxC1REQ 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"met Steek D'n Draak \u0026 DJ-teams van Altstadt, Dynamo, The Jack \u0026 Effenaar","upper_title":null,"tickets":[],"tags":[],"date":{"timestamp":1771113600,"machine":"2026-02-15"},"presale":null,"times":{"starts_at":"20:00","ends_at":"01:00","opens_at":"20:00"},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"facebook_event":{"uri":"https://fb.me/e/iIJQwCP9f","title":"","options":{"url":"https://fb.me/e/iIJQwCP9f"}},"genres":[],"club_card_event":false,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[],"blocks":[{"type":"paragraph","id":"7c2d6e1e-d22b-4e5a-baed-bbf3e583aef9","header":{"title":"Timetable"},"content":{"content":"\u003cp\u003e20:00 uur Deuren open\u003cbr\u003e20:00 - 21:15 uur Team Effenaar: De Rolonaise\u003cbr\u003e21:15 - 22:00 uur Team Dynamo\u003cbr\u003e22:00 - 23:00 uur Steek d'n Draak\u003cbr\u003e23:00 - 23:45 uur Team The Jack: Caught in a Hos\u003cbr\u003e23:45 - 00:30 uur Team Altstadt: Bad Boys\u003c/p\u003e\u003cp\u003eLet op: tijden zijn onder voorbehoud\u003c/p\u003e","links":null}},{"type":"paragraph","id":"ee032cdb-4e7f-4026-a744-7e411afc9d91","header":{"title":null},"content":{"content":"\u003cp\u003eOp de line-up: de beste alternatieve DJ’s van Lampegat: van o.a. The Jack, Altstadt, Dynamo en Effenaar. En natuurlijk komt er ook een bandje optreden. Namelijk: Steek d'n Draak! Carnaval for whom the polonaise walks! Du host! Wanted Dead Or Alaaf! Salaaif to the grind! Kickstart my hoempa! Chop Worstenbroodjes! Smells like vieze bierscheetjes! Oke we houden al op.\u003c/p\u003e\u003cp\u003eGratis toegang en vol = vol. Dus kom op tijd.\u003c/p\u003e","links":null}},{"type":"paragraph","id":"52fdb4b6-73b5-4d6c-a48f-3dc28792e9c7","header":{"title":"Feestcafé Effenar"},"content":{"content":"\u003cp\u003eVan zaterdag t/m maandag wordt ons restaurant Meet \u0026amp; Eat omgetoverd tot Feestcafé Effenar! Dus, ginne warme maaltijd, maar juist extra hossen en zingen met onze eigen DJ's die de ganse avond aan mekaar draaien. Da ken nie misse!\u003c/p\u003e","links":null}},{"type":"embed","id":"a0baa4f0-8ad1-44ca-93c6-cdc605d0f777","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/9_x8Q4g2bwo?si=TdHNfIB4uYwc9zuw\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724683825,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-carnaval-effenar-heavy-hossen-0-nl","queryHash":"[\"AgendaDetail-carnaval-effenar-heavy-hossen-0-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1209,"slug":"/agenda/kingongolo-kiniata","endpoint":"/nl/agenda/kingongolo-kiniata","translations":{"nl":"/agenda/kingongolo-kiniata","en":null},"title":"Kin'Gongolo Kiniata","content":"\u003cp\u003eMet een levendige mix van urbane ritmes, elektronische geluiden en handgemaakte percussie, weet Kin'Gongolo Kiniata de grenzen van Congolese muziek te herdefiniëren. En dat niet alleen: tegelijkertijd worden de diepe wortels van de cultuur geëerd. \u003c/p\u003e\r\n","meta":{"title":"Kin'Gongolo Kiniata","description":"Met een levendige mix van urbane ritmes, elektronische geluiden en handgemaakte percussie, weet Kin'Gongolo Kiniata de grenzen van Congolese muziek te herdefiniëren En dat niet alleen: tegelijkertijd worden de diepe wortels van de cultuur geëerd. ","image":{"image":{"alt":"kingongolo header","src":"https://d12y285rxlbnxt.cloudfront.net/2024-10/square%20kingolo.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/square%20kingolo.jpg?itok=FTw-lSaz","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/square%20kingolo.jpg?itok=v8HQWp71","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/square%20kingolo.jpg?itok=Jy-O1TOl","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/square%20kingolo.jpg?itok=gVVlB1mW","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/square%20kingolo.jpg?itok=KvSQ20la","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/square%20kingolo.jpg?itok=O4_PYafi"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/square%20kingolo.jpg?itok=FTw-lSaz 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/square%20kingolo.jpg?itok=v8HQWp71 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/square%20kingolo.jpg?itok=Jy-O1TOl 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/square%20kingolo.jpg?itok=gVVlB1mW 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/square%20kingolo.jpg?itok=KvSQ20la 480w","https://d1