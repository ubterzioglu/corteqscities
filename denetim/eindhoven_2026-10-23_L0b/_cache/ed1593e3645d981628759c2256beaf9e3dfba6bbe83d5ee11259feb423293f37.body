26-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=3DTeFfiU 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=jnERAwSI 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=53ZPzPLd 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=mSGXhcmX 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=ENhTv3bO 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#dce0da","background_color":"#485b6d","text_color":"#FFFFFF"}}],"blocks":[{"type":"paragraph","id":"a310ed1f-0bf8-4742-b57c-d757bece2e39","header":{"title":"This page is also available in English:"},"content":{"content":"\u003cp\u003e\u003ca href=\"https://www.effenaar.nl/en/en/party-nomansland-yin-yin-kumbia-boruka\" title=\"Click here to read.\"\u003ehttps://www.effenaar.nl/en/en/party-nomansland-yin-yin-kumbia-boruka\u003c/a\u003e\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"aa8c3373-41a5-439c-bf90-f1cddfcbf940","header":{"title":"YĪN YĪN"},"content":{"content":"\u003cp\u003eHet Maastrichtse YĪN YĪN brengt hun Thaichedelica terug naar Effenaar! Naast optredens op festivals als Into The Great Wide Open en Best Kept Secret was YĪN YĪN - met hun psychedelische mix van Thaise funk, disco en elektronica - één van de hoogtepunten van Hit The City 2022. Op zaterdag 9 september brengen ze hun nieuwste album 'The Age Of Aquarius' terug naar Eindhoven om het nog eens dunnetjes over te doen, maar dan in de Grote Zaal!\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"1a3a4679-02b9-4c48-b429-6674a81dc9af","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/4hocimNA2HqHGJENlvTvws?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"657f2270-3139-4317-8f40-f9cb7895a908","header":{"title":"Kumbia Boruka "},"content":{"content":"\u003cp\u003eDe in Lyon gevestigde liveband Kumbia Boruka heeft hun roots in de Mexicaanse \u003cem\u003ecumbia capital \u003c/em\u003eMonterrey; de stad waar bandleider Hernan Cortés de fijne kneepjes van het vak leerde van cumbia-legende Celso Piña. En Kumbia Boruka beheerst naast de klassieke cumbia grooves ook 'nueva cumbia' met invloeden uit reggae, dub, Afrikaanse muziek, rock en meer. Met twee albums en meer dan 250 liveshows aan ervaring is feest gegarandeerd. \u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"Kumbia Boruka","src":"https://d12y285rxlbnxt.cloudfront.net/2023-06/Kumbia%20Boruka%20afbeelding.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=Af4MflVm","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=W9q_LdrG","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=13VFXB_c","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=9Ir5U1Ed","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=E1LSw2aL","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=KBcmkL8a"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=Af4MflVm 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=W9q_LdrG 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=13VFXB_c 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=9Ir5U1Ed 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=E1LSw2aL 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/Kumbia%20Boruka%20afbeelding.jpg?itok=KBcmkL8a 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"83d450c8-31d2-44e8-9e11-903c34291d83","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/artist/3B7XF3wKmK3NFMO4AGfzd7?utm_source=generator\u0026theme=0\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"6229c2f2-8a9e-49be-ba92-e6de88fe0b32","header":{"title":"Daniel Monaco"},"content":{"content":"\u003cp\u003eArtiest/producer/bassist Daniel Monaco is het best bekend voor zijn unieke mix van italo disco, proto house, obscure disco. Én alles met een tropische touch. Op 9 september brengt hij het zonnetje naar de dansvloer!\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"Daniel Monaco","src":"https://d12y285rxlbnxt.cloudfront.net/2023-08/Daniel%20Monaco%201080x1080.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-08/Daniel%20Monaco%201080x1080.jpg?itok=dYDgtGqX","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-08/Daniel%20Monaco%201080x1080.jpg?itok=1A1ow3J3","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-08/Daniel%20Monaco%201080x1080.j