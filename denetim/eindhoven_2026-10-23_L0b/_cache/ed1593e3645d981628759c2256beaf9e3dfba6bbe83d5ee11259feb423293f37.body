 Festival. \u003c/p\u003e\u003cp\u003eJoin us on Friday, May 1, and Saturday, May 2, with performances by W.I.T.C.H., A Place To Bury Strangers, L.A. Witch, Dead Skeletons, Causa Sui, Minami Deutsch and many more.\u003c/p\u003e","meta":{"title":"Fuzz Club 2026","description":"","image":null},"publish_date":{"timestamp":1756902326,"machine":"2025-09-03T12:25:26+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"WITCH header","src":"https://d12y285rxlbnxt.cloudfront.net/2025-10/WITCH.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-10/WITCH.png?itok=LYZFz_wL","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-10/WITCH.png?itok=kKQPAUkt","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-10/WITCH.png?itok=ahpDkAr9","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-10/WITCH.png?itok=jYgOqRur","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-10/WITCH.png?itok=rprjcpRz","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-10/WITCH.png?itok=D0q2cs_9"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-10/WITCH.png?itok=LYZFz_wL 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-10/WITCH.png?itok=kKQPAUkt 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-10/WITCH.png?itok=ahpDkAr9 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-10/WITCH.png?itok=jYgOqRur 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-10/WITCH.png?itok=rprjcpRz 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-10/WITCH.png?itok=D0q2cs_9 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#D93636","background_color":"#29C060","text_color":"#000000"},"thumbnail_image":{"image":{"alt":"WITCH square","src":"https://d12y285rxlbnxt.cloudfront.net/2025-10/WITCH%201080x1450.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-10/WITCH%2010