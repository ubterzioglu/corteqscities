FFF"}}],"blocks":[{"type":"paragraph","id":"f075bbad-669e-4cd6-bb72-7c6f394f1ca9","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e\u003cstrong\u003eStage 1:\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e16.30 uur: Red Hot Chili Peppers by Funky Monks\u003c/p\u003e\u003cp\u003e18.00 uur: Pearl Jam by WHY GO HOME\u003c/p\u003e\u003cp\u003e19.30 uur: Green Day by Green Bay\u003c/p\u003e\u003cp\u003e21.00 uur: Foo Fighters by Monkey Wrench\u003c/p\u003e\u003cp\u003e22.45 uur: Muse by Knights of Muse\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eStage 2:\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e17.30 uur: Soundgarden/Audioslave by Soundslave\u003c/p\u003e\u003cp\u003e20.00 uur: Linkin Park by LinCoil Park\u003c/p\u003e\u003cp\u003e22.00 uur: Nirvana by The Servants\u003c/p\u003e","links":null}},{"type":"effenaar_image","id":"b3b51940-e7b5-4af9-9cea-db73d5de2ae5","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Legends of Rock line-up","src":"https://d12y285rxlbnxt.cloudfront.net/2025-06/20251227---LoR-XL---Effenaar-v1-3_4.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-06/20251227---LoR-XL---Effenaar-v1-3_4.jpg?itok=jr1G3QPQ","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-06/20251227---LoR-XL---Effenaar-v1-3_4.jpg?itok=QhIcGnCR","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-06/20251227---LoR-XL---Effenaar-v1-3_4.jpg?itok=dAnOhep2","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-06/20251227---LoR-XL---Effenaar-v1-3_4.jpg?itok=sGrnl3As","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-06/20251227---LoR-XL---Effenaar-v1-3_4.jpg?itok=s0tp1vSZ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-06/20251227---LoR-XL---Effenaar-v1-3_4.jpg?itok=YiUWLp9N"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-06/20251227---LoR-XL---Effenaar-v1-3_4.jpg?i