loudfront.net/styles/320w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=8-a_jbqa 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=nLP8a3vg 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=rJGoFYJl 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#BFBFBF","background_color":"#404040","text_color":"#FFFFFF"},"tags":[],"related_events":[]}]}}],"subtitle":"Door Roeline Machiels","thumbnail_image":{"image":{"alt":"Thumb Ray elpee","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230414-DSC_3414.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3414.png?itok=TGx5Cocd","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3414.png?itok=pP_B8iVZ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3414.png?itok=hTkIv8ct","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3414.png?itok=b2UMU9WM","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3414.png?itok=VcH_CYFQ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3414.png?itok=aomNYD4K"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3414.png?itok=TGx5Cocd 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3414.png?itok=pP_B8iVZ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3414.png?itok=hTkIv8ct 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3414.png?itok=b2UMU9WM 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3414.png?itok=VcH_CYFQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3414.png?itok=aomNYD4K 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F29F05","background_color":"#F2F2F2","text_color":"#000000"},"tags":[],"related_events":[]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724596967,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"LongReads-hier-scoor-je-de-vetste-platen-eindhoven-nl","queryHash":"[\"LongReads-hier-scoor-je-de-vetste-platen-eindhoven-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"longread","nid":1235,"slug":"/artikelen/somebodys-child","endpoint":"/nl/artikelen/somebodys-child","translations":{"nl":"/artikelen/somebodys-child","en":null},"title":"Somebody's Child: ‘Als dit het laatste album is dat we ooit uitbrengen, dan kan ik daar vrede mee hebben.’","content":"\u003cp\u003eSomebody's Child is het geesteskind van Cian Godfrey. De muzikant groeide op in Frankrijk en Ierland, maar woont inmiddels in het Verenigd Koninkrijk. Grote kans dat je al van de band gehoord hebt, want afgelopen editie speelden ze tijdens het gratis stadsfestival Hit The City het Ketelhuisplein plat. Op 6 december komt Somebody’s Child terug naar Eindhoven, en dat met nieuwe nummers op zak.\u003c/p\u003e\r\n","meta":{"title":"‘Als dit het laatste album is dat we ooit uitbrengen, dan kan ik daar vrede mee hebben.’","description":"Een kijkje in het creatieve maakproces van Somebody's Child.","image":{"image":{"alt":"somebodys child header longread","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=BB1ZBSRM","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=3Jzjr0m0","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=cgQ8lcsL","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=YGlywYmi","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=uzQDBLq3","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=1FvUPuAR"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=BB1ZBSRM 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=3Jzjr0m0 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=cgQ8lcsL 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=YGlywYmi 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=uzQDBLq3 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=1FvUPuAR 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1731405505,"machine":"2024-11-12T09:58:25+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"somebodys child header longread","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=BB1ZBSRM","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=3Jzjr0m0","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=cgQ8lcsL","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=YGlywYmi","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=uzQDBLq3","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=1FvUPuAR"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=BB1ZBSRM 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=3Jzjr0m0 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=cgQ8lcsL 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=YGlywYmi 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=uzQDBLq3 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-319%20header.jpg?itok=1FvUPuAR 720w"]},"source":"Foto: Guus van der Aa","source_link":null},"breadcrumb":null,"blocks":[{"type":"paragraph","id":"43b126c0-bf0b-4de0-84a0-9d0c30f291cd","header":{"title":null},"content":{"content":"\u003cp\u003eGodfrey blikt terug op een mooi jaar, waarin shows gespeeld werden met Bloc Party, Kings of Leon en The War on Drugs, en een hele berg festivals. \"We hadden de mazzel dat we veel supportplekken te pakken kregen. Dat is normaal een politiek spel, maar we mochten veel toffe bands supporten. Voor mij was spelen met The War on Drugs in Liverpool een hoogtepunt, dat is in mijn ogen namelijk één van de beste live bands en ook onze connectie met de fans was daar fantastisch. Het is bijzonder dat dit allemaal gebeurd is terwijl we helemaal geen nieuwe muziek uit hadden, maar die komt er aan.”\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"d549a9b3-7abb-4eda-b8bc-f5fe45f79853","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/KR34TmlgUpY?si=S_oDq4HjFt5JpD6O\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"0facc075-dc26-42ae-b14b-96f2699288db","header":{"title":null},"content":{"content":"\u003cp\u003eDe band kondigde op 7 november het nieuwe album 'When Youth Fades Away' aan, dat op 28 maart zal uitkomen. Vanwege een bijzonder creatief proces hebben ze daarvoor niet de promotiecontent gemaakt die wel verwacht wordt. \"We zijn dat een beetje vergeten tijdens ons opnameproces en met de aankondiging voel ik nu wel wat druk. Er is weer zoveel veranderd in de industrie qua software en data, en ik vind het lastig om het bij te benen. Bovendien zijn er veel dingen die 20 jaar geleden een label voor je deed, die je nu zelf moet doen.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"c67efd50-6a55-4fc3-b176-5543581a729c","header":{"title":null},"content":{"content":"\u003cp\u003eGodfrey ziet zichzelf als oldschool muzikant die vooral de muziek wil laten spreken, en de promo die verwacht wordt past daardoor minder in zijn artistieke visie. “Het is niet dat ik het belang van branding niet zie, ik promoot graag mijn muziek en wil dat mensen het horen, maar van mij zou dat niet in een 30 seconden Instagram of TikTok-variant hoeven. Dat vind ik niet fair naar de luisteraar of naar onszelf. Ik zie mezelf vooral als creatief, met muziek als mijn medium. Het lijkt alsof de focus verschuift van de muziek naar jezelf, je moet een persoonlijkheid zijn. Ik wil liever de muziek laten spreken. Ik houd ervan als artiesten wat mysterieus zijn. De muziek is de connectie en dat is genoeg. Maar je moet mee in deze wereld en men wil dat je dus ook marketeer bent. Of ik daarin altijd meega is een tweede...\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"05d3de83-3336-42c5-8d97-66081bc9f66d","header":{"title":"Schrijven als therapie"},"content":{"content":"\u003cp\u003eDe muzikant ziet muziek dan ook als ambacht, wat je met oprechte intenties beoefent om iets de wereld in te brengen. \"Muziek draait voor mij om het doorgronden van jezelf en de wereld om je heen. Schrijven is voor mij als therapie, en daar komt iets uit waar de luisteraar zelf mag uithalen wat hij wil. Ik hoop dat mijn muziek mensen uit hun dagelijkse sleur haalt en het gevoel geeft dat je leeft. Aan mij is de taak om dat zo goed mogelijk af te leveren, maar zodra de muziek in de wereld is, dan is mijn rol voorbij. Dat maakt het ook zo lastig om nu promo te creëren, terwijl ik al aan een volgend hoofdstuk start.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"82192b39-961a-4e00-8b53-b1598ada944a","header":{"title":null},"content":{"content":"\u003cp\u003eHet diepe inzicht in wat Somebody’s Child is en wil zijn, komt deels voort uit de pandemie. Net daarvoor stond de band in de startblokken om festivals onveilig te gaan maken. \"We hadden veertien festivals op de agenda, en alles viel weg. Het leek alsof alles voorbij was voor ons als band, alsof we onze kans hadden gemist. Er was dus niks anders te doen dan doorgaan en muziek te schrijven. Wel kwamen we uit die periode met een fan schare die we daarvoor niet hadden.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"d309222d-4dfd-4bd0-be1b-57b6d11a1320","header":{"title":null},"content":{"content":"\u003cp\u003eDe muziek van Somebody's Child is contemplatief, een expressie die tijd nodig heeft. In die zin heeft de pandemie ook wat goeds gebracht. \"Het lastige met muziek schrijven is dat je nooit weet of je de goede kant op gaat. Je moet op je gevoel varen en het enige wat je kan doen is zorgen voor goede energie en sfeer. Tijdens de pandemie gebeurde er niets en we probeerden structureel samen te komen om goede muziek te maken. We zijn erg gegroeid in die tijd en creatief nu veel sterker. We weten wat we nodig hebben, misschien waren we anders nog steeds erg verloren.”\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"6503a2c2-a6d1-465d-a31f-8b5481a30d5a","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/artist/5b84ozqhKiJG9LN1IjVac1?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"1c5b7d41-6ee1-425f-be65-a2201d8e54e4","header":{"title":"Vijf artiesten op repeat"},"content":{"content":"\u003cp\u003eIn 2023 kwam het gelijknamige debuutalbum uit, een plaat die groots klinkt, maar ook vol gevoel zit. Zo trots als de band daarop is, wilde Godfrey verder graven in de identiteit van Somebody’s Child. “Voor het nieuwe album, hebben we onszelf vijf maanden afgesloten van de wereld en niet naar andere muziek geluisterd. We hebben vijf artiesten geselecteerd om op repeat naar te luisteren, met het doel niet vergeleken te worden met anderen, en om zo juist diep te duiken in wie we zijn en hoe we klinken. Er stond dan ook geen muziek van nu op het menu, alleen maar artiesten van meer dan twintig jaar geleden. Dat was een soort emotionele zuivering, catharsis, als ik die ervaring zou omschrijven. Ik was alleen maar gefocust op het creatieve proces en dat is een plek waar ik nog nooit eerder ben geweest. Je vindt een visie, een soort wereld in je hoofd die afspeelt als een film. Het is één van de meest betekenisvolle creatieve ervaringen tot nu toe geweest voor mij.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"7ce7e217-9230-4d0a-915f-3d2b0259ac6a","header":{"title":null},"content":{"content":"\u003cp\u003eDe band besloot niet alleen om selectief te zijn met muziek, maar ook met andere mediaconsumptie. Eigenlijk was het dus een heel precies gecureerd mediadieet voor de groep. “Op elk moment hebben we eindeloze keuze en als artiest is het belangrijk jezelf te beperken. Ik ben als een spons, als ik iets hoor of zie neem ik het tot me en ga ik het gebruiken, dus restrictie is belangrijk om te ontdekken wat je echt te zeggen hebt. Dit zorgde ervoor dat ik op die plek kwam, waar ik wist wat de wereld mij wilde vertellen.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"d41223e4-3648-4cfe-a0a6-4e464cbde8ed","header":{"title":null},"content":{"content":"\u003cp\u003eWat er precies in het mediapakket zat, wil de zanger niet vertellen, maar een paar ingrediënten wil hij wel benoemen. “Qua muziek was het in ieder geval Waterboys en Kraftwerk. We wisten dat we nooit een Kraftwerk-nummer zouden maken, maar het is een soort Noordster voor ons. En Haruki Murakami is een auteur die veel heeft betekend in ons proces, zijn werk leent zich voor een bijna cinematisch universum.”\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"0db6ef1c-1789-42f4-86c6-85b926954970","header":{"title":"Somebody's Child tijdens Hit The City 2024","description":null},"content":{"items":[{"image":{"alt":"sc 1","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=VB4ND5uo","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=D0G0wTR8","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=9C9Cgu4s","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=a6G5_rvR","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=qC-HDmZ8","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=0I1K06XB"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=VB4ND5uo 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=D0G0wTR8 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=9C9Cgu4s 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=a6G5_rvR 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Hit%20the%20City%20-%20Photo%20by%20Guus%20van%20der%20Aa-315.jpg?itok=qC-HDmZ8 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Hit%20the%20City%