2y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/Thumbwilhelmina.png?itok=8qlKDs69","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/Thumbwilhelmina.png?itok=gaDwDrKm","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/Thumbwilhelmina.png?itok=7RMHJyyu"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/Thumbwilhelmina.png?itok=vWZ1uDGB 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/Thumbwilhelmina.png?itok=2OA0y1yG 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/Thumbwilhelmina.png?itok=gE0A71sv 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/Thumbwilhelmina.png?itok=8qlKDs69 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/Thumbwilhelmina.png?itok=gaDwDrKm 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/Thumbwilhelmina.png?itok=7RMHJyyu 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F2E6D8","background_color":"#8C4A2A","text_color":"#FFFFFF"},"tags":[],"related_events":[]},{"type":"longread","nid":1235,"slug":"/artikelen/somebodys-child","endpoint":"/nl/artikelen/somebodys-child","translations":{"nl":"/artikelen/somebodys-child","en":null},"title":"Somebody's Child: ‘Als dit het laatste album is dat we ooit uitbrengen, dan kan ik daar vrede mee hebben.’","content":"\u003cp\u003eSomebody's Child is het geesteskind van Cian Godfrey. De muzikant groeide op in Frankrijk en Ierland, maar woont inmiddels in het Verenigd Koninkrijk. Grote kans dat je al van de band gehoord hebt, want afgelopen editie speelden ze tijdens het gratis stadsfestival Hit The City het Ketelhuisplein plat. Op 6 december komt Somebody’s Child terug naar Eindhoven, en dat met nieuwe nummers op zak.\u003c/p\u003e\r\n","meta":{"title":"‘Als dit het laatste album is dat we ooit uitbrengen, dan kan ik daar vrede mee hebben.’","description":"Een kijkje in het creatieve maakproces van Somebody's Child.","image":null}