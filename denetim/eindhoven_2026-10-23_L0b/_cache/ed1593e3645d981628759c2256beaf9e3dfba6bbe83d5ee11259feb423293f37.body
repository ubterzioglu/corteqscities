n-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"144a0c30-56c4-463e-963a-ce86f7cdfaec","header":{"title":null},"content":{"content":"\u003cp\u003eDe band mengt harmonieuze zang typerend voor rituele West-Afrikaanse voodoo ceremonies met 70’s afro funk, blues en soul met invloeden van James Brown, Otis Redding en Wilson Pickett tot een opzwepend en hypnotiserend geheel. Je ontdekte ze eerder op de festivalpodia van Into The Great Wide Open, North Sea Jazz Festival, Down The Rabbit Hole en in Effenaar in 2019. Met nieuwe muziek op zak, laat Vaudou Game onze Kleine Zaal op zondag 26 januari weer dansen!\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"902d530d-e2d9-45a1-93c6-c714bc4d8d48","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/sN9StbxjJPw?si=m7BLj2SIHRJ0ya22\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724682652,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-vaudou-game-nl","queryHash":"[\"AgendaDetail-vaudou-game-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1202,"slug":"/agenda/portal-next-gen-1","endpoint":"/nl/agenda/portal-next-gen-1","translations":{"nl":"/agenda/portal-next-gen-1","en":null},"title":"Portal - The Next Gen","content":"\u003cp\u003eNa eerdere uitverkochte edities zijn onze vrienden van Portal - The Next Gen terug in Effenaar! Stap in deze mysterieuze wereld tijdens een van de hardste raw boilerrooms van Nederland. Deze editie wordt te gek, na een aantal keer onze Kleine Zaal uitverkopen, komt Portal nu naar de Grote Zaal!\u003c/p\u003e\r\n\r\n\u003cp\u003eLet op: dit event is 18+\u003c/p\u003e\r\n","meta":{"title":"Portal - The Next Gen | Effenaar","description":"Na eerdere uitverkochte edities zijn onze vrienden van Portal - The Next Gen terug in Effenaar! ","image":null},"publish_date":{"timestamp":1729154059,"machine":"2024-10-17T08:34:19+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Header portal","src":"https://d12y285rxlbnxt.cloudfront.net/2024-10/Kopie%20van%201920x1080-Banner.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=63-XtGVT","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=DusG51cq","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=0gNZnsks","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=T7z57HSF","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=P_0oCBSK","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=5CVXEQkU"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=63-XtGVT 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=DusG51cq 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=0gNZnsks 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=T7z57HSF 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/Kopie%20van%201920x1080-Banner.jpg?itok=P_0oCBSK 480w","https://d12y285rxl