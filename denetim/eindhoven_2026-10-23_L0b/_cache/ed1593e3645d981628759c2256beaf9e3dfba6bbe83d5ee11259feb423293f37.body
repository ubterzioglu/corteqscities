nly%20noah%20guthri.png?itok=_7zSMoY1 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=V9gDUw4p 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=EiTmwpGM 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=5hpi7OhD 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=SYoqsweO 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=HlzHFVhD 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"Amerikaanse singer-songwriter brengt artistieke americana","upper_title":null,"tickets":[],"tags":[],"date":{"timestamp":1793232000,"machine":"2026-10-29"},"presale":null,"times":{"starts_at":"20:30","ends_at":null,"opens_at":"20:00"},"locations":[],"facebook_event":{"uri":"https://www.facebook.com/events/835961458986730","title":"","options":{"url":"https://www.facebook.com/events/835961458986730"}},"genres":[],"club_card_event":true,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[]},{"type":"event","nid":1936,"slug":"/agenda/k-pop-night-halloween","endpoint":"/nl/agenda/k-pop-night-halloween","translations":{"nl":"/agenda/k-pop-night-halloween","en":null},"title":"K-POP Night - Halloween edition","content":"\u003cp\u003eK-POP Night is terug in Effenaar! Tijdens deze editie vieren we Halloween door ons te verkleden, de zaal te decoreren met webben en spinnen en (naast de nummers die we allemaal liefhebben) een aantal B-sides te draaien die bij het thema passen. Kom verkleed en wie weet win jij een toffe K-POP Night goodiebag!\u003c/p\u003e\u003cp\u003eZoals je van ons gewend bent, organiseren we een Random Play Dance, kun je shoppen in de minimarkt, soju drinken aan de bar (18+), treedt K-Motion op en geven we de photobooth een Halloweenmake-over. \u003cem\u003eAre you ready to dance the night away, like it's your last?\u003c/em\u003e Koop dan nu je tickets!\u003c/p\u003e\u003cp\u003eLet op: dit event is 16+. Neem een geldig ID mee om dit aan te kunnen tonen. \u003c/p\u003e","meta":{"title":"K-POP Night - Halloween Edition | Effenaar","description":"Op vrijdag 30 oktober is K-POP Night terug met een Halloween editie! Naast je favoriete K-pop nummers, draaien we een aantal B-sides die bij het thema passen. Drink Soju aan de bar, shop op de mini markt en doe mee aan de Random Play Dance! ","image":null},"publish_date":{"timestamp":1781184356,"machine":"2026-06-11T13:25:56+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"K-Pop Night Halloween","src":"https://d12y285rxlbnxt.cloudfront.net/2026-06/%20%E2%80%93%201920x1080%20Websitehallo.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-06/%20%E2%80%93%201920x1080%20Websitehallo.png?itok=1W0jd5eq","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-06/%20%E2%80%93%201920x1080%20Websitehallo.png?itok=q8v6bsJI","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-06/%20%E2%80%93%201920x1080%20Websitehallo.png?itok=9DAzt9pd","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-06/%20%E2%80%93%201920x1080%20Websitehallo.png?itok=KtH8DDqj","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-06/%20%E2%80%93%201920x1080%20Websitehallo.png?itok=1b_j5OJb","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-06/%20%E2%80%93%201920x1080%20Websitehallo.png?itok=Ep1fRJe0"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-06/%20%E2%80%93%201920x1080%20Websitehallo.png?itok=1W0jd5eq 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-