ets mysterieuzere koers: minder zichtbaarheid, meer focus op nieuwe muziek. Met uiteenlopende tracks bewijst het trio dat regels er niet toedoen.","image":null},"publish_date":{"timestamp":1785233640,"machine":"2026-07-28T10:14:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"vals alarm header","src":"https://d12y285rxlbnxt.cloudfront.net/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=K2TJUJx1","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=DngWv4ub","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=hX4dEwgc","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=mPe3OQOu","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=bvxOclug","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=YwQt51o5"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=K2TJUJx1 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=DngWv4ub 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=hX4dEwgc 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=mPe3OQOu 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=bvxOclug 480w","https://d12y285rxlbnxt.cloudf