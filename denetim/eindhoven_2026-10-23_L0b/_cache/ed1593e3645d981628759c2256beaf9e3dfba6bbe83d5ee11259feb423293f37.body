/320w/s3/2022-11/Bridge_logo_social_no%20circle_tagline.png?itok=lp92EQ1b 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-11/Bridge_logo_social_no%20circle_tagline.png?itok=WvQATaA0 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-11/Bridge_logo_social_no%20circle_tagline.png?itok=s9r-p_rE 720w"]},"source":null,"source_link":null},"header_text_size":"small","subtitle":"Eindhoven Guitar Festival","upper_title":null,"tickets":[],"tags":[{"id":159,"title":"Gitaarfestival"}],"date":{"timestamp":1683849600,"machine":"2023-05-12"},"presale":{"timestamp":1669334400,"machine":"2022-11-25"},"times":{"starts_at":"12:00","ends_at":null,"opens_at":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false},{"id":118,"title":"Café Wilhelmina","is_external":false},{"id":141,"title":"Altstadt","is_external":false},{"id":129,"title":"'t Rozenknopje","is_external":false},{"id":158,"title":"The Jack","is_external":false},{"id":140,"title":"Muziekgebouw","is_external":false}],"facebook_event":{"uri":"https://www.facebook.com/events/921305865755757/","title":"","options":{"url":"https://www.facebook.com/events/921305865755757/"}},"genres":[{"id":121,"title":"Pop / Rock"},{"id":54,"title":"heavy"},{"id":117,"title":"Singer – songwriter / Americana"},{"id":122,"title":"Funk / Soul / Jazz / Reggae"}],"club_card_event":false,"ticket_url":{"uri":"http://www.bridgefestival.com/","title":"","options":{"url":"http://www.bridgefestival.com/"}},"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[{"nid":1852,"title":"Rolf Sanchez","subtitle":"Dé Nederlandse Latin-sensatie van dit moment","slug":"/agenda/rolf-sanchez","endpoint":"/nl/agenda/rolf-sanchez","date":{"timestamp":1792713600,"machine":"2026-10-23"},"thumbnail_image":{"image":{"alt":"Rolf Sanchez","src":"https://d12y285rxlbnxt.cloudfront.net/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png","sizes":{"1400w":"https://d12y285rxlbnx