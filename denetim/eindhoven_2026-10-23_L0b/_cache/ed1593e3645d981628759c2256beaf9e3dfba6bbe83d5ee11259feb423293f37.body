cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"e9f67395-1c4f-4688-bc22-6a9e1cb855de","header":{"title":"Floor = Lava"},"content":{"content":"\u003cp\u003eThe Grand East heeft een nieuwe samenstelling en met hun nieuwste album ‘Floor = Lava’ ook een nieuwe sound. The Grand East is uitgegroeid tot een rock-'n-rollband die meerdere decennia omspant, waarbij invloeden uit de synthwave uit de jaren '80 en garagerock uit de jaren '90 ook duidelijk hoorbaar zijn. Minder jams, meer songs.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"38dee342-2980-42eb-bfd9-3987c9097ca6","header":{"title":"'Flirten met fout'"},"content":{"content":"\u003cp\u003eIn de studio zijn ze gaan flirten met fout. Niet naast de pot pissen, maar naast de pot mikken. Alles mocht inspireren, zolang je nekharen er maar van overeind gaan staan. Ze weten nog wel waar ze vandaan komen, ze weten alleen de weg niet meer terug. Dit is de meest zweterige boyband van Nederland die live zo hard rockt dat je er steil van achterover slaat. Zorg dat je erbij bent op zaterdag 16 maart in Café Wilhelmina!\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"dbd6557c-9c80-4e27-81f4-1dfe77af4a44","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/vNEMqErEtV8?si=NtrEkC7IbjcbMwL2\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724616878,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-grand-east-nl","queryHash":"[\"AgendaDetail-grand-east-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1259,"slug":"/agenda/noah-gundersen-david-ramirez","endpoint":"/nl/agenda/noah-gundersen-david-ramirez","translations":{"nl":"/agenda/noah-gundersen-david-ramirez","en":null},"title":"Noah Gundersen \u0026 David Ramirez","content":"\u003cp\u003eDe Amerikaanse singer-songwriter Noah Gundersen experimenteert al bijna twee decennia met indiefolk en akoestische rock. Zijn gedurfde, genre-overstijgende muziek werd al gebruikt in populaire series als \u003cem\u003eSons of Anarchy\u003c/em\u003e en \u003cem\u003eThe Vampire Diaries\u003c/em\u003e. Op de plaat \u003cem\u003eA Pillar of Salt\u003c/em\u003e (2021) werkte hij samen met Phoebe Bridgers. Ondanks dat hij nog geen 30 is, straalt Noah een opmerkelijk zelfbewustzijn uit. Hij is geen \"oude ziel,\" maar iemand die van jongs af aan gewend was zijn geloof en de wereld om hem heen kritisch te bevragen.\u003c/p\u003e\r\n","meta":{"title":"Noah Gundersen \u0026 David Ramirez","description":"","image":null},"publish_dat