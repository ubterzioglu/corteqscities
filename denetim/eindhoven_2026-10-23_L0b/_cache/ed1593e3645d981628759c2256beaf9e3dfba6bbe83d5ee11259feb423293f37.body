ttps://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=P9_UJ5Pu 720w"]},"source":null,"source_link":null},"locations":[{"id":141,"title":"Altstadt","is_external":false}],"state":null,"club_card_event":true,"colors":{"accent_color":"#285d33","background_color":"#e7f0f1","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"57863762-297b-4ebf-862f-7e864d7f9205","header":{"title":null},"content":{"content":"\u003cp\u003eIn 2024 deed ditzelfde collectief een uiterst succesvolle tournee door Belgische en Nederlandse zalen met een doorsnede uit 50 jaar Ramones werk. Nu dus terug een iets andere insteek maar met dezelfde energie en bravoure, gebracht door vier totaal verschillende karakters, gebonden door hun liefde voor pure rock 'n roll.\u003cbr\u003e\u003cem\u003eOne, two, three, four! Gabba, Gabba, Hey!\u003c/em\u003e\u003c/p\u003e","links":null}},{"type":"embed","id":"f8f57e5e-607c-4582-8854-0b04b0e5338a","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/g5pAPAoc0fU?si=xVtbOwS1WawU2Y0W\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"209949de-0d81-4aff-9835-417451aa2b67","header":{"title":"Support: FLORA SKULLER"},"content":{"content":"\u003cp\u003eFLORA SKULLER is de artiestennaam van Fleur Van Zuilen, gitarist en zangeres van de rockbandMARCH waarmee zij al jaren door heel Europa toert. Fleur staat bekend om haar rauwe stem,waarmee ze naam heeft gemaakt in de punk en rockscene. Voor dit concert speelt ze akoestische punk-classiekers van onder andere Misfits, Blondie en Bad Religion.\u003c/p\u003e","image":{"image":{"alt":"Flora Skuller","src":"https://d12y285rxlbnxt.cloudfront.net/2025-11/flora%20skuller.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/flora%20skuller.png?itok=cCQUEb2i","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/flora%20skuller.png?itok=8DWMcqHj","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/flora%20skuller.png?itok=kAeeNXSO","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/flora%20skuller.png?itok=ayS022UC","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/flora%20skuller.png?itok=lGrGDxqA","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/flora%20skuller.png?itok=k8ghrfuo"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/flora%20skuller.png?itok=cCQUEb2i 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/flora%20skuller.png?itok=8DWMcqHj 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/flora%20skuller.png?itok=kAeeNXSO 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/flora%20skuller.png?itok=ayS022UC 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/flora%20skuller.png?itok=lGrGDxqA 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/flora%20skuller.png?itok=k8ghrfuo 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724592327,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-ramones-alive-20mrt-nl","queryHash":"[\"AgendaDetail-ramones-alive-20mrt-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"longread","nid":857,"slug":"/artikelen/uit-de-tijdcapsule-stromae-overstijgt-effenaar-met-sterk-gechoreografeerd-spektakel","endpoint":"/nl/artikelen/uit-de-tijdcapsule-stromae-overstijgt-effenaar-met-sterk-gechoreografeerd-spektakel","translations":{"nl":"/artikelen/uit-de-tijdcapsule-stromae-overstijgt-effenaar-met-sterk-gechoreografeerd-spektakel","en":null},"title":"Uit de tijdcapsule: Stromae overstijgt Effenaar met sterk gechoreografeerd spektakel ","content":"\u003cp\u003eHet was de eerste en ook meteen de laatste keer, dat je Stromae zo intiem in Eindhoven kon bewonderen. Op 24 januari 2014 speelt de Belgische zanger in een uitverkochte Effenaar, om nog geen 6 maanden later Ziggo Dome tweemaal tot de nok toe te vullen. Vandaag is het precies tien jaar geleden dat Stromae Effenaar uit haar voegen speelde met een spectaculaire show. Een formidabel moment voor \u003cem\u003eun rétrospective\u003c/em\u003e. \u003c/p\u003e\r\n","meta":{"title":"Uit de tijdcapsule: Stromae overstijgt Effenaar met sterk gechoreografeerd spektakel ","description":"Lees hier de hele terugblik.","image":{"image":{"alt":"Stromae","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/Stromaeheader.jpeg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/Stromaeheader.jpeg?itok=Ta5BgAQU","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/Stromaeheader.jpeg?itok=kRhSkbHa","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/Stromaeheader.jpeg?itok=NxhR514l","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/Stromaeheader.jpeg?itok=RKQPGKRj","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/Stromaeheader.jpeg?itok=NjfJ9n-7","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/Stromaeheader.jpeg?itok=TZOM_0V5"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/Stromaeheader.jpeg?itok=Ta5BgAQU 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/Stromaeheader.jpeg?itok=kRhSkbHa 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/Stromaeheader.jpeg?itok=NxhR514l 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/Stromaeheader.jpeg?itok=RKQPGKRj 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/Stromaeheader.jpeg?itok=NjfJ9n-7 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/Stromaeheader.jpeg?itok=TZOM_0V5 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1706089698,"machine":"2024-01-24T09:48:18+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Stromae","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/Stromaeheader.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/Stromaeheader.png?itok=4Cq3V6Hb","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/Stromaeheader.png?itok=EP9EgPgd","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/Stromaeheader.png?itok=pV9L9rc1","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/Stromaeheader.png?itok=8XgBE6XC","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/Stromaeheader.png?itok=fDHgriMy","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/Stromaeheader.png?itok=FQgK8x0k"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/Stromaeheader.png?itok=4Cq3V6Hb 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/Stromaeheader.png?itok=EP9EgPgd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/Stromaeheader.png?itok=pV9L9rc1 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/Stromaeheader.png?itok=8XgBE6XC 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/Stromaeheader.png?itok=fDHgriMy 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/Stromaeheader.png?itok=FQgK8x0k 720w"]},"source":null,"source_link":null},"breadcrumb":null,"blocks":[{"type":"paragraph","id":"b3b6a0a4-6300-425a-bada-43bae36b5ef3","header":{"title":null},"content":{"content":"\u003cp\u003eIn 2010 bereikt de zomerse track 'Alors On Danse' van Stromae onze landsgrenzen. Het is de eerste grote hit van het muzikale alter ego van de Rwandees-Belgische Paul van Haver, waarmee hij op dat moment al nummer één-posities heeft behaald in België, Frankrijk en Duitsland. En in Nederland doet hij dit nogmaals dunnetjes over. De dansbare single van onze zuiderbuur staat maar liefst 8 weken lang bovenaan in de hitlijsten.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"e615a50a-87d1-4ba0-aef3-496e84d303d3","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/track/2GYHyAoLWpkxLVa4oYTVko?utm_source=generator\" width=\"100%\" height=\"152\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"d6a2e244-f132-44c0-bee1-4338584343ea","header":{"title":null},"content":{"content":"\u003cp\u003eNa de release van zijn debuutalbum 'Cheese', waarop de grote hit te vinden is, wordt het in Nederland weer wat stiller rondom de zanger. Maar een zomerse one-hit-wonder blijkt niets dan minder waar, wanneer hij drie jaar later de levensveranderende opvolgende plaat 'Racine carrée (2013)' uitbrengt. Met zijn single 'Papaoutai' is de Franstalige muzikant terug van weggeweest. Zijn tweede studioalbum brengt uiteindelijk maar liefst vier hits voort die overuren draaien op de ether; 'Papaoutai', 'Formidable', 'Tous Les Mêmes' en 'Ta Fête'.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"fe3769c5-4852-4c97-b4e5-40296560fc0b","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/6uyslsVGFsHKzdGUosFwBM?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"68685c17-5165-4e48-a320-7e1ce238a0c7","header":{"title":null},"content":{"content":"\u003cp\u003e\"In Nederland was het eerder eigenlijk alleen het hitje 'Alors On Danse'. Hij had toen nog niet echt een artiestenprofiel. Mensen wisten niet echt goed wie hij was. Bij de tweede plaat veranderde dat. Het sprak ineens een veel breder publiek aan, van jong tot oud\", blikt MOJO-boeker Hidde Pluymert terug, die al vanaf het begin betrokken is bij de artiest.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"e0795743-66dc-4511-818e-09ded7c5df35","header":{"title":"Op stoom"},"content":{"content":"\u003cp\u003eEind 2013 komt Stromae dan echt in een stroomversnelling. Op 21 december 2013 speelt hij zijn allereerste clubshow in Nederland in een uitverkochte Melkweg. Door de snelheid waarmee de tickets over de toonbank vliegen, worden er nog twee shows bijgeboekt in TivoliVredenburg en Effenaar. De drie clubshows hebben nog niet eens plaatsgevonden en ook Heineken Music Hall, inmiddels omgedoopt tot AFAS Live, wordt toegevoegd aan de lijst.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"063423f7-5b5f-47d2-b962-c1b84be85e76","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Stromae","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/effenaar_stromae_web_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/effenaar_stromae_web_0.png?itok=qpt8OicM","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/effenaar_stromae_web_0.png?itok=FiDYaV9_","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/effenaar_stromae_web_0.png?itok=vky9d_G0","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/effenaar_stromae_web_0.png?itok=J9iNnH_-","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/effenaar_stromae_web_0.png?itok=C2PgMCe8","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/effenaar_stromae_web_0.png?itok=ddVjhsi9"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/effenaar_stromae_web_0.png?itok=qpt8OicM 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/effenaar_stromae_web_0.png?itok=FiDYaV9_ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/effenaar_stromae_web_0.png?itok=vky9d_G0 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/effenaar_stromae_web_0.png?itok=J9iNnH_- 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/effenaar_stromae_web_0.png?itok=C2PgMCe8 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/effenaar_stromae_web_0.png?itok=ddVjhsi9 720w"]},"source":null,"source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"29118b64-d5bb-4938-8635-07e07995b717","header":{"title":null},"content":{"content":"\u003cp\u003eDoordat Stromae in enkele landen, waaronder Nederland, populair wordt, maar in andere landen nog niet zo ver is, is het voor hem mogelijk om op dat moment nog al zijn energie te stoppen in het winnen van populariteit in Nederland. Die beschikbaarheid en flexibiliteit is een onderdeel van waarom hij zo snel zo succesvol kon worden, volgens Pluymert. \"Het groeide zo snel dat je het bijna niet kon bijhouden. We hebben steeds nieuwe plannen gemaakt. Ergens voor die drie concerten ontplofte het totaal. Toen de shows eenmaal plaatsvonden was hij eigenlijk al best wel een ster.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"18165a3c-cade-4577-ad2e-5eccecaa9709","header":{"title":null},"content":{"content":"\u003cp\u003eEn dat blijkt ook wel uit het onthaal van het Eindhovens Dagblad, vertelt muziekjournalist Niels Guns die toentertijd namens die krant aanwezig is geweest bij het concert. \"We hebben hem toen in de middag al gefilmd in de Dommelstraat. Iets in de trant van 'Stromae gespot in de stad'. Dat toont wel aan wat voor status hij al had. Dat doen ze echt niet met iedere artiest die in Effenaar speelt.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"109d06d0-7499-4833-917a-79af9a248e61","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/U-ioexXOv5k?si=W1iwVT3WSuxQT9LX\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"3911b770-3cae-47f4-bca5-12f5091314bf","header":{"title":"De definitie van een show"},"content":{"content":"\u003cp\u003eDe show in Effenaar is stijf uitverkocht. In aanloop naar het concert doen liefhebbers met smekende oproepjes via Facebook nog verwoede pogingen om aan tickets te komen. Op de dag zelf zitten in de middag de eerste fans al aan de deur en naarmate de tijd verstrijkt vormt er zich ruim voor aanvang van de show een rij tot ver in de Dommelstraat.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eOm 20.00 uur gaat het licht uit en de spot aan, het is showtime. Op het doek wordt een animatie getoond van Stromae die een stormachtige weg aflegt. Dan wordt het compleet donker, en zodra het licht weer aangaat staat daar ineens Stromae, gehuld in zijn bekende gestileerde outfit en strik. Waarna hij vervolgens het concert vol gas aftrapt met de hit 'Ta Fête'.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"ae580025-12f6-438a-b390-5676c4d9851e","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/NcoEU0DnaSM?si=XojSnz7AR_pmedA2\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"d8a9b2e4-70df-4c24-8258-5e4b418a37b4","header":{"title":null},"content":{"content":"\u003cp\u003eDe ED-recensent heeft veel shows gezien in Effenaar, maar van best wel wat concerten kan hij zich niet meer zoveel herinneren. \"Dit concert heeft echt een sterk beeld achtergelaten. Hij had veel grotere zalen kunnen spelen. Dat voelde je ook echt. Je wist; 'over een half jaar komt hij niet meer terug.' Hij pakte de zaal echt helemaal in. Het was echt een goede show.\"\u0026nbsp;\u003cbr /\u003e\r\n\u0026nbsp;\u003cbr /\u003e\r\nDe Belgische zanger staat niet alleen op het podium, maar wordt vergezeld door enkele bandleden die zich vanachter verlichte desks ontfermen over de muziek. \"De bandleden waren wel echt duidelijk de secondanten. Ze hadden precies dezelfde kleding aan en een bolhoedje op.\" Wanneer het nummer 'Papaoutai' voorbijkomt op de setlist, moeten de drie muzikanten ook even fysiek aan de bak. Bij aanvang van de track wordt Stromae als een pop, zoals in de muziekclip, het podium opgetild. \"Het was allemaal tot in de puntjes verzorgd, zonder dat het vervelend was. Soms mis je dan spontaniteit, maar dat was hierbij niet. Het was gewoon heel professioneel en goed.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"7fbeb875-5b3e-44e7-a1a1-0333f91567de","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/IfLkX1Gd_7w?si=Wh4YhEXDaEwzdUY4\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"ad407f6c-f93a-4bee-93ed-488aa743a98f","header":{"title":null},"content":{"content":"\u003cp\u003eStromae speelt de Grote Zaal van Effenaar die avond compleet uit haar voegen met zijn strak geregisseerde show vol dans, visuals en zijn bekende hits. Dat de show te groot voelde voor het podium is niet vreemd vindt de MOJO-boeker. \"In België en Frankrijk speelde hij al in veel grotere zalen en op behoorlijke festivals. De show die was gecreëerd, was gemaakt voor een groter publiek. Deze productie is vervolgens ook gebruikt tijdens de kleinere clubshows in Nederland.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"77a79e75-6534-4d5c-87c0-001a32abf3f0","header":{"title":"Taaloverstijgend "},"content":{"content":"\u003cp\u003eMet zijn dansbare tracks krijgt Stromae het publiek compleet mee. Iets wat gezien zijn geheel Franstalige oeuvre toch vrij uniek is. \"Elk nummer is een verhaal met een eigen visuele identiteit. Zijn show is half theater, half muziek. En dat ziet er zo goed uit, dat daarmee de taalbarrière geslecht wordt.\"\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eOok muziekjournalist Guns ervaart dit met de muziek van Stromae. \"Het is inderdaad heel bijzonder, want zoveel Franse hits heb je hier niet. Hij zingt heel melodieus en is vooral ritmisch heel erg goed. Hierdoor vergeet je bijna de taal. Ik denk ook wel dat dit zijn kracht is, dat doet hij heel knap. Hoe hij zingt is bijna een soort van instrument.\" Hierdoor is de emotie in zijn nummers voelbaar. Want hoewel deze vaak catchy en dansbaar zijn, schuilen er in de teksten beladen onderwerpen als een absente vader, liefdesverdriet en stress.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"057b83e8-c260-4aed-bd4f-d3bc02afde52","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Stromae","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/Stromaehandtekening_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/Stromaehandtekening_0.png?itok=8X_g3IGJ","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/Stromaehandtekening_0.png?itok=VowE2vIY","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/Stromaehandtekening_0.png?itok=22x7cSMr","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/Stromaehandtekening_0.png?itok=qSHC-AAb","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/Stromaehandtekening_0.png?itok=a7QloWex","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/Stromaehandtekening_0.png?itok=vcpCmleH"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/Stromaehandtekening_0.png?itok=8X_g3IGJ 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/Stromaehandtekening_0.png?itok=VowE2vIY 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/Stromaehandtekening_0.png?itok=22x7cSMr 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/Stromaehandtekening_0.png?itok=qSHC-AAb 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/Stromaehandtekening_0.png?itok=a7QloWex 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/Stromaehandtekening_0.png?itok=vcpCmleH 720w"]},"source":"Foto: Nonja de Roo | Stromae na show in Effenaar","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"50f6f896-8ac8-4d6a-82cd-62b7b67449ee","header":{"title":"Toch nog oog in oog met de maestro"},"content":{"content":"\u003cp\u003eNa op het podium alles te hebben gegeven, neemt Stromae nog de tijd om fans te voorzien van een handtekening. Waaronder – onze inmiddels huisfotograaf – Nonja de Roo. Doordat de show zo snel uitverkocht was, had ze helaas geen ticket kunnen scoren. \"Ik was groot fan van Stromae toentertijd. Toen bedacht ik het volgende: Ik ga net zo lang wachten tot hij na de show naar buiten komt om te vragen of hij mijn zelfgemaakte tekening wil signeren.\"\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eNa een uurtje wachten komt de charmante zanger dan eindelijk naar buiten. De Roo ontving als één van de eerste een handtekening, en dat op haar zelfgemaakte tekening. \"Hij vond hem erg mooi en schreef 'Merci, Stromae'. Ondanks dat ik niet bij het concert kon zijn, was dit wel een hele bijzondere ervaring. De tekening hangt nog steeds op een mooie plek in huis. Een mooie herinnering aan een bijzonder moment!\"\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"8b53ec91-9de3-44f2-aa46-cd58045ba35b","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Stromae Effenaar","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/IMG_20140228_110210_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/IMG_20140228_110210_0.png?itok=lKxgvQEk","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/IMG_20140228_110210_0.png?itok=af7NHkA-","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/IMG_20140228_110210_0.png?itok=yeoIY7kI","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/IMG_20140228_110210_0.png?itok=vgQZ50o3","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/IMG_20140228_110210_0.png?itok=vOo5B8Fl","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/IMG_20140228_110210_0.png?itok=JoUpSeq5"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/IMG_20140228_110210_0.png?itok=lKxgvQEk 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/IMG_20140228_110210_0.png?itok=af7NHkA- 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/IMG_20140228_110210_0.png?itok=yeoIY7kI 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/IMG_20140228_110210_0.png?itok=vgQZ50o3 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/IMG_20140228_110210_0.png?itok=vOo5B8Fl 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/IMG_20140228_110210_0.png?itok=JoUpSeq5 720w"]},"source":"Afbeelding: Tekening Nonja de Roo, gesigneerd door Stromae","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"477eff40-5e93-46ab-b9ab-4531d7787a36","header":{"title":"Een wereldster"},"content":{"content":"\u003cp\u003e\"‘Uitverkocht’ is een woord dat in 2014 waarschijnlijk vaak in een adem met de artiestennaam Stromae genoemd zal worden\", schrijft Guns in zijn recensie na het concert in Effenaar. En niets blijkt minder waar. In april staat Stromae in een uitverkochte Heineken Music Hall, en in juni verkopen zijn Ziggo Dome shows die in november 2014 gaan plaatsvinden al uit. \"Ik wou bijna zeggen dat hij nog een wereldster in wording was, maar dat was hij in Effenaar eigenlijk al. En dat is natuurlijk alleen maar groter geworden.\"\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eElke keer wanneer Stromae optreedt, wordt hij groter en groter. \"Wat ik er bijzonder aan vond is dat het ook alleen maar beter werd. Vaak zeggen mensen 'ik ben blij dat ik het toen nog in een kleine zaal heb gezien.' Maar deze show werd beter, des te groter de zalen werden\", concludeert Pluymert.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"0a05e72e-1676-4923-b1c8-da63e409c278","header":{"title":"De keerzijde van succes "},"content":{"content":"\u003cp\u003eDe enorme voortgang in zijn carrière dat jaar is voor Stromae als een cadeautje, maar ook erg overweldigend. Dit laat de artiest al voor het concert in Effenaar doorschemeren tijdens een interview met Guns. \"Het gesprek met hem is mij wel bijgebleven. Hij vertelde over het afgelopen jaar, want 2013 was echt zijn doorbraakjaar. Dat was aan de ene kant natuurlijk fantastisch, maar ook erg pittig. Iedereen herkende hem of wilde iets van hem. Op het moment dat ik hem sprak, stond hij in Frankrijk met drie nummers in de top vijf. Hij was echt opeens een megaster. Het was duidelijk dat hij dat toen allemaal nog echt een plekje moest geven.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"12cb7fcd-e8dc-4035-8095-95b6360dbed8","header":{"title":null},"content":{"content":"\u003cp\u003eHij vertelt de muziekjournalist dat hij daarom expres op vakantie is geweest naar Bolivia, omdat hij daar nog niet bekend was. Zo kon hij eventjes echt weg zijn en weer even Paul van Haver zijn. \"Ook vertelde hij dat hij aan het einde van het jaar altijd heel bewust terugblikt op alles wat er is gebeurd, en hoe dat nou eigenlijk voelt. Maar die Oudejaarsavond had hij er geen tijd voor gehad, hij had zelf een show. Terwijl het eigenlijk juist een jaar was waarin hij superveel had meegemaakt en die reflectie wellicht extra nodig had.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"f1e5d542-0d2e-4978-a951-28887a176221","header":{"title":null},"content":{"content":"\u003cp\u003eIn 2014 ploegt de zanger keihard door met zijn uitverkochte shows en optredens op Lowlands en Pinkpop. Meer dan terecht volgens Guns, want Stromae is hartstikke goed. \"Niet veel later is hij best wel een tijdje uit de running geweest en heeft hij echt even afstand genomen van zijn artiestenbestaan. Ik weet niet waar dat precies mee te maken had. Maar toen ik het hoorde verbaasde me dat in ieder geval niet. Hij voelde naar mijn idee toen al de keerzijde ervan.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"ccf1d206-04ef-42f2-967c-b96ae362ded2","header":{"title":"Onvergetelijke rentree "},"content":{"content":"\u003cp\u003eNa acht jaar te zijn weggeweest van de spotlights, \u003ca href=\"https://www.youtube.com/watch?v=YAG6nj7Sff8\" target=\"_blank\"\u003emaakt Stromae in 2022 zijn comeback met een sensationeel televisieoptreden op de Franse zender TF1, waar hij wordt geinterviewd over zijn nieuwe album 'Multitude'\u003c/a\u003e. Daar zingt hij als stunt zijn nummer 'L'Enfer' live tijdens het journaal. \"Dat was een hele creatieve manier van de aandacht op zich vestigen. Dat was echt super goed gedaan en uitgedacht. Dat is precies waar hij goed in is en waarom mensen hem niet vergeten. Zijn shows zijn altijd zo'n sterke ervaring. Dat blijft wel hangen\", vertelt zijn boeker. Ook in Nederland komt hij langs voor een sterke performance in het programma Mathijs Gaat Door. En zelfs na zoveel jaren, trekt Stromae nog met gemak de grootste zalen vol.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"90e25a53-ae0a-44b6-8113-b780f9ecbfdb","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/1g4xRBNiPOo?si=sjj3QMpLRfUN5fCQ\u0026amp;start=7\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"006f5c2f-1e7d-48bd-ac06-046d2e3fb1b0","header":{"title":null},"content":{"content":"\u003cp\u003eMomenteel is het weer even stil rondom de zanger. Maar wanneer hij weer klaar is voor een rentree, gebeurt dat vast en zeker weer met net zo veel creativiteit en show. \"Deze man is gewoon ongelooflijk goed. Hij heeft niet alleen talent of perfectionisme, het wordt gewoon heel goed gestileerd. Ze laten niets aan toeval over. Het wordt zo gedaan, dat het niet anders dan succesvol kan zijn. In dit geval overwint kwaliteit.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"cta","id":"85124b76-0690-4ab2-bb4d-dbbfdd852fe1","header":{"title":"Meer lezen?","description":null},"content":{"cta_title":"Uit de tijdcapsule: Pearl Jam ontwapenend met debuutalbum Ten in Effenaar","cta_description":null,"url":{"uri":"https://www.effenaar.nl/nl/artikelen/uit-de-tijdcapsule-pearl-jam-ontwapenend-met-debuutalbum-ten-effenaar","title":"Lees hier het artikel","options":{"url":"https://www.effenaar.nl/nl/artikelen/uit-de-tijdcapsule-pearl-jam-ontwapenend-met-debuutalbum-ten-effenaar"}},"description":null,"title":"Meer lezen?"}},{"type":"cta","id":"346b0e05-f208-47b1-b24d-e7f85312db01","header":{"title":null,"description":null},"content":{"cta_title":"Uit de tijdcapsule: Red Hot Chili Peppers onbevangen, naakt en op stoom in Effenaar","cta_description":null,"url":{"uri":"https://www.effenaar.nl/nl/artikelen/uit-de-tijdcapsule-red-hot-chili-peppers-ambitieus-naakt-en-op-stoom-effenaar","title":"Lees hier het artikel","options":{"url":"https://www.effenaar.nl/nl/artikelen/uit-de-tijdcapsule-red-hot-chili-peppers-ambitieus-naakt-en-op-stoom-effenaar"}},"description":null,"title":null}},{"type":"cta","id":"26583c8a-c0cb-4f32-a4c2-76d99b4d653d","header":{"title":null,"description":null},"content":{"cta_title":null,"cta_description":null,"url":{"uri":"https://www.effenaar.nl/spaces","title":"Lees hier alle Spaces-artikelen","options":{"url":"https://www.effenaar.nl/spaces"}},"description":null,"title":null}}],"subtitle":"Door Roeline Machiels","thumbnail_image":{"image":{"alt":"Stromae","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/effenaar_stromae_thumb.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/effenaar_stromae_thumb.png?itok=gFI2UiPU","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/effenaar_stromae_thumb.png?itok=xpyfJ4ef","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/effenaar_stromae_thumb.png?itok=EYkiMYOl","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/effenaar_stromae_thumb.png?itok=coo_7Y-o","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/effenaar_stromae_thumb.png?itok=2SF_Mie8","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/effenaar_stromae_thumb.png?itok=tAIqVqkP"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/effenaar_stromae_thumb.png?itok=gFI2UiPU 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/effenaar_stromae_thumb.png?itok=xpyfJ4ef 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/effenaar_stromae_thumb.png?itok=EYkiMYOl 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/effenaar_stromae_thumb.png?itok=coo_7Y-o 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/effenaar_stromae_thumb.png?itok=2SF_Mie8 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/effenaar_stromae_thumb.png?itok=tAIqVqkP 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#C4826A","background_color":"#F2E0D5","text_color":"#000000"},"tags":[],"related_events":[]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724592996,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"LongReads-uit-de-tijdcapsule-stromae-overstijgt-effenaar-met-sterk-gechoreografeerd-spektakel-nl","queryHash":"[\"LongReads-uit-de-tijdcapsule-stromae-overstijgt-effenaar-met-sterk-gechoreografeerd-spektakel-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1492,"slug":"/agenda/legends-rock-tribute-festival-xl","endpoint":"/nl/agenda/legends-rock-tribute-festival-xl","translations":{"nl":"/agenda/legends-rock-tribute-festival-xl","en":null},"title":"LEGENDS of ROCK Tribute Festival XL","content":"\u003cp\u003eNa vele succesvolle edities komt LEGENDS of ROCK Tribute Tour terug naar Effenaar met een spectaculaire Grunge/Punk/Rock-editie. Verdeeld over twee podia storten de No.1 tribute bands van Nirvana, Pearl Jam, Foo Fighters, Red Hot Chili Peppers, Muse, Linkin Park, Green Day en Soundgarden op indrukwekkend authentieke wijze alle grote hits en de beste albumsongs van hun muzikale helden over het publiek uit. Met dynamische lichtshows en special effects en in een perfecte ambiance zorgen deze top bands met passie en volle overgave voor een aaneenschakeling van dampende concerten en vele muzikale hoogtepunten. \u003c/p\u003e","meta":{"title":"LEGENDS of ROCK Tribute Festival XL","description":"","im