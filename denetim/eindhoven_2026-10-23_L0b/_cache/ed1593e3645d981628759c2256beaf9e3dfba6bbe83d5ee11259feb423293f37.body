E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=jnERAwSI","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=53ZPzPLd","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=mSGXhcmX","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=ENhTv3bO"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=wQV3Amn3 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=3DTeFfiU 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=jnERAwSI 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=53ZPzPLd 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=mSGXhcmX 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-07/%20%E2%80%93%20Square%20afbeelding%20onlyBLOF.png?itok=ENhTv3bO 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#dce0da","background_color":"#485b6d","text_color":"#FFFFFF"}}],"blocks":[{"type":"paragraph","id":"e0de08eb-3d9b-470c-94f3-de993f9df523","header":{"title":null},"content":{"content":"\u003cp\u003eGeen wonder dat de band elk podium bestormt en shows speelt alsof het hun laatste is. Meltheads brengt je aanstekelijke garage, slimme post-punk en (cold)wave schatplichtig aan The Chats, Amyl and the Sniffers, Gang of Four, Wire en - jawel - De Brassers en Aroma Di Amore. Op zaterdag 9 maart zie je ze in het Stroomhuis.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"34907b26-2520-456d-965d-79330fe6e2d8","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19.30 uur: Deuren open\u003cbr /\u003e\r\n20.00 uur: Show Wasted Youth Club\u003cbr /\u003e\r\n21:00 uur: Show Purrses\u003cbr /\u003e\r\n22.00 uur: Show Meltheads\u003cbr /\u003e\r\n(tijden zijn onder voorbehoud)\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_quote","id":"87579fb9-7f1b-4b1e-b0cc-c57583b984ca","header":{"title":null,"description":null},"content":{"quote":"In de Club kregen we een waanzinnige set voorgeschoteld die zonder blozen deed denken aan opkomende rockbands in de 90’s. U zag Nirvana in de Vooruit? Wel, ik zag Meltheads op Rock Herk. Kan iemand voorspellen waar de top ligt?","author":"Humo over de show op Rock Herk"}},{"type":"embed","id":"1a77f28c-963e-4f02-b42f-b051c1c3428a","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/hhgPEt5jWXg?si=NxKO5MytWRiggjg7\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"19da3e9c-9618-4a39-a2be-fe2f152e3754","header":{"title":"Wasted Youth Club"},"content":{"content":"\u003cp\u003eDe vierkoppige Arnhemse Garageband Wasted Youth Club verzorgt de support voor Meltheads! Geïnspireerd door bands als FIDLAR, Together Pangea, Ty Segall en Bass Drum of Death maken ze muziek die klinkt zoals je dronken vette hap smaakt: vies lekker. Steek je huiswerk in de fik en schreeuw mee met nummers pakkender dan je lokale clublied. Wasted Youth Club is voor iedereen met een hartslag die wil ontsnappen aan de dagelijkse sleur. De rest is ook welkom.\u003c/p\u003e\r\n","image":{"image":{"alt":"Wasted Youth Club","src":"https://d12y285rxlbnxt.cloudfront.net/2024-02/Wasted%20Youth%20Club.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/Wasted%20Youth%20Club.png?itok=2zf7aW0X","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/Wasted%20Youth%20Club.png?itok=7ejrseY_","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/Wasted%20Youth%20Club.png?itok=GWA8WHt8","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/Wasted%20Youth%20Club.png?itok=oAN7vb3D","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/Wasted%20Youth%20Club.png?itok=FpDs45Yy","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/Wasted%20Youth%20Club.png?itok=M4EY9uUn"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/Wasted%20Youth%20Club.png?itok=2zf7aW0X 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/Wasted%20Youth%20Club.png?itok=7ejrseY_ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/Wasted%20Youth%20Club.png?itok=GWA8WHt8 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/Wasted%20Youth%20Club.png?itok=oAN7vb3D 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/Wasted%20Youth%20Club.png?itok=FpDs45Yy 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/Wasted%20Youth%20Club.png?itok=M4EY9uUn 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"52388952-7178-45d2-acd4-9caf3be408e9","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/UQeK6Eaww74?si=bug3C8pJDU32SD4e\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"803e4402-3d5f-48d6-8bc2-aa5fce0dff4b","header":{"title":"Purrses"},"content":{"content":"\u003cp\u003ePurrses banen zich een weg door de Brusselse rockscene met een verfrissende aanpak, waarbij ze alle genreclichés aan de kant schuiven. Het viertal brengt een mix van artrock met popaccenten, gekenmerkt door teksten die een fijne dosis naïef cynisme uitstralen. Bij Purrses draait alles om het combineren van rockenergie, soulvolle grooves en de melodische invloed van punk. Kleurrijk maar toch koud; de vier stemmen en verschillende persoonlijkheden binnen de band zijn perfect met elkaar verweven. Deze avond spelen ze de support voor Meltheads!\u003c/p\u003e\r\n\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"Purrses","src":"https://d12y285rxlbnxt.cloudfront.net/2024-03/purrses-promo%281%29.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-03/purrses-promo%281%29.jpg?itok=5PNys28t","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-03/purrses-promo%281%29.jpg?itok=EGBFFqs4","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-03/purrses-promo%281%29.jpg?itok=2mAsu9py","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-03/purrses-promo%281%29.jpg?itok=GHKxHvG7","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-03/purrses-promo%281%29.jpg?itok=2Y7xDIUK","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-03/purrses-promo%281%29.jpg?itok=S67D4kwJ"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-03/purrses-promo%281%29.jpg?itok=5PNys28t 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-03/purrses-promo%281%29.jpg?itok=EGBFFqs4 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-03/purrses-promo%281%29.jpg?itok=2mAsu9py 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-03/purrses-promo%281%29.jpg?itok=GHKxHvG7 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-03/purrses-promo%281%29.jpg?itok=2Y7xDIUK 480w","https://d12y285rxlbnxt.