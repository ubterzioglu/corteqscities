:"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-12/thecurethumb_0.png?itok=AzLZJdef"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-12/thecurethumb_0.png?itok=4vd4z-yU 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-12/thecurethumb_0.png?itok=EmzYclJL 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-12/thecurethumb_0.png?itok=VMg2oGBI 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-12/thecurethumb_0.png?itok=e2zNw3XP 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-12/thecurethumb_0.png?itok=J4LEFiOM 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-12/thecurethumb_0.png?itok=AzLZJdef 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#C6679F","background_color":"#404040","text_color":"#FFFFFF"},"tags":[],"related_events":[]}],"extra_stories":[{"type":"longread","nid":2037,"slug":"/artikelen/kaat-van-stralen-het-alsof-ik-de-vuurlinie-open-op-mezelf-ik-sta-vrij-schiet-maar","endpoint":"/nl/artikelen/kaat-van-stralen-het-alsof-ik-de-vuurlinie-open-op-mezelf-ik-sta-vrij-schiet-maar","translations":{"nl":"/artikelen/kaat-van-stralen-het-alsof-ik-de-vuurlinie-open-op-mezelf-ik-sta-vrij-schiet-maar","en":null},"title":"Kaat van Stralen: ‘Het is alsof ik de vuurlinie open op mezelf: ik sta vrij, schiet maar’","content":"\u003cp\u003eWat ooit begon als soloproject, is uitgegroeid tot een genre-overschrijdende punkband. Met het anthem ‘Stop Met Wenen’ zet Kaat van Stralen zich in 2023 op de kaart, en beukt sindsdien lekker door. Van een overvol Café Wilhelmina tijdens Hit The City en Misty Fields, tot Best Kept Secret en Pukkelpop; en nu tijd voor haar eigen clubtour. Op donderdag 26 november speelt ze in Effenaar. Maar eerst duiken we met haar in de diepte: over haar je-m’en-fous-attitude, de fucked up industrie, een laffe Ed Sheeran en een wervelwind van een jaar. \u003c/p\u003e","meta":{"title":"Kaat van Stralen: ‘Het is alsof ik de vuurlinie open op mezelf: ik sta vrij, schiet maar’","description":"Lees het interview met Kaat van Stralen op het platform van Effenaar.","image":null},"publish_date":{"timestamp":1792407470,"machine":"2026-10-19T10:57:50+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Kaat van Stralen","src":"https://d12y285rxlbnxt.cloudfront.net/2026-10/headerweb.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-10/headerweb.png?itok=AUBQxYL_","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-10/headerweb.png?itok=AMxg26EB","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-10/headerweb.png?itok=JA1Llwlt","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-10/headerweb.png?itok=7LeP_Fgh","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-10/headerweb.png?itok=jSLY-Hx6","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-10/headerweb.png?itok=dR_DLLPc"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-10/headerweb.png?itok=AUBQxYL_ 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-10/headerweb.png?itok=AMxg26EB 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-10/headerweb.png?itok=JA1Llwlt 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-10/headerweb.png?itok=7LeP_Fgh 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-10/headerweb.png?itok=jSLY-Hx6 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-10/headerweb.png?itok=dR_DLLPc 720w"]},"source":"Foto: Moenia Ladhib","source_link":null},"breadcrumb":null,"subtitle":"Door Lola Heijdt","thumbnail_image":{"image":{"alt":"Kaat van Stralen","src":"https://d12y285rxlbnxt.cloudfront.net/2026-10/Kaatvanstralenthumb.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-10/Kaatvanstralenthumb.png?itok=cytQX9e_","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-10/Kaatvanstralenthumb.png?itok=XBTk0GWl","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-10/Kaatvanstralenthumb.png?itok=USqLqRzv","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-10/Kaatvanstralenthumb.png?itok=rxXZIl8Y","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-10/Kaatvanstralenthumb.png?itok=Ow6-XEFw","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-10/Kaatvanstralenthumb.png?itok=4i3v7NJQ"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-10/Kaatvanstralenthumb.png?itok=cytQX9e_ 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-10/Kaatvanstralenthumb.png?itok=XBTk0GWl 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-10/Kaatvanstralenthumb.png?itok=USqLqRzv 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-10/Kaatvanstralenthumb.png?itok=rxXZIl8Y 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-10/Kaatvanstralenthumb.png?itok=Ow6-XEFw 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-10/Kaatvanstralenthumb.png?itok=4i3v7NJQ 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#073642","background_color":"#C3CAD8","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":2019,"slug":"/artikelen/achter-de-plaat-met-young-giant-je-moet-hoop-en-optimisme-hebben-deze-fucked-wereld","endpoint":"/nl/artikelen/achter-de-plaat-met-young-giant-je-moet-hoop-en-optimisme-hebben-deze-fucked-wereld","translations":{"nl":"/artikelen/achter-de-plaat-met-young-giant-je-moet-hoop-en-optimisme-hebben-deze-fucked-wereld","en":null},"title":"Achter de plaat met Young The Giant: 'Je moet hoop en optimisme hebben in deze fucked up wereld' ","content":"\u003cp\u003eMy Body, Apartment, Cough Syrup, Mind Over Matter; het zijn de hits waar Young The Giant de wereld mee veroverde. De Amerikaanse band heeft inmiddels zes full-lenght platen op zijn naam staan, waarvan de laatste afgelopen voorjaar het levenslicht zag. Op woensdag 14 oktober trakteert Young The Giant in de Grote Zaal op bekende hits én de nieuwe anthems van het album Victory Garden. Maar eerst duiken we met bandlid Payam Doostzadeh in de verhalen achter de plaat; van schrijven in de woestijn tot Queen, en van de leugens van het Witte Huis tot hoopvolle anthems. \u003c/p\u003e","meta":{"title":"Achter de plaat met Young The Giant: 'Je moet hoop en optimisme hebben in deze fucked up wereld' ","description":"Young The Giant over hoopvolle anthems, een ode aan Queen en de white lies uit het Witte Huis. ","image":null},"publish_date":{"timestamp":1790768714,"machine":"2026-09-30T11:45:14+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Young The Giant","src":"https://d12y285rxlbnxt.cloudfront.net/2026-09/YoungTheGiant_Lupe%20Bustos.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=hS5w0zVk","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=UZ5we8tM","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=wo2GIS2m","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=yhRWD8Wl","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=PerCSDI_","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=9K-P0kJr"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=hS5w0zVk 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=UZ5we8tM 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=wo2GIS2m 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=yhRWD8Wl 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=PerCSDI_ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-09/YoungTheGiant_Lupe%20Bustos.png?itok=9K-P0kJr 720w"]},"source":"Foto: Lupe Bustos | v.l.n.r. Eric Cannata, Payam Doostzadeh, Jacob Tilley, Sameer Gadhia en François Comtois","source_link":null},"breadcrumb":null,"subtitle":"Door Roeline Machiels","thumbnail_image":{"image":{"alt":"Young The Giant","src":"https://d12y285rxlbnxt.cloudfront.net/2026-09/thumbweb_1.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-09/thumbweb_1.png?itok=vdOM2YTh","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-09/thumbweb_1.png?itok=7_NBpjn7","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-09/thumbweb_1.png?itok=ODjaanu9","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-09/thumbweb_1.png?itok=oORW0adl","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-09/thumbweb_1.png?itok=-EFuVgEM","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-09/thumbweb_1.png?itok=ohdhrcaa"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-09/thumbweb_1.png?itok=vdOM2YTh 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-09/thumbweb_1.png?itok=7_NBpjn7 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-09/thumbweb_1.png?itok=ODjaanu9 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-09/thumbweb_1.png?itok=oORW0adl 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-09/thumbweb_1.png?itok=-EFuVgEM 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-09/thumbweb_1.png?itok=ohdhrcaa 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#657430","background_color":"#F1E8D4","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":2001,"slug":"/artikelen/hoofdprogrammeur-robert-schaeffer-viert-30-jaar-bij-effenaar-ik-ben-wel-trots-dat-zij","endpoint":"/nl/artikelen/hoofdprogrammeur-robert-schaeffer-viert-30-jaar-bij-effenaar-ik-ben-wel-trots-dat-zij","translations":{"nl":"/artikelen/hoofdprogrammeur-robert-schaeffer-viert-30-jaar-bij-effenaar-ik-ben-wel-trots-dat-zij","en":null},"title":"Hoofdprogrammeur Robert Schaeffer viert 30 jaar bij Effenaar: “Ik ben wel trots dat zij hier hebben gespeeld”","content":"\u003cp\u003eOp de middelbare school liet hij muziek vallen, omdat je er ‘toch niets mee kon’. Maar dit jaar viert hoofdprogrammeur Robert Schaeffer zijn 30-jarig jubileum bij Effenaar. Als student stapte hij ooit binnen als vrijwilliger, maar inmiddels boekt hij al decennia het programma rond. In zijn tijd als hoofdprogrammeur hebben namen als Queens Of The Stone Age, Turnstile, Stromae, Editors en Slowdive opgetreden in Eindhoven. Hoewel hij zelf niet graag in de schijnwerpers staat, kan hij ‘uren lullen’ over zijn passie. En laat dit er eens een uitgelezen moment voor zijn. Van zijn start tot kroonboeking, en van kweekvijver tot zijn ideale Effenaar; Schaeffer neemt je mee door zijn bijzondere tijd in het vak.\u003c/p\u003e","meta":{"title":"“Ik ben wel trots dat zij hier hebben gespeeld”","description":"Hoofdprogrammeur Robert Schaeffer viert 30 jaar bij Effenaar.","image":null},"publish_date":{"timestamp":1788953617,"machine":"2026-09-09T11:33:37+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Robert Schaeffer","src":"https://d12y285rxlbnxt.cloudfront.net/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=guC5kOdq","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=XZbMGAWZ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=JQnWT-1-","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=irz3_YX-","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=2tiYkwb1","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=G8qk0bDl"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=guC5kOdq 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=XZbMGAWZ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=JQnWT-1- 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=irz3_YX- 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=2tiYkwb1 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-09/20260826_RobertSchaeffer_MaxKneefel_YKN9714_.png?itok=G8qk0bDl 720w"]},"source":"Foto: Max Kneefel","source_link":null},"breadcrumb":null,"subtitle":"Door Zoran Bogdanovic","thumbnail_image":{"image":{"alt":"Robert Schaeffer","src":"https://d12y285rxlbnxt.cloudfront.net/2026-09/thumbweb.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-09/thumbweb.png?itok=OOh0hN78","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-09/thumbweb.png?itok=mPTItS99","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-09/thumbweb.png?itok=lLFYR1iW","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-09/thumbweb.png?itok=mxaEBuOT","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-09/thumbweb.png?itok=N5Undcei","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-09/thumbweb.png?itok=1eRMZW2R"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-09/thumbweb.png?itok=OOh0hN78 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-09/thumbweb.png?itok=mPTItS99 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-09/thumbweb.png?itok=lLFYR1iW 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-09/thumbweb.png?itok=mxaEBuOT 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-09/thumbweb.png?itok=N5Undcei 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-09/thumbweb.png?itok=1eRMZW2R 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#013E7F","background_color":"#EDE7D2","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":1904,"slug":"/artikelen/achter-de-plaat-met-merol-radicale-eerlijkheid-tietenharnassen-en-een-uitstekende-kut","endpoint":"/nl/artikelen/achter-de-plaat-met-merol-radicale-eerlijkheid-tietenharnassen-en-een-uitstekende-kut","translations":{"nl":"/artikelen/achter-de-plaat-met-merol-radicale-eerlijkheid-tietenharnassen-en-een-uitstekende-kut","en":null},"title":"Achter de plaat met MEROL: Radicale eerlijkheid, tietenharnassen en een uitstekende kut ","content":"\u003cp\u003eOp vrijdag 20 november zet Nederlands popicoon MEROL onze Grote Zaal op z'n kop. En dat ook nog eens met een nieuwe plaat op zak. Op 1 mei zag \u003cem\u003eLeve De Feeks\u003c/em\u003e het levenslicht; waarop ze de schaamte voorbijgaat. Schurend, eerlijk en super kwetsbaar. Een mooi moment om met MEROL in haar verse tracks en de verhalen daarachter te duiken; van inspiratie uit boeken tot een tietenharnas met super soakers, en van rauwe kwetsbaarheid tot een uitstekende kut.\u003c/p\u003e","meta":{"title":"Achter de plaat met MEROL: Radicale eerlijkheid, tietenharnassen en een uitstekende kut ","description":"Lees hier het interview. ","image":null},"publish_date":{"timestamp":1779095247,"mach