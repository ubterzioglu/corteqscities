11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"13418c84-06ee-4401-9bec-20a6f1712410","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:30 uur: Deuren open\u003cbr /\u003e\r\n20:15 uur: Show Ghostwoman\u003cbr /\u003e\r\n21:15 uur: Show Dinosaur Jr.\u0026nbsp;\u003cbr /\u003e\r\n(tijden onder voorbehoud)\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"d631b9e5-1baf-4603-a5e5-275d4eaba10b","header":{"title":"Feel The Pain "},"content":{"content":"\u003cp\u003eZe hebben ontelbaar veel bands beïnvloed, zoals Nirvana, Radiohead, Pixies en The Smashing Pumpkins. Hun geluid is onmiskenbaar. Dat ze liedjes maken die in je geheugen gegrift staan. \u0026nbsp;Klassiekers als Where You Been, Start Choppin’, What Else Is New, Feel The Pain en Freak Scene. En bovenal dat het een band is om te koesteren: stronteigenwijs, onafhankelijk, volgens een beproefd recept en toch altijd verrassend. Wat hadden we toch eigenlijk gemoeten zonder de muziek van Dinosaur Jr. in ons leven? We slaken een zucht van verlichting dat ze er zijn. En dat ze naar BRIDGE komen dit jaar!\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"5551bc62-e286-4bcd-9510-798f5ff73de2","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/artist/267VY6GX5LyU5c9M85ECZQ?utm_source=generator\u0026theme=0\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"e0630784-cb1b-4f8e-a3f2-3859bd663bae","header":{"title":"Support: GHOSTWOMAN"},"content":{"content":"\u003cp\u003eGHOSTWOMAN maakte vorig jaar een fantastisch goede beurt in Lab-1 tijdens BRIDGE. Met hun nieuwe album ‘Hindsight Is 50/50’ op zak is het reden te meer ze wederom uit te nodigen, dit keer als support van Dinosaur Jr. GHOSTWOMAN is ontsproten uit het brein van Canadees Evan Uschenko, die je misschien kent uit de band van Michael Rault. GHOSTWOMAN-vernoemd naar het nummer ‘Ghost Woman Blues ‘van George Carter- maakt psychedelische, krauterige garagerocksongs die verrassend puntig zijn.\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"GHOSTWOMAN","src":"https://d12y285rxlbnxt.cloudfront.net/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=v51g2Oyn","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=QwKPw-iY","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=Mwj1Pz47","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=FDJHZ_UP","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=Nn6-Px7r","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=jJInSd-W"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=v51g2Oyn 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=QwKPw-iY 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=Mwj1Pz47 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=FDJHZ_UP 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=Nn6-Px7r 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/GW_promo_portrait_toon%20persyn%20PNG.png?itok=jJInSd-W 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"effenaar_image","id":"dd0382a7-ab2c-4f1a-8641-70a2f9fe854b","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Concertfuel","src":"https://d12y285rxlbnxt.cloudfront.net/2024-05/Concertfuel_servicemaildef.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/Concertfuel_servicemaildef.png?itok=rnRecR5m","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/Concertfuel_servicemaildef.png?itok=cqelbIh6","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/Concertfuel_servicemaildef.png?itok=qnRqqanO","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/Concertfuel_servicemaildef.png?itok=MBhYOCvO","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/Concertfuel_servicemaildef.png?itok=h7uLmb_B","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/Concertfuel_servicemaildef.png?itok=1hPfSzNd"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/Concertfuel_servicemaildef.png?itok=rnRecR5m 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/Concertfuel_servicemaildef.png?itok=cqelbIh6 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/Concertfuel_servicemaildef.png?itok=qnRqqanO 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/Concertfuel_servicemaildef.png?itok=MBhYOCvO 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/Concertfuel_servicemaildef.png?itok=h7uLmb_B 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/Concertfuel_servicemaildef.png?itok=1hPfSzNd 720w"]},"source":null,"source_link":null},"is_fullscreen":false}},{"type":"cta","id":"410fd8df-e4f9-425b-9b43-e9474832de29","header":{"title":"Effenaar Meet \u0026 Eat: Concert Fuel  ","description":"\u003cp\u003eOm een hele avond los te gaan, heb je uiteraard energie nodig. In ons restaurant Effenaar Meet \u0026amp; Eat kan je terecht voor een snelle, lekkere en voedzame maaltijd, zodat je er de hele avond tegenaan kan. Je hoeft hiervoor niet te reserveren, het gerecht is direct verkrijgbaar aan de bar.\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eJe hebt hierbij keuze uit:\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003e1. Kippendijen in hoi sin saus, met roerbakgroenten, koriander en jasmijnrijst\u003c/p\u003e\r\n\r\n\u003cp\u003e2. Dahl linzencurry met jackfruit, roerbakgroenten, cashewnoten en jasmijnrijst\u003c/p\u003e\r\n\r\n\u003cp\u003ePer gerecht betaal je €13,50,-.\u003c/p\u003e\r\n\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n"},"content":{"cta_title":"Liever uitgebreid tafelen? Dat kan uiteraard ook!","cta_description":null,"url":{"uri":"https://www.effenaar.nl/restaurant","title":"Bekijk hier onze menukaart en reserveer een tafel ","options":{"url":"https://www.effenaar.nl/restaurant"}},"description":{"value":"\u003cp\u003eOm een hele avond los te gaan, heb je uiteraard energie nodig. In ons restaurant Effenaar Meet \u0026amp; Eat kan je terecht voor een snelle, lekkere en voedzame maaltijd, zodat je er de hele avond tegenaan kan. Je hoeft hiervoor niet te reserveren, het gerecht is direct verkrijgbaar aan de bar.\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eJe hebt hierbij keuze uit:\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003e1. Kippendijen in hoi sin saus, met roerbakgroenten, koriander en jasmijnrijst\u003c/p\u003e\r\n\r\n\u003cp\u003e2. Dahl linzencurry met jackfruit, roerbakgroenten, cashewnoten en jasmijnrijst\u003c/p\u003e\r\n\r\n\u003cp\u003ePer gerecht betaal je €13,50,-.\u003c/p\u003e\r\n\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n","format":"basic_html","processed":{"web":"\u003cp\u003eOm een hele avond los te gaan, heb je uiteraard energie nodig. In ons restaurant Effenaar Meet \u0026amp; Eat kan je terecht voor een snelle, lekkere en voedzame maaltijd, zodat je er de hele avond tegenaan kan. Je hoeft hiervoor niet te reserveren, het gerecht is direct verkrijgbaar aan de bar.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eJe hebt hierbij keuze uit:\u0026nbsp;\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e1. Kippendijen in hoi sin saus, met roerbakgroenten, koriander en jasmijnrijst\u003c/p\u003e\n\u003cp\u003e2. Dahl linzencurry met jackfruit, roerbakgroenten, cashewnoten en jasmijnrijst\u003c/p\u003e\n\u003cp\u003ePer gerecht betaal je €13,50,-.\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n","app":"Om een hele avond los te gaan, heb je uiteraard energie nodig. In ons restaurant Effenaar Meet \u0026amp; Eat kan je terecht voor een snelle, lekkere en voedzame maaltijd, zodat je er de hele avond tegenaan kan. Je hoeft hiervoor niet te reserveren, het gerecht is direct verkrijgbaar aan de bar.\u0026nbsp;\nJe hebt hierbij keuze uit:\u0026nbsp;\u0026nbsp;\n1. Kippendijen in hoi sin saus, met roerbakgroenten, koriander en jasmijnrijst\n2. Dahl linzencurry met jackfruit, roerbakgroenten, cashewnoten en jasmijnrijst\nPer gerecht betaal je €13,50,-.\n\u0026nbsp;\n"}},"title":"Effenaar Meet \u0026 Eat: Concert Fuel  "}},{"type":"cta","id":"06041cc0-f909-46ca-8df4-baee62263b3e","header":{"title":null,"description":null},"content":{"cta_title":"Alvast een locker reserveren?","cta_description":null,"url":{"uri":"https://effenaar.elockers.shop/effenaar/lockers","title":"Dat doe je via deze link! ","options":{"url":"https://effenaar.elockers.shop/effenaar/lockers"}},"description":null,"title":null}},{"type":"cta","id":"ae039147-a8cf-45ba-89e5-017f2fa2eecb","header":{"title":null,"description":null},"content":{"cta_title":"Meer info en de laatste updates over BRIDGE Guitar Festival bekijken? ","cta_description":null,"url":{"uri":"https://bridgefestival.com/","title":"Bezoek hier de website van BRIDGE!","options":{"url":"https://bridgefestival.com/"}},"description":null,"title":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724686236,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-dinosaur-jr-nl","queryHash":"[\"AgendaDetail-dinosaur-jr-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":846,"slug":"/agenda/bridge-around-town-vrijdag","endpoint":"/nl/agenda/bridge-around-town-vrijdag","translations":{"nl":"/agenda/bridge-around-town-vrijdag","en":null},"title":"BRIDGE AROUND TOWN | Vrijdag ","content":"\u003cp\u003eVan rauwe rock en indie pop, tot opruiende metal, blues, gypsy en psychedelische rock. Vooral enorm veel bijzondere gitaristen. Met hun bands uiteraard. Tijdens BRIDGE Guitar Festival vindt er naast een aantal betaalde concerten ook een groot gratis stadsfestival plaats in het centrum van Eindhoven: \u003cstrong\u003eBRIDGE AROUND TOWN\u003c/strong\u003e. Verdeeld over tien zalen, staan er straks ruim 50 acts op het podium! \u003c/p\u003e\r\n","meta":{"title":"BRIDGE AROUND TOWN ","description":"Van rauwe rock en indie pop, tot opruiende metal, blues, gypsy en psychedelische rock. Vooral enorm veel bijzondere gitaristen. Met hun bands uiteraard. Tijdens BRIDGE Guitar Festival vindt er naast een aantal betaalde concerten ook een groot gratis stadsfestival plaats in het centrum van Eindhoven: BRIDGE AROUND TOWN. Verdeeld over tien zalen, staan er straks ruim 50 acts op het podium! ","image":null},"publish_date":{"timestamp":1705412144,"machine":"2024-01-16T13:35:44+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"BRIDGE AROUND TOWN ","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=DhHdV_b-","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=MF9Gw9vK","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=7s7V6B9N","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=7SeoicDR","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=nCtBGkpy","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?it