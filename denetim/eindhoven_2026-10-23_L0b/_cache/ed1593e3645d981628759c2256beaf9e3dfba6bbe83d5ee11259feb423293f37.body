-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"6c4f695c-dd7d-437b-b987-28f67e070f9d","header":{"title":"Soloalbum Paragon"},"content":{"content":"\u003cp\u003eDe palmares van Floor zijn ondertussen bij heel wat muziekliefhebbers bekend: ze verdiende haar strepen in bovengenoemde bands en speelde zich bij een breder publiek in de kijker door een optreden bij tv-programma Beste Zangers. Haar versie van Phantom of the Opera samen met bariton Henk Poort blies iedereen die het hoorde van de sokken.\u003c/p\u003e\r\n\r\n\u003cp\u003eOp haar eerste soloalbum Paragon dat in maart 2023 uitkwam, liet Floor een gevarieerde, kwetsbare, intieme en krachtige kant van zichzelf zien. Ze maakte een grote ontwikkeling door als songschrijver in samenwerking met producers en songschrijvers Gordon Groothedde en Wouter Hardy. Met die nummers verbreedde ze haar toch al behoorlijk brede palet en stapte ze vol vertrouwen het clubcircuit in. Maar het grotere werk lonkte. Op BRIDGE geeft Floor wederom een grote show met haar eigen naam op het affiche. Natuurlijk niet zonder dat een absolute topband haar begeleidt.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"featured_paragraph","id":"b6cfba12-9c14-47aa-a64e-fc907e09859c","header":{"title":"Special guest: Anneke van Giersbergen"},"content":{"content":"\u003cp\u003eNiemand minder dan Anneke van Giersbergen zal als special guest optreden tijdens de show van Floor Jansen op zaterdag 1 juni in het Klokgebouw! Anneke en Floor deelden eerder veelvuldig het podium. Een ‘match made in heaven’ die deze avond in Anneke’s thuisstad andermaal onderstreept gaat worden. Ze is een héél grote naam in de rock- en metalwereld als frontvrouw van The Gathering, maar inmiddels heeft ze al vele jaren een succesvolle solocarrière.\u003c/p\u003e\r\n","image":{"image":{"alt":"Anneke png","src":"https://d12y285rxlbnxt.cloudfront.net/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=o0kKQy1m","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=XM50GnKr","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=VEwIiEK9","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=BK6uDDZm","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=dnaMAZYr","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=igBNnJMf"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=o0kKQy1m 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=XM50GnKr 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=VEwIiEK9 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=BK6uDDZm 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=dnaMAZYr 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-03/1080x1080%20ANNEKE%20VAN%20GIERSBERGEN%20PNG.png?itok=igBNnJMf 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"03a2e4b6-62af-45c9-a7d8-b1e0e1e96d88","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/5taY5JenEe5UTeLDKqvvEY?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"cta","id":"0fded55f-94e1-4010-ac60-d8f2a390c5d3","header":{"title":null,"description":null},"content":{"cta_title":"Meer info en de laatste updates over BRIDGE Guitar Festival bekijken?","cta_description":null,"url":{"uri":"https://bridgefestival.com/","title":"Bezoek hier de website van BRIDGE!","options":{"url":"https://bridgefestival.com/"}},"description":null,"title":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724687805,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-floor-jansen-nl","queryHash":"[\"AgendaDetail-floor-jansen-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":847,"slug":"/agenda/bridge-around-town-zaterdag","endpoint":"/nl/agenda/bridge-around-town-zaterdag","translations":{"nl":"/agenda/bridge-around-town-zaterdag","en":null},"title":"BRIDGE AROUND TOWN | Zaterdag ","content":"\u003cp\u003eVan rauwe rock en indie pop, tot opruiende metal, blues, gypsy en psychedelische rock. Vooral enorm veel bijzondere gitaristen. Met hun bands uiteraard. Tijdens BRIDGE Guitar Festival vindt er naast een aantal betaalde concerten ook een groot gratis stadsfestival plaats in het centrum van Eindhoven: \u003cstrong\u003eBRIDGE AROUND TOWN\u003c/strong\u003e. Verdeeld over tien zalen, staan er straks ruim 50 acts op het podium! \u003c/p\u003e\r\n","meta":{"title":"BRIDGE AROUND TOWN ","description":"Van rauwe rock en indie pop, tot opruiende metal, blues, gypsy en psychedelische rock. Vooral enorm veel bijzondere gitaristen. Met hun bands uiteraard. Tijdens BRIDGE Guitar Festival vindt er naast een aantal betaalde concerten ook een groot gratis stadsfestival plaats in het centrum van Eindhoven: BRIDGE AROUND TOWN. Verdeeld over tien zalen, staan er straks ruim 50 acts op het podium! ","image":null},"publish_date":{"timestamp":1705414289,"machine":"2024-01-16T14:11:29+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"BRIDGE AROUND TOWN ","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=DhHdV_b-","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=MF9Gw9vK","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=7s7V6B9N","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=7SeoicDR","480w":"https://d12y285rxlbnxt.cloudfro