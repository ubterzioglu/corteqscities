-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19.png?itok=GpvLv2IK 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19.png?itok=32CecMvQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19.png?itok=XdSAdVca 720w"]},"source":"Foto: Almicheal Fraay | Doevoe at Hit The City 2022","source_link":null},"breadcrumb":null,"subtitle":"Door Roeline Machiels, Zoran Bogdanovic","thumbnail_image":{"image":{"alt":"Doevoe Hit The City","src":"https://d12y285rxlbnxt.cloudfront.net/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=jlq5FkFR","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=8q5QNbA1","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=h8fefdQf","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=HipFwLvq","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=YvdQ2wDL","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=sWHs6DMt"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=jlq5FkFR 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=8q5QNbA1 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=h8fefdQf 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=HipFwLvq 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=YvdQ2wDL 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-10/HIT%20THE%20CITY%202022%20Night%201_fotograaf%20Almicheal%20Fraay%20%28%40maikeljay%29-19_v2.png?itok=sWHs6DMt 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#CBACE8","background_color":"#280D2C","text_color":"#FFFFFF"},"tags":[],"related_events":[]},{"type":"longread","nid":666,"slug":"/artikelen/de-toekomst-van-muziekbeleving-ai-immersieve-werelden-en-virtueel-geluid","endpoint":"/nl/artikelen/de-toekomst-van-muziekbeleving-ai-immersieve-werelden-en-virtueel-geluid","translations":{"nl":"/artikelen/de-toekomst-van-muziekbeleving-ai-immersieve-werelden-en-virtueel-geluid","en":null},"title":"De toekomst van muziekbeleving: AI, immersieve werelden en virtueel geluid ","content":"\u003cp\u003e\u003ca href=\"https://www.effenaar.nl/nl/future-music-experience-ai-immersive-worlds-and-virtual-sound\" target=\"_blank\"\u003eWant to read this article in English? Hit this link!\u003c/a\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003eTechnologie heeft een transformatief effect op hoe we de wereld om ons heen beleven en de ontwikkelingen komen razendsnel. Apps voor alle wensen, QR-codes die allerlei info en media ontsluiten en 24/7 contact via je devices terwijl we kilometers bij elkaar vandaan zijn. Technologie biedt mogelijkheden die voorheen onmogelijk waren, door de digitale hyperrealiteit steeds meer in te bedden in onze dagelijkse wereld. Die transformatie zie je terug in alle aspecten van ons leven en dus ook in de muziek. Concerten van je favo artiesten beleven via livestreams nam de laatste jaren - mede doordat we thuiszaten vanwege de pandemie - een enorme vlucht. Dat zette ook veel muziekprofessionals aan het denken; wat kan er nog meer? Langzaam omarmen we de nieuwe kansen die technologie ons biedt. Artiesten en makers, maar ook de luisteraar zelf. Wat zijn de mogelijkheden en hoe zet je die in? Het antwoord moet nog blijken, maar zeker is dat er druk wordt geëxperimenteerd.\u003c/p\u003e\r\n","meta":{"title":"De toekomst van muziekbeleving: AI, immersieve werelden en virtueel geluid ","description":"Lees hier het hele artikel.","image":null},"publish_date":{"timestamp":1694639722,"machine":"2023-09-13T21:15:22+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"hiigo hybrid music vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/hiigohuismeta.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuismeta.png?itok=Wkn2sUam","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/hiigohuismeta.png?itok=9jp_EJNu","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/hiigohuismeta.png?itok=Ms243jK8","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/hiigohuismeta.png?itok=KKXeTEh5","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/hiigohuismeta.png?itok=fZuhEGnW","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/hiigohuismeta.png?itok=ZpAFobjv"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuismeta.png?itok=Wkn2sUam 1400w","https://d12y285rx