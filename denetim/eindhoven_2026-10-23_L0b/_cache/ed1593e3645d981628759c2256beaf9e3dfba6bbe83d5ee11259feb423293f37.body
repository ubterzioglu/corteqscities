ll,"opens_at":"19:30"},"locations":[],"facebook_event":{"uri":"https://fb.me/e/7e5TZbCCa","title":"","options":{"url":"https://fb.me/e/7e5TZbCCa"}},"genres":[],"club_card_event":true,"ticket_url":null,"ticket_price":null,"state":"last_tickets","locker_reservation":true,"restaurant_reservation":true,"related_events":[]},{"type":"event","nid":1141,"slug":"/agenda/james-leg","endpoint":"/nl/agenda/james-leg","translations":{"nl":"/agenda/james-leg","en":null},"title":"James Leg","content":"\u003cp\u003eJohn Wesley Myers, bekend van o.a. Black Diamond Heavies, kruipt in zijn lenige alter-ego James Leg om de punk-blues te prediken. Deze zoon van een predikant groeide op in Texas met gospel, wat hij nu moeiteloos combineert met rock 'n roll en blues. Of zoals zijn familie zou zeggen; music of the devil. James Leg rockt al 25 jaar door 30 landen met zijn traditionele roots met moderne invloeden. In 2025 komt zijn negende studio album uit. Daar wordt op het moment hard aan gewerkt in de kelder van een kerk in Tennessee.\u003c/p\u003e\r\n","meta":{"title":"James Leg | Effenaar","description":"John Wesley Myers, bekend van o.a. Black Diamond Heavies, kruipt in zijn lenige alter-ego James Leg om de punk-blues te prediken. Deze zoon van een predikant groeide op in Texas met gospel, wat hij nu moeiteloos mixt met rock 'n roll en blues. Of zoals zijn familie zou zeggen; music of the devil. James Leg rockt al 25 jaar door 30 landen met zijn traditionele roots met moderne invloeden. In 2025 komt zijn negende studio album uit. Daar wordt op het moment hard aan gewerkt in de kelder van een kerk in Tennessee.","image":null},"publish_date":{"timestamp":1725441424,"machine":"2024-09-04T09:17:04+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"James Leg Header","src":"https://d12y285rxlbnxt.cloudfront.net/2024-09/%20%E2%80%93%201920x1080%20Website.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-09/%20%E2%80%93%201920x1080%20Website