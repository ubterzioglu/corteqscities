ent":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/AjwWZp0kWnU?si=TSSFvMjIU2_bNcnT\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"embed","id":"9017a3d0-ded0-4b7d-b87f-457c59715e6f","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe data-testid=\"embed-iframe\" style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/artist/4hj9dun9KpnBukLv7Hgfkr?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724589857,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-ronde-18okt-nl","queryHash":"[\"AgendaDetail-ronde-18okt-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1798,"slug":"/agenda/thesmithspresumably","endpoint":"/nl/agenda/thesmithspresumably","translations":{"nl":"/agenda/thesmithspresumably","en":null},"title":"The Smiths Presumably","content":"\u003cp\u003eGeen andere tributeband vertolkt het oeuvre van The Smiths zo indrukwekkend als The Smiths Presumably. Deze Belgische band, met Limburgse roots, heeft nota bene in het Verenigd Koninkrijk een ijzersterke podiumreputatie opgebouwd. In de bakermat van The Smiths brengen ze de klassiekers van Morrissey en Marr uit de jaren tachtig - van This Charming Man, Bigmouth Strikes Again, Girlfriend In A Coma en There Is A Light That Never Goes Out - voor 