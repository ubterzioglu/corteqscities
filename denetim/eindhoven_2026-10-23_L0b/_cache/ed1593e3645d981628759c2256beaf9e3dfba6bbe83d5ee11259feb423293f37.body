y%20KaatVanStralen.jpg?itok=8QBjRajA","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-03/%E2%80%93%20Square%20afbeelding%20only%20KaatVanStralen.jpg?itok=lCA-dGcM","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-03/%E2%80%93%20Square%20afbeelding%20only%20KaatVanStralen.jpg?itok=__9p3Bzw"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-03/%E2%80%93%20Square%20afbeelding%20only%20KaatVanStralen.jpg?itok=h8zeliag 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-03/%E2%80%93%20Square%20afbeelding%20only%20KaatVanStralen.jpg?itok=pBXHPwId 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-03/%E2%80%93%20Square%20afbeelding%20only%20KaatVanStralen.jpg?itok=SizWRiWe 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-03/%E2%80%93%20Square%20afbeelding%20only%20KaatVanStralen.jpg?itok=8QBjRajA 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-03/%E2%80%93%20Square%20afbeelding%20only%20KaatVanStralen.jpg?itok=lCA-dGcM 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-03/%E2%80%93%20Square%20afbeelding%20only%20KaatVanStralen.jpg?itok=__9p3Bzw 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":null,"club_card_event":true,"colors":{"accent_color":"#03A6A6","background_color":"#000D08","text_color":"#ffffff"}}],"blocks":[{"type":"paragraph","id":"61f3bfac-e089-433f-9501-0a4f70d09667","header":{"title":null},"content":{"content":"\u003cp\u003eHun geluid kun je ondertussen het beste omschrijven als grunge met een knipoog, indie met rafelranden en hooks die in je hoofd blijven hangen. Geïnspireerd door Hole (de naam van de band komt niet voor niets van een lyric uit 'Celebrity Skin'), Nirvana en Radiohead, maakt wilt muziek voor mensen die eigenlijk zeggen dat ze “niet zo van gitaarbands houden”. Muziek die je het best luistert in de auto over de snelweg, maar nog beter in de volle chaos van een liveshow. Dat laatste doe je in Altstadt, op zaterdag 7 november!\u003c/p\u003e","links":null}},{"type":"embed","id":"e4d656ed-0b8c-4d45-8810-435ee148e5d2","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/IKUO2OhVdg0?si=bPrIbzsaJ4WRMQQl\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"63e34d16-4d00-4062-9fd5-b7be37318a38","header":{"title":"Support: thistle."},"content":{"content":"\u003cp\u003eHet Manchester-trio thistle. bouwt in rap tempo aan momentum binnen de Britse alternatieve scene met hun mix van lo-fi noise, shoegaze-texturen en hardcore-achtige intensiteit, door de pers ook wel “grungegaze” genoemd. Hun nieuwste EP 'backflip' laat horen hoe de band moeiteloos schakelt tussen vervormde, chaotische noise rock en kwetsbare, gelaagde momenten. Een passende metafoor voor hun vernieuwing en de fysieke, intensieve manier waarop ze zich uiten.\u003c/p\u003e","links":null}},{"type":"embed","id":"22793165-0a63-42d8-a310-df6c5fe9ab0f","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/vy7RQc6GpLU?si=N8bqEXc0W8mzWqJa\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":92,"dataUpdatedAt":1792724743473,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-wilt-nl","queryHash":"[\"AgendaDetail-wilt-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"longread","nid":215,"slug":"/artikelen/eindhoven-op-hit-city-3x-artiesten","endpoint":"/nl/artikelen/eindhoven-op-hit-city-3x-artiesten","translations":{"nl":"/artikelen/eindhoven-op-hit-city-3x-artiesten","en":null},"title":"Eindhoven op Hit The City: 3x Artiesten","content":"\u003cp\u003e‘Het is één groot complot,’ vertelt Lloyd me als ik erachter kom dat iedereen in dit interview connected is. Voor effenaar.nl sprak ik Ferdous Dehzad, Lloyd Usidame en Jazz: de geheime driehoeksverhouding die meer deelt dan hun homebase of een plekje op de line-up van \u003ca href=\"https://www.instagram.com/hitthecity.festival/\"\u003eHit The City\u003c/a\u003e. Hoe diep kan ik tot hun kern als artiest komen binnen 10 minuten? Dat lees je na het reclameblok.\u003c/p\u003e\r\n","meta":{"title":"Eindhoven op Hit The City: 3x Artiesten","description":"","image":null},"publish_date":{"timestamp":1664290800,"machine":"2022-09-27T15:00:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"KEVN 1","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/kelder.jpeg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/kelder.jpeg?itok=lNiQyF1H","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/kelder.jpeg?itok=Fhago4KQ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/kelder.jpeg?itok=oY7wmG6P","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/kelder.jpeg?itok=iIdsyPNS","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/kelder.jpeg?itok=sn_1Moe5","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/kelder.jpeg?itok=rcLuGdBk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/kelder.jpeg?itok=lNiQyF1H 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/kelder.jpeg?itok=Fhago4KQ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/kelder.jpeg?itok=oY7wmG6P 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/kelder.jpeg?itok=iIdsyPNS 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/kelder.jpeg?itok=sn_1Moe5 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/kelder.jpeg?itok=rcLuGdBk 720w"]},"source":"Kelderman En Van Noort (KEVN)","source_link":null},"breadcrumb":null,"blocks":[{"type":"related_news","id":"b1299216-8db3-4c64-bb98-a3411b511e13","header":{"title":null,"description":null},"content":{"items":[{"type":"news","nid":194,"slug":"/nieuws/maak-kennis-met-de-9-curatoren-van-hit-city-2022","endpoint":"/nl/nieuws/maak-kennis-met-de-9-curatoren-van-hit-city-2022","translations":{"nl":"/nieuws/maak-kennis-met-de-9-curatoren-van-hit-city-2022","en":null},"title":"Maak kennis met de 9 curatoren van Hit The City 2022","content":"","meta":{"title":"Maak kennis met de 9 curatoren van Hit The City 2022","description":"","image":null},"publish_date":{"timestamp":1663257600,"machine":"2022-09-15T16:00:00+00:00"},"published":true,"sticky":true,"header_image":null,"description":""}]}},{"type":"paragraph","id":"2223ad64-0670-469f-8fc9-41f1a20bff05","header":{"title":"Geheime driehoeksverhouding"},"content":{"content":"\u003cp\u003eLloyd en Jazz komen beiden uit de 040-zone en ondergingen hetzelfde ontwikkelingstraject: \u003ca href=\"https://www.talenthubbrabant.nl/talenthubs/music-hub-brabant-90\"\u003eMusic Hub Brabant\u003c/a\u003e. Ferdous en Lloyd delen hetzelfde atelier en speelden al eerder in verschillende formaties met elkaar. Begin je 'het complot' te begrijpen? Dit jaar staan de volgroeide artiesten ieder solo onder hun pseudoniemen \u003ca href=\"https://www.instagram.com/ferdousmusic/\"\u003eFerdous\u003c/a\u003e, \u003ca href=\"https://www.instagram.com/ituagram/\"\u003eITUA\u003c/a\u003e en \u003ca href=\"https://www.instagram.com/jazzofficial/\"\u003ePXRPLE JAZZ\u003c/a\u003e op Hit The City 2022. In \u003ca href=\"https://www.keldermanenvannoort.nl/\"\u003eKelderman En Van Noort\u003c/a\u003e sprak ik de drie over hun visie op muziek, de weg die ze momenteel bewandelen als artiest en hun shows tijdens Hit The City. Mijn gezelschap is collega-vriendin-fotograaf Miranda Gashi, wellicht bekend van rubriek \u003ca href=\"https://www.effenaar.nl/artikelen/effe-kletsen-met-elvin-usidame\"\u003eEffe Kletsen\u003c/a\u003e, om deze mooie mensen vast te leggen op beeld.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"90794040-005d-4513-9ae6-412617cd5dd6","header":{"title":"ITUA","description":"\u003cp\u003eVrijdag 21 oktober | Kelderman En Van Noort\u0026nbsp;\u003c/p\u003e\r\n"},"content":{"image":{"image":{"alt":"Eindhoven op Hit The City 8","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/ITUA1_0.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/ITUA1_0.jpg?itok=BjL4hh4R","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/ITUA1_0.jpg?itok=eZQoUDJ0","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/ITUA1_0.jpg?itok=Rz6hasdA","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/ITUA1_0.jpg?itok=OlE6p5hp","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/ITUA1_0.jpg?itok=Vp4dM7Y2","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/ITUA1_0.jpg?itok=bEUcPmEL"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/ITUA1_0.jpg?itok=BjL4hh4R 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/ITUA1_0.jpg?itok=eZQoUDJ0 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/ITUA1_0.jpg?itok=Rz6hasdA 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/ITUA1_0.jpg?itok=OlE6p5hp 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/ITUA1_0.jpg?itok=Vp4dM7Y2 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/ITUA1_0.jpg?itok=bEUcPmEL 720w"]},"source":"Foto: Miranda Gashi","source_link":null},"is_fullscreen":false}},{"type":"related_event","id":"abf29867-7131-409f-91b5-a1c0bed52264","header":{"title":null,"description":null},"content":{"items":[{"type":"event","nid":68,"slug":"/agenda/hit-city-vrijdag","endpoint":"/nl/agenda/hit-city-vrijdag","translations":{"nl":"/agenda/hit-city-vrijdag","en":null},"title":"Hit The City | Vrijdag","content":"\u003cp\u003eHit The City is terug met meer locaties, opkomende artiesten en grensverleggende muziek! Van gruizige gitaren en dansbare elektropop tot experimentele hiphop, obscure black metal en alles daartussenin - ontdek de bekendere en onbekendere pareltjes en nieuwe favorieten op tien bruisende locaties in Eindhoven.\u003c/p\u003e\r\n","meta":{"title":"Hit The City | Vrijdag","description":"","image":null},"publish_date":{"timestamp":1661598063,"machine":"2022-08-27T11:01:03+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"HTC Banner","src":"https://d12y285rxlbnxt.cloudfront.net/2022-10/Banner%20Website%20Algemeen.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=wbnBf40r","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=FqMYR6Dp","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=pauSo-J8","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=dvndmGNw","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=goFlPB3c","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=fonkYL4U"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=wbnBf40r 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=FqMYR6Dp 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=pauSo-J8 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=dvndmGNw 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=goFlPB3c 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=fonkYL4U 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#0b2f2f","background_color":"#e9e6e1","text_color":"#000000"},"thumbnail_image":{"image":{"alt":"HTC","src":"https://d12y285rxlbnxt.cloudfront.net/2022-10/Logo%2BBackground.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Logo%2BBackground.jpg?itok=wzAPus2q","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Logo%2BBackground.jpg?itok=1Y4RPZXA","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Logo%2BBackground.jpg?itok=Wz0eJluk","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Logo%2BBackground.jpg?itok=uL8Vd5wg","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Logo%2BBackground.jpg?itok=EJvVaqbG","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Logo%2BBackground.jpg?itok=BaxR-HCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Logo%2BBackground.jpg?itok=wzAPus2q 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Logo%2BBackground.jpg?itok=1Y4RPZXA 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Logo%2BBackground.jpg?itok=Wz0eJluk 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Logo%2BBackground.jpg?itok=uL8Vd5wg 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Logo%2BBackground.jpg?itok=EJvVaqbG 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Logo%2BBackground.jpg?itok=BaxR-HCk 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"Drie dagen gratis muziek ontdekken op tien locaties in Eindhoven","upper_title":null,"tickets":[],"tags":[{"id":67,"title":"Hit The City"}],"date":{"timestamp":1666310400,"machine":"2022-10-21"},"presale":null,"times":{"starts_at":"17:00","ends_at":null,"opens_at":null},"locations":[],"facebook_event":{"uri":"https://www.facebook.com/events/460470769258443/460470782591775/","title":"","options":{"url":"https://www.facebook.com/events/460470769258443/460470782591775/"}},"genres":[],"club_card_event":false,"ticket_url":null,"ticket_price":"0.00","state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[]}]}},{"type":"paragraph","id":"222ad2f1-aeac-4217-9a3b-73e43322cdd1","header":{"title":"Hoe rolde je in de muziek? "},"content":{"content":"\u003cp\u003eDat begon op jonge leeftijd al, toen ik 9 jaar oud was. We gingen vroeger vaak naar een Pinkstergemeenschap-kerk waar ook veel mensen uit Curaçao en Suriname kwamen. Dat was altijd een groot feestje, en ik en mijn broer waren altijd geïnteresseerd om muzikaal deel te nemen. We hadden thuis instrumenten staan: mijn broer begon op de gitaar en ik op de djembé. Op 12-jarige leeftijd ging ik drummen voor de schoolband van mijn broer. Zo werd de band Hunting The Robot geboren. Met deze band hebben we tours gedaan door heel Nederland en in het voorprogramma gestaan van namen als Kensington, Go Back To The Zoo en Jungle By Night. Met deze 'familieband' heb ik veel geleerd. Vanaf 2017 ging iedereen zijn eigen kant op. Via Ferran Huijsmans, die destijds manager en geluidsman van Hunting The Robot was, ben ik meer als live-drummer gaan spelen voor o.a Thomas Azier en Klyne.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"dedfc541-a4ad-4b0b-ac7e-429f6551567a","header":{"title":"Welke rol heeft Eindhoven gespeeld in je ontwikkeling als artiest? "},"content":{"content":"\u003cp\u003eMijn muzikale carrière is altijd Eindhoven-based geweest. Met \u003ca href=\"https://www.youtube.com/watch?v=hWI7KVb4Fhw\"\u003eKlyne\u003c/a\u003e en Thomas Azier repeteerde ik altijd al in Eindhoven. Daarna kreeg ik de mogelijkheid om mijn eigen studio te huren samen met Ferdous. Door deze ruimte kreeg ik de mogelijkheid om volledig te experimenteren en mijn sound te vinden. Ik en Ferdous repeteren hier ook voor zijn liveshow.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"b720b444-4cc3-4583-9895-ee090ec827cb","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Eindhoven op Hit The City 5","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/ITUA-ehv.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/ITUA-ehv.jpg?itok=BHkNXvMa","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/ITUA-ehv.jpg?itok=l2uMItFc","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/ITUA-ehv.jpg?itok=wJuyzNau","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/ITUA-ehv.jpg?itok=qutxPuxQ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/ITUA-ehv.jpg?itok=Azf0K3o4","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/ITUA-ehv.jpg?itok=GAIO-I7y"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/ITUA-ehv.jpg?itok=BHkNXvMa 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/ITUA-ehv.jpg?itok=l2uMItFc 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/ITUA-ehv.jpg?itok=wJuyzNau 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/ITUA-ehv.jpg?itok=qutxPuxQ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/ITUA-ehv.jpg?itok=Azf0K3o4 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/ITUA-ehv.jpg?itok=GAIO-I7y 720w"]},"source":"Foto: Miranda Gashi ","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"9bafc1b2-3e28-41cb-9457-f023ef5f2e74","header":{"title":"Welk thema is belangrijk voor jouw muziek? "},"content":{"content":"\u003cp\u003eHet is misschien een cliché tegenwoordig, maar ‘mental health’ vind ik heel belangrijk. Constant bezig zijn met wie je bent zonder dat het iets engs of vervelends hoeft te zijn. Dat maakt je sterk en geeft je innerlijke rust om de juiste keuzes te maken in het leven. Het heeft me de energy gegeven om te durven doen wat ik doe en mezelf te kunnen afsluiten in de zin van: this is my plan.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"456e2e75-660e-4b38-b1d0-d4076b7d8e12","header":{"title":"Op welk nummer ben je het meest trots? "},"content":{"content":"\u003cp\u003eDat vind ik lastig om te zeggen, omdat ik meer bezig ben met what’s next. De nummers die nu uit zijn, zijn relatief oud voor mij. De meest recente is al een jaar geleden geproduceerd. Van alles ben ik het meest trots op de EP: het totale plaatje. Een afsluiting waarmee ik doorga naar de next chapter.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"bc39b369-0fd8-4125-9d4c-bfca3fe61cf4","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/jaagKiPvkK0?controls=0\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"34c0a097-1244-4ce0-9e1b-ec4b33f6e84e","header":{"title":"Wat kunnen we verwachten van je performance op Hit The City?"},"content":{"content":"\u003cp\u003eDit gaat mijn eerste optreden worden met publiek én met volledige band. Ik hoop mensen hierin mee te nemen, to feed off their energy, en er echt een feestje van te maken. Voor mij is het een soort Homecoming Show, terwijl ik in de realiteit nooit ben weggeweest. Het is een nieuw hoofdstuk voor ITUA: een goedkeuring van mijn stad om daarna te kunnen vliegen.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"ed272ec0-7ec4-4629-b9f7-9e84312ea890","header":{"title":"Zou je ooit weg willen uit Eindhoven?"},"content":{"content":"\u003cp\u003eJa, als een soort noodzaak voor mijn plan, maar ik wil altijd terugkomen in Eindhoven. Ik wil binnenkort naar Nigeria gaan, niet alleen om mijn muziek daar te verspreiden, maar juist om te kijken of ik er bridges kan creëren; Westerse creators naar Afrika halen om daar dingen op te bouwen. The creative scene in Nigeria is erg opkomend en ik wil hier aan bijdragen en deel van uitmaken.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"cef54872-0dcb-4a1d-b18a-fd4277f0f2cd","header":{"title":"PXRPLE JAZZ","description":"\u003cp\u003eZaterdag 22 oktober | Effenaar\u003c/p\u003e\r\n"},"content":{"image":{"image":{"alt":"Eindhoven op Hit The City 2","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/PXRPLE%20JAZZ%202.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=UXnoINWX","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=ElhpLxsW","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=9CXGz99z","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=r9ttpOnh","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=iJRG0cB6","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=hETfdV41"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=UXnoINWX 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=ElhpLxsW 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=9CXGz99z 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=r9ttpOnh 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=iJRG0cB6 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=hETfdV41 720w"]},"source":"Foto: Miranda Gashi","source_link":null},"is_fullscreen":false}},{"type":"related_event","id":"6dd7633f-91c1-4b90-8518-a5d5953b6fe9","header":{"title":null,"description":null},"content":{"items":[{"type":"event","nid":69,"slug":"/agenda/hit-city-zaterdag","endpoint":"/nl/agenda/hit-city-zaterdag","translations":{"nl":"/agenda/hit-city-zaterdag","en":null},"title":"Hit The City | Zaterdag","content":"\u003cp\u003eHit The City is terug met meer locaties, opkomende artiesten en grensverleggende muziek! Van gruizige gitaren en dansbare elektropop tot experimentele hiphop, obscure black metal en alles daartussenin - ontdek de bekendere en onbekendere pareltjes en nieuwe favorieten op tien bruisende locaties in Eindhoven.\u003c/p\u003e\r\n","meta":{"title":"Hit The City | Zaterdag","description":"","image":null},"publish_date":{"timestamp":1661599069,"machine":"2022-08-27T11:17:49+00:00"},"published":true,"sticky":true,"header_image":{"image":{"alt":"HTC Banner","src":"https://d12y285rxlbnxt.cloudfront.net/2022-10/Banner%20Website%20Algemeen.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=wbnBf40r","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=FqMYR6Dp","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=pauSo-J8","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=dvndmGNw","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=goFlPB3c","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=fonkYL4U"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=wbnBf40r 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=FqMYR6Dp 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=pauSo-J8 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=dvndmGNw 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=goFlPB3c 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=fonkYL4U 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#0b2f2f","background_color":"#e9e6e1","text_color":"#000000"},"thumbnail_image":{"image":{"alt":"HTC","src":"https://d12y285rxlbnxt.cloudfront.net/2022-10/Logo%2BBackground.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Logo%2BBackground.jpg?itok=wzAPus2q","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Logo%2BBackground.jpg?itok=1Y4RPZXA","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Logo%2BBackground.jpg?itok=Wz0eJluk","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Logo%2BBackground.jpg?itok=uL8Vd5wg","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Logo%2BBackground.jpg?itok=EJvVaqbG","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Logo%2BBackground.jpg?itok=BaxR-HCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Logo%2BBackground.jpg?itok=wzAPus2q 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Logo%2BBackground.jpg?itok=1Y4RPZXA 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Logo%2BBackground.jpg?itok=Wz0eJluk 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Logo%2BBackground.jpg?itok=uL8Vd5wg 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Logo%2BBackground.jpg?itok=EJvVaqbG 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Logo%2BBackground.jpg?itok=BaxR-HCk 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"Drie dagen gratis muziek ontdekken op tien locaties in Eindhoven","upper_title":null,"tickets":[],"tags":[{"id":67,"title":"Hit The City"}],"date":{"timestamp":1666396800,"machine":"2022-10-22"},"presale":null,"times":{"starts_at":"17:00","ends_at":null,"opens_at":null},"locations":[],"facebook_event":{"uri":"https://www.facebook.com/events/460470769258443/460470782591775/","title":"","options":{"url":"https://www.facebook.com/events/460470769258443/460470782591775/"}},"genres":[],"club_card_event":false,"ticket_url":null,"ticket_price":"0.00","state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[]}]}},{"type":"paragraph","id":"388f2a48-5bc7-4da4-b819-204dc4b90cad","header":{"title":"Hoe rolde je in de muziek? "},"content":{"content":"\u003cp\u003eMuziek is altijd onderdeel van mij geweest. Ik ben opgegroeid met verschillende culturen en genres. Dansen was mijn eerste passie en zo is mijn liefde voor muziek eigenlijk alleen maar groter geworden. Als verlegen kind gaven kunst en muziek toegang tot uiting van mezelf, zelfexpressie.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"87115f84-ae54-4cc9-a227-a36a87ce555d","header":{"title":"Hoe kwam het zingen erbij kijken? "},"content":{"content":"\u003cp\u003eIk zong altijd al, maar nooit professioneel. Wat niemand weet is dat ik een paar jaartjes in een koortje heb gezeten, en dat was super leuk. Mijn talent voor dans was altijd meer zichtbaar, daarom werd het door iedereen zo gestimuleerd. Eigenlijk wilde ik liever zingen, maar dat werd minder gestimuleerd. \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"ca1000cc-a7bd-4b1b-af8a-f438fadc5cb5","header":{"title":"Wanneer kwam die switch van; nu ga ik voor een zangcarrière? "},"content":{"content":"\u003cp\u003eToen ik het huis uitging. Mijn ouders waren streng. Ik heb een paar keer geprobeerd stiekem zangles te nemen, maar daar kwamen ze telkens achter. Toen ik op mijn achttiende op mezelf ging wonen ben ik ervoor gegaan en nu ben ik waar ik ben. Dat heeft me heel sterk en bewust gemaakt.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"ba178942-1a2e-4e61-bd2d-590cc289a491","header":{"title":"Welke rol heeft Eindhoven gespeeld in je ontwikkeling als artiest? "},"content":{"content":"\u003cp\u003eSteffi was mijn begeleider in het \u003ca href=\"https://www.talenthubbrabant.nl/talenthubs/music-hub-brabant-90\"\u003eMusic Hub Brabant\u003c/a\u003e-traject en heeft veel voor mij betekent. Ik ontmoette haar tijdens mijn eerste optreden in Effenaar in 2020. Kort hierna nam Music Hub Brabant contact met me op om te zeggen dat ik geselecteerd was voor het talentontwikkelingstraject. Hierin was Steffi mijn mentor en hebben we veel gepraat over waar ik naartoe wilde groeien, wat er mogelijk was en heb ik veel geleerd van haar input.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"34deb7e3-bdf6-4c04-8651-2af0073ee3ed","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Eindhoven op Hit The City 6","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/JAZZ-ehv.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/JAZZ-ehv.jpg?itok=NqnioWwn","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/JAZZ-ehv.jpg?itok=A-7_Zf9H","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/JAZZ-ehv.jpg?itok=i_et-W8m","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/JAZZ-ehv.jpg?itok=2ThVX2EW","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/JAZZ-ehv.jpg?itok=VNyMG6da","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/JAZZ-ehv.jpg?itok=HiWrOAqw"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/JAZZ-ehv.jpg?itok=NqnioWwn 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/JAZZ-ehv.jpg?itok=A-7_Zf9H 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/JAZZ-ehv.jpg?itok=i_et-W8m 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/JAZZ-ehv.jpg?itok=2ThVX2EW 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/JAZZ-ehv.jpg?itok=VNyMG6da 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/JAZZ-ehv.jpg?itok=HiWrOAqw 720w"]},"source":"Foto: Miranda Gashi","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"675feb9b-579e-4a5c-bedc-6c7cd0279451","header":{"title":"Hoe zag dit traject er voor jou uit?"},"content":{"content":"\u003cp\u003eJe kunt het eigenlijk zelf invullen. Ik heb heel veel goede gesprekken met Aram gehad, mijn contactpersoon uit het traject. Ik ben altijd iemand die mezelf uit mijn comfortzone haalt. Met elke visual, look, optreden wil ik mezelf overtreffen en het beste uit mezelf halen. Ik heb in het traject ook wel geleerd om in the moment te zijn. Tegelijkertijd werkte dit perfectionisme me ook heel erg tegen. Mijn grootste les was: geniet ervan. Jij deelt jouw energie, jouw muziek en jouw verhaal met het publiek: dat is al een journey op zich. Als artiest heb je heel veel verschillende lijnen die tegelijkertijd lopen. Je hebt je interne proces, het maakproces en het presentatie proces. En dat loopt allemaal door elkaar. Wat jij presenteert heb je een tijdje geleden gemaakt, en tegelijkertijd ben je weer met nieuwe dingen bezig.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"8a11d4b5-4ef8-43ea-a505-d34af4ca7837","header":{"title":"Welk thema is belangrijk voor jou als artiest?"},"content":{"content":"\u003cp\u003eZelfexpressie, gelijkheid en vrijheid. Die drie gaan voor mij vaak samen. In mijn nummers zing ik vaak over een serieus thema dat ik op een speelse manier aanpak en presenteer.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"19d2a6cc-b8f9-4513-b337-d64a45e700b7","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/SYji9pERrdM?controls=0\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"4f57e7da-43da-47ad-88db-3639afa3b814","header":{"title":"Op welk nummer ben je het meest trots? "},"content":{"content":"\u003cp\u003eDat is een nummer dat nog niet is uitgebracht ;)\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"1e9cc09c-ed2a-4ab0-b792-d42aef91adba","header":{"title":"Can we get a preview, without spoiling too much?"},"content":{"content":"\u003cp\u003eHet nummer heeft meerdere betekenissen. Als je luistert naar de tekst moet je weten dat er meerdere lagen in zitten. Het gaat over hoe de maatschappij vrouwen behandelt, maar dat pak ik op een speelse en savage manier aan. Met een subtiele middelvinger. Het is heel cunty, that I can tell you.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"305e4243-cf86-4e73-9960-b12a619a0fb7","header":{"title":"Wat kunnen we verwachten van je performance op Hit The City?"},"content":{"content":"\u003cp\u003eFIRE, klaar. Get ready to be \u003ca href=\"https://www.youtube.com/watch?v=n2SCc2LdYzE\"\u003emesmerized\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"786f52c4-7bb9-4063-b3e7-f393a75385a0","header":{"title":"Ferdous","description":"\u003cp\u003eZaterdag 22 oktober | Kelderman En Van Noort\u0026nbsp;\u003c/p\u003e\r\n"},"content":{"image":{"image":{"alt":"Eindhoven Hit The City 3","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/Ferdous1.jpeg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Ferdous1.jpeg?itok=gWAW1TA5","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Ferdous1.jpeg?itok=WcaQVKnI","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Ferdous1.jpeg?itok=FRQvghF5","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Ferdous1.jpeg?itok=ObSooKat","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Ferdous1.jpeg?itok=ISQ1TLSj","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Ferdous1.jpeg?itok=Gkk33vYB"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Ferdous1.jpeg?itok=gWAW1TA5 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Ferdous1.jpeg?itok=WcaQVKnI 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Ferdous1.jpeg?itok=FRQvghF5 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Ferdous1.jpeg?itok=ObSooKat 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Ferdous1.jpeg?itok=ISQ1TLSj 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Ferdous1.jpeg?itok=Gkk33vYB 720w"]},"source":"Foto: Miranda Gashi","source_link":null},"is_fullscreen":false}},{"type":"related_event","id":"88cb38dc-bdf1-457c-a71f-f27e09eb118f","header":{"title":null,"description":null},"content":{"items":[{"type":"event","nid":69,"slug":"/agenda/hit-city-zaterdag","endpoint":"/nl/agenda/hit-city-zaterdag","translations":{"nl":"/agenda/hit-city-zaterdag","en":null},"title":"Hit The City | Zaterdag","content":"\u003cp\u003eHit The City is terug met meer locaties, opkomende artiesten en grensverleggende muziek! Van gruizige gitaren en dansbare elektropop tot experimentele hiphop, obscure black metal en alles daartussenin - ontdek de bekendere en onbekendere pareltjes en nieuwe favorieten op tien bruisende locaties in Eindhoven.\u003c/p\u003e\r\n","meta":{"title":"Hit The City | Zaterdag","description":"","image":null},"publish_date":{"timestamp":1661599069,"machine":"2022-08-27T11:17:49+00:00"},"published":true,"sticky":true,"header_image":{"image":{"alt":"HTC Banner","src":"https://d12y285rxlbnxt.cloudfront.net/2022-10/Banner%20Website%20Algemeen.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=wbnBf40r","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=FqMYR6Dp","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=pauSo-J8","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=dvndmGNw","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=goFlPB3c","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=fonkYL4U"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=wbnBf40r 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=FqMYR6Dp 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=pauSo-J8 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=dvndmGNw 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=goFlPB3c 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Banner%20Website%20Algemeen.jpg?itok=fonkYL4U 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#0b2f2f","background_color":"#e9e6e1","text_color":"#000000"},"thumbnail_image":{"image":{"alt":"HTC","src":"https://d12y285rxlbnxt.cloudfront.net/2022-10/Logo%2BBackground.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Logo%2BBackground.jpg?itok=wzAPus2q","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Logo%2BBackground.jpg?itok=1Y4RPZXA","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Logo%2BBackground.jpg?itok=Wz0eJluk","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Logo%2BBackground.jpg?itok=uL8Vd5wg","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Logo%2BBackground.jpg?itok=EJvVaqbG","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Logo%2BBackground.jpg?itok=BaxR-HCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-10/Logo%2BBackground.jpg?itok=wzAPus2q 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-10/Logo%2BBackground.jpg?itok=1Y4RPZXA 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-10/Logo%2BBackground.jpg?itok=Wz0eJluk 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-10/Logo%2BBackground.jpg?itok=uL8Vd5wg 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-10/Logo%2BBackground.jpg?itok=EJvVaqbG 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-10/Logo%2BBackground.jpg?itok=BaxR-HCk 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"Drie dagen gratis muziek ontdekken op tien locaties in Eindhoven","upper_title":null,"tickets":[],"tags":[{"id":67,"title":"Hit The City"}],"date":{"timestamp":1666396800,"machine":"2022-10-22"},"presale":null,"times":{"starts_at":"17:00","ends_at":null,"opens_at":null},"locations":[],"facebook_event":{"uri":"https://www.facebook.com/events/460470769258443/460470782591775/","title":"","options":{"url":"https://www.facebook.com/events/460470769258443/460470782591775/"}},"genres":[],"club_card_event":false,"ticket_url":null,"ticket_price":"0.00","state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[]}]}},{"type":"paragraph","id":"b40d3434-52bf-4c5f-a5f1-a28dc39e8b54","header":{"title":"Hoe rolde je in de muziek? "},"content":{"content":"\u003cp\u003eHet kwartje viel toen ik begon op de Rockacademie; hey nu kan ik iets met muziek gaan doen. Eigenlijk maakte ik van kinds af aan iedere dag al beats in mijn vrije tijd. Na de Rockacademie ging ik iets meer gefocust te werk op songwriting. Toen ik weer in touch kwam met een oude vriend van mij gingen we songs opnemen die ik rond stuurde naar allerlei blogs. Een lied werd door alle blogs opgepikt en van de ene op de andere dag hadden we opeens een buzz. Dit gaf de ruimte om alles los te laten en puur de focus op muziek te leggen.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"abf116d2-0643-4d0d-9ff9-190e753bf12b","header":{"title":"Wie was deze vriend?"},"content":{"content":"\u003cp\u003eDat was Nick. Met hem zat ik in Klyne, ons vorige project. Daarmee kon ik voor het eerst mijn brood verdienen met puur het maken van muziek.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"a0318c5e-b5d7-4b9c-a1da-6d1594470b42","header":{"title":"Wanneer begon je solocarrière? "},"content":{"content":"\u003cp\u003eBij de albumrelease van Klyne was ik erg ziek en was ik geforceerd om met dat project te stoppen. In 2018 ging ik na mijn revalidatie meer experimenteren; met een vrije geest nieuwe dingen uitproberen. Het voelde als een nieuwe start. Eind 2019 begon ik officieel met mijn solo releases en dat was het startpunt voor Ferdous.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"54141d88-c53e-4bb5-beca-3b8c95d8f767","header":{"title":"Welke rol heeft Eindhoven gespeeld in je ontwikkeling als artiest?"},"content":{"content":"\u003cp\u003eMijn basis was hier altijd al gevestigd. Eerst met Klyne, en nu werk ik samen met Lloyd in deze studio. We hebben hier dag en nacht gewerkt aan mijn liveshow toen er nog helemaal niets stond. Daar hebben we veel tijd in gestoken. Hier is alles wat ik heb.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"539c51f0-1f66-4420-9508-ab0f46b5d251","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Eindhoven op Hit The City 7","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/Ferdous-ehv.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Ferdous-ehv.jpg?itok=AO2J9Qc3","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Ferdous-ehv.jpg?itok=r2Wm5nD8","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Ferdous-ehv.jpg?itok=zhrOTxqQ","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Ferdous-ehv.jpg?itok=44SFVWY_","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Ferdous-ehv.jpg?itok=uttA1WPP","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Ferdous-ehv.jpg?itok=v7paLfuH"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Ferdous-ehv.jpg?itok=AO2J9Qc3 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Ferdous-ehv.jpg?itok=r2Wm5nD8 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Ferdous-ehv.jpg?itok=zhrOTxqQ 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Ferdous-ehv.jpg?itok=44SFVWY_ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Ferdous-ehv.jpg?itok=uttA1WPP 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Ferdous-ehv.jpg?itok=v7paLfuH 720w"]},"source":"Foto: Miranda Gashi","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"3e15c131-386b-42fc-acd9-c3d183e9d182","header":{"title":"Welk thema is belangrijk voor jouw muziek? "},"content":{"content":"\u003cp\u003eMuziek is altijd een uitdrukking van wie ik ben, mijn persoonlijkheid. Die kan elke dag weer anders zijn. Dat is het belangrijkste onderdeel voor mij: dat ik dat altijd kan uiten, zelfexpressie. Dat is de enige manier waarop ik muziek kan doen. Hier hecht ik veel waarde aan en dat is ook het belangrijkste onderdeel in ons team. Ik wil niet dat men denkt: welk lied kan het meest succesvol zijn. Snel succes kan in principe altijd, maar hoeveel voldoening haal je hier uit en hoe kun je daar op lange termijn duurzaam mee bezig zijn?\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"0ac1c767-e64a-4c02-bd4d-dbff371254d0","header":{"title":"Hoe komt deze duurzaamheid terug in jouw werk? "},"content":{"content":"\u003cp\u003eIk wil iedere dag beginnen met het eerste in wat me opkomt en me aan niemand in mijn team te hoeven verantwoorden waarom ik die dingen doe. Dat is wat voor mij centraal staat, in plaats van streven naar een hit. Wat is een hit nog vandaag? De meest random shit gaat nu viral op platforms zoals TikTok. Een hit kan ook iets zijn dat helemaal niets te maken heeft met het volgen van een formule, maar een eerlijke uitdrukking van hoe of wie iemand is.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"6990a565-d9df-406c-a00c-786856ec53d9","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/8gHVmXs9ouk?controls=0\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"633c36b4-ea72-4a69-b6a3-7599123d535c","header":{"title":"Op welk nummer ben je het meest trots? "},"content":{"content":"\u003cp\u003eDie is lastig, ik denk \u003ca href=\"https://www.youtube.com/watch?v=8gHVmXs9ouk\"\u003eStarlight\u003c/a\u003e. Deze heb ik geschreven in een kleine cabine in België op het platteland. Toen was ik bezig met het uitwerken van een ander project, wat mijn focus had moeten zijn. Toen ging ik toch een paar dagen wat meer experimenteren met nieuwe dingen. Ik had nooit verwacht dat ik dit daar zou maken. Voor mij riep Starlight een sterk gevoel op van; what the fuck is dit, waar komt dit vandaan? Ik had het nummer gedeeld in mijn story, omdat het nooit mijn intentie was deze te releasen. Toen kreeg ik opeens zoveel positieve reacties erop van mensen die mij volgden waardoor ik dacht; misschien roept het bij hen hetzelfde gevoel op als wat ik nu voel. Toen heb ik Starlight uiteindelijk gereleased. Qua numbers presteerde dit lied niet per se het beste.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"e2060170-e63b-4fbc-8827-5ce2397c0684","header":{"title":"Waar gaat Starlight over?"},"content":{"content":"\u003cp\u003eToen zat ik nog in de beginfase van mijn soloproject. Dat bracht best veel twijfels met zich mee. Toen ik dat lied aan het maken was, zat ik best met mezelf in de knoop: waar ga ik heen met dit project? En dat is best wel voelbaar in het lied. Daarom ben ik er dan ook best trots op. Nog steeds is dit, van alle releases die ik heb, het nummer waar ik het meeste bij voel.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"bae36278-70af-4f9b-a2cb-b859a7aaade6","header":{"title":"Wat kunnen we verwachten van je performance op Hit The City?"},"content":{"content":"\u003cp\u003eIk ga daar best veel nieuw materiaal spelen waar ik de laatste maanden mee bezig ben geweest, maar zeker ook wat ik tot nu toe heb uitgebracht. Voor mij is Hit The City een moment waarop alles een geheel moet zijn.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"dc0c92ea-a5a1-44db-8bd5-22f96d1e4f94","header":{"title":null},"content":{"content":"\u003ch3\u003eZie ITUA, Ferdous en PXRPLE JAZZ live op Hit The City tijdens het eerste weekend van Dutch Design Week. Nieuwsgierig naar de andere 50+ artiesten en \u003ca href=\"https://www.effenaar.nl/nieuws/maak-kennis-met-de-9-curatoren-van-hit-city-2022\"\u003ecuratoren\u003c/a\u003e van het festival? Neem dan een kijkje op \u003ca href=\"https://www.instagram.com/hitthecity.festival/\"\u003eInstagram\u003c/a\u003e en download gratis app\u0026nbsp;\u003ca href=\"https://www.tmsqr.com/\"\u003eTimesquare\u003c/a\u003e voor het complete overzicht met de deelnemende locaties en timetables.\u0026nbsp;\u003c/h3\u003e\r\n","links":null}},{"type":"cta","id":"d8d496dd-00d3-4705-b38c-f3bc7f8b19ba","header":{"title":"Plan je bezoek","description":"\u003cp\u003eTimesquare is een gratis app waarin je alle deelnemende artiesten, curatoren, locaties en timetables vindt van het driedaagse muziekfestival.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n"},"content":{"cta_title":"Hit The City in één overzicht","cta_description":null,"url":{"uri":"https://timesquare.app.link/khPMjMyJ6jb?_p=c81329c099027af1e31890fee1","title":"Download Timesquare","options":{"url":"https://timesquare.app.link/khPMjMyJ6jb?_p=c81329c099027af1e31890fee1"}},"description":{"value":"\u003cp\u003eTimesquare is een gratis app waarin je alle deelnemende artiesten, curatoren, locaties en timetables vindt van het driedaagse muziekfestival.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","format":"basic_html","processed":{"web":"\u003cp\u003eTimesquare is een gratis app waarin je alle deelnemende artiesten, curatoren, locaties en timetables vindt van het driedaagse muziekfestival.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\n","app":"Timesquare is een gratis app waarin je alle deelnemende artiesten, curatoren, locaties en timetables vindt van het driedaagse muziekfestival.\u0026nbsp;\u0026nbsp;\n"}},"title":"Plan je bezoek"}}],"subtitle":"Door Davy de Lepper","thumbnail_image":{"image":{"alt":"Eindhoven op Hit The City 2","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/PXRPLE%20JAZZ%202.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=UXnoINWX","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=ElhpLxsW","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/PXRPLE%20JAZZ%202.jpg?itok=9CXGz99z","320w":"https://d12y285rxlbnxt.cloudfron