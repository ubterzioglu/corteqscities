":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/Discophonic.png?itok=vCu9S1mp"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/Discophonic.png?itok=xo9k6dwi 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/Discophonic.png?itok=SBmyJOzn 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/Discophonic.png?itok=nXUSroTy 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/Discophonic.png?itok=6qR79GD1 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/Discophonic.png?itok=_Kzj5IhU 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/Discophonic.png?itok=vCu9S1mp 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#F7A920","background_color":"#2A2859","text_color":"#FFFFFF"}}],"blocks":[{"type":"paragraph","id":"6f871218-96e5-4e8b-808b-234a564ba91e","header":{"title":null},"content":{"content":"\u003cp\u003eMet quadrafonische sound, een spectaculaire lichtshow en indrukwekkende visuals is het alsof de legendarische Britse band nooit heeft opgehouden te bestaan.\u003c/p\u003e","links":null}},{"type":"embed","id":"b4d7b0a0-1b4b-40c0-8977-96bd8137b3a1","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/MQna59V6xCc?si=D1ifSGxkxkzWiCot\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":780,"dataUpdatedAt":1792724786031,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-pink-project-echoes-nl","queryHash":"[\"AgendaDetail-pink-project-echoes-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":439,"slug":"/agenda/kovacs","endpoint":"/nl/agenda/kovacs","translations":{"nl":"/agenda/kovacs","en":null},"title":"Kovacs","content":"\u003cp\u003eSharon Kovacs is een raadselachtig fenomeen. Voortgekomen uit de muziekschool en open-mic avonden in Eindhoven, heeft ze inmiddels haar unieke pad gesmeed door de sluwe kronkels en knopen van het leven en de wereld in vervoering gebracht met haar boze allure. De Bond-achtige tango noir van EP ‘My Love’ uit 2013 werd een Europese hit, het debuutalbum ‘Shades of Black’ haalde de hitlijsten in 36 landen en ‘Cheap Smell’ was een van de meest eerlijke en inspirerende soul albums van het decennium. Kovac’s donkere en rauwe stemgeluid tipt aan grootheden als Billie Holiday, Nina Simone, Amy Winehouse en Portishead’s Beth Gibbons en maakt haar een zwoele wereldster in wording.\u003c/p\u003e\r\n","meta":{"title":"Kovacs","description":"","image":null},"publish_date":{"timestamp":1678438500,"machine":"2023-03-10T08:55:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Kovacs header","src":"https://d12y285rxlbnxt.cloudfront.net/2023-03/header_3.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-03/header_3.png?itok=GwTUYJt3","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-03/header_3.png?itok=DgWnobLo","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-03/header_3.png?itok=yfqSJqXw","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-03/header_3.png?itok=mlTbryq3","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-03/header_3.png?itok=m1wSTotv","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-03/header_3.png?itok=vqhQAK2X"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-03/