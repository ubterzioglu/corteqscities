0F8A-F5","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/4-5%20Storycard%20Front.png?itok=euVc1ecm","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/4-5%20Storycard%20Front.png?itok=Jrr8MnCz","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/4-5%20Storycard%20Front.png?itok=YkwDMo8L","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/4-5%20Storycard%20Front.png?itok=e7l5Ghij"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/4-5%20Storycard%20Front.png?itok=EXl1STuE 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/4-5%20Storycard%20Front.png?itok=V0F8A-F5 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/4-5%20Storycard%20Front.png?itok=euVc1ecm 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/4-5%20Storycard%20Front.png?itok=Jrr8MnCz 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/4-5%20Storycard%20Front.png?itok=YkwDMo8L 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/4-5%20Storycard%20Front.png?itok=e7l5Ghij 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#D92344","background_color":"#0D0D0D","text_color":"#FFFFFF"},"tags":[],"related_events":[]},{"type":"longread","nid":653,"slug":"/artikelen/uit-de-tijdcapsule-pearl-jam-ontwapenend-met-debuutalbum-ten-effenaar","endpoint":"/nl/artikelen/uit-de-tijdcapsule-pearl-jam-ontwapenend-met-debuutalbum-ten-effenaar","translations":{"nl":"/artikelen/uit-de-tijdcapsule-pearl-jam-ontwapenend-met-debuutalbum-ten-effenaar","en":null},"title":"Uit de tijdcapsule: Pearl Jam ontwapenend met debuutalbum Ten in Effenaar","content":"\u003cp\u003eOp 27 augustus 1991 ziet het debuutalbum Ten van Pearl Jam het levenslicht, nog altijd hun meest geroemde plaat. Hoewel Ten langzaam stijgt in de hitlijsten, schiet de band zich met intense liveshows binnen no-time in het vizier van het grote publiek. Gelukkig maken ze nét voor hun grote doorbraak nog een stop in Eindhoven. Met hun allereerste album op zak, speelt Pearl Jam op 5 maart 1992 in een stijf uitverkochte Effenaar.\u003c/p\u003e","meta":{"title":"Uit de tijdcapsule: Pearl Jam ontwapenend met debuutalbum Ten in Effenaar","description":"Beluister hier het hele concert uit 1992.","image":null},"publish_date":{"timestamp":1787305499,"machine":"2026-08-21T09:44:59+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Pearl Jam Effenaar","src":"https://d12y285rxlbnxt.cloudfront.net/2023-08/Pearl%20Jam%20Header.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-08/Pearl%20Jam%20Header.png?itok=xRjVbU0V","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-08/Pearl%20Jam%20Header.png?itok=xK9Jl57H","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-08/Pearl%20Jam%20Header.png?itok=HmE_vAqt","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-08/Pearl%20Jam%20Header.png?itok=DAbvUPSy","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-08/Pearl%20Jam%20Header.png?itok=-qk9k0FI","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-08/Pearl%20Jam%20Header.png?itok=KOuZnQa9"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-08/Pearl%20Jam%20Header.png?itok=xRjVbU0V 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-08/Pearl%20Jam%20Header.png?itok=xK9Jl57H 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-08/Pearl%20Jam%20Header.png?itok=HmE_vAqt 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-08/Pearl%20Jam%20Header.png?itok=DAbvUPSy 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-08/Pearl%20Jam%20Header.png?itok=-qk9k0FI 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-08/Pearl%20Jam%20Header.png?itok=KOuZnQa9 720w"]},"source":"Foto: Ad de Wit | Pearl Jam in Effenaar","source_link":null},"breadcrumb":null,"s