/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"8dd97fe0-ba60-43cf-bf21-20c46d0ddecb","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:30 Deuren open\u003cbr /\u003e\r\n20:15 Morpheus\u003cbr /\u003e\r\n21:00 Kovacs\u003cbr /\u003e\r\n(tijden onder voorbehoud)\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"96f35e8a-f828-414e-a54a-3a09fb945b22","header":{"title":"Child of Sin"},"content":{"content":"\u003cp\u003eOnlangs kwam het derde album Child of Sin (2023) uit, met het op true crime geïnspireerde pop-noir nummer 'Bang Bang' én een opmerkelijk duet met Rammstein's Till Lindemann. Niet de meest voor de hand liggende combinatie, wel een hele sterke. Ontdaan van demonen, bevrijd van ketens en op weg naar geluk: met Child of Sin levert Kovacs een stevig visitekaartje af. Op donderdag 23 november hoor je het live in onze Grote Zaal.\u003c/p\u003e\r\n\r\n\u003cp\u003eDit concert is een samenwerking tussen Effenaar en Muziekgebouw Eindhoven.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"9914a6dc-d76b-4d31-ab23-42dc860e05d7","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/uc_bePdbslk\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"79dd1d20-1574-4255-9427-8a20c3d5b265","header":{"title":"Support: Morpheus"},"content":{"content":"\u003cp\u003eMet zijn innemende stem debuteert de Amsterdamse singer-songwriter Morpheus dit jaar met zijn debuut-EP ‘Morphosis’. Geïnspireerd door Jacques Brel en Kate Bush, draait het project om het vertellen van echte verhalen met bezielde vocalen. Na het onverwachte verlies van zijn moeder, besloot Morpheus deze aangrijpende ervaring om te zetten in kracht, heling en wijsheid. Iedere song is thuis in de woonkamer in één take opgenomen, zodat de mechaniek van de piano en iedere adem te horen zijn. Schoonheid zit voor Morpheus namelijk niet in een perfecte opname maar juist in het vangen van het moment.\u003c/p\u003e\r\n","image":{"image":{"alt":"Morpheus","src":"https://d12y285rxlbnxt.cloudfront.net/2023-10/morpheus%20swuare.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-10/morpheus%20swuare.png?itok=gW68Flnx","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-10/morpheus%20swuare.png?itok=rIo3NMQ9","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-10/morpheus%20swuare.png?itok=g_EfjIs_","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-10/morpheus%20swuare.png?itok=_2tIOoeL","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-10/morpheus%20swuare.png?itok=2CJ2Nzd3","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-10/morpheus%20swuare.png?itok=I3gjFSj9"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-10/morpheus%20swuare.png?itok=gW68Flnx 1400w","https: