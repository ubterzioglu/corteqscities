w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/naft%20square.png?itok=aoPMRvM6 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/naft%20square.png?itok=rTZGyM1J 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"Gratis toegankelijke (tech)house afterparty van NAFT","upper_title":null,"tickets":[],"tags":[],"date":{"timestamp":1764288000,"machine":"2025-11-28"},"presale":null,"times":{"starts_at":"22:30","ends_at":null,"opens_at":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"facebook_event":null,"genres":[{"id":12,"title":"dance"}],"club_card_event":false,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":true,"related_events":[]}]}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724687396,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-naft-nl","queryHash":"[\"AgendaDetail-naft-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":770,"slug":"/agenda/floor-jansen","endpoint":"/nl/agenda/floor-jansen","translations":{"nl":"/agenda/floor-jansen","en":null},"title":"Floor Jansen ","content":"\u003cp\u003eBruggen bouwen met een dijk van een stem. Dat is wat Floor Jansen kan als geen ander. Ze bouwt die muzikale infrastructurele hoogstandjes tussen symfonische muziek, rock, pop en metal. Die krachtstem klinkt vooral onweerstaanbaar in combinatie met stuwende gitaren. Dat liet ze horen bij After Forever, Revamp, Nightwish en nu ook als soloartiest. Tijdens Bridge Festival 2024 geeft ze een knallend concert in het Klokgebouw!\u003c/p\u003e\r\n","meta":{"title":"Floor Jansen tijdens BRIDGE Guitar Festival 2024 | Eindhoven ","description":"Bruggen bouwen met een dijk van een stem. Dat is wat Floor Jansen kan als geen ander. Ze bouwt die muzikale infrastructurele hoogstandjes tussen symfonische muziek, rock, pop en metal. Die krachtstem klinkt vooral onweerstaanbaar in combinatie met stuwende gitaren. Dat liet ze horen bij After Forever, Revamp, Nightwish en nu ook als soloartiest. Tijdens Bridge Festival 2024 geeft ze een knallend soloconcert in het Klokgebouw!","image":{"image":{"alt":"FLOOR JANSEN BRIDGE","src":"https://d12y285rxlbnxt.cloudfront.net/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=LbCDIk2N","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=ViHx9aUW","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=nvi0pjQF","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=Qqmott4a","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=YmbCcU-U","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=gI4-cX7C"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=LbCDIk2N 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=ViHx9aUW 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=nvi0pjQF 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-12/FLOOR%20JANSEN%20-%201920x1080%20FB%20banner%20PNG_0.jpg?itok=Qqmott4a 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-12/FLOOR%20JANSEN%20-%201