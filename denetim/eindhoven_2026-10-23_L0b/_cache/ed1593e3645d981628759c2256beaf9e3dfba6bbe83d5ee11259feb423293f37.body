t/styles/2510w/s3/2024-02/DR_20231020_DR2_7553.png?itok=def7XFKE 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/DR_20231020_DR2_7553.png?itok=tyPKbcaD 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/DR_20231020_DR2_7553.png?itok=ESlwOflc 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/DR_20231020_DR2_7553.png?itok=kUK120ZI 720w"]},"source":null,"source_link":null},{"image":{"alt":"chibi 4","src":"https://d12y285rxlbnxt.cloudfront.net/2024-02/DR_20231021_DR2_8631.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/DR_20231021_DR2_8631.png?itok=bTTYWKYE","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/DR_20231021_DR2_8631.png?itok=UGlo00Sz","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/DR_20231021_DR2_8631.png?itok=viidUVLA","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/DR_20231021_DR2_8631.png?itok=ZRzezmPx","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/DR_20231021_DR2_8631.png?itok=nHDEWXd2","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/DR_20231021_DR2_8631.png?itok=8X1toOP8"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/DR_20231021_DR2_8631.png?itok=bTTYWKYE 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/DR_20231021_DR2_8631.png?itok=UGlo00Sz 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/DR_20231021_DR2_8631.png?itok=viidUVLA 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/DR_20231021_DR2_8631.png?itok=ZRzezmPx 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/DR_20231021_DR2_8631.png?itok=nHDEWXd2 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/DR_20231021_DR2_8631.png?itok=8X1toOP8 720w"]},"source":null,"source_link":null},{"image":{"alt":"chibi 5","src":"https://d12y285rxlbnxt.cloudfront.net/2024-02/DR_20231020_DR2_7672.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/DR_20231020_DR2_7672.png?itok=03Fi0QOD","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/DR_20231020_DR2_7672.png?itok=LUppVxRo","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/DR_20231020_DR2_7672.png?itok=O5bqoC0i","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/DR_20231020_DR2_7672.png?itok=LOqeNRRN","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/DR_20231020_DR2_7672.png?itok=Dw9sYOCd","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/DR_20231020_DR2_7672.png?itok=IA-gYfj9"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/DR_20231020_DR2_7672.png?itok=03Fi0QOD 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/DR_20231020_DR2_7672.png?itok=LUppVxRo 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/DR_20231020_DR2_7672.png?itok=O5bqoC0i 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/DR_20231020_DR2_7672.png?itok=LOqeNRRN 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/DR_20231020_DR2_7672.png?itok=Dw9sYOCd 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/DR_20231020_DR2_7672.png?itok=IA-gYfj9 720w"]},"source":null,"source_link":null}]}},{"type":"featured_paragraph","id":"1b39f6ed-5344-48ed-83fc-e3f678be6c8a","header":{"title":"Support: Zeevlinder"},"content":{"content":"\u003cp\u003eMoody, verliefd zijn en om alles iets geven: dat is Zeevlinder. Onder de vleugels van label Burning Fik (Abel en Faberyayo), wil ze met haar muziek mensen laten zien dat er wel tijd is om de wereld te veranderen en duurzaam te leven.\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"zeevlinder","src":"https://d12y285rxlbnxt.cloudfront.net/2024-09/Zeevlinder%201.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-09/Zeevlinder%201.jpg?itok=nHm1O2e_","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-09/Zeevlinder%201.jpg?itok=GyXg5MqX","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-09/Zeevlinder%201.jpg?itok=eaMxDd7C","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-09/Zeevlinder%201.jpg?itok=uv-ulZWX","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-09/Zeevlinder%201.jpg?itok=J9FYh1nI","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-09/Zeevlinder%201.jpg?itok=oQO1j6sx"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-09/Zeevlinder%201.jpg?itok=nHm1O2e_ 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-09/Zeevlinder%201.jpg?itok=GyXg5MqX 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-09/Zeevlinder%201.jpg?itok=eaMxDd7C 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-09/Zeevlinder%201.jpg?itok=uv-ulZWX 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-09/Zeevlinder%201.jpg?itok=J9FYh1nI 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-09/Zeevlinder%201.jpg?itok=oQO1j6sx 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"a81719bf-b996-47fc-a11d-8f1d5b5f5474","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/artist/1SQxjouaMdQ33xLh15463l?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724631878,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-chibi-ichigo-nl","queryHash":"[\"AgendaDetail-chibi-ichigo-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"longread","nid":1405,"slug":"/artikelen/toekomstmuziek-ai-als-nieuwe-artiest","endpoint":"/nl/artikelen/toekomstmuziek-ai-als-nieuwe-artiest","translations":{"nl":"/artikelen/toekomstmuziek-ai-als-nieuwe-artiest","en":null},"title":"Toekomstmuziek: AI als nieuwe artiest?","content":"\u003cp\u003eSinds de lancering van ChatGPT staan de sluisdeuren open voor generatieve artificiële intelligentie, oftewel AI. Waar de eerste resultaten koddig en komisch waren, gaat er nu geen week voorbij waarin we niet verbaasd worden door de state-of-the-art producten die de tools produceren. Films, software, boeken en muziek rolt met een korte prompt op je scherm. De impact is voelbaar in diverse sectoren, ook in de muziekindustrie, waar AI verandert wat artiest-zijn betekent en discussies aanzwengelt over creativiteit.\u003c/p\u003e\r\n","meta":{"title":"Toekomstmuziek: AI als nieuwe artiest?","description":"AI roept fundamentele vragen op: wat is creativiteit, wat maakt muziek goed, en wat kan een muzikant? ","image":{"image":{"alt":"Toekomstmuziek","src":"https://d12y285rxlbnxt.cloudfront.net/2025-04/headermusicai.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-04/headermusicai.jpg?itok=JBj3wv7K","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-04/headermusicai.jpg?itok=8HlWG1dB","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-04/headermusicai.jpg?itok=kcEtJg7s","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-04/headermusicai.jpg?itok=GV5ar31n","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-04/headermusicai.jpg?itok=1xYiEFk2","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-04/headermusicai.jpg?itok=ODsmvIw2"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-04/headermusicai.jpg?itok=JBj3wv7K 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-04/headermusicai.jpg?itok=8HlWG1dB 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-04/headermusicai.jpg?itok=kcEtJg7s 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-04/headermusicai.jpg?itok=GV5ar31n 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-04/headermusicai.jpg?itok=1xYiEFk2 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-04/headermusicai.jpg?itok=ODsmvIw2 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1743601973,"machine":"2025-04-02T13:52:53+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Muziekproducer","src":"https://d12y285rxlbnxt.cloudfront.net/2025-04/headermusicai.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-04/headermusicai.png?itok=GgkrpyKn","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-04/headermusicai.png?itok=BK_xtjwl","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-04/headermusicai.png?itok=GFMeQd8P","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-04/headermusicai.png?itok=RvshAbbB","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-04/headermusicai.png?itok=ya8Uobal","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-04/headermusicai.png?itok=267aKi8f"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-04/headermusicai.png?itok=GgkrpyKn 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-04/headermusicai.png?itok=BK_xtjwl 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-04/headermusicai.png?itok=GFMeQd8P 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-04/headermusicai.png?itok=RvshAbbB 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-04/headermusicai.png?itok=ya8Uobal 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-04/headermusicai.png?itok=267aKi8f 720w"]},"source":"Afbeelding: Unsplash rechtenvrij door Techivation","source_link":null},"breadcrumb":null,"blocks":[{"type":"paragraph","id":"42b70f62-ed38-4e36-8dde-290f411c6565","header":{"title":null},"content":{"content":"\u003cp\u003eAI is een transformatieve technologie, omdat het de manier hoe we naar iets kijken compleet op z’n kop zet. \u0026nbsp;Denk bijvoorbeeld aan het uitvinden van opnametechnologie, die muziek maken mogelijk maakte zonder instrumenten of artiesten. Dat staat in contrast met een innovatie, zoals de kleurentelevisie. Natuurlijk een bijzondere verandering, maar die veranderde niet hoe we naar bewegend beeld kijken. AI doet dat wél met ons maakproces.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"f32449bd-244c-4750-a8ee-4627e186a367","header":{"title":null},"content":{"content":"\u003cp\u003eWat de tool zo bijzonder maakt, is dat het leert van data en patronen herkent, in tegenstelling tot traditionele software die vaste regels volgt. Dit gebeurt via neurale netwerken, die lagen van informatie analyseren—zoals juryleden die samen een oordeel vormen over muziek. Hierdoor kun je met een simpele prompt complexe muziek genereren, telkens met een uniek resultaat.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"6f60ee57-0c21-4618-9312-59cce874eb14","header":{"title":null},"content":{"content":"\u003cp\u003eHet zal niemand verbazen dat AI al volop in gebruik is in de muziek. Omdat het goed is in het herkennen van patronen, kan het ook goed corrigeren, invullen en uitbalanceren. Geen wonder dus, dat audiosoftware voor opnames of liveshows al ondersteund wordt door algoritmes die gitaarriffjes rechttrekken, een mix uitbalanceren of geluid schoonpoetsen. Dat maakt veel productiewerk veel sneller en efficiënter. Bij liveshows kan AI helpen de lichten aan te sturen, in lijn met de muziek, of direct corrigeren in de mix. Vooralsnog onder supervisie van geluidsmensen, maar nu al is veel monnikkenwerk in de productie verleden tijd. \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"579952f3-0062-46bb-be67-afdc91b4fb6d","header":{"title":"Een stil protest"},"content":{"content":"\u003cp\u003eToch ligt de verdere ontwikkeling van AI in de muziek onder vuur. Dit wordt vooral door één onderwerp enorm gekleurd; copyright. In 2024 ondertekenden 200 muzikanten, waaronder Billie Eilish en Nicki Minaj, een open brief aan techbedrijven over het trainen van modellen op muziek zonder toestemming van de desbetreffende artiesten. Dit jaar bracht een groep artiesten, waaronder Kate Bush en Damon Albarn, het album \u003cem\u003e‘\u003c/em\u003e\u003cem\u003eIs This What We Want?’\u003c/em\u003e uit; een plaat zonder muziek, geheel stil, als protest. Zelden zijn bedrijven transparant over hun trainingsdata en ook de wet- en regelgeving biedt weinig houvast.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"5ae19cb4-aeb0-4487-9bcd-059106e17dbe","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/1yUbRSEsj5ng38IpHpcLJt?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"5f4a85b4-2643-44d4-acc4-2ab698b37add","header":{"title":null},"content":{"content":"\u003cp\u003eGeneratieve AI-muziektool Suno heeft inmiddels een marktwaarde van zo’n slordige $500 miljoen, maar artiesten zien er geen cent van. De angst bestaat dat nu Suno door Amazon toegevoegd wordt aan voiceassistant Alexa -ondanks de lopende rechtszaken met de drie grote platenlabels- de artiest helemaal buitenspel komt te staan.\u003c/p\u003e\r\n\r\n\u003cp\u003eOver de netelige copyright kwestie lees je meer in een eerder artikel over AI. Waar we het nu over willen hebben is; Wat betekent AI nou eigenlijk voor het artiest-zijn en creatieve proces?\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"c29b76ea-3802-4d72-97e5-54e2322f0fd7","header":{"title":"Sneller aan de 'fun'"},"content":{"content":"\u003cp\u003eVeel artiesten gaan los met AI en dat zijn niet alleen de pioniers en innovators. Een opvallend AI-succesverhaal komt namelijk van The Beatles. Paul McCartney en Ringo Starr mochten een Grammy ophalen voor de ‘opgepoetste’ archief-single ‘Now and Then’. AI hielp om de opname in ere te herstellen, iets wat zonder deze technologie nooit gelukt was, vertelt\u0026nbsp;\u003ca href=\"https://www.bbc.com/news/entertainment-arts-65881813\"\u003eMcCartney in een gesprek met de BBC\u003c/a\u003e.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"dc8f9522-673f-4ae7-ac98-0eaa12eebb1c","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/Opxhh9Oh3rg?si=A_U_V4wbZ_MT_Na2\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"091faa41-0805-4516-ae0f-720051af3a87","header":{"title":null},"content":{"content":"\u003cp\u003eEr wordt ook volop geëxperimenteerd door artiesten als Will.I.Am, dancepopgroep Yacht en artiest Taryn Southern, die in 2018 al een met AI gecreëerd album uitbracht. Eén van de grootste evangelisten is opvallend genoeg producer Timbaland, die aan Rolling Stone Magazine vertelde: “God gaf me dit stuk gereedschap”. De producer maakte naar eigen zeggen duizenden beats en is nauw betrokken bij het eerdergenoemde Suno als strategisch adviseur en partner.\u003cbr /\u003e\r\n\u003cbr /\u003e\r\nOok singer-songwriter SYML ziet aan de makerskant mogelijkheden, waarmee het artiestschap leuker kan zijn. “Als je meer tijd aan de ‘fun’-kant van het muzikantschap kan besteden, is dat fantastisch.” Hoewel de Belgische zangeres Sylvie Kreusch aangeeft dat AI een interessante technische tool kan zijn om het proces te vergemakkelijken of als sparringpartner kan dienen, is ze wat sceptischer. “Het is moeilijk. Ergens geloof ik ook niet in AI - hoewel er zal natuurlijk wel veel populaire muziek deels door AI wordt geschreven en de grote massa zal daarnaar gaan luisteren.\u0026nbsp;Maar mensen zijn ook niet dom en ik denk dat ze blijven zoeken naar eerlijkheid.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"ba2588d7-5282-4d9c-bb53-696650de681a","header":{"title":"Van gevoel tot calculatie"},"content":{"content":"\u003cp\u003eDaar lijkt vaak de crux te zitten in de discussie; AI is niet menselijk, het is zelfs niet intelligent in de zin dat AI ‘originele’ gedachten heeft. Het is een hele complexe replicator van kennis en heeft geen enkele vorm van emotionele betrokkenheid bij het product. Nick Cave vindt daarom dat AI de artiest vernedert, door de hele artistieke worsteling te reduceren tot een calculatie. \u003ca href=\"https://www.rollingstone.co.uk/music/news/nick-cave-on-the-frightening-impact-of-ai-in-music-42193/\"\u003eRolling Stone Magazine citeert\u003c/a\u003e hoe de meester AI als banaal en zielloos omschrijft.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"9cb6ef83-b297-4eb2-9e81-5d3e8ed36381","header":{"title":null},"content":{"content":"\u003cp\u003eMuzikant, producer en componist \u003ca href=\"https://www.effenaar.nl/nl/artikelen/jett-rebels-decennium-van-venus-en-strijd-tot-de-kunst-van-mens-zijn-en-een-nieuw-album\"\u003eJett Rebel neemt een vergelijkbare positie in\u003c/a\u003e. “De meeste mensen zullen zeggen: ‘Boeien dat het geplakt is, ik vind het gewoon lekker klinken.’ En dat mag, maar vanuit mijn perspectief, als iemand die letterlijk zijn leven geeft voor dit vak voelt het soms als valsspelen. Doping binnen sport mag niet. Muziek is dan wel geen wedstrijd en daarom is het grijs gebied, maar ik vind in veel gevallen dat ze hun fans voorliegen.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"29d0ce8e-e765-4044-b7e0-cb4e7222c180","header":{"title":null},"content":{"content":"\u003cp\u003e“Ik heb zelf meer respect voor muzikanten die een instrument beheersen”, steekt Sylvie Kreusch af. Haar visie sluit aan bij die van Cave en Jett Rebel. “Muziek -ongeacht het genre- is goed wanneer het eerlijk is, en AI is allesbehalve eerlijk. Ik ben vooral erg geïnteresseerd in de persoon achter de muziek dus wat is het nut van een computer die iets heeft geschreven? Je herkent jezelf in een nummer en voelt dat iemand ook hetzelfde heeft meegemaakt of ergens ook zo over denkt. Je wilt de persoon leren kennen, en je denkt na een tijdje ook dat je die kent. Er wordt een soort vriendschap gecreëerd.” Maar voelen alle muziekfans diezelfde behoefte bij een artiest en wie zegt dat eenzelfde gevoel anders niet mogelijk is?\u003cbr /\u003e\r\n\u003cbr /\u003e\r\nDe Amerikaanse zanger SYML gooit al een balletje op in de andere richting. “Als AI zelfbewust wordt en \u003cem\u003esongs\u003c/em\u003e gaat schrijven over zijn eigen bestaan en leven\u003cem\u003e, I would love to hear that shit\u003c/em\u003e. Dat zou enorm inspirerend en bizar zijn.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"a6342e64-cf95-4dd3-b6e1-0d09874cdce0","header":{"title":"De opkomst van virtuele artiesten en co-artiesten"},"content":{"content":"\u003cp\u003eEr zijn al voorbeelden van niet-menselijke artiesten. Zelfs metalfans gaan om voor AI-band The Frostbite Orckings. Eerder deed Metalbijbel Metal Archives alle AI-bands in de ban, en oldschool deathmetal iconen Pestilence werden werd belachelijk gemaakt vanwege AI-artwork. Maar de scene die zo prat gaat op ‘echtheid’ schijnt toch honderdduizenden keren naar de virtuele band The Frostbite Orckings te luisteren – de band heeft echte fans, \u003ca href=\"https://www.forbes.com/sites/charliefink/2023/09/18/ai-generated-music-with-real-human-fans\"\u003eschrijft Forbes\u003c/a\u003e.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"9765f8a8-b2d6-43ac-8177-ee0accb23f54","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/artist/4Zmsub1ajsxU4vymJhDfpa?utm_source=generator\" width=\"100%\" height=\"152\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"e5ec0c8c-ac5e-4ed2-b46b-77b62c85c035","header":{"title":null},"content":{"content":"\u003cp\u003eEen ander bewijsstuk is een hologram, die bijna de AFAS uitverkocht. Hatsune Miku is in feite een Vocaloid software voicebank – een sample pack met vocals, ingezongen door een voice actrice. Een community van fans en artiesten maakte al meer dan 200.000 nummers. Hoewel de oorspronkelijke stem menselijk is, speelt AI een grote rol in de creatie van Hatsune Miku-nummers. De populariteit zette het softwarebedrijf aan tot het ontwikkelen van een hologram en een reeks ‘liveshows’. Wat Hatsune Miku interessant maakt is het stuk co-creatie, maar ook het feit dat de stem gelicenseerd is, wat een interessant idee kan zijn voor AI.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"10603614-5cc9-4982-8c64-edd0060f2f3f","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/jhl5afLEKdo?si=V153Y-mnQiTnVN8y\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"0d290a17-760a-4656-8e26-e8e7d797953c","header":{"title":"Zoeken naar een eerlijke toekomst met AI"},"content":{"content":"\u003cp\u003eBijna elke artiest die met AI experimenteert is zich bewust van de ethische zorgen. Incidenten zoals de AI-gegenereerde hit met de stemmen van Drake en The Weeknd zorgden voor veel ophef. Sampling kende vergelijkbare copyright-uitdagingen, wat uiteindelijk leidde tot licentiedeals en sample packs. Een vergelijkbare route voor AI zou kunnen en sommige artiesten spelen hier al mee. Grimes biedt haar stem al aan via haar website elf.tech en ondanks haar zorgen over AI, \u003ca href=\"https://time.com/7212502/grimes-ai-art-interview/\"\u003edeelt ze met Time Magazine\u003c/a\u003e haar fascinatie voor de mogelijkheden en ziet dit als een manier om zichzelf uit te dagen.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"9db0049c-f47b-49f2-befb-2430b9b768a9","header":{"title":null},"content":{"content":"\u003cp\u003eImogen Heap staat altijd vooraan bij nieuwe techniek en vertelde op de Websummit 2024 in Lissabon over haar samenwerking met Jet om een tool te ontwikkelen die gebruikers in staat stelt \u003cem\u003esongs\u003c/em\u003e in haar stijl te genereren. Het geeft een stuk artiestschap aan de fans en opent nieuwe vormen van co-creatie en co-artiestschap. Ook heeft ze ai.mogen in het leven geroepen, een persoonlijk AI-model. Hiervoor maakte Heap eindeloze opnames van zichzelf en voedde haar eigen materiaal als data, \u003ca href=\"https://www.theguardian.com/music/2024/oct/16/im-empowering-my-song-to-go-and-make-love-with-different-people-imogen-heap-on-how-her-ai-twin-will-rewrite-pop\"\u003elegt ze uit aan The Guardian.\u003c/a\u003e Het doel hiervan is het creëren een AI-tweeling, die als assistent fungeert in haar kunstenaarschap, maar ook een nieuwe dimensie geeft aan haar werk.\u003c/p\u003e\r\n\r\n\u003cp\u003eDichter bij huis doet Albert van Abbe iets vergelijkbaars met een AI-sequencer getraind op zijn eigen werk, die in real-time muziek en licht kan aansturen. Het zijn voorbeelden van artiesten die op ethisch verantwoorde wijze AI inzetten in hun werk. Zelfs Timbaland, die zijn schouders ophaalt voor het copyright-vraagstuk, gebruikt een versie exclusief getraind op zijn eigen muziek.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"0d2120ce-cfe0-4bdc-99db-f2310a9baa15","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/JhHJv2EjIEw?si=Z8P1LTOEnLeCfnzD\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"5a220cc0-c20a-46ad-86db-f6f2b01b587a","header":{"title":"Pandora’s doos"},"content":{"content":"\u003cp\u003eSommige artiesten, zoals Jett Rebel, zien geen brood in een toekomst met AI, maar wel kansen voor de ambachtsmuzikanten. ”Mensen zijn de technieken aan het verleren, omdat ze gemakzuchtig zijn en gebruik maken van programma’s die het voor hen doen. Dus in de niet-ver-weg-toekomst ben ik één van de handjevolmensen die het kan op de echte manier, en is mijn expertise meer en meer waard.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"66e64497-7204-4078-9113-55d276d6bd4d","header":{"title":null},"content":{"content":"\u003cp\u003eDeels heeft hij gelijk, en over smaak valt niet te twisten. Maar \u003cem\u003eonly time will tell\u003c/em\u003e welke kant het op gaat. Zoals bij elke technologische innovatie zijn er voor- en tegenstanders. De discussie over het gebruik van technologie in creativiteit is al zo oud als de weg naar Rome. Denk hierbij aan kunstenaars en fotografen die met Photoshop werkten, die werden aanvankelijk niet serieus genomen of zelfs geweerd uit galeries. Of de eerste bands die aan de haal gingen met synths waar op neer werd gekeken, omdat het niet werd gezien als een ‘echt’ instrument. Er werden zelfs albums uitgebracht met de duidelijke disclaimer ‘geen synths’, om aan te tonen hoe puur de muziek was. En dan nog de opkomst van Auto-Tune wat massaal werd afgekeurd en gezien als valsspelen, maar nu niet meer is weg te denken uit opnamesoftware. Sterker nog, muzikanten zetten het zelfs in als artistiek effect.\u003c/p\u003e\r\n\r\n\u003cp\u003eAI roept fundamentele vragen op: wat is creativiteit, wat maakt muziek goed, en wat is en kan een muzikant? Die discussie is cruciaal om een weg vooruit te vinden. Eén ding staat vast: AI gaat niet meer weg. De doos van Pandora is open – de vraag is hoe we ermee omgaan.\u003c/p\u003e\r\n","links":null}},{"type":"related_longr_story","id":"66ca4c7e-6972-4ac0-b2a2-2a69967c7820","header":{"title":null,"description":null},"content":{"items":[{"type":"longread","nid":1308,"slug":"/artikelen/toekomstmuziek-hoe-tech-de-muziekindustrie-vormgeeft-2025","endpoint":"/nl/artikelen/toekomstmuziek-hoe-tech-de-muziekindustrie-vormgeeft-2025","translations":{"nl":"/artikelen/toekomstmuziek-hoe-tech-de-muziekindustrie-vormgeeft-2025","en":null},"title":"Toekomstmuziek: Hoe tech de muziekindustrie transformeert","content":"\u003cp\u003eAfgelopen week nam het showcasefestival Eurosonic Noorderslag het centrum van Groningen weer over. Naast het geluid van zo'n 250 acts dat door de straten bulderde, werd er in intieme zaaltjes en drukke auditoria door professionals uitvoerig gediscussieerd over de toekomst van de muziekindustrie. Met als groot speerpunt; de impact van technologische ontwikkelingen.\u003c/p\u003e\r\n","meta":{"title":"Toekomstmuziek: Hoe tech de muziekindustrie transformeert","description":"De impact van AI en innovaties op artiesten, podia en concertbezoek.","image":null},"publish_date":{"timestamp":1737496254,"machine":"2025-01-21T21:50:54+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Technologie","src":"https://d12y285rxlbnxt.cloudfront.net/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=3IXut4AI","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=EhmCrdjD","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=Y5ERQ4H7","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=6EJluoj2","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=UWg_3Q9z","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=d2-40cvj"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=3IXut4AI 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=EhmCrdjD 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=Y5ERQ4H7 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=6EJluoj2 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=UWg_3Q9z 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-01/markus-spiske-Skf7HxARcoc-unsplash.png?itok=d2-40cvj 720w"]},"source":"Foto: Markus Spiske | Unsplash","source_link":null},"breadcrumb":null,"subtitle":"Door Roeline Machiels","thumbnail_image":{"image":{"alt":"Technologie","src":"https://d12y285rxlbnxt.cloudfront.net/2025-01/thumb.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-01/thumb.jpg?itok=z62ycOoo","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-01/thumb.jpg?itok=oTeRSq3j","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-01/thumb.jpg?itok=8HydNUvI","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-01/thumb.jpg?itok=WWjyoiNj","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-01/thumb.jpg?itok=Twt8x3PP","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-01/thumb.jpg?itok=nN_O1lH1"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-01/thumb.jpg?itok=z62ycOoo 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-01/thumb.jpg?itok=oTeRSq3j 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-01/thumb.jpg?itok=8HydNUvI 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-01/thumb.jpg?itok=WWjyoiNj 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-01/thumb.jpg?itok=Twt8x3PP 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-01/thumb.jpg?itok=nN_O1lH1 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F2CD5C","background_color":"#2E3D50","text_color":"#FFFFFF"},"tags":[],"related_events":[]},{"type":"longread","nid":666,"slug":"/artikelen/de-toekomst-van-muziekbeleving-ai-immersieve-werelden-en-virtueel-geluid","endpoint":"/nl/artikelen/de-toekomst-van-muziekbeleving-ai-immersieve-werelden-en-virtueel-geluid","translations":{"nl":"/artikelen/de-toekomst-van-muziekbeleving-ai-immersieve-werelden-en-virtueel-geluid","en":null},"title":"De toekomst van muziekbeleving: AI, immersieve werelden en virtueel geluid ","content":"\u003cp\u003e\u003ca href=\"https://www.effenaar.nl/nl/future-music-experience-ai-immersive-worlds-and-virtual-sound\" target=\"_blank\"\u003eWant to read this article in English? Hit this link!\u003c/a\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003eTechnologie heeft een transformatief effect op hoe we de wereld om ons heen beleven en de ontwikkelingen komen razendsnel. Apps voor alle wensen, QR-codes die allerlei info en media ontsluiten en 24/7 contact via je devices terwijl we kilometers bij elkaar vandaan zijn. Technologie biedt mogelijkheden die voorheen onmogelijk waren, door de digitale hyperrealiteit steeds meer in te bedden in onze dagelijkse wereld. Die transformatie zie je terug in alle aspecten van ons leven en dus ook in de muziek. Concerten van je favo artiesten beleven via livestreams nam de laatste jaren - mede doordat we thuiszaten vanwege de pandemie - een enorme vlucht. Dat zette ook veel muziekprofessionals aan het denken; wat kan er nog meer? Langzaam omarmen we de nieuwe kansen die technologie ons biedt. Artiesten en makers, maar ook de luisteraar zelf. Wat zijn de mogelijkheden en hoe zet je die in? Het antwoord moet nog blijken, maar zeker is dat er druk wordt geëxperimenteerd.\u003c/p\u003e\r\n","meta":{"title":"De toekomst van muziekbeleving: AI, immersieve werelden en virtueel geluid ","description":"Lees hier het hele artikel.","image":null},"publish_date":{"timestamp":1694639722,"machine":"2023-09-13T21:15:22+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"hiigo hybrid music vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/hiigohuismeta.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuismeta.png?itok=Wkn2sUam","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/hiigohuismeta.png?itok=9jp_EJNu","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/hiigohuismeta.png?itok=Ms243jK8","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/hiigohuismeta.png?itok=KKXeTEh5","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/hiigohuismeta.png?itok=fZuhEGnW","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/hiigohuismeta.png?itok=ZpAFobjv"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuismeta.png?itok=Wkn2sUam 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/hiigohuismeta.png?itok=9jp_EJNu 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/hiigohuismeta.png?itok=Ms243jK8 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/hiigohuismeta.png?itok=KKXeTEh5 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/hiigohuismeta.png?itok=fZuhEGnW 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/hiigohuismeta.png?itok=ZpAFobjv 720w"]},"source":"Ontwerp: eerste schets Hiigo-huis ","source_link":null},"breadcrumb":null,"subtitle":"Door Guido Segers","thumbnail_image":{"image":{"alt":"hiigo hybrid music vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/hiigohuisthumb.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuisthumb.png?itok=Tp3RVrwc","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/hiigohuisthumb.png?itok=rjk56Kt6","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/hiigohuisthumb.png?itok=dvwG1sA4","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/hiigohuisthumb.png?itok=7JKSQnAz","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/hiigohuisthumb.png?itok=EF--jaCL","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/hiigohuisthumb.png?itok=tBGgjZqc"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuisthumb.png?itok=Tp3RVrwc 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/hiigohuisthumb.png?itok=rjk56Kt6 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/hiigohuisthumb.png?itok=dvwG1sA4 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/hiigohuisthumb.png?itok=7JKSQnAz 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/hiigohuisthumb.png?itok=EF--jaCL 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/hiigohuisthumb.png?itok=tBGgjZqc 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#A61C68","background_color":"#9BB9BF","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":1385,"slug":"/artikelen/op-comic-trip-met-sylvie-kreusch-volwassen-worden-misschien-wel-mijn-grootste-angst","endpoint":"/nl/artikelen/op-comic-trip-met-sylvie-kreusch-volwassen-worden-misschien-wel-mijn-grootste-angst","translations":{"nl":"/artikelen/op-comic-trip-met-sylvie-kreusch-volwassen-worden-misschien-wel-mijn-grootste-angst","en":null},"title":"Op Comic Trip met Sylvie Kreusch: “Volwassen worden is misschien wel mijn grootste angst”","content":"\u003cp\u003eVorig jaar liet Sylvie Kreusch het publiek nog verliefd achter op Hit The City festival. Op woensdag 9 april keert de koningin van de Belgische artpop terug naar Eindhoven voor een show in onze Grote Zaal, dit keer met een gloednieuw album onder de arm. Na het ultieme heartbreak-album 'Montbray' gooit ze het roer om: haar vurige rode lokken maken plaats voor blond, haar mysterieuze imago als nachtschim van België verruilt ze voor een plek achter het stuur – met haar geliefde naast zich. Haar nieuwe reis begint op ‘Comic Trip’, en waar beter te starten dan bij het begin van alles: de kindertijd?\u003c/p\u003e\r\n","meta":{"title":"Op Comic Trip met Sylvie Kreusch: “Volwassen worden is misschien wel mijn grootste angst”","description":"Lees het interview met Sylvie Kreusch op het platform SPACES van Effenaar.","image":null},"publish_date":{"timestamp":1742390264,"machine":"2025-03-19T13:17:44+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Sylvie Kreusch","src":"https://d12y285rxlbnxt.cloudfront.net/2025-03/4%20Sylvie%20bw.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/4%20Sylvie%20bw.png?itok=HwDCTwIS","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/4%20Sylvie%20bw.png?itok=0SnO9_Fz","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/4%20Sylvie%20bw.png?itok=LoVpZi6F","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/4%20Sylvie%20bw.png?itok=K1mHKuD5","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/4%20Sylvie%20bw.png?itok=xMIMCP8I","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/4%20Sylvie%20bw.png?itok=BaL24wZv"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/4%20Sylvie%20bw.png?itok=HwDCTwIS 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/4%20Sylvie%20bw.png?itok=0SnO9_Fz 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/4%20Sylvie%20bw.png?itok=LoVpZi6F 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/4%20Sylvie%20bw.png?itok=K1mHKuD5 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/4%20Sylvie%20bw.png?itok=xMIMCP8I 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/4%20Sylvie%20bw.png?itok=BaL24wZv 720w"]},"source":null,"source_link":null},"breadcrumb":null,"subtitle":"Door Renia Heeringa","thumbnail_image":{"image":{"alt":"Sylvie Kreusch","src":"https://d12y285rxlbnxt.cloudfront.net/2025-03/thumbsylvie_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/thumbsylvie_0.png?itok=jWjE54_i","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/thumbsylvie_0.png?itok=Uc6GWMqi","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/thumbsylvie_0.png?itok=bnL4HO4W","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/thumbsylvie_0.png?itok=qUCt2mgL","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/thumbsylvie_0.png?itok=P_8jCddR","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/thumbsylvie_0.png?itok=Xl8I-Ko-"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-03/thumbsylvie_0.png?itok=jWjE54_i 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-03/thumbsylvie_0.png?itok=Uc6GWMqi 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-03/thumbsylvie_0.png?itok=bnL4HO4W 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-03/thumbsylvie_0.png?itok=qUCt2mgL 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-03/thumbsylvie_0.png?itok=P_8jCddR 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-03/thumbsylvie_0.png?itok=Xl8I-Ko- 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#428C6A","background_color":"#E7D5F2","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":773,"slug":"/artikelen/jett-rebels-decennium-van-venus-en-strijd-tot-de-kunst-van-mens-zijn-en-een-nieuw-album","endpoint":"/nl/artikelen/jett-rebels-decennium-van-venus-en-strijd-tot-de-kunst-van-mens-zijn-en-een-nieuw-album","translations":{"nl":"/artikelen/jett-rebels-decennium-van-venus-en-strijd-tot-de-kunst-van-mens-zijn-en-een-nieuw-album","en":null},"title":"Jett Rebel's decennium: Van 'Venus' en strijd, tot de kunst van mens-zijn en een nieuw album","content":"\u003cp\u003eDe muzikale duizendpoot Jelte Tuinstra staat alweer tien jaar op de bühne onder de welbekende naam Jett Rebel, en dat gaat hij groots vieren. Op zondag 10 december trakteert hij Eindhoven op een spektakel tijdens zijn Super Sweet 10 Year Anniversary Tour, een show vol al zijn muzikale hoogtepunten. Samen met Jelte nemen we alvast een duik in de afgelopen tien jaar en zijn nieuwe dromen: van een breuk met zijn platenlabel en een nieuw album, tot Picasso en de kunst van mens zijn.\u003c/p\u003e\r\n","meta":{"title":"Jett Rebel's decennium: Van 'Venus' en strijd, tot de kunst van mens-zijn en een nieuw album","description":"Lees hier het hele interview.","image":null},"publish_date":{"timestamp":1701262984,"machine":"2023-11-29T13:03:04+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Jett Rebel","src":"https://d12y285rxlbnxt.cloudfront.net/2023-11/Header%20website.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-11/Header%20website.png?itok=n_lnFDc7","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-11/Header%20website.png?itok=HJ2hq7pl","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-11/Header%20website.png?itok=0-QGAeJK","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-11/Header%20website.png?itok=Dx2FpY8T","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-11/Header%20website.png?itok=QCGOMDu8","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-11/Header%20website.png?itok=Lmh_SEwr"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-11/Header%20website.png?itok=n_lnFDc7 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-11/Header%20website.png?itok=HJ2hq7pl 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-11/Header%20website.png?itok=0-QGAeJK 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-11/Header%20website.png?itok=Dx2FpY8T 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-11/Header%20website.png?itok=QCGOMDu8 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-11/Header%20website.png?itok=Lmh_SEwr 720w"]},"source":null,"source_link":null},"breadcrumb":null,"subtitle":"Door Roeline Machiels","thumbnail_image":{"image":{"alt":"Jett Rebel","src":"https://d12y285rxlbnxt.cloudfront.net/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=jOnwKktD","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=11e_lgWH","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=8R5BU2HY","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=bOQo4bnY","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=FtE6Ql5j","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=04J2jswc"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=jOnwKktD 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=11e_lgWH 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=8R5BU2HY 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=bOQo4bnY 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=FtE6Ql5j 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-11/Jett_Rebel_6A1007_1%5B83%5D.png?itok=04J2jswc 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#EBD8A2","background_color":"#737151","text_color":"#FFFFFF"},"tags":[],"related_events":[]}]}}],"subtitle":"Door Guido Segers","thumbnail_image":{"image":{"alt":"Music AI","src":"https://d12y285rxlbnxt.cloudfront.net/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=EKGehyYX","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=EPkk07yO","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=hcI0MfWI","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=yk6B9_a3","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=UCS_ZJiU","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=0rAjvNUB"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=EKGehyYX 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=EPkk07yO 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=hcI0MfWI 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=yk6B9_a3 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=UCS_ZJiU 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-04/techivation-EaZdLOxkcpI-unsplash.jpg?itok=0rAjvNUB 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#C5D9D9","background_color":"#262626","text_color":"#FFFFFF"},"tags":[],"related_events":[]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724635234,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"LongReads-toekomstmuziek-ai-als-nieuwe-artiest-nl","queryHash":"[\"LongReads-toekomstmuziek-ai-als-nieuwe-artiest-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"page","nid":697,"slug":"/future-music-experience-ai-immersive-worlds-and-virtual-sound","endpoint":"/nl/future-music-experience-ai-immersive-worlds-and-virtual-sound","translations":{"nl":"/future-music-experience-ai-immersive-worlds-and-virtual-sound","en":null},"title":"The future of music experience: AI, immersive worlds and virtual sound ","content":"\u003cp\u003eTechnology has a transformative effect on how we experience the world around us and developments are coming at lightning speed. Apps for all wishes, QR codes that unlock all kinds of information and media and 24/7 contact via your devices while we are miles away from each other. Technology offers possibilities that were previously impossible, by increasingly embedding digital hyperreality in our daily world. This transformation is reflected in all aspects of our lives and therefore also in music. Experiencing concerts of your favorite artists via livestreams has taken off in recent years - partly because we were at home because of the pandemic. This also got a lot of music professionals thinking; What else can be done? We are slowly embracing the new opportunities that technology offers us. Artists and makers, but also the listener himself. What are the possibilities and how do you use them? The answer remains to be seen, but it is certain that there is a lot of experimentation. \u003c/p\u003e\r\n","meta":{"title":"The future of music experience: AI, immersive worlds and virtual sound ","description":"Click here to read more about the future of music and technology.","image":{"image":{"alt":"hiigo hybrid music vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/hiigohuismeta.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuismeta.jpg?itok=JqvfpbZ4","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/hiigohuismeta.jpg?itok=kGQ7HLKG","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/hiigohuismeta.jpg?itok=W9ezpWRD","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/hiigohuismeta.jpg?itok=TdUFB8Dv","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/hiigohuismeta.jpg?itok=ii0WuqyH","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/hiigohuismeta.jpg?itok=QbGmGCuY"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuismeta.jpg?itok=JqvfpbZ4 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/hiigohuismeta.jpg?itok=kGQ7HLKG 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/hiigohuismeta.jpg?itok=W9ezpWRD 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/hiigohuismeta.jpg?itok=TdUFB8Dv 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/hiigohuismeta.jpg?itok=ii0WuqyH 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/hiigohuismeta.jpg?itok=QbGmGCuY 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1696408355,"machine":"2023-10-04T08:32:35+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"hiigo hybrid music vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/hiigohuismeta.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuismeta.png?itok=Wkn2sUam","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/hiigohuismeta.png?itok=9jp_EJNu","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/hiigohuismeta.png?itok=Ms243jK8","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/hiigohuismeta.png?itok=KKXeTEh5","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/hiigohuismeta.png?itok=fZuhEGnW","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/hiigohuismeta.png?itok=ZpAFobjv"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/hiigohuismeta.png?itok=Wkn2sUam 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/hiigohuismeta.png?itok=9jp_EJNu 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/hiigohuismeta.png?itok=Ms243jK8 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/hiigohuismeta.png?itok=KKXeTEh5 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/hiigohuismeta.png?itok=fZuhEGnW 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/hiigohuismeta.png?itok=ZpAFobjv 720w"]},"source":null,"source_link":null},"breadcrumb":null,"blocks":[{"type":"paragraph","id":"cd616f65-a471-433d-a788-4757684f4a6e","header":{"title":"Changing technology and audience "},"content":{"content":"\u003cp\u003eCurrently, a whole new generation of music consumers is growing up who experience music and media very differently, says Thijs Verhulst, Business Development Manager at Warner Music. \"If you look at younger audiences, you see that young people aged 16 to 18-years-old spend a lot more time on visual media like YouTube Shorts or TikTok. The group that comes next spends a lot more time in gaming worlds. Both their attention span is shorter, but also the expectations of an artist are very different. They expect something they can see, but they also seek a connection based on more than just music.\" So technology is not just a possibility, but a necessity in the changing landscape. We already see examples where technology is used successfully, says Verhulst: \"Think of the virtual ABBA show that runs successfully, or a concert by Travis Scott in the game Fortnite that attracted 27.7 million visitors - and gave a boost to its chart listing. Closer to home, artist Coloray won prizes for his audiovisual project 'Future Static'. Anything is possible and you can already see the change.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"afa95660-e363-4d3d-b212-4865896825e7","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/tdcVAUUf0Zw?si=xXL6LgwFSUVF2UNN\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"69a426a0-4c87-423a-97f6-ccf68f2aeb32","header":{"title":"Pioneering and making choices "},"content":{"content":"\u003cp\u003eUntil now, immersion has mainly been used in marketing activities. Presenting yourself broadly as an artist is ultimately key to success. These are also logical opportunities, Verhulst explains. \"By promoting music with more than audio, you simply increase visibility, but you can also stand out in a market where there is a lot. In addition, it is very important that you can connect with fans on a level of shared values, which creates bonding. A big part is pioneering, especially when it comes to an integration into being an artist. It's a blank canvas in that sense.\"\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eGreat artists are already playing around with the possibilities. Drake, for example, has a bizarre shop, where you can look around his house 'The Embassy' and click on products. This way you buy the same fridge magnets as the rapper - from which he probably makes some money. Several stars explored the possibilities of VR, and Dua Lipa and Ellie Golding used AR in promotional campaigns. Verhulst expects that in the coming years this technology will be increasingly embraced by the music world. Moving along and exploring possibilities are therefore very important for artists themselves: \"If you as an artist are not working on this, it will be difficult to get your career off the ground in a few years. Now you mainly see big artists who do a lot with this. That is why it is also about looking for what works for you as an artist, and how you can link a revenue model to it. You can't do everything, like a global star like Dua Lipa who has the support of a huge team for this. There is no one-size-fits-all model, every artist has to find what works for them.\"\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"bc68fc60-fac1-472d-a935-67fe95b6a15e","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/oWq_UARVOo0?si=yyCBRQtlBLGMbHtj\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"e5e20959-4a0b-46bb-8964-9735584e14c9","header":{"title":"A space to experiment "},"content":{"content":"\u003cp\u003eNot only the big stars are exploring the boundaries of technology, in Eindhoven there is also a lot of experimentation going on. To make technology accessible to artists, Effenaar founded Effenaar Lab in 2018. Effenaar Lab functions as a makerspace, where artists gain knowledge and can experiment with VR, AR and streaming. Incredibly valuable pioneering work, for the artists and the industry, says Verhulst. \"It is very important that we make the knowledge about what is possible available to artists. For me, it's also a kind of benchmarking; find out what artists their stance is and how they think about this. Because they are given the creative space, many original ideas arise, from which I get inspiration.\"\u0026nbsp;\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eOne of the trajectories within Effenaar Lab is the Hybrid Music Vibes program. Last March, the second edition of the program started with a new group of artists. After a series of knowledge sessions with experts, the artists got to work themselves and developed their own concept. Of these, six artists were chosen by a professional jury and the public to realize that concept. Together with specialists, they are working on their own project to strengthen their artistry. Many possibilities, but also many questions: How can you strengthen fan experience and connection? How can you enrich audiovisually? And how do you use technology in a cost-effective way? Artists RHIANNIN, De Toegift, Julia Sabaté, Max Frimout, Hiigo and PXPLE JAZZ explore the answers to these questions with their concepts.\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"5201bf3d-4d8d-495f-b823-22b4f8f9a6eb","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"Julia sabate hmv","src":"https://d12y285rxlbnxt.cloudfront.net/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=LO9Xzjii","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=Vm1x9Mx4","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=8qUMod6d","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=kkdnPEWz","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=uVVuaUOi","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=NUApCraR"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=LO9Xzjii 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=Vm1x9Mx4 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=8qUMod6d 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=kkdnPEWz 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=uVVuaUOi 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96151_DEF-lr_0.png?itok=NUApCraR 720w"]},"source":"Photo: Max Kneefel | Julia Sabaté","source_link":null},{"image":{"alt":"hiigo hmv","src":"https://d12y285rxlbnxt.cloudfront.net/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=RkTU3jIB","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=P-hTrOoT","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=3zrNjPJX","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=jcVaN5af","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=ya5HlStt","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=GmlAHZdb"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=RkTU3jIB 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=P-hTrOoT 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=3zrNjPJX 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=jcVaN5af 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=ya5HlStt 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_96216_DEF-lr_0.png?itok=GmlAHZdb 720w"]},"source":"Photo: Max Kneefel | Hiigo, Aart de Gier","source_link":null},{"image":{"alt":"Pxrple jazz hybrid music vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=QoqAAeNb","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=sV5xBur-","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=ILJoKsXH","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=9lkSrLd_","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=kgt5ikfu","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=ebPnAyR2"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=QoqAAeNb 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=sV5xBur- 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=ILJoKsXH 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=9lkSrLd_ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=kgt5ikfu 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95482_DEF-lr.png?itok=ebPnAyR2 720w"]},"source":"Photo: Max Kneefel | PXRPLE JAZZ","source_link":null},{"image":{"alt":"Rhiannin hmv","src":"https://d12y285rxlbnxt.cloudfront.net/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=TqgyypG3","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=xSfyPmxt","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=k-7zvsR1","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=SXbFsy27","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=10PHF6UZ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=REFQEj5b"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=TqgyypG3 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=xSfyPmxt 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=k-7zvsR1 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=SXbFsy27 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=10PHF6UZ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95638_DEF-lr_0.png?itok=REFQEj5b 720w"]},"source":"Photo: Max Kneefel | RHIANNIN","source_link":null},{"image":{"alt":"De Toegift Hybrid Music Vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=SoQAnTix","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=21i_p6rA","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=w60_FW3U","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=QN1uGauW","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=Ze2azecr","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=7TGsfoHc"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=SoQAnTix 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=21i_p6rA 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=w60_FW3U 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=QN1uGauW 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=Ze2azecr 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_94987_DEF-lr_0.png?itok=7TGsfoHc 720w"]},"source":"Photo: Max Kneefel | De Toegift, Tom Gudde","source_link":null},{"image":{"alt":"max frimout hmv","src":"https://d12y285rxlbnxt.cloudfront.net/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=Dt4_LVCI","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=MnjO2GqY","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=WRmPtdzH","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=-bDSeyJP","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=wuJUsCUk","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=bL6Eglg8"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=Dt4_LVCI 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=MnjO2GqY 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=WRmPtdzH 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=-bDSeyJP 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=wuJUsCUk 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/20230411_HMV_MAXKNEEFEL_95268_DEF-lr_0.png?itok=bL6Eglg8 720w"]},"source":"Photo: Max Kneefel | Max Frimour","source_link":null}]}},{"type":"paragraph","id":"94ca5d3a-0a9f-44d7-8937-fb7f320bd8d1","header":{"title":"Audience and AI as co-creator during live shows "},"content":{"content":"\u003cp\u003eJulia Sabaté is not so much a band. It is a project by Julia Sabaté, Ruben Sieben and Koen Hermans, of which Sabaté is the face. The trio is very future-oriented, they see technology as a tool to strengthen their (live) act. Sabaté has Spanish roots and often sings in Spanish. In her opinion, this creates a distance between her and the Dutch concertgoers. \"It makes it more difficult to convey the story, although listeners can often feel and experience the emotion. Our idea is to use visuals for that.\" The group joined forces with Bureau Moeilijke Dingen to further develop this. The first ideas varied a lot, but in the end it was decided to use generative artificial intelligence for the visuals. The audience can submit images, which are fed to the algorithm, making the audience co-creator of the show. This is then applied to one song in the setlist, says Sieben. \"You can't have people sent pictures for a whole show, that's going to be way too busy. We are looking for a VJ and for one song it will generate visuals with the submitted images. In retrospect, you could also generate revenue with that image, but we want to look at that in the future. The most important thing is that what we're doing now is something we can do well and strengthen our act.\"\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eThe group has a strong pro-technological stance, which they say is part of how Julia Sabaté operates and approaches the artistry. Sabaté sees Hybrid Music Vibes as a reality check regarding the future: \"So much is possible. You have to want to understand what's coming and be able to place that in your profession and what opportunities it offers you as an artist.\" On stage, it's still about playing the songs well and delivering a strong performance. Technology helps with this, and especially enriches the toolkit that you have as an artist, says Sieben: \"As an artist, you want to keep up with the times. That's sometimes in your style, but also in terms of technology. For example, artificial intelligence is now super current and offers many opportunities, but you have to know what it can do. Technology can take a lot of work off your hands, like in our live set, but as an artist you're still in control.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"b544f72e-26c5-461f-a51b-6f372be60028","header":{"title":"A virtual meetingplace "},"content":{"content":"\u003cp\u003eTechnology offers possibilities during shows, but also outside of them. It gives several options to stay in touch with fans or to present yourself more broadly and personally as an artists something that appeals to PRXPLE JAZZ, Hiigo, RHIANNIN and De Toegift.\u0026nbsp;\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eThe Dutch band Hiigo started off with an idea to bring their artwork to life with VR/AR glasses during live shows. After the knowledge sessions, the group concluded that a different course was better, says singer Hans van der Werf. \"That was of course unfeasible in terms of costs and organization. Then we were immersed in the world of holograms and metaverse.\" From the original idea, only the artwork of Laura Gardebroek – the sister of drummer Koen – remained in the new plan. \"Our central concept is togetherness, the feeling of home. We want to create an environment where our fans can experience that, watch how we do things and how seriously we take it. For example, how all the artwork by Laura is made with real dedication, that we work with passionate video makers, and how everything is intertwined. I don't like the flat, commercial representation of artists. I just want to show authenticity. That's why we're looking for opportunities in our project for depth and connection with our fans.\"\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"2356c0b5-383e-4b56-bd0f-0bccb3c6b8d5","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"hiigo Hybrid Music Vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/Huis.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/Huis.png?itok=xlRb0OFE","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/Huis.png?itok=3hYq0nlN","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/Huis.png?itok=IeO9LQN5","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/Huis.png?itok=ovSiYrtA","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/Huis.png?itok=gGA4SQ5G","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/Huis.png?itok=5FB3AprZ"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/Huis.png?itok=xlRb0OFE 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/Huis.png?itok=3hYq0nlN 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/Huis.png?itok=IeO9LQN5 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/Huis.png?itok=ovSiYrtA 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/Huis.png?itok=gGA4SQ5G 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/Huis.png?itok=5FB3AprZ 720w"]},"source":"Picture: design Hiigo house","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"58666f20-7bb3-4b51-bf02-4f5ee5f70aa2","header":{"title":null},"content":{"content":"\u003cp\u003eTogether with partner organizations, a virtual house is being developed. After purchasing a physical product, fans get access. \"You can view and explore the artwork, but also listen to demos in Koen's office. There are also holograms of us, which are being developed by Dutch Rose Media, and hopefully we can offer even more in the future. It's going to be very special.\" The band wants to continue to develop the house into a meeting place for fans and themselves. \"A community of fans and musicians who love what they do\".\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eSinger PXRPLE JAZZ also wants to create a stronger bond with her fans with her concept. The singer sees music as part of the bigger picture and that is the performance. \"I see myself as an artist who creates an atmosphere and move. I am very visual in this and that happens naturally to me. This means that I look at the lights, visuals, dance and dancers, but also the message as a whole. All the skills I have come together to make something.\" It certainly helps to have a broad skillset, and to continue to broaden it as an artist.\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eShe was already aware of the technical possibilities, and previously experimented with visuals and 3D at live shows. But this time she is going for the realization of an immersive website. \"You can try things yourself, and that's very valuable, but you don't want to miss the mark when you hire professionals. It is therefore very important to ask yourself what works for you and what you want to achieve with it. For me, that was connecting with fans. I am active on social media, but everything is fragmented. I'd like to bring that together.\" Through gamified elements, users can discover more about PXRPLE JAZZ in a playful way. For the realization of the website she works together with arfected and her own team. The website is still in development, so no spoilers, but the goal is clear for Jazz: \"I hope this will help fans to feel more connected with me, but also to have easier contact with each other.\"\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"dbecf54d-e3c1-41bf-8a5f-64738b5690ef","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"PXRPLE JAZZ","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/pxrplejazz_conceptvisual1.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=uAdxKjlI","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=8UcBiTDS","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=UA99ya-V","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=PJ2VUAK4","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=ubOAOQ13","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=jthoS0-I"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=uAdxKjlI 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=8UcBiTDS 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=UA99ya-V 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=PJ2VUAK4 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=ubOAOQ13 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/pxrplejazz_conceptvisual1.png?itok=jthoS0-I 720w"]},"source":"Picture: sketch immersive landscape PXRPLE JAZZ","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"4ff78038-0e85-49a6-9f62-a1090595c371","header":{"title":"Multiple dimensions "},"content":{"content":"\u003cp\u003eWith the project RHIANNIN, singer Rianne Wilbers wants to express herself in all facets of her work, which she translates within Hybrid Music Vibes to a virtual diorama. \"My vision is an aesthetic overall picture, in which Icelandic artist Björk is my great inspiration. Her work is instantly recognizable in everything she does, from her sound to clothing and artwork. RHIANNIN is that to me; An identity in which my art, music and myself form one image.\" In collaboration with arfected, Wilbers is working on an immersive environment, where people can experience her music and paintings and walk through them. Wilbers is not a techie herself, so she made a book with cut-out pages as inspiration to illustrate what she had in mind for the technicians.\u0026nbsp;\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eTransforming your art into a world with a virtual character also means asking questions about your work. \"A lot of image formatting and generation can be done with artificial intelligence (AI), but I want to keep the feeling of authentic craftsmanship and make sure that my style comes back. There's a lot of jokes in there, and surrealism, so I want to come up with that myself and not generate it. But for example, I had a painting of a bird, where one wing is cut off and you can complete that for the website with generative AI. So much is uncharted territory for everyone, but it is a huge enrichment of my artistry and the journey of discovery for me of what RHIANNIN is and will become.\"\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"d3f5a3a2-6cae-4b3a-b658-dd5169a677b7","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"RHIANNIN","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/rhiannin_conceptvisual1.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/rhiannin_conceptvisual1.png?itok=oqYv6AiP","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/rhiannin_conceptvisual1.png?itok=JY4AnkdG","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/rhiannin_conceptvisual1.png?itok=N1CtGO62","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/rhiannin_conceptvisual1.png?itok=u_amlt_2","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/rhiannin_conceptvisual1.png?itok=Gz5uXYHT","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/rhiannin_conceptvisual1.png?itok=7baw1FU7"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/rhiannin_conceptvisual1.png?itok=oqYv6AiP 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/rhiannin_conceptvisual1.png?itok=JY4AnkdG 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/rhiannin_conceptvisual1.png?itok=N1CtGO62 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/rhiannin_conceptvisual1.png?itok=u_amlt_2 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/rhiannin_conceptvisual1.png?itok=Gz5uXYHT 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/rhiannin_conceptvisual1.png?itok=7baw1FU7 720w"]},"source":"Picture: design virtual diorama RHIANNIN","source_link":null},{"image":{"alt":"RHIANNIN","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=ibOg-6gJ","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=pgc2c9yn","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=tumH-n99","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=dZTipBVZ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=nePvoXxF","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=emgmjBox"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=ibOg-6gJ 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=pgc2c9yn 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=tumH-n99 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=dZTipBVZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=nePvoXxF 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.55.54%20%281%29.png?itok=emgmjBox 720w"]},"source":"Photo: Robbie van Hek | RHIANNIN and her art","source_link":null}]}},{"type":"paragraph","id":"6fda3270-ab96-43ca-bc41-caf447faaad0","header":{"title":"Not necessarily the most 'cutting edge'"},"content":{"content":"\u003cp\u003eThe Dutch band De Toegift also creates a virtual world, but also takes into account the character of their work and being. \"We're actually an old-fashioned band, so exploring the possibilities technology offers within Hybrid Music Vibes program is special. Our performances have little fuss; We are a group of musicians on stage and we play vulnerable music that draws on folk, jazz, pop and rock. This creates a vulnerable and intimate relationship with the audience, which we want to preserve. But we stepped in with an open mind,\" says keyboardist and guitarist Tom Gudde. De Toegift is enthusiastic about how many aspects and angles technology offers, but it has to match who they are. \"I don't see De Toegift using LED screens or VR/AR applications that disrupt the experience between us and the audience.\"\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eHowever, there is still a lot to be gained for the band outside the stage, which they hope to find an answer to with technology. \"Our music touches people and we see that they often stick around to talk to us, but that time is limited.\" The plan became to develop a virtual environment, which fans can access via a QR code at shows. Here they can ask questions, share emotions or experiences and thus build a connection with the band. Gudde hopes that this environment will help to strengthen the relationship with fans, and that is precisely in the qualitative one-on-one interactions with fans. \"With this project we create a safe environment, where we can take all the time for that contact a day or week later. I am always very curious about what people have to say and I also like to receive new stories. That goes for the rest of the band as well, and it fits who we are as well. We hope to use this as a pilot during our autumn tour and we are very curious to see what it brings us.\"\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"fe519fa9-ff94-44a2-81a8-44b4311ab92e","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"De Toegift","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=8ulxkpTk","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=i6m7nMY0","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=WCXxLu78","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=2agwK3Zw","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=XdteI4y2","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=jXRb7jRA"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=8ulxkpTk 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=i6m7nMY0 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=WCXxLu78 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=2agwK3Zw 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=XdteI4y2 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/WhatsApp%20Image%202023-09-12%20at%2017.35.04%20%285%29.png?itok=jXRb7jRA 720w"]},"source":"Photo: Robbie van Hek | Tom Gudde from De Toegift working on the concept","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"10452cee-0f98-4033-941b-cf5557173ff1","header":{"title":null},"content":{"content":"\u003cp\u003eFor the realization of the interactive environment, De Toegift works together with augmented reality experts Dutch Rose Media. Sparring about the choices in the project got Gudde thinking: \"We had the first kick-off and it is very interesting, because you have technicians who have all the possibilities and trends on top of their mind. My role as a creative means that I have to give it a purpose and style and that means making choices. Sometimes also against the trends. One example is that they indicated that everything is video nowadays, but I opted for a text-based interaction. There's a romance to letters and the written word that fits De Toegift.\" Gudde is aware that De Toegift does not opt for an application that uses the most 'cutting edge' possibilities. He is certainly aware of the changes that are coming, but above all sees the need for customization: \"We are a different kind of band.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"446fcfe5-5ff0-4d5f-82a3-9e27fdf8219a","header":{"title":"Sound as a virtual space "},"content":{"content":"\u003cp\u003eMost people think of virtual reality as visual, but artist Max Frimout thinks this is a limited view of what VR means. He finds sound much more interesting and how it interacts with your physical positioning as a listener: \"There are all kinds of applications that play with a virtual environment. This can be a treadmill that gives you the feeling of movement, but also tactile interaction. If you are going to watch sound from a virtual space, then anything is possible. I find the spatial aspect of sound very special.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"9235079f-2569-4bf4-aa52-a77edfa2317b","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Max Frimout Hybrid Music Vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=rzVg6Fy3","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=FYYCLQ2E","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=Mk2OoGDN","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=KJnbncpA","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=rlttrBrg","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=XBfwvvzY"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=rzVg6Fy3 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=FYYCLQ2E 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=Mk2OoGDN 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=KJnbncpA 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=rlttrBrg 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/WhatsApp%20Image%202023-09-08%20at%2010.15.04.png?itok=XBfwvvzY 720w"]},"source":"Photo: Robbie van Hek | Max Frimout in his workroom","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"5841381b-817f-43a1-a826-e3cf80f4fe32","header":{"title":null},"content":{"content":"\u003cp\u003eDuring Hybrid Music Vibes, Frimout will further develop the concept of the Odio app. Odio was developed by a team of innovators, including Frimout, for the AirPods, according to Frimout one of the best VR devices available. The app allows the user to create a kind of live remix of how sound is coming at them. But how that really works is complicated. The musician picks up an old mixing console: \"Look, reproducing sound in stereo used to be completely new. Before that, you had mono, where the sound comes from one point. But with stereo sound, new ways of setting up a sound experience arose, because you have two points. I have an old stereo mixer here, with which I can adjust how all the elements in that stereo sound come to me as a listener and in what balance. That's also the idea with virtual sound in the Odio app, where the speakers make it possible to simulate sound from all sides of the room around you. As a user, you can place all sound elements in the space around you as you wish.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"29d833e4-e5f8-4f7f-afc7-447749852d62","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Max Frimout Hybrid Music Vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/Virtual%20Sky.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/Virtual%20Sky.png?itok=JCs3i3Gc","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/Virtual%20Sky.png?itok=Uke_-mLU","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/Virtual%20Sky.png?itok=Iu3pKiTP","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/Virtual%20Sky.png?itok=CikNuDK8","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/Virtual%20Sky.png?itok=6cbzTI3B","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/Virtual%20Sky.png?itok=wYXqft4J"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/Virtual%20Sky.png?itok=JCs3i3Gc 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-09/Virtual%20Sky.png?itok=Uke_-mLU 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-09/Virtual%20Sky.png?itok=Iu3pKiTP 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-09/Virtual%20Sky.png?itok=CikNuDK8 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-09/Virtual%20Sky.png?itok=6cbzTI3B 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-09/Virtual%20Sky.png?itok=wYXqft4J 720w"]},"source":"Picture: screenshot Odio-app from perskit Odio","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"22220f88-f9bc-492f-9a74-203cb7bf0b27","header":{"title":null},"content":{"content":"\u003cp\u003eTo further develop the concept of Odio, Frimout works together with iOS developer Unbeatable and Odio media. In that respect, it is pioneering work, in which a lot is possible, but where the sound artist also challenges his own artistry: \"For myself, it is fascinating to investigate where sound goes, but also to broaden and deepen myself. It is very special to compose for Odio, because we normally think - in what I call linear structures. But also think of video games, where sound has to work fragmented based on a user's randomness. That's also the case with virtual sound. It would be great if I could eventually do live performances with Odio in that way.\"\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eThe app is already available and became a great success with 150 thousand downloads and even won an Apple Design Award. Why is Odio so successful? Frimout sees several explanations: \"Playing with sound intrigues people, something with being in control. There is also a dimension of personalization to it; Decorate the sound the way you like it best. Anyway, now the app is still a 2d interface, but within the project I want to see what else is possible, now that Apple glasses is coming. For me, it's also a question of whether virtual is just a new tool, or really a game changer in how we think about making music.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"b5088ba7-35c5-44d2-adbb-e2d82076b48c","header":{"title":null},"content":{"content":"\u003ch4\u003eCurious about the Hybrid Music Vibes program? \u003ca href=\"https://www.effenaar.nl/effenaar-lab\" target=\"_blank\"\u003eHere you can find more\u003c/a\u003e about the program and the participating artists. Follow the \u003ca href=\"https://www.instagram.com/effenaarlab/\" target=\"_blank\"\u003eInstagram of Effenaar Lab\u003c/a\u003e if you would like to stay up to date of cool projects and see the results of the experiments.\u003c/h4\u003e\r\n","links":null}}],"subtitle":"Written by Guido Segers","colors":{"accent_color":"#A61C68","background_color":"#7297A6","text_color":"#000000"},"show_header_grid":"grid_tunnel"},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724635836,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"PageDetail-future-music-experience-ai-immersive-worlds-and-virtual-sound-nl","queryHash":"[\"PageDetail-future-music-experience-ai-immersive-worlds-and-virtual-sound-nl\"]"},{"state":{"data":{"statusCode":404,"type":"ERROR"},"dataUpdateCount":1,"dataUpdatedAt":1792724636794,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"PageDetail-hybrid-music-vibes-2-julia-sabate-nl","queryHash":"[\"PageDetail-hybrid-music-vibes-2-julia-sabate-nl\"]"},{"state":{"data":{"statusCode":404,"type":"ERROR"},"dataUpdateCount":1,"dataUpdatedAt":1792724637725,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"PageDetail-hybrid-music-vibes-2-hiigo-nl","queryHash":"[\"PageDetail-hybrid-music-vibes-2-hiigo-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1663,"slug":"/agenda/turkish-pop-night","endpoint":"/nl/agenda/turkish-pop-night","translations":{"nl":"/agenda/turkish-pop-night","en":null},"title":"Turkish Pop Night","content":"\u003cp\u003e(Türkçesi aşağıdadır)\u003c/p\u003e\u003cp\u003eDJ Denden komt terug naar Eindhoven!\u003c/p\u003e\u003cp\u003eVoor iedereen die dammetjes bouwde op straat, het lange Tetris-blok tot het laatst bewaarde, kastanjes roosterde op het fornuis en gek was op die kleine \u003cem\u003eTop Kek\u003c/em\u003e-cakejes...\u003c/p\u003e\u003cp\u003eJe jeugdherinneringen, je eerste liefde, de plek waar je bent opgegroeid, je dromen, je speelgoed. Maak je klaar voor een avond vol plezier en de grootste Turkse hits uit de jaren ’90 en 2000!\u003c/p\u003e\u003cp\u003eNeem je Nederlandse vrienden en familie mee en laten we samen de melodieën delen van de dagen die ons hebben gevormd, toen en nu!\u003c/p\u003e\u003cp\u003e\u003cem\u003eLet op: Turkish Pop Night is 18+! Er kan aan de deur om ID worden gevraagd. Neem een identiteitsbewijs mee.\u003c/em\u003e\u003c/p\u003e","meta":{"title":"Turkish Pop Night | Effenaar","description":"DJ Denden neemt je mee terug naar de jaren 90 en 00! Dans met je vrienden en familie op de grootste Turkse hits.","image":{"image":{"alt":"Turkish pop night","src":"https://d12y285rxlbnxt.cloudfront.net/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=dye69wTC","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=LAmQHcBi","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=bbiuemuM","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=KRa6fq6u","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=U2UOJEZd","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=sw9mf30a"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=dye69wTC 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=LAmQHcBi 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=bbiuemuM 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=KRa6fq6u 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=U2UOJEZd 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=sw9mf30a 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1761310383,"machine":"2025-10-24T12:53:03+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Turkish pop night","src":"https://d12y285rxlbnxt.cloudfront.net/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=dye69wTC","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=LAmQHcBi","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=bbiuemuM","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=KRa6fq6u","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=U2UOJEZd","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=sw9mf30a"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=dye69wTC 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=LAmQHcBi 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=bbiuemuM 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=KRa6fq6u 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?itok=U2UOJEZd 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-10/%20%E2%80%93%201920x1080%20WebsiteTPN.png?it