hMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"PageDetail-favicon.ico-nl","queryHash":"[\"PageDetail-favicon.ico-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1974,"slug":"/agenda/vals-alarm","endpoint":"/nl/agenda/vals-alarm","translations":{"nl":"/agenda/vals-alarm","en":null},"title":"VALS ALARM","content":"\u003cp\u003eDe afgelopen jaren bouwde VALS ALARM gestaag aan een reputatie als één van de meest energieke livebands binnen de alternatieve muziekscene. Van festivals als Best Kept Secret, Down The Rabbit Hole, MadNes en Wildeburg tot shows waar het publiek binnen no-time wordt meegesleurd in de chaos en euforie die de band eigen is.\u003c/p\u003e","meta":{"title":"VALS ALARM","description":"Twee jaar na hun explosieve opkomst is VALS ALARM niet meer weg te denken uit de alternatieve muziekscene. Inmiddels kiest de band voor een iets mysterieuzere koers: minder zichtbaarheid, meer focus op nieuwe muziek. Met uiteenlopende tracks bewijst het trio dat regels er niet toedoen.","image":null},"publish_date":{"timestamp":1785233640,"machine":"2026-07-28T10:14:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"vals alarm header","src":"https://d12y285rxlbnxt.cloudfront.net/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=K2TJUJx1","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=DngWv4ub","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=hX4dEwgc","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-07/%20%E2%80%93%201920x1080%20Website%20vals%20alarm.png?itok=mPe3OQOu","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/