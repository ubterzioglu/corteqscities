w/s3/2026-04/%20%E2%80%93%201920x1080%20WebsiteROLF.png?itok=LjD4xZ1B","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%201920x1080%20WebsiteROLF.png?itok=WRZrcjOj","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%201920x1080%20WebsiteROLF.png?itok=Zo9CAOvy"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%201920x1080%20WebsiteROLF.png?itok=q8GzaHpP 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%201920x1080%20WebsiteROLF.png?itok=axpuxNvU 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%201920x1080%20WebsiteROLF.png?itok=7y3raXJq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%201920x1080%20WebsiteROLF.png?itok=LjD4xZ1B 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%201920x1080%20WebsiteROLF.png?itok=WRZrcjOj 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%201920x1080%20WebsiteROLF.png?itok=Zo9CAOvy 720w"]},"source":null,"source_link":null},"logo":null,"upright_image":null,"background_image":null,"video":{"uri":"https://player.vimeo.com/progressive_redirect/playback/1234029994/rendition/source/file.mp4.mp4?loc=external\u0026signature=fdce3207c9a932c8651b579bc90efb6a90cbb034f3990c97a7422311d6836561","title":"","options":[],"url":"https://player.vimeo.com/progressive_redirect/playback/1234029994/rendition/source/file.mp4.mp4?loc=external\u0026signature=fdce3207c9a932c8651b579bc90efb6a90cbb034f3990c97a7422311d6836561"},"colors":{"accent_color":"#312015","background_color":"#d2bea6","cta_color":"#312015"}}}],"related_events":[{"type":"event","nid":1875,"slug":"/agenda/noah-guthrie-29okt","endpoint":"/nl/agenda/noah-guthrie-29okt","translations":{"nl":"/agenda/noah-guthrie-29okt","en":null},"title":"Noah Guthrie","content":"\u003cp\u003eWanneer je de sound van Chris Stapleton met die van Jason Isbell mengt, krijg je het unieke, soulvolle geluid van Noah Guthrie. De Amerikaanse singer-songwriter begon met covers van verschillende nummers op YouTube. \u003c/p\u003e","meta":{"title":"Noah Guthrie","description":"Wanneer je de sound van Chris Stapleton met die van Jason Isbell mengt, krijg je het unieke, soulvolle geluid van Noah Guthrie. De Amerikaanse singer-songwriter begon met covers van verschillende nummers op YouTube. Zo werd hij bekend bij het grote publiek door zijn eigen blues versie van LMFAO's ''I'm Sexy And I Know It'' (deze cover kreeg maar liefst 28 miljoen views), en groeide hij door tot een multitalent met wereldwijde aanhang. Eerder opende hij ook shows van o.a. Ed Sheeran, Corey Smith en Willie Nelson.","image":null},"publish_date":{"timestamp":1776948538,"machine":"2026-04-23T12:48:58+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"noah guthrieheader","src":"https://d12y285rxlbnxt.cloudfront.net/2026-04/%20%E2%80%93%201920x1080%20Website%20noah%20guthri.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%201920x1080%20Website%20noah%20guthri.png?itok=VOAzNAP-","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%201920x1080%20Website%20noah%20guthri.png?itok=xHSQXFRP","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%201920x1080%20Website%20noah%20guthri.png?itok=f8_AwBoo","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%201920x1080%20Website%20noah%20guthri.png?itok=WiqwRSNG","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%201920x1080%20Website%20noah%20guthri.png?itok=S022GSP0","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%201920x1080%20Website%20noah%20guthri.png?itok=EWKRPyb0"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%201920x1080%20Website%20noah%20guthri.png?itok=