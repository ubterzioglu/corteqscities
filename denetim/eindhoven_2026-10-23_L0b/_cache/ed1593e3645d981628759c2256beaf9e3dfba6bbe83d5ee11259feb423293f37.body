re%20afbeelding%20only.jpg?itok=K2icgAkI 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-02/Bombino%20%E2%80%93%20Square%20afbeelding%20only.jpg?itok=3d5MuarZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-02/Bombino%20%E2%80%93%20Square%20afbeelding%20only.jpg?itok=HDfqwYVW 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-02/Bombino%20%E2%80%93%20Square%20afbeelding%20only.jpg?itok=d3ysjF32 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"Geprezen Desert Blues artiest komt terug naar Eindhoven! | + Ras Dashan","upper_title":null,"tickets":[],"tags":[],"date":{"timestamp":1759622400,"machine":"2025-10-05"},"presale":null,"times":{"starts_at":"20:15","ends_at":null,"opens_at":"19:30"},"locations":[],"facebook_event":null,"genres":[],"club_card_event":true,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":true,"related_events":[]},{"type":"event","nid":1547,"slug":"/agenda/gyasi","endpoint":"/nl/agenda/gyasi","translations":{"nl":"/agenda/gyasi","en":null},"title":"Gyasi","content":"\u003cp\u003eDeze Glam rocker lijkt wel geboren te zijn in een ander universum. Gyasi (spreek uit als Jah-sie) groeide op in de bossen van West Virginia juist die omgeving leek voor hem als een andere planeet. Op zijn 6e kreeg hij van zijn ouders een gitaar en sinds dien is muziek een grote passie en uitlaadklep. Gewapend met zijn gitaar, uitgedost in glamoureuze pakken en een verhaal om te vertellen, geeft Gyasi zijn eigen hedendaagse draai aan de gouden jaren van Rock 'n Roll.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eTijdschema\u003c/strong\u003e\u003cbr\u003e19:30 Deuren open\u003cbr\u003e20:00 - 21:30 Gyasi \u003cbr\u003e(tijden onder voorbehoud) \u003c/p\u003e","meta":{"title":"Gyasi | Effenaar","description":"","image":null},"publish_date":{"timestamp":1754298277,"machine":"2025-08-04T09:04:37+00:00"},"published":true,"sticky":false,"header_image":