":null,"title":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724688525,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-bridge-around-town-zaterdag-nl","queryHash":"[\"AgendaDetail-bridge-around-town-zaterdag-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1970,"slug":"/agenda/gone-country","endpoint":"/nl/agenda/gone-country","translations":{"nl":"/agenda/gone-country","en":null},"title":"Gone Country","content":"\u003cp\u003eTrek die laarzen uit de kast en zet je cowboy hoed op: Gone Country neemt je een avond lang mee naar een authentieke honky-tonk in Nashville! \u003cbr\u003eWat begon als een eenmalig evenement in Amsterdam is in korte tijd uitgegroeid tot een maandelijks terugkerend evenement dat inmiddels door heel Nederland reist. Iedereen is welkom, van beginnende dansers tot doorgewinterde countryfans.\u003cbr\u003eDit is geen ‘dansles’ en het is ook niet ‘gewoon een feestje’. Dit is een avond vol beleving, waarin je even uit je dagelijkse routine stapt, iets nieuws probeert en vooral ontzettend veel plezier beleeft.\u003c/p\u003e","meta":{"title":"Gone Country | Effenaar","description":"Trek je laarzen uit de kast en zet je cowboyhoed maar op; Gone Country brengt op donderdag 26 november line dance naar Effenaar! Met een speelse mix van dansles en party trekt de in Texas geboren line dance instructeur Riley het land rond om de honky-tonks van Nashville naar Nederland te brengen.","image":null},"publish_date":{"timestamp":1784794845,"machine":"2026-07-23T08:20:45+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Gone Country header","src":"https://d12y285rxlbnxt.cloudfront.net/2026-07/%20%E2%80%93%201920x1080%20WebsiteGC.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-07/%20%E2%80%93%201920x1080%20W