1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/War%20On%20Women%20%E2%80%93%20Square%20afbeelding%20only.jpg?itok=9AEqHZmF 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/War%20On%20Women%20%E2%80%93%20Square%20afbeelding%20only.jpg?itok=rNHs74zn 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/War%20On%20Women%20%E2%80%93%20Square%20afbeelding%20only.jpg?itok=x5TIOk2I 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/War%20On%20Women%20%E2%80%93%20Square%20afbeelding%20only.jpg?itok=juEK4-BF 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"Feministische punkformatie | + We Are Joiners","upper_title":null,"tickets":[],"tags":[],"date":{"timestamp":1788393600,"machine":"2026-09-03"},"presale":null,"times":{"starts_at":"20:30","ends_at":null,"opens_at":"19:30"},"locations":[],"facebook_event":{"uri":"https://www.facebook.com/events/938569695729020/?acontext=%7B%22event_action_history%22%3A[%7B%22mechanism%22%3A%22attachment%22%2C%22surface%22%3A%22newsfeed%22%7D]%2C%22ref_notif_type%22%3Anull%7D","title":"","options":{"url":"https://www.facebook.com/events/938569695729020/?acontext=%7B%22event_action_history%22%3A[%7B%22mechanism%22%3A%22attachment%22%2C%22surface%22%3A%22newsfeed%22%7D]%2C%22ref_notif_type%22%3Anull%7D"}},"genres":[],"club_card_event":true,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":true,"related_events":[]},{"type":"event","nid":1895,"slug":"/agenda/accused","endpoint":"/nl/agenda/accused","translations":{"nl":"/agenda/accused","en":null},"title":"The Accüsed","content":"\u003cp\u003eThe Accüsed keert na maar liefst vijftien jaar eindelijk terug op het podium en dat betekent maar één ding: Café The Jack gaat eraan. De legendarische band uit Seattle viert het 40-jarig jubileum van hun cultklassieker 'The Return of Martha Splatterhead' met een show vol smerige riffs, opgefokte hardcorepunk en compromisloze crossover thrash.\u003c/p\u003e","meta":{"title":"The Accüsed | Effenaar","description":"De legendarische crossover thrash/punkband The Accüsed uit Seattle keert in het najaar van 2026 terug naar Europa! Na 15 jaar niet op tour te zijn geweest komen ze terug naar ons continent.","image":null},"publish_date":{"timestamp":1778573485,"machine":"2026-05-12T08:11:25+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"The Accused header","src":"https://d12y285rxlbnxt.cloudfront.net/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=zFKPTy5C","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=NOg197tw","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=FO44tbaz","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=HhTkOwUz","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=mfIAzXMW","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=bovVBb2Q"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=zFKPTy5C 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=NOg197tw 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=FO44tbaz 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/The%20Accused%20%E2%80%93%201920x1080%20Website.jpg?itok=HhTkOwUz 320w","https://d12y285rxlbnxt.cloudfr