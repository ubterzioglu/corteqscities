04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=lt3ZfQCK 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=WSBGu7Vz 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=IXLO9ado 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=waQNUMpd 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#000000","background_color":"#fc7356","text_color":"#000000"}},{"nid":1685,"title":"Dotan","subtitle":"Dromerige folk die zowel groots als intiem voelt","slug":"/agenda/dotan","endpoint":"/nl/agenda/dotan","date":{"timestamp":1792886400,"machine":"2026-10-25"},"thumbnail_image":{"image":{"alt":"dotan square","src":"https://d12y285rxlbnxt.cloudfront.net/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"cta","id":"ef76b68c-daf4-4c5c-837c-0e39ead13120","header":{"title":null,"description":null},"content":{"cta_title":null,"cta_description":null,"url":{"uri":"https://bridgefestival.com/","title":"Wil je meer weten over BRIDGE? Klik hier voor de website.","options":{"url":"https://bridgefestival.com/"}},"description":null,"title":null}},{"type":"paragraph","id":"3c336e76-73ea-444b-8f2b-44531c7b0fb9","header":{"title":null},"content":{"content":"\u003cp\u003eNaast enkele zéér speciale concerten, waarvoor losse tickets gekocht moeten worden, is er van vrijdag 12 t/m zondag 14 mei een vrij toegankelijk stadfestival in het centrum van Eindhoven! Verdeeld over de vijf locaties Café Wilhelmina, Altstadt, De Rozenknop, The Jack en de Kleine Zaal van Effenaar staan er op vrijdag en zaterdag toffe artiesten op het podium. Op zaterdag en zondag komen er op het Wilhelmina- en 18 septemberplein zelfs nog twee buitenpodia bij.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"806de050-e9d0-406a-89d2-32beb5612a44","header":{"title":null},"content":{"content":"\u003cp\u003eMeestergitarist Steve Vai + Metropole Orkest (onder leiding van dirigent Jukka Iisakkila) presenteren op zaterdag 13 mei een hele bijzondere wereldpremière in Muziekgebouw Eindhoven. Op de website van \u003ca href=\"https://www.bridgefestival.com/\"\u003eBRIDGE\u003c/a\u003e kun je hier alles over lezen! En op zondag 14 mei kun je van dit concert ontspannen bijkomen tijdens het optreden van Robin Scherpen in de Paterskerk, waarbij bezoekers worden uitgenodigd om liggend te genieten van zijn muziek. Kaarten voor zowel het concert van Steve Vai als die van Robin Scherpen zijn te koop vanaf aanstaande vrijdag 25 november om 10.00 uur. Voor tickets van Steve Vai + Metropole Orkest klik je\u0026nbsp;hier\u0026nbsp;en als je naar Robin Scherpen wil moet je\u0026nbsp;hier\u0026nbsp;zijn.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"cf36a429-72d4-473f-a2ae-93c261ac2018","header":{"title":null},"content":{"content":"\u003cp\u003eOp de website vind je alle beschikbare informatie over het 360˚gitaarfestival tot nu toe. Vanaf\u0026nbsp;vandaag wordt de website regelmatig aangevuld met nieuwe programmaonderdelen voor\u0026nbsp;BRIDGE, maar\u0026nbsp;we kunnen nu alvast verklappen dat er onder\u0026nbsp;andere een imposante beurs plaatsvindt in\u0026nbsp;Muziekgebouw Eindhoven.\u0026nbsp;Hier kunnen liefhebbers terecht voor de laatste technische snufjes over de\u0026nbsp;gitaar en ook voor het bijwonen van interessante masterclasses en workshops.\u0026nbsp;Daarnaast lanceren we tijdens\u0026nbsp;BRIDGE\u0026nbsp;een boeiende talkshow, getiteld Guitar\u0026nbsp;Inside.\u0026nbsp;De talkshow kan zowel live als online bijgewoond worden en de\u0026nbsp;presentatie is in handen van Eefke Boelhouwers, met Eindhovens gitaar-slimmerik\u0026nbsp;Niels Guns als vaste tafelgast. Wie de overige gasten zijn, wordt in een later\u0026nbsp;stadium bekend. Behalve de beurs, waarover later meer, en Guitar\u0026nbsp;Inside, wordt er met enkele\u0026nbsp;muziekopleidingen, podia en ondernemers hard gewerkt aan een aantal projecten\u0026nbsp;en ook gaan we de wijken in middels huiskamerconcerten. En alsof\u0026nbsp;het allemaal nog niet genoeg is, betrekken we op zondag 14 mei Stadspark\u0026nbsp;Eindhoven bij het festival voor een speciaal Moederdag-programma en worden er gedurende het gehele festival\u0026nbsp;lunchconcerten georganiseerd op bijzondere locaties in de Brainport\u0026nbsp;regio.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"a9ea7b68-c7d7-4b09-b084-e92efeeb2408","header":{"title":null},"content":{"content":"\u003cp\u003eMeer inhoudelijke details over het programma volgen snel, hou de website van BRIDGE hiervoor in de gaten en zorg dat je de sociale media kanalen volgt.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"261a68a3-10e1-418a-9284-4664858e1721","header":{"title":null},"content":{"content":"\u003cp\u003eBR~DGE is een initiatief van Muziekgebouw en Effenaar en wordt mede mogelijk gemaakt door Stichting\u0026nbsp;Brainport.\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eAls mediapartners zijn aan BR~DGE verbonden: Soundz en Gitarist.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"related_event","id":"f66ff8cd-4666-47ca-9f59-d13568fe24dd","header":{"title":null,"description":null},"content":{"items":[{"type":"event","nid":283,"slug":"/agenda/bridge-do-11-mei","endpoint":"/nl/agenda/bridge-do-11-mei","translations":{"nl":"/agenda/bridge-do-11-mei","en":null},"title":"BRIDGE - do 11 mei","content":"\u003cp\u003eEindhoven is een festival rijker: vanaf 10 mei 2023 staat de gitaar 5 dagen lang centraal tijdens het nieuwe \u003ca href=\"https://bridgefestival.com/\"\u003eBRIDGE\u003c/a\u003e! Het meerdaagse, allround gitaarfestival is uniek in zijn soort: van klassiek tot blues, van jazz tot rock, van flamenco tot pop, alles komt aan bod. Livemuziek speelt tijdens BRIDGE een grote rol, vele gitaristen zullen in verschillende formats afreizen naar het festival. Daarnaast worden volop andere programma’s aangeboden zoals workshops, masterclasses, een omvangrijke beurs, huiskamerconcerten en meerdere on- en offline activiteiten. En dat alles onder de noemer van een aantal pijlers: innovatie, educatie, participatie, inclusie en natuurlijk de grote gezamenlijke liefhebberij van de gitaar. Hiermee wordt er voldaan aan de behoefte binnen de gehele Brainport regio: verbinding, mét elkaar, vóór elkaar. Met andere woorden: we slaan van 10 tot en met 14 mei 2023 sámen een brug, BRIDGE is geboren! \u003c/p\u003e\r\n","meta":{"title":"BRIDGE","description":"Eindhoven is een festival rijker: vanaf 10 mei 2023 staat de gitaar 5 dagen lang centraal tijdens het nieuwe BRIDGE! Het meerdaagse, allround gitaarfestival is uniek in zijn soort: van klassiek tot blues, van jazz tot rock, van flamenco tot pop, alles komt aan bod. Livemuziek speelt tijdens BRIDGE een grote rol, vele gitaristen zullen in verschillende formats afreizen naar het festival. Daarnaast worden volop andere programma’s aangeboden zoals workshops, masterclasses, een omvangrijke beurs, huiskamerconcerten en meerdere on- en offline activiteiten. En dat alles onder de noemer van een aantal pijlers: innovatie, educatie, participatie, inclusie en natuurlijk de grote gezamenlijke liefhebberij van de gitaar. Hiermee wordt er voldaan aan de behoefte binnen de gehele Brainport regio: verbinding, mét elkaar, vóór elkaar. Met andere woorden: we slaan van 10 tot en met 14 mei 2023 sámen een brug, BRIDGE is geboren! ","image":null},"publish_date":{"timestamp":1669028400,"machine":"2022-11-21T11:00:00+00:00"},"published":false,"sticky":false,"header_image":{"image":{"alt":"Bridge Gitaarfestival Eindhoven","src":"https://d12y285rxlbnxt.cloudfront.net/2023-01/Header%20BRIDGE%202.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-01/Header%20BRIDGE%202.jpg?itok=lHiuCEx0","1920w":"https://d12y285rxlbnxt.cloudfront.net/