are%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"a60ea00f-391e-428e-bf86-d2ed9f78ae5a","header":{"title":null},"content":{"content":"\u003cp\u003eNu opent\u0026nbsp;VALS\u0026nbsp;ALARM\u0026nbsp;een nieuw hoofdstuk met I.D.I.O.T..\u0026nbsp;Geen albumconcept of strak omlijnd plan, maar een nieuwe golf aan muziek waarin alles mag bestaan. Over jezelf zijn zonder excuses. Over onzekerheid, frustratie, overprikkeling, daten, opbranden en vooral: je niets aantrekken van wat anderen ervan vinden. Met een flinke dosis humor en zelfspot verandert\u0026nbsp;VALS\u0026nbsp;ALARM\u0026nbsp;herkenbare dagelijkse struggles in energieke punktracks die tegelijk grappig, absurd en verrassend raak zijn. De band combineert hun kenmerkende gitaren met synths, pakkende melodieën en een sound die groter klinkt dan ooit, zonder de eigenzinnigheid te verliezen.\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u0026nbsp;\u003c/p\u003e","links":null}},{"type":"embed","id":"e8094e27-c203-4e22-9f4f-93fe52029411","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/VUdaVRs9TL4?si=MF_CA7a7dIUWxplm\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"embed","id":"b045d7ac-3a28-4336-a528-43bd46111ece","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe data-testid=\"embed-iframe\" style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/artist/3q1SvFNWA77vrDRqEpgjbS?utm_source=generator\u0026si=7b5c4359cb50403c\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":337,"dataUpdatedAt":1792724747770,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-vals-alarm-nl","queryHash":"[\"AgendaDetail-vals-alarm-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1922,"slug":"/agenda/wilt","endpoint":"/nl/agenda/wilt","translations":{"nl":"/agenda/wilt","en":null},"title":"wilt","content":"\u003cp\u003ewilt begon ooit als “\u003cem\u003eyour favorite band you’ve never heard of\u003c/em\u003e”,  maar die vlieger gaat inmiddels al een tijdje niet meer op. Met miljoenen streams en een groeiende cultfanbase (de ‘wilters’) is de band uit Los Angeles allesbehalve onder de radar. Debuutsingle 'gwen' ging viral voordat ze zelf doorhadden wat er gebeurde.\u003c/p\u003e","meta":{"title":"wilt in Altstadt","description":"","image":null},"publish_date":{"timestamp":1780390500,"machine":"2026-06-02T08:55:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Wilt header","src":"https://d12y285rxlbnxt