imestamp":1792800000,"machine":"2026-10-24"},"thumbnail_image":{"image":{"alt":"turkish pop night","src":"https://d12y285rxlbnxt.cloudfront.net/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=Tdsk6aD7","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=nS29BMQd","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=lt3ZfQCK","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=WSBGu7Vz","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=IXLO9ado","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=waQNUMpd"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=Tdsk6aD7 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=nS29BMQd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=lt3ZfQCK 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=WSBGu7Vz 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=IXLO9ado 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=waQNUMpd 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#000000","background_color":"#fc7356","text_color":"#000000"}},{"nid":1685,"title":"Dotan","subtitle":"Dromerige folk die zowel groots als intiem voelt","slug":"/agenda/dotan","endpoint":"/nl/agenda/dotan","date":{"timestamp":1792886400,"machine":"2026-10-25"},"thumbnail_image":{"image":{"alt":"dotan square","src":"https://d12y285rxlbnxt.cloudfront.net/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"cta","id":"90233da7-7885-48f6-b763-1b7fa8c15922","header":{"title":null,"description":null},"content":{"cta_title":null,"cta_description":null,"url":{"uri":"https://bridgefestival.com/","title":"Wil je meer weten over BRIDGE? Klik hier voor de website.","options":{"url":"https://bridgefestival.com/"}},"description":null,"title":null}},{"type":"paragraph","id":"07de10d8-46d6-4e26-a7f4-7d18b6e67cef","header":{"title":"BRIDGE programma Effenaar"},"content":{"content":"\u003cp\u003eTijdens BRIDGE vinden er in Effenaar enkele gratis en betaalde evenementen plaats.\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cul\u003e\r\n\t\u003cli\u003e10 mei - \u003ca href=\"https://www.effenaar.nl/nl/agenda/bridge-presents-lunchpauzeconcert\"\u003eLunchpauzeconcert\u0026nbsp;\u003c/a\u003e\u003c/li\u003e\r\n\t\u003cli\u003e10 mei - \u003ca href=\"https://www.effenaar.nl/nl/agenda/bridge-festival-heroes-night\"\u003eRock Heroes Night\u003c/a\u003e\u003c/li\u003e\r\n\t\u003cli\u003e11 mei - \u003ca href=\"https://www.effenaar.nl/nl/agenda/club-void-sum-r\"\u003eClub Void: Sum Of R + Wyatt E\u003c/a\u003e\u003c/li\u003e\r\n\t\u003cli\u003e12 mei - Dig Deeper -\u0026nbsp;Free City Festival\u003c/li\u003e\r\n\t\u003cli\u003e12 mei - Erick Steckel -\u0026nbsp;Free City Festival\u003c/li\u003e\r\n\t\u003cli\u003e12 mei - Dawn Brothers - Free City Festival\u003c/li\u003e\r\n\t\u003cli\u003e13 mei - 8080 (BOBO) -\u0026nbsp;Free City Festival\u003c/li\u003e\r\n\t\u003cli\u003e13 mei - Hawxx - Free City Festival\u003c/li\u003e\r\n\t\u003cli\u003e13 mei - Sisters Of Suffocation -\u0026nbsp;Free City Festival\u003c/li\u003e\r\n\t\u003cli\u003e14 mei - \u003ca href=\"https://www.effenaar.nl/nl/agenda/very-exclusive-afternoon-session-steve-vai\"\u003eAfternoon Session With Steve Vai\u003c/a\u003e - Uitverkocht\u003c/li\u003e\r\n\t\u003cli\u003e14 mei - \u003ca href=\"https://www.effenaar.nl/nl/agenda/club-void-nebula\"\u003eClub Void: Nebula\u003c/a\u003e - €17,50\u003c/li\u003e\r\n\u003c/ul\u003e\r\n","links":null}},{"type":"paragraph","id":"4d939e02-ffd5-433b-9d5e-d95f667ac8c6","header":{"title":"Gratis stadsfestival"},"content":{"content":"\u003cp\u003eNaast enkele zéér speciale concerten, waarvoor losse tickets gekocht moeten worden, is er van vrijdag 12 t/m zondag 14 mei een vrij toegankelijk stadfestival in het centrum van Eindhoven! Verdeeld over de vijf locaties Café Wilhelmina, Altstadt, De Rozenknop, The Jack en de Kleine Zaal van Effenaar staan er op vrijdag en zaterdag toffe artiesten op het podium. Op zaterdag en zondag komen er op het Wilhelmina- en 18 septemberplein zelfs nog twee buitenpodia bij.\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003e\u003cstrong\u003eLine-up (a-z)\u003c/strong\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003e8080 -\u0026nbsp;African Strings \u0026amp; Drums - Alabaster - Anker -\u0026nbsp;Baklawai - Combo Qazam - Dans Dans - Dawn Brothers -\u0026nbsp;Dig Deeper - Ella Zirina -\u0026nbsp; Echo Beatty - Eric Steckel - Erja Lyytinen - Five Great Guitars - Fungistanbul -\u0026nbsp;Ghost Woman - Gwenifer Raymond - Hawxx - Iguana Death Cult – Inge Lamboo - Iron Jinn - Jimmy Diamond - Jornt Duyx - Leif de Leeuw Band - Lifeless Past - Makas - Mariachi Los Tarascos - Merel van Hoek - Michiel Stekelenburg, Trio Onoda - Mohama Saz - Montis, Goudsmit \u0026amp; Directie - Nick Dittmeier \u0026amp; The Sawdusters – Nusantara Beat - Penny - Robin Kester - Roufaida - Severant - Sisters of Suffocation - Sjords van der Mark - Spencer Mackenzie - STACE - Tankzilla – The Guru Guru - To Adelaide - True Champions Ride On Speed - Voltage - William Tyler - Wolf Soup\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eHou BRIDGE in de gaten voor meer namen.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"56e56bb6-ecea-40a9-b21e-c8c4178d1f00","header":{"title":"Betaalde concerten"},"content":{"content":"\u003cp\u003eMeestergitarist Steve Vai + Metropole Orkest (onder leiding van dirigent Jukka Iisakkila) presenteren op zaterdag 13 mei een hele bijzondere wereldpremière in Muziekgebouw Eindhoven. Op de website van \u003ca href=\"https://www.bridgefestival.com/\"\u003eBRIDGE\u003c/a\u003e kun je hier alles over lezen! En op zondag 14 mei kun je van dit concert ontspannen bijkomen tijdens het optreden van Robin Scherpen in de Paterskerk, waarbij bezoekers worden uitgenodigd om liggend te genieten van zijn muziek. Kaarten voor zowel het concert van Steve Vai als die van Robin Scherpen zijn te koop vanaf aanstaande vrijdag 25 november om 10.00 uur. Voor tickets van Steve Vai + Metropole Orkest klik je\u0026nbsp;hier\u0026nbsp;en als je naar Robin Scherpen wil moet je\u0026nbsp;hier\u0026nbsp;zijn.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"266c015f-39dd-4a0f-b114-34df57254584","header":{"title":"360˚gitaarfestival"},"content":{"content":"\u003cp\u003eOp de website vind je alle beschikbare informatie over het 360˚gitaarfestival tot nu toe. Vanaf\u0026nbsp;vandaag wordt de website regelmatig aangevuld met nieuwe programmaonderdelen voor\u0026nbsp;BRIDGE, maar\u0026nbsp;we kunnen nu alvast verklappen dat er onder\u0026nbsp;andere een imposante beurs plaatsvindt in\u0026nbsp;Muziekgebouw Eindhoven.\u0026nbsp;Hier kunnen liefhebbers terecht voor de laatste technische snufjes over de\u0026nbsp;gitaar en ook voor het bijwonen van interessante masterclasses en workshops.\u0026nbsp;Daarnaast lanceren we tijdens\u0026nbsp;BRIDGE\u0026nbsp;een boeiende talkshow, getiteld Guitar\u0026nbsp;Inside.\u0026nbsp;De talkshow kan zowel live als online bijgewoond worden en de\u0026nbsp;presentatie is in handen van Eefke Boelhouwers, met Eindhovens gitaar-slimmerik\u0026nbsp;Niels Guns als vaste tafelgast. Wie de overige gasten zijn, wordt in een later\u0026nbsp;stadium bekend. Behalve de beurs, waarover later meer, en Guitar\u0026nbsp;Inside, wordt er met enkele\u0026nbsp;muziekopleidingen, podia en ondernemers hard gewerkt aan een aantal projecten\u0026nbsp;en ook gaan we de wijken in middels huiskamerconcerten. En alsof\u0026nbsp;het allemaal nog niet genoeg is, betrekken we op zondag 14 mei Stadspark\u0026nbsp;Eindhoven bij het festival voor een speciaal Moederdag-programma en worden er gedurende het gehele festival\u0026nbsp;lunchconcerten georganiseerd op bijzondere locaties in de Brainport\u0026nbsp;regio.\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eMeer inhoudelijke details over het programma volgen snel, hou de website van BRIDGE hiervoor in de gaten en zorg dat je de sociale media kanalen volgt.\u003c/p\u003e\r\n\r\n\u003cp\u003eBR~DGE is een initiatief van Muziekgebouw en Effenaar en wordt mede mogelijk gemaakt door Stichting\u0026nbsp;Brainport.\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eAls mediapartners zijn aan BR~DGE verbonden: Soundz en Gitarist.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"22b43ae9-fb38-412b-8cd3-ec4d888e0632","header":{"title":"Talkshow: Guitar Inside"},"content":{"content":"\u003cp\u003eGuitar Inside vindt tijdens BRIDGE Festival meerdere malen plaats in Meneer Frits (Muziekgebouw Eindhoven). Voor iedere aflevering schuiven minstens twee gasten aan. Deze kun je live bijwonen. More info is coming soon.\u003c/p\u003e\r\n\r\n\u003cp\u003eOntdek meer over Guitar Inside: www.\u003ca href=\"https://bridgefestival.com/nl/updates/guitar-inside\" target=\"_blank\"\u003ebridgefestival.com/nl/updates/guitar-inside\u003c/a\u003e\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"related_event","id":"44b5efff-aa7e-470f-9be9-eb97cb5714f9","header":{"title":null,"description":null},"content":{"items":[{"type":"event","nid":284,"slug":"/agenda/bridge-10-11-mei","endpoint":"/nl/agenda/bridge-10-11-mei","translations":{"nl":"/agenda/bridge-10-11-mei","en":null},"title":"BRIDGE - 10 \u0026 11 mei","content":"\u003cp\u003eEindhoven is een festival rijker: vanaf 10 mei 2023 staat de gitaar 5 dagen lang centraal tijdens het nieuwe \u003ca href=\"https://bridgefestival.com/\"\u003eBRIDGE\u003c/a\u003e! Het meerdaagse, allround gitaarfestival is uniek in zijn soort: van klassiek tot blues, van jazz tot rock, van flamenco tot pop, alles komt aan bod. Livemuziek speelt tijdens BRIDGE een grote rol, vele gitaristen zullen in verschillende formats afreizen naar het festival. Daarnaast worden volop andere programma’s aangeboden zoals workshops, masterclasses, een omvangrijke beurs, huiskamerconcerten en meerdere on- en offline activiteiten. En dat alles onder de noemer van een aantal pijlers: innovatie, educatie, participatie, inclusie en natuurlijk de grote gezamenlijke liefhebberij van de gitaar. Hiermee wordt er voldaan aan de behoefte binnen de gehele Brainport regio: verbinding, mét elkaar, vóór elkaar. Met andere woorden: we slaan van 10 tot en met 14 mei 2023 sámen een brug, BRIDGE is geboren! \u003c/p\u003e\r\n","meta":{"title":"BRIDGE","description":"Eindhoven is een festival rijker: vanaf 10 mei 2023 staat de gitaar 5 dagen lang centraal tijdens het nieuwe BRIDGE! Het meerdaagse, allround gitaarfestival is uniek in zijn soort: van klassiek tot blues, van jazz tot rock, van flamenco tot 