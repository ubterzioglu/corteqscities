are%20afbeelding%20only%20noah%20guthri.png?itok=SYoqsweO","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=HlzHFVhD"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=_7zSMoY1 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=V9gDUw4p 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=EiTmwpGM 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=5hpi7OhD 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=SYoqsweO 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20noah%20guthri.png?itok=HlzHFVhD 720w"]},"source":null,"source_link":null},"locations":[{"id":129,"title":"'t Rozenknopje","is_external":false}],"state":null,"club_card_event":true,"colors":{"accent_color":"#021526","background_color":"#BFB688","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"bd634e1e-be23-47e3-a255-2fe528924e24","header":{"title":"A Modern Day Distraction"},"content":{"content":"\u003cp\u003eEind 2025 kwam zijn nieuwe plaat 'A Mordern Day Distraction' uit. Een album waarop Bugg weer dichter bij zichzelf blijft en een meer jaren 60 rock-geluid omarmt. Bugg spreekt zich op dit album hoorbaar uit tegen sociale ongelijkheid. Hij hoopt met dit album verschillende groepen uit de samenleving te overbruggen en samen de gezamenlijke struggles aan te pakken.\u003c/p\u003e","links":null}},{"type":"embed","id":"dd1fe6a6-9901-458d-b5ae-860a3084ca83","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/YE5ttZGJfws?si=XJQhoMPg3-5EQAA6\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"8cb2d7f7-5213-46fa-8861-236c95ee6cff","header":{"title":"Support: Silver Lake"},"content":{"content":"\u003cp\u003eHaags indie-duo Silver Lake is terug met hun nachtelijke, melancholische art-pop. Na een jaar schrijven, opnemen en teruggaan naar de tekentafel kunnen we een verbluffend genuanceerd geluid van ze verwachten dat de randen van de ‘indie’ vervaagt en op de jaren zestig geïnspireerde ‘folkpop’ raakt. De lichte en intieme zang van Marleen Hoebe beschrijft een aantal van de mooiste aspecten van de menselijke ervaring; de tijd nemen om diep adem te halen, dat ene moeilijke ding te delen met iemand van wie je houdt en de troost en twijfels die relaties met zich meebrengen. Hoopvolle melodieën met diepgaande teksten die het alledaagse in een nostalgisch maar wonderschoon daglicht schilderen, gecombineerd met arrangementen van partner Jesse Koch die de op hun eerste album gecreëerde wereld evolueren en uitbreiden.\u003c/p\u003e","image":{"image":{"alt":"Silver Lake","src":"https://d12y285rxlbnxt.cloudfront.net/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=fmV2GKBq","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=eGfh5Rgn","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=bmcoF6WG","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=5F4j3AM4","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=f27lxCZi","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=kWy-KqeC"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=fmV2GKBq 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=eGfh5Rgn 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=bmcoF6WG 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=5F4j3AM4 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=f27lxCZi 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/Plaroid_SX70_Silver%20Lake%20%28Lin%20Bartraij%29.jpg?itok=kWy-KqeC 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"fdfad1a4-91c5-4b4b-9644-f06ba75b9392","header":{"title":null},"content":{"content":"\u003cp\u003e\u003cstrong\u003eDit concert is Powered by ASML.\u003c/strong\u003e\u003c/p\u003e","links":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724608361,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-jake-bugg-nl","queryHash":"[\"AgendaDetail-jake-bugg-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1734,"slug":"/agenda/morgan-heritage","endpoint":"/nl/agenda/morgan-heritage","translations":{"nl":"/agenda/morgan-heritage","en":null},"title":"Morgan Heritage","content":"\u003cp\u003eMorgan Heritage is niet zomaar een reggaeband. Al meer dan drie decennia vormen de Grammy Award–winnende broers en zussen van de familie Morgan het gezicht van moderne rootsreggae. Opgericht door de kinderen van het Jamaicaanse reggae-icoon Denroy Morgan Sr. – Una, Gramps, Peetah, Lukes en Mr. Mojo Morgan – heeft de groep met 12 studioalbums en talloze awards de wereld rondgereisd en overal hun stempel gedrukt. Hun songs ademen liefde, Rastafari, sociale rechtvaardigheid, familie en geloof, en brengen Jamaica, Afrika, Europa en Amerika muzikaal samen.\u003c/p\u003e","meta":{"title":"Morgan Heritage","description":"","image":null},"publish_date":{"timestamp":1765875300,"machine":"2025-12-16T08:55:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Morgan Heritage header","src":"https://d12y285rxlbnxt.cloudfront.net/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=PaBs8N-D","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=mlXKgVO_","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=aQS8IdqW","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=PxQ3NGkV","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=0E7WR1tM","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=WF75wc_5"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=PaBs8N-D 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=mlXKgVO_ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=aQS8IdqW 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=PxQ3NGkV 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=0E7WR1tM 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-12/%20%E2%80%93%201920x1080%20Website_0.jpg?itok=WF75wc_5 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F2C84B","background_color":"#4A8C6D","text_color":"#000000"},"thumbnail_image":{"image":{"alt":"Morgan Heritage","src":"https://d12y285rxlbnxt.cloudfront.net/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=ajUBzNAY","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=cR-awojm","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=-DgSvAeB","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=LtAy19pF","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=PwBB-Qxs","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=-Jd7SfNR"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=ajUBzNAY 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=cR-awojm 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=-DgSvAeB 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=LtAy19pF 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=PwBB-Qxs 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-12/%20%E2%80%93%20Square%20afbeelding%20only_0.png?itok=-Jd7SfNR 720w"]},"source":null,"source_link":null},"header_text_size":"big","subtitle":"Iconische rootsreggae-band | + Esh Morgan + UnitedSounds Soundsystem","upper_title":null,"tickets":[],"tags":[],"date":{"timestamp":1779926400,"machine":"2026-05-28"},"presale":null,"times":{"starts_at":"20:15","ends_at":null,"opens_at":"19:30"},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"facebook_event":{"uri":"https://www.facebook.com/events/1641091000186872?acontext=%7B%22event_action_history%22%3A[%7B%22surface%22%3A%22home%22%7D%2C%7B%22mechanism%22%3A%22attachment%22%2C%22surface%22%3A%22newsfeed%22%7D]%2C%22ref_notif_type%22%3Anull%7D","title":"","options":{"url":"https://www.facebook.com/events/1641091000186872?acontext=%7B%22event_action_history%22%3A[%7B%22surface%22%3A%22home%22%7D%2C%7B%22mechanism%22%3A%22attachment%22%2C%22surface%22%3A%22newsfeed%22%7D]%2C%22ref_notif_type%22%3Anull%7D"}},"genres":[{"id":120,"title":"Funk / Soul/ Jazz / Reggae"}],"club_card_event":false,"ticket_url":{"uri":"https://shop.tickets.cm.com/118eb8d0-b97e-6d04-df9f-209cb6fbaff9","title":"","options":{"url":"https://shop.tickets.cm.com/118eb8d0-b97e-6d04-df9f-209cb6fbaff9"}},"ticket_price":"44.00","state":null,"locker_reservation":false,"restaurant_reservation":true,"related_events":[],"blocks":[{"type":"paragraph","id":"e984a650-14fc-4083-9c82-200980de5e40","header":{"title":null},"content":{"content":"\u003cp\u003eNa een periode van bezinning en herstel is Una Morgan, een van de originele leden, terug op het podium en sterker dan ooit. Tegelijkertijd heeft Jemere Morgan, oudste zoon van Gramps, het stokje als nieuwe frontman overgenomen. Morgan Heritage 2.0 blijft trouw aan de kern van de band, maar opent ook ruimte voor frisse energie en nieuwe ideeën. Elke show draagt de geest van Peetah Morgan, de oorspronkelijke leadzanger, terwijl de missie duidelijk blijft: reggae levend houden, mensen samenbrengen en generaties inspireren. Op donderdag 28 mei doen ze dat in onze Grote Zaal!\u003c/p\u003e","links":null}},{"type":"paragraph","id":"81da1751-9947-48cf-9657-f163e3feea8a","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:30 uur: Deuren open\u003cbr\u003e20:15 uur: Show Esh Morgan\u003cbr\u003e20:35 uur: UnitedSounds Soundsystem\u003cbr\u003e21:00 uur: Show Morgan Heritage\u003cbr\u003e22:40 uur: UnitedSounds Soundsystem\u003cbr\u003e(tijden zijn onder voorbehoud)\u003c/p\u003e","links":null}},{"type":"embed","id":"41929ec1-3333-4a09-b006-56f7dce2bb42","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/gEnVCG9uIWs?si=30Ql0X14nTUXeLP5\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"dd4ae675-d26f-478a-bd64-4651a369e504","header":{"title":"Support: Esh Morgan"},"content":{"content":"\u003cp\u003eEsh Morgan is een opkomende reggaeartiest die bekendstaat om zijn warme stemgeluid, oprechte teksten en moderne interpretatie van klassieke rootsreggae. Met invloeden uit reggae, soul en hedendaagse Caribische muziek en als zoon van Mojo Morgan en kleinzoon van Denroy Morgan bouwt hij voort op een rijke muzikale traditie, terwijl hij tegelijkertijd zijn eigen geluid neerzet. Met zijn sterke live-reputatie weet Esh Morgan moeiteloos de sfeer op te bouwen en het publiek klaar te stomen voor een onvergetelijke avond, voorafgaand aan Morgan Heritage.\u003c/p\u003e","links":null}},{"type":"embed","id":"b236e880-4753-40bd-8f97-5b7c1c7d5fb4","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/vVEGl8n6up8?si=xQIMGt0uE7trdVF1\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"b2272205-9eb7-4246-a45d-a1074de15e56","header":{"title":"DJ support: UnitedSounds"},"content":{"content":"\u003cp\u003eUnitedSounds is een toonaangevend Roots \u0026amp; ulture reggae Dancehall Soundsystem, opgericht in 1993 in Tilburg. De drijvende krachten achter het collectief zijn Taki en RasDré, die samen de rollen van MC, DJ en selector vervullen. Met hun scherpe reggae-selecties, opzwepende dancehall-vibes en exclusieve dubplates weten zij keer op keer het publiek te raken. In 2020 werd het team versterkt door Bartje JahSoldier, wat de energie en dynamiek van UnitedSounds naar een hoger niveau tilde.\u003c/p\u003e\u003cp\u003eMet een diepe liefde voor reggae en de Jamaicaanse cultuur én een ijzersterke samenwerking, staat UnitedSounds al meer dan 30 jaar garant voor energieke shows op nationale en internationale podia.\u003c/p\u003e","links":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724608974,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-morgan-heritage-nl","queryHash":"[\"AgendaDetail-morgan-heritage-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1677,"slug":"/agenda/motorpsycho","endpoint":"/nl/agenda/motorpsycho","translations":{"nl":"/agenda/motorpsycho","en":null},"title":"Motorpsycho","content":"\u003cp\u003eDe Noorse rocklegendes van Motorpsycho komen speciaal voor BRIDGE naar Effenaar voor een exclusief concert in Nederland! Bassist Bent Sæther en gitarist Hans Magnus staan bekend om hun genre-overschrijdende stijl, die rock, psychedelica, heavy metal en zelfs jazz, pop en country samenvoegt.\u003c/p\u003e","meta":{"title":"Motorpsycho in Effenaar tijdens BRIDGE Gitaarfestival","description":"Het Noorse rockduo Motorpsycho komt speciaal voor BRIDGE naar Effenaar voor een exclusief concert in Nederland! Bassist Bent Sæther en gitarist Hans Magnus staan bekend om hun genre-overschrijdende stijl, die rock, psychedelica, heavy metal en zelfs jazz, pop en country samenvoegt.","image":null},"publish_date":{"timestamp":1762247051,"machine":"2025-11-04T09:04:11+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Motorpsycho","src":"https://d12y285rxlbnxt.cloudfront.net/2025-11/20260531%20BRIDGE%20Motorpsycho_Web-header_Muziekgebouw-Eindhoven_1920x1080.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/20260531%20BRIDGE%20Motorpsycho_Web-header_Muziekgebouw-Eindhoven_1920x1080.jpg?itok=PVhZb4_S","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/20260531%20BRIDGE%20Motorpsycho_Web-header_Muziekgebouw-Eindhoven_1920x1080.jpg?itok=XkYtckAA","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/20260531%20BRIDGE%20Motorpsycho_Web-header_Muziekgebouw-Eindhoven_1920x1080.jpg?itok=D27OdUyJ","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/20260531%20BRIDGE%20Motorpsycho_Web-header_Muziekgebouw-Eindhoven_1920x1080.jpg?itok=LtrPkquK","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/20260531%20BRIDGE%20Motorpsycho_Web-header_Muziekgebouw-Eindhoven_1920x1080.jpg?itok=H3cNlU-f","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/20260531%20BRIDGE%20Motorpsych