w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=nS29BMQd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=lt3ZfQCK 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=WSBGu7Vz 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=IXLO9ado 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=waQNUMpd 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#000000","background_color":"#fc7356","text_color":"#000000"}},{"nid":1685,"title":"Dotan","subtitle":"Dromerige folk die zowel groots als intiem voelt","slug":"/agenda/dotan","endpoint":"/nl/agenda/dotan","date":{"timestamp":1792886400,"machine":"2026-10-25"},"thumbnail_image":{"image":{"alt":"dotan square","src":"https://d12y285rxlbnxt.cloudfront.net/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"379b0b28-cc11-4acc-bb2e-a03441691f22","header":{"title":"Duurzaamheid"},"content":{"content":"\u003cp\u003eMet het oog op duurzaamheid, verzoeken wij zoveel mogelijk gasten met de fiets te komen. Ook wordt er gebruik gemaakt van hardcups, om wegwerpplastic tegen te gaan. Wat consumpties betreft zullen er voldoende eet- en drinkkraampjes aanwezig zijn. Bespaar jezelf gesjouw en dompel je onder in het lokale eet- en drinkaanbod van 't Wasven.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"cb7b2863-ffdc-47f8-b19d-a45b17648389","header":{"title":"14:00-14:30 Rhino Black"},"content":{"content":"\u003cp\u003eDeze gloednieuwe formatie maakt liedjes met een laidback punch.\u0026nbsp;Met teksten om op te kauwen maar waar je glimlachend naar luistert. Oude punkrockers uit Eindhoven, die in plaats van drie nog maar twee akkoorden willen spelen, lieten zich inspireren door reggae. In het najaar duikt Rhino Black de studio in; tot die tijd kun je hun ‘good vibes with a smile’ in het wild/wasven komen aanschouwen!\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"7d0cf4bb-0b64-4a69-beed-27a190e4c7e0","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/t2OXIRV9Jz4?si=rLrqJlH0I0LuUzUe\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"f4481477-a46d-469a-889f-5d09f775b2a0","header":{"title":"15:00-15:45 Luke Christoffel"},"content":{"content":"\u003cp\u003eLuke's hart klopt op het ritme van de klassiekers - de tijdloze deuntjes van Elvis Presley, de beklijvende melodieën van Roy Orbison en de soulvolle harmonieën van The Platters behoren tot zijn grote inspiratiebronnen. Met zijn warme stemgeluid en charismatische podiumuitstraling brengt deze troubadour een moderne variant van de crooner-stijl, geïnspireerd door grootheden als Frank Sinatra. Zijn optredens ademen de sfeer van de jaren '50, maar met een frisse, eigentijdse twist.\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"luke christoffel","src":"https://d12y285rxlbnxt.cloudfront.net/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=sCXsf3Ot","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=E-FA7Pli","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=p3Q-VjPA","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=zPZeukj7","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=067oZ54k","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=gGWk8Tl8"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=sCXsf3Ot 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=E-FA7Pli 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=p3Q-VjPA 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=zPZeukj7 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=067oZ54k 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-05/Luke%20Christoffel%20PRESS%20I.jpeg?itok=gGWk8Tl8 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"7084a451-610f-4025-a41c-69183a49546e","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/XQf92nxyjfo?si=qOCVv0um7Z1Icmud\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"4a102935-124e-48e5-aa60-8523bea3191e","header":{"title":"16:15-17:15 Postmodern Clarity"},"content":{"content":"\u003cp\u003eVirtuoze solo’s, Prachtige samenzang en ijzersterke melodieën: de vier vrienden Frank Homma (gitaar), Robin Borsboom (contrabas), Edwin Versprille (banjo) en Jeffrey Blok (zang, mandoline, gitaar), hebben elkaar ontmoet op het conservatorium en delen hun liefde voor bluegrass. Ze brengen een frisse draai aan het genre door invloeden uit jazz en folk te verweven met de traditionele sound. Met een repertoire van zowel eigen werk als vernieuwende interpretaties van klassiekers bewijst het viertal dat bluegrass verre van achterhaald is.\u003c/p\u003e\r\n","image":{"image":{"alt":"pmc","src":"https://d12y285rxlbnxt.cloudfront.net/2025-05/Schermafbeelding%202025-05-14%20120936.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=pryoqlko","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=KqR_huqZ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=Q1ggDLAP","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=CMpIk8Pr","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=hEhgFu7z","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=FxmxquOv"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=pryoqlko 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=KqR_huqZ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=Q1ggDLAP 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=CMpIk8Pr 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=hEhgFu7z 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-05/Schermafbeelding%202025-05-14%20120936.png?itok=FxmxquOv 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"fcc982d8-9568-4284-a663-320cb3cb46d2","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/VGnDd1oXqHU?si=DJkkny22p2gp9PKd\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724666655,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-wasven27jul-nl","queryHash":"[\"AgendaDetail-wasven27jul-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"longread","nid":1255,"slug":"/artikelen/cafe-jack-je-hebt-rock-je-hebt-metal-en-je-hebt-niek","endpoint":"/nl/artikelen/cafe-jack-je-hebt-rock-je-hebt-metal-en-je-hebt-niek","translations":{"nl":"/artikelen/cafe-jack-je-hebt-rock-je-hebt-metal-en-je-hebt-niek","en":null},"title":"Café The Jack: Je hebt rock, je hebt metal en je hebt Niek","content":"\u003cp\u003eDe hardrock- en metalscene is altijd al groot geweest in Eindhoven. Maar vijftien jaar geleden hadden metalheads in de stad opeens weinig plekken om heen te gaan. Bekende verzamelplaatsen als de Dynamo-kelder en bikercafé Roadhouse sloten hun deuren.\u003c/p\u003e","meta":{"title":"Café The Jack: Je hebt rock, je hebt metal en je hebt Niek","description":"Lees hier het interview met eigenaar Niek van Rixel van Café The Jack in Eindhoven.","image":{"image":{"alt":"The Jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/thumbmeta.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/thumbmeta.jpg?itok=KkrK-HSi","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/thumbmeta.jpg?itok=QYRhMdXq","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/thumbmeta.jpg?itok=aeaG4d8e","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/thumbmeta.jpg?itok=eD9UokWu","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/thumbmeta.jpg?itok=Xunej3qw","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/thumbmeta.jpg?itok=bFXnWgJ_"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/thumbmeta.jpg?itok=KkrK-HSi 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/thumbmeta.jpg?itok=QYRhMdXq 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/thumbmeta.jpg?itok=aeaG4d8e 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/thumbmeta.jpg?itok=eD9UokWu 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/thumbmeta.jpg?itok=Xunej3qw 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/thumbmeta.jpg?itok=bFXnWgJ_ 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1732707318,"machine":"2024-11-27T11:35:18+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"The Jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=Q_2b7MY7","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=HvNHVG-D","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=9dWiNFSm","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=wwQmLjtC","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=hk0FKiR_","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=3BALk0Gi"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=Q_2b7MY7 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=HvNHVG-D 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=9dWiNFSm 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=wwQmLjtC 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=hk0FKiR_ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4568.png?itok=3BALk0Gi 720w"]},"source":"Foto: Max Kneefel | Niek van Rixel in Café The Jack","source_link":null},"breadcrumb":null,"blocks":[{"type":"paragraph","id":"62c54ca3-4c75-4a3a-b9c1-2ff672d245b7","header":{"title":null},"content":{"content":"\u003cp\u003e“Er was niet meer zoveel aanbod in de stad”, zegt Niek van Rixel (40), die juist op dat moment Café The Jack op Stratumseind opent. “Met het idee van een Radio Veronica-achtig rockcafé. Ik was toen 25 jaar en had geen flauw benul van ondernemen. Wél kon ik plaatjes draaien, tappen, slap ouwehoeren en hard werken. De eerste jaren wel honderd uur per week.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"df2aaef5-129e-4270-a5ca-1d6f15a52294","header":{"title":null},"content":{"content":"\u003cp\u003eNieks harde werk is goed terug te zien in Café The Jack. Hij timmerde de boel letterlijk bij elkaar. Van de uitklapbare leuningen aan de muur en de bar, de doorzichtige koelkasten met meer dan honderd soorten speciaalbier, tot het podium rechts in de hoek. Op dat podium is plek voor bands van ‘hardere’ gitaarmuziek: hardrock, emo, metal, hardcore, punk, en al hun subgenres.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"a4aa0ad8-d84a-4ccc-baa8-d9fa4d45ecd2","header":{"title":null},"content":{"content":"\u003cp\u003eDe aankondiging voor het aankomende feest op derde kerstdag, op de site van het café spreekt boekdelen: ‘\u003cem\u003eIt’s beginning to look a lot like… F*CK THIS!\u003c/em\u003e’. Moshpits gegarandeerd. Tegelijkertijd zijn het juist de lieverds die hier vaste klant zijn, zegt Niek, geplaatst op een barstoel in het vroege middaguur. “Er is nooit gezeik, we hebben zelfs geen portier nodig. De sociale controle is groot. Mensen zeggen tegen hun kinderen die op Stratumseind gaan stappen: ‘Als je je als meisje niet prettig voelt, ga dan naar The Jack.’”\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"dc5930a6-b7db-4f17-b4da-c651c4d78f70","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"the jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=7oHa02yA","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=pODplW0e","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=rzID3nNs","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=XOymt57K","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=M5C_P-VR","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=wBZdxYuB"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=7oHa02yA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=pODplW0e 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=rzID3nNs 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=XOymt57K 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=M5C_P-VR 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4590.png?itok=wBZdxYuB 720w"]},"source":"Foto: Max Kneefel","source_link":null},{"image":{"alt":"The Jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=UsbLfBFt","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=DiDiDsZF","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=yRqj__Ls","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=wosibrRY","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=wp-Z7iB2","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=A2T2Xwik"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=UsbLfBFt 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=DiDiDsZF 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=yRqj__Ls 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=wosibrRY 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=wp-Z7iB2 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4591.png?itok=A2T2Xwik 720w"]},"source":"Foto: Max Kneefel ","source_link":null}]}},{"type":"paragraph","id":"27eea795-a8d9-4e90-982e-e05049d6e36a","header":{"title":null},"content":{"content":"\u003cp\u003eWat ook opvalt, is dat het café relatief smal is. Volgens de eigenaar voegt dat juist toe aan de sfeer bij drukbezochte optredens. “Dan klapt het erop! Mensen kruipen tegen het plafond omhoog, artiesten gaan over de bar… De tent ontploft. Ja, dat is \u003cem\u003efacking \u003c/em\u003egaaf. Met carnaval gebeurt precies hetzelfde… Maar dat is \u003cem\u003efacking verschrikkelijk\u003c/em\u003e, met die muziek.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"6e687bfb-5e2d-4425-b231-98efa0f1e2bf","header":{"title":"Community die alle kleuren heeft"},"content":{"content":"\u003cp\u003eNu, vijftien jaar na de opening, staat The Jack bekend als hét hardrockcafé van Eindhoven. Eentje waar nooit een portier voor de deur staat. Nee, het is een ‘familiegebeuren’, zoals Niek het noemt. De jonge generatie, die met hun ‘spijkerjackies’ binnenkomt en zich mengt met de ‘kale koppies’, die decennia terug met een lange haardos in diezelfde spijkerjackies in de Dynamo-kelder stonden. Zowel voor, als achter de bar.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"6b9a9f0c-b664-46ba-8216-fab0c6d34706","header":{"title":null},"content":{"content":"\u003cp\u003e“Jong en oud loopt hier allemaal door elkaar”, zegt Niek. “En dat matched gewoon. Ergens is de rock- en metalmuziek niet zo trendgevoelig. Het is tijdloos. Natuurlijk zijn er genres die de laatste paar jaren weer naar voren komen, zoals de emo-scene. Maar de basis blijft hetzelfde. Iron Maiden, Metallica, AC/DC… Dat wordt door jong en oud gewaardeerd.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"1bb61042-dd18-4750-a28c-ca9a0515945a","header":{"title":null},"content":{"content":"\u003cp\u003e“Het hele doel van The Jack is dan ook om mensen bij elkaar te brengen en daar een familie van te maken. We willen een huiskamer zijn voor mensen die ook buiten het café met elkaar optrekken. Een community opbouwen die alle kleuren heeft. Dat is altijd mijn drijfveer geweest.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"8efdb98f-b246-4751-9b2a-525a67075eec","header":{"title":null},"content":{"content":"\u003cp\u003eDat Niek voorheen die honderd uur per week in het café stopte, is opeens geen heel gekke gedachte meer. Naast dat hij nagenoeg in zijn eentje\u003cstrong\u003e \u003c/strong\u003ehet café runde, deed hij zijn stinkende best om bij The Jack te een familiegevoel te smeden. “Met pubquizzen, bandavonden, proeverijen en barbecues, tot metal-bowlingenavonden en busreizen naar festivals…”\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"52f8c851-0265-41fe-a406-7ffa5893bcf0","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"The Jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=4a0qGnol","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=B_nygtq5","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=rWUbsfzG","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=-zVPbIEi","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=fNBuJOOR","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=e3EeKt71"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=4a0qGnol 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=B_nygtq5 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=rWUbsfzG 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=-zVPbIEi 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=fNBuJOOR 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4579.png?itok=e3EeKt71 720w"]},"source":"Foto: Max Kneefel","source_link":null},"is_fullscreen":true}},{"type":"paragraph","id":"8929172b-86c2-4706-bcf4-3bcb3ee2988c","header":{"title":"Van radio tot bar in een bus"},"content":{"content":"\u003cp\u003eDie familie kwam er. Bewijs daarvan is de coronaperiode. Waar menig café nog niet het niveau van sociale verbinding heeft bereikt van vóór corona, kwam men bij Café The Jack, ondanks de afstand, juist dichter bij elkaar. “Ik heb altijd gezegd dat ik iedereen in dienst wilde houden, maar ik vroeg er ook iets voor terug van het personeel.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"7e689327-c9d1-4fc9-848a-bca676be2573","header":{"title":null},"content":{"content":"\u003cp\u003eEn dus richtte Niek tijdens de lockdowns een radiostation The Jack op. “Dat was allemaal houtje, touwtje, met telefoons die aan elkaar aangesloten werden met vijf computers… En het personeel was erbij. Dan gingen we elke keer met twee, drie man uit de community radio maken. Met beeld erbij en al. Eerst zaten er veertig man in de chat, dat vonden we al veel. Uiteindelijk hadden we honderden mensen die iedere avond luisterden.”\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"75afc88b-c594-4abd-b633-d2f2f4562b84","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"The Jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/95763235_3049856388385698_5430739438575550464_n.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=wodg1g6I","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=jPofBTxi","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=T_DrZw91","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=mG97BJ_I","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=PivC2HzU","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=PrbkKUkB"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=wodg1g6I 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=jPofBTxi 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=T_DrZw91 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=mG97BJ_I 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=PivC2HzU 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/95763235_3049856388385698_5430739438575550464_n.png?itok=PrbkKUkB 720w"]},"source":"Foto: Radiostudio van The Jack","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"9b1f630a-0dd0-42dd-bbd8-f1ad8bfac4c5","header":{"title":null},"content":{"content":"\u003cp\u003eNaar de radio-uitzendingen luisterden ook vrienden van vrienden, of gezelschappen die op de achtergrond de radio aan hadden staan. Maar ook veel mensen die alleen waren en zo toch de connectie met elkaar vonden. “Via de chat, of door in te bellen op de radio. Dat was super gaaf. Het deed ons allemaal goed.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"e8c3eb37-aa00-4bee-80e7-fd2b29043a4e","header":{"title":null},"content":{"content":"\u003cp\u003eOok bouwde Niek zijn Caddy-bestelbusje om tot een ‘zorgbus’. Hij kortte een biertafel in op anderhalve meter en stopte die samen met twee krukjes in de bus. Ook laadde hij de bus vol met speciaalbier en nam hij een kleine DJ-booth mee. “Dan kon je mij bestellen”, zegt hij lachend. “Ik zette een kruk voor je deur en ging zelf op anderhalve meter zitten. Dan kon je nummertjes aanvragen en praten over het leven. In die periode zag je dat er veel mensen tegen de muur liepen. Vaak was dat een leegloop van emoties, omdat ze eindelijk weer eens iemand fysiek konden zien.”\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"96cec94e-10af-43d1-a361-dd859920f678","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"The Jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/96857495_3224208887598017_7809456811462885376_n.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=uqA8W7h2","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=nIGYprpX","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=MjTmPz4K","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=dU23nhCV","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=jovyR7Bs","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=3HyrPIpB"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=uqA8W7h2 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=nIGYprpX 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=MjTmPz4K 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=dU23nhCV 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=jovyR7Bs 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/96857495_3224208887598017_7809456811462885376_n.png?itok=3HyrPIpB 720w"]},"source":"Foto: Niek met zijn bezorgbus","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"41a68e9f-3427-4b33-977c-6be9f3915628","header":{"title":null},"content":{"content":"\u003cp\u003eOf dat niet een beetje heftig was, al die verhalen aanhoren? “Fucking slopend”, antwoordt Niek. “Als barman hoor je natuurlijk ook allerlei verhalen van mensen, maar die filter je er achter de bar toch net wat makkelijker uit. Dit was wel echt next level.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"f52b2f7d-1a2f-47cb-8ced-65681dc20459","header":{"title":"Nog een café-restaurant "},"content":{"content":"\u003cp\u003eJe hele hart en ziel in een café stoppen is uitputtend. Toen Niek in 2018 zijn schouder brak, was dat letterlijk een geluk bij een ongeluk. “Toen ik moest rusten, kreeg ik een \u003cem\u003ehelicopterview\u003c/em\u003e. Ik leerde dat ik niet alles zelf hoef te doen en nam personeel aan. In plaats van twintig balletjes hooghouden, werden dat er tien. Zo werd het ook nog eens leuker. Maar ik ben blij dat ik de eerste acht jaar naar mijn eigen wijsheid luisterde. Als ik naar alle mensen had geluisterd die zeiden: ‘Weet je wat jij zou moeten doen?’, dan was het café nooit geworden zoals het nu is.\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"9d54621a-44c1-4fd4-bf45-018340761536","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"The Jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=EvIPk88u","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=2Y2-6Xdr","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=MEZXP2BL","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=_HV-q_VE","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=ypXW3bl3","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=6xffhyEo"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=EvIPk88u 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=2Y2-6Xdr 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=MEZXP2BL 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=_HV-q_VE 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=ypXW3bl3 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4602.png?itok=6xffhyEo 720w"]},"source":"Foto: Max Kneefel","source_link":null},{"image":{"alt":"the Jack","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=8gy3xKPQ","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=GMJ8kLrB","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=q4_VssiD","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=OvT7aA90","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=dGBM8RYc","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=aeXaPYhl"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=8gy3xKPQ 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=GMJ8kLrB 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=q4_VssiD 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=OvT7aA90 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=dGBM8RYc 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/20241114_Niek_TheJack_MaxKneefel_YKV4523.png?itok=aeXaPYhl 720w"]},"source":"Foto: Max Kneefel","source_link":null}]}},{"type":"paragraph","id":"82c47758-dc72-4ae2-9549-a5f715973970","header":{"title":null},"content":{"content":"\u003cp\u003eAchter de bar klinkt geklus. Dan komen de lange haren van Henk van der Laars (57)\u003cstrong\u003e \u003c/strong\u003eboven de bar uit. Naast zijn bezigheden als geluidstechnicus, gitarist en componist bij de Eindhovense power metalband \u003cem\u003eElegy\u003c/em\u003e, is Henk de linkerhand van Niek. Nagenoeg vanaf het begin van het café, was hij erbij.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"6487d2a2-726f-46e0-a992-d9d93214d95b","header":{"title":null},"content":{"content":"\u003cp\u003eNa twee dagen werk als geluidsmixer bij The Jack, trok hij in op de bovenverdieping. Nog steeds woont hij boven het café, waar hij in loondienst is. “Henk is niet alleen kind aan huis. Maar ook de oom en opa voor de jongeren die hier komen.”\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"e08cedd6-ab4e-4466-bc55-6bccec792016","header":{"title":null},"content":{"content":"\u003cp\u003eZijn energie steekt Niek al een poos niet meer in het organiseren van busritjes van cafégangers naar festivals - ‘Dat is helaas onbetaalbaar geworden’. En ook bandoptredens worden voor de kroegbaas steeds duurder. “De marges waren vroeger veel hoger in de horeca. Nu is het heel moeilijk om livemuziek aan te bieden en daarin een leuke cent mee te geven aan de bandleden en de geluidstechnici. Zelf verwacht je nooit iets te verdienen aan zo’n avond. Daarom zijn we heel blij met de samenwerking met Effenaar. Zij verzorgen de boeking en marketing voor bepaalde bands die hier komen optreden.” Een voorbeeld van die samenwerking is de band FEMME FUGAZI, die volgende week zaterdag in The Jack optreedt. \"Garage-postpunk van Hollandse bodem”, zegt Niek. “Daar kijk ik erg naar uit.”\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"19aa8a23-f148-4bf3-8e7f-bd4c52739bbd","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"Lambrini Girls","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/lambrinigirls.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/lambrinigirls.png?itok=TgqzhtN-","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/lambrinigirls.png?itok=al6bx3WL","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/lambrinigirls.png?itok=VBn6Y0_R","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/lambrinigirls.png?itok=KisMobC9","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/lambrinigirls.png?itok=cz22mVbm","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/lambrinigirls.png?itok=LE9Xw6QA"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/lambrinigirls.png?itok=TgqzhtN- 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/lambrinigirls.png?itok=al6bx3WL 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/lambrinigirls.png?itok=VBn6Y0_R 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/lambrinigirls.png?itok=KisMobC9 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/lambrinigirls.png?itok=cz22mVbm 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/lambrinigirls.png?itok=LE9Xw6QA 720w"]},"source":"Foto: Marco Smeets | Lambrini Girls tijdens Hit The City in Café The Jack","source_link":null},{"image":{"alt":"Ditz","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/Ditz.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Ditz.png?itok=A7c_U8oD","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Ditz.png?itok=MQVqz-vH","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/Ditz.png?itok=4e0y8fQa","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Ditz.png?itok=5FsH6gIU","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Ditz.png?itok=1p91wSz4","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Ditz.png?itok=1qVUpF_A"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Ditz.png?itok=A7c_U8oD 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Ditz.png?itok=MQVqz-vH 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/Ditz.png?itok=4e0y8fQa 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Ditz.png?itok=5FsH6gIU 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Ditz.png?itok=1p91wSz4 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Ditz.png?itok=1qVUpF_A 720w"]},"source":"Foto: Marco Smeets | Ditz tijdens Hit The City in Café The Jack","source_link":null}]}},{"type":"paragraph","id":"96aad386-51a8-4729-bc91-752a482db561","header":{"title":null},"content":{"content":"\u003cp\u003eOok heeft Niek sinds 2021 een compagnon, Alvin Dooms. “Alvin is kneiter sterk aan de achterkant”, zegt Niek. “Zodat ik me meer kan focussen op de voorkant, maar ook met de behoefte om te groeien.” Zo nam het tweetal vorig jaar de horeca over in de onderverdieping van de Eindhovense muziekhub PopEi, en doopten het nieuwe café-restaurant om tot PopEi The Pub. “Hier hebben we de horeca uit handen genomen om dit naar een hoger niveau te tillen”, zegt Niek. “Jarenlange ervaring met het combineren van horeca samen met live muziek vallen daar mooi op z’n plek.”\u003c/p\u003e\r\n","links":null}},{"type":"related_event","id":"aeb77ea5-646b-411f-a5b7-57ab715837f4","header":{"title":"Naar een vette show in Café The Jack? Check onze agenda: ","description":null},"content":{"items":[{"type":"event","nid":1868,"slug":"/agenda/war-on-women","endpoint":"/nl/agenda/war-on-women","translations":{"nl":"/agenda/war-on-women","en":null},"title":"War On Women","content":"\u003cp\u003eHet uit Baltimore afkomstige War On Women werd schreeuwend geboren: naar de wereld, naar de gevestigde orde, recht in het gezicht van onderdrukking. Al jaren bestrijdt deze feministische punkformatie onrecht, nummer voor nummer, met tanden geknars en gif in de aanslag. Hun titelloze debuut uit 2015 kruiste de felheid van riot grrrl met de wendbare agressie van thrash en bewees meteen dat hardcore prima verder kan reiken dan zweterige moshpits en kapotte oordoppen.\u003c/p\u003e","meta":{"title":"War On Women","description":"","image":null},"publish_date":{"timestamp":1776671837,"machine":"2026-04-20T07:57:17+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"War On Women header","src":"https://d12y285rxlbnxt.cloudfront.net/2026-04/%20War%20on%20Women%E2%80%93%201920x1080%20Website.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20War%20on%20Women%E2%80%93%201920x1080%20Website.jpg?itok=uAfEjT_F","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20War%20on%20Women%E2%80%93%201920x1080%20Website.jpg?itok=B1QXUOZN","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20War%20on%20Women%E2%80%93%201920x1080%20Website.jpg?itok=3jivhBko","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20War%20on%20Women%E2%80%93%201920x1080%20Website.jpg?itok=sKlWgtm5","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20War%20on%20Women%E2%80%93%201920x1080%20Website.jpg?itok=5OR-N5k7","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20War%20on%20Women%E2%80%93%201920x1080%20Website.jpg?itok=slb6slo1"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20War%20on%20Women%E2%80%93%201920x1080%20Website.jpg?itok=uAfEjT_F 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20War%20on%20Women%E2%80%93%201920x1080%20Website.jpg?itok=B1QXUOZN 1920w","https://d12y285rxlbnxt.cloudfron