front.net/styles/480w/s3/2026-06/%20%E2%80%93%20Square%20afbeelding%20onlyEarly.png?itok=8QOERXoR 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-06/%20%E2%80%93%20Square%20afbeelding%20onlyEarly.png?itok=H6PdXI5_ 720w"]},"source":null,"source_link":null},"locations":[{"id":118,"title":"Café Wilhelmina","is_external":false}],"state":null,"club_card_event":true,"colors":{"accent_color":"#b9a387","background_color":"#2596be","text_color":"#FFFFFF"}}],"blocks":[{"type":"paragraph","id":"cfce795a-74d3-4ba0-8a2d-9e9b7f7e4f09","header":{"title":null},"content":{"content":"\u003cp\u003eOnder begeleiding van een Texaanse instructeur leer je gedurende de avond beginnersvriendelijke linedances, met dezelfde choreografieën die worden gedanst in bars en honky-tonks door heel de Verenigde Staten (en ver daarbuiten). Ervaring is niet nodig. Elke dans wordt stap voor stap aangeleerd, zodat iedereen makkelijk kan meedoen. Heb je al ervaring met line dancing? Tijdens de pauzes en na de show dansen we non-stop (en nemen we graag verzoeknummers en dansverzoeken aan).\u003c/p\u003e\u003cp dir=\"ltr\"\u003eWat trek je aan? BYOB... bring your own boots. Stevige schoenen worden aangeraden, bij voorkeur cowboylaarzen.\u003c/p\u003e","links":null}},{"type":"embed","id":"4140fcfc-b02a-43c0-96eb-11ddf853650d","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/zsviGFdHI8Q?si=m3Uq2FtXNTVRGkXv\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724688786,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-gone-country-nl","queryHash":"[\"AgendaDetail-gone-country-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":848,"slug":"/agenda/bridge-around-town-zondag","endpoint":"/nl/agenda/bridge-around-town-zondag","translations":{"nl":"/agenda/bridge-around-town-zondag","en":null},"title":"BRIDGE AROUND TOWN | Zondag ","content":"\u003cp\u003eVan rauwe rock en indie pop, tot opruiende metal, blues, gypsy en psychedelische rock. Vooral enorm veel bijzondere gitaristen. Met hun bands uiteraard. Tijdens BRIDGE Guitar Festival vindt er naast een aantal betaalde concerten ook een groot gratis stadsfestival plaats in het centrum van Eindhoven: \u003cstrong\u003eBRIDGE AROUND TOWN\u003c/strong\u003e. Verdeeld over tien zalen, staan er straks ruim 50 acts op het podium! \u003c/p\u003e\r\n","meta":{"title":"BRIDGE AROUND TOWN ","description":"Van rauwe rock en indie pop, tot opruiende metal, blues, gypsy en psychedelische rock. Vooral enorm veel bijzondere gitaristen. Met hun bands uiteraard. Tijdens BRIDGE Guitar Festival vindt er naast een aantal betaalde concerten ook een groot gratis stadsfestival plaats in het centrum van Eindhoven: BRIDGE AROUND TOWN. Verdeeld over tien zalen, staan er straks ruim 50 acts op het podium! ","image":null},"publish_date":{"timestamp":1705414650,"machine":"2024-01-16T14:17:30+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"BRIDGE AROUND TOWN ","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=DhHdV_b-","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=MF9Gw9vK","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/BRIDGE%20AROUND%20TOWN%20web%20banner.png?itok=7s7V6B9N","320w":"https