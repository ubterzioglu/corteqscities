021526","background_color":"#BFB688","text_color":"#000000"}},{"nid":1889,"title":"Danny Vera ","subtitle":"Beggin’ For More Trouble Part 2","slug":"/agenda/danny-vera-31okt","endpoint":"/nl/agenda/danny-vera-31okt","date":{"timestamp":1793404800,"machine":"2026-10-31"},"thumbnail_image":{"image":{"alt":"Danny Vera Klokgebouw 2","src":"https://d12y285rxlbnxt.cloudfront.net/2026-05/effenaar%201080x1080.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/effenaar%201080x1080.jpg?itok=3ltegrN5","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/effenaar%201080x1080.jpg?itok=aOhwLyuA","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/effenaar%201080x1080.jpg?itok=lLhSrh_A","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/effenaar%201080x1080.jpg?itok=uN23JmK0","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/effenaar%201080x1080.jpg?itok=E1dKNIT_","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/effenaar%201080x1080.jpg?itok=cPJMIIG8"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-05/effenaar%201080x1080.jpg?itok=3ltegrN5 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-05/effenaar%201080x1080.jpg?itok=aOhwLyuA 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/effenaar%201080x1080.jpg?itok=lLhSrh_A 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/effenaar%201080x1080.jpg?itok=uN23JmK0 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/effenaar%201080x1080.jpg?itok=E1dKNIT_ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/effenaar%201080x1080.jpg?itok=cPJMIIG8 720w"]},"source":null,"source_link":null},"locations":[{"id":183,"title":"Klokgebouw","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#fb9101","background_color":"#f0d5ba","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"34fd0049-d114-423c-becf-87ac4d7dff11","header":{"title":null},"content":{"content":"\u003cp\u003eOp zijn nieuwste album\u0026nbsp;\u003cem\u003eIf This Is The End\u003c/em\u003e\u0026nbsp;(2023) tilt hij kwetsbaarheid naar een nieuw niveau. Ontstaan tijdens een periode van zelfreflectie, waarin Gundersen in de bouw werkte na een succesvolle muziekcarrière, verkennen de nummers het verdriet en de mislukkingen van die jaren. Tegelijkertijd belichten ze zijn hernieuwde kijk op hoop en de transformerende kracht van liefde.\u0026nbsp;\u003cem\u003eIf This Is The End\u003c/em\u003e\u0026nbsp;is een intieme en prachtige verzameling indiefolk, voor fans van Bon Iver, Sufjan Stevens of Ben Howard.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"0cdc8172-35e1-42f4-b727-7e3182d09a52","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:30 uur: Deuren open\u003cbr /\u003e\r\n20:00 uur: Show David Ramirez\u003cbr /\u003e\r\n21:20 uur: Show Noah Gundersen\u003cbr /\u003e\r\n(tijden zijn onder voorbehoud)\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"8442aa06-788f-481b-9fcc-b81fa8cd0e41","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/hUG1YV_HPCQ?si=FCMCVzxM8GqXxgpa\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"e20aa0d7-3fa5-4ce1-b087-be3642ebdeca","header":{"title":"David Ramirez"},"content":{"content":"\u003cp\u003eHoe schrijf je liedjes als je hart gebroken is? Hoe zing je over hoop en passie als die van jou verdwenen is? Hoe maak je een album af als de relatie die het inspireerde is geëindigd? Het antwoord van de Texaanse singer-songwriter David Ramirez is verpakt in prachtige, soms hartverscheurende liedjes die doordrenkt zijn van indiefolk, Americana en country.\u003c/p\u003e\r\n\r\n\u003cp\u003eEen geprezen singer-songwriter met een indringende, introspectieve catalogus van doordringende nummers over de maatschappij, religie en de donkere kanten van het hart. Het aankomende album All The Not So Gentle Reminders (2024)\u0026nbsp;is een herinnering aan de kracht van muziek om verschillende emoties op te roepen, vaak binnen hetzelfde lied. Of het nu door een zachte fluistering, een vloeiende zang of een krachtig uithalen op het hoogtepunt van een nummer is, David Ramirez heeft de gave om passie en emotie over te brengen in elk nummer.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"fd6238e8-dac4-462f-bf8e-9e4db1ba5890","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/hpC4Ppa36YA?si=gc42uXU0Ax2yUJzx\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":2,"dataUpdatedAt":1792724847937,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-noah-gundersen-david-ramirez-nl","queryHash":"[\"AgendaDetail-noah-gundersen-david-ramirez-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":840,"slug":"/agenda/conway-machine","endpoint":"/nl/agenda/conway-machine","translations":{"nl":"/agenda/conway-machine","en":null},"title":"Conway The Machine","content":"","meta":{"title":"Conway The Machine","description":"Conway the Machine is al jaren een frisse wind in de Amerikaanse hiphopscene. Na een bijna fatale schietpartij in 2012 besloot de rapper uit Buffalo zich volledig op de muziek te storten en vormde hij - samen met bloedverwanten Westside Gunn en Mach-Hommy - het collectief Griselda Records, dat grotendeels verantwoordelijk is voor de heropleving van de hardcore hiphopsound uit de jaren '90 in deze eeuw. Zijn meest geroemde platen zijn het debuutalbum 'From King To A God' (2020) en 'God Don't Make Mistakes' (2022), al is dat slechts het topje van de ijsberg. Conway heeft inmiddels afscheid genomen van Griselda om zich te richten op zijn eigen label DrumWork - een puur zakelijke beslissing. De MC wordt onder andere geprezen om de rauwe teksten, complexe rijmschema's en zijn arsenaal aan herkenbare ad-libs. Om nog maar te zwijgen over zijn productieve workflow, want alleen al in het afgelopen jaar zijn er zeven (!) projecten van Conway uitgebracht.\r\nDefault image\r\nToggle Actions\r\n\r\nImage\r\nImage\r\nConway header\r\nConway – 1920x1080 Website.jpg\r\nThe maximum number of media items have been selected.\r\nSource\r\n\r\nSource url\r\nURL\r\nStart typing the title of a piece of content to select it. You can also enter an internal path such as /node/add or an external URL such as http://example.com. Enter \u003cfront\u003e to link to the front page. Enter \u003cnolink\u003e to display link text only. Enter \u003cbutton\u003e to display keyboard-accessible link text only.\r\nLink text\r\n","image":{"image":{"alt":"Conway header","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=u_uidY3n","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=D9Evadhl","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=cY9CFRm3","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=7SSsa8ST","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=jgunlu2l","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=4VzA57Wh"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=u_uidY3n 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=D9Evadhl 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=cY9CFRm3 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=7SSsa8ST 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=jgunlu2l 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=4VzA57Wh 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1704903553,"machine":"2024-01-10T16:19:13+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Conway header","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=u_uidY3n","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=D9Evadhl","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=cY9CFRm3","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/Conway%20%E2%80%93%201920x1080%20Website.jpg?itok=7SSsa8ST","480w":"https://d12y285rxlbnxt.cloudfront.net/style