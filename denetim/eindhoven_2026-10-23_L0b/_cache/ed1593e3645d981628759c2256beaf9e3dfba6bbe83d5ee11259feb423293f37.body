%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"d5ab9f52-2bfe-43a4-94e2-2779296b1d69","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:00 Deuren open\u003cbr /\u003e\r\n19:30-20:00 Sick Joy\u003cbr /\u003e\r\n20:20-21:10 The Dirty Nil\u003cbr /\u003e\r\n21:30 Microwave\u003cbr /\u003e\r\n(tijden zijn onder voorbehoud)\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"c264929e-5a79-4a3e-814c-bc1febb4502d","header":{"title":null},"content":{"content":"\u003cp\u003eBekend om hun emotionele teksten en vrolijke melodieën, slaan ze op de laatste plaat Death is a Warm Blanket (2019) een drastisch zwaardere richting in. De voorheen optimistische kijk wordt verruild voor een explosie van mentale en fysieke frustratie, vertaald in dynamische nummers die laten zien hoe krachtig en hartverscheurend muziek kan zijn als het volledig onbegrensd is. In hun vernieuwde geluid hoor je de agressie van post-hardcore en grunge, die liefhebbers van Thrice, Citizen en Balance \u0026amp; Composure ook wel kunnen waarderen. Na lange tijd maken ze eindelijk weer de stop in Nederland, dus wees erbij op zondag 7 april.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"c119b3c3-ff22-4e85-aef4-1426cf16a6f2","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/yuenDKsbSAw?si=kkFfY7C-vMHgHpjN\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"0640bb3c-9fbc-44b6-9021-4100aab3a103","header":{"title":"The Dirty Nil"},"content":{"content":"\u003cp\u003eVertel The Dirty Nil maar beter niet hoe je muziek moet maken. Het Canadese trio is een fijn afgestemde rockmachine die op zijn best is wanneer de leden hun eigenzinnige, uitbundige riffs, en snoeiharde drums op maximaal volume kunnen zetten en wanneer ze hun eigen creativiteit de vrije loop laten. Het nieuwste album Free Rein to Passions (2023) is hun meest authentieke plaat tot nu toe en een directe reactie op de vorige, Fuck Art uit 2021, waarvoor ze conformeerden aan mensen uit de muziekindustrie om op de radio te kunnen komen. En dat lieten ze geen tweede keer gebeuren. Hun nieuwe geluid is het resultaat van wekenlang jammen in oefenruimtes, zonder na te denken en zonder input van buitenaf. En die roekeloze overgave levert nu precies de rock ’n’ roll op die weliswaar niet aan de grillen van de moderne muziekmachine voldoet, maar des te leuker klinkt.\u003c/p\u003e\r\n","image":{"image":{"alt":"The Dirty Nil","src":"https://d12y285rxlbnxt.cloudfront.net/2023-12/the%20dirty%20nil.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-12/the%20dirty%20nil.png?itok=IZYk0iXj","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-12/the%20dirty%20nil.png?itok=HGS0lDYi","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-12/the%20dirty%20nil.png?itok=oiX4yvi3","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-12/the%20dirty%20nil.png?itok=7O0eKOXY","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-12/the%20dirty%20nil.png?itok=GusvzF-n","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-12/the%20dirty%20nil.png?itok=NJR4r4Js"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-12/the%20dirty%20nil.png?itok=IZYk0iXj 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-12/the%20dirty%20nil.png?itok=HGS0lDYi 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-12/the%20dirty%20nil.png?itok=oiX4yvi3 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-12/the%20dirty%20nil.png?itok=7O0eKOXY 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-12/the%20dirty%20nil.png?itok=GusvzF-n 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-12/the%20dirty%20nil.png?itok=NJR4r4Js 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"fe654f15-e9e7-42a5-be75-54aab6e1f669","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/rbDvm7gS8UI?si=8S51o8KugoJiGOgz\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"90fea736-1c1c-4487-a221-2ab67d4a3a59","header":{"title":"Sick Joy"},"content":{"content":"\u003cp\u003eMet een expertise in zware muziek vol pakkende melodieën, hoge energie en scherpe teksten is Sick Joy één van de meest veelbelovende Britse rockbands van het moment. Hun debuut EP Amateurs (2018) viel in de smaak bij Radio 1, Kerrang! Radio en Radio X, én schepte vergelijkingen met bands als Pixies en Slipknot. Niet voor niets speelden ze support shows op voor iconische bands als Pixies, Pearl Team, Dinosaur Pile-Up en Demob Happy. Op het debuutalbum We’re All Gonna F***cking Die, dat vorig jaar uitkwam, hoor je Sick Joy donkerder, zwaarder en venijniger dan ooit. Maar dit is nog maar het begin van het volgende hoofdstuk van het Sick Joy-verhaal. Zorg dat je het niet mist!\u003c/p\u003e\r\n","image":{"image":{"alt":"Sick Joy","src":"https://d12y285rxlbnxt.cloudfront.net/2024-02/Sick%20Joy%20Press%20Shot.jpeg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=Nz9K26Iy","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=XHVrSsI0","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=IwJD9X58","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=Y0GvdO4d","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=3wvTa8Y_","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=HcXGZd2o"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=Nz9K26Iy 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=XHVrSsI0 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=IwJD9X58 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=Y0GvdO4d 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-02/Sick%20Joy%20Press%20Shot.jpeg?itok=3wvTa8Y_ 480