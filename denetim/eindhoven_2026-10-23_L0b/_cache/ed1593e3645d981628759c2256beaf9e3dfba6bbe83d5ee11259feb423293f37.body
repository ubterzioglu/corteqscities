ront.net/styles/2510w/s3/2026-06/isabel%20usher%20%E2%80%93%20Square%20afbeelding%20only.png?itok=NHU48wJt 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-06/isabel%20usher%20%E2%80%93%20Square%20afbeelding%20only.png?itok=ImWuF_0G 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-06/isabel%20usher%20%E2%80%93%20Square%20afbeelding%20only.png?itok=0PRv1rGG 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-06/isabel%20usher%20%E2%80%93%20Square%20afbeelding%20only.png?itok=9AmGzLN7 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":"sold_out","club_card_event":true,"colors":{"accent_color":"#591D07","background_color":"#D8D9D7","text_color":"#000000"}}],"blocks":[{"type":"featured_paragraph","id":"b6e11551-e388-4049-b95c-f9c91ad29daf","header":{"title":"Freddie Konings"},"content":{"content":"\u003cp\u003eToen we de Antwerpse rapper benaderden voor een show bleek dat Freddie Konings nog nooit in Nederland opgetreden heeft! Daar moet dus snel verandering in komen. De granaat uit Chossellonië gaat als een trein in zijn thuisland. Hij bracht al meerdere mokerharde platen uit, waarvan zijn laatste ‘Respect The Pain 1’ misschien wel zijn beste is. Freddie heeft bars voor days, maar wat hij nog meer heeft is energie om elke zaal te veranderen in 1 grote pull-up. We zien je in de moshpit. “WE ZIJN OP GAS GEEN HANDREM!”\u003c/p\u003e\r\n","image":{"image":{"alt":"boolin sq","src":"https://d12y285rxlbnxt.cloudfront.net/2024-04/freddie%20sq.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/freddie%20sq.jpg?itok=NNm9SeSS","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/freddie%20sq.jpg?itok=keilfGbQ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/freddie%20sq.jpg?itok=4QN8v407","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/freddie%20sq.jpg?itok=3OL33tP0","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/freddie%20sq.jpg?itok=1K5V6K52","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/freddie%20sq.jpg?itok=lDX7286M"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/freddie%20sq.jpg?itok=NNm9SeSS 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/freddie%20sq.jpg?itok=keilfGbQ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/freddie%20sq.jpg?itok=4QN8v407 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/freddie%20sq.jpg?itok=3OL33tP0 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/freddie%20sq.jpg?itok=1K5V6K52 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/freddie%20sq.jpg?itok=lDX7286M 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"dfd1949d-7349-4c75-90d7-6e2cf80ce7ff","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/9K0xA5VuZdQ?si=WnT4ilGyCzha_Hvf\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"d4586836-3305-4e3c-9f15-a23c95ac94fa","header":{"title":"Miggs de Bruijn"},"content":{"content":"\u003cp\u003eIs er nog iemand wie we moeten uitleggen who the fuck Miggs de Bruijn is? De local legend gaat al meer dan 10 jaar mee, heeft al meerdere 101Barz geslayed en zo’n beetje alle zalen en festivals van Nederland al kapotgemaakt. Toch kwam dit jaar pas zijn debuutplaat uit! ‘Pieken en Dalen’, uitgebracht op Zware Jongens Records, laat horen dat Miggs na al die jaren nog niet op zijn retour is. Geïnspireerd door Afrobeats en zijn Congolese roots is er een shift in zijn sound te horen, maar Miggs rockt het als vanouds.\u0026nbsp;En dan heeft hij nu ook nog een dikke viral te pakken met dé kampioenstune voor ons PSV. “Rood wit in mijn DNA, coach die mannen net Peter Bosz” \u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"miggs","src":"https://d12y285rxlbnxt.cloudfront.net/2024-05/miggs%20png.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/miggs%20png.png?itok=TYzKFfUb","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/miggs%20png.png?itok=Dcd-8vyU","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/miggs%20png.png?itok=sgV868YT","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/miggs%20png.png?itok=aMfE6sKJ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/miggs%20png.png?itok=KzTu8aON","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/miggs%20png.png?itok=PVDfxr72"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/miggs%20png.png?itok=TYzKFfUb 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/miggs%20png.png?itok=Dcd-8vyU 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/miggs%20png.png?itok=sgV868YT 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/miggs%20png.png?itok=aMfE6sKJ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/miggs%20png.png?itok=KzTu8aON 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/miggs%20png.png?itok=PVDfxr72 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"f9932622-acad-4d8f-a5c7-9fe2f12adf0d","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/C9jW1nXxqF8?si=kGJvm9S10yHmBNru\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"6685bb73-b483-4118-aeab-d47eddb64e4d","header":{"title":"Marou"},"content":{"content":"\u003cp\u003eDe aanstormende Marokkaans-Nederlandse rapper Marou viel ons op door zijn consistente tunes op Spotify, Tiktok en YouTube. Vandaag is de eerste keer dat je hem live in Eindje kan bewonderen.\u003c/p\u003e\r\n","image":{"image":{"alt":"marou","src":"https://d12y285rxlbnxt.cloudfront.net/2024-05/IMG_3116.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/IMG_3116.png?itok=-RmXestr","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/IMG_3116.png?itok=sHS5gTJO","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/IMG_3116.png?itok=j26sbaWv","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/IMG_3116.png?itok=vyZBE4aB","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/IMG_3116.png?itok=_hAvlQbk","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/IMG_3116.png?itok=lIyvjxFG"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/IMG_3116.png?itok=-RmXestr 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/IMG_3116.png?itok=sHS5gTJO 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-05/IMG_3116.png?itok=j26sbaWv 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-05/IMG_3116.png?itok=vyZBE4aB 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-05/IMG_3116.png?itok=_hAvlQbk 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-05/IMG_3116.png?itok=lIyvjxFG 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"1413a4cd-02c3-4bf0-9fe9-20abfc870699","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/M0kvDJ19Tjk?si=I55EEgPtluyxVNE8\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":18,"dataUpdatedAt":1792689776953,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-boolin06-nl","queryHash":"[\"AgendaDetail-boolin06-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1991,"slug":"/agenda/durum-night","endpoint":"/nl/agenda/durum-night","translations":{"nl":"/agenda/durum-night","en":null},"title":"Durum Night","content":"\u003cp\u003eDurum Night brengt de sound van Durum Records naar de club. Een nieuwe serie in Effenaar waarin muziek van over de hele wereld samenkomt met psychedelische rock, funk, jazz en elektronische sounds. Verwacht avontuurlijke live-acts en dj’s uit verschillende hoeken van de wereld: artiesten die putten uit hun eigen muzikale roots en die combineren met hedendaagse invloeden. Van psychedelische grooves en Anatolische funk tot Noord-Afrikaanse ritmes, wereldse elektronica en alles daartussenin.\u003c/p\u003e\u003cp\u003eMet deze editie: Sababa 5, Zajal en Trackvogels.\u003c/p\u003e","meta":{"title":"Durum Night met Sababa 5, Zajal en Trackvogels | Effenaar","description":"Durum Nights is een nieuw concept in Effenaar die de sound van Durum Records naar de club brengt. Verwacht avontuurlijke live-acts en dj’s uit verschillende hoeken van de wereld: artiesten die putten uit hun eigen muzikale roots en die combineren met hedendaagse invloeden. Met deze editie: Sababa 5, Zajal en Trackvogels!","image":{"image":{"alt":"D