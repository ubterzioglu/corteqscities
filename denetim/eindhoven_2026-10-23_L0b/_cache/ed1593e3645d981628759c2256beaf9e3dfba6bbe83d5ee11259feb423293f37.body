209949.jpg?itok=rJGoFYJl"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=MuH13ZES 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=nWws2LUH 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=nAY3igSh 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=8-a_jbqa 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=nLP8a3vg 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=rJGoFYJl 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#BFBFBF","background_color":"#404040","text_color":"#FFFFFF"},"tags":[],"related_events":[]},{"type":"longread","nid":715,"slug":"/artikelen/muziek-en-cultuur-zijn-letterlijk-toegevoegde-waarden-voor-je-levenskwaliteit","endpoint":"/nl/artikelen/muziek-en-cultuur-zijn-letterlijk-toegevoegde-waarden-voor-je-levenskwaliteit","translations":{"nl":"/artikelen/muziek-en-cultuur-zijn-letterlijk-toegevoegde-waarden-voor-je-levenskwaliteit","en":null},"title":"'Muziek en cultuur zijn letterlijk toegevoegde waarden voor je levenskwaliteit'","content":"\u003cp\u003eDit weekend geniet je van meer dan 60 acts tijdens het gratis stadsfestival Hit The City, dat wordt georganiseerd door Effenaar en Friendly Fire. Carl Leen, muziekliefhebber én Programma Manager Maatschappelijke betrokkenheid, zet zich samen met zijn collega’s vanuit ASML in voor een bruisende en inclusieve leefomgeving in regio Eindhoven, waarbij Hit The City een belangrijk deel vormt in deze missie.\u003c/p\u003e\r\n","meta":{"title":"“Muziek en cultuur zijn letterlijk toegevoegde waarden voor je levenskwaliteit”","description":"Lees hier het hele artikel.","image":nul