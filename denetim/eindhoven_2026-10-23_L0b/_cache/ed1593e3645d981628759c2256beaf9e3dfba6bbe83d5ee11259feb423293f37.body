udfront.net/styles/1920w/s3/2026-05/effenaar%201080x1080.jpg?itok=aOhwLyuA 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-05/effenaar%201080x1080.jpg?itok=lLhSrh_A 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-05/effenaar%201080x1080.jpg?itok=uN23JmK0 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-05/effenaar%201080x1080.jpg?itok=E1dKNIT_ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-05/effenaar%201080x1080.jpg?itok=cPJMIIG8 720w"]},"source":null,"source_link":null},"locations":[{"id":183,"title":"Klokgebouw","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#fb9101","background_color":"#f0d5ba","text_color":"#000000"}}],"blocks":[{"type":"featured_paragraph","id":"58a47400-2523-465b-ab98-3b97702fe51d","header":{"title":"14:00-14:30 Mila \u0026 Mira"},"content":{"content":"\u003cp\u003eBij deze muzikale twee-eenheid staat samenzang en vrijheid voorop. Hun dromerige indiepop neemt je mee langs zonnige velden en ontwapenende dorpjes. Warme akoestische klanken wisselen af met koele elektronica, waardoor gedachten de vrije loop krijgen. Dankzij hun gevoel voor hooks zullen de reflecterende teksten van Mila \u0026amp; Mira je nog lang bijblijven.\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"miramila","src":"https://d12y285rxlbnxt.cloudfront.net/2023-06/milamira-lobkebesselink-1-1.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=Ey0Esruq","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=dDNwB_5I","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=XDxnptBn","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=VAT_XolC","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=fcmZ2jlb","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=uozQfAhu"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=Ey0Esruq 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=dDNwB_5I 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=XDxnptBn 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=VAT_XolC 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=fcmZ2jlb 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/milamira-lobkebesselink-1-1.png?itok=uozQfAhu 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"featured_paragraph","id":"b457b18c-a228-44d8-9e8a-847f51dcad40","header":{"title":"15:00-15:45 Tim Vantol"},"content":{"content":"\u003cp\u003eAls de arm die je weer naar binnen trekt vanuit het raam waar je net uit viel. Als de welwillende leider van een goedaardige straatbende, of de laatste verantwoordelijke man in deze gekke wereld. Zo klinkt de stem van Tim Vantol. Rauw, maar ruw zoals de wol in je favoriete trui in plaats van schuurpapier-rauw. Met zijn onstuitbare energie, die hij eerder ook al meenam als supportact van Heideroosjes naar onze Grote Zaal, hecht hij veel waarde aan elke positieve gedachte die je kunt opbrengen te uiten, omdat niets in dit leven als vanzelfsprekend kan worden beschouwd.\u003c/p\u003e\r\n","image":{"image":{"alt":"tim vantol","src":"https://d12y285rxlbnxt.cloudfront.net/2023-06/134615081_243872097096812_4935977212759536423_n.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=M5KcQYxM","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=Hp52W4CP","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=A_8Sw6so","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=96xHpFvd","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=9MZw6lxe","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=KXBZJgau"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=M5KcQYxM 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=Hp52W4CP 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=A_8Sw6so 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=96xHpFvd 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=9MZw6lxe 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/134615081_243872097096812_4935977212759536423_n.png?itok=KXBZJgau 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"featured_paragraph","id":"43d6d9c3-ab19-4089-81ae-bbf8fc8ea250","header":{"title":"16:30-17:30 Texas String Assembly"},"content":{"content":"\u003cp\u003eDeze 7-koppige band heeft zijn eigen plek veroverd in de favoriete rock-’n-roll clubs van Austin. Met elementen van bluegrass, funk, jazz, folk country en hippie-jugband groeiden ze van achtertuinen tot bars tot geliefde locaties. Met een snel groeiende fanbase is Texas String Assembly klaar voor de festivalweides en een jaar gevuld met extra singles en een tweede album.\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"tsa ","src":"https://d12y285rxlbnxt.cloudfront.net/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=LsWQavUD","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=xPMgut_6","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=sQJf6b_A","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=0Ogse6kJ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=uNNCT_6t","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=ltyWa6bF"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=LsWQavUD 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=xPMgut_6 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=sQJf6b_A 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=0Ogse6kJ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=uNNCT_6t 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-06/TSA%20-%20Mohawk%20-%2012.30.22-19%20%281%29.png?itok=ltyWa6bF 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"c3b29840-a6c2-4cf4-80fb-ad58b34044d1","header":{"title":"Duurzaamheid"},"content":{"content":"\u003cp\u003eMet het oog op duurzaamheid, verzoekt de organisatie van Groendomein 't Wasven zoveel mogelijk gasten met de fiets te komen. Ook wordt er gebruik gemaakt van hardcups, om wegwerpplastic tegen te gaan.\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"4f8bc4b9-c884-4ecf-94e7-16650154529b","header":{"title":"Dit was Effenaar 't Wasven 2022:","description":null},"content":{"items":[{"image":{"alt":"wv22","src":"https://d12y285rxlbnxt.cloudfront.net/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=37F1MS8d","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=NNXEmqFZ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=4NNI6Kox","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=Yi--l3xg","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=ScfEebW2","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=aXnNSW2A"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=37F1MS8d 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=NNXEmqFZ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=4NNI6Kox 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-05/289438038_10161212263622985_4801717327656305785_n.jpg?itok=Yi--l3xg 320w","https://d12y285rxlbnxt.clo