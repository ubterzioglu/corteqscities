4/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=V7Fp0_u4","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=EyMLiGdS","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=dzKzM-eD","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=EFGl8O8l","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=nM2oREar","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=bJBaYU1j"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=V7Fp0_u4 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=EyMLiGdS 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=dzKzM-eD 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=EFGl8O8l 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=nM2oREar 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20only%20gallowstr.png?itok=bJBaYU1j 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":"last_tickets","club_card_event":true,"colors":{"accent_color":"#F28F6B","background_color":"#011826","text_color":"#ffffff"}}],"blocks":[{"type":"paragraph","id":"a6cd5c11-5b20-4681-a157-376767e710ac","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:30 Deuren open\u003cbr /\u003e\r\n20:30-22:00 Kin'Gongolo Kiniata\u003cbr /\u003e\r\n(tijden onder voorbehoud)\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"a88d6a32-a461-41ef-a81c-ac3009d748c8","header":{"title":"Het verpletterende geluid"},"content":{"content":"\u003cp\u003eVoordat ze internationale festivals in Europa en Amerika veroverden (waaronder Lowlands afgelopen jaar), werd de groep gevormd in de straten van Kinshasa, waar elk geluid en elke beat de realiteit van het dagelijks leven weerspiegelt. De bandnaam betekent \"het verpletterende geluid\", wat dient als perfecte metafoor voor de krachtige muziek van de groep. Met handgemaakte instrumenten van gerecylede materialen als plastic flessen en metaal weten ze stedelijke chaos om te zetten in een\u0026nbsp;opvallende mix van Afropop, Congolese punk en experimentele elektronisering.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_quote","id":"aff775bf-1041-4469-aa82-86a33e18a168","header":{"title":null,"description":null},"content":{"quote":"Punkier dan Kin'Gongolo Kiniata wordt het niet.","author":"3voor12"}},{"type":"embed","id":"2d805a91-995f-42bd-8a40-5a3958f3184a","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/RTbSQQLtUCQ?si=MN-SRi_sxitqaudF\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724684570,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-kingongolo-kiniata-nl","queryHash":"[\"AgendaDetail-kingongolo-kiniata-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1230,"slug":"/agenda/carsick","endpoint":"/nl/agenda/carsick","translations":{"nl":"/agenda/carsick","en":null},"title":"CARSICK","content":"\u003cp\u003e“‘Anthems for the pissed-up and pissed-off'', zoals CARSICK zelf hun muziek omschrijft, hadden wij het niet beter kunnen zeggen. Dit viertal mengt rauwe punk, 90’s-geïnspireerde indierock, UK hiphop en een vleugje elektronica tot een typisch Brits amalgaam waar goed bier op te drinken is.\u003c/p\u003e\r\n","meta":{"title":"CARSICK","description":"","image":null},"publish_date":{"timestamp":1731059400,"machine":"2024-11-08T09:50:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"CARSICK header","src":"https://d12y285rxlbnxt.cloudfront.net/2024-11/Carsick%20%E2%80%93%201920x1080%20Website.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Carsick%20%E2%80%93%201920x1080%20Website.jpg?itok=JZxdUzoD","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Carsick%20%E2%80%93%201920x1080%20Website.jpg?itok=ZApbxcGG","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11/Carsick%20%E2%80%93%201920x1080%20Website.jpg?itok=SHDPqyOm","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-11/Carsick%20%E2%80%93%201920x1080%20Website.jpg?itok=osriV6OC","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-11/Carsick%20%E2%80%93%201920x1080%20Website.jpg?itok=-zNeQTcG","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-11/Carsick%20%E2%80%93%201920x1080%20Website.jpg?itok=o5eYtpXE"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-11/Carsick%20%E2%80%93%201920x1080%20Website.jpg?itok=JZxdUzoD 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-11/Carsick%20%E2%80%93%201920x1080%20Website.jpg?itok=ZApbxcGG 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-11