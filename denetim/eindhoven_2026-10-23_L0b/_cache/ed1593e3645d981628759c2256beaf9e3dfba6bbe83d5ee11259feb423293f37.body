5rxlbnxt.cloudfront.net/styles/2510w/s3/2025-01/ThumbDewolff_0.png?itok=4exKu1EL 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-01/ThumbDewolff_0.png?itok=trfv8lSo 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-01/ThumbDewolff_0.png?itok=MlVvGgpG 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-01/ThumbDewolff_0.png?itok=G24Sg86v 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#597351","background_color":"#D9D3B8","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":994,"slug":"/artikelen/cafe-wilhelmina-staat-de-tijd-stil-maar-tikt-de-klok-door","endpoint":"/nl/artikelen/cafe-wilhelmina-staat-de-tijd-stil-maar-tikt-de-klok-door","translations":{"nl":"/artikelen/cafe-wilhelmina-staat-de-tijd-stil-maar-tikt-de-klok-door","en":null},"title":"‘In Café Wilhelmina staat de tijd stil, maar tikt de klok door’","content":"\u003cp\u003eKoos Cornelissen (71) noemt zichzelf een ‘brave’ gitarist, maar is tegelijkertijd rijk aan wilde verhalen over spelen voor een zaal met boze Hells Angels en als openingsact spelen voor The Clash en Iggy Pop als gitarist van de Eindhovense punkband Flyin’ Spiderz. Dankzij Koos vonden grote namen uit de jazz- en blueswereld hun weg naar het podium in Café Wilhelmina. “Maar ik kwam als mopperende klant binnen, hoor.”\u003c/p\u003e\r\n","meta":{"title":"‘In Café Wilhelmina staat de tijd stil, maar tikt de klok door’","description":"Lees hier het hele interview met Koos Cornelissen van Café Wilhelmina.","image":null},"publish_date":{"timestamp":1714552632,"machine":"2024-05-01T08:37:12+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Wilhelmina","src":"https://d12y285rxlbnxt.cloudfront.net/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/20240402_KoosCornelissen_MaxKneefel_6133.png?itok=Dif7_wkC","1920w":"https://d12y285rxlbnxt.cloudfront.net/s