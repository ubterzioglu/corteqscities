%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"a7ee2650-48d4-4883-a2d6-0da2e07d2e67","header":{"title":null},"content":{"content":"\u003cp\u003eOp hun eerste studioalbum Dünyanın En İyi Albümü (2017) haalden ze hun inspiratie bij bands als Red Hot Chili Peppers en introduceerden ze funkrock elementen in hun geluid. Het duo produceert hun eigen muziekvideo’s, die lijken op mini-films, en maken hun eigen stagedesigns waarmee ze de aandacht trekken van miljoenen luisteraars van over de hele wereld. Vorig jaar brachten ze hun nieuwste album Ölüm Dansı (2023) uit, en maakten ze een documentaireserie genaamd “Dedim Olabilir: An Independent Music Documentary”, die licht werpt op de onafhankelijke muziekscene van Turkije. Dit jaar vieren ze hun tiende jaar in de muziek en dat vraagt om nieuwe liedjes, nieuwe projecten én een nieuwe tour. Op vrijdag 17 mei zie je Dolu Kadehi Ters Tut in onze Kleine Zaal!\u003c/p\u003e\r\n\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"7e2ea401-035a-4ae9-9d3d-ea12f9039dc9","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e20:00 uur: Deuren open\u003cbr /\u003e\r\n21:00 uur: Show Dolu Kadehi Ters Tut\u003cbr /\u003e\r\n(tijden zijn onder voorbehoud)\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"d2b874b7-8711-48c6-921c-9da43ead4ba8","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/H0z_FL1XkYc?si=fh-O6dGT76gio-Vr\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":2,"dataUpdatedAt":1792724824560,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-dolu-kadehi-ters-tut-nl","queryHash":"[\"AgendaDetail-dolu-kadehi-ters-tut-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":856,"slug":"/agenda/upchuck","endpoint":"/nl/agenda/upchuck","translations":{"nl":"/agenda/upchuck","en":null},"title":"Upchuck","content":"\u003cp\u003eErgens op het kruispunt tussen punk, garagerock, hardcore en (on)gecontroleerde chaos vind je Upchuck. De bandleden vonden elkaar in de experimentele skatescene van Atlanta, en ondanks nauwelijks online aanwezigheid werden ze al snel de hype van hun thuisstad.\u003c/p\u003e\r\n","meta":{"title":"Upchuck","description":"","image":null},"publish_date":{"timestamp":1706003700,"machine":"2024-01-23T09:55:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Upchuck header","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/%20%E2%80%93%201920x1080%20Website_1.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_1.jpg?itok=D_1tlDzr","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_1.jpg?itok=R7ySmJ-G","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_1.jpg?itok=hzwhuCZ7","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_1.jpg?itok=IM81CEvR","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_1.jpg?itok=_SLc3rTL",