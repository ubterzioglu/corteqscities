620","background_color":"#F3F3F0","text_color":"#000000"},"tags":[],"related_events":[]}]}}],"subtitle":"Door Tijs Heesterbeek","thumbnail_image":{"image":{"alt":"speedking","src":"https://d12y285rxlbnxt.cloudfront.net/2025-09/speedking059.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-09/speedking059.png?itok=QCF3UDt5","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-09/speedking059.png?itok=d5vGIBU7","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-09/speedking059.png?itok=OmRwyRyD","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-09/speedking059.png?itok=sMYE1HRl","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-09/speedking059.png?itok=5sgS3INU","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-09/speedking059.png?itok=xOUwORoP"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-09/speedking059.png?itok=QCF3UDt5 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-09/speedking059.png?itok=d5vGIBU7 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-09/speedking059.png?itok=OmRwyRyD 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-09/speedking059.png?itok=sMYE1HRl 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-09/speedking059.png?itok=5sgS3INU 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-09/speedking059.png?itok=xOUwORoP 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F2133C","background_color":"#0D0D0D","text_color":"#FFFFFF"},"tags":[],"related_events":[]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724599843,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"LongReads-uit-de-tijdcapsule-de-allereerste-show-de-nieuwe-effenaar-nl","queryHash":"[\"LongReads-uit-de-tijdcapsule-de-allereerste-show-de-nieuwe-effenaar-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"longread","nid":183,"slug":"/artikelen/van-punkhol-naar-professionele-popzaal-50-jaar-effenaar","endpoint":"/nl/artikelen/van-punkhol-naar-professionele-popzaal-50-jaar-effenaar","translations":{"nl":"/artikelen/van-punkhol-naar-professionele-popzaal-50-jaar-effenaar","en":null},"title":"Van punkhol naar professionele popzaal: 50 jaar Effenaar","content":"\u003cp\u003eAl vijftig jaar gaan we ‘effe naar de Effenaar’. Maar waar komt die naam vandaan? En hoe is het exclusieve ‘in-crowd-punkhol’ van vroeger uitgegroeid tot een grote, professionele poptempel voor iedereen in de stad?\u003c/p\u003e\r\n","meta":{"title":"Van punkhol naar professionele popzaal: 50 jaar Effenaar","description":"","image":null},"publish_date":{"timestamp":1662967031,"machine":"2022-09-12T07:17:11+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Archive1","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/Banner_0.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Banner_0.jpg?itok=yk02HlQr","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Banner_0.jpg?itok=72MTUJpg","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Banner_0.jpg?itok=3Z1uKthA","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Banner_0.jpg?itok=wO09vYuI","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Banner_0.jpg?itok=XaI-S4CT","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Banner_0.jpg?itok=XStr0gmV"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Banner_0.jpg?itok=yk02HlQr 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Banner_0.jpg?itok=72MTUJpg 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Banner_0.jpg?itok=3Z1uKthA 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Banner_0.jpg?itok=wO09vYuI 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Banner_0.jpg?itok=XaI-S4CT 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Banner_0.jpg?itok=XStr0gmV 720w"]},"source":null,"source_link":null},"breadcrumb":null,"blocks":[{"type":"paragraph","id":"56b97de7-05ec-4140-a95e-f7c1a74fc410","header":{"title":null},"content":{"content":"\u003cp\u003eDe inmiddels overleden vader van Barbara van der Put bedacht de naam Effenaar in ’1971, in de tijd dat de voorloper van het poppodium wel toe was aan een opfrisser van het imago. Huub van der Put kreeg de klus om een nieuwe naam te verzinnen voor een nieuw poppodium in Eindhoven, ontstaan uit een gekraakt jeugdhonk.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"2ccfe903-7a47-49dd-9bcd-5c78fb069ed4","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Archive2","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/61004102.jpeg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/61004102.jpeg?itok=JOaYo5u6","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/61004102.jpeg?itok=E-8qPw8O","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/61004102.jpeg?itok=jko_xSqU","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/61004102.jpeg?itok=qFkgj-4w","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/61004102.jpeg?itok=NVaRkav7","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/61004102.jpeg?itok=5XUACYWs"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/61004102.jpeg?itok=JOaYo5u6 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/61004102.jpeg?itok=E-8qPw8O 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/61004102.jpeg?itok=jko_xSqU 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/61004102.jpeg?itok=qFkgj-4w 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/61004102.jpeg?itok=NVaRkav7 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/61004102.jpeg?itok=5XUACYWs 720w"]},"source":"Para+ | De bezetting van het gerechtshof op Stratumseind in 1969","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"40d90a05-052a-4240-b246-1adf0b22cad0","header":{"title":"De voorloper van"},"content":{"content":"\u003cp\u003ePara+ was hét jongerencentrum van Eindhoven waar vrijheid voorop stond: jongeren uit de stad konden daar zichzelf zijn, zich uiten hoe ze wilden en er doen en laten wat ze wilden. Die plek hadden ze in Eindhoven voorheen nog niet, eerder werd er met jaloezie gekeken naar Paradiso in Amsterdam.\u003cbr /\u003e\r\n\u003cbr /\u003e\r\nDe communistische jongeren van De Rode Jeugd en studenten van de Akademie voor Industriéle Vormgeving kraakten het kantongebouw in Eindhoven en maakten van het statige stadspand hun tijdelijke thuis. Er ontstond een hechte subcultuur. Daar hoort natuurlijk niet alleen een koude Fristi bij, in de jaren ’70 waren verdovende middelen niet minder populair dan nu. Toen dat toch ietwat de spuigaten uit begon te lopen volgens de gemeente, werd het tijd voor een flinke wasbeurt en een nieuwe, serieuze plek.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"7f262c01-c8f1-4d82-8d7d-e01ed22fdba1","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Archive 3","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/Effenaar1.jpeg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Effenaar1.jpeg?itok=p3Oka8Wx","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Effenaar1.jpeg?itok=x8Hm7ua5","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Effenaar1.jpeg?itok=10rprgOe","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Effenaar1.jpeg?itok=uWFh4BLj","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Effenaar1.jpeg?itok=McBL1DJi","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Effenaar1.jpeg?itok=zjWLqO7_"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Effenaar1.jpeg?itok=p3Oka8Wx 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Effenaar1.jpeg?itok=x8Hm7ua5 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Effenaar1.jpeg?itok=10rprgOe 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Effenaar1.jpeg?itok=uWFh4BLj 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Effenaar1.jpeg?itok=McBL1DJi 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Effenaar1.jpeg?itok=zjWLqO7_ 720w"]},"source":"De leegstaande linnenweverij van Van den Briel wordt Effenaar in 1971","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"3754a1e0-df4c-49d8-b5de-2203ab14c794","header":{"title":"Een weefinstrument"},"content":{"content":"\u003cp\u003eCopywriter en reclame-expert Huub van der Put ging met de prestigieuze opdracht aan de haal en kwam na een tijdje terug met de naam Effenaar. Het nieuwe podium kreeg een plek toegewezen van de gemeente Eindhoven, waar eerder een linnenfabriek stond. Naast dat een effenaar een weefinstrument is dat stoffen in een linnenfabriek ‘vereffent’ en glad maakt, klinkt het natuurlijk ook lekker Brabants. ‘Effe naar ..’, vul het maar in; deze leus kent iedere Eindhovenaar wel. Het imago van Para+ werd dus ook gladgestreken, een mooie dubbelzinnigheid die Van Der Put uitermate geschikt vond voor het nieuwe poppodium.\u003cbr /\u003e\r\n\u003cbr /\u003e\r\nOf het direct zou werken? De inmiddels 62-jarige Barbara van der Put vertelt over die tijd: ‘Ik mocht op mijn zeventiende van mijn ouders nog niet naar het concert van Talking Heads, omdat het toch de naam had van een soort punkhol. Het was de laatste keer dat Talking Heads in een klein zaaltje speelde, daarna braken ze flink door.’ Balen, maar ze zou toen ze iets ouder was nog veel New Wave-bands zien in het ‘nieuwe’ Effenaar.\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"77aa9a90-0743-418c-9745-2b041ddfb6e0","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Joy Division, 1980","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/Joy%20Division%2C%201980-2.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=0aHp3zzl","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=nSz95uHP","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=LDURP-H4","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=AjpiSaY6","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=e3yB4vsu","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=IKMIA8HV"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=0aHp3zzl 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=nSz95uHP 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=LDURP-H4 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=AjpiSaY6 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=e3yB4vsu 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Joy%20Division%2C%201980-2.jpg?itok=IKMIA8HV 720w"]},"source":"Foto: Peter Cox | Joy Division in Effenaar, 18 januari 1980","source_link":null},"is_fullscreen":true}},{"type":"paragraph","id":"17e0c38e-4ba5-4e80-bad4-1f6f5e4782d8","header":{"title":"‘Iedereen is welkom, behalve fans van De Dijk’"},"content":{"content":"\u003cp\u003eVan kleine vrijhaven waar nul, en dan ook echt nul, regels golden, naar een groot cultureel poppodium waar artiesten, publiek en werknemers samen professionele producties optuigen en mensen zich welkom voelen. Hoe gebeurt zoiets? Robert Schaeffer is Hoofd Programma \u0026amp; Marketing bij Effenaar en loopt er al zo’n 25 jaar rond. Hij begon als vrijwilliger en kreeg later via een sociaal-maatschappelijk programma een betaalde baan als Assistent-Programmeur.\u003cbr /\u003e\r\n\u003cbr /\u003e\r\n‘Toen ik in de jaren ’90 als vrijwilliger bij Effenaar kwam werken, was het al een podium in transitie. Eerst was het een plek voor de postpunkers, zo’n 10% van de Eindhovense jongeren. Die waren er dan ook echt altijd, een soort clubhuis voor de underground. De andere 90% van de jongeren durfden daar ook helemaal niet binnen te komen. Voor de in-crowd was het een fantastische tijd, maar anderen zagen het als een vies drugshol waar ze ver weg van bleven.’\u003cbr /\u003e\r\n\u003cbr /\u003e\r\nRobert ‘onderdeel van het meubilair van Effenaar’ Schaeffer vertelt dat het – als je er in zat – juist een enorm tolerante plek was, waar iedereen zijn puurste zelf kon zijn. Alles was goed, als je maar niet van De Dijk hield. Dan kreeg je het met de ‘muziekpolitie’ aan de stok.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"f30de9f0-bbbe-45ab-a734-c45d5094a7f3","header":{"title":"Drie keer De Dijk in de Grote Zaal"},"content":{"content":"\u003cp\u003eInmiddels zijn zo’n 70 tot 80% van de Eindhovense jongeren wel eens in Effenaar geweest, en meestal ook vaker dan maar een paar keer. ‘Maar we zijn van niemand meer het thuishonk’, vertelt Schaeffer, naast lid van het managementteam ook een van de drie programmeurs van Effenaar.\u003cbr /\u003e\r\n\u003cbr /\u003e\r\nHet moge duidelijk zijn, het poppodium is net als van naam ook van functie veranderd. De belangen zijn groter, de eisen en regels zijn strenger en vooral de stad is enorm veranderd en gegroeid. Deze zomer staat De Dijk zelfs\u0026nbsp;drie keer\u0026nbsp;in een uitverkochte grote zaal van Effenaar om hun afscheidstour te spelen, waarschijnlijk met een hoop bezoekers van toen. ‘De tijd van het spelen van de muziekpolitie is wel over. We zijn nu hartstikke trots dat ze drie keer komen’, vertelt de Brabantse programmeur met een lach. ‘Het gaat er tegenwoordig veel meer om wat de mensen in de stad willen. Ook buiten ons eigen gebouw.’\u003cbr /\u003e\r\n\u003cbr /\u003e\r\nEffenaar heeft na vijftig jaar vooral die sociaal-maatschappelijke functie in de stad, vindt ook\u0026nbsp;programmeur Steffi Blonk. ‘We brengen mensen samen, die allemaal naar Effenaar komen omdat ze heel erg van iets houden. Of dat nou de locatie, de muziek of een specifiek genre is, dat is nog steeds de reden om een bezoekje te brengen aan ons podium.’ Een groot verschil dat zij merkt, is dat de popsector van gezellige honkjes en clubhuizen naar een echte industrie is uitgegroeid. ‘Dat neemt met zich mee dat het belangrijk is geworden om te zorgen dat de Effenaar financieel goed draait en dat we genoeg mensen trekken. Negen van de tien keer is dit werk gewoon keihard beuken en meedraaien met de machine die we met z’n allen gebouwd hebben.’ Soms is die hard en koud, beschrijft ze, en is er geen ruimte voor creativiteit. ‘We zijn ook allemaal dezelfde soort grote gebouwen als blokkendozen gaan bouwen, bijvoorbeeld.’\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"6171edbd-2ef9-47c0-a2eb-f84d4590fa54","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Hybrid Music Vibes","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/hybridmusicvibes.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/hybridmusicvibes.jpg?itok=MZPmb3-f","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/hybridmusicvibes.jpg?itok=DJyBUSV9","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/hybridmusicvibes.jpg?itok=qwqfw1eK","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/hybridmusicvibes.jpg?itok=gm1gJSsd","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/hybridmusicvibes.jpg?itok=QbYUo2j-","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/hybridmusicvibes.jpg?itok=39AdRAHX"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/hybridmusicvibes.jpg?itok=MZPmb3-f 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/hybridmusicvibes.jpg?itok=DJyBUSV9 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/hybridmusicvibes.jpg?itok=qwqfw1eK 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/hybridmusicvibes.jpg?itok=gm1gJSsd 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/hybridmusicvibes.jpg?itok=QbYUo2j- 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/hybridmusicvibes.jpg?itok=39AdRAHX 720w"]},"source":"Foto: Patrick Spuytenburg | Productieleider Ernst-Jan tijdens opnames van Hybrid Music Vibes","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"e578d9f3-16bd-44b7-b831-ffaa799ed9fb","header":{"title":"‘We willen allemaal van de kneuterigheid van vroeger af’"},"content":{"content":"\u003cp\u003eVooral op het samenstellen van het programma heeft deze ontwikkeling invloed, vertelt Steffi. ‘De sociale en financiële functies kunnen goed naast elkaar bestaan, maar af en toe is de balans misschien zoek. Een voorbeeld is dat we de grote zaal zo vaak mogelijk willen vullen met veel mensen, waardoor we alleen zoeken naar acts die dat kunnen.’ Dat zijn soms niet de meest spannende of ‘coole’ namen. ‘Doordat we een industrie zijn geworden en doordat alle grote podia hetzelfde zijn gaan doen, willen we allemaal de grote bands boeken en van die kneuterigheid van vroeger af.’\u003cbr /\u003e\r\n\u003cbr /\u003e\r\nToch is ook die Grote Zaal van creatief en artistiek belang voor de niches en de meer abstracte projecten. ‘Met wat daar financieel uitkomt, kunnen we ook weer hele mooie kleine en nieuwe dingen doen. Ik vind het juist fantastisch om gesprekken te voeren met mensen over wat ze bezighoudt en welke dingen zij willen doen, waarna ik ga kijken of daar ruimte voor is bij Effenaar en of we met elkaar tot iets leuks kunnen komen. Dat lijkt meer op het programmeren van vroeger, wat tijd en geld kost. Dat is er niet altijd.’\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"9bdc20d7-3f0d-4761-944e-b9f479e567a0","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Archive 4","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=H3VANtE2","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=HDuSZq6W","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=cTvq8xl4","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=9-Zsgrtu","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=6M0wHc65","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=881UMSwS"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=H3VANtE2 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=HDuSZq6W 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=cTvq8xl4 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=9-Zsgrtu 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=6M0wHc65 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Opening_Nieuwe_Effenaar_Paul_Verhagen.jpg?itok=881UMSwS 720w"]},"source":"Foto: Paul Verhagen | Opening nieuwe Effenaar-gebouw in oktober 2005","source_link":null},"is_fullscreen":true}},{"type":"paragraph","id":"6bdde37a-8ecb-4cc7-9e97-d898d89db48e","header":{"title":"De handen ineen"},"content":{"content":"\u003cp\u003eEen onmiskenbaar positieve verandering van de professionalisering van het poppodium, is dat het team goed weet wat mensen in de stad willen en er daardoor een veel breder aanbod is, dat het team weet wat artiesten nodig hebben voor een flitsende show, dat samenwerkingen met kleinere podia in de stad leiden tot die fijne, rauwe energie die jonge mensen vaak opzoeken, en dat Effenaar als enige podium voor de vraag uit loopt door flink in te zetten op digitalisering en hybridevormen van livemuziek. Dit doet Effenaar bijvoorbeeld door artiesten kennis te laten maken met hybride vormen van muziek maken en opnemen in de interne Makerspace, waar AR en VR-tools aanwezig zijn.\u0026nbsp;17 artiesten\u0026nbsp;mochten meedoen aan het project\u0026nbsp;\u003ca href=\"https://www.instagram.com/p/CeTjKB_K4mn/\" target=\"_blank\"\u003eHybrid Music Vibes\u003c/a\u003e, waarin zij de nodige hulpmiddelen, kennis en steun krijgen om hun muziek ook in het digitale universum te verspreiden.\u003cbr /\u003e\r\n\u003cbr /\u003e\r\nMaar daarnaast is Effenaar er ook voor een compleet andere groep, vertelt Robert Schaeffer: de mensen die graag iets willen organiseren in de stad. ‘Het feit dat we\u0026nbsp;\u003ca href=\"https://www.instagram.com/nox_bass/\" target=\"_blank\"\u003eNOX events\u003c/a\u003e\u0026nbsp;van de kleine naar de grote zaal en daarna naar een compleet buiten-festival hebben kunnen helpen, is een mooi voorbeeld van hoe initiatieven uit de stad met de juiste samenwerking kunnen opbloeien.’ Dat gevoel van community is dus nog niet helemaal weg.\u003cbr /\u003e\r\n\u003cbr /\u003e\r\n‘Daarom vind ik het zo leuk om bij Het Stroomhuis zelf aan de deur te gaan staan om mensen hun kaartjes te checken, of om af en toe te dj’en bij kleinere shows. De lol om samen iets te maken, is er nog steeds. Dat is ook zo in de grote, professionele Effenaar, met het hele team maken we een speciale ervaring voor mensen die ons komen bezoeken. Dat blijft.’\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"aab7c81b-62eb-4cdf-b696-721980722e34","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"The Damned","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/The%20Damned.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/The%20Damned.jpg?itok=XXBmttRl","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/The%20Damned.jpg?itok=4C2Y0X3Z","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/The%20Damned.jpg?itok=5lzg5Ax9","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/The%20Damned.jpg?itok=OVh5O3Wd","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/The%20Damned.jpg?itok=5z0Le7dp","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/The%20Damned.jpg?itok=Qs0QfIAE"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/The%20Damned.jpg?itok=XXBmttRl 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/The%20Damned.jpg?itok=4C2Y0X3Z 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/The%20Damned.jpg?itok=5lzg5Ax9 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/The%20Damned.jpg?itok=OVh5O3Wd 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/The%20Damned.jpg?itok=5z0Le7dp 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/The%20Damned.jpg?itok=Qs0QfIAE 720w"]},"source":"Foto: Peter Cox | The Damned, 1977","source_link":null},"is_fullscreen":false}}],"subtitle":"Door Meike Jentjens ","thumbnail_image":{"image":{"alt":"Archive1","src":"https://d12y285rxlbnxt.cloudfront.net/2022-09/Banner_0.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Banner_0.jpg?itok=yk02HlQr","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Banner_0.jpg?itok=72MTUJpg","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Banner_0.jpg?itok=3Z1uKthA","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Banner_0.jpg?itok=wO09vYuI","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Banner_0.jpg?itok=XaI-S4CT","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Banner_0.jpg?itok=XStr0gmV"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2022-09/Banner_0.jpg?itok=yk02HlQr 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2022-09/Banner_0.jpg?itok=72MTUJpg 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2022-09/Banner_0.jpg?itok=3Z1uKthA 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2022-09/Banner_0.jpg?itok=wO09vYuI 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2022-09/Banner_0.jpg?itok=XaI-S4CT 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2022-09/Banner_0.jpg?itok=XStr0gmV 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#262620","background_color":"#F3F3F0","text_color":"#000000"},"tags":[{"id":7,"title":"Effenaar50"},{"id":137,"title":"Historie"}],"related_events":[]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724600542,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"LongReads-van-punkhol-naar-professionele-popzaal-50-jaar-effenaar-nl","queryHash":"[\"LongReads-van-punkhol-naar-professionele-popzaal-50-jaar-effenaar-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":1467,"slug":"/agenda/wasven24aug","endpoint":"/nl/agenda/wasven24aug","translations":{"nl":"/agenda/wasven24aug","en":null},"title":"Effenaar 't Wasven met Mazis, Mama's Shakin' Beanbags en Timo de Jong \u0026 Leadbeaters","content":"\u003cp\u003eTraditiegetrouw vieren we ook dit jaar weer de zomer op 3 zonnige zondagen op het gezellige terrein van 't Wasven. De ingrediënten zijn simpel: breng je picknickkleedje en zonnebril mee, trommel je vrienden/familie op en kom genieten van zomerse livemuziek onder het genot van een hapje en drankje. De entree is zoals altijd helemaal gratis! \u003c/p\u003e\u003cp\u003eCelebeslaan 30\u003cbr\u003e5641 AG Eindhoven\u003cbr\u003e040-7870707\u003c/p\u003e","meta":{"title":"Effenaar 't Wasven met Mazis, Mama's Shakin' Beanbags en Timo de Jong \u0026 Leadbeaters","description":"","image":null},"publish_date":{"timestamp":1747217471,"machine":"2025-05-14T10:11:11+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"header wasven","src":"https://d12y285rxlbnxt.cloudfront.net/2025-05/Header%20afbeelding.jpeg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-05/Header%20afbeelding.jpeg?itok=E-pPNz3i","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-05/Header%20afbeelding.jpeg?itok=TDu2hqLl","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-05/Header%20afbeelding.jpeg?itok=z39WpAKh","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-05/Header%20afbeelding.jpeg?itok=BCqceVZR","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-05/Header%20afbeelding.jpeg?itok=b_V3wrUf","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-05/Header%20afbeelding.jpeg?itok=2e4r_swN"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-05/Header%20afbeel