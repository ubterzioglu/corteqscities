:null,"opens_at":null},"locations":[{"id":132,"title":"Meerdere locaties","is_external":false}],"facebook_event":{"uri":"https://www.facebook.com/events/763642988820189","title":"","options":{"url":"https://www.facebook.com/events/763642988820189"}},"genres":[{"id":48,"title":"indie"},{"id":125,"title":"Upcoming"},{"id":54,"title":"heavy"},{"id":12,"title":"dance"},{"id":121,"title":"Pop / Rock"}],"club_card_event":false,"ticket_url":null,"ticket_price":null,"state":null,"locker_reservation":false,"restaurant_reservation":false,"related_events":[]}]}},{"type":"cta","id":"bf685740-4554-456b-8312-91cb87b0e805","header":{"title":null,"description":null},"content":{"cta_title":null,"cta_description":null,"url":{"uri":"https://www.instagram.com/hitthecity.festival/","title":"Volg Hit The City op Instagram","options":{"url":"https://www.instagram.com/hitthecity.festival/"}},"description":null,"title":null}},{"type":"paragraph","id":"77e5a12e-1b87-449c-906a-3deae38b6b6f","header":{"title":"Effenaar x Friendly Fire"},"content":{"content":"\u003cp\u003eDutch Design Week (DDW) verwelkomt ieder jaar duizenden designers en bezoekers van over de hele wereld.\u0026nbsp;Net als voorgaande jaren trekken we levendigheid van DDW door naar de avond met een geheel gratis muziekfestival georganiseerd en geprogrammeerd door Effenaar en\u0026nbsp;Friendly Fire.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"71d70c4e-9737-40ec-96df-e729338e6881","header":{"title":"Bekijk de aftermovie van Hit The City 2022","description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/N94Jq5ajtx4\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724614333,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-hit-city-2023-zaterdag-nl","queryHash":"[\"AgendaDetail-hit-city-2023-zaterdag-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":608,"slug":"/agenda/party-nomansland-la-pegatina","endpoint":"/nl/agenda/party-nomansland-la-pegatina","translations":{"nl":"/agenda/party-nomansland-la-pegatina","en":null},"title":"Party in Nomansland: La Pegatina","content":"\u003cp\u003eLa Pegatina heeft zijn thuisbasis in het bruisende Barcelona. Ooit begonnen ze daar op straat, nu vullen ze er de grootste zalen en jagen de temperatuur op tot het kookpunt. Hun muziek is een mengeling van genres die ze in de stad om zich heen hoorden: rumba catalana, ska, punk, cumbia en música mestiza. Hun doel is om iedereen in beweging te krijgen binnen 3 seconden, met een smile van oor tot oor. Verwacht een sprankelende show vol power, energie en adrenaline! \u003c/p\u003e\r\n\r\n\u003cp\u003ePowered by ASML.\u003c/p\u003e\r\n","meta":{"title":"Party in Nomansland: La Pegatina","description":"La Pegatina heeft zijn thuisbasis in het bruisende Barcelona. Ooit begonnen ze daar op straat, nu vullen ze er de grootste zalen en jagen de temperatuur op tot het kookpunt. Hun muziek is een mengeling van genres die ze in de stad om zich heen hoorden: rumba catalana, ska, punk, cumbia en música mestiza. Hun doel is om iedereen in beweging te krijgen binnen 3 seconden, met een smile van oor tot oor. Verwacht een sprankelende show vol power, energie en adrenaline! \r\n\r\nPowered by ASML.","image":{"image":{"alt":"Party In Nomansland: La Pegatina","src":"https://d12y285rxlbnxt.cloudfront.net/2023-07/Party%20In%20Nomansland%20Header.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-07/Party%20In%20Nomansland%20Header.jpg?itok=WEq9YnWh","1920w":"https://d12y285rxlbnxt.cloudfront.ne