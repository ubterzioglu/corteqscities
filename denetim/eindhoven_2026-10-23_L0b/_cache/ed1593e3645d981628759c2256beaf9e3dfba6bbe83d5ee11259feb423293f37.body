yles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"8ae7ac07-b7db-4706-8ea0-4b2d4887e533","header":{"title":null},"content":{"content":"\u003cp\u003eBeige Banquet brengt je rammelende en dansbare post-punk met jaren 80 drummachines en synths dat ergens tussen DEVO, Thee Oh Sees of Crack Cloud in zit. Begin volgend jaar brengen ze hun eerste album ‘Ornamental Hermit’ uit als volledige band, en daarmee maken ze ook een stop in het Stroomhuis. En met een reputatie van meedogenloze, zweterige en intense liveshows is dat niet iets wat je wilt missen.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"73ab5d9f-bee4-4b0e-9618-b9fffd54deb5","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e18:30 uur: Deuren open\u003cbr /\u003e\r\n19:00 uur: Show Warm Exit\u003cbr /\u003e\r\n19:45 uur: Show Cucamaras\u003cbr /\u003e\r\n22:00 uur: Show Beige Banquet\u003cbr /\u003e\r\n(tijden zijn onder voorbehoud)\u003c/p\u003e\r\n\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"8de1ad54-ceab-4d3b-a39e-b54ecb569d91","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/TGhQlN1aWZs?si=AGptMAUib4b0BHRf\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"226ccb6a-4417-4fe2-8944-548a1c2ad2f3","header":{"title":"Cucamaras"},"content":{"content":"\u003cp\u003eNa het succes van hun eerste twee releases en een druk liveschema, is het indie/post-punkkwartet Cucamaras klaar om een stap verder te gaan met hun aankomende EP ‘Soft Soap’. De band, bestaande uit Josh Hart, Olly Bowley, Dan McGrath en Joe Newton, heeft een sterke interesse ontwikkeld vanuit de lokale scene in Nottingham, waar ze The Bodega uitverkochten in 2021. De nieuwste EP demonstreert de uitbreiding van de richting van de band en biedt een kijkje in hun toekomst. Tijdens afgelopen ESNS wisten ze Huize Maas tot de nok toe te vullen, het is nu tijd voor een bezoekje aan Stroomhuis op Tweede Paasdag!\u003c/p\u003e\r\n","image":{"image":{"alt":"cuca square","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/square%20cucamaras.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/square%20cucamaras.jpg?itok=YfbBhm_4","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/square%20cucamaras.jpg?itok=Cl4Cq2Xs","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/square%20cucamaras.jpg?itok=Lri5RaR5","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/square%20cucamaras.jpg?itok=jaEyd33H","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/square%20cucamaras.jpg?itok=flyfdECe","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/square%20cucamaras.jpg?itok=fb_hySBd"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/square%20cucamaras.jpg?itok=YfbBhm_4 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/square%20cucamaras.jpg?itok=Cl4Cq2Xs 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/square%20cucamaras.jpg?itok=Lri5RaR5 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/square%20cucamaras.jpg?itok=jaEyd33H 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/square%20cucamaras.jpg?itok=flyfdECe 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/square%20cucamaras.jpg?itok=fb_hySBd 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"64452fcd-0fec-437d-9d2f-178610935920","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/qi6NOKAHSGs?si=MHo7WLUCe3p5u5Sk\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"cecafaf2-a3b6-4327-9d2e-d5870f2485c9","header":{"title":"Support: Warm Exit"},"content":{"content":"\u003cp\u003eWarm Exit is een Belgisch postpunkkwartet dat zich met hun gewelddadige en explosieve geluid onderscheidt als een van de meest rauwe en opwindende acts van het moment. Met uiteenlopende invloeden uit krautrock, punk en noiserock wagen ze zich aan de geest van iconische bands als Wire, Rema Rema en PiL. Op hun debuutplaat Ultra Violence (2024) wordt er moeiteloos geschakeld tussen snelle en langzame tempo’s, hoge en lage energieniveau’s en gespannen gefluister of ongebreideld geschreeuw. Daarmee nemen ze de luisteraar mee door een landschap van onenigheid, suggestieve spoken word en industriële ondertonen. Live razen met ongekende intensiteit over het podium, dus deze support show wil je niet missen!\u003c/p\u003e\r\n","image":{"image":{"alt":"Warm Exit ","src":"https://d12y285rxlbnxt.cloudfront.net/2024-03/Warm%20Exit.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-03/Warm%20Exit.jpg?itok=-c1KITwq","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-03/Warm%20Exit.jpg?itok=I3CFxgCC","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-03/Warm%20Exit.jpg?itok=1M5mG-8x","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-03/Warm%20Exit.jpg?itok=NS6Q5zch","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-03/Warm%20Exit.jpg?itok=iKTo_O79","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-03/Warm%20Exit.jpg?itok=JpK4xJeE"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-03/Warm%20Exit.jpg?itok=-c1KITwq 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-03/Warm%20Exit.jpg?itok=I3CFxgCC 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-03/Warm%20Exit.jpg?itok=1M5mG-8x 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-03/Warm%20Exit.jpg?itok=NS6Q5zch 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-03/Warm%20Exit.jpg?itok=iKTo_O79 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-03/Warm%20Exit.jpg?itok=JpK4xJeE 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"9e365650-a3dc-48da-9f5f-4fa3cf686470","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/sNEeRPgtGb0?si=czBr7zgyIvqLTOI3\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724621007,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-beige-banquet-cucamaras-nl","queryHash":"[\"AgendaDetail-beige-banquet-cucamaras-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":866,"slug":"/agenda/thy-catafalque","endpoint":"/nl/agenda/thy-catafalque","translations":{"nl":"/agenda/thy-catafalque","en":null},"title":"Thy Catafalque","content":"\u003cp\u003eThy Catafalque komt voor hun eerste Nederlandse show ooit naar Effenaar! Deze Hongaarse avant-gardistische progmetalband is het project van meesterbrein en multi-instrumentalist Tamás Kátai.\u003c/p\u003e\r\n","meta":{"title":"Thy Catafalque","description":"","image":null},"publish_date":{"timestamp":1706608200,"machine":"2024-01-30T09:50:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Thy Catafalque header","src":"https://d12y285rxlbnxt.cloudfront.net/2024-01/%20%E2%80%93%201920x1080%20Website_2.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_2.jpg?itok=19UEXDcL","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_2.jpg?itok=BqHDnHCh","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_2.jpg?itok=XeISql9I","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_2.jpg?itok=NQAy6Fwb","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_2.jpg?itok=RLYTeizj","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_2.jpg?itok=7qUb5Fh2"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-01/%20%E2%80%93%201920x1080%20Website_2.jpg?itok=19UEXDcL 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-01/%20%E2%