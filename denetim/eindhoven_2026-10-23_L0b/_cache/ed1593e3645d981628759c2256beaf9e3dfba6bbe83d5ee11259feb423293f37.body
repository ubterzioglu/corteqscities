rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=IXLO9ado","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=waQNUMpd"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=Tdsk6aD7 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=nS29BMQd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=lt3ZfQCK 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=WSBGu7Vz 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=IXLO9ado 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyTPN.png?itok=waQNUMpd 720w"]},"source":null,"source_link":null},"locations":[{"id":126,"title":"Kleine Zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#000000","background_color":"#fc7356","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"fd2aa41b-5e3c-400a-9f37-934daa19d853","header":{"title":null},"content":{"content":"\u003cp\u003eJe jeugdherinneringen, je eerste liefde, de plek waar je bent opgegroeid, je dromen, je speelgoed. Maak je klaar voor een avond vol plezier en de grootste Turkse hits uit de jaren ’90 en 2000!\u003c/p\u003e\u003cp\u003eNeem je Nederlandse vrienden en familie mee en laat ons samen de melodieën delen van de dagen die ons hebben gevormd, toen en nu!\u003c/p\u003e\u003cp\u003e\u003cem\u003eLet op: Turkish Pop Night is 18+! Er kan aan de deur om ID worden gevraagd. Neem een identiteitsbewijs mee.\u003c/em\u003e\u003c/p\u003e","links":null}},{"type":"paragraph","id":"730460d7-6ce0-438a-9e2d-0bbeba1541a4","header":{"title":"Türkçesi"},"content":{"content":"\u003cp\u003eDJ Denden Eindhovena geri donuyor!\u0026nbsp;\u003c/p\u003e\u003cp\u003eDj Denden ile Türkçe Pop Gecesi 4 Nisan Cumartesi akşamı Effenaar Eindhoven sahnesinde!\u003c/p\u003e\u003cp\u003eSokaklarda kumdan baraj yapanlar, tetriste en uzun çubugu sona bırakanlar, soba üstünde kestane yiyenler ve top kek sevenler.. Çocukluk anılarınız, ilk aşkınız, büyüdüğünüz yer, hayalleriniz, oyuncaklarınız... 90'larin ve 2000'lerin en guzel muzikleriyle eglenceli bir geceye hazir olun.\u0026nbsp;\u003c/p\u003e\u003cp\u003eHollandali dostlarinizi, ailenizi de getirin hep birlikte dunu ve bugun bizi biz yapan gunlerimizin melodilerini paylasalim!\u003c/p\u003e\u003cp\u003e\u003cem\u003eDikkat: Turkish Pop Night 18 yaşından büyükler içindir! Kapıda kimlik sorulabilir.\u0026nbsp;\u003c/em\u003e\u003c/p\u003e","links":null}},{"type":"embed","id":"eb0b76dc-97a3-421e-9fca-3c7a8850e824","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/cpp69ghR1IM?si=nro7kF_fCVI7vkY4\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724611169,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-turkish-pop-night-4apr-nl","queryHash":"[\"AgendaDetail-turkish-pop-night-4apr-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"longread","nid":1189,"slug":"/artikelen/een-kijkje-achter-de-schermen-als-doof-persoon-ergens-naartoe-gaan-kost-nog-veel-extra","endpoint":"/nl/artikelen/een-kijkje-achter-de-schermen-als-doof-persoon-ergens-naartoe-gaan-kost-nog-veel-extra","translations":{"nl":"/artikelen/een-kijkje-achter-de-schermen-als-doof-persoon-ergens-naartoe-gaan-kost-nog-veel-extra","en":null},"title":"Een kijkje achter de schermen: 'Als doof persoon ergens naartoe gaan kost veel extra tijd en regelwerk'","content":"\u003cp\u003eVan 7 tot en met 12 oktober is het de Week van Toegankelijkheid. Een week die extra aandacht vraagt voor een toegankelijke en inclusieve samenleving. Hieronder valt het toegankelijk maken van een pand, faciliteiten en diensten, maar ook belevingen, zoals muziek en concerten. Iedereen moet onbezorgd van cultuur kunnen genieten. Hierin is echter nog een behoorlijke slag te slaan, vertellen bezoekers Egon van Hulst en Jessica de Waard – beiden muziekfanaat en op latere leeftijd slechthorend geworden. Samen met muziektolk Ruth Krooshof nemen ze je mee in het concertbezoek van dove en slechthorende mensen; wat gaat eraan vooraf, hoe bereidt een tolk zich voor en hoe kan livemuziek toegankelijker worden gemaakt. \u003c/p\u003e\r\n","meta":{"title":"Een kijkje achter de schermen: 'Als doof persoon ergens naartoe gaan kost veel extra tijd en regelwerk'","description":"Bezoekers Egon en Jessica, en muziektolk Ruth over de toegankelijkheid van concerten voor dove en slechthorende mensen. ","image":{"image":{"alt":"Muziektolk Alestorm","src":"https://d12y285rxlbnxt.cloudfront.net/2024-10/fbheader.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/fbheader.jpg?itok=MSe6X09-","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/fbheader.jpg?itok=CKNw6rRz","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/fbheader.jpg?itok=LUPwyutf","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/fbheader.jpg?itok=bXzg3b9e","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/fbheader.jpg?itok=DylcE0z6","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/fbheader.jpg?itok=szcYIfbj"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/fbheader.jpg?itok=MSe6X09- 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/fbheader.jpg?itok=CKNw6rRz 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/fbheader.jpg?itok=LUPwyutf 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/fbheader.jpg?itok=bXzg3b9e 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/fbheader.jpg?itok=DylcE0z6 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/fbheader.jpg?itok=szcYIfbj 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1728394839,"machine":"2024-10-08T13:40:39+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Muziektolk Alestorm","src":"https://d12y285rxlbnxt.cloudfront.net/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=uoBFFxv0","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=VWkoxt5H","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=ogbkieYz","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=sMe5XKz_","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=tlEAn9Wf","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=nr7nwUAe"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=uoBFFxv0 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=VWkoxt5H 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=ogbkieYz 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=sMe5XKz_ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=tlEAn9Wf 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-20.png?itok=nr7nwUAe 720w"]},"source":"Foto: Nadia Hagen | Muziektolk Cindy bij Alestorm","source_link":null},"breadcrumb":null,"blocks":[{"type":"paragraph","id":"cfa522bb-59cb-4899-9be8-054d4ff1ed7e","header":{"title":null},"content":{"content":"\u003cp\u003eHet lijkt steeds meer te gaan leven, de toegankelijkheid van muziek en concerten voor dove en slechthorende mensen. Het afgelopen festivalseizoen zag je onder andere bij de podia's van \u003ca href=\"https://www.concertatsea.nl/faq/zijn-er-muziektolken-op-het-festival/\" target=\"_blank\"\u003eConcert At Sea\u003c/a\u003e en \u003ca href=\"https://www.gld.nl/video/8180544/dankzij-muziektolken-geniet-iedereen-van-muziek-zwarte-cross?fbclid=IwY2xjawFvgrFleHRuA2FlbQIxMAABHQmsUtFmhx0KUTpaV5Z4TFbmiXHtwqJsXLE3drvx9ovW8N4fX4nh64m8dw_aem_BTYzEqEHhugpRQN9T1DHWA\" target=\"_blank\"\u003eZwarte Cross\u003c/a\u003e muziektolken om de shows te vertalen.\u0026nbsp;\"Voorheen was het zo dat het eigenlijk iedere keer een strijd was en dat een hele hoop mainstream evenementen niet toegankelijk waren. Gelukkig zit er sinds de erkenning van de Nederlandse gebarentaal [\u003ca href=\"https://zoek.officielebekendmakingen.nl/stb-2021-165.html\" target=\"_blank\"\u003ered. in 2021\u003c/a\u003e] wel verandering\", vertelt Jessica. Zelf is ze één van de initiatiefnemers van \u003ca href=\"https://www.facebook.com/Muziektolkhoorterbij/?locale=nl_NL\" target=\"_blank\"\u003eMuziektolkhoorterbij\u003c/a\u003e, waarmee ze sinds 2017 strijd voor betere toegankelijkheid voor dove en slechthorende mensen bij concerten en festivals.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"a0578f5d-286f-4453-a253-fb833c7bdec7","header":{"title":null},"content":{"content":"\u003cp\u003eMaar ondanks dat enkele grote evenementen zo nu en dan uit eigen beweging muziektolken inzetten, ligt het initiatief - en de kosten - veelal nog bij de bezoeker zelf. Hiervoor kunnen dove en slechthorende personen gebruik maken van een x aantal tolkuren dat wordt vergoed door de zorgverzekering.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"dde9a04c-4d52-4306-bc25-15765c9600d7","header":{"title":null},"content":{"content":"\u003cp\u003eAfgelopen juni was Egon, die in 2018 de diagnose plotsdoof kreeg, samen met twee muziektolken aanwezig bij de show van Chef'Special in Effenaar. \"Wanneer ik een concert tegenkom waar ik graag naartoe wil, neem ik contact op met het podium en artiest of management.\" Hieraan legt hij zijn verzoek om een muziektolk mee te nemen voor. \"Daar is nog veel winst te halen. Sommige locaties en managements willen niet eens meewerken.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"b8c206a5-6e25-4c4f-a5d9-1d587359c977","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Chef Special muziektolk","src":"https://d12y285rxlbnxt.cloudfront.net/2024-10/Chef%27Special-2.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/Chef%27Special-2.png?itok=R3KtgHrw","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/Chef%27Special-2.png?itok=itFUTWfw","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/Chef%27Special-2.png?itok=7L_Ls6fa","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/Chef%27Special-2.png?itok=sdEEXym-","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/Chef%27Special-2.png?itok=tJbIrn4Y","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/Chef%27Special-2.png?itok=NlDtSpbr"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/Chef%27Special-2.png?itok=R3KtgHrw 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/Chef%27Special-2.png?itok=itFUTWfw 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/Chef%27Special-2.png?itok=7L_Ls6fa 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/Chef%27Special-2.png?itok=sdEEXym- 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/Chef%27Special-2.png?itok=tJbIrn4Y 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/Chef%27Special-2.png?itok=NlDtSpbr 720w"]},"source":"Foto: Nonja de Roo | Chef'Special","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"2a8aa28d-f1b1-4301-bcd4-ecf2ebc0ed87","header":{"title":null},"content":{"content":"\u003cp\u003eWanneer er wel een akkoord volgt, vraagt hij de setlist op en gaat hij ondertussen op zoek naar een geschikte muziektolk. \"Meestal benader ik ze persoonlijk. Ik heb een app met een groep diverse muziektolken. Ik ben altijd horend geweest. Dus ik weet wat muziek teweeg kan brengen buiten de tekst. Ik vind het heel belangrijk dat dit aspect goed wordt overgebracht.\" Zelf houdt hij vooral van singer-songwriters of ballads. \"De emotie komt er heel mooi in naar voren en de muziek gaat dan niet heel snel. Wat langzamer is ook beter te volgen omdat de tolken de gebaren dan mooi kunnen afmaken.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"01e0c26c-b2b8-497f-9c48-17ef53120a7a","header":{"title":"Meer dan tekst"},"content":{"content":"\u003cp\u003eIn Nederland is er een select aantal tolken die daadwerkelijk de specialisatie hebben om muziek te vertalen. Want er komt veel meer bij kijken dan alleen 'droog de tekst vertalen'. \"Er zit emotie in de muziek, er zitten instrumenten in en heel veel dynamiek. En iedere muziekstijl klinkt anders, en ziet er ook anders uit. Dus het is echt een heel apart specialisme\", legt Jessica uit.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"98519cb7-1dbc-46cd-8c0c-ec943733a7be","header":{"title":null},"content":{"content":"\u003cp\u003e\"Ik stem ook vaak even af met de klant\", vult muziektolk Ruth aan, die afgelopen jaar samen met Jessica aanwezig was bij het piratenfestijn van de Schotse metalband Alestorm in Effenaar. \"Jessica was eerder horend, dus voor haar is het belangrijk dat ze mee kan zingen met de muziek. Ze wil graag letterlijk vertaald zien wat er te horen valt. Dus het is niet zo dat ik een gitaar ga uitbeelden. Dat zegt namelijk niets over wat voor gitaar en wat voor melodielijn het is.\"\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"aaf70e9b-de2d-4f24-a230-532e9a2fffb3","header":{"title":null},"content":{"content":"\u003cp\u003eNaast gebaren gebruikt de muziektolk haar hele lichaam om de sfeer en emotie van de muziek te vangen en over te brengen. \"Bij mij zit de melodielijn in mijn bovenlijf en het ritme in mijn onderlijf. Zo houd ik de vertaling duidelijk, want als je te veel gaat bewegen dan vallen je handen weg.\" En het laatste belangrijke component is mimiek. Hiermee geeft Ruth bijvoorbeeld aan of er een scherp of zelfs vals geluid te horen is. \"Ook dat geef je allemaal mee tijdens de vertaling.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"739ffb59-282a-46d6-adf2-841ecd4e266d","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Tolk Alestorm","src":"https://d12y285rxlbnxt.cloudfront.net/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=lj1dxvT5","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=ZcEapygQ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=gj30KcQe","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=24VKqOTx","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=3cHe3ihc","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=eZ98wyul"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=lj1dxvT5 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=ZcEapygQ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=gj30KcQe 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=24VKqOTx 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=3cHe3ihc 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-6.png?itok=eZ98wyul 720w"]},"source":"Foto: Nadia Hagen | Muziektolk Ruth bij Alestorm","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"25778f2d-4bac-46e7-9a07-03edbfa37910","header":{"title":"Het kunnen dromen van nummers"},"content":{"content":"\u003cp\u003eOm de muziek en show goed te vangen is een goede voorbereiding nodig. Zodra de setlist in handen is, begint het werk voor de muziektolk. \"Op basis van de setlist verdelen we de nummers. Vaak ben je met twee of drie tolken, omdat het voor één tolk gewoon te zwaar is. Je leert dan de teksten uit je hoofd en luistert de liedjes heel vaak, zodat je deze helemaal in je systeem krijgt en uiteindelijk kan performen.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"b1f66a04-8e85-4f11-b864-3502cef176f8","header":{"title":null},"content":{"content":"\u003cp\u003eHet grijsdraaien van de nummers doet Ruth soms niet alleen om zich goed voor te bereiden, zo nu en dan vindt ze via haar werk ook nieuwe favorieten. \"Toevallig sleept Jessica mij wel vaker mee naar bands waar ik dan van tevoren nog nooit van gehoord heb. Die vervolgens wel echt in mijn favorietenlijst erbij gaan. Daar heeft ze wel een talentje voor. Alestorm kende ik al, omdat ze me vorig jaar mee had genomen naar een groot rockfestival waar zij speelden en daar hebben we echt een feestje gemaakt. Toen ze zei dat ze naar Effenaar kwamen, heb ik direct gezegd: 'mag ik alsjeblieft mee, want het is echt heel leuk'.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"1c5a6d18-f7f7-4d5f-8ead-b37a616607cb","header":{"title":null},"content":{"content":"\u003cp\u003eDe voorbereiding van de tolk kost tijd, en daarvoor geldt: hoe eerder, hoe beter. Jessica: \"Hoe eerder we weten wat de programmering is, hoe beter natuurlijk. Dan heb je meer tijd om alles te regelen en om alles af te stemmen. Zo\u0026nbsp;hebben de mensen die de muziek vertalen ook meer tijd en ruimte om alle muziek goed te leren en dat stuk voor te bereiden.\"\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"444abdd2-9a5b-44fb-8b98-9399c2e7634a","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Muziektolk Alestorm","src":"https://d12y285rxlbnxt.cloudfront.net/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=r1OOJf8g","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=4NiwHm8e","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=R0ifq0Aj","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=9VRlN_kS","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=AzCCJC6H","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=dfyeQlDL"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=r1OOJf8g 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=4NiwHm8e 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=R0ifq0Aj 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=9VRlN_kS 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=AzCCJC6H 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-5.png?itok=dfyeQlDL 720w"]},"source":"Foto: Nadia Hagen | Muziektolk Ruth op het podium bij Alestorm","source_link":null},"is_fullscreen":true}},{"type":"paragraph","id":"87c1f816-282c-40eb-a0bc-5db99479b22f","header":{"title":"Geen tenniswedstrijd "},"content":{"content":"\u003cp\u003eNaast het bestuderen van de muziek moet ook de productie worden geregeld. Muziektolk Ruth neemt hiervoor voorafgaand aan het concert contact op met de locatie. \"Ik leg dan uit dat we het prettig vinden om op een bepaalde plek te staan, waar de dove gasten ons goed kunnen zien en ook kunnen kijken naar wat er op het podium gebeurt. Het moet niet zo zijn dat je een soort tenniswedstrijd aan het spelen bent, en je of kan volgen wat de tolk gebaart, of kan zien wat er op het podium gebeurt.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"9ca926b7-a047-428b-9150-3a7fca49300c","header":{"title":null},"content":{"content":"\u003cp\u003eOndanks de uitleg, komt het toch voor dat ze bij aankomst bij een locatie wordt geconfronteerd met een plek die haar werk lastig maakt. \"Dan zeggen ze; 'ja we hebben een mooie plek geregeld, daar!'. Terwijl dan aan de andere kant alles gebeurt. Dan is het soms wel echt lastig om toch op een goede manier een show te kunnen faciliteren. Vaak weten mensen ook niet wat we komen doen, ook al hebben we het benoemd en video's meegestuurd.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"dfa9ea18-ad8f-4aaa-883b-4a6db01d1376","header":{"title":null},"content":{"content":"\u003cp\u003eWat de meest ideale plek zou zijn voor een muziektolk? \"Gewoon naast de band op het podium\", antwoordt Jessica. \"Dan is het één geheel, en is de visuele muziek eigenlijk een onderdeel van de hele performance. Dat is het mooiste en wat we het liefste zien. Maar soms gebeurt er zoveel op een podium – denk aan confettikanonnen – daar moet ook rekening mee worden gehouden. Dus het is niet altijd even makkelijk om dat af te stemmen.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"66faa452-f804-402e-8010-3b99e3c2118f","header":{"title":"Meer licht op de muziektolk "},"content":{"content":"\u003cp\u003eMaar ongeacht waar een muziektolk ook staat, één aspect in zichtbaarheid is eigenlijk zo makkelijk te behalen, maar wordt toch zo vaak over het hoofd gezien. \"Het is het element wat eigenlijk ó zó logisch voelt als je het bespreekbaar maakt; het stukje belichting\", zegt Jessica. \"Op het moment dat er super veel lichteffecten zijn, dan zie je heel moeilijk wat er wordt gebaard. Of als er vanuit sfeer is gekozen voor een donkere set, dan mis je een stukje belichting en kan je de tolk niet goed zien. Dan mis je één simpele spot op de muziektolk. Het liefste heb je dat de tolk gedurende de show op dezelfde manier is uitgelicht, zodat deze zonder afleiding zichtbaar is en de hele tijd in dezelfde lichtsterkte staat.\"\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"70f22b0b-bbc9-4bb3-9f98-d740fc9b0636","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"muziektolk alestorm","src":"https://d12y285rxlbnxt.cloudfront.net/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=kb4Tffvx","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=rEQP4rE3","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=aCiHy7tt","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=geWun-U-","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=ZN_YD0bO","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=hUvjaejm"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=kb4Tffvx 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=rEQP4rE3 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=aCiHy7tt 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=geWun-U- 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=ZN_YD0bO 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-10/20231203%20Alestorm%20-%20Nadia%20Hagen-24.png?itok=hUvjaejm 720w"]},"source":"Foto: Nadia Hagen | Muziektolk Cindy bij Alestorm","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"151bb949-614e-431c-b1f5-4c266e2c9e15","header":{"title":null},"content":{"content":"\u003cp\u003eZowel Egon als Jessica oppert dat locaties kunnen beginnen met het opstellen van een standaard protocol, waarmee deze productionele kwesties kunnen worden opgevangen. Zoals het aanwijzen van een standaard tolkplek met spot, zodat iedereen binnen de organisatie weet wat er moet worden geregeld wanneer er een muziektolk aanwezig is.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"e0170e72-4ab3-4ff7-bb25-89ea9b30c85b","header":{"title":null},"content":{"content":"\u003cp\u003eMuziektolk Ruth vult aan: \"Dan kan de locatie ook makkelijker handelen naar de organisatie van de band en zeggen: 'We hebben een aanvraag gekregen voor een tolk, dat betekent dat we verwachten dat er een setlist ligt en dat er een tolk op het podium zal staan in dit witte vierkantje.' Dan kunnen ze daar rekening mee houden met de opbouw. Nu gebeurt het veel te vaak dat ik van tevoren afspraken maak met iemand binnen een organisatie, maar dat de stagemanager niet precies weet wat de bedoeling is. Dan moeten ze weer allerlei dingen gaan verbouwen en schuiven. Terwijl het met een vaste spot, dat witte vierkantje,\u0026nbsp;voor iedereen duidelijk is waar de tolk komt te staan.\"\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"3318f4a1-df5d-432d-9290-6d5afaf6fbe3","header":{"title":"Zorgeloos genieten "},"content":{"content":"\u003cp\u003eEen verbeterd proces en protocol zou de eerste stap zijn, maar om onbezorgd te kunnen genieten zoals de rest van de bezoekers moet uiteindelijk het initiatief gaan verschuiven. \"Ik denk dat de grootste stap in toegankelijkheid die we kunnen maken, vanaf het punt waar we nu staan, het stukje zorgeloosheid voor de bezoekers is. Dat ik me als dove bezoeker niet anders voel dan de rest van de bezoekers\", stelt Jessica. \"De meest ideale situatie is natuurlijk dat een locatie of venue, of artiest zelf zorgt voor de toegankelijkheid. Wil je nu ergens naartoe gaan als doof persoon, dan kost dat veel extra tijd, energie en regelwerk. Je hebt dat stukje zorgeloosheid niet. In vergelijking met hoe ik het mij weet te herinneren als horende. Je koopt een ticket, en denkt verder nergens over na.\"\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"25be746e-8ec2-4ba5-8012-542f22d3e243","header":{"title":null},"content":{"content":"\u003cp\u003eHoe dit er volgens haar in praktijk het beste uit kan zien? \"Dat je bijvoorbeeld bij ticketverkoop alleen een vinkje kan aanklikken en dat vervolgens alles door de locatie achter de schermen wordt geregeld. Dat is vergelijkbaar met hoe je nu bijvoorbeeld een ticket voor een rolstoelpodium aanvraagt. Dat zou mijn droom zijn dat dit overal zo is.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"0544d587-e39d-4eb9-ab89-95baba14d001","header":{"title":null},"content":{"content":"\u003ch4\u003eEffenaar werkt aan een toegankelijker poppodium en programma voor iedereen. Heb jij aandachtspunten voor ons of wil jij hierover meedenken? Dan horen we graag van je! Je kan contact met ons opnemen via \u003ca href=\"mailto:toegankelijkheid@effenaar.nl\"\u003etoegankelijkheid@effenaar.nl\u003c/a\u003e.\u003c/h4\u003e\r\n","links":null}},{"type":"related_longr_story","id":"8d97976c-0d35-456e-9320-3080db8b46b7","header":{"title":"Meer lezen:","description":null},"content":{"items":[{"type":"longread","nid":1063,"slug":"/artikelen/een-kijkje-achter-de-schermen-hoe-krijgen-we-nu-echt-meer-diversiteit-line-ups","endpoint":"/nl/artikelen/een-kijkje-achter-de-schermen-hoe-krijgen-we-nu-echt-meer-diversiteit-line-ups","translations":{"nl":"/artikelen/een-kijkje-achter-de-schermen-hoe-krijgen-we-nu-echt-meer-diversiteit-line-ups","en":null},"title":"Een kijkje achter de schermen: Hoe krijgen we nu echt meer diversiteit in line-ups?","content":"\u003cp\u003eDe prognoses zien er goed uit: we stevenen steeds meer af op gelijkwaardig verdeelde line-ups in Nederland, volgens Nederlandse muziekmedia. Je leest dat ‘vrouwen in opmars zijn’ en er ‘steeds meer vrouwen op podia van grote muziekfestivals’ staan. Lowlands boekte vorig jaar meer vrouwelijke headliners dan ooit. Dichterbij huis kan Hit The City dit jaar op een vrouwelijke headliner rekenen. We zijn er echter nog niet, want de statistieken laten zien dat mannen toch nog veel meer geboekt worden - zeker als headliner. Hoe werkt zoiets eigenlijk? En waar ligt het nou allemaal aan dat we tot nu toe vooral mannen op het podium zien? Friendly Fire-boeker Pien Feith en onderzoeker Lisa Gritter geven je een kijkje achter de schermen van de muziekindustrie.\u003cstrong\u003e \u003c/strong\u003e\u003c/p\u003e\r\n","meta":{"title":"Hoe krijgen we nu echt meer diversiteit op line-ups?","description":"Een kijkje achter de schermen met Friendly Fire-boeker Pien Feith en onderzoeker Lisa Gritter.","image":null},"publish_date":{"timestamp":1718182591,"machine":"2024-06-12T08:56:31+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Sophie straat","src":"https://d12y285rxlbnxt.cloudfront.net/2024-06/Sophie%20Straat.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-06/Sophie%20Straat.png?itok=ANS7ohwH","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-06/Sophie%20Straat.png?itok=-_NtiQCw","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-06/Sophie%20Straat.png?itok=FTJQ1kMz","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-06/Sophie%20Straat.png?itok=uJcPX2-W","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-06/Sophie%20Straat.png?itok=iC0Pi6EA","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-06/Sophie%20Straat.png?itok=3FiJPO9Z"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-06/Sophie%20Straat.png?itok=ANS7ohwH 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-06/Sophie%20Straat.png?itok=-_NtiQCw 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-06/Sophie%20Straat.png?itok=FTJQ1kMz 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-06/Sophie%20Straat.png?itok=uJcPX2-W 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-06/Sophie%20Straat.png?itok=iC0Pi6EA 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-06/Sophie%20Straat.png?itok=3FiJPO9Z 720w"]},"source":"Foto: Willem Wouterse | Sophie Straat in Effenaar","source_link":null},"breadcrumb":null,"subtitle":"Door Meike Jentjens","thumbnail_image":{"image":{"alt":"Sophie straat","src":"https://d12y285rxlbnxt.cloudfront.net/2024-06/Sophie%20Straat.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-06/Sophie%20Straat.png?itok=ANS7ohwH","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-06/Sophie%20Straat.png?itok=-_NtiQCw","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-06/Sophie%20Straat.png?itok=FTJQ1kMz","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-06/Sophie%20Straat.png?itok=uJcPX2-W","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-06/Sophie%20Straat.png?itok=iC0Pi6EA","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-06/Sophie%20Straat.png?itok=3FiJPO9Z"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-06/Sophie%20Straat.png?itok=ANS7ohwH 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-06/Sophie%20Straat.png?itok=-_NtiQCw 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-06/Sophie%20Straat.png?itok=FTJQ1kMz 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-06/Sophie%20Straat.png?itok=uJcPX2-W 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-06/Sophie%20Straat.png?itok=iC0Pi6EA 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-06/Sophie%20Straat.png?itok=3FiJPO9Z 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F2594B","background_color":"#F2DDD0","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":428,"slug":"/artikelen/huisfotograaf-paul-verhagen-mijn-kleurenblindheid-voor-mij-een-non-issue","endpoint":"/nl/artikelen/huisfotograaf-paul-verhagen-mijn-kleurenblindheid-voor-mij-een-non-issue","translations":{"nl":"/artikelen/huisfotograaf-paul-verhagen-mijn-kleurenblindheid-voor-mij-een-non-issue","en":null},"title":"Het unieke perspectief van een concertfotograaf met kleurenblindheid","content":"\u003cp\u003eDe toffe platen van huisfotograaf Paul Verhagen heb je ongetwijfeld weleens voorbij zien komen. Jaar na jaar schiet hij vette en krachtige foto's van acts die Effenaar komen platspelen. Inmiddels is hij al meer dan twaalf jaar onderdeel van de enthousiaste club huisfotografen, en nog altijd met evenveel passie.\u003c/p\u003e\r\n","meta":{"title":"Het unieke perspectief van een concertfotograaf met kleurenblindheid","description":"Lees hier het hele interview met huisfotograaf Paul Verhagen.","image":null},"publish_date":{"timestamp":1677746870,"machine":"2023-03-02T08:47:50+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Paul Verhagen","src":"https://d12y285rxlbnxt.cloudfront.net/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=MuH13ZES","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=nWws2LUH","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=nAY3igSh","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=8-a_jbqa","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/