"type":"cta","id":"04cfab1f-8400-40f5-b873-e1861f777396","header":{"title":null,"description":null},"content":{"cta_title":"Alvast een locker reserveren?","cta_description":null,"url":{"uri":"https://effenaar.elockers.shop/effenaar/lockers","title":"Dat doe je via deze link!","options":{"url":"https://effenaar.elockers.shop/effenaar/lockers"}},"description":null,"title":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724612247,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-party-nomansland-yin-yin-kumbia-boruka-nl","queryHash":"[\"AgendaDetail-party-nomansland-yin-yin-kumbia-boruka-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":565,"slug":"/agenda/hit-city-2023-opening-sticks-sor","endpoint":"/nl/agenda/hit-city-2023-opening-sticks-sor","translations":{"nl":"/agenda/hit-city-2023-opening-sticks-sor","en":null},"title":"Hit The City 2023 Opening: Sticks \u0026 Sor","content":"\u003cp\u003eHit The City is terug op 19-21 oktober! Net als voorgaande jaren trekken we de levendigheid van Dutch Design Week door naar de avond met een geheel gratis muziekfestival georganiseerd en geprogrammeerd door Effenaar en Friendly Fire.\u003c/p\u003e\r\n\r\n\u003cp\u003eOntdek drie dagen lang de nieuwste en meest veelbelovende acts, grensverleggende muziek en een diversiteit aan genres op meer dan tien bruisende locaties in Eindhoven.\u003c/p\u003e\r\n","meta":{"title":"Hit The City 2023 Opening: Sticks \u0026 Sor","description":"","image":null},"publish_date":{"timestamp":1686578400,"machine":"2023-06-12T14:00:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"sticks sor","src":"https://d12y285rxlbnxt.cloudfront.net/2023-09/Naamloos-1.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-09/Naamloos-1.png?itok=ZadaMYI8","1920w":"h