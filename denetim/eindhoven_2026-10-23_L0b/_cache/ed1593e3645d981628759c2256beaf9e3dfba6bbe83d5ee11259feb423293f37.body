es/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"520efdf8-9b3c-4f33-a035-d8d0f3d9ae16","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:30 Deuren open\u003cbr /\u003e\r\n20:15-20:45 Rikas\u003cbr /\u003e\r\n21:15 The Vices\u003cbr /\u003e\r\n(tijden zijn onder voorbehoud)\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"65b3b530-b78c-4db4-b099-56896047005d","header":{"title":null},"content":{"content":"\u003cp\u003eGiet wat britpop, surfrock en invloeden van The Strokes en Cage The Elephant in een blender èt voila: je hebt de sound van The Vices. Terecht wordt de Groningse band vergeleken met grote namen, maar hun kracht schuilt bovenal in de kunst van het trouw blijven aan zichzelf. Met kinderlijk plezier en tomeloze ambitie weten ze keer op keer de zaal in vuur en vlam te zetten.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"ab969d59-cca5-4004-8ced-19573893a5c7","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/9R3inXW_odc?si=DMaqMCvHdxPSnRCa\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"486f138e-20b2-4fd6-8c8e-a09001970612","header":{"title":"Support: Rikas"},"content":{"content":"\u003cp\u003eDeze vierkoppige indie-band maakt indruk met een vrolijke sound gecombineerd met Beach Boys achtige harmonieën. Tijdens het luisteren waan je je dan ook zo op een Californisch strand met een surfboard aan je zij en een koud biertje in je hand. Eerder verzorgden ze het voorprogramma van o.a. alt-J en Milky Chance, waarmee ze al een aardige reputatie op hebben weten te bouwen. Het tweede album 'Soundtrack For A Movie That Has Not Been Written Yet' (uitstekende naam, als je het ons vraagt) wordt verwacht op 8 februari 2025.\u003c/p\u003e\r\n","image":{"image":{"alt":"rikas","src":"https://d12y285rxlbnxt.cloudfront.net/2025-01/rikas.jpeg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-01/rikas.jpeg?itok=O-JPRfOo","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-01/rikas.jpeg?itok=73Yhyo_X","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-01/rikas.jpeg?itok=nJekE1Bt","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-01/rikas.jpeg?itok=jQwGhdRQ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-01/rikas.jpeg?itok=ilGGRipH","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-01/rikas.jpeg?itok=nH0CQGK5"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-01/rikas.jpeg?itok=O-JPRfOo 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-01/rikas.jpeg?itok=73Yhyo_X 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-01/rikas.jpeg?itok=nJekE1Bt 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-01/rikas.jpeg?itok=jQwGhdRQ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-01/rikas.jpeg?itok=ilGGRipH 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-01/rikas.jpeg?itok=nH0CQGK5 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"embed","id":"c16e6b8a-bc6f-4631-94ae-73abdcb79c6e","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/o4TJLljKO7U?si=IzN6epYzkBgbaose\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724596304,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-vices-8mrt-nl","queryHash":"[\"AgendaDetail-vices-8mrt-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"longread","nid":517,"slug":"/artikelen/hier-scoor-je-de-vetste-platen-eindhoven","endpoint":"/nl/artikelen/hier-scoor-je-de-vetste-platen-eindhoven","translations":{"nl":"/artikelen/hier-scoor-je-de-vetste-platen-eindhoven","en":null},"title":"Hier scoor je de vetste platen in Eindhoven","content":"\u003cp\u003eAls vinyl- en muziekliefhebber kom je in Eindhoven gelukkig niets tekort. In maar liefst zeven platenzaken en één bijzondere ontmoetingsplek kan je iedere week oneindig schatzoeken tussen de vetste vinyl albums en mooiste CD’s. Benieuwd naar waar je als muziekfanaat terecht kan? We zetten de beste plekjes in Eindhoven voor je op een rijtje.\u003c/p\u003e","meta":{"title":"Hier scoor je de vetste platen in Eindhoven","description":"Ken jij de nieuwe platenzaak Ruishuis al?","image":{"image":{"alt":"Platenkast meta data","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230414-DSC_3414.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3414.jpg?itok=s_kKv5ND","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3414.jpg?itok=6AJs7Fwr","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3414.jpg?itok=TYPrd2KX","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3414.jpg?itok=MSBnosKI","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3414.jpg?itok=y81ZO9gx","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3414.jpg?itok=NDFq55Ut"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3414.jpg?itok=s_kKv5ND 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3414.jpg?itok=6AJs7Fwr 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3414.jpg?itok=TYPrd2KX 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3414.jpg?itok=MSBnosKI 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3414.jpg?itok=y81ZO9gx 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3414.jpg?itok=NDFq55Ut 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1713341401,"machine":"2024-04-17T08:10:01+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Thumb Ray elpee","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230414-DSC_3414.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3414.png?itok=TGx5Cocd","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3414.png?itok=pP_B8iVZ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3414.png?itok=hTkIv8ct","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3414.png?itok=b2UMU9WM","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3414.png?itok=VcH_CYFQ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3414.png?itok=aomNYD4K"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3414.png?itok=TGx5Cocd 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3414.png?itok=pP_B8iVZ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3414.png?itok=hTkIv8ct 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3414.png?itok=b2UMU9WM 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3414.png?itok=VcH_CYFQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3414.png?itok=aomNYD4K 720w"]},"source":"Foto: Roeline Machiels | Ray Elpee","source_link":null},"breadcrumb":null,"blocks":[{"type":"featured_paragraph","id":"5e2c8103-08c3-4031-88fb-46fbecc3428d","header":{"title":"Memory Music "},"content":{"content":"\u003cp\u003eWe trappen het overzicht af met één van de oudste platenzaken in Eindhoven. “We hebben echt alles overleefd”, lacht eigenaar Frans van Bakel, die in 1989 de zaak Memory Music startte vanuit pure liefhebberij. Voor de opening was hij al actief als platenhandelaar op de Eindhovense markt en verschillende beurzen, maar dat smaakte naar meer. Memory Music opende haar deuren ooit aan de Kleine Berg, maar inmiddels zit de ondernemer alweer zo'n tien jaar in zijn pand aan de Gestelsestraat.\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"Memory Music","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/Nini_MemoryMusic.gif","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/Nini_MemoryMusic.gif?itok=RxxdldpN","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/Nini_MemoryMusic.gif?itok=FciPCnl1","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/Nini_MemoryMusic.gif?itok=Lq83u6J6","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/Nini_MemoryMusic.gif?itok=UjFqvwqs","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/Nini_MemoryMusic.gif?itok=CQ0mqQJ6","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/Nini_MemoryMusic.gif?itok=ChdV-DHa"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/Nini_MemoryMusic.gif?itok=RxxdldpN 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/Nini_MemoryMusic.gif?itok=FciPCnl1 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/Nini_MemoryMusic.gif?itok=Lq83u6J6 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/Nini_MemoryMusic.gif?itok=UjFqvwqs 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/Nini_MemoryMusic.gif?itok=CQ0mqQJ6 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/Nini_MemoryMusic.gif?itok=ChdV-DHa 720w"]},"source":"Foto: Roeline Machiels | verzamelaar in Memory Music","source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"8e9dfd0d-953b-441c-9d93-b51c6f50dc6e","header":{"title":null},"content":{"content":"\u003cp\u003eDe winkel bestaat voor ongeveer 90% uit tweedehandse CD's en platen, en die staan er rijen dik. \"Tweedehands heeft toch iets meer dan nieuw verkopen, er zit altijd een geschiedenis achter. Het mooie is dat collecties van liefhebbers die hier eerder iets kochten, soms ook weer terugkomen en een nieuw huisje vinden. Het is ook wel een beetje gezonde recycling. Voor mij hoeft het ook niet zo snel verkocht te worden. Tweedehands is toch meer om te snuffelen.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_quote","id":"424b4027-cded-4cc8-9ea4-14d06e9c22c4","header":{"title":null,"description":null},"content":{"quote":"Soms komt er iemand die wel iets nieuws zoekt. Dat is niet erg, die verwijs ik dan door naar de collega's. Liever bij de collega’s dan via het internet.","author":"Memory Music-eigenaar Frans van Bakel"}},{"type":"paragraph","id":"ddc45cd3-0749-4563-b317-e380811e11a1","header":{"title":null},"content":{"content":"\u003cp\u003eDe eigenaar merkt wel een interessant verschil met vroeger, waardoor de nostalgische sfeer naar zijn mening soms wat verdwijnt. \"Vroeger kwamen mensen langs om rond te kijken en draaide je nog wat plaatjes voor klanten, zodat ze konden horen hoe iets klinkt. Tegenwoordig luisteren velen de muziek even op hun telefoon. Mensen komen nu meer doelbewust kopen, waardoor ik nog amper plaatjes hoef op te zetten.\" \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"989aa8cf-e830-409c-95b8-bdbdd0b63e7e","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"Memory Music","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230415-DSC_3625-3.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230415-DSC_3625-3.png?itok=NLOLF8L8","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230415-DSC_3625-3.png?itok=Hw9nW-Pj","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230415-DSC_3625-3.png?itok=RLRjxhDQ","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230415-DSC_3625-3.png?itok=HYRqxZvR","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230415-DSC_3625-3.png?itok=0rgDcw3O","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230415-DSC_3625-3.png?itok=UU9Izfly"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230415-DSC_3625-3.png?itok=NLOLF8L8 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230415-DSC_3625-3.png?itok=Hw9nW-Pj 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230415-DSC_3625-3.png?itok=RLRjxhDQ 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230415-DSC_3625-3.png?itok=HYRqxZvR 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230415-DSC_3625-3.png?itok=0rgDcw3O 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230415-DSC_3625-3.png?itok=UU9Izfly 720w"]},"source":"Foto: Roeline Machiels | Memory Music","source_link":null},{"image":{"alt":"Memory Music","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230415-DSC_3643.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230415-DSC_3643.png?itok=iHzUEVPG","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230415-DSC_3643.png?itok=OQ4neiSC","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230415-DSC_3643.png?itok=MUEjsMAg","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230415-DSC_3643.png?itok=X4HeMO7a","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230415-DSC_3643.png?itok=sjBSpE0p","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230415-DSC_3643.png?itok=VLYR2RBr"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230415-DSC_3643.png?itok=iHzUEVPG 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230415-DSC_3643.png?itok=OQ4neiSC 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230415-DSC_3643.png?itok=MUEjsMAg 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230415-DSC_3643.png?itok=X4HeMO7a 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230415-DSC_3643.png?itok=sjBSpE0p 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230415-DSC_3643.png?itok=VLYR2RBr 720w"]},"source":"Foto: Roeline Machiels | Memory Music","source_link":null}]}},{"type":"paragraph","id":"ba0a43d3-d0c7-4b1d-a3bc-9cc65561646b","header":{"title":null},"content":{"content":"\u003cp\u003eMaar deze verandering drukt de pret niet voor Van Bakel. Al jaren werkt hij met plezier in zijn platenzaak en geniet hij van ieder aspect; van het schoonmaken en op alfabet zetten van platen, tot het fijne contact met klanten dat hij over de jaren heeft opgebouwd. \"Iedere week komt er een jongen met een verstandelijke beperking samen met zijn broer twee Nederlandstalige CD's uitzoeken. Dat vind ik heel mooi. Er is steeds minder te vinden van Nederlandstalig, maar ik heb het nog wel en blijf het nu ook zeker neerzetten.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"f9ae1c0e-6846-41fe-934f-f02f315bb74c","header":{"title":null},"content":{"content":"\u003cp\u003eWie zijn eigen favorieten artiesten zijn? Bee Gees en The Carpenters draait de muziekliefhebber zelf toch wel het liefste. \"Misschien een beetje oubollig, maar de winkel heet dan ook niet voor niets Memory Music.\" Ofwel, voor een goede dosis oldies en kennis daarover zit je hier goed.\u003c/p\u003e\r\n","links":null}},{"type":"featured_paragraph","id":"9917c971-6280-4dd3-b7c4-c6b0a850c4aa","header":{"title":"CD Teek"},"content":{"content":"\u003cp\u003eEen andere zaak die niet meer is weg te denken uit het centrum, is CD Teek.\u0026nbsp;De winkel van Ronnie Blommendaal opende in 1989 als een CD-verhuur, maar na 15 jaar maakte hij\u0026nbsp;de volledige overstap naar het verkopen van nieuwe en tweedehandse LP's en CD's. \"Ik heb er vaak over nagedacht om de zaak anders te noemen, maar iedereen kent dit al.\"\u0026nbsp;Al zo'n 28 jaar vind je CD Teek op een hoekje van\u0026nbsp;de Kleine Berg. Over de jaren heeft de eigenaar mensen geboren zien worden die inmiddels zelf weer klant zijn. \"Maar het wordt nooit saai. Muziek verandert altijd en we hebben een heel leuk publiek. Voor sommigen hebben we zelfs een beetje een huiskamerfunctie.\"\u003c/p\u003e\r\n","image":{"image":{"alt":"CD Teek ","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/CDTeek.gif","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/CDTeek.gif?itok=v8jYNCog","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/CDTeek.gif?itok=nuRUwmdX","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/CDTeek.gif?itok=cMXmR5nX","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/CDTeek.gif?itok=fB9UPKlO","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/CDTeek.gif?itok=vV40LlMP","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/CDTeek.gif?itok=oB0_nWRy"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/CDTeek.gif?itok=v8jYNCog 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/CDTeek.gif?itok=nuRUwmdX 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/CDTeek.gif?itok=cMXmR5nX 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/CDTeek.gif?itok=fB9UPKlO 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/CDTeek.gif?itok=vV40LlMP 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/CDTeek.gif?itok=oB0_nWRy 720w"]},"source":"Foto: Nini Hoang | Ronnie Blommendaal","source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"bf3369ee-50e7-4042-8e2a-12382706bcd3","header":{"title":null},"content":{"content":"\u003cp\u003eDe afgelopen jaren ziet Blommendaal dat steeds meer jeugd zijn weg vindt naar de platenzaken, een leuke ontwikkeling vindt hij. \"In het verleden was het publiek wat ouder en meerderheid man, nu zie je veel meer jongere mensen en ook veel meer vrouwen en meisjes. Het is mooi om te zien dat er weer een hele nieuwe generatie streamingsdiensten als Spotify een beetje zat is. Ze willen toch iets tastbaars van hun favoriete artiesten.\" \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"438e2e65-a2a4-44dd-af35-1c6235971423","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"CD Teek","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230417-R1-06773-013A-2.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=bnXTLUS-","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=YIOisPiT","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=T6bncwt-","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=un7oKQ_1","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=AHq8GaUv","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=d59bF_7V"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=bnXTLUS- 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=YIOisPiT 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=T6bncwt- 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=un7oKQ_1 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=AHq8GaUv 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06773-013A-2.jpg?itok=d59bF_7V 720w"]},"source":"Foto: Nini Hoang | klanten in de CD Teek","source_link":null},{"image":{"alt":"CD Teek","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230417-R1-06773-009A-2.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=YuA6Iq6g","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=1fmE2uDq","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=QGywroz5","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=VIRvqn15","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=uKKH7a1k","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=66-Pue8B"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=YuA6Iq6g 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=1fmE2uDq 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=QGywroz5 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=VIRvqn15 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=uKKH7a1k 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06773-009A-2.jpg?itok=66-Pue8B 720w"]},"source":"Foto: Nini Hoang | CD Teek","source_link":null}]}},{"type":"paragraph","id":"39f6c9a6-0caf-483d-8c02-6bb3e34189e3","header":{"title":null},"content":{"content":"\u003cp\u003eHierdoor ziet hij ook een duidelijke verschuiving in wat hij verkoopt. Vroeger was dit overwegend zwaar alternatief, maar nu vliegen ook artiesten als Lana Del Rey, Harry Styles en Taylor Swift over de toonbank. Zeker naar die laatste blijkt in aanloop naar Record Store Day enorm veel vraag. \"Verder is hiphop wel echt één van de hardlopende genres.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"0ceaaf95-36a0-4f6b-a216-d901e58d70ff","header":{"title":null},"content":{"content":"\u003cp\u003eMomenteel is de vinylplaat weer helemaal hot. \"Daar ga je echt voor zitten en het artwork is mooier, dat is wel echt de aantrekkingskracht.\" Maar hoewel de plaat zo populair is, wordt de CD naar Blommendaal's inziens onterecht bestempeld als een wegwerpachtig iets. \"Nu de LP zo duur wordt, zie je de jongere generatie ook weer CD's kopen. Die zijn gewoon een stuk goedkoper en het is ook gewoon een goed product.\" Deze blijven dan ook breed vertegenwoordigd in zijn winkel.\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_quote","id":"fca1e35f-0f38-4fa1-b643-3da37b7e05f7","header":{"title":null,"description":null},"content":{"quote":"Er is zoveel mooie muziek. Daarom is het fijn om een hele brede smaak te hebben, in plaats van dat je alleen maar naar Susan \u0026 Freek luistert.","author":"Ronnie Blommendaal over zijn brede muzieksmaak"}},{"type":"paragraph","id":"8112a61a-898a-4ece-80f9-825befa94744","header":{"title":null},"content":{"content":"\u003cp\u003eEen gouden tip die de CD Teek-eigenaar muziekliefhebbers\u0026nbsp;mee wil geven, beluister eens het album \u003ca href=\"https://youtu.be/1LZaytY3SdU\" target=\"_blank\"\u003e'Scenes From The Second Storey' van The God Machine\u003c/a\u003e. \"Naar mijns inziens ten onrechte erg onbekend.\" En naar eigen zeggen is hijzelf niet snel meer onder de indruk, dus dat belooft wat.\u003c/p\u003e\r\n","links":null}},{"type":"featured_paragraph","id":"a1b43866-0b23-40ee-ac10-326948e30747","header":{"title":"Velvet Music"},"content":{"content":"\u003cp\u003eWie\u0026nbsp;een groot aanbod aan nieuwe releases\u0026nbsp;en hedendaagse artiesten zoekt,\u0026nbsp;kan bij Velvet Music een zee aan materiaal induiken. Aan de muur pronken de artworks van Taylor Swift, Olivia Rodrigo, The Weeknd en Arctic Monkeys. \"Ik vind het belangrijk om te laten zien dat nieuwe dingen ook op plaat uitkomen en dat er nog steeds goede muziek wordt gemaakt.\"\u0026nbsp;Velvet Music startte 7 jaar geleden op Strijp-S, waar Remco Moonen-Emmerink de vestiging onder zijn hoede nam. Dat liep zo lekker dat hij uiteindelijk de zaak compleet heeft overgenomen. In 2020 is de winkel verhuisd naar de Edisonstraat, waar hij meer zijn eigen ding kan doen.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"Velvet Music","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/Velvet.gif","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/Velvet.gif?itok=YKbLBcNd","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/Velvet.gif?itok=g2W3g9tu","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/Velvet.gif?itok=1UPBtWas","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/Velvet.gif?itok=otEoC5i1","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/Velvet.gif?itok=ixYWf93y","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/Velvet.gif?itok=Lv2XHnp_"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/Velvet.gif?itok=YKbLBcNd 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/Velvet.gif?itok=g2W3g9tu 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/Velvet.gif?itok=1UPBtWas 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/Velvet.gif?itok=otEoC5i1 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/Velvet.gif?itok=ixYWf93y 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/Velvet.gif?itok=Lv2XHnp_ 720w"]},"source":"Foto: Nini Hoang","source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"cdf8287d-21ab-43e0-b6b3-b3b8fb4c31c6","header":{"title":null},"content":{"content":"\u003cp\u003eIn de winkel vind je vooral vinylplaten, waarbinnen een fors groeiende K-pop afdeling bestaat. De eigenaar heeft een focus op de hedendaagse (pop)muziek, maar ook de echte klassiekers zijn hier te vinden. Sinds een half jaar verkoopt hij ook weer tweedehandse platen. \"De kracht van het oude kruidenierswinkeltje zoals je die vroeger had, dat is wat ik hier ook wil neerzetten. Dat er allemaal producten staan is leuk en aardig, maar uiteindelijk moet het meer om de mens gaan. Je wordt toch deel van elkaars leven.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_quote","id":"dfec3f3d-aeb5-4cbd-80ae-b91ddd3f347e","header":{"title":null,"description":null},"content":{"quote":"Het ontdekken van nieuwe muziek is een soort reis waarbij je door de tijd reist, kriskras door de geschiedenis heen. En dat doe je niet alleen, maar samen.","author":"Remco Moonen-Emmerink over muziek ontdekken"}},{"type":"image_carousel","id":"618be790-10bf-4edc-8c56-c2b9ef203906","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"Velvet Music","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230414-DSC_3540.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3540.png?itok=FcxWE6vA","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3540.png?itok=F4c3R98v","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3540.png?itok=oGEWfSRe","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3540.png?itok=2RAHv53d","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3540.png?itok=-clL-Lv5","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3540.png?itok=knMqvH5x"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3540.png?itok=FcxWE6vA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3540.png?itok=F4c3R98v 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3540.png?itok=oGEWfSRe 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3540.png?itok=2RAHv53d 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3540.png?itok=-clL-Lv5 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3540.png?itok=knMqvH5x 720w"]},"source":"Foto: Roeline Machiels | Velvet Music","source_link":null},{"image":{"alt":"Velvet Music","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230414-DSC_3552.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3552.png?itok=Zq8QigkV","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3552.png?itok=KdM5xSgc","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3552.png?itok=xJ2td7Th","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3552.png?itok=X7IwgN7N","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3552.png?itok=OPFl6_v0","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3552.png?itok=JwiROXb_"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3552.png?itok=Zq8QigkV 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3552.png?itok=KdM5xSgc 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3552.png?itok=xJ2td7Th 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3552.png?itok=X7IwgN7N 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3552.png?itok=OPFl6_v0 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3552.png?itok=JwiROXb_ 720w"]},"source":"Foto: Roeline Machiels | Velvet Music","source_link":null}]}},{"type":"paragraph","id":"2a766058-263e-45f6-ace8-c97fcb3b0f6e","header":{"title":null},"content":{"content":"\u003cp\u003eDe ondernemer wisselt dan ook graag tips uit met zijn klanten. Hij ziet zichzelf niet als verkoper, maar meer iemand om mee over muziek 'te lullen'. \"Muziek is gewoon het allermooiste wat we hebben in ons leven. Ik ben zelf ook niet echt kieskeurig qua genres. Muziek is zoiets moois dat mensen met elkaar verbindt, daar zijn geen woorden voor.\" \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"ddc82c7c-7bfa-4b81-9e60-f75595be5468","header":{"title":null},"content":{"content":"\u003cp\u003eEen act die muziekliefhebbers volgens hem zouden moeten uitproberen\u0026nbsp;is \u003ca href=\"https://youtu.be/Na4RMkoq2os\" target=\"_blank\"\u003eGiant Brain\u003c/a\u003e, een klein Amerikaans bandje. \"De sound is erg eind jaren '70, en ook heel erg nu. Er zit elektronica in, super vette riffs en stoner.\" Ofwel, een tip voorop je verlanglijstje. Maar zaterdag kan je hier niet alleen platen scoren, ook geniet je van een gratis concert. Om 11.00 uur trakteert de Nederlandse FIEP op aanstekelijke indierock.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"5d78b2ab-f24d-40dd-8c69-4d8a2561836b","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/AW7f_4teSDw?si=0d1_s8anplsnHToD\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"9eacc8ba-6c7f-46ca-ac44-aa4200a7683c","header":{"title":"Ray Elpee "},"content":{"content":"\u003cp lang=\"NL-NL\"\u003eRay Derkzen draait al even mee in de Eindhovense muziekscene. Ooit werkte hij bij POPEI, had hij een eigen boekingskantoor en was hij zelfs twaalf jaar in dienst bij Effenaar. \"Dat was rond de tijd van Red Hot Chili Peppers en Pearl Jam daar op het podium stonden.\" Maar inmiddels is hij al enkele decennia helemaal into platen.\u0026nbsp;In 2003\u0026nbsp;stond de muziekfanaat op markten, wanneer hij tegen een toen leeg pand aanliep aan de Kleine Bleekstraat. En één plus één was twee.\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"Ray Elpee","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/RayElpee.gif","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/RayElpee.gif?itok=RxY9QwQk","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/RayElpee.gif?itok=5zr-FN6b","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/RayElpee.gif?itok=qUv_2WYj","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/RayElpee.gif?itok=f416AkEA","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/RayElpee.gif?itok=qBmn_efb","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/RayElpee.gif?itok=dRbSrpx-"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/RayElpee.gif?itok=RxY9QwQk 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/RayElpee.gif?itok=5zr-FN6b 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/RayElpee.gif?itok=qUv_2WYj 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/RayElpee.gif?itok=f416AkEA 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/RayElpee.gif?itok=qBmn_efb 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/RayElpee.gif?itok=dRbSrpx- 720w"]},"source":"Foto: Nini Hoang","source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"94d75aaa-6103-405d-adde-5c61c2951308","header":{"title":null},"content":{"content":"\u003cp\u003eHoewel hij in zijn winkel ook\u0026nbsp;CD's heeft staan, heeft Derkzen\u0026nbsp;persoonlijk een echte passie voor vinyl. \"Een plaat mag een beetje kraken, het klinkt ook warmer. Het heeft mooier artwork en je hebt echt iets tastbaars.\" En die liefde deelt hij graag met zijn klanten, maar de markt maakt dit soms wel lastig. De prijzen van LP's vindt hij momenteel belachelijk hoog. \"Er is nu een rerelease van ABBA en daar moet ik mensen dan vijftig euro voor vragen. Terwijl diezelfde plaat\u0026nbsp;hier ook tweedehands staat voor vijf euro. Dat gaat mij echt te ver.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"62dbac48-d4a3-4cda-89f2-f162c9706078","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"Ray Elpee","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230417-R1-06772-0011-2.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=n69Id9Lm","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=Z4JaTPoc","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=Qalcw-gz","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=bH5L5e5w","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=D6pyA0Y5","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=f4PzaF0P"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=n69Id9Lm 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=Z4JaTPoc 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=Qalcw-gz 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=bH5L5e5w 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=D6pyA0Y5 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0011-2.jpg?itok=f4PzaF0P 720w"]},"source":"Foto: Nini Hoang | Ray Elpee","source_link":null},{"image":{"alt":"Ray Elpee","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230417-R1-06772-0013-2.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=YkjoWmMJ","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=y4g87aj5","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=mZ2K85Ky","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=aMZG0lAD","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=Kebzyk5b","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=YKXEV0Cn"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=YkjoWmMJ 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=y4g87aj5 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=mZ2K85Ky 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=aMZG0lAD 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=Kebzyk5b 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0013-2.jpg?itok=YKXEV0Cn 720w"]},"source":"Foto: Nini Hoang | Ray Elpee","source_link":null}]}},{"type":"paragraph","id":"ae2e9ca5-e816-4556-941c-a5bec1c4c558","header":{"title":null},"content":{"content":"\u003cp\u003eHoewel Derkzen een focus heeft op tweedehandsplaten, wil hij de nieuwe releases wel kunnen aanbieden. Voor nu haalt hij er een aantal vanuit Duitsland, waar de inkoopprijs aanzienlijk lager ligt. Toch houden de hogere prijzen klanten gelukkig niet tegen om langs te komen. \"Er komt steeds meer jeugd. Wat mij laatst erg verbaasde was een meisje van 13 jaar die een stapel platen kocht ter waarde van 180 euro. Ik vroeg nog lachend aan de moeder: 'is dat jouw pinpasje?' Maar ze kocht ze echt zelf.\" Het meisje kocht allerlei albums van hedendaagse popartiesten als Dua Lipa en Billie Eilish. \"Vooral die laatste verkoopt als een tierelier.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"c3e4aa4e-524a-4cf9-b9a7-0baffdad25e9","header":{"title":null},"content":{"content":"\u003cp\u003eDerkzen zijn eigen favoriet is en blijft Led Zeppelin. Maar momenteel is hij ook helemaal weg van de plaat 'Totally' van de Amerikaanse band Stoner, waar muzikanten\u0026nbsp;Brant Bjork and Nick Oliveri in spelen. Naar zijn mening een echte aanrader voor iedereen die stonermuziek kan waarderen. \"Dat is echt geweldig.\" Hij heeft je bij dezen gewaarschuwd.\u003c/p\u003e\r\n","links":null}},{"type":"featured_paragraph","id":"c283490e-542b-439e-b2bc-5c398a689b34","header":{"title":"De Platenzaak"},"content":{"content":"\u003cp\u003eAan de Gelderopseweg vind je de winkel\u0026nbsp;van Wim van Stiphout, die geheel toepasselijk 'De Platenzaak' heet. \"Ik ben hier eigenlijk per\u0026nbsp;toeval terechtgekomen. Ik werkte voor een commerciële kringloop en hield mij daar bezig met de boeken, maar niemand deed daar de muziek. En muziek is mijn hobby, dus ben ik dat erbij gaan doen. Dat was in de tijd dat vinyl net weer een beetje populair begon te worden. Op een gegeven moment ben ik toen collecties gaan opkopen. Ongeveer 90% van de winkel is tweedehands spul. Van ABBA, tot Zappa, tot The Beatles en Yes.\" Hier zit je wel goed voor de klassiekers\u003c/p\u003e\r\n","image":{"image":{"alt":"De Platenzaak","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/DePlatenzaak.gif","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/DePlatenzaak.gif?itok=AcYV1_zQ","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/DePlatenzaak.gif?itok=2lwQwKig","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/DePlatenzaak.gif?itok=3MucKgg6","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/DePlatenzaak.gif?itok=hCOUNh_V","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/DePlatenzaak.gif?itok=CUMEsr_j","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/DePlatenzaak.gif?itok=JVnOTQQU"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/DePlatenzaak.gif?itok=AcYV1_zQ 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/DePlatenzaak.gif?itok=2lwQwKig 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/DePlatenzaak.gif?itok=3MucKgg6 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/DePlatenzaak.gif?itok=hCOUNh_V 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/DePlatenzaak.gif?itok=CUMEsr_j 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/DePlatenzaak.gif?itok=JVnOTQQU 720w"]},"source":"Foto: Nini Hoang","source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"05ae2d64-6360-4447-aefa-8fdb773972c9","header":{"title":null},"content":{"content":"\u003cp\u003eIn één hoek van de winkel kan je graven tussen het de nieuwe platen. Van Stiphout snapt de rivival of vinyl wel, ook zeker onder de opkomende bands waar hij albums van heeft staan. \"De coverart op een LP is natuurlijk fantastisch. En je hebt écht iets vast. Het is mooi gesealed en dat shined helemaal. Het is een beetje wat een ekster heeft met iets dat glimt. Platenliefhebbers hebben dat ook. Het moet er mooi uitzien.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"ded001df-cf5a-4eb4-ad46-5f051e7de533","header":{"title":null},"content":{"content":"\u003cp\u003eHet valt hem op dat er steeds meer jongeren binnenlopen en vragen naar The Beatles of Kiss. \"Die krijgen dat mee vanuit ouders, maar ook van games en films. Zo worden Pet Shop Boys volgens mij gebruikt in het spel Grand Theft Auto.\" Van de oudere garde heeft hij hierdoor soms de nieuwe druk in de winkel staan, want geen Queen in de winkel dat kan hij uiteraard niet maken. \"Als ik dat tweedehands in de winkel zet, dan is het gewoon meteen weg. Net als Thriller of Bad van Michael Jackson. Er zijn ook veel mensen die spijt hebben die, net als ikzelf, hun verzameling ooit hebben weggedaan toen de CD opkwam. Zij zoeken nu veel uit\u0026nbsp;de jaren '80.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"0ba77a72-31c8-420a-b983-c72ca31499dd","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"De platenzaak","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230417-R1-06772-0024-2.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=X6vSf2G8","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=1WQO71qU","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=1wuj3cB8","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=ymiLyaKY","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=BMDFi6RB","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=qWahtWBl"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=X6vSf2G8 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=1WQO71qU 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=1wuj3cB8 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=ymiLyaKY 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=BMDFi6RB 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0024-2.png?itok=qWahtWBl 720w"]},"source":"Foto: Nini Hoang | Wim van Stiphout in zijn zaak","source_link":null},{"image":{"alt":"De Platenzaak","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230414-DSC_3467.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3467.png?itok=DpZzQFUW","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3467.png?itok=b59aH3CN","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3467.png?itok=2C5g14Il","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3467.png?itok=UAEt_x_8","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3467.png?itok=8R00ulu6","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3467.png?itok=JgM3_eRS"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3467.png?itok=DpZzQFUW 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3467.png?itok=b59aH3CN 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3467.png?itok=2C5g14Il 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3467.png?itok=UAEt_x_8 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3467.png?itok=8R00ulu6 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3467.png?itok=JgM3_eRS 720w"]},"source":"Foto: Roeline Machiels | De Platenzaak","source_link":null}]}},{"type":"paragraph","id":"df22aa5c-f720-40f0-aaf3-eba8ab50f7e9","header":{"title":null},"content":{"content":"\u003cp\u003eMocht je nou misgrijpen op de plaat die je eigenlijk wil hebben uit deze periode, dan heeft Van Stiphout nog wel goede alternatieven. \"Er zijn een aantal albums die niet door alle muziekliefhebbers serieus worden genomen, wat ik wel echt hele vette albums vind. Denk bijvoorbeeld aan 'Introducing the Heartline According To Terence Trent D'Arby'. Dat is echt een briljant album. Of de plaat 'Picture Book' van Simply Red, die frontman heeft echt een soulstem.\" En een extra pluspunt, die zijn gewoon nog tweedehands te krijgen. \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"featured_paragraph","id":"33b44da9-ab87-4c85-9d58-7abc8c797141","header":{"title":"RUISHUIS"},"content":{"content":"\u003cp\u003eVers in het Eindhovense circuit is \u003ca href=\"https://www.instagram.com/ruishuis/\" target=\"_blank\"\u003ehet nieuwe Ruishuis\u003c/a\u003e; de platenzaak van Glenn Peeters. Die je misschien wel kent van de Eindhovense band Radar Men From The Moon. \"Het idee zat al enige tijd in mijn hoofd, alleen was nu het moment om het eindelijk eens door te zetten.\" Eind januari is Ruishuis dan eindelijk in de lucht gegaan, vooralsnog alleen online, maar er wordt hard gezocht naar een vaste ruimte. \"Ik wilde daar niet op wachten, ik vond dat het naar buiten moest.\"\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"Glen Peeters Ruishuis","src":"https://d12y285rxlbnxt.cloudfront.net/2024-04/GlennPeeters_Ruishuis.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=x0ROPm7Z","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=7J3AWgqv","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=z2AFQx50","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=trjii1br","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=fnIcHkej","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=iKTBHGsH"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=x0ROPm7Z 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=7J3AWgqv 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=z2AFQx50 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=trjii1br 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=fnIcHkej 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/GlennPeeters_Ruishuis.png?itok=iKTBHGsH 720w"]},"source":"Foto: Persfoto Glenn Peeters","source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"d4f4889e-deab-4c90-93ef-fb4dd8f52b30","header":{"title":null},"content":{"content":"\u003cp\u003eRuishuis focust zich op de wat meer undergroundmuziek en subculturen, en presenteert verschillende niches van alternatieve muziek. \"Het is natuurlijk supervet dat er zoveel zaken zijn in Eindhoven. Maar persoonlijk miste ik in Eindhoven een aantal dingen die ik zelf zou zoeken. Ik vond dat ik daarnaar moest handelen.\" Bij Ruishuis vind je platen, voornamelijk nieuwe vinyl, uit de hoeken; (post)punk, metal, goth, darkwave, acid house, EBM en verschillende soorten techno. \"Alles wat Ruishuis verkoopt heeft die 'underground' toets. Ik vind het belangrijk om dat te ondersteunen. Het komt voort uit de passie die ik heb voor deze muziek, dat enthousiasme wil ik overbrengen met Ruishuis. Ik geloof ook wel dat een platenzaak een reflectie is van degene die het runt. Ik kan het geheel cureren en ga op zoek naar artiesten en labels die ik tof vind. En op deze manier kan presenteren.\"\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"206cfaf3-ba1a-444a-a6b2-4fcfd46f2dbc","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Ruishuis","src":"https://d12y285rxlbnxt.cloudfront.net/2024-04/RUISHUIS_Square1.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/RUISHUIS_Square1.png?itok=aidDXB_D","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/RUISHUIS_Square1.png?itok=47UEU9Aw","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/RUISHUIS_Square1.png?itok=IYg4EfTu","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/RUISHUIS_Square1.png?itok=i7nOeYEH","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/RUISHUIS_Square1.png?itok=5vjuE_cv","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/RUISHUIS_Square1.png?itok=pcvNvFk9"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/RUISHUIS_Square1.png?itok=aidDXB_D 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/RUISHUIS_Square1.png?itok=47UEU9Aw 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/RUISHUIS_Square1.png?itok=IYg4EfTu 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/RUISHUIS_Square1.png?itok=i7nOeYEH 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/RUISHUIS_Square1.png?itok=5vjuE_cv 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/RUISHUIS_Square1.png?itok=pcvNvFk9 720w"]},"source":"Afbeelding: Logo Ruishuis","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"0b38112a-0815-4633-903b-31c4fe480d80","header":{"title":null},"content":{"content":"\u003cp\u003eWat Peeters zelf momenteel vet vindt? \"Zelf heb ik afgelopen weken veel naar de plaat ‘Weaponize your dreams’ van General Dynamics geluisterd, wat een samenwerking is tussen de techno artiest Sarin en EBM act Qual. Daarnaast heeft ook de nieuwe plaat van de Franse black metalband Mutiilation veel rondes gedraaid. Verder ben ik heel enthousiast over de nieuwe plaat ’Eisstob’ van Post Scriptvm dat power electronics met ambient mixt. Kortom, ik denk dat mijn interesses als curator worden gereflecteerd in Ruishuis want dit soort acts vind je ook in mijn aanbod.\"\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"d1d46008-a355-4b12-8dc4-1af96c65d463","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/2UvJJYXJQUuSLxAQdOph4T?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"5b36c0b5-565c-4d62-89a7-47d37d99d9aa","header":{"title":null},"content":{"content":"\u003cp\u003eDe droom is om een vaste plek te bemachtigen, waar hij mensen kan meenemen in de wondere wereld van de undergroundmuziek. \"Een platenzaak moet een wereld zijn waar je binnenstapt\", vindt Peeters. \"Je wordt ook heel erg aangetrokken tot het visuele gedeelte, de hoezen. Waardoor je ook dingen probeert die je nog niet kent, en daardoor verrast wordt.\" Dat wil hij dan ook het liefste doen, muziekliefhebbers verrassen met toffe acts en genres. \"Momenteel sta ik dagelijks bij het postkantoor, dat is wat minder romantisch. Maar er loopt wel een gesprek voor een mogelijke ruimte. Dat moet ik nog even afwachten en hopelijk krijg ik daar binnenkort een positief bericht van.\" Het is dus nog even geduld, maar tot het fysiek kan, kan je online al terecht om zijn collectie aan underground-parels door te spitten. \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"featured_paragraph","id":"816118a1-b39f-4c5e-8528-f0c24e5054ed","header":{"title":"Bullit Klassiek"},"content":{"content":"\u003cp\u003eDe naam van de winkel verraadt het al, Bullit Klassiek staat vol met prachtige klassieke werken. Wanneer je de foyer van Muziekgebouw Eindhoven binnenloopt kan je de zaak van Rens Sanders eigenlijk niet missen. Bij binnenkomst stuit je al snel op zijn gouden desk, waarachter bakken en kasten vol met CD’s te vinden zijn.\u0026nbsp;Bullit Klassiek zag haar levenslicht als vertakking van de platenzaak Bullit die eerder in Eindhoven zat. Sanders werkte destijds bij Bullit en kreeg van de eigenaar de kans om een klassieke versie van de zaak op te zetten. \u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"The Bullit Klassiek","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/BullitKlasiek.gif","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/BullitKlasiek.gif?itok=8DCoTAKB","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/BullitKlasiek.gif?itok=2gRRzWzj","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/BullitKlasiek.gif?itok=N6is_QI7","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/BullitKlasiek.gif?itok=pZbhA5w0","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/BullitKlasiek.gif?itok=HADBFIeT","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/BullitKlasiek.gif?itok=VJFkEB9y"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/BullitKlasiek.gif?itok=8DCoTAKB 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/BullitKlasiek.gif?itok=2gRRzWzj 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/BullitKlasiek.gif?itok=N6is_QI7 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/BullitKlasiek.gif?itok=pZbhA5w0 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/BullitKlasiek.gif?itok=HADBFIeT 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/BullitKlasiek.gif?itok=VJFkEB9y 720w"]},"source":"Foto: Nini Hoang | Rens Sanders","source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"2ec001a7-49b7-4d55-9e61-c647b4f35abe","header":{"title":null},"content":{"content":"\u003cp\u003e“Ik ben toen op de Bergstraat begonnen. Doordat de CD-markt inzakte, kon de eigenaar van Bullit het al snel niet meer financieren. Het was toen stoppen of de winkel overnemen. Toen heb ik mijn huis verkocht om Bullit Klassiek over te nemen. En na een aantal moeilijke jaren bestaat het nu na dertig jaar nog steeds.” En inmiddels zit hij daarvan al zo’n 25 jaar in Muziekgebouw Eindhoven.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"32cabd21-ff59-4b28-b4d7-2040818dadf8","header":{"title":null},"content":{"content":"\u003cp\u003eIn zijn jongere jaren bezocht Sanders regelmatig new wave concerten in Effenaar, en zat hij zelfs in een punkbandje. Waaruit zijn passie voor klassieke muziek is ontstaan? “Toen ik bij Bullit werkte, heb ik daar verschillende terreinen onderzocht; jazz, pop, wereldmuziek, de Engelse, Amerikaanse en Nederlandse muziek. Op een gegeven moment had ik dat wel allemaal gehad en begon het te vervelen.” De uitvoering die hem heeft geprikkeld om de klassieke wereld in te duiken was de Italiaanse opera Norma van Bellini, waarvan de vertolking door Maria Callas hem het meest ontroert. “Dat raakt je zo diep, dat is de reden waarom je naar muziek luistert. En iedere keer weer. Ik draai het eigenlijk weinig, want ik schiet meteen weer vol.”\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"d0041b18-6169-40ba-a3ff-4600d5de5ed5","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/track/0U3rmYLLwNzqJxmfq9E7a3?utm_source=generator\" width=\"100%\" height=\"352\" frameBorder=\"0\" allowfullscreen=\"\" allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"paragraph","id":"6341a3fd-eab5-4f79-b3b0-0b2579127453","header":{"title":null},"content":{"content":"\u003cp\u003eEen aanrader voor ieder die zijn tenen eens wil dippen in de klassieke wateren, dat vindt de eigenaar maar lastig. “Er is geen standaard werk dat geldt voor iedereen. Iemand die van piano houdt, die moet de Goldberg Variations van Glenn Gould absoluut in huis hebben. Maar verder moet je echt een beetje speuren. Je wordt er niet mee overladen zoals met popmuziek. Je moet er zelf iets meer insteken.” Een andere tip van Sanders is: geduld. In een recent artikel over streamingsdiensten las hij dat de gemiddelde luisterduur zo’n 8 seconden is. “In klassieke muziek is er dan in veel werken nog niets gebeurd. Sommige stukken hebben een intro van tien minuten.”\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_quote","id":"4d273d6d-ae96-4931-b73c-2bc4df61a51e","header":{"title":null,"description":null},"content":{"quote":"Voor veel mensen die de klassieke muziek niet kennen is er een wereld te ontdekken van hier tot ginder. Laat het niet links liggen, er is veel te halen.","author":"Rens Sanders over klassieke muziek"}},{"type":"image_carousel","id":"78774f7c-1f31-4e54-83d8-e25cfa6dc40e","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"The Bullti Klassiek","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230417-R1-06772-0007-2.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=iDGgLEK0","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=gn0XD7FZ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=0eivov4b","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=gWKHuGa6","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=WbocXfqB","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=GW2LXz7l"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=iDGgLEK0 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=gn0XD7FZ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=0eivov4b 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=gWKHuGa6 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=WbocXfqB 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0007-2.jpg?itok=GW2LXz7l 720w"]},"source":"Foto: Nini Hoang | The Bullit Klassiek","source_link":null},{"image":{"alt":"Bullit Klassiek","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230414-DSC_3378_0.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3378_0.png?itok=azgeghZv","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3378_0.png?itok=gqItiKm4","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3378_0.png?itok=7ry50nPS","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3378_0.png?itok=bGlie8Vq","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3378_0.png?itok=4GcDBEDO","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3378_0.png?itok=nVQI3uhA"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3378_0.png?itok=azgeghZv 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3378_0.png?itok=gqItiKm4 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3378_0.png?itok=7ry50nPS 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3378_0.png?itok=bGlie8Vq 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3378_0.png?itok=4GcDBEDO 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3378_0.png?itok=nVQI3uhA 720w"]},"source":"Foto: Roeline Machiels | Bullit Klassiek","source_link":null}]}},{"type":"paragraph","id":"0241dbe0-7ae8-45c1-b7f6-839a64446500","header":{"title":null},"content":{"content":"\u003cp\u003eEen fascinerend verschil tussen de popmuziek en klassieke wereld vindt hij de ontvangst van verschillende variaties van één nummer. Hij haalt hierbij David Bowie als voorbeeld aan. “Een ander moet zijn nummers eigenlijk niet zingen, want niets is beter dan het origineel volgens fans.” In de klassieke wereld is dit anders, doordat de uitvoeringen erg kunnen verschillen door variaties in tempo, accenten en hoe het orkest is samengesteld. “Laats had ik iemand in de winkel die de Matthäus-Passion van Bach spaart en die had al zo’n 129 verschillende uitvoeringen. Dat zul je met popmuziek niet snel hebben. Meestal is er maar één die er een hit mee scoort.”\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"921258af-59f9-4e36-84f1-91823884b573","header":{"title":null},"content":{"content":"\u003cp\u003eIn de winkel vind je vooral CD’s, omdat dit bij klassieke muziek het kraakheldere geluid waarborgt. Wil je eens rondneuzen tussen alle verschillende werken en variaties? Sanders maakt je graag wegwijs in de wereld van klassieke muziek.\u003c/p\u003e\r\n","links":null}},{"type":"featured_paragraph","id":"9dffa231-4e83-40bc-a1ee-5ffcdba4a7cb","header":{"title":"Een ontmoetingsplek voor muziekliefhebbers in Burgers "},"content":{"content":"\u003cp\u003eVerstopt achter in het pand Burgers, vind je een kamertje waar je iedere vrijdagmiddag door de privécollectie van Hans Matheeuwsen mag neuzen. Op slechts een paar vierkante meter kan je je tegoed doen aan ontelbaar veel platen en CD’s, die hij op goed vertrouwen uitleent aan zijn gasten. \"En als je het dan niet terugbrengt, dan ben ik gedesillusioneerd en een beetje boos, maar dat weerhoudt mij niet.\" Al zo'n 33 jaar bestaat zijn platenuitleen. Door middel van zijn\u0026nbsp;initiatief wil hij mensen meenemen in zijn liefde voor muziek.\u0026nbsp;\"In drieëndertig jaar ben ik er pas vier keer niet geweest op vrijdag. Inmiddels ben ik met mijn collectie uitgegroeid tot een ontmoetingsplek waar je muziek kunt ruilen, lenen en erover kan praten.\"\u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"Burgers","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/Burgers.gif","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/Burgers.gif?itok=-X2pqWjU","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/Burgers.gif?itok=JBHhD3gR","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/Burgers.gif?itok=QigjdvFk","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/Burgers.gif?itok=5m0vETs0","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/Burgers.gif?itok=Mqtduyzh","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/Burgers.gif?itok=cCzAZehz"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/Burgers.gif?itok=-X2pqWjU 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/Burgers.gif?itok=JBHhD3gR 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/Burgers.gif?itok=QigjdvFk 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/Burgers.gif?itok=5m0vETs0 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/Burgers.gif?itok=Mqtduyzh 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/Burgers.gif?itok=cCzAZehz 720w"]},"source":"Foto: Nini Hoang","source_link":null},"image_align":"left","links":null}},{"type":"paragraph","id":"9d1b60c9-ce3a-49bc-a23a-2d093feaf014","header":{"title":null},"content":{"content":"\u003cp\u003eDe liefde voor muziek zit er al vanaf jongs af aan in\u0026nbsp;bij Matheeuwsen. In\u0026nbsp;zijn collectie vind je een breed scala aan genres, maar de focus ligt toch wel op experimenteel, avant-garde en veel gitaren. \"Ik ben opgegroeid met Crosby, Stills, Nash \u0026amp; Young, vooral Neil Young scoort hoog in mijn top tien allertijden. Ook psychedelica uit Amerika, zoals Quicksilver Messenger Service en Jefferson Airplane. Daar ben ik mee opgegroeid en er is in de loop der jaren niet gek veel beters gemaakt.\" Er is een stelling dat alles wat je tussen je 15e en 25ste goed vindt, dat dat de maatstaf is voor de rest van je leven, vertelt de initiatiefnemer. Maar met 66 jaar op de teller ontdekt hij nog altijd nieuwe muziek die hem raakt. Zijn favoriete album van 2022 was God's Country van de Amerikaanse rockband Chat Pile, een plaat vol stevige noisegitaren. \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"984a416f-b136-42c6-9c5e-9fe07a3126b3","header":{"title":null},"content":{"content":"\u003cp\u003eMuziek aan anderen aanraden, dat doet de liefhebber liever niet. \"Jij moet voor jezelf uitmaken wat goed is, dat ga ik niet doen. Neem maar wat mee en ga maar luisteren. Vaak krijg ik dan een 'maar ik ken het niet'. Leer het dan kennen, please! Niet altijd voor safe gaan.\" Hij heeft liever dat zijn gasten dan een plaatje extra lenen om het uit te proberen.\u003c/p\u003e\r\n","links":null}},{"type":"image_carousel","id":"4d4d0152-6e55-4070-9cb9-898b696af6f6","header":{"title":null,"description":null},"content":{"items":[{"image":{"alt":"Burgers","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230414-DSC_3499.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3499.png?itok=tg1jr99A","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3499.png?itok=-zaFncIs","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3499.png?itok=WKu5nLmn","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3499.png?itok=uCqHP5pj","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3499.png?itok=GS7w4Tx9","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3499.png?itok=VLnrGk5k"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3499.png?itok=tg1jr99A 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3499.png?itok=-zaFncIs 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3499.png?itok=WKu5nLmn 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3499.png?itok=uCqHP5pj 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3499.png?itok=GS7w4Tx9 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3499.png?itok=VLnrGk5k 720w"]},"source":"Foto: Roeline Machiels | Burgers","source_link":null},{"image":{"alt":"Burgers","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230414-DSC_3485.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3485.png?itok=NEDzsqWD","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3485.png?itok=OigjQ6zc","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3485.png?itok=mZFSPHzD","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3485.png?itok=ztNFfeV8","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3485.png?itok=gMSVRYJt","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3485.png?itok=TpeHgpyW"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230414-DSC_3485.png?itok=NEDzsqWD 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230414-DSC_3485.png?itok=OigjQ6zc 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230414-DSC_3485.png?itok=mZFSPHzD 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230414-DSC_3485.png?itok=ztNFfeV8 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230414-DSC_3485.png?itok=gMSVRYJt 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230414-DSC_3485.png?itok=TpeHgpyW 720w"]},"source":"Foto: Roeline Machiels | Burgers","source_link":null}]}},{"type":"effenaar_quote","id":"5b20e789-84f6-42f9-8eed-379efc4111d0","header":{"title":null,"description":null},"content":{"quote":"Het is ook een kwaal, er komt zoveel uit. Ook online, dat is oneindig. Dat is mijn enige probleem, er zitten maar vierentwintig uur in één dag.","author":"Hans Matheeuwsen over zijn liefde voor muziek"}},{"type":"paragraph","id":"441780b8-1ac8-4ef5-932b-7798d49992a4","header":{"title":null},"content":{"content":"\u003cp\u003eDe collectie van Matheeuwsen bestaat zowel uit LP's als CD's. Een voorkeur tussen de twee dragers heeft hij eigenlijk niet. \"Ik heb ooit gedaan alsof een plaat speelde, maar de CD stond op. En twee mensen aan de bar zeiden: 'je kunt horen dat het een LP is, het klinkt zoveel warmer.' Dat vond ik humoristisch. Ik denk dat, zeker op mijn leeftijd, het verschrikkelijk moeilijk is om verschil te horen. Als het er is, dan wordt het waarschijnlijk gemaakt door je versterker, speler of boxen.\"\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"effenaar_image","id":"10a933ab-b4af-45b6-8f53-c0ce40e4581f","header":{"title":null,"description":null},"content":{"image":{"image":{"alt":"Burgers","src":"https://d12y285rxlbnxt.cloudfront.net/2023-04/20230417-R1-06772-0035-2.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=bFXvUdck","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=fPSu9zmg","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=fgvSJOqq","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=jy97v_Sd","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=xb0LNvh2","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=V80B7Hzb"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=bFXvUdck 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=fPSu9zmg 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=fgvSJOqq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=jy97v_Sd 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=xb0LNvh2 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-04/20230417-R1-06772-0035-2.jpg?itok=V80B7Hzb 720w"]},"source":"Foto: Nini Hoang | de vaste club","source_link":null},"is_fullscreen":false}},{"type":"paragraph","id":"3e910ed3-1486-4219-8971-9d6d514fdf59","header":{"title":null},"content":{"content":"\u003cp\u003eInmiddels zit het vaste clubje van de vrijdagmiddag al binnen en iedere vraag is een startpunt voor een interessante discussie over de muziekindustrie, self-releasing artists en zelfs Beyoncé. Meerdere gasten\u0026nbsp;mengen zich in het gesprek. En dit is precies waar het plekje van Matheeuwsen\u0026nbsp;om draait. Samen je passie delen voor muziek.\u0026nbsp;De ontmoetingsplek van Matheeuwsen is niet bekend of aangegeven in Eindhoven, je moet hem echt weten te vinden. \"Dat vind ik onderdeel van de charme, een beetje moeite doen. Maar het zijn erg leuke middagen en iedereen is welkom.\" Dus je hoort het, schuif vooral eens een keer aan voor een plaatje en een praatje. \u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"8b49a850-b229-4060-a88c-b3b6add29ef0","header":{"title":null},"content":{"content":"\u003ch4\u003eDit zijn de toffe platenzaken en uitwisselplek die Eindhoven rijk is. Een mooie mix van ondernemers die elkaar qua visie en focus aanvullen en zorgen dat er in de stad voor ieder wat wils is.\u0026nbsp;\u0026nbsp;\u003c/h4\u003e\r\n","links":null}},{"type":"related_longr_story","id":"a02804ac-404d-426a-8a3a-0afdac0cf874","header":{"title":"Meer lezen:","description":null},"content":{"items":[{"type":"longread","nid":762,"slug":"/artikelen/chef-kok-dies-effenaar-meet-eat-een-ontmoetingsplek-voor-alle-eindhovenaren","endpoint":"/nl/artikelen/chef-kok-dies-effenaar-meet-eat-een-ontmoetingsplek-voor-alle-eindhovenaren","translations":{"nl":"/artikelen/chef-kok-dies-effenaar-meet-eat-een-ontmoetingsplek-voor-alle-eindhovenaren","en":null},"title":"Chef-kok Dies: 'Effenaar Meet \u0026 Eat is een ontmoetingsplek voor alle Eindhovenaren'","content":"\u003cp\u003eVanaf het moment dat hij wakker wordt, denkt chef-kok Dies Wouters aan eten. Al zestien jaar runt hij het - sinds deze zomer vernieuwde - café-restaurant Effenaar Meet \u0026 Eat. En dat doet hij met een visie: zoveel mogelijk zelfgemaakt, zoveel mogelijk lokaal en elke maand een nieuwe dinerkaart. Maar wie is deze smaakkunstenaar en meesterbrein achter de keuken van Effenaar nou eigenlijk?\u003c/p\u003e\r\n","meta":{"title":"Chef-kok Dies: 'Effenaar Meet \u0026 Eat is een ontmoetingsplek voor alle Eindhovenaren'","description":"Lees hier het hele interview.","image":null},"publish_date":{"timestamp":1700581148,"machine":"2023-11-21T15:39:08+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Effenaar Meet and eat","src":"https://d12y285rxlbnxt.cloudfront.net/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=yrw9NCTM","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=FNxZD1zP","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=okIlD61y","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=WnE696i8","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=ch2uqqib","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=a4ir8m4n"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=yrw9NCTM 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=FNxZD1zP 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=okIlD61y 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=WnE696i8 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=ch2uqqib 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883v2.png?itok=a4ir8m4n 720w"]},"source":"Foto: Max Kneefel | Dies Wouters in Effenaar Meet \u0026 Eat","source_link":null},"breadcrumb":null,"subtitle":"Door Zoran Bogdanovic","thumbnail_image":{"image":{"alt":"Dies restaurant","src":"https://d12y285rxlbnxt.cloudfront.net/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=uejiico3","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=h1IW4Lrd","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=5qzkJ3JS","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=B3So-aDy","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=XJ3MiN7B","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=Wh27sAgs"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=uejiico3 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=h1IW4Lrd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=5qzkJ3JS 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=B3So-aDy 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=XJ3MiN7B 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-11/20231110_EffenaarRestaurant_MaxKneefel_3883.png?itok=Wh27sAgs 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#2A5757","background_color":"#6AA6A6","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":643,"slug":"/artikelen/legendarische-effenaar-posters-ruil-voor-tosti-bonnen","endpoint":"/nl/artikelen/legendarische-effenaar-posters-ruil-voor-tosti-bonnen","translations":{"nl":"/artikelen/legendarische-effenaar-posters-ruil-voor-tosti-bonnen","en":null},"title":"Legendarische Effenaar-posters in ruil voor tosti-bonnen","content":"\u003cp\u003eAl meer dan vijftig jaar bestaat Effenaar: dat zijn heel wat posters, affiches en ander soort visuals. Met ‘Effenaar in Beeld’ ontmoet je de vormgevers die hieraan hebben bijgedragen. Wat maakten ze, wat was hun ervaring met het poppodium en waar staan ze nu?\u003c/p\u003e\r\n","meta":{"title":"Legendarische Effenaar-posters in ruil voor tosti-bonnen","description":"Lees hier het hele artikel.","image":null},"publish_date":{"timestamp":1692081141,"machine":"2023-08-15T06:32:21+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Rik van Iersel","src":"https://d12y285rxlbnxt.cloudfront.net/2023-08/Rikvanierselheader.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-08/Rikvanierselheader.png?itok=Hry7C-Gq","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-08/Rikvanierselheader.png?itok=ljKI3Qh3","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-08/Rikvanierselheader.png?itok=9qjYIGss","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-08/Rikvanierselheader.png?itok=PfNfKSA1","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-08/Rikvanierselheader.png?itok=bB-WY37G","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-08/Rikvanierselheader.png?itok=-o7EA_zA"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-08/Rikvanierselheader.png?itok=Hry7C-Gq 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-08/Rikvanierselheader.png?itok=ljKI3Qh3 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-08/Rikvanierselheader.png?itok=9qjYIGss 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-08/Rikvanierselheader.png?itok=PfNfKSA1 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-08/Rikvanierselheader.png?itok=bB-WY37G 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-08/Rikvanierselheader.png?itok=-o7EA_zA 720w"]},"source":"Foto: Davy de Lepper | portret Rik van Iersel","source_link":null},"breadcrumb":null,"subtitle":"Door Davy de Lepper","thumbnail_image":{"image":{"alt":"Rik van Iersel","src":"https://d12y285rxlbnxt.cloudfront.net/2023-08/Rikvanierselthumb.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-08/Rikvanierselthumb.png?itok=_oTLGVeM","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-08/Rikvanierselthumb.png?itok=Jydj-edz","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-08/Rikvanierselthumb.png?itok=mc5WZq18","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-08/Rikvanierselthumb.png?itok=dyAM1Mc5","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-08/Rikvanierselthumb.png?itok=7v6LPrQY","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-08/Rikvanierselthumb.png?itok=v89RZH4q"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-08/Rikvanierselthumb.png?itok=_oTLGVeM 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-08/Rikvanierselthumb.png?itok=Jydj-edz 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-08/Rikvanierselthumb.png?itok=mc5WZq18 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-08/Rikvanierselthumb.png?itok=dyAM1Mc5 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-08/Rikvanierselthumb.png?itok=7v6LPrQY 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-08/Rikvanierselthumb.png?itok=v89RZH4q 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#D90404","background_color":"#F2B8A2","text_color":"#000000"},"tags":[],"related_events":[]},{"type":"longread","nid":968,"slug":"/artikelen/uit-de-tijdcapsule-joy-division-effenaar","endpoint":"/nl/artikelen/uit-de-tijdcapsule-joy-division-effenaar","translations":{"nl":"/artikelen/uit-de-tijdcapsule-joy-division-effenaar","en":null},"title":"Uit de tijdcapsule: spanning loopt op bij een intens en zwaarmoedig Joy Division in Effenaar","content":"\u003cp\u003eIn 1979 verscheen het legendarische album 'Unknown Pleasures' van Joy Division, waarmee de Britse band de New Wave-beweging aftrapte en het fundament legde voor vele andere iconische bands. Met hun debuutplaat vers op zak, kwam het kwartet in januari 1980 voor het eerst naar Nederland. De tour ging uiteindelijk te boek als het enige bezoek van Joy Division aan ons land. Van de slechts zes shows, speelde de band er ook één in Eindhoven. Op 18 januari 1980 betoverde Joy Division het publiek in Effenaar met haar duistere sound.\u003c/p\u003e","meta":{"title":"Uit de tijdcapsule: spanning loopt op bij een intens en zwaarmoedig Joy Division in Effenaar","description":"Beleef hier het concert van Joy Division in Effenaar uit 1980.","image":null},"publish_date":{"timestamp":1759923737,"machine":"2025-10-08T11:42:17+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Joy Division in Effenaar","src":"https://d12y285rxlbnxt.cloudfront.net/2024-04/-002.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/-002.png?itok=VdftVYq7","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/-002.png?itok=FF1STxIg","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/-002.png?itok=4Jx-aqFO","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/-002.png?itok=uD-Azx2P","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/-002.png?itok=wnUvtmxW","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/-002.png?itok=1mZ7QDiB"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/-002.png?itok=VdftVYq7 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/-002.png?itok=FF1STxIg 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/-002.png?itok=4Jx-aqFO 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/-002.png?itok=uD-Azx2P 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/-002.png?itok=wnUvtmxW 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/-002.png?itok=1mZ7QDiB 720w"]},"source":"Foto: Peter Cox | Joy Division in Effenaar","source_link":null},"breadcrumb":null,"subtitle":"Door Roeline Machiels","thumbnail_image":{"image":{"alt":"Joy Division in Effenaar","src":"https://d12y285rxlbnxt.cloudfront.net/2024-04/thumb.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/thumb.png?itok=pE7NDSQ5","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/thumb.png?itok=-q4Rz7dC","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/thumb.png?itok=CBE7QM98","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/thumb.png?itok=R5EHulFm","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/thumb.png?itok=Lrz51Qef","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/thumb.png?itok=xga6W3kE"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/thumb.png?itok=pE7NDSQ5 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/thumb.png?itok=-q4Rz7dC 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/thumb.png?itok=CBE7QM98 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/thumb.png?itok=R5EHulFm 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/thumb.png?itok=Lrz51Qef 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/thumb.png?itok=xga6W3kE 720w"]},"source":null,"source_link":null},"colors":{"accent_color":"#F2F2F2","background_color":"#262626","text_color":"#FFFFFF"},"tags":[],"related_events":[]},{"type":"longread","nid":428,"slug":"/artikelen/huisfotograaf-paul-verhagen-mijn-kleurenblindheid-voor-mij-een-non-issue","endpoint":"/nl/artikelen/huisfotograaf-paul-verhagen-mijn-kleurenblindheid-voor-mij-een-non-issue","translations":{"nl":"/artikelen/huisfotograaf-paul-verhagen-mijn-kleurenblindheid-voor-mij-een-non-issue","en":null},"title":"Het unieke perspectief van een concertfotograaf met kleurenblindheid","content":"\u003cp\u003eDe toffe platen van huisfotograaf Paul Verhagen heb je ongetwijfeld weleens voorbij zien komen. Jaar na jaar schiet hij vette en krachtige foto's van acts die Effenaar komen platspelen. Inmiddels is hij al meer dan twaalf jaar onderdeel van de enthousiaste club huisfotografen, en nog altijd met evenveel passie.\u003c/p\u003e\r\n","meta":{"title":"Het unieke perspectief van een concertfotograaf met kleurenblindheid","description":"Lees hier het hele interview met huisfotograaf Paul Verhagen.","image":null},"publish_date":{"timestamp":1677746870,"machine":"2023-03-02T08:47:50+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Paul Verhagen","src":"https://d12y285rxlbnxt.cloudfront.net/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=MuH13ZES","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=nWws2LUH","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=nAY3igSh","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=8-a_jbqa","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=nLP8a3vg","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=rJGoFYJl"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?itok=MuH13ZES 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-03/Paul%20Verhagen%20portret%202023-209949.jpg?it