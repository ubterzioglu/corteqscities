/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=JihIrLeA 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=xfXP3Epd 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=dDhzVXXq 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=G5MtQtlZ 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=pcoIFteQ 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2025-11/%20%E2%80%93%20Square%20afbeelding%20only%20dotan.png?itok=BaADXtCk 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":"sold_out","club_card_event":false,"colors":{"accent_color":"#014034","background_color":"#F2F2F2","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"dcc08242-4fa2-41c2-bca1-574bbe0706d2","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e20:00 Deuren open\u003cbr /\u003e\r\n20:30 Hideous\u0026nbsp;\u003cbr /\u003e\r\n(tijden onder voorbehoud)\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"5f3bab3e-10b9-4989-a024-be043b106013","header":{"title":"Hideous met eigen show terug in Eindhoven!"},"content":{"content":"\u003cp\u003eNa spetterende shows op Come As You Are en als support van The Vices keren de Vlaamse rockers van Hideous terug, dit keer naar Café Wilhelmina. Hideous is het gloednieuwe samengesteld gezin van gitaristen Guillaume Lamont (RHEA) en Tim Leyman (Ramkot). Beiden verdienden ze al hun strepen bij de genoemde projecten, maar ze besloten om hun krachten te bundelen. Hideous brengt rockmuziek geïnspireerd op de ruwheid van de jaren '90. Rechtdoor zonder nadenken, maar toch het belang van een zwevende melodie niet onderschatten.\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"c469a4d2-3e83-45e5-b15b-0e0482b32e71","header":{"title":"Lovende kritieken"},"content":{"content":"\u003cp\u003eEind 2022 werd de band opgericht en in november 2022 brachten ze hun eerste single uit, genaamd ‘Curse’. Daarop volgde de single ‘Follow Me’ in april en hun nieuwste single ‘The Rut’ in oktober. Deze singles werden allemaal met lovende kritieken ontvangen. Naast Guilaume en Tim zijn ook Victor Defoort (Roméo Elvis) \u0026amp; Dajo Vlaeminck (Kids With Buns) belangrijke bandleden.\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"5ef702bc-4bd5-4cd5-b3c4-a7f9e9aa3b1c","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/iS7tdbR7QZc?si=hgysKs-MQuUfqtlE\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724623242,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-hideous-nl","queryHash":"[\"AgendaDetail-hideous-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":795,"slug":"/agenda/microwave-dirty-nil","endpoint":"/nl/agenda/microwave-dirty-nil","translations":{"nl":"/agenda/microwave-dirty-nil","en":null},"title":"Microwave + The Dirty Nil","content":"\u003cp\u003eHet uit Atlanta afkomstige Microwave leeft bij zijn eigen regels. De band zette zichzelf op de kaart met de plaat Much Love (2016), waarop genre grenzen irrelevant zijn en invloeden van alternatieve rock, emo en misschien wel honderd subgenres moeiteloos in de blender worden gegooid.\u003c/p\u003e\r\n","meta":{"title":"Microwave + The Dirty Nil","description":"","image":null},"publish_date":{"timestamp":1702285730,"machine":"2023-12-11T09:08:50+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"Microwave header","src":"https://d12y285rxlbnxt.cloudfront.net/2023-12/%E2%80%93%201920x1080%20Website.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-12/%E2%80%93%201920x1080%20Website.jpg?itok=xC0-rUMj","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-12/%E2%80%93%201920x1080%20Website.jpg?itok=GTNNr_Gn","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-12/%E2%80%93%201920x1080%20Website.jpg?itok=55AMirnk","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-12/%E2%80%93%201920x1080%20Website.jpg?itok=xzwjkbNm","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-12/%E2%80%93%201920x1080%20Website.jpg?itok=s6Rb58lG","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-12/%E2%80%93%201920x1080%20Website.jpg?itok=s4qSAQxx"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-12/%E2%80%93%201920x1080%20Website.jpg?itok=xC0-rUMj 1400w","https://d12y285rxlbnxt.cloud