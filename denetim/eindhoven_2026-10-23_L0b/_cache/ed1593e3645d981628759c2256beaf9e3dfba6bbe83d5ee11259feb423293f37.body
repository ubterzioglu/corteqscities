oudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png?itok=D7ucC5O2","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png?itok=3_hKtIo-","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png?itok=AHC1_rSo"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png?itok=XtA3t7MZ 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png?itok=K_5pmG1P 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png?itok=2pKOPpq8 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png?itok=D7ucC5O2 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png?itok=3_hKtIo- 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-04/%20%E2%80%93%20Square%20afbeelding%20onlyROLF.png?itok=AHC1_rSo 720w"]},"source":null,"source_link":null},"locations":[{"id":116,"title":"Grote zaal","is_external":false}],"state":null,"club_card_event":false,"colors":{"accent_color":"#312015","background_color":"#d2bea6","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"d90acf84-91cb-4ba2-adf9-94534aebb70e","header":{"title":null},"content":{"content":"\u003cp\u003eSinds hun doorbraak met 'Box of Secrets' (2008) blijft het duo uit Brighton hun mix van indie, punk en rock opnieuw uitvinden, met als voorlopig laatste wapenfeit 'Ghosts On Tape' (2022). Hun in-your-face rock-’n-roll heeft wereldwijd al menig podium gesloopt en klinkt nog altijd even fel en urgent. Dit jaar vieren ze hun 20-jarig bestaan met een intieme clubshow waar stevige riffs en indie-anthems zich genadeloos vastbijten.\u003c/p\u003e","links":null}},{"type":"paragraph","id":"47b08cd2-4934-4db3-bfb3-30e5f14eb5c6","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:30 uur: deuren open\u003cbr\u003e20:00 uur: show Sm^sher\u003cbr\u003e21:00 uur: show Blood Red Shoes\u003cbr\u003e22:15 uur: verwachte eindtijd\u003cbr\u003e(tijden zijn onder voorbehoud)\u003c/p\u003e","links":null}},{"type":"embed","id":"f35076d4-f211-4f89-8ea3-52b208dc382a","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/ap2oXTQBSfk?si=QwcHiQFHsm6tEu4f\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}}]},"preview":false},"dataUpdateCount":596,"dataUpdatedAt":1792724783658,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-blood-red-shoes-nl","queryHash":"[\"AgendaDetail-blood-red-shoes-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"event","nid":993,"slug":"/agenda/boolin06","endpoint":"/nl/agenda/boolin06","translations":{"nl":"/agenda/boolin06","en":null},"title":"Boolin': Freddie Konings + Miggs de Bruijn + Marou","content":"\u003cp\u003e\u003cstrong\u003eWegens productionele redenen gaat Boolin’ niet door. Ticketkopers krijgen hun geld terug via Ticketmaster.\u003c/strong\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003e \u003c/p\u003e\r\n\r\n\u003cp\u003eBOOLIN’ IS BACK! Boolin’ is al enkele jaren hét concept in Eindhoven waar jij de beste NL hiphop kunt zien voor een gunstige ticketprijs. En ook dit keer is de line-up weer fire.\u003c/p\u003e\r\n","meta":{"title":"Boolin': Freddie Konings + Miggs de Bruijn + Marou","description":"BOOLIN’ IS BACK! Boolin’ is al enkele jaren hét concept in Eindhoven waar jij de beste NL hiphop kunt zien voor een gunstige ticketprijs. En ook dit keer is de line-up weer fire.","image":{"image":{"alt":"boolin sq","src":"https://d12y285rxlbnxt.cloudfront.net/2024-04/freddie%20sq.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/freddie%20sq.jpg?itok=NNm9SeSS","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/freddie%20sq.jpg?itok=keilfGbQ","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/freddie%20sq.jpg?itok=4QN8v407","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/freddie%20sq.jpg?itok=3OL33tP0","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/freddie%20sq.jpg?itok=1K5V6K52","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/freddie%20sq.jpg?itok=lDX7286M"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-04/freddie%20sq.jpg?itok=NNm9SeSS 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-04/freddie%20sq.jpg?itok=keilfGbQ 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2024-04/freddie%20sq.jpg?itok=4QN8v407 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2024-04/freddie%20sq.jpg?itok=3OL33tP0 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2024-04/freddie%20sq.jpg?itok=1K5V6K52 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2024-04/freddie%20sq.jpg?itok=lDX7286M 720w"]},"source":null,"source_link":null}},"publish_date":{"timestamp":1714654680,"machine":"2024-05-02T12:58:00+00:00"},"published":true,"sticky":false,"header_image":{"image":{"alt":"boolin header","src":"https://d12y285rxlbnxt.cloudfront.net/2024-05/Boolin%20Narrow%20-%20header.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2024-05/Boolin%20Narrow%20-%20header.jpg?itok=fUSCh4mk","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2024-05/Boolin%