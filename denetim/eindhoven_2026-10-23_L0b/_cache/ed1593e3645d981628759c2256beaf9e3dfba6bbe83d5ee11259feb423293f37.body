tate":null,"club_card_event":true,"colors":{"accent_color":"#8DA1A6","background_color":"#0D0D0D","text_color":"#FFFFFF"}},{"nid":1925,"title":"Moreish Idols","subtitle":"Britse, eigenwijze postpunk voor fans van DEADLETTER en DITZ | + Adaisy","slug":"/agenda/moreish-idols","endpoint":"/nl/agenda/moreish-idols","date":{"timestamp":1793836800,"machine":"2026-11-05"},"thumbnail_image":{"image":{"alt":"Moreish Idols square","src":"https://d12y285rxlbnxt.cloudfront.net/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=5cgVEFj9","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=CZDBa6fj","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=LmVfC_uX","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=9lROZ0UO","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=IPm4wTVU","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=P9_UJ5Pu"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=5cgVEFj9 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=CZDBa6fj 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=LmVfC_uX 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=9lROZ0UO 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=IPm4wTVU 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2026-06/%E2%80%93%20Square%20afbeelding%20only.jpg?itok=P9_UJ5Pu 720w"]},"source":null,"source_link":null},"locations":[{"id":141,"title":"Altstadt","is_external":false}],"state":null,"club_card_event":true,"colors":{"accent_color":"#285d33","background_color":"#e7f0f1","text_color":"#000000"}}],"blocks":[{"type":"paragraph","id":"4099eee7-743e-4915-a8e6-5993a31a5212","header":{"title":"Tijdschema"},"content":{"content":"\u003cp\u003e19:00 deuren open\u003cbr /\u003e\r\n19:30 SWELL\u003cbr /\u003e\r\n20:30 Two And A Half Girl\u003cbr /\u003e\r\n21:30 Scowl\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"b5bc5dcd-8b7a-4e80-9cd2-ab492ed72ec6","header":{"title":"Hardcore én grunge"},"content":{"content":"\u003cp\u003eIn 2019 debuteerde de band met hun zelfbenoemde EP\u0026nbsp;'Scowl' en sindsdien ging het hard.\u0026nbsp;Scowl\u0026nbsp;grossiert echter niet alleen in snoeiharde hardcore maar ook in\u0026nbsp;Courtney\u0026nbsp;Love-achtige grunge liedjes als 'Opening\u0026nbsp;Night'.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"paragraph","id":"2e87365c-191f-445e-ad0a-b81f562153b1","header":{"title":"Psychic Dance Routine"},"content":{"content":"\u003cp\u003eOp het nieuwe 'Psychic\u0026nbsp;Dance Routine' blijft\u0026nbsp;Scowl\u0026nbsp;de grenzen zowel op muzikaal als artistiek vlak verleggen. Of zoals de band het zegt: “it’s\u0026nbsp;like\u0026nbsp;Negative\u0026nbsp;Approach\u0026nbsp;meets\u0026nbsp;The\u0026nbsp;Breeders.”\u0026nbsp;\u003c/p\u003e\r\n","links":null}},{"type":"embed","id":"50949022-8a63-404d-9ba3-4badf97e5b85","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/vuLQhr9Y5eo\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"embed","id":"d32b75c7-ce25-49e0-9434-d4992c1991e4","header":{"title":null,"description":null},"content":{"embed":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/U__Z7ZPBKfk\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","caption":null,"cookie_message":false}},{"type":"featured_paragraph","id":"37c51d5b-8ebf-4df0-93b5-760899424e38","header":{"title":"Two And A Half Girl"},"content":{"content":"\u003cp\u003eDe support komt van het Utrechtste Two And A Half Girl. In hun muziek – een mix van emo, punk en rock – is de band niet bang om persoonlijke en gevoelige onderwerpen aan te snijden. Denk aan geestelijke gezondheid, alcohol- en drugsgebruik onder jongeren. De release van hun EP 'Prove You Wrong' (2019) werd gevierd in Paradiso en de opvolger ontving lovende kritieken van o.a. Guitarist, Musicmaker en Never Mind The Hype. \u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"Two And A Half Girl","src":"https://d12y285rxlbnxt.cloudfront.net/2023-07/Two%20And%20A%20Half%20Girl.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=xzP_Y3z0","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=binvJ-F0","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=pF7pvXWu","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=DAKfwxP1","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=UUiKo-x6","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=ono7lEIR"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=xzP_Y3z0 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=binvJ-F0 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=pF7pvXWu 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=DAKfwxP1 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=UUiKo-x6 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-07/Two%20And%20A%20Half%20Girl.jpg?itok=ono7lEIR 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}},{"type":"featured_paragraph","id":"6d3a2a64-55d8-4a54-8f74-7fac5f29db28","header":{"title":"SWELL"},"content":{"content":"\u003cp\u003eDe avond zal worden geopend door de vierkoppige hardcore band SWELL uit Tilburg. Sinds de oprichting in 2020 zijn ze bezig om hun eigen plekje in de scene te veroveren. En met debuut-EP 'Mercy Never Wanted Me' (2021), supportshows voor o.a. Sunami, One Step Closer, Dare en Magnitutde én een succesvolle Popronde in 2022 kunnen we stellen dat ze goed op weg zijn. Verwacht 'toegankelijke' hardcore met snelle riffs, zware breaks en melodische vocalen. \u0026nbsp;\u003c/p\u003e\r\n","image":{"image":{"alt":"SWELL","src":"https://d12y285rxlbnxt.cloudfront.net/2023-07/SWELL.jpg","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-07/SWELL.jpg?itok=ovJLyZ8D","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-07/SWELL.jpg?itok=ymPbcBo6","2510w":"https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-07/SWELL.jpg?itok=jyuxs8Wt","320w":"https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-07/SWELL.jpg?itok=qkAiItwT","480w":"https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-07/SWELL.jpg?itok=cYEYsTQI","720w":"https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-07/SWELL.jpg?itok=xTIps0mt"},"srcset":["https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-07/SWELL.jpg?itok=ovJLyZ8D 1400w","https://d12y285rxlbnxt.cloudfront.net/styles/1920w/s3/2023-07/SWELL.jpg?itok=ymPbcBo6 1920w","https://d12y285rxlbnxt.cloudfront.net/styles/2510w/s3/2023-07/SWELL.jpg?itok=jyuxs8Wt 2510w","https://d12y285rxlbnxt.cloudfront.net/styles/320w/s3/2023-07/SWELL.jpg?itok=qkAiItwT 320w","https://d12y285rxlbnxt.cloudfront.net/styles/480w/s3/2023-07/SWELL.jpg?itok=cYEYsTQI 480w","https://d12y285rxlbnxt.cloudfront.net/styles/720w/s3/2023-07/SWELL.jpg?itok=xTIps0mt 720w"]},"source":null,"source_link":null},"image_align":"left","links":null}}]},"preview":false},"dataUpdateCount":1,"dataUpdatedAt":1792724644257,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchMeta":null,"isFetching":false,"isInvalidated":false,"isPaused":false,"status":"success"},"queryKey":"AgendaDetail-scowl-nl","queryHash":"[\"AgendaDetail-scowl-nl\"]"},{"state":{"data":{"statusCode":200,"type":"OK","pageData":{"type":"storycard","nid":592,"slug":"/storycards/5x-eindhovense-underground-bands","endpoint":"/nl/storycards/5x-eindhovense-underground-bands","translations":{"nl":"/storycards/5x-eindhovense-underground-bands","en":null},"title":"5x Eindhovense underground bands ","content":"","meta":{"title":"5x Eindhovense underground bands ","description":"Uit de Riolen van Eindhoven is terug! Op deze avond duik je in de krochten van de underground gitaarscene en ontdek je de vijf meest veelbelovende en luidruchtige gitaarbands van Eindhoven. Met een diversiteit aan genres in de mix: van post-rock tot rock ’n roll en van lo-fi poppunk tot doom death metal. Om vervolgens af te sluiten met totale distorted techno-gekte. Maak alvast kennis met de acts.","image":{"image":{"alt":"alkahest png","src":"https://d12y285rxlbnxt.cloudfront.net/2023-06/alkahest%20png.png","sizes":{"1400w":"https://d12y285rxlbnxt.cloudfront.net/styles/1400w/s3/2023-06/alkahest%20png.png?itok=2orzi3lZ","1920w":"https://d12y285rxlbnxt.cloudfront.net/styles/192