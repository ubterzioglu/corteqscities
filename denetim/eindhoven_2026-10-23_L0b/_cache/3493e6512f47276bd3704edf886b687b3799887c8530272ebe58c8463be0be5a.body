</script><script>
	jQuery(document).ready( function() {

		jQuery(document).on("click", 'a[href="#reserveren"]', function(event) { 
			event.preventDefault(); 
			FT.widgets.get().open();
		});

		/* Header */
		jQuery(window).scrollTop(jQuery(window).scrollTop() +1);
		
		jQuery('header .mainmenu li.menu-item-has-children > a').click(function(e) {
			e.preventDefault();
			if (jQuery(this).parent().hasClass('active')) {
				jQuery(this).parent().removeClass('active');
			}
			else {
				jQuery('header .mainmenu li.menu-item-has-children.active').removeClass('active');
				jQuery(this).parent().addClass('active');
				if (jQuery('body').hasClass('home')) {
					if (jQuery(window).scrollTop() < 50) {
						jQuery(window).scrollTop(51);	
					}
				}
			}
		});
		jQuery('header .mainmenu li ul.sub-menu > li.current-menu-item a').on("click", function(event) {
			event.preventDefault();
			var href  = jQuery(this).attr('href');
			window.location.href = href;
			window.location.reload();
		});
		jQuery('.mobile_menu').on("click", function(event) {
			event.preventDefault();
			jQuery('header .mainmenu').toggleClass('active');
		});
		jQuery(window).scroll(function() {
			var scroll = jQuery(window).scrollTop();
			if (scroll >= 50) {
				jQuery("header").addClass("scrolled");
			}
			else {
				jQuery("header:not(:has(li.active)").removeClass("scrolled");
			}
		});		
		jQuery('.talenswitch_container').on("click", function(event) {
			event.preventDefault();
			jQuery(this).toggleClass('active');
		});

		setTimeout(function(){
			jQuery('rw-app-view').css('z-index', '98');
		}, 5000);

		/* Home intro */
		jQuery('body.home > .main > .wp-block-cover:first-of-type() + .lichtkrant').css('margin-top', jQuery('body.home > .main > .wp-block-cover:first-of-type()').outerHeight());
		jQuery('body.home > .main > .wp-block-cover:first-of-type()').css('position', 'fixed');
		jQuery('body.home > .main > .wp-block-cover:first-of-type()').css('left', '0');
		jQuery('body.home > .main > .wp-block-cover:first-of-type()').css('top', '0');
		jQuery('body.home > .main > .wp-block-cover:first-of-type()').css('z-index', '-1');


		/* WP Core -> Gallery */
		if (jQuery('.wp-block-gallery').length) {
			jQuery('.wp-block-gallery figure').click(function(e){
				var clickIndex = jQuery(this).index();
				e.preventDefault();
				var itemsArray = [];
				jQuery(this).parent().find('figure').each(function() {
					targetUrl = jQuery(this).find('a').attr('href');
					itemsArray.push(targetUrl);
				})
				SimpleLightbox.open({
					items: itemsArray,
					startAt: clickIndex
				}); 
			})	
		}

		/* Blok -> Bier slider */
		if(jQuery('.beer-slider').length) {
			jQuery('.beer-slider').each(function(key, item) {
				jQuery(this).slick({
					slidesToShow: 1,
					slidesToScroll: 1,
					arrows: true,
					dots: true,
					prevArrow: jQuery(this).parent().find('.beerslide-arrow-prev'),
					nextArrow: jQuery(this).parent().find('.beerslide-arrow-next'),
					appendDots: jQuery(this).parent().find('.beerslideshow-dots'),
					slide: '.beer-slide',
					fade: true,
					speed: 500,
					cssEase: 'linear',
					swipe: false,
					swipeToSlide: false
				});
			});
		}

		/* Blok -> Lichtkrant */
		if(jQuery('.lichtkrant').length) {
			gsap.to('.lichtkrant-slider', {
				xPercent: -15,
				ease: "none",
				scrollTrigger: {
					trigger: ".lichtkrant-slider",
					start: "10% bottom",
					// end: "max",
					scrub: true
				}
			});
		}


		// Blok -> Menukaart slider sectie
				
		if(jQuery('.vertical-usp-slider-container').length > 0) {
			const panels = gsap.utils.toArray(".vertical-usp-slider-container .vertical-usp-slider-item-container");
			// const contentpanels = gsap.utils.toArray(".vertical-usp-slider-container .content");

			panels.forEach((panel, i) => {
				gsap.fromTo(panel,
					{
						yPercent: 0
					},
					{
						yPercent: 0,
						ease: "power1.inOut",
						scrollTrigger: {
							trigger: panel,
							pin: true,
							scrub: 0.5,
							start: "-=128",
							end: "+=1000",
							toggleActions: 'restart none none reverse'
						}
					}
				);
				gsap.fromTo('.vertical-usp-slider-container .pin-spacer:nth-child(' + (i + 1) + ') img',
					{
						opacity: 0.2
					},
					{
						opacity: 0.8,
						ease: "none",
						scrollTrigger: {
							trigger: '.vertical-usp-slider-container .pin-spacer:nth-child(' + (i + 1) + ') img',
							start: "-200",
							end: "+=500",
							toggleActions: 'restart none none reverse'
						}
					}
				);

				gsap.fromTo('.vertical-usp-slider-container .pin-spacer:nth-child(' + (i + 1) + ') .content',
					{
						yPercent: 50
					},
					{
						yPercent: -0,
						ease: "none",
						scrollTrigger: {
							trigger: '.vertical-usp-slider-container .pin-spacer:nth-child(' + (i + 1) + ')',
							start: "0",
							end: "+=2000",
							toggleActions: 'restart none none reverse'
						}
					}
				);

				// gsap.fromTo('.vertical-usp-slider-container h2',
				// {
				// 	yPercent: 0
				// },
				// {
				// 	yPercent: 0,
				// 	scrollTrigger: {
				// 		trigger: '.vertical-usp-slider-container',
				// 		pin: true,
				// 		start: "-200"
				// 	}
				// })
			});

			// contentpanels.forEach((panel, i) => {
			// 	gsap.fromTo(
			// 		'.pin-spacer:has(.vertical-usp-slider-item-container):nth-child(' + (i + 1) + ')',
			// 		{
			// 			yPercent: 0
			// 		},
			// 		{
			// 			opacity: 1,
			// 			ease: 'none',
			// 			scrollTrigger: {
			// 				trigger: panel,
			// 				start: "-=128",
			// 				end: "+=500",
			// 				invalidateOnRefresh: true,
			// 				anticipatePin: 1
			// 			}
			// 		}
			// 	)
			// })

			gsap.ScrollTrigger.refresh();
		}

		/* Verticale USP slider */
		if(jQuery('.vertical-usp-slider').length) {

			jQuery('.vertical-usp-slider').each(function(key, item) {
				jQuery(this).find('img:first').addClass('active');

				jQuery(this).slick({
					slidesToShow: 1,
					slidesToScroll: 1,
					autoplay: false,
					autoplaySpeed: 0,
					arrows: true,
					slide: '.vertical-usp-slider-item',
					vertical: true,
					verticalSwiping: true,
					centerMode: false,
					infinite: false,
					focusOnSelect: true,
					responsive: [
					{
						breakpoint: 1000,
						settings: {
							verticalSwiping: false,
						}
					}
					]
				});

				jQuery(this).on('beforeChange', function(event, slick, currentSlide, nextSlide){
					jQuery(this).find('img').removeClass('active');
					jQuery(this).find('img').eq(nextSlide).addClass('active');
				});

				$obj = jQuery(this);
				document.addEventListener('wheel', function(e) {
					$this = $obj.find('.slick-list');
					$that = $obj.closest('.vertical-usp-slider-section');

					if (($that.offset().top - jQuery(window).scrollTop()) < 200 && ($that.offset().top - jQuery(window).scrollTop()) > 0) {
						if (e.deltaY < 0) {
							if (!$this.parent().find('.slick-prev.slick-arrow').hasClass('slick-disabled')) {
								e.preventDefault();
								$this.parent().slick('slickPrev');
							}					
						} else {
							if (!$this.parent().find('.slick-next.slick-arrow').hasClass('slick-disabled')) {
								e.preventDefault();
								$this.parent().slick('slickNext');
							}				
						}
					}
					else {
						e.returnValue = true;
					}
				}, {capture: true, passive:false});
			});
		}

		/* Template -> Menukaart archief */
		var gekozenKaart;
		var sectionIds;
		var kaartGeselecteerd = false;

		var hash;
		if ( jQuery( '.kaartkeuze' ) ) {
			hash = window.location.hash;

			if ( hash != '' ) {
				jQuery( '.kaartkeuze .titel' ).each(function( index ) {
					if ( '#'+jQuery(this).attr("data-titel") == hash ) {
						jQuery(this).addClass( 'active' );
						gekozenKaart = jQuery(this).attr("data-titel");
						jQuery('.gerechttypes.active').removeClass('active');
						jQuery('#kaart-'+gekozenKaart).addClass('active');
						kaartGeselecteerd = true;
					}
				});
			} 

			if ( kaartGeselecteerd == false ){
				jQuery( '.gerechttypes' ).first().addClass( 'active' );
				jQuery( '.kaartkeuze .titel' ).first().addClass( 'active' );
				gekozenKaart = jQuery( '.kaartkeuze .titel' ).first().attr("data-titel");
			}
			
			sectionIds = jQuery('#kaart-'+gekozenKaart+' .lijst li a');
		}
		
		jQuery( '.gerechttypes.active .lijst li' ).first().addClass( 'active' );
		jQuery( '.menukaart_item.highlighted' ).parent().addClass( 'cardhiglight' );

		jQuery( '.kaartkeuze .titel' ).click( function( event ) {
			event.preventDefault();
			gekozenKaart = jQuery(this).attr("data-titel");
			jQuery( '.kaartkeuze .titel' ).removeClass( 'active' );
			jQuery( '.gerechttypes' ).removeClass( 'active' );
			jQuery( '.lijst li' ).removeClass( 'active' );
			
			jQuery(this).addClass( 'active' );
			jQuery('#kaart-'+gekozenKaart).addClass( 'active' );
			jQuery('#kaart-'+gekozenKaart+' .lijst li').first().addClass( 'active' );			

			sectionIds = jQuery('#kaart-'+gekozenKaart+' .lijst li a');

			if ( hash != '' ) {
				window.location.hash = gekozenKaart;
			}
		});

		jQuery('ul.lijst li a').click(function(e){
			jQuery('html, body').animate({
				scrollTop: jQuery(jQuery(this).attr('href')).offset().top - 150
			}, 500);
		})

		jQuery(document).scroll(function(){
			sectionIds.each(function(){
				var container = jQuery(this).attr('href');
				var containerOffset = jQuery(container).offset().top;
				var containerHeight = jQuery(container).outerHeight();
				var containerBottom = containerOffset + containerHeight;
				var scrollPosition = jQuery(document).scrollTop();
		
				if(scrollPosition < containerBottom - 270 && scrollPosition >= containerOffset - 270 ){
					jQuery(this).parent().addClass('active');
				} else{
					jQuery(this).parent().removeClass('active');
				}
			});
		});

		jQuery( '.menukaarticon' ).hover( 
			function( event ) {
				jQuery(this).parent().siblings( ".icondescription" ).text(jQuery(this).attr("data-titel"));
			},
			function() {
				jQuery(this).parent().siblings( ".icondescription" ).text('');
			}
		);

		/* Template -> Arrangementen archief */
		if(jQuery('.post-type-archive-so_cpt_arrangement').length) {
			jQuery( ".scroll-to-content" ).on( "click", function() {
				document.querySelector('.arrangementen').scrollIntoView({
					behavior: 'smooth' 
				});
			});
		}

		/* Pop up */
		jQuery(document).on('click', '.lity-container', function(e) {
			if (e.target == this) {
				jQuery(this).find('.lity-close').click();
			}
		});
	});

		
	jQuery(document).ready(resizeFunc);
	jQuery(window).resize(resizeFunc);
	function resizeFunc() {
		var width = jQuery(window).width();
		if (width < 1430) {
			
		}
		else {
			// Responsive functies
		}
	};
</script></body>
</html>
