    <script>
    (function () {

      // ============================================================
      //  TYPOGRAPHIC AUTO-CORRECTION
      //  Code Snippets → PHP → wp_footer → Frontend only
      // ============================================================

      // ── DOPPELTE ANFÜHRUNGSZEICHEN (stateful pro Container) ─────
      function fixDoubleQuotes(text, state) {
        // Zahl + " oder ″ raussichern (Koordinaten, Maße, Bogensekunden)
        // Schützt sowohl ASCII " (U+0022) als auch Double Prime ″ (U+2033)
        var saved = [];
        text = text.replace(/\d[\u0022\u2033]/g, function(match) {
          saved.push(match);
          return '\x02';
        });

        // Alle anderen Varianten normalisieren: „ " " ‟ ″ → "
        text = text.replace(/[\u201C\u201D\u201E\u201F\u2033]/g, '"');

        // Abwechselnd öffnend " und schließend " setzen
        text = text.replace(/"/g, function () {
          var q = state.open ? '\u201C' : '\u201D';
          state.open = !state.open;
          return q;
        });

        // Gesicherte Werte exakt zurücksetzen
        text = text.replace(/\x02/g, function() { return saved.shift(); });
        return text;
      }

      // ── EINFACHE ANFÜHRUNGSZEICHEN / APOSTROPH ──────────────────
      function fixSingleQuotes(text) {
        // Zahl + ' oder ′ raussichern (Koordinaten, Fuß, Bogenminuten)
        // Schützt sowohl ASCII ' (U+0027) als auch Prime ′ (U+2032)
        var saved = [];
        text = text.replace(/\d[\u0027\u2032]/g, function(match) {
          saved.push(match);
          return '\x01';
        });

        // Normalisieren
        text = text.replace(/[\u2018\u2019\u201A]/g, "'");

        // Possessiv / Kontraktion: Wort'Wort → Wort'Wort
        text = text.replace(/(\w)'(\w)/g, '$1\u2019$2');
        // Öffnend: nach Start, Leerzeichen, Klammer auf
        text = text.replace(/(^|[\s\u00A0\(\[{<])'(?=\S)/g, '$1\u2018');
        // Schließend: vor Ende, Leerzeichen, Satzzeichen
        text = text.replace(/'(?=[\s\u00A0\)\]}>.,;:!?]|$)/g, '\u2019');
        // Übrige → schließend
        text = text.replace(/'/g, '\u2019');

        // Gesicherte Werte exakt zurücksetzen
        text = text.replace(/\x01/g, function() { return saved.shift(); });
        return text;
      }

      // ── ALLE ANDEREN KORREKTUREN ────────────────────────────────
      function fixTypo(text) {
        // Symbole
        text = text.replace(/\(c\)/gi,  '\u00A9'); // ©
        text = text.replace(/\(r\)/gi,  '\u00AE'); // ®
        text = text.replace(/\(tm\)/gi, '\u2122'); // ™

        // Brüche
        text = text.replace(/\b1\/2\b/g, '\u00BD'); // ½
        text = text.replace(/\b1\/4\b/g, '\u00BC'); // ¼
        text = text.replace(/\b3\/4\b/g, '\u00BE'); // ¾
        text = text.replace(/\b1\/3\b/g, '\u2153'); // ⅓
        text = text.replace(/\b2\/3\b/g, '\u2154'); // ⅔

        // Multiplikationszeichen nur zwischen Zahlen
        text = text.replace(/(\d)\s*[xX]\s*(\d)/g, '$1\u00D7$2');

        // Zeitspannen: 14:00-17:00 → 14:00–17:00
        text = text.replace(/(\d{1,2}:\d{2})\s*-\s*(\d{1,2}:\d{2})/g, '$1\u2013$2');
        // Zahlenbereiche: 10-15 → 10–15
        text = text.replace(/(\d+)\s*-\s*(\d+)/g, '$1\u2013$2');

        // Ellipsis
        text = text.replace(/\.{3}/g, '\u2026');

        // Gedankenstrich
        text = text.replace(/\s*\u2014\s*/g, '\u00A0\u2013 '); // — → nbsp–space
        text = text.replace(/\s*--\s*/g,     '\u00A0\u2013 '); // -- → nbsp–space

        // Leerzeichen vor Satzzeichen (EN/NL Regel)
        text = text.replace(/\s+([?!:;,.])/g, '$1');

        // Mehrfach-Leerzeichen
        text = text.replace(/[ \t]{2,}/g, ' ');

        return text;
      }

      // ── TEXT-NODE WALKER (pro Container-Element) ────────────────
      function walkNodes(root) {
        var quoteState = { open: true };

        var walker = document.createTreeWalker(
          root,
          NodeFilter.SHOW_TEXT,
          {
            acceptNode: function (node) {
              var tag = node.parentElement && node.parentElement.tagName;
              if (['SCRIPT','STYLE','CODE','PRE','INPUT',
                   'TEXTAREA','SELECT','BUTTON','A'].includes(tag)) {
                return NodeFilter.FILTER_REJECT;
              }
              return NodeFilter.FILTER_ACCEPT;
            }
          }
        );

        var node;
        while ((node = walker.nextNode())) {
          var t = node.textContent;
          t = fixTypo(t);
          t = fixDoubleQuotes(t, quoteState);
          t = fixSingleQuotes(t);
          if (t !== node.textContent) {
            node.textContent = t;
          }
        }
      }

      // ── SELEKTOREN ──────────────────────────────────────────────
      var selectors = [
        '.elementor-widget-text-editor',
        '.elementor-widget-container p',
        '.elementor-heading-title',
        '.elementor-image-caption',
        '.elementor-image-carousel-caption',
        '.elementor-widget-container h1',
        '.elementor-widget-container h2',
        '.elementor-widget-container h3',
        '.elementor-widget-container h4',
        '.elementor-widget-container h5',
        '.elementor-widget-container h6'
      ].join(', ');

      function runFix() {
        document.querySelectorAll(selectors).forEach(walkNodes);
      }

      // ── TIMING ──────────────────────────────────────────────────
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          setTimeout(runFix, 300);
        });
      } else {
        setTimeout(runFix, 300);
      }

    })();
    </script>
