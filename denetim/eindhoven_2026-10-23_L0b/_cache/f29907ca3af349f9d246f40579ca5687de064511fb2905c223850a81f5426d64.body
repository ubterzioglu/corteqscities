					<div class="ticker" id="tk">
  <div class="ticker__track">
    <span><i>Temporary Address:</i> Stadhuisplein 3, 5611 EM Eindhoven (3rd floor)</span>
    <span><i>Temporary Address:</i> Stadhuisplein 3, 5611 EM Eindhoven (3rd floor)</span>
    <span><i>Temporary Address:</i> Stadhuisplein 3, 5611 EM Eindhoven (3rd floor)</span>
    <span><i>Temporary Address:</i> Stadhuisplein 3, 5611 EM Eindhoven (3rd floor)</span>
  </div>
</div>

<style>
#tk{overflow:hidden;white-space:nowrap;width:100%;background:#000;padding:4px 0;
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;}
#tk .ticker__track{display:inline-flex;}
#tk .ticker__track span{font-family:inherit;font-size:16px;font-weight:500; letter-spacing:0.5px; color:#fff;padding:0 30px;}
#tk .ticker__track span::after{content:"•";margin-left:70px;color:#fff;opacity:.5;}
</style>

<script>
(function(){
  var box=document.getElementById('tk');
  var track=box.querySelector('.ticker__track');
  var spans=track.children;
  var speed=30; // Pixel pro Sekunde – höher = schneller
  var x=0, unit=0, last=null, paused=false;

  function measure(){
    // Breite EINES Textblocks (inkl. Padding + Bullet)
    unit=spans[0].getBoundingClientRect().width;
    // so viele Kopien, dass Balken doppelt gefüllt ist
    var need=Math.ceil((box.offsetWidth*2)/unit)+1;
    while(spans.length<need){ track.appendChild(spans[0].cloneNode(true)); }
  }
  function frame(t){
    if(last==null)last=t;
    var dt=(t-last)/1000; last=t;
    if(!paused){
      x-=speed*dt;
      if(-x>=unit){ x+=unit; } // nahtlos: um genau einen Block zurück
      track.style.transform='translateX('+Math.round(x)+'px)'; // ganze Pixel = kein Flimmern
    }
    requestAnimationFrame(frame);
  }
  box.addEventListener('mouseenter',function(){paused=true;});
  box.addEventListener('mouseleave',function(){paused=false;});
  window.addEventListener('resize',measure);
  measure();
  requestAnimationFrame(frame);
})();
</script>				</div>
