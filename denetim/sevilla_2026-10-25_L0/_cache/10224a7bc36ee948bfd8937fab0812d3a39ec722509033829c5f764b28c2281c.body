<style class="wpcode-css-snippet">@media (max-width:768px){

  /* Carrusel deslizable para Zonas y Rutas */
  .zonas-grid, .rutas-grid{
    display:flex !important;
    overflow-x:auto;
    gap:16px;
    scroll-snap-type:x mandatory;
    scroll-padding-left:16px;
    -webkit-overflow-scrolling:touch;
    padding-bottom:12px;
  }
  .zonas-grid > div, .rutas-grid > div{
    flex:0 0 80%;
    scroll-snap-align:start;
    grid-column:auto !important;
    max-width:none !important;
  }
  .zonas-grid > div:first-child,
  .rutas-grid > div:first-child{
    margin-left:16px;
  }

  /* Info: apilada en una columna */
  .info-grid{ grid-template-columns:1fr !important; }

  /* Encabezado amarillo: menos padding en móvil */
  .zonas-intro{ padding:32px 24px !important; }

  /* Interlineado de titulares en móvil */
  .seccion-titulo{ line-height:1.25 !important; }
  .card-title{ line-height:1.25 !important; }
  .orgullo-grid{ grid-template-columns:1fr !important; }
  .festivales-grid{ grid-template-columns:1fr !important; }
}</style><!-- Google Tag Manager -->
