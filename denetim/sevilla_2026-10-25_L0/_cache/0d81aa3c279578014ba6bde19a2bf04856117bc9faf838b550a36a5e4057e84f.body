<table class="irtabladatos">
  <caption>Guaranteed income amounts in 2026 Single parent unit</caption>
  <tbody>
    <tr>
      <th id="header8">Cohabitation unit: </th>

      <th id="header9">Euros/year </th>
      <th id="header10">Euros/month </th>


    </tr>

    <tr>
      <td headers="header8">One adult and one minor</td>

      <td headers="header9">13,380.84</td>
      <td headers="header10">1,115.07</td>

    </tr>
    <tr>
