<!-- Recaptcha v3 -->

<script>
  (function () {
    var SITE_KEY = '6LfkaEIsAAAAAJHrFSnG5y2RVCx2sny_7zfHRcGY';
    var form = document.querySelector('.w-form form');
    if (!form) return;

    var loaded = false;

    function loadRecaptcha(cb) {
      if (loaded) {
        cb && cb();
        return;
      }
      loaded = true;
      var s = document.createElement('script');
      s.src = 'https://www.google.com/recaptcha/api.js?render=' + SITE_KEY;
      s.onload = function () {
        cb && cb();
      };
      document.head.appendChild(s);
    }

    // Laad bij eerste focus op formulierveld
    form.addEventListener(
      'focusin',
      function () {
        loadRecaptcha();
      },
      { once: true },
    );

    // Voeg token toe bij verzenden
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('[type=submit]');
      if (btn) btn.disabled = true;

      loadRecaptcha(function () {
        grecaptcha.ready(function () {
          grecaptcha.execute(SITE_KEY, { action: 'contact' }).then(function (token) {
            var input = form.querySelector('[name="g-recaptcha-response"]');
            if (!input) {
              input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'g-recaptcha-response';
              form.appendChild(input);
            }
            input.value = token;
            if (btn) btn.disabled = false;
            form.submit();
          });
        });
      });
    });
  })();
</script>

<script>
  (function () {
    var loaded = false;
    function load() {
      if (loaded) return;
      loaded = true;
      var l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = 'https://neoseum-widget.pages.dev/widget.css';
      document.head.appendChild(l);
      var s = document.createElement('script');
      s.src = 'https://neoseum-widget.pages.dev/widget.js';
      s.defer = true;
      document.head.appendChild(s);
    }
    function schedule() {
      setTimeout(function () {
        if (window.requestIdleCallback) {
          window.requestIdleCallback(load, { timeout: 3000 });
        } else {
          load();
        }
      }, 1500);
    }
    // Deep link to the booking widget? Load it NOW instead of after the idle delay.
    var p = new URLSearchParams(location.search);
    if (p.has('book') || p.has('location')) {
      load();
    } else if (document.readyState === 'complete') {
      schedule();
    } else {
      window.addEventListener('load', schedule);
    }
  })();
</script>

<!-- ================================================================ -->
<!--  NEOSEUM — Locatiekiezer                                          -->
<!--  • Pop-up bij eerste bezoek (kies Eindhoven / Amsterdam)          -->
<!--  • Wisselen via gewone links naar / en /amsterdam (of dropdown    -->
<!--    met data-location-switch)                                      -->
<!--  • De pagina waar je op staat is altijd je actieve locatie        -->
<!--  • Slimme root-redirect voor terugkerende bezoekers               -->
<!--  Plakken in: Webflow → Site Settings → Custom Code → Footer Code  -->
<!-- ================================================================ -->

<style>
  /* Pop-up (eerste keuze) */
  #ns-popup{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;background:rgba(8,8,12,.72);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
  #ns-popup .ns-card{background:#0b0b0f;color:#fff;border:1px solid rgba(255,255,255,.10);border-radius:20px;padding:44px 40px;width:90%;max-width:440px;text-align:center;font-family:inherit;box-shadow:0 30px 80px rgba(0,0,0,.5)}
  #ns-popup h2{margin:0 0 10px;font-size:26px;font-weight:700;letter-spacing:-.01em}
  #ns-popup p{margin:0 0 28px;font-size:15px;opacity:.6}
  #ns-popup .ns-btns{display:flex;gap:12px}
  #ns-popup button{flex:1;cursor:pointer;border:0;border-radius:13px;padding:17px;font-size:16px;font-weight:600;font-family:inherit;background:#fff;color:#0b0b0f;transition:transform .15s ease,opacity .15s ease}
  #ns-popup button:hover{transform:translateY(-2px);opacity:.9}
  @media(max-width:480px){#ns-popup .ns-btns{flex-direction:column}}

  /* Dropdown (optioneel, via data-location-switch) */
  #ns-menu{position:absolute;z-index:99999;min-width:180px;background:#0b0b0f;border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:7px;display:flex;flex-direction:column;gap:2px;font-family:inherit;box-shadow:0 18px 50px rgba(0,0,0,.45)}
  #ns-menu button{cursor:pointer;border:0;background:none;color:#fff;text-align:left;padding:11px 13px;border-radius:9px;font-size:14px;font-family:inherit}
  #ns-menu button:hover{background:rgba(255,255,255,.08)}
  #ns-menu button.is-current{background:rgba(255,255,255,.14)}
</style>

<script>
(function () {
  /* ============ CONFIG — voeg hier een locatie toe ============ */
  /* Formaat:  [ id, weergavenaam, URL van de landingspagina ]    */
  var LOCATIONS = [
    ['eindhoven', 'Eindhoven', '/'],
    ['amsterdam', 'Amsterdam', '/amsterdam']
    /* , ['rotterdam', 'Rotterdam', '/rotterdam']  <-- zo voeg je er één toe */
  ];
  var STORAGE_KEY = 'neoseum_location';
  /* ============================================================ */

  /* ============ Taal / locale ============ */
  /* Locale-prefixes die Webflow gebruikt. EN heeft geen prefix, NL = /nl.
     Nieuwe taal erbij? Voeg de prefix hier toe, bijvoorbeeld '/de'. */
  var LOCALES = ['/nl'];

  function norm(p){ p = (p || '/').replace(/\/+$/, ''); return p === '' ? '/' : p; }

  var rawPath = norm(location.pathname);
  var PREFIX = '';                                  /* '' op EN, '/nl' op de NL-versie */
  for(var _i = 0; _i < LOCALES.length; _i++){
    var _lp = LOCALES[_i];
    if(rawPath === _lp || rawPath.indexOf(_lp + '/') === 0){ PREFIX = _lp; break; }
  }
  /* Huidig pad ZONDER taalprefix, zodat het met de kale config-paden vergelijkt */
  var path = norm(rawPath.slice(PREFIX.length) || '/');

  /* Bouwt de echte URL MÉT taalprefix voor een locatie (bv. /nl/amsterdam) */
  function locUrl(loc){
    var base = norm(loc[2]);
    var url = PREFIX + (base === '/' ? '' : base);
    return url === '' ? '/' : url;
  }

  function find(id){ for(var i=0;i<LOCATIONS.length;i++) if(LOCATIONS[i][0]===id) return LOCATIONS[i]; return null; }
  function findByPath(p){ for(var i=0;i<LOCATIONS.length;i++) if(norm(LOCATIONS[i][2])===p) return LOCATIONS[i]; return null; }
  function getChoice(){ try { return localStorage.getItem(STORAGE_KEY); } catch(e){ return null; } }
  function setChoice(id){ try { localStorage.setItem(STORAGE_KEY, id); } catch(e){} }

  function choose(id){
    var loc = find(id); if(!loc) return;
    setChoice(id);
    var target = norm(loc[2]);
    /* Sta je op een LOCATIEPAGINA (root = Eindhoven, /amsterdam = Amsterdam) en kies je
       een ANDERE locatie? → ga naar die landingspagina.
       Op gedeelde/inhoudspagina's (Voyage, FAQ, ...) blijf je staan en wisselt alleen de context. */
    if(findByPath(path) && target !== path){
      window.location.href = locUrl(loc);
    } else {
      var pop = document.getElementById('ns-popup'); if(pop) pop.remove();
      var menu = document.getElementById('ns-menu'); if(menu) menu.remove();
      updateLabels();
    }
  }

  function buttonsHTML(current){
    return LOCATIONS.map(function(l){
      return '<button type="button" data-ns-go="' + l[0] + '"' +
        (l[0] === current ? ' class="is-current"' : '') + '>' + l[1] + '</button>';
    }).join('');
  }

  /* ---- Pop-up bij eerste bezoek ---- */
  function openPopup(){
    if(document.getElementById('ns-popup')) return;
    var el = document.createElement('div');
    el.id = 'ns-popup';
    el.innerHTML =
      '<div class="ns-card" role="dialog" aria-modal="true" aria-label="Kies je locatie">' +
        '<h2>Kies je locatie</h2>' +
        '<p>Waar wil je NEOSEUM beleven?</p>' +
        '<div class="ns-btns">' + buttonsHTML() + '</div>' +
      '</div>';
    document.body.appendChild(el);
  }

  /* ---- Dropdown om te wisselen (optioneel) ---- */
  function toggleMenu(trigger){
    var existing = document.getElementById('ns-menu');
    if(existing){ existing.remove(); return; }
    var menu = document.createElement('div');
    menu.id = 'ns-menu';
    menu.innerHTML = buttonsHTML(getChoice());
    document.body.appendChild(menu);
    var r = trigger.getBoundingClientRect();
    menu.style.top  = (r.bottom + window.scrollY + 8) + 'px';
    menu.style.left = (r.left + window.scrollX) + 'px';
  }
  function closeMenu(){ var m = document.getElementById('ns-menu'); if(m) m.remove(); }

  /* ---- Sluit een (Webflow native) dropdown waarin het geklikte element zit ---- */
  function closeWebflowDropdown(el){
    var dd = (el && el.closest) ? el.closest('.w-dropdown') : null;
    if(!dd) return;
    var open = dd.querySelectorAll('.w--open');
    for(var i=0;i<open.length;i++) open[i].classList.remove('w--open');
    var t = dd.querySelector('.w-dropdown-toggle');
    if(t) t.setAttribute('aria-expanded', 'false');
  }

  /* ---- Welke locatie is nu actief? (locatiepagina wint, anders de keuze) ---- */
  function activeLocation(){
    if(path !== '/'){ var h = findByPath(path); if(h) return h[0]; }
    return getChoice();
  }
  function inList(attr, loc){
    return ('' + attr).split(',').map(function(s){ return s.trim(); }).indexOf(loc) > -1;
  }

  /* ---- Labels + tonen/verbergen op basis van de actieve locatie ----
     In de Designer voeg je deze custom attributes toe aan een element:
       data-location-label          → tekst wordt de stadsnaam (Eindhoven/Amsterdam)
       data-show-for="amsterdam"    → element ALLEEN tonen bij die locatie(s)
       data-hide-for="eindhoven"    → element verbergen bij die locatie(s)
     Meerdere mag, komma-gescheiden:  data-show-for="eindhoven,amsterdam"
     Op <html> komt automatisch data-location="..." te staan voor eigen CSS. */
  function updateLabels(){
    var loc = activeLocation(), i, nodes, item = find(loc);

    if(item){
      nodes = document.querySelectorAll('[data-location-label]');
      for(i=0;i<nodes.length;i++) nodes[i].textContent = item[1];
    }

    nodes = document.querySelectorAll('[data-show-for]');
    for(i=0;i<nodes.length;i++)
      nodes[i].style.display = (loc && inList(nodes[i].getAttribute('data-show-for'), loc)) ? '' : 'none';

    nodes = document.querySelectorAll('[data-hide-for]');
    for(i=0;i<nodes.length;i++)
      nodes[i].style.display = (loc && inList(nodes[i].getAttribute('data-hide-for'), loc)) ? 'none' : '';

    if(loc) document.documentElement.setAttribute('data-location', loc);
  }

  /* ---- Events ---- */
  document.addEventListener('click', function(e){
    var goBtn = e.target.closest && e.target.closest('[data-ns-go]');
    if(goBtn){
      var goId = (goBtn.getAttribute('data-ns-go') || '').trim();
      if(find(goId)){ e.preventDefault(); closeWebflowDropdown(goBtn); choose(goId); return; }
      /* onbekende/lege waarde → laat de gewone link gewoon navigeren */
    }

    var trigger = e.target.closest && e.target.closest('[data-location-switch]');
    if(trigger){ e.preventDefault(); toggleMenu(trigger); return; }

    var menu = document.getElementById('ns-menu');
    if(menu && !menu.contains(e.target)) closeMenu();
  });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeMenu(); });

  /* ---- Init ---- */
  function init(){
    /* 0) ?loc=... in de URL → keuze opslaan en de parameter weer opschonen.
          Hierdoor werken de wissel-links altijd, ook zonder data-ns-go. */
    try {
      var params = new URLSearchParams(location.search);
      var lp = (params.get('loc') || '').trim();
      if(lp && find(lp)){
        setChoice(lp);
      //  params.delete('loc');
     //   var qs = params.toString();
    //    history.replaceState(null, '', location.pathname + (qs ? ('?' + qs) : '') + location.hash);
      }
    } catch(e){}

    /* 1) Sta je op een locatiepagina (niet de root)? Dan is DÁT nu je locatie —
          ook al stond er eerder iets anders opgeslagen. De pagina wint altijd. */
    if(path !== '/'){
      var here = findByPath(path);
      if(here){ setChoice(here[0]); updateLabels(); return; }
    }

    var choice = getChoice();

    /* 2) Op de root + eerder een NIET-Eindhoven keuze → door naar die locatie */
    if(path === '/' && choice){
      var loc = find(choice);
      if(loc && norm(loc[2]) !== '/'){ window.location.href = locUrl(loc); return; }
    }

    /* 3) Al een keuze (Eindhoven, of op een gedeelde pagina) → labels bijwerken, geen pop-up */
    if(choice){ updateLabels(); return; }

    /* 4) Nog geen keuze → zichtbaarheid bijwerken en de pop-up tonen */
    updateLabels();
    openPopup();
  }

  if(document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
})();
</script>
<!-- END LOCATION PICKER-->

<!-- START BUTTON-->
<style>
.button-float{
  opacity:0;
  transform:translateY(20px);
  visibility:hidden;
  pointer-events:none;
  transition:opacity .3s ease, transform .3s ease, visibility 0s linear .3s;
}

.button-float.show{
  opacity:1;
  transform:translateY(0);
  visibility:visible;
  pointer-events:auto;
  transition:opacity .3s ease, transform .3s ease, visibility 0s;
}
</style>

<script>
window.addEventListener('scroll', () => {
  document.querySelectorAll('.button-float').forEach(btn => {
    btn.classList.toggle(
      'show',
      window.scrollY > window.innerHeight * 0.5
    );
  });
});
</script>
<!-- END BUTTON -->

<style>
  .hero-content img { height: auto; }
</style></body></html>