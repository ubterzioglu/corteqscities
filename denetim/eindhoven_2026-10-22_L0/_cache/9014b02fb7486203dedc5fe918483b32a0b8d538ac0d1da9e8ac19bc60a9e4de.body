<!--  NEOSEUM - Cookiemelding (analytisch: accepteren / weigeren)       -->
<!--  Vervangt de losse gtag.js-, gtag('config')- en GTM-snippets.      -->
<!-- ================================================================ -->

<style>
  #ns-cc{position:fixed;left:0;right:0;bottom:0;z-index:100000;display:none;background:#0b0b0f;color:#fff;border-top:1px solid rgba(214,178,94,.5);font-family:inherit;padding:14px 20px calc(14px + env(safe-area-inset-bottom))}
  #ns-cc.is-open{display:block}
  #ns-cc .ns-cc-in{max-width:1200px;margin:0 auto;display:flex;align-items:center;gap:20px}
  #ns-cc p{margin:0;flex:1;font-size:14px;line-height:1.5;color:rgba(255,255,255,.78)}
  #ns-cc a{color:#fff;text-decoration:underline}
  #ns-cc .ns-cc-btns{display:flex;gap:10px;flex:none}
  #ns-cc button{cursor:pointer;min-width:120px;padding:11px 20px;border-radius:10px;border:1px solid #d6b25e;background:transparent;color:#d6b25e;font:inherit;font-size:14px;font-weight:600}
  #ns-cc button:hover{background:rgba(214,178,94,.12)}
  #ns-cc button:focus-visible{outline:2px solid #d6b25e;outline-offset:2px}
  @media(max-width:640px){
    #ns-cc .ns-cc-in{flex-direction:column;align-items:stretch;gap:12px}
    #ns-cc .ns-cc-btns button{flex:1;min-width:0}
  }
</style>

<script>
(function () {
  /* ============ CONFIG ============ */
  var GA_ID  = 'G-DX2NGQJJ6B';
  var GTM_ID = 'GTM-PNB9X2XH';
  var KEY    = 'neoseum_consent';
  var ID_KEY = 'neoseum_consent_id';
  var VERSION = 1;                         /* verhoog als tekst of categorieen wijzigen: iedereen wordt opnieuw gevraagd */
  var MAX_AGE = 365 * 24 * 60 * 60 * 1000; /* 12 maanden */

  var TEXT = {
    nl: {
      label: 'Cookies',
      text: 'We gebruiken analytische cookies om te zien welke pagina\'s bezocht worden en om de site te verbeteren. Weigeren kan gewoon, dan blijft alles werken.',
      privacy: 'Privacybeleid',
      accept: 'Accepteren',
      decline: 'Weigeren'
    },
    en: {
      label: 'Cookies',
      text: 'We use analytics cookies to see which pages are visited and to improve the site. You can decline and everything keeps working.',
      privacy: 'Privacy policy',
      accept: 'Accept',
      decline: 'Decline'
    }
  };
  /* ================================== */

  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = window.gtag || gtag;

  /* Standaard alles geweigerd, voordat enig Google-script laadt */
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied'
  });

  /* ---- HIER komt later het vastleggen van de keuze (bijv. Supabase) ----
     Wordt na elke keuze aangeroepen met:
     { id, v, analytics, ts, lang }
     id = willekeurig anoniem toestemmings-ID, ts = tijdstip in ms.
     Overschrijf deze functie of vul haar aan. */
  window.nsConsentLog = window.nsConsentLog || function (record) {};

  function lang() {
    return /^\/nl(\/|$)/.test(location.pathname) ? 'nl' : 'en';
  }

  function read() {
    try {
      var r = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (r && r.v === VERSION && typeof r.ts === 'number' && Date.now() - r.ts < MAX_AGE) return r;
    } catch (e) {}
    return null;
  }

  function consentId() {
    try {
      var id = localStorage.getItem(ID_KEY);
      if (!id) {
        id = (window.crypto && crypto.randomUUID) ? crypto.randomUUID()
           : String(Date.now()) + '-' + Math.random().toString(16).slice(2);
        localStorage.setItem(ID_KEY, id);
      }
      return id;
    } catch (e) { return ''; }
  }

  function save(analytics) {
    var record = { id: consentId(), v: VERSION, analytics: !!analytics, ts: Date.now(), lang: lang() };
    try { localStorage.setItem(KEY, JSON.stringify(record)); } catch (e) {}
    try { window.nsConsentLog(record); } catch (e) {}
    return record;
  }

  var loaded = false;
  function loadGoogle() {
    window['ga-disable-' + GA_ID] = false;
    gtag('consent', 'update', { analytics_storage: 'granted' });
    if (loaded || window.NS_COOKIE_PREVIEW) return;
    loaded = true;

    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
    document.head.appendChild(s);
    gtag('js', new Date());
    gtag('config', GA_ID);

    (function (w, d, t, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName(t)[0], j = d.createElement(t);
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', GTM_ID);
  }

  function revoke() {
    window['ga-disable-' + GA_ID] = true;
    gtag('consent', 'update', { analytics_storage: 'denied' });
    try {
      var host = location.hostname, parts = host.split('.'), roots = [host, '.' + host];
      if (parts.length > 2) roots.push('.' + parts.slice(-2).join('.'));
      document.cookie.split(';').forEach(function (c) {
        var name = c.split('=')[0].trim();
        if (name === '_ga' || name.indexOf('_ga_') === 0 || name === '_gid') {
          roots.forEach(function (d) {
            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=' + d;
          });
          document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
        }
      });
    } catch (e) {}
  }

  function build() {
    var existing = document.getElementById('ns-cc');
    if (existing) return existing;
    var L = lang(), t = TEXT[L], privacy = (L === 'nl' ? '/nl' : '') + '/privacy';
    var el = document.createElement('div');
    el.id = 'ns-cc';
    el.setAttribute('role', 'region');
    el.setAttribute('aria-label', t.label);
    el.innerHTML =
      '<div class="ns-cc-in">' +
        '<p>' + t.text + ' <a href="' + privacy + '">' + t.privacy + '</a></p>' +
        '<div class="ns-cc-btns">' +
          '<button type="button" data-ns-cc="accept">' + t.accept + '</button>' +
          '<button type="button" data-ns-cc="decline">' + t.decline + '</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(el);
    el.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-ns-cc]');
      if (!b) return;
      choose(b.getAttribute('data-ns-cc') === 'accept');
    });
    return el;
  }

  function open()  { build().classList.add('is-open'); }
  function close() { var el = document.getElementById('ns-cc'); if (el) el.classList.remove('is-open'); }

  function choose(analytics) {
    save(analytics);
    close();
    if (analytics) loadGoogle(); else revoke();
  }

  /* Eerder akkoord? Dan meteen laden, zonder de balk te tonen */
  var rec = read();
  if (rec && rec.analytics) loadGoogle();

  function init() {
    if (!read()) open();
    /* Link "Cookie-instellingen": geef een element in de footer het attribuut data-cookie-settings */
    document.addEventListener('click', function (e) {
      var s = e.target.closest && e.target.closest('[data-cookie-settings]');
      if (s) { e.preventDefault(); open(); }
    });
  }
  window.nsCookieSettings = open;

  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
})();
</script>
<!-- EINDE COOKIEMELDING -->

<!-- ================================================================ -->
<!--  NEOSEUM — Locatie: flikkervrij tonen/verbergen                   -->
<!--  Plakken in: Webflow → Site Settings → Custom Code → HEAD Code    -->
<!--  Werkt samen met het footer-script (locatiekiezer).              -->
<!-- ================================================================ -->

<style>
  /* Verberg locatie-specifieke elementen vóór de eerste paint → geen flits, geen verschuiving */
  html:not([data-location]) [data-loc]{display:none !important}
  html[data-location="eindhoven"] [data-loc]:not([data-loc~="eindhoven"]){display:none !important}
  html[data-location="amsterdam"] [data-loc]:not([data-loc~="amsterdam"]){display:none !important}
  /* Nieuwe locatie erbij? Voeg hier één regel toe, bijvoorbeeld:
     html[data-location="rotterdam"] [data-loc]:not([data-loc~="rotterdam"]){display:none !important} */
</style>

<script>
  (function () {
    try {
      var LOCALES = ['/nl'];                       /* EN heeft geen prefix, NL = /nl */
      var raw = (location.pathname || '/').replace(/\/+$/, '') || '/';
      var prefix = '';
      for (var i = 0; i < LOCALES.length; i++) {
        if (raw === LOCALES[i] || raw.indexOf(LOCALES[i] + '/') === 0) { prefix = LOCALES[i]; break; }
      }
      var path = raw.slice(prefix.length) || '/';   /* pad zonder taalprefix */
      /* Locatiepagina's → die locatie wint. Voeg nieuwe pagina's hier toe. */
      var PAGES = { '/': 'eindhoven', '/amsterdam': 'amsterdam' };
      var loc = PAGES[path] || localStorage.getItem('neoseum_location');
      if (loc) document.documentElement.setAttribute('data-location', loc);
    } catch (e) {}
  })();
</script>
<!--- EINDE LOCATIE PICKER --->

<!-- Google tag en GTM worden nu geladen door de cookiemelding hierboven, pas na toestemming -->

<style>
  html {
    font-size: clamp(14px, 0.4vw + 14px, 18px);
  }
</style>

<script>
(function () {
  var pending = null;
  function onEarlyClick(e) {
    if (window.__neoseumWidgetReady) return;            // widget live — let its own handler run
    var el = e.target instanceof Element && e.target.closest('.open-booking');
    if (!el) return;
    e.preventDefault();
    pending = el;
    el.setAttribute('aria-busy', 'true');               // optional: visual "loading" hint
  }
  document.addEventListener('click', onEarlyClick, true); // capture phase, runs first
  window.__neoseumOnReady = function () {
    window.__neoseumWidgetReady = true;
    document.removeEventListener('click', onEarlyClick, true);
    if (pending) { pending.removeAttribute('aria-busy'); pending.click(); pending = null; }
  };
})();
</script>

<style>
  .nav-link.w--current {
    color: #d6b25e;
  }
</style>

<script>
  (function () {
    const MODAL_ID = 'thankyou-modal';
    const CLOSE_ID = 'thankyou-close';
    const AUTO_CLOSE_MS = 4000; // 4 seconds

    function openModal() {
      const modal = document.getElementById(MODAL_ID);
      if (!modal) return;

      modal.style.display = 'flex';

      window.clearTimeout(window.__tyTimeout);
      window.__tyTimeout = window.setTimeout(closeModal, AUTO_CLOSE_MS);
    }

    function closeModal() {
      const modal = document.getElementById(MODAL_ID);
      if (!modal) return;
      modal.style.display = 'none';
    }

    // Close on X click + overlay click
    document.addEventListener('click', function (e) {
      const modal = document.getElementById(MODAL_ID);
      if (!modal || modal.style.display === 'none') return;

      if (e.target.id === CLOSE_ID) closeModal();
      if (e.target.id === MODAL_ID) closeModal();
    });

    // When Webflow shows success message (.w-form-done), open modal
    const observer = new MutationObserver(() => {
      const done = document.querySelector('.w-form-done');
      if (done && done.style.display !== 'none') openModal();
    });

    observer.observe(document.documentElement, {
      childList: true,
      subtree: true,
    });
  })();
</script>

<script>
  (function () {
    var h = document.head;
    function L(rel, url, opts) {
      var l = document.createElement('link');
      l.rel = rel;
      l.href = url;
      if (opts) {
        for (var k in opts) {
          if (opts[k] != null) l[k] = opts[k];
        }
      }
      h.appendChild(l);
    }
//    L('preconnect', 'https://neoseum-widget.pages.dev', { crossOrigin: 'anonymous' });
//    L('preconnect', 'https://qaqskfvvfjewmfmkdchq.supabase.co');
  })();
</script>

