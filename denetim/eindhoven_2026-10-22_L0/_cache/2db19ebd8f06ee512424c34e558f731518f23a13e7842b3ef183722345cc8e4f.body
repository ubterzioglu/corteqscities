jven/inschrijfvergoeding/?_hn:type=component-rendering\u0026_hn:ref=r22\u0026refPrefix=%23","type":"external"}},"meta":{"definitionId":"hst:pages/informationDetail","params":{}},"name":"informationDetail","type":"component","componentClass":"org.kvk.components.ModelContributionComponent","children":[{"$ref":"#u213d68fd530d45d7bbdfa0153885b9c5"},{"$ref":"#u551ecde92ee14e56a6cf1b159d80ed26"},{"$ref":"#u872ca460490a482e852a3596a1c8439a"}],"models":{"content_sdg":false,"translations":{"en":"/en/registration/registration-fee/","nl":"/inschrijven/inschrijfvergoeding/"},"skipLinkLabels":{"skipToContent":"Direct naar de content"},"menuLabels":{"accountabilityMenu":"Links verantwoording website","mainMenu":"Hoofdmenu","aboutKVK":"Links over KVK","whenLoggedIn":"Ingelogd","title":"Ga naar de homepagina van kvk.nl","languageSwitchLabel":"English","close":"Sluiten","open":"Menu"},"locale":"nl","otherLabels":{"shareOnX":"Deel via X (opent nieuw venster)","shareOnWhatsApp":"Deel via WhatsApp (opent WhatsApp)","closeNotification":"Sluit notificatie","shareUsingEmail":"Deel via email (opent email programma)","share":"Delen","shareOnLinkedIn":"Deel via LinkedIn (opent nieuw venster)"}}},"ue87d53ad689e4b8192ef7536ce86cb6e":{"type":"document","links":{"site":{"href":"/inschrijven/inschrijfvergoeding/","type":"internal"}},"meta":{},"data":{"name":"inschrijfvergoeding","displayName":"Inschrijfvergoeding","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Inschrijfvergoeding","seodescription":"Voor de inschrijving van een nieuwe onderneming of organisatie in het Handelsregister betaal je een eenmalige inschrijfvergoeding.","seonoindex":false,"contentType":"seosupport:seo"},"contentBlocks":[{"contentType":"hippostd:html","value":"\u003cp\u003eJe betaalt inschrijfvergoeding bij:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003ede eerste inschrijving van een onderneming of organisatie in het Handelsregister;\u003c/li\u003e\n \u003cli\u003eeen voortzetting, overname, splitsing of fusie waarbij een nieuwe inschrijving in het Handelsregister ontstaat met een nieuw KVK-nummer.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003eDe kosten voor de inschrijfvergoeding worden jaarlijks aangepast. De aanpassing is afhankelijk van de inflatie.\u0026#160;\u003c/p\u003e\n\n\u003ch2\u003eUittreksel Handelsregister nodig?\u003c/h2\u003e\n\n\u003cp\u003eAls je bij je inschrijving van je bedrijf een \u003ca rel=\"noopener noreferrer\" href=\"https://www.kvk.nl/producten-bestellen/uittreksel-handelsregister-kamer-van-koophandel/\" class=\"external-link\" target=\"_blank\"\u003euittreksel uit het Handelsregister\u003c/a\u003e nodig hebt, dan heb je de keuze uit een papier gewaarmerkt of een digitaal gewaarmerkt uittreksel. Sommige banken vragen om een uittreksel uit het Handelsregister, net als de meeste groothandels. Controleer voordat je een uittreksel bestelt of een digitale versie geaccepteerd wordt.\u003c/p\u003e\n\n\u003ch2\u003eHoe ontvang ik de rekening?\u003c/h2\u003e\n\n\u003cp\u003eHoe je de factuur krijgt, hangt af van hoe je je inschrijft:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003e\u003cstrong\u003eInschrijving op een KVK-kantoor\u003c/strong\u003e\u003cbr /\u003e\n Je krijgt de factuur via e-mail op het e-mailadres dat je vooraf hebt doorgegeven. De afzender is: factuur@kvk.nl.\u003c/li\u003e\n \u003cli\u003e\u003cstrong\u003eInschrijving via de notaris\u003c/strong\u003e\u003cbr /\u003e\n Je krijgt de factuur via e-mail of via post; dit hangt af van de gegevens die de notaris bij de inschrijving doorgeeft.\u003c/li\u003e\n \u003cli\u003e\u003cstrong\u003eInschrijving via een formulier (post)\u003c/strong\u003e\u003cbr /\u003e\n Je krijgt de factuur via post.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch3\u003eGoed om te weten\u003c/h3\u003e\n\n\u003cp\u003eHet e-mailadres waar je je KVK-facturen op krijgt hoeft niet hetzelfde te zijn als het zakelijke e-mailadres dat in het Handelsregister staat. Het e-mailadres waar je je KVK-facturen op krijgt, gebruiken we alleen voor deze facturen en komt niet in het \u003ca class=\"anchor-target\" href=\"/over-het-handelsregister/geregistreerd-in-het-handelsregister/\" data-type=\"internal\"\u003eHandelsregister\u003c/a\u003e te staan. Je kunt dit e-mailadres later ook aanpassen via het betaalportaal.\u003c/p\u003e"}],"chatbotSettings":{"name":"kvkwebsite:chatbotSettings","displayName":"kvkwebsite:chatbotSettings","showProactiveChatbot":false,"contentType":"kvkwebsite:chatbotSettings"},"teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","image":{"$ref":"#u77e2f167e5cc4b9ca2c25e3a23b37312"},"title":"Inschrijfvergoeding","description":"Voor de inschrijving van een nieuwe onderneming of organisatie in het Handelsregister betaal je een eenmalige inschrijfvergoeding.","contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"intro":"Voor de inschrijving van een nieuwe onderneming of organisatie in het Handelsregister betaal je een eenmalige inschrijfvergoeding van € 85,15. Deze inschrijfvergoeding is voor ondernemers fiscaal aftrekbaar.","metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"editorialPublicationDateWithDefault":1472940000000,"editorialModificationDate":1781169300000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"readingTime":1,"contentType":"kvkwebsite:metadata","editorialPublicationDate":1472940000000,"mostRecentChangeDate":1781169300000,"phase":[],"theme":[],"transaction":[{"name":"selection:listitem","displayName":"selection:listitem","key":"1","label":"Inschrijven","contentType":"selection:listitem","id":"0bce0e5f-945b-49b7-8583-82e0e92f143f"}],"organization":[],"subject":[],"sector":[],"audience":[],"articleType":null,"author":[],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","key":"x","label":"X","contentType":"selection:listitem","id":"0b36e318-5b34-418a-a6ef-6ffbc1a7cd10"}],"lawOpenGovernment":[null]},"title":"Inschrijfvergoeding","primaryDocumentInRequest":true,"localeString":"nl","contentType":"kvkwebsite:informationDocument","systemCreationDate":1678111025286,"systemModificationDate":1781255286561,"systemPublicationDate":1781255292148,"id":"e87d53ad-689e-4b81-92ef-7536ce86cb6e"}},"u213d68fd530d45d7bbdfa0153885b9c5":{"id":"r22_r1","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/inschrijven/inschrijfvergoeding/?_hn:type=component-rendering\u0026_hn:ref=r22_r1\u0026refPrefix=%23","type":"external"}},"meta":{"params":{}},"name":"main","type":"component","componentClass":"org.hippoecm.hst.core.component.GenericHstComponent","children":[{"$ref":"#u02e2cd91238c4a20ba64f0747c726115"}]},"u551ecde92ee14e56a6cf1b159d80ed26":{"id":"r22_r2","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/inschrijven/inschrijfvergoeding/?_hn:type=component-rendering\u0026_hn:ref=r22_r2\u0026refPrefix=%23","type":"external"}},"meta":{"params":{}},"name":"header","type":"component","componentClass":"org.hippoecm.hst.core.component.GenericHstComponent","children":[{"$ref":"#uc3543dc304fc49a394b15711db80e66f"},{"$ref":"#u0517ab1a064646f29c80ed294fb291b3"}]},"u872ca460490a482e852a3596a1c8439a":{"id":"r22_r3","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/inschrijven/inschrijfvergoeding/?_hn:type=component-rendering\u0026_hn:ref=r22_r3\u0026refPrefix=%23","type":"external"}},"meta":{"params":{}},"name":"footer","type":"component","componentClass":"org.hippoecm.hst.core.component.GenericHstComponent","children":[{"$ref":"#u3e9f5985ac7c4ed18c92e3cbe37933e2"},{"$ref":"#ue1d0f6fb522846b499a672e31c11fb54"},{"$ref":"#u55c0ef38140f46928cf8caf70983879a"},{"$ref":"#u488bdbb7f95249759434b3b93e15b2ee"},{"$ref":"#u