<h1 class="ind-hero__heading ind-heading ind-heading--h1 ind-heading--theme:inverse" data-component-id="ind2:heading" data-component-variant="h1">
      Travelling with a residence permit and a return visa
  </h1>

  
  </div>

</section>


        
    
    




<section class="ind:not-has-[.ind-alert]:hidden ind-section ind-section--theme:messages" data-component-id="ind2:section">
      
                



<div data-component-id="ind2:container" class="ind-container">
                          



<div data-component-id="ind2:stack" class="ind-stack ind-stack--gap:sm">
                    <div class="ind:not-has-[.ind-alert]:hidden">
          <div data-sitewide-alert data-sitewide-alert-type="notification"></div>
        </div>

        <div data-drupal-messages-fallback class="hidden"></div>
          
  </div>

    
          
  </div>

      </section>

  

  
  
      




<section data-component-id="ind2:section" class="ind-section">
      
                



<div data-component-id="ind2:container" class="ind-container">
                        


<div data-component-id="ind2:grid" data-component-variant="layout-side" class="ind-grid ind-grid--variant:layout-side">
          <div class="ind-content ind-flow ind-grid__item--area:content">
                    




<nav class="ind:mbe-6 ind:md:hidden ind-table-of-content" data-component-id="ind2:table-of-content" aria-labelledby="table-of-content-heading">
  
  




