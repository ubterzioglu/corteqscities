    <script>
        function ResetCaptcha(e) {
            var d = new Date();
            $("." + e + " #captcha-image").attr("src", "/Mission/GetCaptcha?" + d.getTime() + "/");
            $("." + e + " #security").val("");
            $("." + e + " #CaptchaText").val(""); 
        }

        $(document).ready(function () {  
            $("#btnNewApplication").click(function() {
