            data-image-source="dam"
            data-link-container='no'
            data-link-url=''
            data-omniture=''> <div class="p-gc13v2-positioning"> <picture><source srcset="/c-dam/corporate/philips-museum/Bezoek/museum-cafe/iconcafe-gallery-1.jpg" media="(min-width: 961px)"></source><source srcset="/c-dam/corporate/philips-museum/Bezoek/museum-cafe/iconcafe-gallery-1.jpg" media="(min-width: 701px)"></source><source srcset="/c-dam/corporate/philips-museum/Bezoek/museum-cafe/iconcafe-gallery-1.jpg" media="(min-width: 451px)"></source><source srcset="/c-dam/corporate/philips-museum/Bezoek/museum-cafe/iconcafe-gallery-1.jpg" media=""></source><img src="/c-dam/corporate/philips-museum/Bezoek/museum-cafe/iconcafe-gallery-1.jpg" alt="philips_museum_cafe" title="" loading="lazy" class=""></picture> </div> </section> </div> </div> </section> </div> </div> </li> </ul> </nav> <div class="p-tab-content-container-side"></div> <div class="p-tab-content-container-top"></div> </section> </div> </div> </section> </div> </div> <div class="p-grid-item 
                                           
                                           
                                             p-l-one-whole p-m-one-whole p-s-one-whole p-xs-one-whole
