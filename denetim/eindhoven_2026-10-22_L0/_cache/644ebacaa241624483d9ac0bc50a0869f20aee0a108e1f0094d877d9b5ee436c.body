        data-is-internal="true"> <div class="p-vertical-positioning p-text-container  p-valign-top"> <div class="p-text-container-inner"> <h2><span class="p-heading-03">Entry price reductions</span></h2> <p class="p-body-text p-text-smaller
                        p-l-col1 p-m-col1
                        p-s-col1 p-xs-col1"> <span><div> &nbsp; </div> <ul class="p-bullets"> <li><span class="p-body-copy-02">Philips employees + 1 guest free of charge with Philips badge</span></li> <li><span class="p-body-copy-02">Members of the Philips Verenigingen van Gepensioneerden&nbsp;€ 5,50 (with a proof of membership)</span></li> </ul></span> </p> </div> </div> </section> </div> </div> </section> </div> </div> </div> </div> </section> </div> <div class="gc04v3-gridcontainer component-base section"> <section class="p-gc04v3-gridcontainer   p-full-bleed  p-l-cell-margin-c  p-m-cell-margin-c  p-s-cell-margin-b  p-xs-cell-margin-b 
                         
                                           
                                           
                                            
