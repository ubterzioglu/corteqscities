        data-comp-id="gc11v3Generictext"
        data-containerlink='{"useLink":"no",
                "url":"",
                "navdest":"",
                "target":"_self",
                "omniture":""}'
        data-is-internal="true"> <div class="p-vertical-positioning p-text-container  p-valign-top"> <div class="p-text-container-inner"> <h2><span class="p-heading-03">Entry prices</span></h2> <p class="p-body-text p-text-smaller
                        p-l-col1 p-m-col1
                        p-s-col1 p-xs-col1"> <span><p>&nbsp;</p> <ul class="p-bullets"> <li><span class="p-body-copy-02">Adults: € 13,50 (including audio tour)</span></li> <li><span class="p-body-copy-02">Museum Card: free admission*</span></li> <li><span class="p-body-copy-02">Children up to 3 years: free of charge</span></li> <li><span class="p-body-copy-02">Children 4-17 years € 7,- (including Torch Light treasure hunt)</span></li> <li><span class="p-body-copy-02">Students with valid college card € 7,-</span></li> <li><span class="p-body-copy-02">CJP card holders €7,-</span></li> <li><span class="p-body-copy-02">Tuesday 15.30 - 17.00 hrs free admission, with the exception of all national school holidays as well as groups consisting of 10 or more persons. Check the <a href="https://www.rijksoverheid.nl/onderwerpen/schoolvakanties" data-track-description="Rijksoverheid" data-track-type="track-conversion" data-track-name="interaction" data-track-compid="gc11" class="p-gc11v3-inlinelink">Rijksoverheid</a> website for school holiday dates.</span></li> <li><span class="p-body-copy-02">An audio tour is free with your entrance ticket. We have audio tours available in Dutch, Dutch in easy language (NT2), English, German, French, Turkish, Spanish and Italian.</span><br> </li> </ul> <p><span class="p-body-copy-02">&nbsp;</span></p> <p><span class="p-body-copy-02"><em>*The Philips Museum is no point of sale for the Museum Card.<br> **<br> </em></span></p></span> </p> </div> </div> </section> </div> <div class="gc11v3-generictext component-base section"> <section
        class="p-gc11v3-generictext p-valign-parent
               
            p-row-gutter p-comp-spacing-bottom  p-l-spacing-top-c p-m-spacing-top-c p-s-spacing-top-b p-xs-spacing-top-b"
        id="gc11v3-1e11MGIDLC1kMPua"
        data-comp-id="gc11v3Generictext"
        data-containerlink='{"useLink":"no",
