                        p-s-col1 p-xs-col1"> <span><p>&nbsp;</p> <p><span class="p-body-copy-02">Simply buy your ticket to the Philips Museum online or at our desk.</span></p> <p><span class="p-body-copy-02"><em>Please note: the e-tickets are only valid on the day and within the time slot stated on the ticket. Exchanging e-tickets for cash or another ticket is not possible.</em></span></p> <p>&nbsp;</p></span> </p> </div> </div> </section> </div> <div class="gc15-linkbutton component-base section"> <div class="p-gc15-link-button  p-row-gutter p-comp-spacing-bottom  p-l-spacing-top-c p-m-spacing-top-c p-s-spacing-top-b p-xs-spacing-top-b" data-is-internal="true" data-crm-enabled="no" data-comp-id="gc15LinkButton"> <!--googleoff: anchor--> <a href="https://webshopphilipsmuseum.recreatex.be/Exhibitions/Overview?language=EN" class="p-cta-link  p-l-icon-pos-left p-m-icon-pos-left p-s-icon-pos-left p-xs-icon-pos-left pv-button   gc15-linkbutton-component p-gc15-anchor-link " target="_blank" title="Order now (opens in a new window)" rel="noopener" data-track-type="track-conversion" data-track-name="interaction" data-track-description="button:order_now:button" data-track-compid="gc15" data-fullscreen-slide="none" data-btn-alignment='{"l":"left",
