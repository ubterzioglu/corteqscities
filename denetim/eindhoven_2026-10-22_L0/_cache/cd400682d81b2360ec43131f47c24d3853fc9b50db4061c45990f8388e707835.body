a, a:link, a:focus, a:active, a:visited {
	text-decoration: none;
}

.wp-block-post-content {
	margin-block-start: 0 !important;
}

footer {
	margin-block-start: 0 !important;
}

.wp-block-navigation {
	word-break: keep-all;
}

.wp-block-navigation__responsive-container.is-menu-open {
	padding: 25px !important;
}

.wp-block-navigation a:where(:not(.wp-element-button)):hover {
	text-decoration: none;
}

.wp-block-navigation a:where(:not(.wp-element-button)):focus {
	text-decoration: none;
}

.wp-block-navigation a:where(:not(.wp-element-button)) {
	text-decoration: none;
}

.wp-block-post-content a:where(:not(.wp-element-button)) {
	color: #000 !important;
}

.tribe-events-widget-events-list__event-date-tag {
	background-color: var(--wp--preset--color--primary);
	color: #fff;
	padding-bottom: 5px !important;
}	

.tribe-events-widget-events-list__event-date-tag-month, .tribe-events-widget-events-list__event-date-tag-daynum, .tribe-events-widget-events-list__event-details {
	font-size: unset;
}

.tribe-events-widget-events-list__event-header {
	padding-left: 20px !important;
}

.tribe-events-widget-events-list__view-more-link {
	display: none;
}

.tribe-events-calendar-month__multiday-event-bar-inner {
	background-color: #fff !important;
}

.tribe-events-l-container {
	padding-top: 30px !important;
}

.tribe-events-c-subscribe-dropdown__container {
	display: none !important;
}

h3.tribe-events-widget-events-list__event-title {
	font-size: unset;
	font-weight: 600;
}

.tribe-events-calendar-list__event-date-tag-datetime {
  background-color: var(--wp--preset--color--primary);
}

.tribe-events-calendar-list__event-date-tag-weekday, .tribe-events-calendar-list__event-date-tag-daynum {
	color: #fff !important;	
}

.tribe-events-calendar-list__event-title-link {
	font-size: 1.1rem;
}

.tribe-events-calendar-list__event-header, .tribe-events-calendar-list__event-description {
	padding-left: 10px !important;
}

.sponsorimage {
	max-width: 150px !important;
	min-width: 100px !important;
}

.link-white a {
	color: #fff !important;
}

.wpforms-form button[type=submit] {
    background-color: var(--wp--preset--color--primary) !important;
}
:root :where(.wp-block-navigation){font-size: var(--wp--preset--font-size--small);}
:root :where(.wp-block-navigation a:where(:not(.wp-element-button))){text-decoration: none;}
:root :where(.wp-block-navigation a:where(:not(.wp-element-button)):hover){text-decoration: underline;}
:root :where(.wp-block-navigation a:where(:not(.wp-element-button)):focus){text-decoration: underline dashed;}
:root :where(.wp-block-navigation a:where(:not(.wp-element-button)):active){text-decoration: none;}
:root :where(.wp-block-post-content a:where(:not(.wp-element-button))){color: var(--wp--preset--color--secondary);}
