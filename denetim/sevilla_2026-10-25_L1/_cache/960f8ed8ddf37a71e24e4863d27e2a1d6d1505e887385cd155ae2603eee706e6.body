{
Liferay.component('infoItemActionComponent', new ComponentModule({"executeInfoItemActionURL":"https:\/\/sede.mjusticia.gob.es\/c\/portal\/execute_info_item_action?p_l_mode=view&plid=126","namespace":"","spritemap":"https:\/\/sede.mjusticia.gob.es\/o\/sedeage-theme\/images\/clay\/icons.svg"}), { destroyOnNavigate: true, portletId: ''});
