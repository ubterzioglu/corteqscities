<div class="contenedor_central_izq marginbottom35px mt-0" id="push-avisos-widget">
    <div class="push-avisos-panel">
		<div class="push-avisos-heading-row">
            <div class="push-avisos-heading titulo">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                     viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/>
                </svg>
                Suscripción a avisos&nbsp;&ndash;&nbsp;Campiña sevillana</div>
            <button id="push-avisos-get-token-btn" type="button"
                    class="push-avisos-btn-secondary"
                    data-label-inactive="Activar notificaciones"
                    data-label-active="Desactivar notificaciones"
                    data-title-inactive="Activar notificaciones push para avisos meteorológicos"
                    data-title-active="Desactivar notificaciones push de avisos meteorológicos"
                    aria-label="Activar notificaciones push para avisos meteorológicos"
                    title="Activar notificaciones push para avisos meteorológicos">
                Activar notificaciones</button>
        </div>

        <p class="push-avisos-info">
            Reciba notificaciones push cuando AEMET emita avisos para la zona Campiña sevillana. Necesita activar los permisos de notificaciones en su navegador.</p>

        <div id="push-avisos-form-wrap" class="push-avisos-form-wrap push-avisos-hidden" aria-hidden="true">
            <div class="push-avisos-form">
                <div class="push-avisos-field">
                    <label class="push-avisos-label"
                          for="push-avisos-nivel-toggle">Nivel de aviso</label>
                    <div id="push-avisos-nivel" class="push-avisos-nivel-multiselect">
                        <button id="push-avisos-nivel-toggle"
                                type="button"
                                class="push-avisos-select push-avisos-multiselect-toggle"
                                data-default-label="Seleccione al menos una opción"
                                aria-expanded="false"
                                aria-controls="push-avisos-nivel-menu"
                                aria-label="Abrir selector de nivel de aviso"
                                title="Abrir selector de nivel de aviso">
                            Seleccione al menos una opción</button>
                        <div id="push-avisos-nivel-menu"
                             class="push-avisos-multiselect-menu push-avisos-hidden"
                             aria-hidden="true">
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-nivel-opt" value="3" /> Peligro bajo - Avisos amarillos</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-nivel-opt" value="2" /> Peligro importante - Avisos naranjas</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-nivel-opt" value="1" /> Peligro extraordinario - Avisos rojos</label>
                        </div>
                    </div>
                </div>

                <div class="push-avisos-field">
                    <label class="push-avisos-label"
                          for="push-avisos-fenom-toggle">Fenómeno</label>
                    <div id="push-avisos-fenom" class="push-avisos-fenom-multiselect">
                        <button id="push-avisos-fenom-toggle"
                                type="button"
                            class="push-avisos-select push-avisos-multiselect-toggle"
                                data-default-label="Seleccione al menos una opción"
                                aria-expanded="false"
                                aria-controls="push-avisos-fenom-menu"
                                aria-label="Abrir selector de fenómeno"
                                title="Abrir selector de fenómeno">
                            Seleccione al menos una opción</button>
                        <div id="push-avisos-fenom-menu"
                             class="push-avisos-multiselect-menu push-avisos-hidden"
                             aria-hidden="true">
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="todo" /> Todos los fenómenos</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="al" /> Aludes</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="co" /> Costeros</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="dh" /> Deshielos</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="ga" /> Galernas</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="pr" /> Lluvias</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="ne" /> Nevadas</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="ni" /> Nieblas</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="vs" /> Polvo en suspensión</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="ri" /> Rissagas</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="at" /> Temperaturas máximas</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="bt" /> Temperaturas mínimas</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="to" /> Tormentas</label>
                            <label class="push-avisos-multiselect-option"><input type="checkbox" name="push-avisos-fenom-opt" value="vi" /> Viento</label>
                        </div>
                    </div>
                </div>

                <div class="push-avisos-field">
                    <label class="push-avisos-label"
                           for="push-avisos-horas">Antelación (h)</label>
                    <input type="number"
                           id="push-avisos-horas"
                           class="push-avisos-input-horas"
                           min="1" max="24" step="1" value="1"
                           aria-label="Horas de antelación, entre 1 y 24" />
                </div>

            </div>
            <div>
	            <div class="push-avisos-field push-avisos-field-check">
	                <label class="push-avisos-label-check"
	                       for="push-avisos-avisar-fin">
	                    <input type="checkbox"
	                           id="push-avisos-avisar-fin"
	                           aria-label="Recibir notificación cuando el aviso finalice" />
	                    Avisar del fin del aviso</label>
	            </div>
	            <div class="push-avisos-actions">
	                <button id="push-avisos-apply-all-btn"
	                        type="button"
	                        class="push-avisos-btn-secondary mt-0 mr-0"
	                        disabled
	                        aria-label="Aplicar configuración actual a todas las zonas suscritas"
	                        title="Aplicar configuración actual a todas las zonas suscritas">
	                    Aplicar a zonas suscritas</button>
	            </div>
            </div>
        </div>

        <div id="push-avisos-msg" class="push-avisos-msg" hidden role="alert" aria-live="polite"></div>

        <div id="push-avisos-topics-section" class="push-avisos-topics-section push-avisos-hidden" aria-hidden="true">
            <h4 class="push-avisos-topics-title">Suscripciones activas</h4>
            <div id="push-avisos-config-summary" class="push-avisos-config-summary push-avisos-hidden"></div>
            <div class="push-avisos-zone-action">
                <button id="push-avisos-subscribe-btn"
                        type="button"
                        class="push-avisos-btn-light m-0"
                        disabled>
                </button>
            </div>
            <ul id="push-avisos-topics-list" class="push-avisos-topics-list mt-1"
                aria-label="Lista de suscripciones de avisos activas"></ul>
        </div>
    </div>
</div>

