                  <input type="radio" name="p" onclick="this.form.submit()" id="lab7120250725" value="20250725" checked="checked"/>
                  <label for="lab7120250725" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 25/07/2025, en vigor a partir del 26/07/2025.</strong></label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab7120150923" value="20150923"/>
                  <label for="lab7120150923" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 23/09/2015, en vigor a partir del 01/01/2016.</label>
                </p>
              </fieldset>
