              <input type="hidden" name="id" value="BOE-A-2007-4184">
              <input type="hidden" name="b"  value="22">
              <input type="hidden" name="tn" value="1">
              <fieldset class="gris redondeada">
                <legend class="fuera">Seleccionar redacci&oacute;n:</legend>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab2220111126" value="20111126" checked="checked"/>
                  <label for="lab2220111126" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 26/11/2011, en vigor a partir del 27/11/2011.</strong></label>
                </p>
