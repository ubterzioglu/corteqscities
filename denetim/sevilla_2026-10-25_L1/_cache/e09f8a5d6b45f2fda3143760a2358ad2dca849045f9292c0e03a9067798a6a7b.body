   <script type="text/javascript">//<![CDATA[
(function() {
    function addEditWarning() {
        // Detecta si la URL es privada (ajusta el patrón según tu entorno)
        var isPrivate = window.location.href.toLowerCase().indexOf("edicionportal") !== -1;
 
        if (isPrivate) {
            // Crear el contenedor dinámicamente
            var container = document.createElement('div');
            container.className = 'edit-warning-container';
            container.style.backgroundColor = 'red';
            container.style.padding = '15px';
 
            // Contenido interno del aviso
            container.innerHTML = `
                <div style="font-size: 30px; text-align: center; color: white; margin-bottom: 10px;">
                    <strong>AVISO.</strong>
                </div>
                <div style="font-size: 18px; text-align: center; color: white;">
                    <strong>
                        Desde el Ministerio de la Presidencia, Justicia y Relaciones con las Cortes se ha impulsado la traducción a lenguas cooficiales de parte del contenido del Portal Institucional.
                        Debido a ello, y para evitar que se modifique contenido que esté en proceso de traducción, se comunica que cualquier modificación de contenido del Portal, salvo en lo referente a
                        Empleo Público, Noticias del Gabinete de Prensa y Subastas de la ORGA, queda congelada hasta nuevo aviso. Muchas gracias y disculpen las molestias.
                    </strong>
                </div>
            `;
 
            // Insertar al inicio del body
            document.body.insertBefore(container, document.body.firstChild);
        }
    }
 
    // Ejecuta cuando el DOM esté listo
    if (document.readyState !== 'loading') {
        addEditWarning();
    } else {
        document.addEventListener('DOMContentLoaded', addEditWarning);
    }
 
    // Re-ejecuta tras postbacks parciales (SharePoint clásico)
    try {
        if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(addEditWarning);
        }
    } catch (e) { /* Ignorar si no aplica */ }
})();
//]]></script>
        
