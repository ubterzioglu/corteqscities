              <div class="container-xxl">
        <div class="page-nw-preguntas-respuestas-wrapper">
          <div class="col-md-12">
            
<div class="faqs-wrapper">
  
  <div class="paragraph-preguntas-respuestas-allitems">
    <div class="preguntas-respuestas-top-buttons d-flex justify-content-end">
        <div class="preguntas-respuestas-buttons1 d-flex">
          

          <a class="preguntas-respuestas-link1 btn btn-outline"
            data-open-text="Mostrar detalle"
            data-close-text="Cerrar detalle">
