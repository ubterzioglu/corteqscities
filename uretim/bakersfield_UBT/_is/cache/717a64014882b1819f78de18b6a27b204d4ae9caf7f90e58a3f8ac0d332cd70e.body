<div role="main">
    <figure aria-label="Full Width Banner" class="clearfix  vi-fullwidth-banner flexslider" id="widget_4395_12718_8540" tabindex="0"><ul class="vi-banner-slides slides clearfix"><li class="vi-banner-item"><img class="vi-banner-img" alt="General" src="/home/showpublishedimage/13104/638430877319030000" /></li>

</ul></figure>
</div>

<script>
        $(function ($) {
            var widgetID = "#widget_4395_12718_8540";
            let anchorElement = $(widgetID + '.flexslider .flex-direction-nav li a');
            let anchorElementPausePlay = $(widgetID + '.flexslider div.flex-pauseplay');
            let anchorElementPausePlayIcon = $(widgetID + '.flexslider div.flex-pauseplay a');
            anchorElement.off('keydown');
            anchorElement.off('keyup');
            anchorElement.attr('href', 'javascript:void(0)').attr('role', 'button');
            anchorElementPausePlay.attr('tabindex', '0');
            anchorElementPausePlayIcon.attr('role', 'button');
            anchorElement.bind('keydown click', function (e) {
                if (e.which === 13) {
                    if (e.target.className.includes("flex-prev")) {
                        $(widgetID + '.flexslider').flexslider('prev');
                        setTabIndexesForVisibleSlidesBanner(widgetID);
                    }
                    else if (e.target.className.includes("flex-next")) {
                        $(widgetID + '.flexslider').flexslider('next');
                        setTabIndexesForVisibleSlidesBanner(widgetID);
                    }
                }
                if (e.type === "click") {
                    setTabIndexesForVisibleSlidesBanner(widgetID);
                }
            });
            anchorElementPausePlay.on('keydown click', function (e) {
                if (e.which === 13) {
                    setTabIndexesForVisibleSlidesBanner(widgetID);
                    var slider = $(widgetID + '.flexslider');
                    if (anchorElementPausePlay.children().hasClass("flex-play")) {
                        slider.flexslider('play');
                        $(widgetID + ' .vi-banner-item').find(".vi-banner-img, .vi-banner-title-link, .vi-banner-desc-link ").attr("tabindex", -1);
                    }
                    else {
                        slider.flexslider('pause');
                    }
                }
                if (e.type === "click") {
                    if ($(widgetID + ' .flex-pause').length) {
                        $(widgetID + ' .vi-banner-item').find(".vi-banner-img, .vi-banner-title-link, .vi-banner-desc-link ").attr("tabindex", -1);
                    }
                    else {
                        setTabIndexesForVisibleSlidesBanner(widgetID);
                    }

                }
            });

            let controlElement = $(widgetID + ".flexslider .flex-control-nav");
            controlElement.attr("role", "tablist");
            controlElement.find("li").attr("tabindex", 0).attr("role", "tab");
            controlElement.each(function (e) {
                $(this).find('a:first').attr('aria-label', 'Move to ' + ($(this).text()));
            });

            controlElement.find('li').on('keydown click', function (ev) {
                if (ev.which === 13) {
                    let tabSlide = parseInt($(this).find('a').first().text(), 10);
                    if (!isNaN(tabSlide)) {
                        $(widgetID + '.flexslider').flexslider(tabSlide - 1);
                        setTabIndexesForVisibleSlidesBanner(widgetID);
                    }
                }
                else if (ev.which === 39) { //right
                    $(widgetID + '.flexslider').flexslider('next');
                    setTabIndexesForVisibleSlidesBanner(widgetID);
                }
                else if (ev.which === 37) { //left
                    $(widgetID + '.flexslider').flexslider('prev');
                    setTabIndexesForVisibleSlidesBanner(widgetID);
                }
                if (ev.type === "click") {
                    setTabIndexesForVisibleSlidesBanner(widgetID);
                }
            });
            if ($(widgetID + ' .flex-pause').length) {
                $(widgetID + ' .vi-banner-item').find(".vi-banner-img, .vi-banner-title-link, .vi-banner-desc-link ").attr("tabindex", -1);
            }
        });
    $('#widget_4395_12718_8540' + '.vi-fullwidth-banner.flexslider').on('focus', function (e) {
        $(this).attr('aria-hidden', 'true')
    })
    $('#widget_4395_12718_8540' + '.vi-fullwidth-banner.flexslider').on('blur', function () {
        $(this).removeAttr('aria-hidden');
    });

    function setTabIndexesForVisibleSlidesBanner(widgetID) {
        $(widgetID + " .vi-banner-item").each(function (index) {
            // Check if the slide is visible
            var isVisible = $(this).hasClass('flex-active-slide');
            // If the slide is not visible, set tabindex to -1 for the image and its content
            if (!isVisible) {
                $(this).find(".vi-banner-img, .vi-banner-title-link, .vi-banner-desc-link ").attr("tabindex", -1);
            }
            else {
                $(this).find(".vi-banner-img, .vi-banner-title-link, .vi-banner-desc-link ").removeAttr("tabindex", -1);
            }
        });
    }
</script>

                
