    <script type="text/javascript">
        function OptanonWrapper() {
            let pgeActiveGroups = window.OnetrustActiveGroups || "";
            const pgeCookieCategoryString = "C0002,C0003,C0004";
            const cookieCategory = pgeCookieCategoryString.split(',').map(item => item.trim());
            const isCookieCategoryPresent = cookieCategory.every(category => pgeActiveGroups.includes(category));      
            if (isCookieCategoryPresent) {
                var pgeScriptTag = document.createElement('script');
                pgeScriptTag.type = "text/javascript";
                pgeScriptTag.src = "//assets.adobedtm.com/066d2b523dbe/358ed22ff8f3/launch-86a50ae8f133.min.js";
                const pgeHeadElement = document.head;
                if (pgeHeadElement) {
                    pgeHeadElement.appendChild(pgeScriptTag);
                }
            }           
         }
    </script>
    
    
    
