<div data-cmp-data-layer="{&#34;text-2060f55c47&#34;:{&#34;@type&#34;:&#34;/apps/pge/components/core/text&#34;,&#34;repo:modifyDate&#34;:&#34;2023-10-24T17:45:55Z&#34;,&#34;xdm:text&#34;:&#34;&lt;h3>Frequently asked questions&lt;/h3>\r\n&lt;p>Find answers to commonly asked questions about service guarantees.&lt;/p>\r\n&#34;}}" id="text-2060f55c47" class="cmp-text">
    <h3>Frequently asked questions</h3>
<p>Find answers to commonly asked questions about service guarantees.</p>

</div>

    

</div>
         <div class="show-hide-links">
