<div class="cmp-teaser__content">
 
 
     


    <h2 class="cmp-teaser__title">
        Community Choice Aggregation (CCA)
    </h2>

  
 

	
    	
	
	
	
	



<div class="cmp-teaser__description"><ul><li>PG&amp;E partners with each CCA in our service area to deliver electricity through our transmission and distribution system. </li><li>We handle service requests for each of our CCA partners.</li></ul>
</div>
 




<div class="cmp-teaser__action-container">


	
		
		
			<a href="/en/account/alternate-energy-providers/community-choice-aggregation.html" class="cmp-teaser__action-link">Learn more about CCA 
	         	 
	    	</a>
		
		
	







    </div>

</div>
</div>

    

</div>
<div class="card-feature-tile-informational aem-GridColumn aem-GridColumn--default--12">
    <div class="column-tiles-wrapper column-tiles--informational">
        <div class="column-tiles__title-description">
            <h2 class="column-tiles__title">More about PG&amp;E services</h2>
            
        </div>
        <div class="column-tiles__col-wrapper">
            
                <div class="column-tiles__column">
                    <div class="column-tiles__item">
                        <div class="column-tiles__item-title">
                            <h3 class="column-tiles__item-heading">Connect all digital services in one stop</h3>
                        </div>
                        <div class="column-tiles__item-text"><ul><li><p>Compare TV, Internet, phone and security providers.</p>
</li></ul>
<ul><li><p>Find rates, rebates and information all in one place.</p>
</li></ul>
</div>
                        
                            
                                
                                    <div class="button button--link-primary">
                                        <a class="cmp-button" href="/en/save-energy-and-money/energy-usage-and-tips/residential-energy-savings-tips.html" target="_self">
                                             <!-- <i data-sly-test="/content/pge/language-masters/en/save-energy-and-money/energy-usage-and-tips/residential-energy-savings-tips.html" class="icon icon--arrow-right" aria-hidden="true">
                              </i> -->
                                            <span class="cmp-button__text">Connect your home services</span>
                                            
											<i class="icon icon--arrow-right sb-icon sb-icon--arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                
                            
                        
                        
                        
                    </div>
                </div>
            
                <div class="column-tiles__column">
                    <div class="column-tiles__item">
                        <div class="column-tiles__item-title">
                            <h3 class="column-tiles__item-heading">Mobile home park bill services</h3>
                        </div>
                        <div class="column-tiles__item-text"><p>Are you a mobile home park owner with a PG&amp;E-owned master meter? You can sign up for our Bill Calculation Service.</p>
</div>
                        
                            
                                
                                    <div class="button button--link-primary">
                                        <a class="cmp-button" href="/en/account/manage-my-account/mobile-home-park.html" target="_self">
                                             <!-- <i data-sly-test="/content/pge/language-masters/en/account/manage-my-account/mobile-home-park.html" class="icon icon--arrow-right" aria-hidden="true">
                              </i> -->
                                            <span class="cmp-button__text">Explore mobile home park bill services</span>
                                            
