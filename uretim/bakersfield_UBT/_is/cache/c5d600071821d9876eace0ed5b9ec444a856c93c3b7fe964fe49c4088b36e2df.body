<script id="elementor-pro-frontend-js" src="https://meadowsfield.com/wp-content/plugins/elementor-pro/assets/js/frontend.min.js?ver=4.3.2"></script>
<script id="pro-elements-handlers-js" src="https://meadowsfield.com/wp-content/plugins/elementor-pro/assets/js/elements-handlers.min.js?ver=4.3.2"></script>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Fix header nav - set unique aria-label on the actual nav element
    const headerNav = document.querySelector('header .elementor-nav-menu--main');
    if (headerNav) {
        headerNav.setAttribute('aria-label', 'Primary navigation');
    }
    
    // Fix footer nav - set unique aria-label on the actual nav element
    const footerNav = document.querySelector('footer .elementor-nav-menu--main');
    if (footerNav) {
        footerNav.setAttribute('aria-label', 'Footer navigation');
    }
    
    // Remove invalid aria-label from nav menu wrapper divs
    const navWidgets = document.querySelectorAll('.elementor-widget-nav-menu[aria-label]');
    navWidgets.forEach(function(widget) {
        widget.removeAttribute('aria-label');
    });
    
    // Remove invalid aria-label from accordion wrapper divs
    const accordions = document.querySelectorAll('.e-n-accordion[aria-label]');
    accordions.forEach(function(accordion) {
        accordion.removeAttribute('aria-label');
    });
    
    // Fix Monsido cookie consent buttons - add accessible names
    function fixMonsidoButtons() {
        const buttons = document.querySelectorAll('.mon-cb-button-el');
        buttons.forEach(function(btn) {
            if (!btn.getAttribute('aria-label')) {
                if (btn.classList.contains('primary')) {
                    btn.setAttribute('aria-label', 'Accept cookies');
                } else if (btn.classList.contains('link')) {
                    btn.setAttribute('aria-label', 'Cookie settings');
                }
            }
        });
    }
    
    fixMonsidoButtons();
    setTimeout(fixMonsidoButtons, 1000);
    setTimeout(fixMonsidoButtons, 2500);
    
    const observer = new MutationObserver(fixMonsidoButtons);
    observer.observe(document.body, { childList: true, subtree: true });
});
</script>

</body>
</html>
