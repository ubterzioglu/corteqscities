			<script id="notification-banner-preboot">
	(function () {
		var tray = document.getElementById( 'custom-notification-tray' );
		if ( ! tray ) { return; }

		var body = document.body;
		var now  = Date.now();

		// Drop banners this visitor has already dismissed, before anything paints.
		Array.prototype.forEach.call( tray.querySelectorAll( '.site-banner' ), function ( banner ) {
			var id = banner.getAttribute( 'data-alert-id' );
			var dismissed = false;

			try {
				if ( banner.classList.contains( 'js-banner-once' ) ) {
					dismissed = !! window.localStorage.getItem( 'alert_dismissed_' + id );
				} else if ( banner.classList.contains( 'js-banner-weekly' ) ) {
					var muteUntil = parseInt( window.localStorage.getItem( 'alert_mute_' + id ), 10 );
					dismissed = muteUntil && now < muteUntil;
				}
			} catch ( e ) {}

			if ( dismissed ) { banner.parentNode.removeChild( banner ); }
		} );

		if ( ! tray.querySelector( '.site-banner' ) ) {
			tray.parentNode.removeChild( tray );
			body.classList.remove( 'has-notification-banner' );
			return;
		}

