<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Google Consent Mode v2 — must load BEFORE any gtag/Clarity script -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}

    // Read stored consent (if any) — cookie is scoped to .blvdbakersfield.com (see js/consent.js)
    var _blvdConsent = null;
    try {
      var m = document.cookie.match(/(?:^|;\s*)blvd_consent=([^;]+)/);
      if (m) _blvdConsent = JSON.parse(decodeURIComponent(m[1]));
    } catch(e) {}

    // GPC signal — auto-reject ad/marketing consent if browser sends it
    var _gpc = (typeof navigator !== 'undefined' && navigator.globalPrivacyControl === true);

    // Consent model: US opt-out, matching blvdsac.com and booking.blvdbakersfield.com.
    // Advertising and analytics start granted and the visitor can opt out via the
    // banner or the preferences modal.
    //
    // These pages used to hardcode 'denied'. Because blvdbakersfield.com is where
    // every Google Ads click lands, ad_storage was denied at the very first hop, no
    // _gcl_aw cookie was written, and the gclid was already gone by the time the
    // visitor reached the booking app. Only 8 of 115 bookings taken since the
    // Bakersfield campaigns launched carried any click id.
    //
    // A previously stored choice is applied as the DEFAULT rather than only as a
    // later update, so a visitor who already opted out is never briefly treated as
    // granted during the wait_for_update window. GPC always forces denied.
    var _hasChoice   = !!_blvdConsent;
    var _marketingOK = _hasChoice ? (!!_blvdConsent.marketing && !_gpc) : !_gpc;
    var _analyticsOK = _hasChoice ? !!_blvdConsent.analytics : true;

    var _adDefault        = _marketingOK ? 'granted' : 'denied';
    var _analyticsDefault = _analyticsOK ? 'granted' : 'denied';

    gtag('consent', 'default', {
      'ad_storage': _adDefault,
      'ad_user_data': _adDefault,
      'ad_personalization': _adDefault,
      'analytics_storage': _analyticsDefault,
      'functionality_storage': 'granted',
      'security_storage': 'granted',
      'wait_for_update': 500
    });

    // The consent state actually in force right now, whether it came from a stored
    // choice or from the defaults above. Downstream loaders gate on this instead of
    // _blvdConsentApplied, which is only ever set when a cookie already exists and
    // so left every first-time visitor untracked.
    window._blvdConsentEffective = {
      'ad_storage': _adDefault,
      'ad_user_data': _adDefault,
      'ad_personalization': _adDefault,
      'analytics_storage': _analyticsDefault
    };

    // If user already made a choice previously, apply it now (respect GPC override)
    if (_blvdConsent) {
      var _update = {
        'ad_storage': _blvdConsent.marketing && !_gpc ? 'granted' : 'denied',
        'ad_user_data': _blvdConsent.marketing && !_gpc ? 'granted' : 'denied',
        'ad_personalization': _blvdConsent.marketing && !_gpc ? 'granted' : 'denied',
        'analytics_storage': _blvdConsent.analytics ? 'granted' : 'denied'
      };
      gtag('consent', 'update', _update);
      window._blvdConsentApplied = _update;
    }
    window._blvdGPC = _gpc;
  </script>
  <!-- End Google Consent Mode v2 defaults -->
  <!-- Google tag (gtag.js) — Google Ads + GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-16712270444"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    // Cross-domain linker: preserve gclid when a visitor moves from
    // blvdbakersfield.com to booking.blvdbakersfield.com. Without it the
    // gclid is lost at the subdomain boundary and the booking conversion
    // cannot be attributed back to the ad click.
    gtag('config', 'AW-16712270444', {
      'linker': {
        'domains': ['blvdbakersfield.com', 'booking.blvdbakersfield.com', 'reservations.meriq.com', 'secure.meriq.com'],
        'accept_incoming': true
      }
    });
    gtag('config', 'G-P8SWQE8XTE', {
      'linker': {
        'domains': ['blvdbakersfield.com', 'booking.blvdbakersfield.com', 'reservations.meriq.com', 'secure.meriq.com'],
        'accept_incoming': true
      }
    });
  </script>
  <!-- End Google tag -->
  <!-- Microsoft Clarity heatmaps & session recordings — gated on analytics consent -->
  <script type="text/javascript">
    window.blvdLoadClarity = function() {
      if (window._blvdClarityLoaded) return;
      window._blvdClarityLoaded = true;
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xnex93nmmf");
    };
    // If user previously granted analytics consent (and GPC/DNT are not set), load Clarity now.
    (function () {
      try {
        var dnt = (typeof navigator !== "undefined" && (navigator.doNotTrack === "1" || window.doNotTrack === "1"));
        if (dnt) return;
      } catch (e) {}
      if (window._blvdConsentEffective && window._blvdConsentEffective.analytics_storage === 'granted') {
        window.blvdLoadClarity();
      }
    })();
  </script>
  <!-- End Microsoft Clarity -->
  <title>Contact &amp; Info | The BLVD! Bakersfield</title>
  <meta name="description" content="Visit The BLVD! Bakersfield at 3200 Buck Owens Blvd, Bakersfield. Hours, directions, parking, and contact info.">
  
  <link rel="canonical" href="https://blvdbakersfield.com/contact/">

  <meta property="og:title" content="Contact &amp; Info | The BLVD! Bakersfield">
  <meta property="og:description" content="Visit The BLVD! Bakersfield at 3200 Buck Owens Blvd, Bakersfield. Hours, directions, parking, and contact info.">
  <meta property="og:image" content="https://blvdbakersfield.com/images/heroes/contact.jpg">
  <meta property="og:url" content="https://blvdbakersfield.com/contact/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="The BLVD! Bakersfield">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Contact &amp; Info | The BLVD! Bakersfield">
  <meta name="twitter:description" content="Visit The BLVD! Bakersfield at 3200 Buck Owens Blvd, Bakersfield. Hours, directions, parking, and contact info.">
  <meta name="twitter:image" content="https://blvdbakersfield.com/images/heroes/contact.jpg">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">

<link rel="icon" type="image/png" href="images/blvd-logo.png">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div id="site-header" data-active="contact"></div>

  <main>
    <section class="hero-page" data-focal="contain" style="background-image:url('images/heroes/contact.jpg');" aria-label="Contact hero">
      <div class="hero-page-content">
        <h1>Contact &amp; Info</h1>
        <p>Plan your visit, find us on the map, or drop us a line.</p>
      </div>
    </section>

    <!-- Address + map -->
    <section class="section">
      <div class="container">
        <div class="fade-in" style="display:grid;grid-template-columns:1fr 1.2fr;gap:2rem;align-items:start;">
          <div>
            <span class="section-label">Visit Us</span>
            <h2 style="font-size:clamp(1.5rem,1rem+1.5vw,2rem);margin-bottom:1.25rem;">3200 Buck Owens Blvd</h2>
            <p style="color:var(--blvd-gray-light);margin-bottom:1.25rem;">Bakersfield, CA 93308<br>Just minutes from Downtown Bakersfield with easy freeway access. Free on-site parking.</p>
            <p style="margin-bottom:0.5rem;">📞 <a href="tel:6618734477" style="color:#fff;font-weight:700;">661-873-4477</a></p>
            <p style="margin-bottom:1.5rem;">✉️ <a href="mailto:sales@blvdbakersfield.com" style="color:#fff;font-weight:700;">sales@blvdbakersfield.com</a></p>

            <h3 style="font-size:1.05rem;margin-bottom:0.6rem;">Hours</h3>
            <div style="font-size:0.9375rem;color:var(--blvd-gray-light);">
              <div style="display:flex;justify-content:space-between;padding:0.55rem 0;border-bottom:1px solid var(--blvd-border);"><span>Sunday – Thursday</span><span style="color:#fff;font-weight:700;">11am – 9pm</span></div>
              <div style="display:flex;justify-content:space-between;padding:0.55rem 0;border-bottom:1px solid var(--blvd-border);"><span>Friday – Saturday</span><span style="color:#fff;font-weight:700;">11am – 12am</span></div>
            </div>
          </div>
          <div class="map-container" style="height:100%;min-height:380px;">
            <iframe src="https://www.google.com/maps?q=3200+Buck+Owens+Blvd+Bakersfield+CA+93308&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="The BLVD! Bakersfield location map" style="height:100%;min-height:380px;"></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- Get connected -->
    <section class="section" style="background:var(--blvd-charcoal);">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">Stay Connected</span>
          <h2>Get <span class="text-green">Connected</span></h2>
          <p>Follow us on social and never miss a happening.</p>
        </div>

        <div class="fade-in" style="max-width:980px;margin:0 auto;">
          <div class="card">
            <h3 style="font-size:1.15rem;margin-bottom:0.75rem;">Follow Us</h3>
            <p style="color:var(--blvd-gray-light);font-size:0.95rem;margin-bottom:1rem;">@blvdbakersfield on Instagram · @blvdbakersfield on TikTok · The BLVD! Bakersfield on Facebook.</p>
            <div class="social-links" style="margin-top:0;">
              <a href="https://www.facebook.com/p/The-BLVD-West-Bakersfield-61568727740168/" target="_blank" rel="noopener" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
              <a href="https://www.instagram.com/blvdbakersfield/" target="_blank" rel="noopener" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></a>
              <a href="https://www.tiktok.com/@blvdbakersfield" target="_blank" rel="noopener" aria-label="TikTok"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Today's Happenings cross-promo -->
    <section class="section">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">Don't Miss</span>
          <h2>Today's <span class="text-green">Happenings</span></h2>
        </div>
        <div class="card fade-in" style="max-width:760px;margin:0 auto;text-align:center;">
          <p style="color:var(--blvd-gray-light);margin-bottom:1.25rem;">From Bites &amp; Strikes Mondays to Throwback &amp; Throwdown Thursdays — every day has something. See what's on tonight.</p>
          <a class='btn btn-green btn-sm' href='/#happenings'>See All Happenings</a>
        </div>
      </div>
    </section>

  </main>

  <div id="site-footer"></div>
  <script src="js/components.js"></script>
  <script src="js/main.js"></script>
  <script src="js/consent.js"></script>
  <script src="js/attribution.js"></script>
  <script src="js/conversions.js"></script>
</body>
</html>
