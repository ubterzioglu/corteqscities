    flex:0 0 50%;
    position:relative;
    overflow:hidden;
}
.slick-initialized .slick-slide{
    width:50%;
    padding-bottom:11.25%;
    background-size:cover;
    background-position:center;
}
.slideshow-sportfile-slideshow .slick-prev{
    position:absolute;
    top:calc(50% - 15px);
    left:12px;
    font-size:0;
    border:none;
    background:transparent;
}
.slideshow-sportfile-slideshow .slick-prev:after{
    content: '\e835';
    font-family: "sidearm_font";
    text-align: center;
    font-size:30px;
    color:#fff;
    text-shadow:0 0 12px rgba(0,0,0,.5);
}
.slideshow-sportfile-slideshow .slick-next{
    position:absolute;
    top:calc(50% - 15px);
    right:12px;
    font-size:0;
    border:none;
    background:transparent;
}
.slideshow-sportfile-slideshow .slick-next:after{
    content: '\e836';
    font-family: "sidearm_font";
    text-align: center;
