<script>
//simple addition by Russ to add consent banner link into footer - updated by Adrian to account for Termly installs.
(function () {
  var poweredByFirstAnchor = document.querySelector('.poweredBy a:first-child');
  if (!poweredByFirstAnchor) return;

  if (window.Termly) {
    var termlySpan = document.createElement('span');
    termlySpan.className = 'termly-display-preferences';
    termlySpan.textContent = 'Manage Consent Preferences';
    poweredByFirstAnchor.insertAdjacentElement('afterend', termlySpan);
  } else {
    var spSpan = document.createElement('span');
    spSpan.id = 'spConsentWrapper';
    poweredByFirstAnchor.insertAdjacentElement('afterend', spSpan);
    window.localStorage.setItem('__springtime__repop__target', '#spConsentWrapper');
  }
})();
</script>
<style>
  #spConsentWrapper:before,
  .poweredBy .termly-display-preferences:before { content: " | " }
  .poweredBy .termly-display-preferences { cursor: pointer; }
</style>
<script>
if (window.location.search.indexOf('preview') > 0) {
  window.localStorage.setItem('ae_user_consent_decision_has_been_made', true);
  var spEl = document.getElementById('spConsentWrapper');
  if (spEl) spEl.remove();
}
</script><!--  End Product Custom HTML Markup -->
