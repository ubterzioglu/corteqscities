    <script>
        jQuery(function () {

            // Header accordian animations
            $("h3").click(function () {

                if ($("#" + $(this).attr("id") + "_box").hasClass("shown")) {

                    // Animate the box
                    $("#" + $(this).attr("id") + "_box").slideUp().removeClass("shown");

                    // Animate the chevron
                    $(this).find(".accordianChevron").animate(

                        { deg: 0 },
                        {
                            duration: 400,
                            step: function (now) {
                                $(this).css({ "transform": "rotate(" + now + "deg)" });
                                $(this).css({ "-webkit-transform": "rotate(" + now + "deg)" });
                                $(this).css({ "-ms-transform": "rotate(" + now + "deg)" });
                            }
                        }
                    );
                }
                else {

                    $("#" + $(this).attr("id") + "_box").slideDown().addClass("shown");
                    $(this).find(".accordianChevron").animate(

                        { deg: 90 },
                        {
                            duration: 400,
                            step: function (now) {
                                $(this).css({ "transform": "rotate(" + now + "deg)" });
                                $(this).css({ "-webkit-transform": "rotate(" + now + "deg)" });
                                $(this).css({ "-ms-transform": "rotate(" + now + "deg)" });
                            }
                        }
                    );
                } 
            });

            // Layer 1 Accordian animations
            $(".accordianLayer1").click(function () {

                event.preventDefault();
