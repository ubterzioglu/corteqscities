2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg></div><h4 class="text-body font-bold">Tons of Attractions!</h4></div><blockquote class="text-body-sm leading-relaxed text-muted-foreground">Trampolines, foam pits, bounce houses, dodgeball, basketball, arcades, this place has a ton to keep the kids busy. The staff was amazing to work with and our kids had a blast!</blockquote><figcaption class="mt-auto pt-2 font-bold"><span aria-hidden="true">—</span>Janice B.</figcaption></figure></li></ul></section><section class="container-page section-y"><div class="flex flex-col gap-3 items-center text-center"><h2 class="display section-heading-glow text-blue max-w-3xl">Action Packed Fun</h2></div><div class="mt-10 grid items-center gap-10 lg:grid-cols-2"><img alt="" loading="lazy" width="960" height="720" decoding="async" data-nimg="1" class="h-auto w-full object-cover rounded-lg" style="color:transparent" sizes="(min-width: 1024px) 50vw, 100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ftl0ypvfn%2Fproduction%2Ff76d31283e8b06cd74c9b4e2bec981e20e547f28-2560x1707.jpg%3Frect%3D142%2C0%2C2276%2C1707%26w%3D960%26h%3D720%26fit%3Dcrop&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ftl0ypvfn%2Fproduction%2Ff76d31283e8b06cd74c9b4e2bec981e20e547f28-2560x1707.jpg%3Frect%3D142%2C0%2C2276%2C1707%26w%3D960%26h%3D720%26fit%3Dcrop&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ftl0ypvfn%2Fproduction%2Ff76d31283e8b06cd74c9b4e2bec981e20e547f28-2560x1707.jpg%3Frect%3D142%2C0%2C2276%2C1707%26w%3D960%26h%3D720%26fit%3Dcrop&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ftl0ypvfn%2Fproduction%2Ff76d312