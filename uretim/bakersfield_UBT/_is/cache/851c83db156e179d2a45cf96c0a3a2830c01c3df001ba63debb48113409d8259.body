g\":\"Everything you need for an epic day at {name}\",\"adventureLead\":\"Jump in for open play, lock in a membership for unlimited fun, or book the best birthday ever — pick how you want to play below.\",\"waiverLead\":\"Save time at the door — every jumper needs a signed waiver.\",\"signTheWaiver\":\"Sign the waiver\",\"perJumperTaxNote\":\"per jumper · taxes may apply at checkout\",\"pricePerJumper\":\"Price per jumper\",\"pricePerJumperMinimum\":\"Price per jumper ({count} jumper minimum)\",\"jumperMinimum\":\"{count} jumper minimum\",\"minimumJumpers\":\"Minimum {count} jumpers\",\"upgrade\":\"Upgrade\",\"standard\":\"Standard\",\"upgradeRow\":\"{label} upgrade\",\"upgradeNote\":\"{label} upgrade +{delta}/jumper\",\"perJumperDelta\":\"+{delta}/jumper\",\"partyPackageComparison\":\"Party package comparison\",\"choosePartyTitle\":\"Choose your {tier} party\",\"howPartyWorks\":\"How your party works\",\"close\":\"Close\",\"partyGuideDescription\":\"A step-by-step guide to your party, from the pre-party checklist to the day-of timeline.\",\"partySpaceName\":\"{unit, select, room {Private Room} other {Party {label}}}\",\"jumperPackage\":\"{count}-jumper package\",\"perAdditionalJumper\":\"+{price} per additional jumper\",\"pricingAtCheckout\":\"Pricing available at checkout\",\"playNow\":\"Play now\",\"yourPass\":\"your pass\",\"membership\":\"Membership\",\"memberships\":\"Memberships\",\"singleUsePasses\":\"Single Use Passes\",\"parties\":\"Parties\",\"waysToPlayTitle\":\"Ways to Play\",\"waysToPlayFallbackIntro\":\"Single visits, memberships, parties and more — however your crew likes to play, today's prices and tickets are just a tap away.\",\"waysToPlayComparison\":\"Ways to play comparison\",\"unitTable\":\"Table\",\"unitRoom\":\"Room\",\"unitBay\":\"Bay\"},\"MembershipUpsell\":{\"eyebrow\":\"Did you know?\",\"title\":\"Make it a Membership\",\"body\":\"A {{membership}} Membership is about the same price as the {{pass}} you’ve selected, and it gets you into the park FREE for the next 30 days. Convert your tickets to a Membership?\",\"bodySavings\":\"{{membership}} Memberships are just {{membershipPrice}} each, and every member gets into the park FREE for the next 30 days. Come back even ONE more time in the next 30 days and you’ll save {{savings}} compared to paying per visit. Convert your tickets to Memberships?\",\"bodySavingsToday\":\"{{membership}} Memberships cost even less than your passes. Convert now and you’ll save {{savedToday}} today, and if you come back even ONE more time in the next 30 days, you’ll save {{savings}} in total. Convert your tickets to Memberships?\",\"countLabel\":\"How many passes are you buying?\",\"fewerPasses\":\"Fewer passes\",\"morePasses\":\"More passes\",\"continueLabel\":\"Continue\",\"confirmLabel\":\"Yes, convert to Membership\",\"declineLabel\":\"No thanks, continue with {{pass}}\"},\"ComingSoon\":{\"badge\":\"Coming soon\",\"openTodayAs\":\"Open today as {name} — becoming a {parkName} soon.\",\"comingToPlace\":\"A brand-new {parkName} is coming to {place}.\",\"comingSoonGeneric\":\"A brand-new {parkName} is coming soon.\",\"openNowAs\":\"Open now as\",\"viewOnGoogleMaps\":\"View on Google Maps\",\"visitWebsite\":\"Visit website\",\"bookAt\":\"Book now at {name}\",\"beFirstToKnow\":\"Be first to know\",\"signupBodyFallback\":\"Get opening news, founding-member offers and launch-day perks for {name} — straight to your inbox.\",\"getUpdatesTitle\":\"Get updates about {name}\",\"onTheList\":\"You’re on the list — we’ll email you when we open!\",\"signupUnavailable\":\"Opening-updates signup is coming soon — check back shortly.\",\"consent\":\"By signing up you agree to receive marketing emails and texts from {brand}. You can unsubscribe at any time.\"},\"Finder\":{\"headingFallback\":\"Find your nearest {parkName}\",\"introFallback\":\"World-class trampolines, ninja courses, and obstacle attractions for kids and families. Filter by country or state, search by city, or use “near me” to