sizes="(max-width: 1080px) 100vw, 1080px" srcset="https://cdn.prod.website-files.com/67e305638ce40a0f0af305e3/682685957cbe4cd7c4eecfe4_ab7772ad5a329a427b61249f13abe3a7_ww_building-rendering_3x4_1080w-p-500.avif 500w, https://cdn.prod.website-files.com/67e305638ce40a0f0af305e3/682685957cbe4cd7c4eecfe4_ab7772ad5a329a427b61249f13abe3a7_ww_building-rendering_3x4_1080w.avif 1080w" alt="The renovated Woolworth&#x27;s Building on the corner of 19th and K Street" src="https://cdn.prod.website-files.com/67e305638ce40a0f0af305e3/682685957cbe4cd7c4eecfe4_ab7772ad5a329a427b61249f13abe3a7_ww_building-rendering_3x4_1080w.avif" loading="lazy" class="visit_header-2_image"/></div></div></div></div></div></div></section><section class="section_visit_quick-info"><div class="padding-global"><div class="container-large"><div class="padding-section-large"><div class="visit_quick-info_component"><div class="margin-bottom margin-large"><h2 class="heading-style-h2">Hours of Operation</h2></div><div class="w-layout-grid visit_quick-info_grid-list"><div class="contact_header_item"><div class="contact_header_item-lines"><div class="vertical-line is-short"></div><div class="vertical-line"></div></div><div class="contact_header_item-content"><div class="margin-bottom margin-xxsmall"><h3 class="heading-style-h5">Building Hours</h3></div><div class="contact_header_item-content-grid"><div>Mon–Sat:</div><div class="is-non-breaking">11:00am–8:00pm</div></div><div class="contact_header_item-content-grid"><div>Sun:</div><div class="is-non-breaking">Closed</div></div></div></div><div class="contact_header_item"><div class="contact_header_item-lines"><div class="vertical-line is-short"></div><div class="vertical-line"></div></div><div class="contact_header_item-content"><div class="margin-bottom margin-xxsmall"><h3 class="heading-style-h5">Luncheonette Hours</h3></div><div class="contact_header_item-content-grid"><div>Mon–Thurs:<br/>Fri &amp; Sat:</div><div class="is-non-breaking">11:00am–3:00pm<br/>11:00am–8:00pm</div></div><div class="contact_header_item-content-grid"><div>Sun:</div><div class="is-non-breaking">10:00am–2:00pm </div></div></div></div><div class="contact_header_item"><div class="contact_header_item-lines"><div class="vertical-line is-short"></div><div class="vertical-line"></div></div><div class="contact_header_item-content"><div class="margin-bottom margin-xxsmall"><h3 class="heading-style-h5">Tenant Hours</h3></div><p>Hours for individual <a href="/tenants" class="text-style-link">Tenants</a> will vary. </p></div></div></div></div></div></div></div><div class="check-pattern_wrapper"><img src="https://cdn.prod.website-files.com/67e305638ce40a0f0af305e3/67fd91494e9ee03a4a8c2c3c_5d5a4500b7dbfa29f987a47048c9c416_check_steel-blue.svg" loading="lazy" alt="" class="check-pattern"/></div><div class="check-pattern_wrapper is-bottom"><img src="https://cdn.prod.website-files.com/67e305638ce40a0f0af305e3/67fd91494e9ee03a4a8c2c3c_5d5a4500b7dbfa29f987a47048c9c416_check_steel-blue.svg" loading="lazy" alt="" class="check-pattern"/></div></section><section class="section_visit_layout"><div class="padding-global"><div class="container-large"><div class="padding-section-large"><div class="visit_layout_component"><div class="w-layout-grid visit_layout_content"><div class="visit_layout_content-left"><div class="visit_layout_contact-heading"><div class="margin-bottom margin-xxsmall"><div class="text-style-tagline">Directions</div></div><div class="margin-bottom margin-xsmall"><h2 class="heading-style-h2">Getting Here</h2></div><div class="margin-bottom margin-large"><p class="text-wrap-balance">The Woolworth’s Building is located in the heart of downtown Bakersfield, California, at the corner of 19th and K Street.</p></div></div><div class="visit_layout_contact-list"><div class="visit_layout_item"><div class="contact_header_item-lines"><div class="vertical-line is-short"></div><div class="vertical-line"></div></div><div class="contact_header_item-content"><div class="