<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "url": "/visit",
  "inLanguage": "en",
  "description": "Frequently asked questions about visiting the Woolworth's Building in downtown Bakersfield, including hours, parking, accessibility, dining, and events.",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where is The Woolworth's Building located?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Woolworth's Building is located in the heart of downtown Bakersfield, California, at the corner of 19th and K Street, at 1400 19th St, Bakersfield, CA 93301."
      }
    },
    {
      "@type": "Question",
      "name": "What are the building's hours of operation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Woolworth's Building is open Monday through Saturday from 11:00 a.m. to 8:00 p.m. We are closed on Sundays."
      }
    },
    {
      "@type": "Question",
      "name": "Is parking available at The Woolworth's Building?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, both street parking and nearby public lots are available around the Woolworth's Building at 19th and K Streets in Downtown Bakersfield."
      }
    },
    {
      "@type": "Question",
      "name": "What can I expect to see at The Woolworth's Building?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Visitors can enjoy a meal at the last surviving Woolworth's Luncheonette, serving classic fare with a modern touch. The building also features The Basement, an immersive subterranean venue for live music, performances, and private events. The preserved Late Moderne architecture includes original terrazzo floors and the historic Luncheonette."
      }
    },
    {
      "@type": "Question",
      "name": "Can I take a guided tour of the building?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, guided tours will be coming soon. Email inquiries to info@historicwoolworths.com."
      }
    },
    {
      "@type": "Question",
      "name": "Is The Woolworth's Building accessible for visitors with disabilities?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The Woolworth's Building is fully accessible, including elevators for reaching all levels and ADA-compliant restrooms."
      }
    },
    {
      "@type": "Question",
      "name": "How can I book The Basement for private events?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Booking inquiries can be sent to info@historicwoolworths.com."
      }
    },
    {
      "@type": "Question",
      "name": "What are the Luncheonette's hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Luncheonette is open Monday through Thursday from 11:00 a.m. to 8:00 p.m., Friday and Saturday from 11:00 a.m. to 9:00 p.m. It is closed on Sundays."
      }
    },
    {
      "@type": "Question",
      "name": "Is photography allowed at The Woolworth's Building?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Personal photography is welcome. For professional shoots, please contact us to obtain the necessary permits."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I buy Woolworth's merchandise?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Merchandise is available for purchase on-site at the historic Woolworth's Building, as well as online at historicwoolworths.com."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I learn more about the history of the building?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Visit the Explore section of our website for a building history timeline, an inside look at the renovation, and a gallery showcasing behind-the-scenes details."
      }
    }
  ]
}
</script><script>(function(w,i,g){w[g]=w[g]||[];if(typeof w[g].push=='function')w[g].push.apply(w[g],Array.isArray(i)?i:[i]);})(window,['G-75LJBJ2ZY7','G-2947X5ME94'],'google_tags_first_party');</script><script async="" src="/9i1h7htkfq16NjdlMzA1NjM4Y2U0MGEwZjBhZjMwNWUz/dCUwinGedNGT5xIQ09G9PwPpAXI"></script><script async="" src="/9i1h7htkfq16NjdlMzA1NjM4Y2U0MGEwZjBhZjMwNWUz/dCUwinGedNGW62ptya7CIGPqAXI"></script><script type="text/javascript">window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('set', 'developer_id.dZGVlNj', true);gtag('set', 'developer_id.dYWYxNW', true);gtag('js', new Date());gtag('config', 'G-75LJBJ2ZY7');gtag('config', 'G-2947X5ME94');</script><!-- Keep this css code to improve the font quality-->
