<section data-component-id="ind2:section" class="ind-section">
      
                



<div data-component-id="ind2:container" class="ind-container">
                        


<div data-component-id="ind2:grid" data-component-variant="layout-side" class="ind-grid ind-grid--variant:layout-side">
          <div class="ind-content ind-flow ind-grid__item--area:content">
                    




