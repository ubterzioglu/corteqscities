        data-is-internal="true"> <div class="p-vertical-positioning p-text-container  p-valign-top"> <div class="p-text-container-inner"> <p class="p-body-text p-text-smaller
                        p-l-col1 p-m-col1
                        p-s-col1 p-xs-col1"> <span><p><strong><br> </strong><span class="p-body-copy-01"><strong>Philips Museum</strong></span></p> <p><span class="p-body-copy-01">Emmasingel 31<br> 5611 AZ Eindhoven</span></p> <p><span class="p-body-copy-01">&nbsp;</span></p> <p><span class="p-body-copy-01">Telefoon (algemeen receptie): + 31 (0)40 235 90 30<br> Telefoon (Boekingen en Sales): +31 (0)6 - 29 12 30 86</span></p> <p>&nbsp;</p> <p><strong>Postadres</strong></p> <p>Lichttoren 340<br> 5611 BJ Eindhoven</p></span> </p> </div> </div> </section> </div> <div class="gc11v3-generictext component-base section"> <section
