				<div class="elementor-widget-container">
					<div class="elementor-image-box-wrapper"><figure class="elementor-image-box-img"><a href="https://www.tac.nu/tac-genoten-2/tac-resident-ahn-sung-hwan/" target="_blank" tabindex="-1"><img fetchpriority="high" fetchpriority="high" decoding="async" width="400" height="400" src="https://www.tac.nu/wp-content/uploads/Studio-Ahn-Sung-Hwan-Sung-Hwan-Ahn-400x400-1-400x400.png" class="attachment-400x400-cropped size-400x400-cropped wp-image-5467" alt="" /></a></figure><div class="elementor-image-box-content"><div class="elementor-image-box-title"><a href="https://www.tac.nu/tac-genoten-2/tac-resident-ahn-sung-hwan/" target="_blank">AHN SUNG HWAN</a></div><p class="elementor-image-box-description">Beeldende kunst </p></div></div>				</div>
				</div>
					</div>
		</div>
				<div class="elementor-column elementor-col-20 elementor-top-column elementor-element elementor-element-e347edf" data-id="e347edf" data-element_type="column">
