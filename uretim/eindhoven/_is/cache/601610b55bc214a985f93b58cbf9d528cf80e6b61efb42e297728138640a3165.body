/* headings */

h1 {
	font-size: 24px;
  font-weight: bold;
	color: #335f67;
}

h3 {
	font-size: 14px;
  color: #737272 !important;
	letter-spacing: 0.5px;
  line-height: 22px;
}

h4 {
    display: inline-block;
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 1px;
    line-height: 30px;
    margin-bottom: 15px;
    position: relative;
    text-transform: uppercase;
	  color: #335f67 !important;
}

h5 {
    color: #737272 !important;
    font-size: 14px;
    letter-spacing: 0.5px;
    line-height: 22px;
    margin-bottom: 15px;
	  font-style: italic;
    text-transform: capitalize;
}

.hover-p {
	text-transform: uppercase;
}

h6 {
    font-weight: bold;
    color: #335f67 !important;
    margin-top: 0px;
    font-style: normal;
    font-weight: 300;
    letter-spacing: .5px;
    text-transform: uppercase;
	font-size: 18px;
	font-weight: 600;
}

h8 {
	  display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: 32px;
    font-weight: 800;
    text-transform: capitalize;
    color: #232323;
    line-height: 1;
		text-align: center;
}

/* food */

.avia-icon-pos-left {
    float: left;
    margin-right: 0.7em;
}

#top .noHover .av-image-caption-overlay {
    height: 50px;
    bottom: 0;
}

.container_wrap { border-top: none !important; }

/* food */

.avia-button {
    background: #ffffff !important;
    border: 1px solid #e5e5e5 !important;
    display: inline-block;
    color: #333333 !important;
    font-size: 12px !important;
    font-weight: 700;
    height: 45px;
    letter-spacing: 1px;
    line-height: 45px !important;
    padding: 0 20px !important;
    text-transform: uppercase;
    transition: .3s;
}

.avia-button:hover {
    background: #335f67 !important;
	color: #fff !important;
}

.box-shadow {
	box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.padding-left {
	padding-left: 10px;
}
	
