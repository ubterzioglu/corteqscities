			/* menu */

div .logo {
    float: left;
    position: absolute;
    left: 0;
    z-index: 1;
    vertical-align: 0 auto;
    top: 25%;
}

.avia-menu-text {
	font-size: 12px !important;
	letter-spacing: 1px;
	text-transform: uppercase;
}

li#menu-item-3271 span {
color: #fff !important;
height: 50px!important;
top: 37px;
padding: 10px 15px;
background: #335f68 !important;
font-size: 15px !important;
}

li#menu-item-3271 span:hover {background-color: black !important;
color: #fff!important;
}

.menu li > a:after { content: ' ▾'; } 
.menu li > a:only-child:after { content: ''; }

.av-main-nav li {
    float: left;
    position: relative;
    z-index: 20;
    margin-left: 10px;
}

.main-menu li:hover > a {
    color: #335f67;
}

#top #header.av_minimal_header .main_menu ul:first-child >li > ul, #top #header.av_minimal_header .main_menu .avia_mega_div > .sub-menu {
    border-top: 3px solid #335F67;
    width: 150px;
    margin-top: -20px;
	  background: #ffffff !important;
}


#top .av-main-nav ul a {
    width: 150px;
    height: auto;
    float: left;
    text-align: left;
    font-size: 12px;
    max-width: none;
    text-decoration: none;
    font-family: inherit;
    background: #fff !important;
    color: #232332 !important;
    letter-spacing: 1px;
    text-transform: uppercase;
}

#top .av-main-nav ul li {
    margin: 0;
    padding: 0;
    width: 150px;
}

