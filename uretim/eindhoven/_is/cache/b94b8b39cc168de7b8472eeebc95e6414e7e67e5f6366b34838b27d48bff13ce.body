dcrumb_breadCrumbList__cjuUK\",\"children\":[[\"$\",\"li\",\"/\",{\"children\":[\"$\",\"a\",null,{\"aria-current\":\"$undefined\",\"href\":\"/\",\"aria-label\":\"Home\",\"children\":[[\"$\",\"span\",null,{\"className\":\"Breadcrumb_text__560xQ\",\"children\":\"Home\"}],[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"viewBox\":\"0 0 64 64\",\"height\":20,\"width\":20,\"className\":\"Icon_icon__hNQtl \",\"role\":null,\"aria-label\":null,\"aria-hidden\":true,\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"fill\":\"#000\",\"d\":\"M43.714 44.896l-3.839-3.63 6.214-6.844-1.365.266H10.667v-5.261h34.057l1.365.208-6.339-6.902 3.839-3.628 11.703 12.952z\"}]]}]]}]}],[\"$\",\"li\",\"/legalisation\",{\"children\":[\"$\",\"a\",null,{\"aria-current\":\"$undefined\",\"href\":\"/legalisation\",\"aria-label\":\"Legalisation of documents\",\"children\":[[\"$\",\"span\",null,{\"className\":\"Breadcrumb_text__560xQ\",\"children\":\"Legalisation of documents\"}],[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"viewBox\":\"0 0 64 64\",\"height\":20,\"width\":20,\"className\":\"Icon_icon__hNQtl \",\"role\":null,\"aria-label\":null,\"aria-hidden\":true,\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"fill\":\"#000\",\"d\":\"M43.675 44.88l-2.953-2.791 7.494-8.172-1.052.203H10.667v-4.047h36.497l1.052.161-7.682-8.32 2.953-2.794 11.807 12.977z\"}]]}]]}]}],[\"$\",\"li\",\"/legalisation/foreign-documents\",{\"children\":[\"$\",\"a\",null,{\"aria-current\":\"page\",\"href\":\"/legalisation/foreign-documents\",\"aria-label\":\"Legalisation of foreign documents for use in the Netherlands. Choose your country.\",\"children\":[[\"$\",\"span\",null,{\"className\":\"Breadcrumb_text__560xQ\",\"children\":\"Legalisation of foreign documents for use in the Netherlands. Choose your country.\"}],[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"viewBox\":\"0 0 64 64\",\"height\":20,\"width\":20,\"className\":\"Icon_icon__hNQtl \",\"role\":null,\"aria-label\":null,\"aria-hidden\":true,\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"fill\":\"#000\",\"d\":\"M43.675 44.88l-2.953-2.791 7.494-8.172-1.052.203H10.667v-4.047h36.497l1.052.161-7.682-8.32 2.953-2.794 11.807 12.977z\"}]]}]]}]}]]}]}]}],[\"$\",\"$L34\",null,{\"data\":{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.netherlandsworldwide.nl/legalisation/foreign-documents/turkiye/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.netherlandsworldwide.nl/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Legalisation of documents\",\"item\":\"https://www.netherlandsworldwide.nl/legalisation\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Legalisation of foreign documents for use in the Netherlands. Choose your country.\",\"item\":\"https://www.netherlandsworldwide.nl/legalisation/foreign-documents\"}]}}]],[\"$\",\"main\",null,{\"lang\":null,\"dir\":null,\"children\":[[\"$\",\"div\",null,{\"className\":\"colored-background  ActionArea_ActionArea__vZzqj\",\"data-testid\":\"action-area\",\"children\":[\"$\",\"div\",null,{\"id\":\"first-content\",\"className\":\"content-wrapper\",\"children\":[[\"$\",\"header\",null,{\"className\":\"ActionArea_title__aTS3p \",\"children\":[\"$undefined\",[\"$\",\"h1\",null,{\"aria-live\":null,\"aria-atomic\":null,\"className\":\"ActionArea_pageTitle__IJO8a\",\"children\":[false,\"Legalisation of documents from Türkiye for use in the Netherlands\"]}],\"$undefined\"]}],\"$undefined\",false,[\"$\",\"$L35\",null,{\"translations\":[{\"lang\":\"en\",\"link\":\"/legalisation/foreign-documents/turkiye\"},{\"lang\":\"nl\",\"link\":\"https://www.nederlandwereldwijd.nl/legaliseren/buitenlandse-documenten/turkije\"}],\"currentLang\":\"en\",\"locale\":\"en\",\"showDutchTranslation\":false}],[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn content-small-wrapper ActionArea_intro__2v5LN\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eYou can use certain documents from Türkiye immediately in the Netherlands. Others must first be legalised with an apostille by the Turkish authorities. This is a simplified form of legalisation which allows you to use your documents in the Netherlands.\u003c/p\u003e\"}}],null,false]}]}],[\"$\",\"div\",null,{\"className\":\"content-wrapper BrInformationArea_informationArea__b8Pf7\",\"data-testid\":\"information-area\",\"children\":[[[[\"$\",\"$1\",\"p1_p2\",{\"children\":[\"$L36\",\"$L37\",\"$L38\",\"$L39\"]}]],\"$undefined\"],\"$undefined\"]}]]}]]\n32:[[\"$\",\"$L21\",\"p1_p10\",{\"signOff\":{\"title\":\"NetherlandsWorldwide\",\"text\":\"\"},\"language\":\"en\",\"navItems\":[\"$\",\"div\",null,{\"className\":\"component-wrapper-no-margin\",\"children\":[[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",\"About NetherlandsWorldwide\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/about-netherlands-worldwide\",\"children\":\"About NetherlandsWorldwide\"}]}],[\"$\",\"li\",\"About this website\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/about-the-website\",\"children\":\"About this website\"}]}]]}],\"$undefined\"]}],\"extraClass\":\"BrFooter_wrapperWithFeedbackBar__mp5SG\",\"translationUrl\":\"https://www.nederlandwereldwijd.nl\",\"hasLanguageSelector\":true,\"footerLogo\":[\"$\",\"img\",null,{\"alt\":\"\",\"loading\":\"lazy\",\"width\":0,\"height\":0,\"decoding\":\"async\",\"src\":\"/binaries/content/gallery/p1o/afbeeldingen/nww-wereldbol-rgb-wit-1.svg\"}],\"children\":[[\"$\",\"div\",null,{\"id\":\"surveyContent\"}],[\"$\",\"div\",null,{\"className\":\"layout-wrapper\",\"children\":false}],false]}]]\n37:[\"$\",\"div\",\"p1_p2_p2\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$undefined\",false]}]\n38:[\"$\",\"div\",\"p1_p2_p3\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003ch2\u003eContact\u003c/h2\u003e\u003cp\u003eIf you have any questions, please do not hesitate to \u003ca href=\\\"/contact\\\"\u003econtact us\u003c/a\u003e.\u003c/p\u003e\"}}],false]}]\n39:[\"$\",\"div\",\"p1_p2_p4\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003ch2\u003eAfter legalisation\u003c/h2\u003e\u003ch3\u003eVerification of your document in the Netherlands\u003c/h3\u003e\u003cp\u003eLegalisation does not prove the authenticity of a document or the truthfulness of its content. A municipality in the Netherlands, the Immigration and Naturalisation Service (IND) or another authority may decide to verify these things. Legalisation of your document simply means that your document bears the correct signature.\u003c/p\u003e\u003ch3\u003eHow recently must your document have been issued or legalised\u003c/h3\u003e\u003cp\u003eOrganisations have different requirements for how recently your document must have been issued and legalised. For more information, contact the organisation in the Netherlands requesting the document. For marriage certificates or birth certificates: when you obtained and or legalised one of these certificates is not important, as they remain valid once they have been legalised. \\n\u003cbr /\u003e\u003c/p\u003e\"}}],false]}]\n3a:I[13106,[\"7589\",\"$13\",\"1043\",\"$18\",\"8142\",\"$19\",\"6998\",\"$14\",\"4714\",\"$1a\",\"3400\",\"$1b\"],\"default\"]\n36:[\"$\",\"div\",\"p1_p2_p1\",{\"className\":\"component-wrapper-no-margin\",\"children\":[[[\"$\",\"div\",\"block-0\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"notification--attention\\\"\u003e\u003cspan class=\\\"sr-only\\\"\u003eAttention: \u003c/span\u003eIf you want to use a Dutch document in Türkiye, see  \u003ca href=\\\"/legalisation/dutch-documents\\\"\u003eLegalisation of Dutch documents for use abroad\u003c/a\u003e.\u003c/div\u003e\u003ch2\u003eGood to know\u003c/h2\u003e\u003cul\u003e\u003cli\u003eMultilingual extracts from civil status records do not have to be translated or legalised.\u003c/li\u003e\u003cli\u003eIf your document is in Turkish, you must have it translated. \u003c/li\u003e\u003cli\u003eYour document must be original and complete. If it refers to other documents or annexes, these must be included. \u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eWhat documents do not have to be legalised? \u003c/h2\u003e\u003cp\u003eThe following documents do not have to be legalised for use in the Netherlands.\u003c/p\u003e\"}}]}],[\"$\",\"div\",\"block-1\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$\",\"$L3a\",null,{\"isNavigationType\":false,\"data\":[{\"header\":\"Multilingual extracts from civil status records\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cul\u003e\u003cli\u003eMultilingual extracts from civil status records do not have to be legalised for use in the Netherlands.\u003c/li\u003e\u003cli\u003eA multilingual extract is a standard form in several languages, including English.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eYou can request multilingual extracts from the following types of record:\u003c/p\u003e\u003cul\u003e\u003cli\u003ebirth certificates\u003c/li\u003e\u003cli\u003emarriage certificates\u003c/li\u003e\u003cli\u003edivorce certificates\u003c/li\u003e\u003cli\u003edeath certificates\u003c/li\u003e\u003c/ul\u003e\u003cdiv class=\\\"notification--attention\\\"\u003e\u003cspan class=\\\"sr-only\\\"\u003eAttention: \u003c/span\u003e\u003cspan\u003eTo use a multilingual extract in Aruba, Curaçao, St Maarten, Bonaire, Saba or St Eustatius, you must have it legalised with an apostille. \u003c/span\u003e\u003c/div\u003e\"}}],[]],\"id\":0},{\"header\":\"Certificates/declarations of capacity to marry\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eThere is a multilingual standard form for a certificate proving that you are legally allowed to get married (certificate/declaration of capacity to marry). This document does not need to be translated or legalised for use in the Netherlands.\u003c/p\u003e\u003cp\u003eIt can also be used in Aruba, Curaçao, St Maarten, Bonaire, Saba and St Eustatius.\u003c/p\u003e\"}}],[]],\"id\":1},{\"header\":\"Documents regarding your nationality or place of residence\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eDocuments regarding your nationality or place of residence do not have to be legalised for use in the Netherlands or Aruba. \u003c/p\u003e\u003cp\u003eIf the document is in Turkish, you must have it translated into Dutch, English, French or German.\u003c/p\u003e\u003cdiv class=\\\"notification--attention\\\"\u003e\u003cspan class=\\\"sr-only\\\"\u003eAttention: \u003c/span\u003eTo use the document in Curaçao, St Maarten, Bonaire, Saba or St Eustatius, you must have it legalised with an apostille.\u003c/div\u003e\"}}],[]],\"id\":2},{\"header\":\"Documents issued by an embassy or consulate\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eYou can use documents drawn up by a Turkish embassy or consulate directly in the Netherlands. Legalisation is not necessary.\u003c/p\u003e\u003cp\u003eIf the document is drawn up in Turkish, you must have the document translated into Dutch, English, French or German. Will you have the document translated in the Netherlands? Then legalisation of the translation is not necessary.\u003c/p\u003e\u003cp\u003eThese documents can also be used in Aruba, Curaçao, St Maarten, Bonaire, Saba and St Eustatius.\u003c/p\u003e\u003cp\u003eExamples of this type of document include:\u003c/p\u003e\u003cul\u003e\u003cli\u003edeclarations of civil status\u003c/li\u003e\u003cli\u003ecertificates of residence\u003c/li\u003e\u003cli\u003ecertificates of life\u003c/li\u003e\u003c/ul\u003e\"}}],[]],\"id\":3}],\"title\":null,\"actionType\":null,\"useHeading3\":true,\"id\":\"block-1\"}]}],\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\",\"$L3f\",\"$L40\",\"$L41\"],\"$undefined\"]}]\n3b:[\"$\",\"div\",\"block-2\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003ch2\u003eWhat documents have to be legalised?\u003c/h2\u003e\u003cp\u003eThe following documents must be legalised for use in the Netherlands.\u003c/p\u003e\"}}]}]\n3c:[\"$\",\"div\",\"block-3\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$\",\"$L3a\",null,{\"isNavigationType\":false,\"data\":[{\"header\":\"Diplomas and certificates\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eDiplomas and professional and educational certificates must be legalised with an apostille.\u003c/p\u003e\u003cp\u003eOnce your document has been legalised it is fit for use in the Netherlands.\u003c/p\u003e\u003cp\u003eIt is then also fit for use in Aruba, Curaçao, St Maarten, Bonaire, Saba and St Eustatius.\u003c/p\u003e\"}}],[]],\"id\":0},{\"header\":\"Multilingual extracts for use in the Caribbean part of the Kingdom\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eTo use a multilingual extract from a civil status record in Aruba, Curaçao, St Maarten, Bonaire, Saba or St Eustatius, you must have it legalised with an apostille.\u003c/p\u003e\"}}],[]],\"id\":1}],\"title\":null,\"actionType\":null,\"useHeading3\":true,\"id\":\"block-3\"}]}]\n3d:[\"$\",\"div\",\"block-4\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eIf you have another type of document, find out from the organisation in the Netherlands requesting the document whether it needs to be legalised.\u003c/p\u003e\u003ch2\u003eCheck whether you need a translation\u003c/h2\u003e\u003cp\u003eIf your document is in Turkish, check whether you can get a multilingual extract. A multilingual extract does not need to be translated or legalised for use in the Netherlands.\u003c/p\u003e\u003cp\u003eIf you cannot get a multilingual extract, you must have your document translated into Dutch, English, French or German by a sworn translator.\u003c/p\u003e\"}}]}]\n3e:[\"$\",\"div\",\"block-5\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$\",\"$L3a\",null,{\"isNavigationType\":false,\"data\":[{\"header\":\"Having your document translated in Türkiye\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003col\u003e\u003cli\u003eHave the document translated by a sworn translator.\u003c/li\u003e\u003cli\u003eHave the original and the translation legalised.\u003c/li\u003e\u003c/ol\u003e\"}}],[]],\"id\":0},{\"header\":\"Having your document translated in the Netherlands\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003col\u003e\u003cli\u003eHave the original document legalised in Türkiye.\u003c/li\u003e\u003cli\u003eHave the legalised document translated by a sworn translator in the Netherlands. You do not need to have the translation legalised.\u003cbr /\u003e\\nYou can find a sworn translator on the \u003ca href=\\\"https://zoekeentolkvertaler.bureauwbtv.nl/\\\"\u003eLegal Aid Council website\u003c/a\u003e.\u003c/li\u003e\u003c/ol\u003e\"}}],[]],\"id\":1}],\"title\":null,\"actionType\":null,\"useHeading3\":true,\"id\":\"block-5\"}]}]\n3f:[\"$\",\"div\",\"block-6\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003ch2\u003eWhere can you have your documents legalised?\u003c/h2\u003e\u003cp\u003eYour document and, if applicable, the translation must be legalised with an apostille by the Turkish authorities. See the \u003ca href=\\\"https://www.hcch.net/en/states/authorities/details3/?aid=350\\\"\u003eHague Conference on Private International Law (HCCH)\u003c/a\u003e website for contact details.\u003c/p\u003e\u003cp\u003eOnce your document has been legalised it is fit for use in the Netherlands.\u003c/p\u003e\u003cp\u003eIt is then also fit for use in Aruba, Curaçao, St Maarten, Bonaire, Saba and St Eustatius.\u003c/p\u003e\u003ch2\u003eDon’t have the document you need?\u003c/h2\u003e\u003cp\u003eFind out below where to obtain a document that you need but do not yet have.\u003c/p\u003e\u003cdiv class=\\\"notification--attention\\\"\u003e\u003cspan class=\\\"sr-only\\\"\u003eAttention: \u003c/span\u003eCheck whether you can get a multilingual extract. A multilingual extract does not need to be translated or legalised for use in the Netherlands. \u003c/div\u003e\"}}]}]\n40:[\"$\",\"div\",\"block-7\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$\",\"$L3a\",null,{\"isNavigationType\":false,\"data\":[{\"header\":\"Birth certificates, marriage certificates, divorce certificates and death certificates\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eYou can get civil status records from the civil status records office (dir=\\\"ltr\\\" lang=\\\"tr\\\"\u0026gt;nüfus idaresi/nüfus müdürlüğü)\u003c/p\u003e\u003cp\u003ein the district where you are registered. You can also get official copies and multilingual extracts there.\u003c/p\u003e\u003cp\u003eThis applies to the following documents:\u003c/p\u003e\u003cul\u003e\u003cli\u003ebirth certificates\u003c/li\u003e\u003cli\u003emarriage certificates\u003c/li\u003e\u003cli\u003edeath certificates\u003c/li\u003e\u003cli\u003edivorce certificates\u003c/li\u003e\u003c/ul\u003e\"}}],[]],\"id\":0},{\"header\":\"Certificates of unmarried status\",\"content\":[[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eYou can get a certificate of unmarried status from the civil status records office (\u003cspan dir=\\\"ltr\\\" lang=\\\"tr\\\"\u003e\u003cem\u003enüfus idaresi/nüfus müdürlüğü\u003c/em\u003e\u003c/span\u003e) in the district where you are registered.\u003c/p\u003e\"}}],[]],\"id\":1}],\"title\":null,\"actionType\":null,\"useHeading3\":true,\"id\":\"block-7\"}]}]\n41:[\"$\",\"div\",\"block-8\",{\"className\":\"component-wrapper content-small-wrapper\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"$undefined\",\"className\":\"RichText_container__QJWUn \",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003eIf you need to obtain another type of document, ask the local authorities where you can get this document.\u003c/p\u003e\"}}]}]\n"])</script></body></html>