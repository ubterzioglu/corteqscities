-2 md:mx-2 text-primary" viewBox="0 0 15 25" xmlns="http://www.w3.org/2000/svg"><path d="M14.4603 13.7376L3.14568 24.4869C2.42594 25.171 1.25899 25.171 0.539592 24.4869C-0.179864 23.8034 -0.179864 22.6948 0.539592 22.0113L10.5513 12.4998L0.539883 2.98869C-0.179573 2.30489 -0.179573 1.19638 0.539883 0.512853C1.25934 -0.170951 2.42623 -0.170951 3.14598 0.512853L14.4606 11.2623C14.8203 11.6042 15 12.0519 15 12.4998C15 12.9479 14.82 13.3959 14.4603 13.7376Z"></path></svg><span class="font-bold transition-color ease-out duration-150 text-basic-600">Wij zijn weer open, kom jij weer lekker schaatsen?</span></div></div><div class="u-block-margins"><h2 class="lg:h1 mb-4 text-secondary">Nieuws</h2><div class="flex flex-wrap lg:justify-between -mx-4"><div class="flex-full lg:flex-7/12 max-w-full lg:max-w-7/12 p-4"><h1 class="h3 lg:h2 mb-6 lg:mb-10">Wij zijn weer open, kom jij weer lekker schaatsen?</h1><figure class="NewsPagestyles__NewsPageFigure-sc-51riyi-0 cUHCtE mb-6 lg:mb-10"><img src="https://dmtupqacnn63x.cloudfront.net/images/0032_scherm0321.2a04590c.fill-900x360-c100.jpg" alt="0032_scherm032[1]" class="w-full h-full rounded-lg object-cover object-center"/></figure><p class="font-bold mb-6 lg:mb-10">Goed nieuws, zaterdag 17 oktober zijn wij geopend voor al jouw activiteiten op het ijs!</p><div class="mb-6 lg:mb-10 "><div class="RichTextstyles__RichTextElem-sc-mg14jk-0 jcOvwj rich-text" data-test-id="component-richText"><p data-block-key="egsql">Beste bezoeker,</p><p data-block-key="algct"><br/>Op zaterdag 17 oktober 2026 openen wij weer met veel plezier onze deuren en verwelkomen wij jong en oud voor een nieuw, sportief en gezellig ijsseizoen.</p><p data-block-key="81nku"></p><p data-block-key="djttl">Of je nu komt voor een ontspannen rondje op het ijs, sportieve uitdagingen of een gezellig dagje uit met familie en vrienden — wij staan straks weer voor je klaar met een frisse baan en een warme sfeer.</p><p data-block-key="a43vs"></p><p data-block-key="53iu3">Wij kijken ernaar uit je binnenkort weer te zien op het ijs!</p><p data-block-key="bj8rc"></p><p data-block-key="9vsb4">Tot snel bij het IJssportcentrum Eindhoven!</p></div></div><div class="px-2"><div class="flex -mx-2"><div class="px-2">Deel dit bericht</div><div class="flex"><a class="px-2" href="https://twitter.com/intent/tweet?url=&amp;text=Wij%20zijn%20weer%20open%2C%20kom%20jij%20weer%20lekker%20schaatsen%3F" rel="noreferrer" target="_blank"><span class="sr-only">Delen via Twitter</span><svg id="social-twitter" width="25" height="25" fill="currentColor" stroke="currentColor" class="text-primary" viewBox="0 0 512 462.799" shape-rendering="geometricPrecision" text-rendering="geometricPrecision" image-rendering="optimizeQuality" fill-rule="evenodd" clip-rule="evenodd" xmlns="http://www.w3.org/2000/svg"><path fill-rule="nonzero" d="M403.229 0h78.506L310.219 196.04 512 462.799H354.002L230.261 301.007 88.669 462.799h-78.56l183.455-209.683L0 0h161.999l111.856 147.88L403.229 0zm-27.556 415.805h43.505L138.363 44.527h-46.68l283.99 371.278z"></path></svg></a><a class="px-2" href="https://www.facebook.com/sharer/sharer.php?u=" target="_blank" rel="noreferrer"><span class="sr-only">Delen via Facebook</span><svg id="social-facebook" width="25" height="25" fill="currentColor" stroke="currentColor" class="text-primary" viewBox="0 0 25 26" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M14.0647 25.9733V14.7224H17.1936L17.7055 9.72235H14.0647V7.28827C14.0647 6.00017 14.0933 4.72282 15.7435 4.72282H17.4145V1.14763C17.4145 1.09447 15.98 0.973394 14.5273 0.973394C11.4945 0.973394 9.5974 3.04424 9.5974 6.84862V9.72235H6.2476V14.7224H9.5974V25.9733H14.0647Z"></path></svg></a><a class="px-2" href="https://api.whatsapp.com/send?text=Bekijk+op+sportfondsen.nl%3A+" rel="noreferrer" target="_blank"><span class="sr-only">Delen via Whatsapp</span><svg id="social-whatsapp" width="25" height="25" fill="currentColor" stroke="currentColor" class="text-primary" viewB