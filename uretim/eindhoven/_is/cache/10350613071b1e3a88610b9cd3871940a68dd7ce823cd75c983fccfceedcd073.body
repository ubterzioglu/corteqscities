    <div id="si-sp" class="sp"><div id="main" data-bid="main" class="sb sib-main sb-nm-dH sb-nd-wH"><div class="ss-s ss-bg"><div class="sb-m"></div><div class="sc" style="width:1200px"></div></div><div id="main_view-1" class="ss sis-main_view-1 sactive"><div class="sc"><div data-sid="main_view-1_0" class="sie-main_view-1_0 se"><h3 class="se-t sie-main_view-1_0-text st-m-heading st-d-heading se-rc">Wil jij werken met de mooiste wijnen, in een ervaren en internationaal team? Stuur dan een mail naar info@cafebarolo.nl!<br><br>Ook ons keukenteam kan versterking gebruiken!<br></h3></div><div data-sid="main_view-1_1" class="sie-main_view-1_1 se"><h1 class="se-t sie-main_view-1_1-text st-m-title st-d-title se-rc">Na het selecteren van een moment, kunt u de keuze in tasting aangeven in de reserveringstool!<br></h1></div><a href="https://static.showit.com/file/fX5_ypbQ57IMK3sbT2Geqw/288208/food_26_09.pdf" target="_blank" class="sie-main_view-1_2 se" data-sid="main_view-1_2"><h1 class="se-t sie-main_view-1_2-text st-m-title st-d-title">FOOD</h1></a></div></div><div class="ss-s ss-fg"><div class="sc"><a href="https://zarzo.nl/" target="_blank" class="sie-main_2 se" data-sid="main_2"><div style="width:100%;height:100%" data-img="main_2" class="se-img se-gr slzy"></div><noscript><img src="//static.showit.co/200/Oz_tSosY6mcMxIMoD5MIwA/288208/zarzo_wit.png" class="se-img" alt="" title="zarzo_wit"/></noscript></a><a href="https://www.restaurant-zuid.nl/" target="_blank" class="sie-main_3 se" data-sid="main_3"><div style="width:100%;height:100%" data-img="main_3" class="se-img se-gr slzy"></div><noscript><img src="//static.showit.co/200/7s6vCkBUtG4asYQwu6zNtw/288208/zuid-wit.png" class="se-img" alt="" title="zuid-wit"/></noscript></a><a href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x47c6d9cb28f448bd:0xf81d83bc5cd9e891?sa=X&amp;ved=1t:8290&amp;ictx=111" target="_blank" class="sie-main_5 se" data-sid="main_5"><p class="se-t sie-main_5-text st-m-paragraph st-d-paragraph">info@cafebarolo.nl<br>Keizersgracht 4, 5611 GD Eindhoven<br></p></a><div class="str-im str-id" data-tran="main_6"><a href="https://www.instagram.com/cafe_barolo/" target="_blank" class="sie-main_6 se" data-sid="main_6"><div class="se-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M338,54.63H174c-62.72,0-114,51.32-114,114V343.33c0,62.72,51.32,114,114,114H338c62.72,0,114-51.32,114-114V168.67C452,105.94,400.68,54.63,338,54.63Zm83.91,288.71A84.24,84.24,0,0,1,338,427.24H174a84.24,84.24,0,0,1-83.91-83.91V168.67A84.24,84.24,0,0,1,174,84.76H338a84.24,84.24,0,0,1,83.91,83.91Z"/><path d="M255.77,148.18A107.94,107.94,0,1,0,363.71,256.13,107.94,107.94,0,0,0,255.77,148.18Zm-.52,178.71a70.68,70.68,0,1,1,70.68-70.68A70.68,70.68,0,0,1,255.25,326.9Z"/><circle cx="365.44" cy="146.5" r="25.56"/></svg></div></a></div><a href="https://static.showit.com/file/jMybv7Q_D5QVaR5KZSZBsg/288208/wijnkaart_2026-09-05.pdf" target="_blank" class="sie-main_7 se" data-sid="main_7"><h1 class="se-t sie-main_7-text st-m-title st-d-title">WINES</h1></a><a href="https://www.instagram.com/cafe_barolo/" target="_blank" class="sie-main_8 se" data-sid="main_8"><div class="se-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M250.82,162h60.34a19.34,19.34,0,0,0,19.34-19.34V71.34A19.34,19.34,0,0,0,311.16,52H264.5c-45.84,0-83,91.33-83,204s37.16,204,83,204h46.66a19.34,19.34,0,0,0,19.34-19.34V369.34A19.34,19.34,0,0,0,311.16,350H250.82c-5.95-28.13-9.32-60.1-9.32-94S244.87,190.13,250.82,162Z"/></svg></div></a><a href="https://static.showit.com/file/jiUA4lqjSctQC8iYaQaCCw/288208/tastings_website_03-05-26.pdf" target="_blank" class="sie-main_9 se" data-sid="main_9"><h1 class="se-t sie-main_9-text st-m-title st-d-title">TASTINGS</h1></a><a href="tel:0407600500" target="_self" class="sie-main_10 se" data-sid="main_10"><p class="se-t sie-main_10-text st-m-paragraph st-d-paragraph">040 760 0500<br></p></a><a href="#/" target="_self" class="sie-main_11 se se-pc se-sl" data-sid="main_11" data-scrollto="#info"><h1 class="se-t sie-main_11-text st-m-title st-d-title">INFO</h1></a></div></div></div><div id="info" data-bid="info" class="sb sib-info sb-nm-wH sb-nd-wH sb-ld"><div class="ss-s ss-bg"><div class="sc" style="width:1200px"><a href="https://zarzo.nl/" target="_blank" class="sie-info_0 se" data-sid="info_0"><div style="width:100%;height:100%" data-img="info_0" class="se-img se-gr slzy"></div><noscript><img src="//static.showit.co/200/wrAEZ6jSG7OzjJl0WEjp1g/288208/zarzo.png" class="se-img" alt="" title="zarzo"/></noscript></a><a href="https://www.restaurant-zuid.nl/" target="_blank" class="sie-info_1 se" data-sid="info_1"><div style="width:100%;height:100%" data-img="info_1" class="se-img se-gr slzy"></div><noscript><img src="//static.showit.co/200/xmAXM-jcPmmF4RxMM3tIWA/288208/zuid.png" class="se-img" alt="" title="zuid"/></noscript></a><div class="str-im str-id" data-tran="info_2"><a href="https://www.instagram.com/cafe_barolo/" target="_blank" class="sie-info_2 se" data-sid="info_2"><div class="se-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M338,54.63H174c-62.72,0-114,51.32-114,114V343.33c0,62.72,51.32,114,114,114H338c62.72,0,114-51.32,114-114V168.67C452,105.94,400.68,54.63,338,54.63Zm83.91,288.71A84.24,84.24,0,0,1,338,427.24H174a84.24,84.24,0,0,1-83.91-83.91V168.67A84.24,84.24,0,0,1,174,84.76H338a84.24,84.24,0,0,1,83.91,83.91Z"/><path d="M255.77,148.18A107.94,107.94,0,1,0,363.71,256.13,107.94,107.94,0,0,0,255.77,148.18Zm-.52,178.71a70.68,70.68,0,1,1,70.68-70.68A70.68,70.68,0,0,1,255.25,326.9Z"/><circle cx="365.44" cy="146.5" r="25.56"/></svg></div></a></div><div class="str-im str-id" data-tran="info_3"><a href="#/" target="_self" class="sie-info_3 se se-pc se-sl" data-sid="info_3" data-scrollto="#main"><div class="se-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><polygon points="405 121.8 390.2 107 256 241.2 121.8 107 107 121.8 241.2 256 107 390.2 121.8 405 256 270.8 390.2 405 405 390.2 270.8 256 405 121.8"/></svg></div></a></div><div class="str-im str-id" data-tran="info_4"><a href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x47c6d9cb28f448bd:0xf81d83bc5cd9e891?sa=X&amp;ved=1t:8290&amp;ictx=111" target="_blank" class="sie-info_4 se" data-sid="info_4"><h1 class="se-t sie-info_4-text st-m-heading st-d-heading">VIEW ON MAP</h1></a></div><div class="str-im str-id" data-tran="info_5"><div data-sid="info_5" class="sie-info_5 se"><h1 class="se-t sie-info_5-text st-m-title st-d-title se-rc">INFO</h1></div></div><div class="str-im str-id" data-tran="info_6"><div data-sid="info_6" class="sie-info_6 se"><p class="se-t sie-info_6-text st-m-paragraph st-d-paragraph se-rc">Bij Café Barolo proef je wijnen van over de hele wereld, geselecteerd uit de zorgvuldig opgebouwde privécollectie van Adrian Zarzo. Bekend van zijn Eindhovense zaken Zarzo en Zuid by Adrian Zarzo, brengt hij zijn passie voor wijn naar een nieuwe hoogte.<br><br>Met 40 open wijnen, een keur aan digestieven en versterkte wijnen en een indrukwekkende kaart van bijna 300 flessen is er altijd iets nieuws te ontdekken. Proost op een unieke wijnervaring!<br><br><br></p></div></div><div class="str-im str-id" data-tran="info_7"><div data-sid="info_7" class="sie-info_7 se"><p class="se-t sie-info_7-text st-m-paragraph st-d-paragraph se-rc"><br><br>Maandag&nbsp; t/m woensdag gesloten<br><br>&nbsp;Donderdag 15:00 tot 23:00<br>
<br>Vrijdag van 14.00 tot 00.00
<br>
<br>Zaterdag van 14.00 tot 00.00
<br>
<br>Zondag van 12.00 tot 21.00<br><br></p></div></div><div class="str-im str-id" data-tran="info_8"><div data-sid="info_8" class="sie-info_8 se"><h1 class="se-t sie-info_8-text st-m-title st-d-title se-rc">WINE &amp; FOOD</h1></div></div><div class="str-im str-id" data-tran="info_9"><div data-sid="info_9" class="sie-info_9 se"><h1 class="se-t sie-info_9-text st-m-title st-d-title se-rc">OPENINGSTIJDEN</h1></div></div></div></div><div id="info_view-1" class="ss sis-info_view-1 sactive"><div class="sc"><div data-sid="info_view-1_0" class="sie-info_view-1_0 se"><p class="se-t sie-info_view-1_0-text st-m-paragraph st-d-paragraph se-rc">Keizersgracht4, 5611GD Eindhoven<br>+31 40 7 600 500<br></p></div></div></div></div></div>
    
    
