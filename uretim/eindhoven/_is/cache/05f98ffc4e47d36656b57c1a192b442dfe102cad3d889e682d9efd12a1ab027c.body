="lazy" decoding="async" data-nimg="fill" class="absolute inset-0 h-full w-full object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F2a82c962175409f3bfcbaac03949042a42b906ed-853x1280.jpg&amp;w=420&amp;q=80 420w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F2a82c962175409f3bfcbaac03949042a42b906ed-853x1280.jpg&amp;w=640&amp;q=80 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F2a82c962175409f3bfcbaac03949042a42b906ed-853x1280.jpg&amp;w=750&amp;q=80 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F2a82c962175409f3bfcbaac03949042a42b906ed-853x1280.jpg&amp;w=828&amp;q=80 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F2a82c962175409f3bfcbaac03949042a42b906ed-853x1280.jpg&amp;w=1080&amp;q=80 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F2a82c962175409f3bfcbaac03949042a42b906ed-853x1280.jpg&amp;w=1200&amp;q=80 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F2a82c962175409f3bfcbaac03949042a42b906ed-853x1280.jpg&amp;w=1440&amp;q=80 1440w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F2a82c962175409f3bfcbaac03949042a42b906ed-853x1280.jpg&amp;w=1620&amp;q=80 1620w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F2a82c962175409f3bfcbaac03949042a42b906ed-853x1280.jpg&amp;w=1620&amp;q=80"/></div></div></figure></div><figcaption class="mt-2 tie-type-body text-[16px] leading-6 [&amp;_a]:text-[var(--tie-theme-accent)] [&amp;_a]:underline lg:[&amp;_a:hover]:no-underline"><p>Image</p></figcaption></figure></div></section><section class="scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0"><div class="mx-auto w-full px-2 md:w-[83.34%] lg:w-[66.67%] xl:w-full xl:max-w-[626px] pt-4 tie-rich-text" data-testid="rich-text-block-section"><h2>Budget bites</h2><p>Great food doesn&#x27;t have to cost a lot. <a href="/en/see-and-do/tips-by-locals/hotspots-of-the-big-red-arrow">These thirty Eindhoven foodie hotspots prove that point</a>. Extra addition to the list is <a href="/en/locations/down-town-gourmet-market">Down Town Gourmet Market</a>. At Down Town Gourmet Market you can make your dining experience as expensive (or as affordable) as you like. Whatever you’re into, Down Town delivers. You can choose from the menus of many different affiliated restaurants, right from the comfort of your own (restaurant) chair.</p><h2>Love (and parks) don’t cost a thing</h2><p>Grab your favorite picnic blanket and settle down in one of <a href="/nl/zien-en-doen/recreatie/13x-eindhovense-parken">these fifteen (!) parks</a>. Bring a freshly baked baguette, something to drink, and good company, and your low-budget afternoon is complete. You just need the weather on your side. But you can always bring a thermos of hot chocolate or go for a brisk walk.</p></div></section><section class="scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0"><div class="mx-auto w-full max-w-[1050px]" data-testid="dual-image-portrait-section"><figure class="m-0"><div class="grid grid-cols-2 gap-4"><figure class="m-0 min-w-0"><div class="relative"><div class="relative h-0 overflow-hidden w-full" style="padding-bottom:149%"><img title="Cleo Goossens" alt="Dutch Design Week" loading="lazy" decoding="async" data-nimg="fill" class="absolute inset-0 h-full w-full object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F3f2cc7bf678693c7778e413035fa5d977ef44e73-915x1280.jpg&amp;w=420&amp;q=80 420w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F3f2cc7bf678693c7778e413035fa5d977ef44e73-915x1280.jpg&amp;w=640&amp;q=80 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F3f2cc7bf678693c7778e413035fa5d977ef44e73-915x1280.jpg&amp;w=750&amp;q=80 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F3f2cc7bf678693c7778e413035fa5d977ef44e73-915x1280.jpg&amp;w=828&amp;q=80 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F3f2cc7bf678693c7778e413035fa5d977ef44e73-915x1280.jpg&amp;w=1080&amp;q=80 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F3f2cc7bf678693c7778e413035fa5d977ef44e73-915x1280.jpg&amp;w=1200&amp;q=80 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F3f2cc7bf678693c7778e413035fa5d977ef44e73-915x1280.jpg&amp;w=1440&amp;q=80 1440w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F3f2cc7bf678693c7778e413035fa5d977ef44e73-915x1280.jpg&amp;w=1620&amp;q=80 1620w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2F3f2cc7bf678693c7778e413035fa5d977ef44e73-915x1280.jpg&amp;w=1620&amp;q=80"/></div></div></figure><figure class="m-0 min-w-0"><div class="relative"><div class="relative h-0 overflow-hidden w-full" style="padding-bottom:149%"><img title="Cleo Goossens" alt="Dutch Design Week" loading="lazy" decoding="async" data-nimg="fill" class="absolute inset-0 h-full w-full object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2Fce5b8286a263466050621f7cd742083edc35f4f0-914x1280.jpg&amp;w=420&amp;q=80 420w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2Fce5b8286a263466050621f7cd742083edc35f4f0-914x1280.jpg&amp;w=640&amp;q=80 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2Fce5b8286a263466050621f7cd742083edc35f4f0-914x1280.jpg&amp;w=750&amp;q=80 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2Fce5b8286a263466050621f7cd742083edc35f4f0-914x1280.jpg&amp;w=828&amp;q=80 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2Fce5b8286a263466050621f7cd742083edc35f4f0-914x1280.jpg&amp;w=1080&amp;q=80 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2Fce5b8286a263466050621f7cd742083edc35f4f0-914x1280.jpg&amp;w=1200&amp;q=80 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2Fce5b8286a263466050621f7cd742083edc35f4f0-914x1280.jpg&amp;w=1440&amp;q=80 1440w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2Fce5b8286a263466050621f7cd742083edc35f4f0-914x1280.jpg&amp;w=1620&amp;q=80 1620w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fcwuu6lx4%2Fproduction%2Fce5b8286a263466050621f7cd742083edc35f4f0-914x1280.jpg&amp;w=1620&amp;q=80"/></div></div></figure></div><figcaption class="mt-2 tie-type-body text-[16px] leading-6 [&amp;_a]:text-[var(--tie-theme-accent)] [&amp;_a]:underline lg:[&amp;_a:hover]:no-underline"><p>Image</p></figcaption></figure></div></section><section class="scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0"><div class="mx-auto w-full px-2 md:w-[83.34%] lg:w-[66.67%] xl:w-full xl:max-w-[626px] pt-4 tie-rich-text" data-testid="rich-text-block-section"><h2>Cozy lights and liberation</h2><p>Yes, summer has its charm. Long sunny days, countless festivals, strolling outside without a coat... We get it. But not to worry, <a href="/en/see-and-do/autumn-in-eindhoven">fall in Eindhoven has more than enough to offer</a>! From September 18 to mid-October, you can walk (or cycle) the cozy Lichtjesroute. The Lichtjesroute is 13 miles long and runs through the center of Eindhoven, and the districts Stratum, Strijp, and Woensel. All those cozy lights along the way are sure to give you that ultimate fall feeling. Some background info: The route is organized by volunteers as a tribute to the liberation by the Allied troops on September 18, 1944.</p><h2>Nine days of Dutch design</h2><p>Say Eindhoven, and you say design. As a true design city, it makes sense that Eindhoven hosts the largest design event in Northern Europe. During the <a href="/en/see-and-do/culture-and-design/dutch-design-week-for-beginners">Dutch Design Week</a> in October, the city is taken over by – you guessed it – design! For nine days, people from all over the world come to admire the work of the most talented, inspiring designers. More than 2,600 designers present their work and concepts during DDW. You can wander around and let yourself be surprised, or follow one of the mapped-out routes. That way you’re sure to miss nothing. Some DDW locations are free of charge, but an all-week-pass won’t break the bank either. For about 25 euros, you get nine days of access to all the DDW hotspots.</p><h2>Eindhovens GLOW-up</h2><p>Every year in November, Eindhoven has a real-life glow-up. The whole city changes before your eyes during GLOW. GLOW is a free-to-visit light art festival. With buildings, parks, roofs, and streets as their canvas, about 35 artists paint with light. Also, there are all kinds of events around the festival. GLOW ensures there is something to see and experience throughout the whole city.</p></div></section><section class="scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0"><section class="mx-auto w-full max-w-[626px] tie-border-accent flex flex-col gap-4 border-y py-6" data-testid="category-buttons-section" data-tie-theme="beige"><h2 class="tie-type-eyebrow tie-color-accent m-0">Tags</h2><div class="flex flex-wrap gap-3"><a class="tie-type-button group inline-flex min-h-12 shrink-0 items-center justify-center px-4 py-3 no-underline focus-visible:tie-focus-ring transition-[background-color,border-color,color,opacity] duration-200 ease-in-out border-