            <picture>
    <source class="hero-image hero-image-medium" media="(min-width:769px)" srcset="https://www.hollandexpatcenter.com/sites/default/files/styles/hero_image_medium_1x/public/2025-08/_DSF7191-bewerktLrPs.jpg?h=b0fd5a04&amp;itok=ginBVFVE">
    <img src="" class="hero-image hero-image-fallback" alt=""/>
