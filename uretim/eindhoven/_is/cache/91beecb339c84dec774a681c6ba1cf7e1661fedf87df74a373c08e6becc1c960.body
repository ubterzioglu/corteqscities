"blurDataURL\":\"$undefined\",\"height\":900,\"loading\":\"$undefined\",\"placeholder\":\"$undefined\",\"preload\":true,\"quality\":\"$undefined\",\"sizes\":\"(min-width: 1320px) 640px, (min-width: 1024px) 50vw, 64vw\",\"src\":\"https://cdn.sanity.io/images/cwuu6lx4/production/27ccccd270e73d5fd9dadf17cf8b5fb635013c53-2200x1466.jpg\",\"width\":1600}]]}]]}]}]}],\"$L2c\"]}]]]}]\n"])</script><script>self.__next_f.push([1,"2d:\"/_next/static/immutable/chunks/2bfi0kfoku0sc.js\"\n2e:\"/_next/static/immutable/chunks/03bfgnqubqh5s.js\"\n2f:\"ArticleSelectionSection\"\n30:I[830931,[\"$19\",\"$1a\",\"$1b\",\"$1c\",\"$2d\",\"$20\",\"$2e\"],\"$2f\"]\n2c:[\"$\",\"section\",\"75d69e3835e0\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L30\",null,{\"cta\":{\"href\":\"https://www.thisiseindhoven.com/en/see-and-do\",\"label\":\"Discover more\"},\"eyebrow\":\"See \u0026 Do\",\"fullBleed\":false,\"items\":[{\"description\":\"Planning a day trip or weekend getaway to Eindhoven? From practical information to the necessary inspiration, planning your trip starts here!\",\"href\":\"/en/see-and-do/plan-your-trip\",\"imageAlt\":\"Plan your trip\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/fbc51d665b8f6daff67a50514d2ce405003a08ff-2500x1875.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Practical info\",\"target\":\"$undefined\",\"title\":\"Plan your trip\"},{\"description\":\"Check out our culinary hotspots and discover what Eindhoven has to offer when it comes to food and drinks.\",\"href\":\"/en/see-and-do/food-and-drinks\",\"imageAlt\":\"Food \u0026 drinks\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/954c6dcca6730a2b3de93270bfc3f6bb8959dbaa-2048x1365.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Bars\",\"target\":\"$undefined\",\"title\":\"Food \u0026 drinks\"},{\"description\":\"What's more fun than a day trip to Eindhoven? A two-day trip to Eindhoven! Make the most of your visit with an overnight stay!\",\"href\":\"/en/see-and-do/hotels\",\"imageAlt\":\"Spend the night\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/7a73f4cce8322d9c2c1b779e3f8e9899f85f421d-1618x1080.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Hotels\",\"target\":\"$undefined\",\"title\":\"Spend the night\"},{\"description\":\"Eindhoven is the shopping city of the south of the Netherlands, offering high fashion, Dutch design, local markets, and vintage stores.\",\"href\":\"/en/see-and-do/shopping\",\"imageAlt\":\"Shopping in Eindhoven\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/e71c011ae3271359315757ffe8ec8adcb3855978-1920x1280.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Shopping\",\"target\":\"$undefined\",\"title\":\"Shopping in Eindhoven\"},{\"description\":\"Eindhoven is the perfect city to get your dose of culture and design. Visit our top museums, design studios, and art centers, and discover why we are the design capital of the Netherlands!\",\"href\":\"/en/see-and-do/culture-and-design\",\"imageAlt\":\"Culture \u0026 design\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Max Kneefel\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/92ab9b2681da9ab1835d523aeb8342dea5b63ed9-799x533.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"Culture \u0026 design\"}],\"labels\":{\"next\":\"Next\",\"previous\":\"Previous\",\"dotLabel\":\"Go to slide\",\"dotsAriaLabel\":\"Slide selector\",\"carouselLabel\":\"Articles carousel\"},\"theme\":\"beige\",\"title\":\"Inspiration for your Eindhoven adventure\",\"variant\":\"related\"}]}]\n"])</script><script>self.__next_f.push([1,"f:null\n15:[[\"$\",\"title\",\"0\",{\"children\":\"Philips' legacy in Eindhoven | This is Eindhoven\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"From the most ground-breaking Philips inventions to old factory buildings with creative new uses: this is Philips' legacy!\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://www.thisiseindhoven.com/en/city-life/about-eindhoven/philips-legacy-in-eindhoven\"}],[\"$\",\"link\",\"3\",{\"rel\":\"alternate\",\"hrefLang\":\"de\",\"href\":\"https://www.thisiseindhoven.com/de/stadsleven/over-eindhoven/philips-vermaechtnis-in-eindhoven\"}],[\"$\",\"link\",\"4\",{\"rel\":\"alternate\",\"hrefLang\":\"en\",\"href\":\"https://www.thisiseindhoven.com/en/city-life/about-eindhoven/philips-legacy-in-eindhoven\"}],[\"$\",\"link\",\"5\",{\"rel\":\"alternate\",\"hrefLang\":\"nl\",\"href\":\"https://www.thisiseindhoven.com/nl/stadsleven/over-eindhoven/philips-nalatenschap-in-eindhoven\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Philips' legacy in Eindhoven\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"From the most ground-breaking Philips inventions to old factory buildings with creative new uses: this is Philips' legacy!\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:locale\",\"content\":\"en\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image\",\"content\":\"https://cdn.sanity.io/images/cwuu6lx4/production/f503fe9f5b600339165024f95209b1c11efc0a15-1065x799.jpg\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:image:alt\",\"content\":\"Philips' legacy in Eindhoven\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:title\",\"content\":\"Philips' legacy in Eindhoven\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:description\",\"content\":\"From the most ground-breaking Philips inventions to old factory buildings with creative new uses: this is Philips' legacy!\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:image\",\"content\":\"https://cdn.sanity.io/images/cwuu6lx4/production/f503fe9f5b600339165024f95209b1c11efc0a15-1065x799.jpg\"}]]\n"])</script><script>self.__next_f.push([1,"31:\"HeroWithImageWide\"\n32:I[329237,[\"$19\",\"$1a\",\"$1b\",\"$1c\",\"$2d\",\"$20\",\"$2e\"],\"$31\"]\nc:[\"$\",\"div\",null,{\"className\":\"pb-20\",\"children\":[null,[null,[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-10 lg:gap-16\",\"children\":[[\"$\",\"section\",\"synth-0000\",{\"className\":\"scroll-mt-24\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L32\",null,{\"author\":\"Caya Forman\",\"backLink\":{\"href\":\"/en/city-life/about-eindhoven\",\"label\":\"Back to This is Eindhoven\"},\"bleedBackground\":true,\"cta\":\"$undefined\",\"date\":\"2026-03-26T00:00:00+01:00\",\"imageAlt\":\"Philips' legacy in Eindhoven\",\"imageObjectPosition\":\"$undefined\",\"imageSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/f503fe9f5b600339165024f95209b1c11efc0a15-1065x799.jpg\",\"imageTitle\":\"$undefined\",\"layout\":\"wide\",\"location\":\"$undefined\",\"mediaPosition\":\"right\",\"mobileHideMedia\":\"$undefined\",\"priority\":true,\"readTime\":\"8 min\",\"theme\":\"pink\",\"title\":\"Philips' legacy in Eindhoven\",\"videoUrl\":\"$undefined\",\"withBottomPadding\":\"$undefined\",\"withTopPadding\":\"$undefined\"}]}],[\"$\",\"section\",\"8626b6eb-4c2\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full px-2 md:w-[83.34%] lg:w-[66.67%] xl:w-full xl:max-w-[626px] pt-4 tie-rich-text\",\"data-testid\":\"rich-text-block-section\",\"children\":[[\"$\",\"p\",\"000n63\",{\"className\":\"text-intro tie-type-intro\",\"children\":[\"What Eindhoven would have looked like without Philips remains a mystery. What we do know for sure: the Philips family certainly left its mark on the city. And on the rest of the world too. From the most ground-breaking Philips inventions to old factory buildings with creative new uses: this is Philips' legacy!\"]}],[\"$\",\"h2\",\"000n65\",{\"children\":[\"Philips' most luminous inventions\"]}],[\"$\",\"p\",\"000n67\",{\"children\":[\"Philips is a major Dutch technology company. Originally based in Eindhoven, Philips made a great impact on the (back then) small city throughout the twentieth century. And over the past 130 years, the company has come up with quite a few clever gadgets. What important inventions do we have to thank them for? Discover a small selection here.\"]}],[\"$\",\"h3\",\"000n69\",{\"children\":[\"Next level light bulb\"]}],[\"$\",\"p\",\"000n6b\",{\"children\":[\"In 1915, Philips developed light bulbs filled with the gas argon. Previously the bulbs were made in a vacuum. By filling the bulb with argon, the filament lasted longer and burned brighter. The light bulbs weren’t super environmentally friendly yet, but it was a step in the right direction.\"]}],[\"$\",\"h3\",\"000n6d\",{\"children\":[\"Safer x-rays\"]}],[\"$\",\"p\",\"000n6f\",{\"children\":[\"In the 1920s, x-rays were not very safe. Especially for medical personnel, who were regularly exposed to the dangerous radiation. That’s why Philips came up with a metal casing for the x-ray tube that largely blocked the radiation: the Metalix.\"]}]]}]}],[\"$\",\"section\",\"3e924c86-c02\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1050px]\",\"data-testid\":\"image-block-section\",\"children\":[\"$\",\"figure\",null,{\"className\":\"m-0 min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative h-0 overflow-hidden pb-[72.52%] w-full\",\"style\":\"$undefined\",\"children\":[\"$\",\"$L2b\",null,{\"className\":\"absolute inset-0 h-full w-full object-cover\",\"title\":\"\",\"style\":\"$undefined\",\"alt\":\"Radio Philips Eindhoven\",\"blurDataURL\":\"$undefined\",\"fill\":true,\"loading\":\"$undefined\",\"placeholder\":\"$undefined\",\"preload\":false,\"quality\":\"$undefined\",\"sizes\":\"100vw\",\"src\":\"https://cdn.sanity.io/images/cwuu6lx4/production/b45cd8bd88aa8e5d5c4ef2e55c541752513b5d28-1025x683.jpg\"}]}],null]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-2 tie-type-body text-[18px] leading-6 [\u0026_a]:text-[var(--tie-theme-accent)] [\u0026_a]:underline lg:[\u0026_a:hover]:no-underline\",\"children\":\"Radio Philips Eindhoven\"}]]}]}]}],[\"$\",\"section\",\"96ad8489-c82\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full px-2 md:w-[83.34%] lg:w-[66.67%] xl:w-full xl:max-w-[626px] pt-4 tie-rich-text\",\"data-testid\":\"rich-text-block-section\",\"children\":\"$L33\"}]}],\"$L34\",\"$L35\",\"$L36\",\"$L37\",\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\"]}]]]}]\n"])</script><script>self.__next_f.push([1,"57:\"NewsletterSubscribeRenderer\"\n58:I[934756,[\"$19\",\"$1a\",\"$1b\",\"$1c\",\"$2d\",\"$20\",\"$2e\"],\"$57\"]\n33:[[\"$\",\"h3\",\"000n6h\",{\"children\":[\"Cozy street lights\"]}],[\"$\",\"p\",\"000n6j\",{\"children\":[\"That yellow-orange light that street lamps emit? Yep, also a Philips invention. In 1931, they came up with the Philora: a sodium gas discharge lamp. With that typical orange glow.\"]}],[\"$\",\"h3\",\"000n6l\",{\"children\":[\"Clean-shaven heads\"]}],[\"$\",\"p\",\"000n6n\",{\"children\":[\"An invention that’s sure to have saved us a lot of shaving cuts: the Philishave. In 1939, they developed the first electric shaver with a rotating head.\"]}],[\"$\",\"h3\",\"000n6p\",{\"children\":[\"TV experiments\"]}],[\"$\",\"p\",\"000n6r\",{\"children\":[\"In 1948, Philips broadcast the very first live television broadcast in the Netherlands. It was only received by a handful of televisions in and around Eindhoven. Mainly in the living rooms of Philips executives. What was the entertainment on 'Philips Experimental Television'? Singers, flower arranging, news reports, children's programs, feature films, a soccer game, and even the occasional advertisement. Announced in turns by a former radio announcer (then working in Philips' advertising department) and a Philips secretary.\"]}],[\"$\",\"h3\",\"000n6t\",{\"children\":[\"The cassette tape\"]}],[\"$\",\"p\",\"000n6v\",{\"children\":[\"A Philips engineer and his team developed the first cassette tape. In 1963, the first prototype appeared. With this small tape, suddenly anyone could put together their own music collection, create radio programs, or record and distribute a message.\"]}],[\"$\",\"h3\",\"000n6x\",{\"children\":[\"Better chips\"]}],[\"$\",\"p\",\"000n6z\",{\"children\":[\"Philips also had an important role in the wonderful world of computer chips. In the 1960s, they developed a pioneering technique (LOCOS: Localized Oxidation of Silicon) that made the chip-making process much more efficient.\"]}],[\"$\",\"h3\",\"000n71\",{\"children\":[\"Home video’s\"]}],[\"$\",\"p\",\"000n73\",{\"children\":[\"In 1971, Philips launched the first Video Cassette Recorder (VCR) for home use.\"]}],[\"$\",\"h3\",\"000n75\",{\"children\":[\"The wide-spread use of energy-saving light bulbs\"]}],[\"$\",\"p\",\"000n77\",{\"children\":[\"In the early 1980s, Philips began mass production of a special kind of lighting: the energy-saving light bulb. Later, in 2009, Philips and a few partners developed an even more energy-efficient variation: the LED lamp Luramic.\"]}],[\"$\",\"h3\",\"000n79\",{\"children\":[\"The good old CD\"]}],[\"$\",\"p\",\"000n7b\",{\"children\":[\"The compact disc was the love baby of Philips and the Japanese electronics company Sony. This 1.2-millimeter-thick disc was introduced in 1982. The CD ensured that we could store and listen to music digitally for the first time. A revolution in the music industry.\"]}],[\"$\",\"h3\",\"000n7d\",{\"children\":[\"3D skeletons\"]}],[\"$\",\"p\",\"000n7f\",{\"children\":[\"In 1998, Philips discovered that it was possible to create 3D X-ray images using a C-shaped arm that rotates around the patient. From then on you could get a really good look at your broken arm! A small comfort, but still.\"]}]]\n34:[\"$\",\"section\",\"9372d741-517\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1050px]\",\"data-testid\":\"image-block-section\",\"children\":[\"$\",\"figure\",null,{\"className\":\"m-0 min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative h-0 overflow-hidden pb-[72.52%] w-full\",\"style\":\"$undefined\",\"children\":[\"$\",\"$L2b\",null,{\"className\":\"absolute inset-0 h-full w-full object-cover\",\"title\":\"\",\"style\":\"$undefined\",\"alt\":\"Philips de Jongh Park opening 1949\",\"blurDataURL\":\"$undefined\",\"fill\":true,\"loading\":\"$undefined\",\"placeholder\":\"$undefined\",\"preload\":false,\"quality\":\"$undefined\",\"sizes\":\"100vw\",\"src\":\"https://cdn.sanity.io/images/cwuu6lx4/production/b7b387b781bb1860829e4e3786a638b66de0a192-2676x1785.jpg\"}]}],null]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-2 tie-type-body text-[18px] leading-6 [\u0026_a]:text-[var(--tie-theme-accent)] [\u0026_a]:underline lg:[\u0026_a:hover]:no-underline\",\"children\":\"Philips de Jongh Park opening 1949\"}]]}]}]}]\n35:[\"$\",\"section\",\"d4b5f524-931\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full px-2 md:w-[83.34%] lg:w-[66.67%] xl:w-full xl:max-w-[626px] pt-4 tie-rich-text\",\"data-testid\":\"rich-text-block-section\",\"children\":[[\"$\",\"h2\",\"000n7k\",{\"children\":[\"The Eindhoven innovation mentality\"]}],[\"$\",\"p\",\"000n7m\",{\"children\":[\"Nowadays, oldskool light bulbs and cassette tapes belong in \",[\"$\",\"a\",\"000n7o\",{\"href\":\"/en/locations/philips-historische-producten\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"museums\"]}],\". Philips' heyday in the City of Light is far behind us, gathering dust in twentieth-century history. Philips' headquarters even relocated to Amsterdam in 1997.\"]}],[\"$\",\"p\",\"000n7q\",{\"children\":[\"Yet Eindhoven is still the glowing center of innovation and technology. In the Netherlands and in the world. Think of \",[\"$\",\"a\",\"000n7s\",{\"href\":\"/en/locations/technical-university-eindhoven\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"TU/e\"]}],\", a university that attracts heaps of international talent every year. Or ASML (okay, technically in Veldhoven), the global star of the semiconductor industry. We managed that alright without Philips, didn't we? Well, not quite.\"]}],[\"$\",\"h3\",\"000n7u\",{\"children\":[\"Hungry for brains\"]}],[\"$\",\"p\",\"000n7w\",{\"children\":[\"In a way, we have Philips to thank for all those big brains at TU/e. In the mid-fifties, the company was in need of more well-educated workers. For all those new inventions, of course. The university was founded largely to meet that need. When it was first founded in 1965, it was still called Technische Hogeschool.\"]}],[\"$\",\"h3\",\"000n7y\",{\"children\":[\"Philips spin-off\"]}],[\"$\",\"p\",\"000n80\",{\"children\":[\"Not many people know that ASML is a kind of Philips spin-off. The chip machine maker came into being in the 1980s as a collaboration between Philips and ASM International. Together they wanted to bring a Philips chip machine to market. Today, ASML is one of the fastest-growing companies in the Netherlands, with a billion-dollar turnover.\"]}],[\"$\",\"h3\",\"000n82\",{\"children\":[\"High-tech hotspot\"]}],[\"$\",\"p\",\"000n84\",{\"children\":[[\"$\",\"a\",\"000n85\",{\"href\":\"/en/locations/high-tech-campus-eindhoven\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"The High Tech Campus\"]}],\" wouldn’t have existed without Philips either. The tech hub (consisting of 260 companies) once began as Philips' R\u0026D location. Now the area along the A2 motorway in Eindhoven is the ultimate hotspot for high-tech innovation. On a mission to become Europe's most sustainable campus.\"]}]]}]}]\n36:[\"$\",\"section\",\"897d4860-ed9\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1050px]\",\"data-testid\":\"image-block-section\",\"children\":[\"$\",\"figure\",null,{\"className\":\"m-0 min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative h-0 overflow-hidden pb-[72.52%] w-full\",\"style\":\"$undefined\",\"children\":[\"$\",\"$L2b\",null,{\"className\":\"absolute inset-0 h-full w-full object-cover\",\"title\":\"\",\"style\":\"$undefined\",\"alt\":\"Philips Stadium Eindhoven\",\"blurDataURL\":\"$undefined\",\"fill\":true,\"loading\":\"$undefined\",\"placeholder\":\"$undefined\",\"preload\":false,\"quality\":\"$undefined\",\"sizes\":\"100vw\",\"src\":\"https://cdn.sanity.io/images/cwuu6lx4/production/980425542f94bb1f30c369837ab3465187160aa4-1750x1167.jpg\"}]}],null]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-2 tie-type-body text-[18px] leading-6 [\u0026_a]:text-[var(--tie-theme-accent)] [\u0026_a]:underline lg:[\u0026_a:hover]:no-underline\",\"children\":\"Philips Stadium Eindhoven\"}]]}]}]}]\n37:[\"$\",\"section\",\"08438a96-2d7\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full px-2 md:w-[83.34%] lg:w-[66.67%] xl:w-full xl:max-w-[626px] pt-4 tie-rich-text\",\"data-testid\":\"rich-text-block-section\",\"children\":[[\"$\",\"h2\",\"000n8a\",{\"children\":[\"The first light bulb factory, the Philips Museum, and De Witte Dame\"]}],[\"$\",\"p\",\"000n8c\",{\"children\":[\"It all began on the Emmasingel, in the city center. There, Philips' first light bulb factory opened its doors. This small factory gave Eindhoven its nickname Eindhoven, Lichtstad, or City of Light!\"]}],[\"$\",\"p\",\"000n8e\",{\"children\":[\"The modest light bulb factory used to be the tallest building in Eindhoven. Its chimney towered high above the city. That same chimney now houses a permanent work of light art. Private Light by artist Titia Ex looks like a luminous cap, high atop the chimney. A little light that subtly draws attention to the very beginning of the Philips adventure.\"]}],[\"$\",\"h3\",\"000n8g\",{\"children\":[\"The White Lady\"]}],[\"$\",\"p\",\"000n8i\",{\"children\":[\"Later, when more and more light bulbs had to be made, the factory moved across the road. Philips had the iconic De Witte Dame (The White Lady) built as their new factory building. Today, De Witte Dame is a multifunctional building for design, art, knowledge, and technology. And one of Eindhoven's most iconic and instantly recognizable buildings. De Witte Dame symbolizes the changes Eindhoven has gone through over the years.\"]}],[\"$\",\"h3\",\"000n8k\",{\"children\":[\"The Philips Museum\"]}],[\"$\",\"p\",\"000n8m\",{\"children\":[\"Since 2001, the small, old light bulb factory opposite De Witte Dame has been a national monument. And also the home to \",[\"$\",\"a\",\"000n8o\",{\"href\":\"/en/locations/philips-museum\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"the Philips Museum\"]}],\". In the museum, you can experience the story behind the company first-hand. You can see the role Philips played in important social changes with your own eyes. First with electric light, later with radio, television, and finally in the digital age.\"]}],[\"$\",\"p\",\"000n8q\",{\"children\":[\"In 2011, the Philips Museum underwent a major renovation. In the process, the historic building received a new glass front. Inside, you can still see the original old equipment used for making the light bulbs.\"]}],[\"$\",\"h2\",\"000n8s\",{\"children\":[\"Green, green Eindhoven\"]}],[\"$\",\"p\",\"000n8u\",{\"children\":[\"Eindhoven is one of the greenest cities in the Netherlands. Why is that? Because Philips wanted healthy, happy employees. Frits Philips believed in the beneficial effect of plants and trees. He wanted his factory sites to be designed so that his employees would get a healthy dose of green on their way to work and back home.\"]}],[\"$\",\"p\",\"000n8w\",{\"children\":[\"Frits actually played an active role in this: he collected trees during his many travels and had them shipped to Eindhoven. This way, he not only ensured a nice view for his employees but also more biodiversity in the city.\"]}],[\"$\",\"p\",\"000n8y\",{\"children\":[\"Philips is even hidden in the names of a few parks. That's not for nothing. Those parks were once owned by the Philips family before they donated them to the city.\"]}],[\"$\",\"p\",\"000n90\",{\"children\":[\"For example, \",[\"$\",\"a\",\"000n92\",{\"href\":\"/en/locations/philips-van-lenneppark\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"the Philips van Lenneppark\"]}],\" was given to the city of Eindhoven by the Philips - Van Lennep family in 1964. The park is located between the highway to Tilburg and Poot van Metz.\"]}],\"$L3d\",\"$L3e\",\"$L3f\",\"$L40\",\"$L41\"]}]}]\n38:[\"$\",\"section\",\"1192f0a5-b39\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1050px]\",\"data-testid\":\"image-block-section\",\"children\":[\"$\",\"figure\",null,{\"className\":\"m-0 min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative h-0 overflow-hidden pb-[72.52%] w-full\",\"style\":\"$undefined\",\"children\":[\"$\",\"$L2b\",null,{\"className\":\"absolute inset-0 h-full w-full object-cover\",\"title\":\"Foto Twycer\",\"style\":\"$undefined\",\"alt\":\"Philips Museum Eindhoven\",\"blurDataURL\":\"$undefined\",\"fill\":true,\"loading\":\"$undefined\",\"placeholder\":\"$undefined\",\"preload\":false,\"quality\":\"$undefined\",\"sizes\":\"100vw\",\"src\":\"https://cdn.sanity.io/images/cwuu6lx4/production/daa7e22973ecb75977e5f41878c4708801e949e9-2048x1367.jpg\"}]}],null]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-2 tie-type-body text-[18px] leading-6 [\u0026_a]:text-[var(--tie-theme-accent)] [\u0026_a]:underline lg:[\u0026_a:hover]:no-underline\",\"children\":\"Philips Museum Eindhoven © Foto Twycer\"}]]}]}]}]\n39:[\"$\",\"section\",\"4cc0fbe3-91a\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full px-2 md:w-[83.34%] lg:w-[66.67%] xl:w-full xl:max-w-[626px] pt-4 tie-rich-text\",\"data-testid\":\"rich-text-block-section\",\"children\":[[\"$\",\"h2\",\"000n9y\",{\"children\":[\"Old factories infused with new life\"]}],[\"$\",\"p\",\"000na0\",{\"children\":[\"The beauty of Eindhoven is that the city has honored its past. The old Philips factory buildings haven’t simply been destroyed to make way for new construction. They still exist. And they have all been given a cool, new purpose.\"]}],[\"$\",\"h3\",\"000na2\",{\"children\":[\"Strijp-S\"]}],[\"$\",\"p\",\"000na4\",{\"children\":[\"Once an abandoned factory site, now one of Eindhoven's most vibrant neighborhoods. \",[\"$\",\"a\",\"000na6\",{\"href\":\"/en/locations/strijp-s\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Strijp-S\"]}],\" was once developed as an industrial area. Especially for Philips factories. But in recent years Strijp-S underwent a true transformation. After Philips left it became a hip and lively neighborhood. Full of unique stores, restaurants, offices, and many creative inhabitants. But with the industrial character of yesteryear.\"]}],[\"$\",\"h3\",\"000na8\",{\"children\":[\"Anton and Gerard\"]}],[\"$\",\"p\",\"000naa\",{\"children\":[\"Anton and Gerard, the large white buildings that people instantly think of when they hear Strijp-S, used to be factory buildings where all kinds of Philips products were made. Today they’re turned into residential buildings with beautiful lofts.\"]}],[\"$\",\"h3\",\"000nac\",{\"children\":[\"Klokgebouw\"]}],[\"$\",\"p\",\"000nae\",{\"children\":[\"When you spot \",[\"$\",\"a\",\"000nag\",{\"href\":\"/en/locations/klokgebouw\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Klokgebouw\"]}],\", you know you're near Strijp-S. The name of the tall building comes from the clock at the top of the tower. Philips left its mark on that too: the letters PHILIPSPILIHP tell us the time of day. The building was built in the late 1920s and this is where they made Philite, which is the Philips brand name for Bakelite.\"]}],[\"$\",\"p\",\"000nai\",{\"children\":[\"If you step into Klokgebouw now, you'll find the workspaces of more than 100 creative entrepreneurs. But if you listen carefully, you'll also hear music! Klokgebouw is a sought-after event venue and houses \",[\"$\",\"a\",\"000nak\",{\"href\":\"/en/locations/popei\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"PopEI\"]}],\": where musicians can practice their craft and play gigs. On the right side of the building, you’ll find \",[\"$\",\"a\",\"000nam\",{\"href\":\"/en/locations/blue-collar-hotel\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"the Blue Collar Hotel\"]}],\". This quirky hotel still has many elements from the Philips era. And also a touch of rock 'n roll.\"]}],[\"$\",\"h3\",\"000nao\",{\"children\":[\"Machinekamer\"]}],[\"$\",\"p\",\"000naq\",{\"children\":[\"Machinekamer (Engine Room) was once part of the Klokgebouw power plant. The building kept Strijp-S up and running. Now you'll find \",[\"$\",\"a\",\"000nas\",{\"href\":\"/en/locations/radio-royaal\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"restaurant Radio Royaal\"]}],\" on the top floor. 14.000 square feet of raw industrial design and French-German cuisine. Furthermore, the Machinekamer is home to \",[\"$\",\"a\",\"000nau\",{\"href\":\"/en/locations/pastryclub\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Pastry Club\"]}],\", and \",[\"$\",\"a\",\"000naw\",{\"href\":\"/en/locations/room108-gusj-market\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Room108 \u0026 Gusj Market\"]}],\".\"]}],[\"$\",\"h3\",\"000nay\",{\"children\":[\"Natlab\"]}],[\"$\",\"p\",\"000nb0\",{\"children\":[[\"$\",\"a\",\"000nb1\",{\"href\":\"/en/locations/natlab\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Natlab\"]}],\" was Philips' old physics laboratory. It's where the company’s scientists used to cook up all kinds of new inventions. Did you know that Albert Einstein once gave a lecture there?\"]}],\"$L42\",\"$L43\",\"$L44\",\"$L45\",\"$L46\",\"$L47\",\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\",\"$L4f\",\"$L50\",\"$L51\",\"$L52\",\"$L53\",\"$L54\",\"$L55\",\"$L56\"]}]}]\n3a:[\"$\",\"section\",\"category-buttons-6352\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"section\",null,{\"className\":\"mx-auto w-full max-w-[626px] tie-border-accent flex flex-col gap-4 border-y py-6\",\"data-testid\":\"category-buttons-section\",\"data-tie-theme\":\"pink\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"tie-type-eyebrow tie-color-accent m-0\",\"children\":\"Tags\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"a\",\"/en/search?searchterm=City+life-City life\",{\"className\":\"tie-type-button group inline-flex min-h-12 shrink-0 items-center justify-center px-4 py-3 no-underline focus-visible:tie-focus-ring transition-[background-color,border-color,color,opacity] duration-200 ease-in-out border-2 tie-border-accent tie-color-accent hover:[background-color:var(--tie-theme-accent)] hover:[color:var(--tie-theme-on-accent)]\",\"href\":\"/en/search?searchterm=City+life\",\"children\":[\"$\",\"span\",null,{\"children\":\"City life\"}]}],[\"$\",\"a\",\"/en/search?searchterm=History+of+Eindhoven-History of Eindhoven\",{\"className\":\"tie-type-button group inline-flex min-h-12 shrink-0 items-center justify-center px-4 py-3 no-underline focus-visible:tie-focus-ring transition-[background-color,border-color,color,opacity] duration-200 ease-in-out border-2 tie-border-accent tie-color-accent hover:[background-color:var(--tie-theme-accent)] hover:[color:var(--tie-theme-on-accent)]\",\"href\":\"/en/search?searchterm=History+of+Eindhoven\",\"children\":[\"$\",\"span\",null,{\"children\":\"History of Eindhoven\"}]}],[\"$\",\"a\",\"/en/search?searchterm=Culture+and+design-Culture and design\",{\"className\":\"tie-type-button group inline-flex min-h-12 shrink-0 items-center justify-center px-4 py-3 no-underline focus-visible:tie-focus-ring transition-[background-color,border-color,color,opacity] duration-200 ease-in-out border-2 tie-border-accent tie-color-accent hover:[background-color:var(--tie-theme-accent)] hover:[color:var(--tie-theme-on-accent)]\",\"href\":\"/en/search?searchterm=Culture+and+design\",\"children\":[\"$\",\"span\",null,{\"children\":\"Culture and design\"}]}],[\"$\",\"a\",\"/en/search?searchterm=Design-Design\",{\"className\":\"tie-type-button group inline-flex min-h-12 shrink-0 items-center justify-center px-4 py-3 no-underline focus-visible:tie-focus-ring transition-[background-color,border-color,color,opacity] duration-200 ease-in-out border-2 tie-border-accent tie-color-accent hover:[background-color:var(--tie-theme-accent)] hover:[color:var(--tie-theme-on-accent)]\",\"href\":\"/en/search?searchterm=Design\",\"children\":[\"$\",\"span\",null,{\"children\":\"Design\"}]}]]}]]}]}]\n3b:[\"$\",\"section\",\"4d35a309-063\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L58\",null,{\"component\":{\"_key\":\"4d35a309-063\",\"_type\":\"newsletterSubscription\",\"anchorMenu\":null,\"renderingVariant\":null,\"subscription\":{\"consentText\":null,\"hasThankYouPage\":true,\"privacyHref\":null,\"privacyLinkLabel\":null,\"submitLabel\":null,\"thankYouPath\":\"/en/newsletter-thanks\",\"theme\":\"pink\",\"title\":\"Be the first to stay up to date\"}},\"locale\":\"en\",\"pageTheme\":\"pink\"}]}]\n3c:[\"$\",\"section\",\"600e1080-f1a\",{\"className\":\"scroll-mt-24 px-4 md:px-6 lg:px-5 min-[1440px]:px-0\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L30\",null,{\"cta\":\"$undefined\",\"eyebrow\":\"Districts\",\"fullBleed\":false,\"items\":[{\"description\":\"A strong example of industrial heritage turned into a lively district. The former 'forbidden city' Strijp-S is cooler and more accessible than ever.\",\"href\":\"/en/see-and-do/dynamic-districts/strijp-s\",\"imageAlt\":\"Strijp-S\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/a713974e9e937f96e0778f1e2ebd198615bcf3b1-2048x1365.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Strijp-S\",\"target\":\"$undefined\",\"title\":\"Strijp-S\"},{\"description\":\"Piet Hein Eek has his factory, shop, restaurant, exhibition space and event location in the former Philips ceramic workplace.\",\"href\":\"/en/locations/piet-hein-eek\",\"imageAlt\":\"Piet Hein Eek\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Jeroen Aarts\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/241b9b0df4ab924cfa84ab1731dbb5c77e977b03-1800x1200.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Design\",\"target\":\"$undefined\",\"title\":\"Piet Hein Eek\"},{\"description\":\"The Ketelhuis is open from morning to evening. You can enjoy nice breakfasts, lunches and various snacks later in the day.\",\"href\":\"/en/locations/ketelhuis\",\"imageAlt\":\"Ketelhuis\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Max Kneefel\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/84ba1e91850b753623cc2d82e56377ebf0af8c7c-2048x1365.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Restaurants\",\"target\":\"$undefined\",\"title\":\"Ketelhuis\"},{\"description\":\"MU is an adventurous guide for anyone interested in contemporary art mixed with design, fashion, music, architecture and new media.\",\"href\":\"/en/locations/mu-hybrid-art-house\",\"imageAlt\":\"MU Hybrid Art House\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"$undefined\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/a1baf4cad7277c5843e4ead1e3369d3d16e93ade-2048x1365.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"Art spaces\",\"target\":\"$undefined\",\"title\":\"MU Hybrid Art House\"},{\"description\":\"Delve into the world of gastronomic ice cream, patisserie, and extraordinary tea and coffee specialties at Intelligentia Taste Rooms.\",\"href\":\"/en/locations/intelligentia\",\"imageAlt\":\"Intelligentia ICE by Jeffrey\",\"imageObjectPosition\":\"$undefined\",\"imageTitle\":\"Max Kneefel\",\"imgSrc\":\"https://cdn.sanity.io/images/cwuu6lx4/production/321fc117db55209bb171790a9fa3b59d28ec777c-1920x1280.jpg\",\"readMoreText\":\"Read more\",\"rel\":\"$undefined\",\"tag\":\"$undefined\",\"target\":\"$undefined\",\"title\":\"Intelligentia ICE by Jeffrey\"}],\"labels\":{\"next\":\"Next\",\"previous\":\"Previous\",\"dotLabel\":\"Go to slide\",\"dotsAriaLabel\":\"Slide selector\",\"carouselLabel\":\"Articles carousel\"},\"theme\":\"pink\",\"title\":\"The best of Strijp\",\"variant\":\"related\"}]}]\n"])</script><script>self.__next_f.push([1,"3d:[\"$\",\"p\",\"000n94\",{\"children\":[\"In 1920, Anton Philips and his wife Anna Philips de Jongh gave a park to the municipality. You can find \",[\"$\",\"a\",\"000n96\",{\"href\":\"/en/locations/philips-de-jongh-wandelpark\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"the Philips de Jongh Wandelpark\"]}],\" in the Strijp district, near Landgoed de Wielewaal. The estate where the Philips family used to live.\"]}]\n3e:[\"$\",\"p\",\"000n98\",{\"children\":[\"That estate will soon be part of the public greenery too. The municipality wants to eventually open Landgoed de Wielewaal, where Frits Philips lived from 1934 until he died in 2005, to all Eindhoven residents. The estate is 350 acres in size.\"]}]\n3f:[\"$\",\"h2\",\"000n9a\",{\"children\":[\"From kicking the ball around with co-workers to Memphis Depay\"]}]\n40:[\"$\",\"p\",\"000n9c\",{\"children\":[\"We all know PSV. The Dutch soccer club is famous around the globe. A lesser-known fact is that PSV stands for Philips Sport Vereniging (Philips Sports Association). The sports club was founded in 1913, especially for Philips employees. Only after 1928 were people from outside the company allowed to join in.\"]}]\n41:[\"$\",\"p\",\"000n9e\",{\"children\":[\"What once began as a sports club has grown into one of the Netherlands' most successful soccer clubs. Over the years, PSV played with top international players like Cocu, Van Nistelrooy, Robben, Wijnaldum and Memphis Depay. All thanks to Philips' first kick-off in 1913.\"]}]\n42:[\"$\",\"p\",\"000nb3\",{\"children\":[\"Now the building has little to do with physics, and everything to do with culture and film. Natlab is the place to be for arthouse films, theater, and talk shows. You can also come to enjoy great food and have some drinks.\"]}]\n43:[\"$\",\"h2\",\"000nb5\",{\"children\":[\"More great architecture and cool buildings\"]}]\n44:[\"$\",\"p\",\"000nb7\",{\"children\":[\"When it comes to architecture, the company left behind much more than some old factory buildings. Find out which other cool buildings were part of Philips history.\"]}]\n45:[\"$\",\"h3\",\"000nb9\",{\"children\":[\"Philipsdorp \u0026 Drents Dorp\"]}]\n46:[\"$\",\"p\",\"000nbb\",{\"children\":[\"Drents? But this article is about Eindhoven, right? You’re right. Philips attracted a lot of personnel from the province of Drenthe. To accommodate all those people from Drenthe in Eindhoven, Philips built a neighborhood for them in the 1920s. Hence the name Drents Dorp. The typical workers' houses built back then are still there.\"]}]\n47:[\"$\",\"p\",\"000nbd\",{\"children\":[\"Another ten years earlier, Philipsdorp was built in the Strijp neighborhood. Also aiming to give employees of the fast-growing factory a place of their own.\"]}]\n48:[\"$\",\"h3\",\"000nbf\",{\"children\":[\"Evoluon\"]}]\n49:[\"$\",\"p\",\"000nbh\",{\"children\":[\"Some have been there as children when \",[\"$\",\"a\",\"000nbj\",{\"href\":\"/en/locations/next-nature-museum\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Evoluon\"]}],\" was still an educational technology museum. But since 1996, this iconic UFO has been a convention center and event venue. The wacky-looking building was gifted to the city by Philips in 1966 when the company celebrated its 75th anniversary. Good news for people who long for those good old days: with the exposition Next Nature, you can now return to the future of yesteryear.\"]}]\n4a:[\"$\",\"h3\",\"000nbl\",{\"children\":[\"Philips Stadium\"]}]\n4b:[\"$\",\"p\",\"000nbn\",{\"children\":[\"It started with a small field between the city and the factories of Strijp-S. That was where Philips built a sports park for the residents of the Philipsdorp neighborhood. Now \",[\"$\",\"a\",\"000nbp\",{\"href\":\"/en/locations/philips-stadion-psv\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"the Philips Stadium (or PSV stadium)\"]}],\" is the home of the world-famous soccer club PSV. It’s a stadium that holds more than 35,000 visitors.\"]}]\n4c:[\"$\",\"h3\",\"000nbr\",{\"children\":[\"The Philips Observatory\"]}]\n4d:[\"$\",\"p\",\"000nbt\",{\"children\":[\"In 1935, the Eindhoven Weather and Astronomy Circle was founded. In the beginning, it mostly attracted Philips employees with a love of weather and astronomy. When the society decided it wanted its \",[\"$\",\"a\",\"000nbv\",{\"href\":\"/en/locations/dr-a-f-philips-sterrenwacht\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"own observatory\"]}],\", it was built in the Stadswandelpark. In 1938 they laid the first stone of the observatory, designed by Philips architect Louis Kalff.\"]}]\n4e:[\"$\",\"h3\",\"000nbx\",{\"children\":[\"Villa de Laak\"]}]\n4f:[\"$\",\"p\",\"000nbz\",{\"children\":[\"One of the most striking buildings in the district of Tongelre is \",[\"$\",\"a\",\"000nc1\",{\"href\":\"/en/locations/huize-de-laak\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Huize (or Villa) de Laak\"]}],\". Built in 1907, the villa was commissioned by Anton Philips, who lived there with his wife Henriëtte. Unfortunately, the house is not freely accessible. But from the Parklaan you can get a good look at the villa.\"]}]\n50:[\"$\",\"h2\",\"000nc3\",{\"children\":[\"Strijp T + R\"]}]\n51:[\"$\",\"p\",\"000nc5\",{\"children\":[\"After Strijp-S, Philips also built factory sites Strijp-T and Strijp-R. The intention was to add Strijp-IJ and Strijp-P to the list, but it never came to that.\"]}]\n52:[\"$\",\"h3\",\"000nc7\",{\"children\":[\"Strijp-T\"]}]\n53:[\"$\",\"p\",\"000nc9\",{\"children\":[\"Once the power plant that supplied Philips factories with energy, nowadays \",[\"$\",\"a\",\"000ncb\",{\"href\":\"/en/locations/strijp-t\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Strijp-T\"]}],\" is a breeding ground for design and innovation. It has become a hub for all kinds of innovative Eindhoven businesses.\"]}]\n54:[\"$\",\"h3\",\"000ncd\",{\"children\":[\"Strijp-R and Piet Hein Eek\"]}]\n55:[\"$\",\"p\",\"000ncf\",{\"children\":[\"A stone's throw from Strijp-T you’ll find \",[\"$\",\"a\",\"000nch\",{\"href\":\"/en/locations/strijp-r\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Strijp-R\"]}],\". Around the area is the Zoompark, a legacy of Frits Philips, who believed that Philips employees would thrive in a green environment. At Strijp-R you can visit, among other places, the RK complex, the former Philips ceramic workshop. Years ago radios and televisions were made here. It is one of the few buildings that remained in this area after Philips' departure.\"]}]\n56:[\"$\",\"p\",\"000ncj\",{\"children\":[\"Strijp-R is now the home of designer \",[\"$\",\"a\",\"000ncl\",{\"href\":\"/en/locations/piet-hein-eek\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Piet Hein Eek\"]}],\". You can visit \",[\"$\",\"a\",\"000ncn\",{\"href\":\"/en/locations/shop-showroom-piet-hein-eek\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"the workshop and showroom of this world-famous designer\"]}],\". Would you like to take a piece of Piet home with you? Lucky you. There’s also a Piet Hein Eek shop. And as icing on the cake, you can also eat in \",[\"$\",\"a\",\"000ncp\",{\"href\":\"/en/locations/lobby-restaurant\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"Piet Hein Eek's restaurant\"]}],\", or spend a night in \",[\"$\",\"a\",\"000ncr\",{\"href\":\"/en/locations/hotel-piet-hein-eek\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"his design hotel\"]}],\"! You’ll also find several other creative companies and design studios at Strijp-R.\"]}]\n"])</script></body></html>