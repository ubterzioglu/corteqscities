    var klokIcon = {
    url: '/assets/svg/pin-klokgebouw.svg',
    scaledSize: new google.maps.Size(70, 70),
    };

    var treinIcon = {
    url: '/assets/svg/pin-trein-wit.svg',
    scaledSize: new google.maps.Size(70, 70),
    };

    var autoIcon = {
    url: '/assets/svg/pin-auto-wit.svg',
    scaledSize: new google.maps.Size(70, 70),
    };

    var busIcon = {
    url: '/assets/svg/pin-bus-wit.svg',
    scaledSize: new google.maps.Size(70, 70),
    };
	
    //add locations
    var locations = [
        ['Klokgebouw', 51.448877, 5.457877, klokIcon],
        ['Station Strijp-S', 51.45081108, 5.45632124, treinIcon],
        ['Station Eindhoven', 51.443391, 5.479171, treinIcon],
        ['Parkeergarage Klokgebouw 498 plekken', 51.448068, 5.458692, autoIcon],
        ['Parkeerveld Philitelaan 144 plekken', 51.445794, 5.461975, autoIcon],
