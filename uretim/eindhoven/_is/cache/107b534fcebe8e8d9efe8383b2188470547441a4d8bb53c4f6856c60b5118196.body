                        <div id="configuration" data-logged-out-url='/nl/mijncbr/eigen-digid-sessie-is-beeindigd'
     data-osh-analytics-template-url="https://cbr.innocraft.cloud/matomo.php?idsite=1&rec=1&action_name=[actionOverride]&dimension1=[verintId]&url=https://www.cbr.nl"></div>
