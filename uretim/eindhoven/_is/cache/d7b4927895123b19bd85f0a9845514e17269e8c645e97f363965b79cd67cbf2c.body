den op het programma: De 2-wekelijks Mixed wedstrijden op dinsdag. Inschrijven kan vanaf handicap 45. De ene keer spelen...\",\"firstPublishedDate\":\"2026-05-28T20:48:21.619Z\",\"lastPublishedDate\":\"2026-05-28T20:48:21.619Z\",\"url\":{\"base\":\"https:\/\/www.golfdetongelreep.nl\",\"path\":\"\/post\/wedstrijdkalender-2026\"},\"slug\":\"wedstrijdkalender-2026\",\"featured\":false,\"pinned\":false,\"categoryIds\":[\"d0b7c8a2-f4bc-4fa1-af65-2e7d97d371ea\"],\"memberId\":\"92992c41-c4ae-4f7b-b0d5-0f5685b99972\",\"hashtags\":[],\"commentingEnabled\":true,\"postCountInfo\":{\"comments\":1,\"likes\":0,\"views\":341},\"minutesToRead\":2,\"tagIds\":[],\"relatedPostIds\":[],\"pricingPlanIds\":[],\"language\":\"nl\",\"metrics\":{\"comments\":1,\"likes\":0,\"views\":341,\"totalRatings\":0,\"averageRating\":0},\"contentId\":\"6a18aa15c2da9ec2684a8d52\",\"mostRecentContributorId\":\"92992c41-c4ae-4f7b-b0d5-0f5685b99972\",\"media\":{\"wixMedia\":{\"image\":{\"id\":\"a1146b_8f106a24f08c41b5a8e465d59f0b9d80~mv2.jpg\",\"url\":\"https:\/\/static.wixstatic.com\/media\/a1146b_8f106a24f08c41b5a8e465d59f0b9d80~mv2.jpg\",\"height\":425,\"width\":850,\"filename\":\"Wedstrijdkalender.jpg\"}},\"displayed\":true,\"custom\":false},\"translations\":[],\"customExcerpt\":false,\"internalCategoryIds\":[],\"internalRelatedPostIds\":[],\"isLiked\":false,\"isSubscribed\":false,\"owner\":{\"activityStatus\":\"UNKNOWN\",\"contactId\":\"92992c41-c4ae-4f7b-b0d5-0f5685b99972\",\"id\":\"92992c41-c4ae-4f7b-b0d5-0f5685b99972\",\"name\":\"brigittebeyer58\",\"privacyStatus\":\"PUBLIC\",\"siteMemberId\":\"92992c41-c4ae-4f7b-b0d5-0f5685b99972\",\"slug\":\"brigitte-beyer58\",\"status\":\"UNKNOWN\",\"isBlocked\":false,\"isOwner\":false},\"preview\":false,\"link\":\"https:\/\/www.golfdetongelreep.nl\/post\/wedstrijdkalender-2026\"}],\"metaData\":{\"count\":3,\"offset\":0,\"total\":0,\"cursor\":\"\"},\"pagingMetaData\":{\"count\":3,\"offset\":0,\"total\":0,\"cursors\":{\"next\":\"\",\"previous\":\"\"}}},\"categori