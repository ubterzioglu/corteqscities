comp-lfzkb70t2":"ClassicSection","comp-kcvsf92b":"StripColumnsContainer","comp-kcvsf93d":"Column","DYNAMIC_STRUCTURE_CONTAINER":"DynamicStructureContainer","site-root":"DivWithChildren","main_MF":"DivWithChildren","c1dmp_wrapper":"PageMountUnmount","c1dmp_wrapper_background":"PageMountUnmount"}},"appsWarmupData":{"14bcded7-0066-7c35-14d7-466cb3f09103":{"post-list-comp-kcvmjjr7-undefined-d0b7c8a2-f4bc-4fa1-af65-2e7d97d371ea-undefined-nl-3":"{\"response\":{\"data\":{\"postFeedPage\":{\"id\":\"\",\"currentUser\":{\"activityStatus\":0,\"privacyStatus\":0,\"status\":0,\"isBlocked\":false,\"isOwner\":false,\"appStore\":{\"14bcded7-0066-7c35-14d7-466cb3f09103\":{\"permissions\":{\"role\":\"undefined\"}}}},\"posts\":{\"posts\":[{\"id\":\"b7f506fd-e91b-4931-894f-620661e5b84f\",\"title\":\"En toen kleurde de baan en clubhuis ineens helemaal Marshalblauw........\",\"excerpt\":\"Wat een dag!  Op maandag 21 september jl kleurde de baan volledig blauw tijdens de jaarlijkse Marshalwedstrijd.   Met een goed gevuld startveld, strak in het Marshal blauw-tenue, werd er om 15.30 uur met een shotgun  gestart.   Onder perfecte leiding van wedstrijdleidster Jos Wittenberg verliep alles op rolletjes. Vlot spel, veel sportiviteit en de bekende marshal-discipline: geen flight liep uit. De stableford-formule zorgde voor spanning tot de laatste putt.   Na binnenkomst wachtte in het...\",\"firstPublishedDate\":\"2026-09-22T13:51:33.000Z\",\"lastPublishedDate\":\"2026-09-22T13:51:33.000Z\",\"url\":{\"base\":\"https:\/\/www.golfdetongelreep.nl\",\"path\":\"\/post\/en-toen-kleurde-de-baan-en-clubhuis-ineens-helemaal-marshalblauw\"},\"slug\":\"en-toen-kleurde-de-baan-en-clubhuis-ineens-helemaal-marshalblauw\",\"featured\":false,\"pinned\":false,\"categoryIds\":[\"d0b7c8a2-f4bc-4fa1-af65-2e7d97d371ea\"],\"memberId\":\"b45f20ce-c0a9-496c-9337-2058b4e2f9da\",\"hashtags\":[],\"commentingEnabled\":true,\"postCountInfo\":{\"comments\":0,\"likes\":0,\"views\":27},\"minutesToRead\":1,\"tagIds\":[],\"relatedPostIds\":[],\"pricingPlanIds\":[],\"language\":\"nl\",\"metrics\":{\"comments\":0,\"likes\":0,\"views\":27,\"totalRatings\":0,\"averageRating\":0},\"contentId\":\"6ac8d9fc86e1da51f6fbf7d6\",\"mostRecentContributorId\":\"92992c41-c4ae-4f7b-b0d5-0f5685b99972\",\"media\":{\"wixMedia\":{\"image\":{\"id\":\"2a3a8d_87041502252f422482dbcc6b5d8f8852~mv2.png\",\"url\":\"https:\/\/static.wixstatic.com\/media\/2a3a8d_87041502252f422482dbcc6b5d8f8852~mv2.png\",\"height\":709,\"width\":945,\"filename\":\"image.png\"}},\"displayed\":true,\"custom\":false},\"translations\":[],\"customExcerpt\":false,\"internalCategoryIds\":[],\"internalRelatedPostIds\":[],\"isLiked\":false,\"isSubscribed\":false,\"owner\":{\"activityStatus\":\"UNKNOWN\",\"contactId\":\"b45f20ce-c0a9-496c-9337-2058b4e2f9da\",\"id\":\"b45f20ce-c0a9-496c-9337-2058b4e2f9da\",\"name\":\"alfonsvanmeer\",\"privacyStatus\":\"PUBLIC\",\"siteMemberId\":\"b45f20ce-c0a9-496c-9337-2058b4e2f9da\",\"slug\":\"alfonsvanmeer29697\",\"status\":\"UNKNOWN\",\"isBlocked\":false,\"isOwner\":false},\"preview\":false,\"link\":\"https:\/\/www.golfdetongelreep.nl\/post\/en-toen-kleurde-de-baan-en-clubhuis-ineens-helemaal-marshalblauw\"},{\"id\":\"ddaff398-e5c0-4eb2-916d-99a3ae0bc723\",\"title\":\"Nieuws van de Baancommissie\",\"excerpt\":\"Vanaf zondag 23 augustus bespelen we onze nieuwe baan. Voor ons een mooie tussenstap in dit omvangrijke project maar bovenal een feestje voor ons allemaal! Ten aanzien van het spel de komende periode een aantal mededelingen waarvoor wij jullie aandacht vragen:   We gaan 3 kleuren vlaggen op de greens plaatsen, rood voorop, blauw midden en geel achterop. We hebben afstandspalen geplaatst op 100 meter van midden green (deze palen worden nog vervangen voor andere). Er zijn een aantal nieuwe...\",\"firstPublishedDate\":\"2026-08-21T05:46:26.661Z\",\"lastPublishedDate\":\"2026-08-21T05:46:26.661Z\",\"url\":{\"base\":\"https:\/\/www.golfdetongelreep.nl\",\"path\":\"\/post\/nieuws-van-de-baancommissie\"},\"slu