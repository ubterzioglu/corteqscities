52~mv2.png/v1/fill/w_305,h_229,fp_0.50_0.50,q_95,enc_avif,quality_auto/2a3a8d_87041502252f422482dbcc6b5d8f8852~mv2.webp" loading="lazy" style="width:100%;height:100%"/></picture></div></div></div><div class="gallery-item-common-info-outer [object Object]" style="height:199px;box-sizing:content-box"><div style="overflow:hidden;box-sizing:border-box;width:100%;height:199px" class="gallery-item-common-info gallery-item-bottom-info"><div class="RiOfiW pu51Xe lyd6fK blog-post-description-font blog-text-color blog-card-background-color blog-card-border-color post-list-item blog-post-post-list-border-color blog-post-post-list-post-container blog-post-post-list-background-color _UH27m" style="border-width:0;--wix-blog-inline-padding:24px" data-hook="post-list-item"><div style="padding-left:24px;padding-right:24px" class="iSTCpN lyd6fK post-list-item-wrapper blog-post-post-list-description-font blog-post-post-list-description-color blog-post-post-list-description-fill"><div class="uYL9xS"><div class="JMCi2v blog-post-post-list-link-hashtag-hover-color so9KdE lyd6fK"><a class="O16KGI pu51Xe lyd6fK xs2MeC" href="https://www.golfdetongelreep.nl/post/en-toen-kleurde-de-baan-en-clubhuis-ineens-helemaal-marshalblauw"><div style="font-size:18px" class="FbwBsX blog-post-title-font lyd6fK xs2MeC HhgCcE" data-hook="post-list-item__title"><div class="T5UMT5 fcPJ4D blog-hover-container-element-color I9XQQf post-title blog-post-post-list-title-color blog-post-post-list-title-font" style="font-size:18px" data-hook="post-title"><h2 class="bD0vt9 KNiaIk" style="-webkit-line-clamp:2">En toen kleurde de baan en clubhuis ineens helemaal Marshalblauw........</h2></div></div></a><div class="CHRJex JMCi2v pu51Xe lyd6fK xs2MeC"><div style="font-size:16px" class="nebVix lyd6fK blog-post-description-style-font blog-post-post-list-description-style-font mABNle HhgCcE" data-hook="post-description"><div class="wR7PET"><div class="BOlnTh" style="-webkit-line-clamp:3">Wat een dag!  Op maandag 21 september jl kleurde de baan volledig blauw tijdens de jaarlijkse Marshalwedstrijd.   Met een goed gevuld startveld, strak in het Marshal blauw-tenue, werd er om 15.30 uur met een shotgun  gestart.   Onder perfecte leiding van wedstrijdleidster Jos Wittenberg verliep alles op rolletjes. Vlot spel, veel sportiviteit en de bekende marshal-discipline: geen flight liep uit. De stableford-formule zorgde voor spanning tot de laatste putt.   Na binnenkoms</div></div></div></div></div></div><div class="NPsER6 lyd6fK kzwb6t zwuMcM"><span class="tmHsxH TE7que lyd6fK blog-post-post-list-description-background-color"></span><div style="font-size:12px"><div data-hook="post-footer" class="NT9zC5 blog-post-description-font blog-post-post-list-description-color blog-post-post-list-description-fill blog-post-post-list-description-font post-footer blog-post-post-list-description-font blog-post-post-list-description-color"><div class="PsEy9r"><div class="E54HWO post-stats" data-hook="post-stats"><div data-hook="skeleton-loader" class="bEeZ1_" style="--width:30px"> </div></div></div></div></div></div></div></div></div></div></div></div><div data-id="ddaff398-e5c0-4eb2-916d-99a3ae0bc723" class="item-link-wrapper" data-idx="1" data-hook="item-link-wrapper" tabindex="-1"><div class="gallery-item-container item-container-regular has-custom-focus visible" id="pgiddaff398e5c04eb2916d99a3ae0bc723_1" data-hash="ddaff398-e5c0-4eb2-916d-99a3ae0bc723" data-id="ddaff398-e5c0-4eb2-916d-99a3ae0bc723" data-idx="1" data-hook="item-container" style="overflow-y:hidden;position:absolute;bottom:auto;margin:0;top:0;left:337px;right:auto;width:306px;height:427.75px;overflow:hidden;border-width:1px;border-color:rgba(232,230,230,0.75);border-style:solid;transition:opacity .2s ease;opacity:0;display:none"><div data-idx="1" id="item-action-ddaff398-e5c0-4eb2-916d-99a3ae0bc723" class="item-action" tabindex="-1" data-hook="item-action" aria-label="Nieuws van de Baancommissie"></div><div><div data-hook="item-wrapper" clas