wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"}, "url": "https://upload.wikimedia.org/wikipedia/commons/4/47/Natuur_in_Eindhoven_-_Meerhoven.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:Natuur_in_Eindhoven_-_Meerhoven.jpg", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=35794483", "sha1": "7044d81ea7b707a0d00db7025d5dacbe93cccc65", "extmetadata": {"DateTime": {"value": "2014-09-30 12:53:23", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "Natuur in Eindhoven - Meerhoven", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Parks in Eindhoven|Self-published work|Water in Eindhoven|2014 in Eindhoven|Netherlands photographs taken on 2014-09-27|Taken with Samsung GT-I9505", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Natuur in Eindhoven - Meerhoven", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2014-09-27 14:58:43", "source": "commons-desc-page"}, "Credit": {"value": "<span class=\"int-own-work\" lang=\"en\">Own work</span>", "source": "commons-desc-page"}, "Artist": {"value": "<a href=\"//commons.wikimedia.org/w/index.php?title=User:Dennal&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:Dennal (page does not exist)\">Dennal</a>", "source": "commons-desc-page"}, "LicenseShortName": {"value": "CC BY-SA 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution-Share Alike 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by-sa/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-sa-4.0", "source": "commons-templates", "hidden": ""}}, "mime": "image/jpeg"}]}, {"pageid": 88223432, "ns": 6, "title": "File:990331 Wim Vandekeybus web (programmaboekje).pdf", "imagerepository": "local", "imageinfo": [{"size": 1902521, "width": 668, "height": 1154, "pagecount": 23, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/990331_Wim_Vandekeybus_web_%28programmaboekje%29.pdf/page1-500px-990331_Wim_Vandekeybus_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1600, "thumbheight": 2764, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/990331_Wim_Vandekeybus_web_%28programmaboekje%29.pdf/page1-500px-990331_Wim_Vandekeybus_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1600, "height": 2764}, "url": "https://upload.wikimedia.org/wikipedia/commons/c/c6/990331_Wim_Vandekeybus_web_%28programmaboekje%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:990331_Wim_Vandekeybus_web_(programmaboekje).pdf", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=88223432", "sha1": "cf3fb150ff47b3ce5afc40ea27d082672ed897ea", "extmetadata": {"DateTime": {"value": "2020-03-17 17:08:02", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "990331 Wim Vandekeybus web (programmaboekje)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Uploaded with pattypan|Media contributed by deSingel|Program booklets from deSingel", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Kracht en snelheid, een energieke en hoogst fysieke dans-taal, een feilloze timing en vertrouwen in instinctieve en onbewuste reacties: het zijn sleutelbegrippen in de dans-taal van Wim Vandekeybus. Tien jaar geleden maakte hij zijn eerste voorstelling, 'What the body does not remember', en verwierf er internationale bekendheid mee. Vandekeybus had zijn succesformule kunnen herhalen, maar niets is minder waar: de formule veranderde, het succes bleef. Stond in de eerste producties het lichaam centraal, later werden de voorstellingen bewuster rond inhoudelijke thema's opgebouwd. Het conflict tussen man en vrouw, tussen zien en niet zien in 'Her body doesn't fit her soul', de hallucinatie en de waanzin in 'Mountains made of barking', het onbewuste in 'Bereft of a blissful union' en het bijgeloof in '7 for a Secret never to be told'. De voorstellingen van Wim Vandekeybus versmelten op een onnavolgbare manier muziek, dans, theater en film. Beweging is nooit louter dans: 'In mijn kop zit heel wat meer, zoveel dingen zijn zoveel inspirerender: een foto, een stuk tekst, een filmfragment, gelijk wat, als het me maar raakt, als het mijn fantasie maar stoffeert.' De laatste jaren treedt het medium film steeds meer op de voorgrond in zijn voorstellingen. In 'Immer das Selbe gelogen' was film nog een registratie: een gevoelig portret van de Hamburgse kunstenaar Carlo Verano. De kortfilm 'Elba and Federico' in 'Her body doesn't fit her soul', die een prijs wegkaapte op het Brusselse filmfestival, zit op de grens tussen fictie en realiteit. De filmthema's zijn een aanvulling van wat op de scène gebeurt. In 'Bereft of a blissful union' roepen de filmbeelden een totaal ander universum op: ze spelen zich af onder de waterspiegel die in feite een reusachtig schapenvel blijkt te zijn. Film is zeer belangrijk voor Vandekeybus: 'Ik begon als fotograaf, en het verlangen om terug te keren naar die achtergrond en te werken met de specifieke mogelijkheden van het medium film, heb ik steeds gevoeld. Bovendien denk ik dat mijn films bijdragen tot de spankracht van mijn voorstellingen: wat op de scène gebeurt, heeft bij momenten iets heel concreets en directs, wat je op het scherm ziet, is minder anekdotisch, behoort duidelijker tot het tijdloze en imaginaire. En een fractie van een seconde later is het precies omgekeerd.' Zijn camera beweegt even chaotisch en vervaarlijk als de dansers op het podium. Energie en rust wisselen elkaar af. Ook in de nieuwe productie speelt film een grote rol. Nog meer dan voordien ligt de nadruk op de confrontatie tussen de filmprojectie en de scène. Wat is echt, wat is onecht? Een personage in een film of de acteur of danser op de scène? Filmbeelden roepen een  aparte wereld op, zoals de irrationele wereld en de prachtige Marokkaanse landschappen in de film in 'Mountains made of barking'. Ze voegen ook een eigen tijdsdimensie toe: beelden kunnen vertraagd of versneld worden, bevroren of vermenigvuldigd. Bovendien staat film voor licht, kunstmatig licht, en licht betekent schaduw. Wat is de invloed van licht? Hoe gedragen mensen zich als het altijd nacht is? En als het altijd dag is? In de zomer, in de winter? De eigenlijke repetities starten in december, de première vindt drie maanden later plaats in Ferrara en diezelfde maand nog staat deze productie in deSingel. Ondertussen zal Vandekeybus ook het script van zijn eerste langspeelfilm beëindigd hebben: een ervaring die ongetwijfeld invloed zal hebben op zijn nieuwe creatie.", "source": "commons-desc-page"}, "Credit": {"value": "deSingel, <a rel=\"nofollow\" class=\"external free\" href=\"http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s8sAAB.pdf\">http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s8sAAB.pdf</a>", "source": "commons-desc-page"}, "Artist": {"value": "<bdi><a href=\"https://en.wikipedia.org/wiki/en:DeSingel\" class=\"extiw\" title=\"w:en:DeSingel\"><span title=\"arts center in Antwerp\">deSingel</span></a>\n</bdi>", "source": "commons-desc-page"}, "Permission": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://desingel.be/en/info/copyright\">https://desingel.be/en/info/copyright</a>", "source": "commons-desc-page", "hidden": ""}, "LicenseShortName": {"value": "CC BY 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-4.0", "source": "commons-templates", "hidden": ""}}, "mime": "application/pdf"}]}, {"pageid": 88245585, "ns": 6, "title": "File:990327 Symfonieorkest van de Munt web (programmaboekje).pdf", "imagerepository": "local", "imageinfo": [{"size": 1094802, "width": 668, "height": 1145, "pagecount": 13, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/990327_Symfonieorkest_van_de_Munt_web_%28programmaboekje%29.pdf/page1-500px-990327_Symfonieorkest_van_de_Munt_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1600, "thumbheight": 2743, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/990327_Symfonieorkest_van_de_Munt_web_%28programmaboekje%29.pdf/page1-500px-990327_Symfonieorkest_van_de_Munt_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1600, "height": 2743}, "url": "https://upload.wikimedia.org/wikipedia/commons/c/cd/990327_Symfonieorkest_van_de_Munt_web_%28programmaboekje%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:990327_Symfonieorkest_van_de_Munt_web_(programmaboekje).pdf", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=88245585", "sha1": "98e592ad2cf6e0669d32515bd3d61dcba9f5e420", "extmetadata": {"DateTime": {"value": "2020-03-18 13:01:24", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "990327 Symfonieorkest van de Munt web (programmaboekje)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Uploaded with pattypan|Media contributed by deSingel|Program booklets from deSingel", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Het magistrale <a href=\"https://fr.wikipedia.org/wiki/R%C3%A9veil_des_oiseaux\" class=\"extiw\" title=\"fr:Réveil des oiseaux\">Réveil des Oiseaux</a> (1953) is het eerste en in zekere zin het meest radicale ornithologische werk van <a href=\"https://nl.wikipedia.org/wiki/Olivier_Messiaen\" class=\"extiw\" title=\"nl:Olivier Messiaen\">Olivier Messiaen</a> (1908-1992). Het bestaat volledig uit vogelstemmen die je op een lange lentenacht in heel Frankrijk kan horen. Pianist en orkest moeten de talloze kwetterende en zingende vogels zo getrouw mogelijk nabootsen. Een fascinerende opgave en boeiende ervaring voor zowel toehoorders als uitvoerende musici. De Hymne au Saint Sacrement is een vroeg werk van de Franse meester en is opgebouwd uit twee thema's, het ene 'gemodereerd', het andere 'en coup de vent'.  De nu bijna veertigjarige Britse componist George Benjamin was reeds enkele jaren geleden in deSingel te gast met de creatie van zijn werk Sudden Time. Voor die gelegenheid dirigeerde hij het Koninklijk Filharmonisch Orkest van Vlaanderen. Nu staat hij voor het orkest van de Munt met een vroeger en een gloednieuw werk. Ringed by the Flat Horizon dat bij een van de prestigieuze BBC Promenade Concerts voor het eerst werd uitgevoerd, kende een enorm succes. Viola-viola is een pingpongspel voor twee altviolen en orkest. Het is een typisch werk van Benjamin: het is krachtig en kent een verloop met de precisie van een fijne Engelse klok.", "source": "commons-desc-page"}, "Credit": {"value": "deSingel, <a rel=\"nofollow\" class=\"external free\" href=\"http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s97AAB.pdf\">http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s97AAB.pdf</a>", "source": "commons-desc-page"}, "Artist": {"value": "<bdi><a href=\"https://en.wikipedia.org/wiki/en:DeSingel\" class=\"extiw\" title=\"w:en:DeSingel\"><span title=\"arts center in Antwerp\">deSingel</span></a>\n</bdi>", "source": "commons-desc-page"}, "Permission": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://desingel.be/en/info/copyright\">https://desingel.be/en/info/copyright</a>", "source": "commons-desc-page", "hidden": ""}, "LicenseShortName": {"value": "CC BY 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-4.0", "source": "commons-templates", "hidden": ""}}, "mime": "application/pdf"}]}, {"pageid": 88246508, "ns": 6, "title": "File:990312 Il Seminario Musicale web (programmaboekje).pdf", "imagerepository": "local", "imageinfo": [{"size": 1025919, "width": 666, "height": 1143, "pagecount": 15, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/4/42/990312_Il_Seminario_Musicale_web_%28programmaboekje%29.pdf/page1-500px-990312_Il_Seminario_Musicale_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1600, "thumbheight": 2746, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/4/42/990312_Il_Seminario_Musicale_web_%28programmaboekje%29.pdf/page1-500px-990312_Il_Seminario_Musicale_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1600, "height": 2746}, "url": "https://upload.wikimedia.org/wikipedia/commons/4/42/990312_Il_Seminario_Musicale_web_%28programmaboekje%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:990312_Il_Seminario_Musicale_web_(programmaboekje).pdf", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=88246508", "sha1": "56a6fcf9f116176220dd58967960f59d4d507d94", "extmetadata": {"DateTime": {"value": "2020-03-18 13:46:46", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "990312 Il Seminario Musicale web (programmaboekje)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Uploaded with pattypan|Media contributed by deSingel|Program booklets from deSingel", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Gérard Lesne en zijn groep Il Seminario Musicale concentreren zich bij voorkeur op muziek uit het Italiaanse en Franse repertoire van de zeventiende en achttiende eeuw. Hoofdmoot vormen in dit concert de drie Leçons des morts van Sébastien de Brossard (1655-1730). Brossard was geestelijke, auteur van het eerste Franse woordenboek van de muziek, theoreticus, didacticus, bibliofiel én componist. Hij studeerde in Parijs en was achtereenvolgens maître de chapelle van de kathedraal van Straatsburg en van Meaux.  De Leçons des morts maken deel uit van een in 1724 aan de koning aangeboden verzameling motetten voor twee stemmen, instrumenten en basso continuo. Samen met François Couperin blijkt Brossard een meester in het samenvoegen van het Franse met het Italiaanse idioom. Van de Italiaanse madrigalisten heeft hij de subtiele kunst overgeërfd de muziek te verbinden met de betekenis van de gezongen tekst. Dat maakt dat de grondstemming van deze muziek weliswaar innig en melancholisch is, doch door de afwisseling in schriftuur nooit monotoon of zwaar op de hand overkomt. Zo wordt het geheel, ondanks het thema, mede door die prachtige versmelting van de stemmen van sopraan en countertenor, gegarandeerd een ware streling voor het oor.", "source": "commons-desc-page"}, "Credit": {"value": "deSingel, <a rel=\"nofollow\" class=\"external free\" href=\"http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8sBfAAJ.pdf\">http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8sBfAAJ.pdf</a>", "source": "commons-desc-page"}, "Artist": {"value": "<bdi><a href=\"https://en.wikipedia.org/wiki/en:DeSingel\" class=\"extiw\" title=\"w:en:DeSingel\"><span title=\"arts center in Antwerp\">deSingel</span></a>\n</bdi>", "source": "commons-desc-page"}, "Permission": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://desingel.be/en/info/copyright\">https://desingel.be/en/info/copyright</a>", "source": "commons-desc-page", "hidden": ""}, "LicenseShortName": {"value": "CC BY 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-4.0", "source": "commons-templates", "hidden": ""}}, "mime": "application/pdf"}]}, {"pageid": 88246547, "ns": 6, "title": "File:990505 Quatuor Mosaiques web (programmaboekje).pdf", "imagerepository": "local", "imageinfo": [{"size": 841409, "width": 668, "height": 1150, "pagecount": 11, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/990505_Quatuor_Mosaiques_web_%28programmaboekje%29.pdf/page1-500px-990505_Quatuor_Mosaiques_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1600, "thumbheight": 2754, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/990505_Quatuor_Mosaiques_web_%28programmaboekje%29.pdf/page1-500px-990505_Quatuor_Mosaiques_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1600, "height": 2754}, "url": "https://upload.wikimedia.org/wikipedia/commons/3/36/990505_Quatuor_Mosaiques_web_%28programmaboekje%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:990505_Quatuor_Mosaiques_web_(programmaboekje).pdf", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=88246547", "sha1": "8aceb61548cb388c3ee847d399e7cd7cedd24c35", "extmetadata": {"DateTime": {"value": "2020-03-18 13:48:41", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "990505 Quatuor Mosaiques web (programmaboekje)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Uploaded with pattypan|Media contributed by deSingel|Program booklets from deSingel", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Met dit derde concert laten we de vader van het strijkkwartet aan het woord: Joseph Haydn. Het Strijkkwartet opus 76 nr 3 in C behoort tot zijn latere scheppingsperiode. Het dankt zijn bijnaam Kaiserquartett aan het overbekende thema met variaties dat de kern van het werk uitmaakt: de eenvoudige volksmelodie Gott erhalte Franz den Kaiser. Deze groeide uit tot de Oostenrijkse keizerlijke hymne en is thans de melodie van het Duitse volkslied. Toch heeft dit werk geen storende patriottische of oorlogszuchtige bijklank.  Verzaking en weemoed spreken ook uit het tweede geprogrammeerde kwartet van Haydn, het strijkkwartet opus 103. Het werd niet voltooid (slechts twee delen zijn af) en kreeg bij zijn publicatie in 1806 Haydns woorden van diens visitekaartje mee: 'Hin ist alle meine Kraft, alt und schwach bin ich'. Van resignatie kan bij het Strijkkwartet nr 14 in cis, opus 131 van Ludwig van Beethoven geen sprake zijn. Velen houden dit monument van zeven in elkaar overvloeiende delen voor het meest gewaagde en meest vernieuwende strijkkwartet dat ooit geschreven werd. Superlatieven te over dus én een uitdaging zowel voor de uitvoerders, het op authentieke instrumenten spelende Quatuor Mosaïques, als voor ons trouwe deSingel-publiek.", "source": "commons-desc-page"}, "Credit": {"value": "deSingel, <a rel=\"nofollow\" class=\"external free\" href=\"http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s8EAAR.pdf\">http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s8EAAR.pdf</a>", "source": "commons-desc-page"}, "Artist": {"value": "<bdi><a href=\"https://en.wikipedia.org/wiki/en:DeSingel\" class=\"extiw\" title=\"w:en:DeSingel\"><span title=\"arts center in Antwerp\">deSingel</span></a>\n</bdi>", "source": "commons-desc-page"}, "Permission": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://desingel.be/en/info/copyright\">https://desingel.be/en/info/copyright</a>", "source": "commons-desc-page", "hidden": ""}, "LicenseShortName": {"value": "CC BY 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-4.0", "source": "commons-templates", "hidden": ""}}, "mime": "application/pdf"}]}, {"pageid": 88249828, "ns": 6, "title": "File:990525 Philippe Herreweghe web (programmaboekje).pdf", "imagerepository": "local", "imageinfo": [{"size": 1054940, "width": 664, "height": 1150, "pagecount": 15, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/6/66/990525_Philippe_Herreweghe_web_%28programmaboekje%29.pdf/page1-500px-990525_Philippe_Herreweghe_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1600, "thumbheight": 2771, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/6/66/990525_Philippe_Herreweghe_web_%28programmaboekje%29.pdf/page1-500px-990525_Philippe_Herreweghe_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1600, "height": 2771}, "url": "https://upload.wikimedia.org/wikipedia/commons/6/66/990525_Philippe_Herreweghe_web_%28programmaboekje%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:990525_Philippe_Herreweghe_web_(programmaboekje).pdf", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=88249828", "sha1": "4986c472a5d5d8eb87e098dca600ef565571a193", "extmetadata": {"DateTime": {"value": "2020-03-18 16:25:26", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "990525 Philippe Herreweghe web (programmaboekje)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Uploaded with pattypan|Media contributed by deSingel|Program booklets from deSingel", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Thema van deze tweede avond met Philippe Herreweghe en Collegium Vocale is de hemelvaart van Christus.  De cantate Gott fähret auf mit Jauchzen, BWV 43, is gecomponeerd voor Onze-Lieve-Heer-Hemelvaart. Het is een complex werk, waarin Bach zijn hele vernuft in het inzetten van de verschillende stemmen laat zien. De prachtige cantate Sie werden euch in den Bann tun, BWV 44, was bestemd voor de eerste zondag na hemelvaartsdag en opent met verzen uit het evangelie volgens Johannes.  Het Himmelfahrtsoratorium, BWV 11, is lange tijd ten onrechte bij de cantates geklasseerd. Toch werd het voor het eerst in Leipzig in 1735 onder de titel Oratorium Festo Ascensionis Christi uitgevoerd. Bach weet hier op de hem onnavolgbare wijze uitdrukking te geven aan wat je terecht gemengde gevoelens mag noemen: de smart en zelfs bitterheid van zijn discipelen nu Christus hen gaat verlaten en tegelijkertijd de vreugde en jubilerende toon die bij een ten hemelstijging past.", "source": "commons-desc-page"}, "Credit": {"value": "deSingel, <a rel=\"mw:ExtLink nofollow\" href=\"http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s7fAAB.pdf\" class=\"external free\">http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s7fAAB.pdf</a>", "source": "commons-desc-page"}, "Artist": {"value": "<bdi><a rel=\"mw:WikiLink/Interwiki\" href=\"https://en.wikipedia.org/wiki/en:DeSingel\" title=\"w:en:DeSingel\" class=\"extiw\"><span title=\"arts center in Antwerp\">deSingel</span></a>\n</bdi>", "source": "commons-desc-page"}, "Permission": {"value": "<a rel=\"mw:ExtLink nofollow\" href=\"https://desingel.be/en/info/copyright\" class=\"external text\">https://desingel.be/en/info/copyright</a>", "source": "commons-desc-page", "hidden": ""}, "LicenseShortName": {"value": "CC BY 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-4.0", "source": "commons-templates", "hidden": ""}}, "mime": "application/pdf"}]}, {"pageid": 88255287, "ns": 6, "title": "File:990420 Edouard Lock web (programmaboekje).pdf", "imagerepository": "local", "imageinfo": [{"size": 1541319, "width": 681, "height": 1152, "pagecount": 17, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/990420_Edouard_Lock_web_%28programmaboekje%29.pdf/page1-500px-990420_Edouard_Lock_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1600, "thumbheight": 2707, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/990420_Edouard_Lock_web_%28programmaboekje%29.pdf/page1-500px-990420_Edouard_Lock_web_%28programmaboekje%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1600, "height": 2707}, "url": "https://upload.wikimedia.org/wikipedia/commons/d/d3/990420_Edouard_Lock_web_%28programmaboekje%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:990420_Edouard_Lock_web_(programmaboekje).pdf", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=88255287", "sha1": "2a8d21838d497fafbb339df13492ca0ed3ed9219", "extmetadata": {"DateTime": {"value": "2020-03-18 21:15:17", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "990420 Edouard Lock web (programmaboekje)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Uploaded with pattypan|Media contributed by deSingel|Program booklets from deSingel", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Het dansidioom van Edouard Lock, choreograaf van La La La Human Steps, kende sinds het ontstaan van dit Canadese dansgezelschap in 1980, heel wat navolging. Geen enkele postmoderne dans uit de jaren tachtig was zo verbonden met de rockcultuur, haar rauwe klanken, haar fragmentatie, haar tijdsconcept. Zijn dansers voerden de klassieke danssequensen - entrechats, bournonvilles - uit als waren zij gedreven door een wervelwind, zo obstinaat en krachtig dat de lucht eromheen pure energie leek. Hun lichamen maakten zich meester van de ruimte, schoven over elkaar - het ene lichaam moest noodzakelijk het andere vertrouwen - , ergens halverwege in de lucht ontmoetten ze elkaar, horizontaal, diagonaal. Seconden later kwam het lichaam trefzeker naar beneden, raakte eventjes de dansvloer, rolde en stormde vooruit. Sinds hun Europese doorbraak met 'Human Sex', dat bij ons te zien was een jaar na de creatie in 1985, presenteerden we elke nieuwe productie: 'New Demons' (1987), 'Infante, C'est destroy' (1991) en '2' (1992).  Zoals zovelen van zijn tijdgenoten is Edouard Lock gefascineerd door de deconstructie van de vorm. De dans in het concept van Edouard Lock tast het begrip van het primaire lichaam, het lichaam in rust, aan. Locks dans veroorzaakt instabiliteit. Wat hij beoogt is een minder symmetrisch, meer genuanceerd kijken naar het lichaam, een begrijpen dat meer overeenstemt met onze menselijke complexiteit. Het publiek wordt achtergelaten met een aaneenschakeling van momenten waarbij het lichaam zich voordoet als een vervormde en onvolledige landkaart, als een kubistisch schilderij. Bij het maken van zijn choreografieën concentreert Lock zich deels op de snelheid van de bewegingen en deels op het detail. Zijn dans is een celebratie van het lichaam in zijn meest vitale aspect: zijn vermogen om zichzelf te overstijgen. Het lichaam als een ijle, flitsende icoon. 'De gewaarwording dat je lichaam je niet helemaal toebehoort, wat toch een basisgegeven is, is misschien een manier om onze mogelijkheden te herontdekken.' Lock genoot een opleiding als cineast. Beelden spelen dan ook een belangrijke rol in zijn dansproducties. Zijn films zitten vaak als een huid over de voorstelling en breken het helse ritme van de dans door het tonen van vertraagde bewegingen. Bovendien spelen zij met het detail als een evocatie van het leven in close-up, als een moment van poëzie en reflectie. 'Een gulden middenweg wordt pas duidelijk als de uitersten worden getoond', aldus Lock. Door de jaren heen is hij wellicht wat milder geworden. Begin jaren negentig was er nog het sensueel brutale  'Infante, C'est destroy'. Met '2' onderzocht hij het proces van veroudering en aftakeling en daarmee impliciet de humaniteit achter de moderne technologie en de virtuositeit van zijn uitmuntende dansers. Uit de partituur van deze productie onthouden we de combinatie van barokcomponist Jean-Philippe Rameau met het rockgeweld van Iggy Pop en de minimalistische klanken van Gavin Bryars. De nieuwe productie van La La La Human Steps gaat in première in oktober 1998 in Tokyo. Gavin Bryars duikt opnieuw op, evenals Stephane Roy en Liz Vandal die eerder al de scenografie voor het gezelschap verzorgden.", "source": "commons-desc-page"}, "Credit": {"value": "deSingel, <a rel=\"nofollow\" class=\"external free\" href=\"http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s8iAAB.pdf\">http://s3.eu-central-1.amazonaws.com/desingel-media/a1ib000000D8s8iAAB.pdf</a>", "source": "commons-desc-page"}, "Artist": {"value": "<bdi><a href=\"https://en.wikipedia.org/wiki/en:DeSingel\" class=\"extiw\" title=\"w:en:DeSingel\"><span title=\"arts center in Antwerp\">deSingel</span></a>\n</bdi>", "source": "commons-desc-page"}, "Permission": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://desingel.be/en/info/copyright\">https://desingel.be/en/info/copyright</a>", "source": "commons-desc-page", "hidden": ""}, "LicenseShortName": {"value": "CC BY 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-4.0", "source": "commons-templates", "hidden": ""}}, "mime": "application/pdf"}]}, {"pageid": 112592319, "ns": 6, "title": "File:Eindhoven, wijk Meerhoven, buurt Meerrijk met op de achtergrond Zandrijk.jpg", "imagerepository": "local", "imageinfo": [{"size": 3051002, "width": 5568, "height": 3132, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2b/Eindhoven%2C_wijk_Meerhoven%2C_buurt_Meerrijk_met_op_de_achtergrond_Zandrijk.jpg/1920px-Eindhoven%2C_wijk_Meerhoven%2C_buurt_Meerrijk_met_op_de_achtergrond_Zandrijk.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=t