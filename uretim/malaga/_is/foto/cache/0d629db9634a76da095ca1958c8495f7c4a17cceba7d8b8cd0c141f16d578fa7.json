orturl": "https://commons.wikimedia.org/w/index.php?curid=145380746", "sha1": "4c6f126b98498f76379b99d77d4f7c6fe4055630", "extmetadata": {"DateTime": {"value": "2024-02-15 15:41:15", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "Reproduction of the Mosaic of the Café Central de Málaga 02", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Self-published work|Azulejos in Málaga|FoP-Spain|Files with coordinates missing SDC location of creation|Photos by User:Dcapillae|2024 in Málaga|Museo de Arte Flamenco, Málaga|Daniel García Romero|Mosaics in Málaga", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "GPSLatitude": {"value": "36.723150", "source": "commons-desc-page"}, "GPSLongitude": {"value": "-4.419180", "source": "commons-desc-page"}, "GPSMapDatum": {"value": "WGS-84", "source": "commons-desc-page", "hidden": ""}, "ImageDescription": {"value": "Vista del mosaico que acompaña a la reproducción del año 2023 del mosaico original que se encontraba en el antiguo Café Central, realizada a mano por García Romero Estudio Creativo, en la fachada de la Peña Juan Breva, en el número 4 de la calle Ramón Franquelo, Málaga, España. La reproducción representa las formas de pedir el café en Málaga. En el mosaico inferior (en imagen), bajo un escudo de la ciudad de Málaga, se lee: «Este singular forma de pedir café en / Málaga la inventó José Prado Crespo en el año 1954, / propietario del Café Central en la plaza de la Constitución 11, / quien al ver la indefinición de los clientes al pedir el café, / decidió poner orden dando nombres / a la cantidad de café y leche para no desperdiciar / ambos productos, escasos en aquellos tiempos, / añadiendo ese toque de gracia que se ha convertido / en parte del hablar cotidiano de los malagueños. / Sus continuadores, la familia Prado Fernández Baca, / ceden el mosaico original al Excmo. Ayuntamiento de Málaga / para que perduren estas simpáticas denominaciones / que distingue a los malagueños / allá donde vayan».", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2024-02-15 10:31:52", "source": "commons-desc-page"}, "Credit": {"value": "<span class=\"int-own-work\" lang=\"en\">Own work</span>", "source": "commons-desc-page"}, "Artist": {"value": "<a href=\"//commons.wikimedia.org/wiki/User:Dcapillae\" title=\"User:Dcapillae\">Daniel Capilla</a>", "source": "commons-desc-page"}, "LicenseShortName": {"value": "CC BY-SA 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution-Share Alike 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "Attribution": {"value": "Daniel Capilla", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by-sa/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-sa-4.0", "source": "commons-templates", "hidden": ""}}, "mime": "image/jpeg"}]}, {"pageid": 145380763, "ns": 6, "title": "File:Peña Juan Breva 01.jpg", "imagerepository": "local", "imageinfo": [{"size": 1824687, "width": 4000, "height": 3000, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Pe%C3%B1a_Juan_Breva_01.jpg/1280px-Pe%C3%B1a_Juan_Breva_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1280, "thumbheight": 960, "responsiveUrls": {"2": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Pe%C3%B1a_Juan_Breva_01.jpg/3840px-Pe%C3%B1a_Juan_Breva_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/common