": "extension", "hidden": ""}, "Categories": {"value": "Bust to Juan Estrada Castro (Pimentel, 2000)|Self-published work|Files with coordinates missing SDC location of creation|Photos by User:Dcapillae|2023 in Málaga", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "GPSLatitude": {"value": "36.729440", "source": "commons-desc-page"}, "GPSLongitude": {"value": "-4.421720", "source": "commons-desc-page"}, "GPSMapDatum": {"value": "WGS-84", "source": "commons-desc-page", "hidden": ""}, "ImageDescription": {"value": "Firma de Jaime Pimental en el busto conmemorativo de Juan Estrada Castro, obra en bronce del año 2000, situada en la iglesia de la Divina Pastora y Santa Teresa, en la plaza de Capuchinos, Málaga, España. El busto se asienta sobre un pedestal de piedra en el que se sitúa una placa donde se lee: «\"No hagas el mal y el mal no caerá sobre ti\" / Rd. Dn. Juan Estrada Castro / 1erPárroco de la Divina Pastora y Sta. Teresa de Jesús / 6 Enero 1951 + 30 Abril 1974 / Málaga 24 Junio 2000».", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2023-03-29 16:02:36", "source": "commons-desc-page"}, "Credit": {"value": "<span class=\"int-own-work\" lang=\"en\">Own work</span>", "source": "commons-desc-page"}, "Artist": {"value": "<a href=\"//commons.wikimedia.org/wiki/User:Dcapillae\" title=\"User:Dcapillae\">Daniel Capilla</a>", "source": "commons-desc-page"}, "LicenseShortName": {"value": "CC BY-SA 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution-Share Alike 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "Attribution": {"value": "Daniel Capilla", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by-sa/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-de