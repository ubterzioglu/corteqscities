{"entry_id": "sevilla:iglesia-de-san-andres", "city_id": "sevilla", "slug": "iglesia-de-san-andres", "title": "Iglesia de San Andrés", "subtitle": "Santa Marta kardeşliğinin haftalık ibadetini yaptığı mahalle kilisesi; Plaza de San Andrés, Sevilla", "summary": "San Andrés, Archidiócesis de Sevilla'nın kültür varlığı (BIC) kiliseleri listesinde yer alan mahalle kilisesidir ve Plaza de San Andrés 3 adresindedir. Hermandad de Santa Marta burada ibadet eder. Tapınak normal dönemde pazartesi 18.30-20.30, salıdan cumartesiye 11.00-13.00 ve 18.30-20.30, pazar ve dinî bayramlarda 11.00-12.30 arasında açıktır. Yaz saatleri farklıdır: temmuzda pazartesi 18.30-20.15; 30 Temmuz-15 Ağustos salıdan pazara yalnız 11.00-12.15; 16-31 Ağustos salı, cumartesi ve pazar 10.30-12.15.", "keywords": "Iglesia de San Andrés, Plaza de San Andrés, Hermandad de Santa Marta, Sevilla kilise, BIC", "stages": "planning;new;settled", "source_ids": "sevilla:kaynak:531;sevilla:kaynak:474", "reviewed_on": "2026-10-25", "order": 8002, "featured": "Hayır", "editorial_status": "Taslak", "group": "Tarih ve mimari", "district": "Casco Antiguo", "setting": "Kapalı alan", "location": "Plaza de San Andrés, 3, 41003 Sevilla", "latitude": 37.394335, "longitude": -5.993967, "visit_status": "", "note": "Salı akşamları Santa Marta kardeşliğinin haftalık ayini 20.30'da yapılır.", "collection": "Hayır", "media_key": "", "_sekme": "Mekânlar", "kaynaklar": [{"source_id": "sevilla:kaynak:531", "url": "https://www.archisevilla.org/iglesia/templo-parroquial-san-andres/", "publisher": "Archidiócesis de Sevilla", "text_file": "C:\\temp_private\\corteqs\\0000_newera\\uretim\\sevilla\\_is\\snap_mekan8-yazar1\\8f3392d7f8c779a1508918f500d37dfd4bf3b661d4c81a1248baa9623be77938.txt"}, {"source_id": "sevilla:kaynak:474", "url": "https://www.archisevilla.org/horarios-de-apertura-de-los-bienes-bic-de-la-iglesia-sevilla-capital/", "publisher": "Archidiócesis de Sevilla (archisevilla.org)", "text_file": "C:\\temp_private\\corteqs\\0000