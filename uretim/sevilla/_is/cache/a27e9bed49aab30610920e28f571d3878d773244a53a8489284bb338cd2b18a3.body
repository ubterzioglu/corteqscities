	<script>
	function desplegarMenu1(){
		if(document.getElementById('menuMovil1').style.display=="none"){
		ocultarMenuMovil(1);
		document.getElementById('menuMovil1').style.display="block";
		}else{
			ocultarMenuMovil(1);
		}
	}

	function desplegarMenu2(){
		if(document.getElementById('menuMovil2').style.display=="none"){
		ocultarMenuMovil(2);
		document.getElementById('menuMovil2').style.display="block";
		}else{
			ocultarMenuMovil(2);
		}
	}

	function desplegarMenu3(){
		if(document.getElementById('menuMovil3').style.display=="none"){
		ocultarMenuMovil(3);
		document.getElementById('menuMovil3').style.display="block";
		}else{
			ocultarMenuMovil(3);
		}
	}

	function desplegarMenu4(){
		if(document.getElementById('menuMovil4').style.display=="none"){
		ocultarMenuMovil(4);
		document.getElementById('menuMovil4').style.display="block";
		}else{
			ocultarMenuMovil(4);
		}
	}

	function ocultarMenuMovil(id){
		if(id!=1){
		document.getElementById('menuMovil1').style.display="none";
		}
		if(id!=2){
		document.getElementById('menuMovil2').style.display="none";
		}
		if(id!=3){
		document.getElementById('menuMovil3').style.display="none";
		}
		if(id!=4){
		document.getElementById('menuMovil4').style.display="none";
		}
	}
	</script>
