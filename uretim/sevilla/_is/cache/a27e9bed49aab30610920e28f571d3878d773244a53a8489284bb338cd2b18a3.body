<!-- Boton arriba -->
<a class="homeArriba" javascript:void(0) title="Volver arriba"  href="#inicio"><img alt="boton para ir al principio de la pagina" class="logoSubir ir-arriba icon-arrow-up2" src="https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/iconoArribaVerdeoscuro.png"></a>
<!-- Fin boton arriba -->

<script type="text/javascript">


		var abrir = 0;

		$(".menu-icon").click(function() {

			if (abrir == 0) {
				$(this).toggleClass("opened");
				$('.menuInteriorBlogMovil').css('display', 'block');
				abrir++;
			}else if (abrir == 1){
				$(this).toggleClass("opened");
				$('.menuInteriorBlogMovil').css('display', 'none');
				abrir--;
			}
	}
);


	$(document).ready(function(){ //Hacia arriba
		irArriba();
	});

	function irArriba(){
		$('.ir-arriba').click(function(){ $('body,html').animate({ scrollTop:'0px' },1000); });
		$(window).scroll(function(){
			if($(this).scrollTop() > 0){ $('.ir-arriba').slideDown(600); }else{ $('.ir-arriba').slideUp(600); }
		});
		$('.ir-abajo').click(function(){ $('body,html').animate({ scrollTop:'1000px' },1000); });
	}
</script>

