<script>
<br />
<b>Warning</b>:  Undefined variable $elementosVisibles in <b>/furanet/sites/hospitalmacarena.es/web/htdocs/wp-content/themes/genesis-sample/interior_blog.php</b> on line <b>745</b><br />
<br />
<b>Warning</b>:  Undefined variable $numeroTotalCuadros in <b>/furanet/sites/hospitalmacarena.es/web/htdocs/wp-content/themes/genesis-sample/interior_blog.php</b> on line <b>749</b><br />
// numero de cuadros que se van a visualizar al comienzo
var visibles = 0;
var numeroTotalCuadros = 0;
var noticias_actual=1;

if (visibles == 4 && numeroTotalCuadros <= 4) {
	document.getElementById('boton_siguiente_noticias').style.visibility = "hidden";
}else if(visibles == 6 && numeroTotalCuadros <= 6){
	document.getElementById('boton_siguiente_noticias').style.visibility = "hidden";
}

var noti1=1;var noticia_anterior_1=0;var noti2=2;var noticia_anterior_2=0;var noti3=3;var noticia_anterior_3=0;var noti4=4;var noticia_anterior_4=0;var noti5=5;var noticia_anterior_5=0;var noti6=6;var noticia_anterior_6=0;
// establece los elementos principales a visible.
for (var i = 1; i <=visibles; i++) {
	var a = "noti"+i;
	document.getElementById(eval(a)).style.display = 'inline';
}

// muestra los siguientes cuadros
function noticias_siguientes(contador) {

	// establece los saltos de los cuadros.
	noticia_anterior_1 = noti1;noti1 = noti1 + 1;noticia_anterior_2 = noti2;noti2 = noti2 + 1;noticia_anterior_3 = noti3;noti3 = noti3 + 1;noticia_anterior_4 = noti4;noti4 = noti4 + 1;noticia_anterior_5 = noti5;noti5 = noti5 + 1;noticia_anterior_6 = noti6;noti6 = noti6 + 1;
	document.getElementById(noticias_actual).style.display = "none";
	noticias_actual++;

	// muestra el cuadro siguiente
	for (var i = 1; i <=visibles; i++) {

		var b = "noti"+i;

		if(document.getElementById(eval(b)) != null) {
			document.getElementById(eval(b)).style.display = "inline";
		}
	}
		// oculta la flecha ultima cuando no hay mas cuadros que mostrar
	// si el fila de 4 +3 si es fila de 6 +5
	var cont = 3
	if (noticias_actual+cont == contador) {
		document.getElementById('boton_siguiente_noticias').style.visibility = "hidden";
	}

}

// muestra los anteriores cuadros
function noticias_atras() {

	// establece los saltos de los cuadros.
	noticia_anterior_1 = noti1;noti1 = noti1 - 1;noticia_anterior_2 = noti2;noti2 = noti2 - 1;noticia_anterior_3 = noti3;noti3 = noti3 - 1;noticia_anterior_4 = noti4;noti4 = noti4 - 1;noticia_anterior_5 = noti5;noti5 = noti5 - 1;noticia_anterior_6 = noti6;noti6 = noti6 - 1;
	// oculta el primer cuadro
	for (var i = 1; i <=visibles; i++) {

		var a = "noticia_anterior_"+i;

		if(document.getElementById(eval(a)) != null) {
			document.getElementById(eval(a)).style.display = "none";
		}

	}

	// muestra el cuadro siguiente
	for (var i = 1; i <=visibles; i++) {

		var b = "noti"+i;

		if(document.getElementById(eval(b)) != null) {
			document.getElementById(eval(b)).style.display = "inline";
			document.getElementById('boton_siguiente_noticias').style.visibility = "visible";
		}
	}
	noticias_actual=noticias_actual-1;

}

</script>

