		<script>

			function mostrar(id){
			contador=0;

			if(document.getElementById('menuSuperior'+id).style.display=="inline-flex"){
				contador=1;
			}
			if(id!=1){
			document.getElementById('menuSuperior1').style.display="none";
			}
			if(id!=2){
			document.getElementById('menuSuperior2').style.display="none";
			}
			if(id!=3){
			document.getElementById('menuSuperior3').style.display="none";
			}
			if(id!=4){
			document.getElementById('menuSuperior4').style.display="none";
			}
			if(id!=1){
			document.getElementById('encabezadoMenu1').style.color="white";
			}
			if(id!=2){
			document.getElementById('encabezadoMenu2').style.color="white";
			}
			if(id!=3){
			document.getElementById('encabezadoMenu3').style.color="white";
			}
			if(id!=4){
			document.getElementById('encabezadoMenu4').style.color="white";
			}
			if(id!=1){
			document.getElementById('imagenMenu1').src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu1.png";
			}
			if(id!=2){
			document.getElementById('imagenMenu2').src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu2.png";
			}
			if(id!=3){
			document.getElementById('imagenMenu3').src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu3.png";
			}
			if(id!=4){
			document.getElementById('imagenMenu4').src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu4.png";
			}
				if(contador==1){
					//document.getElementById('menuSuperior'+id).style.display="none";
					//document.getElementById('encabezadoMenu'+id).style.color="white";
					//document.getElementById('imagenMenu'+id).src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu"+id+".png";
				}else{
					document.getElementById('menuSuperior'+id).style.display="inline-flex";
					document.getElementById('encabezadoMenu'+id).style.color="#002810";
					document.getElementById('imagenMenu'+id).src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu"+id+"H.png";
					document.getElementById('menuFlotante'+id).style.backgroundColor = "#66ad4d";
				}

			}

			function ocultar(){
			document.getElementById('menuSuperior1').style.display="none";
			document.getElementById('menuSuperior2').style.display="none";
			document.getElementById('menuSuperior3').style.display="none";
			document.getElementById('menuSuperior4').style.display="none";
			document.getElementById('encabezadoMenu1').style.color="white";
			document.getElementById('encabezadoMenu2').style.color="white";
			document.getElementById('encabezadoMenu3').style.color="white";
			document.getElementById('encabezadoMenu4').style.color="white";
			document.getElementById('imagenMenu1').src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu1.png";
			document.getElementById('imagenMenu2').src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu2.png";
			document.getElementById('imagenMenu3').src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu3.png";
			document.getElementById('imagenMenu4').src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/logoMenu4.png";
			document.getElementById('menuFlotante1').style.backgroundColor = "transparent";
			document.getElementById('menuFlotante2').style.backgroundColor = "transparent";
			document.getElementById('menuFlotante3').style.backgroundColor = "transparent";
			document.getElementById('menuFlotante4').style.backgroundColor = "transparent";
			}

