<script>
function hoverFormulario(){
document.getElementById("btnImagenFormulario").src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/iconoFormularioHover.png";
document.getElementById('txtFormulario').style.color = '#002810';
}

function hoverVisita(){
document.getElementById("btnImagenVisita").src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/hoverBtnVisita.png";
document.getElementById('txtVisita').style.color = '#002810';
}

function hoverMesa(){
document.getElementById("btnImagenMesa").src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/hoverBtnMesa.png";
document.getElementById('txtMesa').style.color = '#002810';
}

function hoverOutFormulario(){
document.getElementById("btnImagenFormulario").src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/iconoFormulario.png";
document.getElementById('txtFormulario').style.color = '#FFF';
}
	
function hoverOutVisita(){
document.getElementById("btnImagenVisita").src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/botonFooterVisita.png";
document.getElementById('txtVisita').style.color = '#FFF';
}

function hoverOutMesa(){
document.getElementById("btnImagenMesa").src = "https://www.hospitalmacarena.es/wp-content/themes/genesis-sample/imagenes/botonFooterMesa.png";
document.getElementById('txtMesa').style.color = '#FFF';
}

</script>
