	<div class="wpb_raw_code wpb_content_element wpb_raw_html" >
		<div class="wpb_wrapper">
			<section class="ksv-tours" id="ksv-elige-tour">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Permanent+Marker&display=swap');
    #ksv-elige-tour, #ksv-elige-tour *{box-sizing:border-box!important;}
    #ksv-elige-tour{
      --ksv-orange:#f5821f;
      --ksv-orange-dark:#d96c0f;
      --ksv-ink:#171717;
      --ksv-gray:#5f5f5f;
      --ksv-line:#ececec;
      --ksv-sunset-1:#ff7a45;
      --ksv-sunset-2:#7a4ca0;
      max-width:1180px!important;
      width:100%!important;
      margin:0 auto!important;
      padding:56px 20px 48px!important;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif!important;
      float:none!important;
    }
    #ksv-elige-tour .ksv-head{text-align:center;max-width:640px;margin:0 auto 38px;}
    #ksv-elige-tour .ksv-eyebrow{display:inline-block;font-family:'Permanent Marker',cursive;font-size:20px;color:var(--ksv-orange);transform:rotate(-2deg);margin-bottom:6px;}
    #ksv-elige-tour h2{margin:0 0 10px!important;font-size:clamp(24px,3.6vw,34px)!important;font-weight:800!important;color:var(--ksv-ink)!important;letter-spacing:-0.5px;line-height:1.2!important;}
    #ksv-elige-tour .ksv-sub{margin:0!important;color:var(--ksv-gray)!important;font-size:16px!important;line-height:1.5!important;}

    #ksv-elige-tour .ksv-grid{
      display:flex!important;
      flex-wrap:wrap!important;
      gap:26px!important;
      margin:0!important;
      padding:0!important;
      list-style:none!important;
    }
    #ksv-elige-tour .ksv-card{
      flex:1 1 300px!important;
      max-width:calc(33.333% - 18px)!important;
      min-width:280px!important;
      position:relative;
      background:#fff!important;
      border:1px solid var(--ksv-line);
      border-radius:14px;
      overflow:hidden;
      display:flex!important;
      flex-direction:column!important;
      box-shadow:0 2px 10px rgba(0,0,0,.05);
      transition:transform .25s ease, box-shadow .25s ease;
    }
    @media (max-width:980px){
      #ksv-elige-tour .ksv-card{max-width:calc(50% - 13px)!important;}
    }
    @media (max-width:640px){
      #ksv-elige-tour .ksv-card{max-width:100%!important;flex-basis:100%!important;}
    }

    #ksv-elige-tour .ksv-card:hover{transform:translateY(-6px);box-shadow:0 18px 30px rgba(0,0,0,.12);}
    #ksv-elige-tour .ksv-card.ksv-featured{border:2px solid var(--ksv-orange);}
    #ksv-elige-tour .ksv-card.ksv-sunset{border:2px solid transparent;background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg,var(--ksv-sunset-1),var(--ksv-sunset-2)) border-box!important;}

    #ksv-elige-tour .ksv-ribbon{position:absolute;top:14px;right:-34px;background:var(--ksv-orange);color:#fff;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:5px 40px;transform:rotate(38deg);box-shadow:0 2px 6px rgba(0,0,0,.2);z-index:2;}

    #ksv-elige-tour .ksv-media{position:relative;width:100%!important;padding-top:75%!important;overflow:hidden;background:#eee;display:block!important;}
    #ksv-elige-tour .ksv-media img{
      position:absolute!important;
      top:0!important;left:0!important;
      width:100%!important;
      height:100%!important;
      max-width:none!important;
      object-fit:cover!important;
      display:block!important;
      margin:0!important;
      transition:transform .5s ease;
    }
    #ksv-elige-tour .ksv-card:hover .ksv-media img{transform:scale(1.06);}
    #ksv-elige-tour .ksv-media::after{content:"";position:absolute;inset:auto 0 0 0;height:55%;background:linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,0));z-index:1;}

    #ksv-elige-tour .ksv-badge{position:absolute;left:14px;bottom:12px;z-index:2;display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.95);color:var(--ksv-ink);font-weight:800;font-size:12.5px;letter-spacing:.04em;text-transform:uppercase;padding:6px 12px;border-radius:999px;}
    #ksv-elige-tour .ksv-badge svg{width:14px;height:14px;flex:none;}
    #ksv-elige-tour .ksv-sunset .ksv-badge{background:linear-gradient(135deg,var(--ksv-sunset-1),var(--ksv-sunset-2));color:#fff;}

    #ksv-elige-tour .ksv-badge-choice{position:absolute;right:14px;top:12px;z-index:2;background:rgba(23,23,23,.85);color:#fff;font-weight:700;font-size:11.5px;letter-spacing:.02em;padding:6px 10px;border-radius:999px;display:inline-flex;align-items:center;gap:5px;}
    #ksv-elige-tour .ksv-badge-choice svg{width:13px;height:13px;flex:none;}

    #ksv-elige-tour .ksv-body{padding:20px 22px 24px!important;display:flex!important;flex-direction:column!important;flex:1!important;}
    #ksv-elige-tour .ksv-card h3{margin:0 0 6px!important;font-size:20px!important;font-weight:800!important;color:var(--ksv-ink)!important;line-height:1.3!important;}
    #ksv-elige-tour .ksv-tagline{margin:0 0 14px!important;font-size:14px!important;color:var(--ksv-orange-dark)!important;font-weight:700!important;}
    #ksv-elige-tour .ksv-sunset .ksv-tagline{color:#a24fbf!important;}

    #ksv-elige-tour ul.ksv-points{list-style:none!important;margin:0 0 18px!important;padding:0!important;flex:1!important;}
    #ksv-elige-tour ul.ksv-points li{display:flex!important;align-items:flex-start!important;gap:8px!important;font-size:14px!important;color:var(--ksv-gray)!important;line-height:1.4!important;margin:0 0 8px!important;padding:0!important;list-style:none!important;}
    #ksv-elige-tour ul.ksv-points li::before,#ksv-elige-tour ul.ksv-points li::marker{content:none!important;}
    #ksv-elige-tour ul.ksv-points svg{flex:none;width:16px;height:16px;margin-top:2px;color:var(--ksv-orange);}
    #ksv-elige-tour .ksv-sunset ul.ksv-points svg{color:#a24fbf;}

    #ksv-elige-tour .ksv-cta{display:inline-block!important;text-align:center!important;background:var(--ksv-ink)!important;color:#fff!important;text-decoration:none!important;font-weight:800!important;font-size:14px!important;letter-spacing:.02em;text-transform:uppercase;padding:13px 18px!important;border-radius:8px!important;transition:background .2s ease, transform .2s ease;}
    #ksv-elige-tour .ksv-cta:hover{background:var(--ksv-orange)!important;transform:translateY(-2px);}
    #ksv-elige-tour .ksv-sunset .ksv-cta{background:linear-gradient(135deg,var(--ksv-sunset-1),var(--ksv-sunset-2))!important;}
    #ksv-elige-tour .ksv-sunset .ksv-cta:hover{filter:brightness(1.08);}

    #ksv-elige-tour .ksv-foot{text-align:center!important;margin-top:30px!important;font-size:13.5px!important;color:var(--ksv-gray)!important;}
  </style>

  <div class="ksv-head">
    <span class="ksv-eyebrow">¡Elige tu aventura!</span>
    <h2>Tres formas de descubrir Sevilla en kayak</h2>
    <p class="ksv-sub">Misma ruta por el corazón histórico del Guadalquivir, distinta duración y ambiente. En los tres puedes elegir kayak o paddle surf. Reserva más abajo.</p>
  </div>

  <div class="ksv-grid">

    <article class="ksv-card">
      <div class="ksv-media">
        <img decoding="async" src="https://kayaksevilla.com/www/wp-content/uploads/2026/07/tour-2h-kayak-o-paddle.jpg" alt="Kayak frente a la Torre del Oro y paddle surf en el Guadalquivir, Sevilla" loading="lazy">
        <span class="ksv-badge-choice"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 20l7-7 2 2 9-9M13 3h5v5"/></svg>Kayak o Paddle Surf</span>
        <span class="ksv-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>2 horas</span>
      </div>
      <div class="ksv-body">
        <h3>Tour Kayak Clásico</h3>
        <p class="ksv-tagline">El imprescindible</p>
        <ul class="ksv-points">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 6"/></svg>Iniciación en tierra y en el agua incluida</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 6"/></svg>Torre del Oro, Puente de Triana y Real Maestranza</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 6"/></svg>Ideal para primerizos, familias y grupos</li>
        </ul>
        <a href="#ksv-reserva-final" class="ksv-cta">Reservar este tour</a>
      </div>
    </article>

    <article class="ksv-card ksv-featured">
      <span class="ksv-ribbon">Más elegido</span>
