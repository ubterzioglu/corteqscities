    (function () {
        'use strict';

        function saveInstructorLabel() {
            var select = document.getElementById('input_134_111');
            var target = document.getElementById('input_134_168');

            if (!select || !target) {
                return;
            }

            var option = select.options[select.selectedIndex];

            target.value = option ? option.text.trim() : '';
        }

        // Capture changes to the instructor dropdown.
        document.addEventListener('change', function (event) {
            if (event.target.id === 'input_134_111') {
                saveInstructorLabel();
            }
        });

        // Capture the selected label before submission.
        document.addEventListener('submit', function (event) {
            if (event.target.id === 'gform_134') {
                saveInstructorLabel();
            }
        }, true);

        // Support Gravity Forms AJAX rendering.
        document.addEventListener('gform/postRender', function (event) {
            if (!event.detail || Number(event.detail.formId) === 134) {
                saveInstructorLabel();
            }
        });

        document.addEventListener('DOMContentLoaded', saveInstructorLabel);

        // Also handle scripts loaded after DOMContentLoaded.
        if (document.readyState !== 'loading') {
            saveInstructorLabel();
        }
    })();
    </script>
        <script>
    jQuery(function ($) {

        var monthlyTimes = {
            1:  ['16:15'],
            2:  ['16:45'],
            3:  ['17:15', '18:15'],
            4:  ['19:15'],
            5:  ['19:45'],
            6:  ['20:15'],
            7:  ['20:15'],
            8:  ['19:45'],
            9:  ['18:45'],
            10: ['18:15', '17:15'],
            11: ['16:45'],
            12: ['16:15']
        };

        var $dateField = $('#input_134_33');
        var $timeField = $('#input_134_169');

        if (!$dateField.length || !$timeField.length) {
            return;
        }

        // Store the original dropdown choices.
        var originalOptions = $timeField.find('option').clone();

        function updateTimes() {

            var dateValue = $dateField.val();

            if (!dateValue) {
                $timeField.empty().append(
                    $('<option>', {
                        value: '',
                        text: 'What time?'
                    })
                );
                return;
            }

            // Expected format: DD/MM/YYYY
            var parts = dateValue.split('/');

            if (parts.length !== 3) {
                return;
            }

            var month = parseInt(parts[1], 10);
            var allowedTimes = monthlyTimes[month] || [];

            // Clear the dropdown.
            $timeField.empty();

            // Add placeholder.
            $timeField.append(
                $('<option>', {
                    value: '',
                    text: 'What time?'
                })
            );

            // Add only the correct monthly times.
            $.each(allowedTimes, function (index, time) {

                var matchingOption = originalOptions.filter(
                    function () {
                        return $(this).val() === time;
                    }
                );

                if (matchingOption.length) {
                    $timeField.append(matchingOption.clone());
                }

            });

            // Force customer to choose a time.
            $timeField.val('');
            $timeField.trigger('change');
        }

        // Update when booking date changes.
        $(document).on(
            'change input',
            '#input_134_33',
            updateTimes
        );

        // Support Gravity Forms datepicker.
        $(document).on(
            'change',
            '#input_134_33',
            updateTimes
        );

        // Run when the page loads.
        updateTimes();

    });
    </script>
            <script>
        (function () {
            'use strict';

            function saveSelectedLabel(formId, sourceId, targetId) {

                var select = document.getElementById(
                    'input_' + formId + '_' + sourceId
                );

                var target = document.getElementById(
                    'input_' + formId + '_' + targetId
                );

                if (!select || !target) {
                    return;
                }

                var option = select.options[select.selectedIndex];

                var label = option ? option.text.trim() : '';

                if (target.value !== label) {
                    target.value = label;

                    target.dispatchEvent(
                        new Event('input', { bubbles: true })
                    );
                }
            }

            function saveAllLabels() {

                // FORM 134 - Instructor
                saveSelectedLabel(134, 111, 168);

                // FORM 137 - Pre-tour briefing
                saveSelectedLabel(137, 176, 191);
            }

            // When customer changes a dropdown.
            document.addEventListener('change', function (event) {

                if (
                    event.target.id === 'input_134_111' ||
                    event.target.id === 'input_137_176'
                ) {
                    saveAllLabels();
                }

            });

            // Capture labels before submission.
            document.addEventListener('submit', function (event) {

                if (
                    event.target.id === 'gform_134' ||
                    event.target.id === 'gform_137'
                ) {
                    saveAllLabels();
                }

            }, true);

            // Gravity Forms AJAX rendering.
            document.addEventListener(
                'gform/postRender',
                function () {
                    saveAllLabels();
                }
            );

            // Compatibility with older Gravity Forms rendering.
            if (window.jQuery) {
                jQuery(document).on(
                    'gform_post_render',
                    function () {
                        saveAllLabels();
                    }
                );
            }

            // Initial page load.
            document.addEventListener(
                'DOMContentLoaded',
                saveAllLabels
            );

            if (document.readyState !== 'loading') {
                saveAllLabels();
            }

        })();
        </script>
        		<script type="text/javascript">
		gform.addFilter( 'gform_datepicker_options_pre_init', function( optionsObj, formId, fieldId ) {
    if ( formId == 38 && fieldId == 33 ) {
        optionsObj.firstDay = 1;
        optionsObj.beforeShowDay = function(date) {
            var day = date.getDay();
            return [(day == 6)];
        };
    }
    return optionsObj;
});
gform.addFilter( 'gform_datepicker_options_pre_init', function( optionsObj, formId, fieldId ) {
    if ( formId == 29 && fieldId == 33 ) {
        optionsObj.minDate = 0;
    }
    return optionsObj;
});		</script>
