<script>jQuery(document).ready(function($) {
    // Function to calculate exact sum of checked boxes in Field 64
    function calculateExactField64Total() {
        var total = 0.0;

        // Loop through all checked inputs in field 64
        $('#input_128_64 input[type="checkbox"]:checked').each(function() {
            var val = $(this).val(); // e.g. "tarjetacursoavanzado|99.95"
            
            if (val && val.indexOf('|') !== -1) {
                // Extract price part after the pipe
                var priceStr = val.split('|')[1]; 
                var price = parseFloat(priceStr);
                
                if (!isNaN(price)) {
                    total += price;
                }
            } else if (!isNaN(parseFloat(val))) {
                total += parseFloat(val);
            }
        });

        // Round to 2 decimal places
        total = Math.round(total * 100) / 100;

        // Force update calculated total field (Field 155)
        var $field155 = $('#input_128_155, input[name="input_155"]');
        if ($field155.length) {
            $field155.val(total.toFixed(2)).trigger('change');
        }

        return total;
    }

    // Trigger calculation whenever a checkbox state changes
    $(document).on('change', '#input_128_64 input[type="checkbox"]', function() {
        calculateExactField64Total();
    });

    // Intercept form submission to guarantee clean value is set right before Stripe modal opens
    $('#gform_128').on('submit', function() {
        calculateExactField64Total();
    });
});</script><style id="wp-custom-css">
.bandera img {
    width: 25px;
    height: 20px;
    padding-left: 20px;
}
#fancy-title-9 {
	font-size: 60px !important;}
.menu-item-link.js-smooth-scroll img{
	display:none !important;
}

.wpb_wrapper img{
		display:none !important;
}
@media screen and (max-width: 480px){
	#gtranslate_wrapper{
	margin-top:70px !important;
	margin-right:130px !important;
}
}
@media only screen and (max-width: 768px) {
  /* For mobile phones: */
  [class*="wp-block-column"] {
	width: 50%;!important;
  }
}/* 1. ESTILOS PARA EL CONTENEDOR DEL VIDEO */
.video-vertical {
  position: relative !important;
  width: 100% !important;
  margin: 0 auto !important;
  height: 0 !important;
  padding-bottom: 177.77% !important; /* Proporción 9:16 */
  overflow: hidden !important;
  border-radius: 12px !important; /* Bordes redondeados opcionales */
  max-width: 320px; /* Ancho máximo en PC para que no se vea gigante */
}

/* 2. REGLA PARA QUE EL VIDEO OCUPE TODO EL CONTENEDOR */
.video-vertical iframe {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
}

/* 3. REGLA CLAVE: NEUTRALIZA EL WRAPPER DE WPBAKERY */
.video-vertical .wpb_wrapper {
  padding: 0 !important;
}

/* 4. REGLA PARA MÓVILES: HACEMOS QUE EN MÓVIL SEA MÁS ANCHO */
@media (max-width: 767px) {
  .video-vertical {
    max-width: 100%; /* Ocupa casi toda la pantalla en móvil */
  }
}
/* Cambia el 123 por el ID de tu página */
.page-id-13147 .gform_wrapper .gfield_radio li label {
    font-size: 17px !important;
    line-height: 1.4 !important;
}
/* Mejorar legibilidad del descargo de responsabilidad KS */
.checkbox-grande,
.checkbox-grande div,
.checkbox-grande p,
.checkbox-grande span,
.checkbox-grande .wpforms-field-description {
    font-size: 16px !important; 
    color: #444444 !important; /* Gris oscuro */
    line-height: 1.5 !important;
}

/* Por si el cajón de texto es un textarea (caja de texto) */
.checkbox-grande textarea {
    font-size: 16px !important;
    color: #444444 !important;
    line-height: 1.5 !important;
