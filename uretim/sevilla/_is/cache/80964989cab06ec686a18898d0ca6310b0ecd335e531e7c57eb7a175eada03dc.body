<style id="components-full-inline-css">

body
{
    background-color:#fff;
}

.hb-custom-header #mk-page-introduce,
.mk-header
{
    background-color:#f7f7f7;
}

.hb-custom-header > div,
.mk-header-bg
{
    background-color:#222222;
}

.mk-classic-nav-bg
{
    background-color:#222222;
}

.master-holder-bg
{
    background-color:#fff;
}

#mk-footer
{
    background-color:#222222;
}

#mk-boxed-layout
{
  -webkit-box-shadow: 0 0 0px rgba(0, 0, 0, 0);
  -moz-box-shadow: 0 0 0px rgba(0, 0, 0, 0);
  box-shadow: 0 0 0px rgba(0, 0, 0, 0);
}

.mk-news-tab .mk-tabs-tabs .is-active a,
.mk-fancy-title.pattern-style span,
.mk-fancy-title.pattern-style.color-gradient span:after,
.page-bg-color
{
    background-color: #fff;
}

.page-title
{
    font-size: 20px;
    color: ;
    text-transform: uppercase;
    font-weight: 400;
    letter-spacing: 2px;
}

.page-subtitle
{
    font-size: 14px;
    line-height: 100%;
    color: ;
    font-size: 14px;
    text-transform: none;
}


    body { font-family: HelveticaNeue-Light, Helvetica Neue Light, Helvetica Neue, sans-serif } h3, h4, h5, .main-navigation-ul, .mk-vm-menuwrapper, .mk-fancy-title, .mk-box-icon .icon-box-title { font-family: Montserrat } body, p { font-family: Quicksand } 

            @font-face {
                font-family: 'star';
                src: url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/star/font.eot');
                src: url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/star/font.eot?#iefix') format('embedded-opentype'),
                url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/star/font.woff') format('woff'),
                url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/star/font.ttf') format('truetype'),
                url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/star/font.svg#star') format('svg');
                font-weight: normal;
                font-style: normal;
            }
            @font-face {
                font-family: 'WooCommerce';
                src: url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/woocommerce/font.eot');
                src: url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/woocommerce/font.eot?#iefix') format('embedded-opentype'),
                url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/woocommerce/font.woff') format('woff'),
                url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/woocommerce/font.ttf') format('truetype'),
                url('https://kayaksevilla.com/www/wp-content/themes/jupiter/assets/stylesheet/fonts/woocommerce/font.svg#WooCommerce') format('svg');
                font-weight: normal;
                font-style: normal;
            }.hide {display:none !important;}
.mapa-localizacion .mk-padding-wrapper {
    padding: 0 !important;
}
h1.page-title {
    margin: 10px 0 !important;
}
.subtitulo p {
    font-size: 1.4em;
}
.sombra-image-box .item-wrapper {
    -moz-box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.09);
    -webkit-box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.09);
    box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.09);
    transition: All 0.4s ease;
    -webkit-transition: All 0.4s ease;
    -moz-transition: All 0.4s ease;
    -o-transition: All 0.4s ease;
    background: #ffffff;
}
.sombra-image-box .item-wrapper:hover {
    -moz-box-shadow:0px 0px 29px rgba(0, 0, 0, 0.24);
    -webkit-box-shadow:0px 0px 29px rgba(0, 0, 0, 0.24);
    box-shadow:0px 0px 29px rgba(0, 0, 0, 0.24);
    transition:All 0.4s ease;
    -webkit-transition:All 0.4s ease;
    -moz-transition:All 0.4s ease;
    -o-transition:All 0.4s ease;
}
.sombra-image-box .item-holder {
    overflow: visible !important;
}
.sombra-icon {filter: drop-shadow(0 0 2px rgba(0,0,0,0.8));}
.texto-blanco p, .texto-blanco a, .texto-blanco b, .texto-blanco strong {
		color:#fff !important;
}
#text-3 .textwidget {
    font-size: 1.2em !important;
}
#mk-footer a:hover {
   text-decoration:underline;
}
.galeria-full-width {
   padding: 0 !important;
}
#menu-item-9291 a, #menu-item-9290 a {
	padding-right: 0 !important;
	padding-left: 0 !important;
}
.bandera img {
	width: 20px;
	height: 20px;
	padding-left:20px;
}
#menu-item-9290 a.menu-item-link::after, #menu-item-9291 a.menu-item-link::after {
	background-color: transparent !important;
}
.esp, .eng {display:none;}
@media handheld, only screen and (max-width: 1140px) {
	.mk-padding-wrapper {padding: 0 !important;}
	.bandera img {padding-left:0 !important;}
	.esp, .eng {display:inline-block;}
	.esp::before {content:"Español: ";}
}

.mk-fancy-title.color-single span, .mk-fancy-title.color-single p {
     color: inherit;
}
/*# sourceURL=components-full-inline-css */
</style>
