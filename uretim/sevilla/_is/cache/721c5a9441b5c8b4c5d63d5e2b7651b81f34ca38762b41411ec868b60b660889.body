    <script>
    (function() {
        var vWidth = $(window).width();
        for (var i = 0; i < 3; i++) {
            var appImg = $('#img_news_app_' + i).val();
            var imgMain = $('#img_main_' + i);
            var figureImg = $('#figure_img_' + i);
            if (vWidth < 570 && appImg) {
                imgMain.attr('src', appImg);
                figureImg.addClass('vertical-img');
            } else if (figureImg.length) {
                figureImg.removeClass('vertical-img');
            }
        }
    })();
</script>
    <script src="/media/js/video_home.js?ch=2122098"></script>
<script src="/ajax/sso_misc/jwt-hometool/dist/js/main.js" charset="utf-8"></script>
<script>
    function getCookie(name) {
        const nameEQ = name + '=';
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) === ' ') c = c.substring(1, c.length);
            if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
        }
        return null;
    }

    function verificarYocultarElementos() {
        const valorCookieApp = getCookie('BETISAPP');

        if (valorCookieApp === 'BETIS') {
            const footer = document.querySelector('footer');
            const header = document.querySelector('.header-wrapper');
            const breadcrumb = document.querySelector('.breadcrumb');
            const breadcrumb2 = document.querySelector('ul.breadcrumb.t-uc.mb30.bg2.oh');

            if (footer) footer.style.display = 'none';
            if (header) header.style.display = 'none';
            if (breadcrumb) breadcrumb.style.display = 'none';
            if (breadcrumb2) breadcrumb2.style.display = 'none';

            if (typeof $ !== 'undefined') {
                $('main').css('margin-top', '0');
            }
        }
    }

    $(document).ready(function () {
        const jwt = getCookie('SSO-BSOCC');
        if (jwt) {
            $('#rawSSOToken').val(jwt);
        }

        setTimeout(function () {
            let data = null;
            const rawJSON = ($('#login').html() || '').replace('Login: ', '');

            if (rawJSON) {
                try {
                    data = JSON.parse(rawJSON);
                } catch (e) {
                    console.error('Error al parsear los datos del login:', e);
                }
            }

            if (data) {
                $('.name-user').html(data.name);
                $('.user-logued').removeClass('hidden');
                $('.my-betis').addClass('hidden');

                if (data.type == 1) {
                    $('.type-fan').addClass('hidden');
                    $('.type-socio').removeClass('hidden');
                } else if (data.type == 2) {
                    $('.type-fan').removeClass('hidden');
                    $('.type-socio').addClass('hidden');
                }
            } else {
                $('.my-betis').removeClass('hidden');
            }

            verificarYocultarElementos();
        }, 1000);
    });

    document.addEventListener('DOMContentLoaded', verificarYocultarElementos);
</script>
