<section class="section section--white">
  <div class="wrap">
    <div class="toc">
      <p class="toc__title">En esta página</p>
      <ol>
        <li><a href="#que-es">Qué es la Torre del Oro</a></li>
        <li><a href="#donde-esta">Dónde está</a></li>
        <li><a href="#visita">Horarios y entradas</a></li>
        <li><a href="#por-dentro">Qué se ve por dentro</a></li>
        <li><a href="#nombre">Por qué se llama así</a></li>
