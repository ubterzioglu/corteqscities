<script type="text/javascript">
    function selectActiveMenu(id) {
        var menuElement = $("#" + id);
        menuElement.addClass("selected");
    }

    var timerId = setTimeout(function tick() {
        if (typeof Drupal != "undefined") {
            if (typeof Drupal.behaviors != "undefined" && typeof Drupal.behaviors.toc_js != "undefined" && typeof jQuery.fn.toc === "function") {
                Drupal.behaviors.terra_toc_js.attach(document, null);
                Drupal.behaviors.toc_js.attach(document, null);
            } else {
                var tag = document.createElement("script");
                tag.src = "../../censar-web/js/default/files/js_Bc9Gk5rYgEpXVJuz4-58ivRDW4oW_xEPqlDJBYaT1vk.js";
                tag.type = "text/javascript";
                tag.defer = "defer";
                document.getElementsByTagName("body")[0].appendChild(tag);

                timerId = setTimeout(tick, 2000);
            }
        } else {
            timerId = setTimeout(tick, 2000); // (*)
        }

    }, 2000);
</script>
