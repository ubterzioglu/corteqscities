<script type="text/javascript">
		/******************************************
			ACCIONES PARA LA CORTINILLA		
		*******************************************/
		
		//*** Comprobamos si existe la cookie cortinilla_activa. Si no existe, la creamos y mostramos la antepantalla
		var cookieCortinilla = leerCookie("cortinilla_activa");

		if ( cortinillaActiva && cookieCortinilla == null ) {
			jQuery('#cortinilla').show();
			
			//Creamos la cookie para la cortinilla_activa durante 24 horas
			crearCookie("cortinilla_activa","S",".junta-andalucia.es",24);
			
			//*** Controlar el cierre de la cortinilla
			jQuery.timer(5000, function (timer) {
				timer.stop();
				jQuery('#cortinilla').hide();		
			}); //end evento timer
		}//end if
</script>


