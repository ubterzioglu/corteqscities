fy-content:space-between!important}}@media(min-width:1024px){.b-offset-menu__bar{height:72px}.b-offset-menu__logo{height:36px}.b-offset-menu__panel-inner{align-items:end}.b-offset-menu__columns{flex-direction:row!important;justify-content:default!important}}body.menu-is-open{overflow:hidden}body.has-header-white .b-offset-menu:not(.is-scrolled):not(.is-open) .b-offset-menu__bar{color:var(--white)}body.has-header-white .b-offset-menu:not(.is-scrolled):not(.is-open) .b-offset-menu__logo-img{filter:brightness(0) invert(1)}

