.b-hero{color:var(--white);display:flex;flex-direction:column;gap:60px;min-height:100svh;padding:var(--spacing-fluid-menu) 0 0;position:relative}.b-hero__bg{z-index:0}.b-hero__bg,.b-hero__bg .c-media,.b-hero__overlay{inset:0;position:absolute}.b-hero__overlay{pointer-events:none;z-index:2}.b-hero__content{flex-grow:99;padding:0 var(--layout-margin);position:relative;z-index:1}.b-hero__claim{font-family:var(--display-font);font-weight:var(--font-weight-bold);line-height:1;margin:0;text-align:justify;text-align-last:justify;text-transform:uppercase;width:100%}.b-hero__bottom{align-items:center;display:flex;gap:24px;justify-content:space-between;padding:0;position:relative;z-index:1}.b-hero__cta{flex-shrink:0;width:100%}.b-hero__cta .btn{color:var(--white)!important}.b-hero__cta .btn:after{transform:rotate(-45deg);transition:all .3s ease-in-out}.b-hero__nav{display:none}.b-hero__menu li a{color:var(--white);display:inline-block;font-family:var(--display-font);font-size:var(--wp--preset--font-size--display-xs);font-weight:var(--font-weight-bold);text-decoration:none;text-transform:uppercase;transition:all .3s ease-in-out}.b-hero__menu li a:hover{transform:rotate(-7deg)}@media screen and (min-width:768px){.b-hero__nav{display:block}.b-hero__nav .wp-block-navigation__container{align-items:center;display:flex;flex-wrap:wrap;gap:clamp(16px,-51.1475px + 8.7432vw,80px);list-style:none;margin-right:var(--layout-margin);padding:0;row-gap:4px}.b-hero__nav .wp-block-navigation-item__label{color:var(--white);display:inline-block;font-family:var(--display-font);font-size:var(--wp--preset--font-size--display-xs);font-weight:var(--font-weight-bold);text-decoration:none;text-transform:uppercase;transition:all .3s ease-in-out}.b-hero__nav .wp-block-navigation-item__label:hover{transform:rotate(-2deg)}.b-hero__cta{min-width:min(550px,40%);width:auto}}

