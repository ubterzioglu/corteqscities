<div class="b-bisiesto b-corporativo-3 alignfull">
	<div class="b-corporativo-3__media">
				<div class="c-media ">
		<video
			class="c-media__item c-media__item--video"
			src="https://vz-7953fb8c-62b.b-cdn.net/2b40ca36-d735-45bf-8120-20a30d1c7929/play_1080p.mp4"
						autoplay
			muted
			loop
