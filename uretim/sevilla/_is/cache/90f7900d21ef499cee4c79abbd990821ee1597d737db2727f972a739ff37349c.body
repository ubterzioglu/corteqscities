<style id="bisiesto-offset-menu-style-inline-css">
.b-offset-menu{left:0;position:fixed;right:0;top:0;z-index:1000}.b-offset-menu__bar{align-items:center;background-color:transparent;border-bottom:2px solid;color:var(--black);display:flex;height:56px;justify-content:space-between;padding:0 var(--layout-margin,24px);position:relative;transform:translateY(0);transition:transform .35s ease,background-color .35s ease,color .35s ease,visibility 0s 0s;visibility:visible;z-index:2}.b-offset-menu.is-open .b-offset-menu__bar,.b-offset-menu.is-scrolled .b-offset-menu__bar{background-color:var(--red);color:var(--white)}.b-offset-menu.is-scrolled-down .b-offset-menu__bar{transform:translateY(-100%);transition:transform .35s ease,background-color .35s ease,color .35s ease,visibility 0s .35s;visibility:hidden}.b-offset-menu__logo-img{filter:brightness(0);transition:filter .35s ease}.b-offset-menu.is-open .b-offset-menu__logo-img,.b-offset-menu.is-scrolled .b-offset-menu__logo-img{filter:brightness(0) invert(1)}.b-offset-menu__logo{align-items:center;display:flex;flex-shrink:0;height:32px}.b-offset-menu__logo .custom-logo-link,.b-offset-menu__logo a{align-items:center;display:flex;height:100%}.b-offset-menu__logo .custom-logo,.b-offset-menu__logo-img{display:block;height:100%;object-fit:contain;width:auto}.b-offset-menu__toggle{align-items:center;background:none;border:none;color:inherit;cursor:pointer;display:flex;font-weight:500!important;gap:10px;padding:0}.b-offset-menu.is-open .b-offset-menu__toggle-label{display:none}.b-offset-menu__toggle-icon{flex-shrink:0;height:20px;position:relative;width:20px}.b-offset-menu__toggle-icon span{background-color:currentColor;height:1.5px;left:0;position:absolute;right:0;transition:transform .35s ease,opacity .35s ease}.b-offset-menu__toggle-icon span:first-child{top:50%;transform:translateY(-50%)}.b-offset-menu__toggle-icon span:last-child{top:50%;transform:translateY(-50%) rotate(90deg)}.b-offset-menu.is-open .b-offset-menu__toggle-icon span:first-child{transform:translateY(-50%) rotate(4