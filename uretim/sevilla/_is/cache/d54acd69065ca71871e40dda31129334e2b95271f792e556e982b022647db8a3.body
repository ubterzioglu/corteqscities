<script>
    let urlActual = window.location.href;

    if(!urlActual.includes('busqueda') && !urlActual.includes('catalogo')){
        localStorage.removeItem("fechaDatos");
        localStorage.removeItem("datosBusqueda");
    }

    console.log(urlActual);
</script>
<script>
        function dirigeApagina(url){
        localStorage.removeItem("fechaDatos");
        localStorage.removeItem("datosBusqueda");
        localStorage.removeItem("paginaActualExposiciones");
        window.location.href=url;
    }
</script>

<script>
    $(document).ready(function() {
        const targetDiv = document.querySelector('.scrolltop-wrap');
        const activationPoint = window.innerHeight / 2;

        function handleScroll() {
            if (window.scrollY >= activationPoint) {
                targetDiv.classList.add('active');
            } else {
                targetDiv.classList.remove('active');
            }
        }

        // Escuchar el evento de scroll
        window.addEventListener('scroll', handleScroll);

        // Controlar el clic de forma accesible devolviendo el foco al principio
        $('.scrolltop-wrap a').on('click', function(e) {
            e.preventDefault();
            $('html, body').animate({ scrollTop: 0 }, 400, function() {
                $('header').attr('tabindex', '-1').focus().removeAttr('tabindex');
            });
        });
    });
</script>

        
