    <button class="close-search-modal" onclick="cerrarBuscador(event);" aria-label="Cerrar búsqueda">&times;</button>
    
    <div class="search-modal-content">
        <h2 id="modal-search-title" class="sr-only">Buscador Global</h2>
        
        <form id="global-search-form" action="https://cicus.us.es/resultados-busqueda" method="GET" onsubmit="enviarBusqueda(event);">
            <div class="search-input-wrapper">
                <svg class="search-input-icon" viewBox="0 0 36.648 36.648" aria-hidden="true">
                    <path d="M15.833,0A15.79,15.79,0,1,1,9.875,1.159,15.778,15.778,0,0,1,15.833,0Zm0,27.665A11.832,11.832,0,1,0,7.465,24.2,11.757,11.757,0,0,0,15.833,27.665Z" fill="currentColor"/>
                    <path d="M9.62,11.034-1.414,0,0-1.414,11.034,9.62Z" transform="translate(25.614 25.614)" fill="currentColor"/>
                </svg>
                <input type="search" name="q" id="global-search-input" placeholder="¿Qué estás buscando?" autocomplete="off" aria-autocomplete="list" aria-controls="global-search-results">
            </div>
        </form>

        <!-- Resultados instantáneos (popover) -->
        <div id="global-search-results" class="search-live-results" aria-live="polite">
            <!-- Los resultados rápidos se inyectarán aquí mediante JS -->
        </div>
    </div>
</div>

