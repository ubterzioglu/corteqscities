<script>
document.addEventListener('DOMContentLoaded', function() {
    const menuLinks = document.querySelectorAll('#main-nav-menu > li > a[data-image]');
    const targetImg = document.getElementById('img-menu-fullscreen');

    // Desktop: swap featured image on mouseenter
    menuLinks.forEach(link => {
        link.addEventListener('mouseenter', function() {
            const imageUrl = this.getAttribute('data-image');
            if (targetImg && imageUrl) {
                if (targetImg.src !== imageUrl) {
                    targetImg.src = imageUrl;
                }
            }
        });
    });

    // Click-toggle submenus on items with submenu (only on mobile)
    const submenuItems = document.querySelectorAll('#main-nav-menu li.has-submenu > a.main-link');

    submenuItems.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault(); // Prevent default link behavior (#)
            
            if (window.innerWidth < 1024) {
                const parentLi = this.closest('li.has-submenu');
                const isOpen = parentLi.classList.contains('submenu-open');

                // Close all other open submenus
                document.querySelectorAll('#main-nav-menu li.has-submenu.submenu-open').forEach(li => {
                    li.classList.remove('submenu-open');
                });

                // Toggle current submenu
                if (!isOpen) {
                    parentLi.classList.add('submenu-open');
                }
            }
        });
    });

    // Close submenus when clicking outside (only on mobile)
    document.addEventListener('click', function(e) {
        if (window.innerWidth < 1024) {
            const mainNav = document.getElementById('main-nav');
            if (mainNav && mainNav.classList.contains('nav-active')) {
                const isClickInsideToggle = e.target.closest('#main-nav-menu li.has-submenu > a.main-link');
                const isClickInsideSubmenu = e.target.closest('.submenu-list');
                
                if (!isClickInsideToggle && !isClickInsideSubmenu) {
                    document.querySelectorAll('#main-nav-menu li.has-submenu.submenu-open').forEach(li => {
                        li.classList.remove('submenu-open');
                    });
                }
            }
        }
    });

    // Close submenus when menu closes
    const toggle = document.getElementById('toggle');
    if (toggle) {
        toggle.addEventListener('click', function() {
            document.querySelectorAll('#main-nav-menu li.has-submenu.submenu-open').forEach(li => {
                li.classList.remove('submenu-open');
            });
        });
    }
});
</script>



        

<section id="highlighted">
    <h1 class="oculto">Patrimonio Cultural de la Universidad de Sevilla</h1>
            <!-- Slider Home -->
        <div id="slider-home" class="slides">
                            <!--  Slide  -->
                <div class="slides-item">
                    <a href="https://cicus.us.es/evento/piel-comun-puesta-en-escena">
                        <img src="https://cicus.us.es/files/public/Evento/imagen/teatrooct2020602_20260923_222512.jpg" alt="">
                        <div class="slides-home-content">
                            <h2>PUESTA EN ESCENA DE LOS RESULTADOS DEL TALLER PIEL COMÚN. MUJERES EN CREACIÓN ESCÉNICA</h2>
                            <p>"Piel común" es un taller en el que través de la metodología Teatro del Sí, desarrollada por Marina Pallarès Elias, se explora cómo la escena puede ser un espacio de encuentro, reconocimiento e igualdad</p>
                        </div>
                    </a>
                </div>
                            <!--  Slide  -->
                <div class="slides-item">
                    <a href="https://cicus.us.es/detalle-noticia/cine-rumano-2026">
                        <img src="https://cicus.us.es/files/public/Evento/imagen/cineoct202606_20260923_231921.jpg" alt="">
                        <div class="slides-home-content">
                            <h2>LUNES DE CINE. MUESTRA DE CINE RUMANO 2026</h2>
                            <p>Esta año vuelve al CICUS la Muestra de Cine Rumano, un evento que nos permite acercarnos a una de las cinematografías más destacadas del continente europeo</p>
                        </div>
                    </a>
                </div>
                            <!--  Slide  -->
                <div class="slides-item">
                    <a href="https://cicus.us.es/detalle-noticia/inauguracion-exposicion-fisicrai-felisa-martin-bravo">
                        <img src="https://cicus.us.es/files/public/Noticia/imagen/dsc01309_20261015_134932.jpg" alt="">
                        <div class="slides-home-content">
                            <h2>La Universidad de Sevilla recupera el legado de Felisa Martín Bravo</h2>
                            <p>El CRAI Antonio de Ulloa inaugura una exposición que reúne instrumentos científicos históricos para acercar al público la figura de una de las grandes pioneras de la ciencia española</p>
                        </div>
                    </a>
                </div>
                            <!--  Slide  -->
                <div class="slides-item">
                    <a href="https://cicus.us.es/evento/guerra-total">
                        <img src="https://cicus.us.es//files/public/EntradaSlider/imagen/2110202609_20261022_221651.jpg" alt="">
                        <div class="slides-home-content">
                            <h2>PRESENTACIÓN DEL LIBRO GUERRA TOTAL DE MANUEL CHAVES</h2>
                            <p>En "Guerra total" (Editorial Renacimiento) se reúnen diez relatos, ocho de ellos inéditos, que complementan 'A sangre y fuego', la obra que transformó nuestra manera de leer y comprender la Guerra Civil española</p>
                        </div>
                    </a>
                </div>
                            <!--  Slide  -->
                <div class="slides-item">
                    <a href="https://cicus.us.es/detalle-noticia/pieza-del-mes-san-ambrosio">
                        <img src="https://cicus.us.es/files/public/Noticia/imagen/piezamesoctubre26_20261006_092631.jpg" alt="">
                        <div class="slides-home-content">
                            <h2>Pieza del Mes: San Ambrosio</h2>
                            <p>Una mirada a los Padres de la Iglesia de la Capilla Universitaria</p>
                        </div>
                    </a>
                </div>
                            <!--  Slide  -->
                <div class="slides-item">
                    <a href="https://cicus.us.es/detalle-noticia/actuacion-corous-oct2026">
                        <img src="https://cicus.us.es/files/public/Evento/imagen/1610202607_20261016_135516.jpg" alt="">
                        <div class="slides-home-content">
                            <h2>EL CORO DE LA UNIVERSIDAD DE SEVILLA INTERVIENE EN EL COLOQUIO INTERNACIONAL «COSAS DE INGENIO Y DE LETRAS»</h2>
                            <p>Con motivo de este encuentro académico, interpretará una selección de obras de música vocal del Renacimiento, incluyendo piezas de Josquin Desprez, Arcadelt y Francisco Guerrero</p>
                        </div>
                    </a>
                </div>
                    </div>
    </section>

