            <!-- 1. Rectorado -->
            <div class="triptico-item" style="background-image: url('https://cicus.us.es/assets/web/images/content/visitaRectorado.jpg');">
                <div class="triptico-overlay"></div>
                <div class="triptico-content">
                    <h3 class="triptico-title">Rectorado</h3>
                    <p class="triptico-desc">Explora la Antigua Real Fábrica de Tabacos, un edificio monumental lleno de historia y arte.</p>
                    <a href="https://cicus.us.es/visitas-guiadas-rectorado" class="btn-black">Ver visita</a>
