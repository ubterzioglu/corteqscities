<div id="capaModalFooterNewsletter" class="modal-newsletter-overlay" style="display:none;">
    <div class="modal-newsletter-container">
        <div class="modal-newsletter-header">
            <h5 class="modal-newsletter-title" id="footerModalNewsletterTitle">
                <i class="fas fa-info-circle text-warning mr-2"></i> Información            </h5>
            <button type="button" class="modal-newsletter-close" onclick="closeFooterNewsletterModal()">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-newsletter-body">
            <p id="footerModalNewsletterText"></p>
            <div class="modal-newsletter-actions" style="margin-top:20px; text-align:right;">
                <button class="btn btn-black" onclick="closeFooterNewsletterModal()">Entendido</button>
            </div>
        </div>
    </div>
</div>

<script>
function closeFooterNewsletterModal() {
    var modal = document.getElementById('capaModalFooterNewsletter');
    if (modal) modal.style.display = 'none';
}

function mostrarModalFooter(titulo, mensaje, esExito) {
    var titleEl = document.getElementById('footerModalNewsletterTitle');
    var textEl = document.getElementById('footerModalNewsletterText');
    var modal = document.getElementById('capaModalFooterNewsletter');
    
    if (titleEl && textEl && modal) {
        var icono = esExito ? '<i class="fas fa-check-circle text-success mr-2"></i> ' : '<i class="fas fa-exclamation-triangle text-warning mr-2"></i> ';
        titleEl.innerHTML = icono + titulo;
        textEl.innerText = mensaje;
        modal.style.display = 'flex';
    } else {
        alert(mensaje);
    }
}

function enviarSuscripcionFooter(e) {
    e.preventDefault();
    
    var nombre = document.getElementById('nl_nombre').value.trim();
    var email = document.getElementById('nl_email').value.trim();
    var politica = document.getElementById('nl_politica').checked;
    var msgDiv = document.getElementById('newsletter-message');
    
    msgDiv.style.display = 'none';
    
    // Validación al pulsar el botón Suscribirse
    var errores = [];
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        errores.push('Por favor, introduce una dirección de correo electrónico válida.');
    }
    if (!politica) {
        errores.push('Debes aceptar la política de privacidad para poder suscribirte.');
    }
    
    if (errores.length > 0) {
        msgDiv.className = 'newsletter-message error';
        msgDiv.innerHTML = '<i class="fas fa-exclamation-circle mr-1"></i> ' + errores.join('<br>');
        msgDiv.style.display = 'block';
        return false;
    }
    
    var btnSubmit = document.getElementById('nl_btn_submit');
    btnSubmit.disabled = true;
    btnSubmit.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Enviando...';
    
    $.ajax({
        url: 'https://cicus.us.es/servicios/newsletter-suscripcion',
        type: 'POST',
        data: {
            nombre: nombre,
            email: email,
            politica: politica ? 1 : 0
        },
        dataType: 'json',
        success: function(res) {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = 'Suscribirse';
            
            if (res.success) {
                document.getElementById('newsletter-form-footer').reset();
                mostrarModalFooter('Confirmación enviada', res.message, true);
            } else {
                if (res.already_active) {
                    mostrarModalFooter('Ya estás suscrito', res.message, false);
                } else {
                    msgDiv.className = 'newsletter-message error';
                    msgDiv.innerHTML = '<i class="fas fa-exclamation-circle mr-1"></i> ' + res.message;
                    msgDiv.style.display = 'block';
                }
            }
        },
        error: function(xhr, status, error) {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = 'Suscribirse';
            msgDiv.className = 'newsletter-message error';
            msgDiv.innerHTML = '<i class="fas fa-exclamation-circle mr-1"></i> Error de conexión al procesar la solicitud.';
            msgDiv.style.display = 'block';
        }
    });
}
</script>

        
