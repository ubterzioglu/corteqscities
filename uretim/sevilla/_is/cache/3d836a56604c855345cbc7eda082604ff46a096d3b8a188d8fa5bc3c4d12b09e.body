    <div class="modal-newsletter-container modal-success-container">
        <div class="modal-newsletter-header modal-success-header">
            <button type="button" class="modal-newsletter-close modal-success-close" onclick="document.getElementById('capaModalSolicitudRecibida').style.display='none'">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-newsletter-body modal-success-body">
            <div class="modal-success-icon">
                <svg width="70" height="70" viewBox="0 0 24 24" fill="none" stroke="var(--destacado)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h2 class="modal-success-title">¡Solicitud recibida!</h2>
            <p class="modal-success-text-main">Gracias por enviarnos su solicitud.</p>
            <p class="modal-success-text-sub">Nos pondremos en contacto con usted en la mayor brevedad posible para su tramitación.</p>
            <div class="modal-newsletter-actions modal-success-actions">
                <button type="button" class="btn btn-success-close" onclick="document.getElementById('capaModalSolicitudRecibida').style.display='none'">Cerrar</button>
            </div>
        </div>
    </div>
</div>


<div id="capaModalNewsletter" class="modal-newsletter-overlay" style="display:none;" >
    <div class="modal-newsletter-container">
        
        
    </div>
</div>


<script>
    function closeNewsletterModal() {
        document.getElementById('capaModalNewsletter').style.display='none';
    }

    document.addEventListener("DOMContentLoaded", function() {
        const container = document.getElementById('catalogoTripticoCarrusel');
        if (container) {
            let intervalId = null;

            function getScrollPercentage() {
                const width = window.innerWidth;
                if (width <= 480) {
                    return -100; // 1 visible
                } else if (width <= 767) {
                    return -50;  // 2 visibles
                } else if (width <= 1023) {
                    return -33.333; // 3 visibles
                } else {
                    return -20;  // 5 visibles
                }
            }

            function startAutoplay() {
                if (intervalId) return;
                intervalId = setInterval(() => {
                    if (window.innerWidth < 1024 || !container.matches(':hover')) {
                        const firstItem = container.firstElementChild;
                        if (firstItem) {
                            const scrollPercent = getScrollPercentage();
                            firstItem.style.transition = 'margin-left 800ms cubic-bezier(0.25, 1, 0.5, 1)';
                            firstItem.style.marginLeft = scrollPercent + '%';
                            setTimeout(() => {
                                firstItem.style.transition = 'none';
                                firstItem.style.marginLeft = '0';
                                container.appendChild(firstItem);
                            }, 800);
                        }
                    }
                }, window.innerWidth < 1024 ? 3000 : 2000);
            }

            function stopAutoplay() {
                if (intervalId) {
                    clearInterval(intervalId);
                    intervalId = null;
                }
            }

            startAutoplay();

            container.addEventListener('mouseenter', () => {
                if (window.innerWidth >= 1024) {
                    stopAutoplay();
                    const firstItem = container.firstElementChild;
                    if (firstItem) {
                        firstItem.style.transition = 'none';
                        firstItem.style.marginLeft = '0';
                    }
                }
            });

            container.addEventListener('mouseleave', () => {
                if (window.innerWidth >= 1024) {
                    startAutoplay();
                }
            });
        }
    });
</script>



        
