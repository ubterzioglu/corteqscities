<style data-type="vc_custom-css">.sect-02 .h2{
    color: #1C72B3;
    font-weight: 700;
    font-size: 18px;
    line-height: 26px;
    margin-bottom: 15px;
}

.sect-02 p{
    color: #333;
font-size: 14px;
line-height: 25px;
margin-bottom: 30px;
}

.sect-02 a{
    color: #1c72b3;
font-weight: bold;
font-size: 13px;
text-align: right;
display: block;
display: flex;
align-items: center;
justify-content: end;
}

.sect-02 .cuerpo_ img{
    width: 18px;
    margin-left: 15px;
}

.sect-02 .vc_column-inner > .wpb_wrapper{
    border-radius: 8px;
background-color: #F9F9F9;
filter: drop-shadow(0px 16px 40px rgba(112, 144, 176, 0.2));
}

.sect-02 .cuerpo_{
    padding: 0 20px 20px 20px;
}

.sect-02{
    max-width: 1200px;
margin: 0 auto;
}

.sect-03 .h2, .sect-04 .h2{
        color: #1F7BBC;
        font-weight: 800;
font-size: 58px;
line-height: 72px;
margin-bottom: 55px !important;
}

.sect-03 .wpb_column, .sect-04 .wpb_column{
    max-width: 1200px;
margin: 0 auto;
float: none;
}

.sect-0m .wpb_column {
    max-width: 1300px;
    margin: 0 auto;
    float: none;
}

.collage{
    display: flex;
    max-height: 720px;
}

.collage .col_2_1, .collage .col_2_2{
    display: flex;
    height: 50%;
}

.collage img{
    height: 100%;
object-fit: cover;
width: 100%;
}

.col_2_1_1, .col_2_2_2{
    width: 65%;
}

.col_2_1_2, .col_2_2_1{
    width: 35%;
}

.abs_{
    background-color: #fb0;
color: white;
font-weight: 800;
font-size: 18px;
padding: 10px;
position: absolute;
width: 180px;
}

.col_1, .col_2_2_1, .col_2_2_2, .col_2_1_1, .col_2_1_2{
    position: relative;
}

.col_1 .abs_, .col_2_1_2 .abs_, .col_2_2_1 .abs_{
    bottom: 5px;
}

.col_2_1_1 .abs_, .col_2_2_2 .abs_{
    top: 5px;
}

.collage a:hover img{
    opacity: 0.7;
}

.av_{
    display: flex;
    align-items: center;
}

.av_ img{
    width: 42px;
}

.av_ p{
    color: #1F7BBC;
font-weight: 700;
font-size: 18px;
margin-bottom: 0;
}

.mapa img{
    filter: drop-shadow(0px 16px 40px rgba(112, 144, 176, 0.2));
border-radius: 24px;
}

.cal_, .hor_{
    display: flex;
    align-items: center;
}

.cal_ img, .hor_ img{
    max-width: 90px;
    margin-right: 20px;
}

.cal_ p, .hor_ p{
    font-weight: 800;
    font-size: 30px;
    line-height: 35px;
    color: #1F7BBC;
    margin-bottom: 0;
}

.sect-04 .h2 {
    margin-bottom: 25px !important;
}


.col_1, .col_2_1_1, .col_2_1_2, .col_2_2_1, .col_2_2_2{
    padding: 5px;
}

.fechas_ > div > div{
    background-color: #1F7BBC;
color: white;
padding: 10px;
}

.fechas_ li{
    font-size: 13px;
    line-height: 20px;
    color: #1F7BBC;
    display: flex;
    box-shadow: inset 0px -1px 0px #E5E5E5;
}
.fechas_{
    max-width: 436px;
filter: drop-shadow(0px 16px 40px rgba(112, 144, 176, 0.2));
border-left: 1px solid #E5E5E5;
border-right: 1px solid #E5E5E5;
}

.fechas_ ul{
 margin-left: 0;   
}

.fechas_ li div{
    width: 50%;
    padding: 10px;
}

@media(max-width: 1100px){
    .sect-03 .h2, .sect-04 .h2 {
    color: #1F7BBC;
