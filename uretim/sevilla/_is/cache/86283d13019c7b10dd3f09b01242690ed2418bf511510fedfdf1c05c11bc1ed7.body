.et_mobile_menu, .et-db #et-boc .et-l .et_mobile_menu {
  display: inline-grid;
      -webkit-box-shadow: 0 2px 5px rgba(0,0,0,0);
  }
  .mobile_menu_bar, .et-db #et-boc .et-l .mobile_menu_bar {
    position: relative;
    display: none;
    line-height: 0;
}
  
  
#slide-in-open{
cursor: pointer;
}
  
.line{
display: block;
position: absolute;
height: 2px;
width: 30px;
background: #24394A;
border-radius: 9px;
opacity: 1;
-webkit-transition: .1s ease-in-out;
-moz-transition: .1s ease-in-out;
-o-transition: .1s ease-in-out;
transition: .1s ease-in-out;
}

.line-2 {
top: 10px;
}

.line-3 {
top: 20px;
}
  
#slide-in-open.open .line-1 {
top: 10px;
-webkit-transform: rotate(135deg);
-moz-transform: rotate(135deg);
-o-transform: rotate(135deg);
transform: rotate(135deg);
}

#slide-in-open.open .line-2 {
display: none;
}

#slide-in-open.open .line-3 {
top: 10px;
-webkit-transform: rotate(-135deg);
-moz-transform: rotate(-135deg);
-o-transform: rotate(-135deg);
transform: rotate(-135deg);
}
  
.slide-in-menu {
left: 0 !important;
opacity: 1 !important;
}
  
.slide-in-menu-container {
  -webkit-transition: all 1s ease !important;
  -moz-transition: all 1s ease !important;
  -o-transition: all 1s ease !important;
  -ms-transition: all 1s ease !important;
  transition: all 1s ease !important;
  height: 90vh !important;
  scrollbar-width: none;
  overflow-y: scroll;
}
  
  .slide-in-menu-container::-webkit-scrollbar{
    display: none;
  }
  
  .show-search {
    display: block !important;
  }
</style>


<script>
  
jQuery(function($){  
	$('#slide-in-open').click(function(){
		$(this).toggleClass('open');
    $('.slide-in-menu-container').toggleClass('slide-in-menu');
	});
  $('#menu-search-button').click(function(){
    $('#menu-search-row').toggleClass('show-search');
    	let BGelement = document.getElementById("search-background-black");
      if(BGelement){
        BGelement.parentNode.removeChild(BGelement);
      }else{
        let fullSearchBG = document.createElement("div");
        fullSearchBG.style.position = "fixed";
        fullSearchBG.style.width = "100vw";
        fullSearchBG.style.height = "100vh";
        fullSearchBG.style.zIndex = 1;
        fullSearchBG.style.left = 0;
        fullSearchBG.style.top = 0;
        fullSearchBG.id = "search-background-black";
        fullSearchBG.style.background = "rgba(0,0,0,0.75)";
        document.body.appendChild(fullSearchBG);
      }
      
	});
});
  
</script></div>
