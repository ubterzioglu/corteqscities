stro-cid-su6xvggn>Русский</option><option value="/cs" data-loc="cs" data-astro-cid-su6xvggn>Čeština</option><option value="/sk" data-loc="sk" data-astro-cid-su6xvggn>Slovenčina</option><option value="/el" data-loc="el" data-astro-cid-su6xvggn>Ελληνικά</option><option value="/sv" data-loc="sv" data-astro-cid-su6xvggn>Svenska</option><option value="/da" data-loc="da" data-astro-cid-su6xvggn>Dansk</option><option value="/uk" data-loc="uk" data-astro-cid-su6xvggn>Українська</option> </select> </div>  </div> </div> <header class="pan-hero" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <picture class="pan-hero-photo" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <source srcset="/img/palacio-andaluz-hero-stage.webp 1172w, /img/palacio-andaluz-hero-stage@2x.webp 1757w" sizes="(max-width: 759px) 340px, 640px" type="image/webp" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <img src="/img/palacio-andaluz-hero-stage.webp" alt="A flamenco dancer mid-turn in a pink ruffled dress on a dark stage, skirt lifted in motion (representative photograph of a flamenco performance, not El Palacio Andaluz itself)" width="1172" height="1440" fetchpriority="high" decoding="async" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> </picture> <div class="pan-hero-veil" aria-hidden="true" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"></div> <div class="pan-wrap pan-hero-wrap" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div class="pan-hero-copy" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <p class="pan-kicker" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">El Palacio Andaluz · Isla de la Cartuja, Seville</p> <h1 class="pan-h1" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Seville&#39;s biggest flamenco stage, twice a night</h1> <p class="pan-rating" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><span class="pan-stars" aria-hidden="true" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">★★★★★</span> <span data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">4.6 (1,507 verified reviews · GetYourGuide)</span></p> <p class="pan-sub" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A sixteen-piece programme runs alegrías to bulería in about ninety minutes, twice every night.</p> <div class="pan-hero-actions" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <a class="pan-btn-cta pan-btn-hero" href="/go/g6094d09ba4" target="_blank" rel="sponsored noopener" data-cta="hero" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">See tonight&#39;s availability on GetYourGuide ↗</a> <span class="pan-price" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">From <strong data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A$58</strong></span> </div> <p class="pan-scarcity" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Two sittings a night and no extra shows for demand — the front-of-stage dinner tables and the 19:00 sitting go first in Semana Santa and Feria week.</p> </div> </div> </header> <div class="pan-trust" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <ul class="pan-wrap pan-trust-row" aria-label="Booking through GetYourGuide" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <li data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <b data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><span class="pan-trust-ico" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.2" y="5" width="17.6" height="16" rx="2.2"/><path d="M3.2 9.4h17.6M8 3v4M16 3v4"/><path d="M12 12.6v3.1l2 1.1"/></svg></span>Reserve now, pay later</b> <span class="pan-trust-d" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Reserve your seats for the flamenco evening now and pay nothing today.</span> </li><li data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <b data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><span class="pan-trust-ico" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5.5c0 4.3-2.9 7.4-7 8.8-4.1-1.4-7-4.5-7-8.8V6l7-3z"/><path d="M9 12l2 2 4-4.2"/></svg></span>Free cancellation up to 24 hours</b> <span class="pan-trust-d" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Plans shift in Seville? Cancel at least 24 hours before your sitting and the full amount comes back.</span> </li><li data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <b data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><span class="pan-trust-ico" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.2" y="5" width="17.6" height="16" rx="2.2"/><path d="M3.2 9.4h17.6M8 3v4M16 3v4"/><path d="M12 12.6v3.1l2 1.1"/></svg></span>Two sittings, every night of the week</b> <span class="pan-trust-d" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">19:00 and 21:30, with no extra shows added in high season</span> </li><li data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <b data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><span class="pan-trust-ico" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.4 4 5.6 4 9s-1.4 6.6-4 9c-2.6-2.4-4-5.6-4-9s1.4-6.6 4-9z"/></svg></span>A museum included with every ticket</b> <span class="pan-trust-d" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The Flamenco Dress Museum, best seen before you&#39;re seated</span> </li> </ul> </div> <main data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <section class="pan-facts" aria-labelledby="pan-facts-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div class="pan-wrap" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <p id="pan-facts-h" class="pan-eyebrow" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Quick facts before you book</p> <dl class="pan-facts-grid" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div class="pan-fact" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><dt data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">What it is</dt><dd data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A nightly flamenco cuadro on Seville&#39;s largest dedicated flamenco stage, with a Flamenco Dress Museum included on every ticket</dd></div><div class="pan-fact" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><dt data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Where</dt><dd data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Isla de la Cartuja, across the Guadalquivir from Seville&#39;s old town — the former Cruzcampo pavilion from the 1992 Expo</dd></div><div class="pan-fact" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><dt data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">How long</dt><dd data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">About 90 minutes on stage, plus roughly 30 minutes for the museum beforehand</dd></div><div class="pan-fact" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><dt data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Showtimes</dt><dd data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Two fixed sittings a night, 19:00 and 21:30, seven nights a week</dd></div> </dl> </div> </section> <section class="pan-why" aria-labelledby="pan-why-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-why-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Why the Palacio suits a first flamenco night</h2> <div class="pan-why-grid" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div class="pan-why-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A stage built to hold the whole cuadro</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">El Palacio Andaluz is built around what its own venue material calls Seville&#39;s largest stage dedicated to flamenco, and the show is cast to fill it: more than ten dancers, singers and guitarists on stage together rather than a trio working a small tablao floor. The room itself is the former Cruzcampo exhibition pavilion from the 1992 Universal Expo, repurposed as a theatre rather than built as one from scratch.</p> </div><div class="pan-why-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Sixteen pieces, not a highlight reel</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The published programme runs a full sequence rather than a handful of crowd-pleasers: it opens on alegrías and moves through soleá, fandango, tientos, guajira, a flamenco adaptation of scenes from Bizet&#39;s opera Carmen, tangos, farruca, cantiñas, caracoles, martinete and seguiriyas, before the whole cast closes on sevillanas and bulería. Castanets, shawls, fans, a cajón and the long-trained bata de cola dress all appear across the ninety minutes, not as one-off props.</p> </div><div class="pan-why-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Emilio Ramírez has directed it from the start</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The choreography and the direction are credited throughout to Emilio Ramírez, known on stage as &#39;El Duende&#39; — the production&#39;s lead male dancer as well as its artistic director, with a performing history that includes New York&#39;s City Center. Spanish public television has selected the show for flamenco promotion abroad, citing its staging and artistic quality.</p> </div><div class="pan-why-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A museum comes with every seat</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Every ticket, at every tier, includes entry to the venue&#39;s Museo del Traje de Flamenca — the Flamenco Dress Museum — best seen in the roughly half hour before the show starts rather than rushed on the way to your table. It&#39;s built into the evening rather than sold as an add-on.</p> </div> </div> </section> <section class="pan-tiles" aria-labelledby="pan-tiles-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-tiles-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The tiles on tonight&#39;s programme</h2> <p class="pan-tiles-intro" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The full show runs sixteen pieces in a fixed order. These six carry the evening — an azulejo tile for each, the way the room&#39;s own tiled walls are built from repeating, individually complete pieces.</p> <div class="pan-tiles-grid" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div class="pan-tile" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-tile-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">I</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Alegrías opens the night</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A palo alegre from Cádiz, danced with a bata de cola — the long-trained dress — and it&#39;s the piece the programme opens on, before the rest of the cast has been introduced.</p> </div><div class="pan-tile" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-tile-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">II</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Guajira, with fan and shawl</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">One of the lighter, Cuban-inflected palos, worked with a folding fan and a shawl rather than the castanets that show up elsewhere in the programme.</p> </div><div class="pan-tile" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-tile-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">III</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Scenes from Carmen</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A flamenco adaptation of passages from Bizet&#39;s opera sits partway through the show — Spanish classical material read through flamenco footwork and castanets rather than sung in French.</p> </div><div class="pan-tile" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-tile-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">IV</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Farruca, danced solo</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A male solo palo, danced straight and percussive with no fan or dress to work around — usually the starkest few minutes of the whole programme.</p> </div><div class="pan-tile" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-tile-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">V</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Tangos, at full pace</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A faster group piece, one of two tangos on the published running order (the second closer to the Triana style), built to lift the room&#39;s energy before the home stretch.</p> </div><div class="pan-tile" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-tile-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">VI</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The finale: sevillanas and bulería</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The whole cast returns for the close — sevillanas, the paired folk dance danced across Seville every April at the Feria, followed by a full-company bulería to take the room out.</p> </div> </div> </section> <section class="pan-gallery" aria-labelledby="pan-gallery-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-gallery-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Flamenco, the arch and the tiles</h2> <p class="pan-gallery-intro" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Representative photographs of the palos, the instruments and the Andalusian architecture the room draws on — not shots from inside El Palacio Andaluz itself.</p> <div class="pan-gallery-grid" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <figure class="pan-gallery-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <img src="/img/palacio-andaluz-dancer.webp" alt="A flamenco dancer in a black and white ruffled dress, mid-turn on a lit stage with a red flower in her hair (representative photograph of a flamenco performance, not El Palacio Andaluz)" loading="lazy" width="1200" height="1000" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <figcaption data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The cuadro on stage</figcaption> </figure><figure class="pan-gallery-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <img src="/img/palacio-andaluz-guitar.webp" alt="A guitarist's hand plucking the strings of an acoustic guitar in close-up, warm window light behind (representative photograph of flamenco guitar, not El Palacio Andaluz's own guitarists)" loading="lazy" width="1200" height="1000" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <figcaption data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The guitarists</figcaption> </figure><figure class="pan-gallery-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <img src="/img/palacio-andaluz-arches.webp" alt="A Mudéjar palace courtyard with a horseshoe-arched doorway, carved plasterwork and orange trees, at the Real Alcázar of Seville (representative photograph of Andalusian palace architecture, not El Palacio Andaluz's own building)" loading="lazy" width="1200" height="1000" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <figcaption data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A horseshoe arch, Andalusian-palace style</figcaption> </figure><figure class="pan-gallery-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <img src="/img/palacio-andaluz-tiles.webp" alt="The tiled, curved arcade and towers of the Plaza de España in Seville under a blue sky (representative photograph of Seville's azulejo tilework, not El Palacio Andaluz's own décor)" loading="lazy" width="1200" height="1000" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <figcaption data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The city&#39;s azulejo tradition</figcaption> </figure><figure class="pan-gallery-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <img src="/img/palacio-andaluz-reddress.webp" alt="A flamenco dancer in a red ruffled dress spinning on a dark stage, hair in motion (representative photograph of a flamenco performance, not El Palacio Andaluz)" loading="lazy" width="1200" height="1000" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <figcaption data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Mid-programme, at pace</figcaption> </figure><figure class="pan-gallery-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <img src="/img/palacio-andaluz-giralda.webp" alt="The Giralda tower and Seville Cathedral rising above the rooftops of Seville's old town at sunset (representative photograph of Seville's historic centre, across the river from Isla de la Cartuja)" loading="lazy" width="1200" height="1000" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <figcaption data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Across the river, the old town</figcaption> </figure> </div> </section> <section class="pan-venue" aria-labelledby="pan-venue-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-venue-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The stage on Isla de la Cartuja</h2> <p class="pan-venue-intro" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The theatre sits inside a former Expo &#39;92 exhibition pavilion, re-fitted around what the venue&#39;s own material calls Seville&#39;s largest flamenco stage.</p> <dl class="pan-venue-list" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div class="pan-venue-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <dt data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A pavilion, not a purpose-built tablao</dt> <dd data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The building started life as the Cruzcampo pavilion for Seville&#39;s 1992 Universal Exposition on Isla de la Cartuja, and it&#39;s been run as a flamenco theatre-restaurant since roughly 1995 — a repurposed exhibition hall rather than a room built from the ground up as a tablao.</dd> </div><div class="pan-venue-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <dt data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Sized for the full cuadro</dt> <dd data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The stage is built to hold the production&#39;s full cast — more than ten dancers, singers and guitarists together — rather than the two or three musicians and a soloist a small tablao room can fit.</dd> </div><div class="pan-venue-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <dt data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The Flamenco Dress Museum</dt> <dd data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Included with every ticket and meant to be seen before the show rather than after it, the museum runs alongside the main room rather than in a separate building.</dd> </div><div class="pan-venue-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <dt data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Reduced-mobility access</dt> <dd data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The venue states it accommodates guests with reduced mobility, and sits on urban bus routes C2, C3, 03 and 06, with a hop-on-hop-off tourist bus stop nearby.</dd> </div> </dl> <div class="pan-evening" aria-labelledby="pan-evening-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h3 id="pan-evening-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Inside the room</h3> <p class="pan-evening-intro" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The same shape most nights: arrive for the museum, take your seat for the tier you booked, then the ninety-minute programme.</p> <ol class="pan-evening-list" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <li data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-evening-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">On arrival</span> <strong data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The Flamenco Dress Museum</strong> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Doors open with time built in to see the Museo del Traje de Flamenca before the room is seated — worth treating as the start of the evening rather than a lobby to pass through.</p> </li><li data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-evening-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Seating</span> <strong data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Your table matches your ticket</strong> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Show-only tickets sit to the side; the drink and dinner tiers move you toward tables set for food, poured or served once the room has filled.</p> </li><li data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-evening-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The show</span> <strong data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Sixteen pieces, ninety minutes</strong> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Alegrías to bulería without an interval — the cast, guitarists and singers stay on or beside the stage for the full run rather than rotating off between pieces.</p> </li><li data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-evening-mark" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The close</span> <strong data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Sevillanas takes the whole room out</strong> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The finale is a full-company piece rather than a single soloist&#39;s bow, and it&#39;s the point in the evening the audience is most often clapping along rather than just watching.</p> </li> </ol> </div> </section> <section class="pan-compare" aria-labelledby="pan-compare-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-compare-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A drink, tapas or dinner</h2> <div class="pan-compare-scroll" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <table data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <caption data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A drink, tapas or dinner — El Palacio Andaluz&#39;s own tiers</caption> <thead data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <tr data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><th scope="col" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Tier</th><th scope="col" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">What comes with it</th><th scope="col" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Best for</th></tr> </thead> <tbody data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <tr data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><th scope="row" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Show only</th><td data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Side seating, the full sixteen-piece programme, and the Flamenco Dress Museum before the show</td><td data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A late decision, or a budget that&#39;s already spent on dinner elsewhere</td></tr><tr data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><th scope="row" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Show + drink</th><td data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A glass of cava and a chocolate truffle, served at your seat</td><td data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A short stop before or after dinner in town</td></tr><tr data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><th scope="row" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Show + dinner</th><td data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A three-course Andalusian dinner with wine — cured meats and cheese to start, a choice of mains, then a warm chocolate dessert — at a table facing the stage</td><td data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Making the show itself the evening&#39;s main event</td></tr><tr data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"><th scope="row" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A flamenco show with no dress museum and no dedicated stage</th><td data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Whatever that room happens to offer — it varies venue to venue</td><td data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Doesn&#39;t compete with the tiers above — a different kind of evening</td></tr> </tbody> </table> </div> <p class="pan-compare-note" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A drink, a plate of tapas or a full sit-down dinner can all be added to any of the palos below — the food and the programme run on separate tracks, so choosing a bigger tier changes what&#39;s on your table, not what&#39;s on stage.</p> <a class="pan-premium-link" href="/go/gd96e1a7da0" target="_blank" rel="sponsored noopener" data-cta="dl-premium" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Also on this listing: the show with a full Andalusian dinner ↗</a> </section> <section class="pan-book" aria-labelledby="pan-book-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-book-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Pick your date below</h2> <p class="pan-experiences-intro" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">GetYourGuide handles the booking itself — live seat availability, and your total charged in your own currency at checkout.</p> <div class="pan-widget-wrap" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div data-gyg-widget="availability" data-gyg-variant="horizontal" data-gyg-tour-id="144288" data-gyg-locale-code="en-US" data-gyg-currency="AUD" data-gyg-cmp="pc-A-palacio-andaluz-en" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"></div> <p class="pan-widget-note" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Dates, seats and pricing update live from GetYourGuide&#39;s own booking system.</p> </div> </section> <section class="pan-rail" aria-labelledby="pan-rail-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div class="pan-rail-head" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-rail-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">More Seville experiences</h2> <a class="pan-hub-link" href="/go/g8fa290d5b8" target="_blank" rel="sponsored noopener" data-cta="hub" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">See all Seville experiences ↗</a> </div> <div data-gyg-widget="activities" data-gyg-location-id="48" data-gyg-locale-code="en-US" data-gyg-currency="AUD" data-gyg-cmp="rail-A-palacio-andaluz-en" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"></div> </section> <section class="pan-plan" aria-labelledby="pan-plan-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-plan-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Isla de la Cartuja: getting there and timing</h2> <div class="pan-plan-layout" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <figure class="pan-plan-photo" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <img src="/img/palacio-andaluz-giralda.webp" alt="The Giralda tower and Seville Cathedral rising above the rooftops of Seville's old town at sunset (representative photograph of Seville's historic centre, across the river from Isla de la Cartuja)" loading="lazy" width="1400" height="1000" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <figcaption data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Across the river, the old town</figcaption> </figure> <div class="pan-plan-list" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div class="pan-plan-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Crossing the river to Isla de la Cartuja</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The theatre sits on Isla de la Cartuja, the island across the Guadalquivir that hosted the world&#39;s fair in 1992. It is a separate trip from Seville&#39;s old town, not a walk from Santa Cruz. The venue is served by urban bus lines C2, C3, 03 and 06, plus a hop-on-hop-off tourist bus stop nearby.</p> </div><div class="pan-plan-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Arrive for the museum, not just the show</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Every ticket includes the Flamenco Dress Museum, best seen in the half hour before the room is seated. Turning up right at 19:00 or 21:30 sharp means watching other guests queue past the museum rather than through it.</p> </div><div class="pan-plan-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">19:00 or 21:30 — the same show either time</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Both nightly sittings run the same sixteen-piece programme, so the choice comes down to the rest of your evening in Seville rather than which show is better — an earlier finish for a 19:00 sitting, or dinner in town first for the 21:30 one.</p> </div><div class="pan-plan-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Booking in Semana Santa and Feria de Abril</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">No extra sittings are added for Seville&#39;s busiest weeks, so the front-of-stage dinner tables and the earlier 19:00 slot are the first to fill when the city&#39;s Easter and April Feria crowds are in town.</p> </div> </div> </div> </section> <section class="pan-guides" aria-labelledby="pan-guides-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-guides-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Planning a night at El Palacio Andaluz</h2> <div class="pan-guides-grid" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <a class="pan-guide-card" href="/guides/palacio-andaluz-evening-step-by-step/" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-guide-kick" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A first-timer&#39;s guide</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A night at El Palacio Andaluz: what actually happens, step by step</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">From the moment doors open to the closing bulería — what to expect at each stage of a night at El Palacio Andaluz, and where the museum and your seating tier fit in.</p> <span class="pan-guide-cta" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Read more →</span> </a><a class="pan-guide-card" href="/guides/palacio-andaluz-flamenco-and-andalusian-dances/" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-guide-kick" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">What&#39;s actually on stage</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Flamenco and the other Andalusian dances at El Palacio Andaluz</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Alegrías, guajira, farruca, tangos and the sevillanas finale — what each palo is, and where the Carmen sequence and the paired folk dance sevillanas fit beside them.</p> <span class="pan-guide-cta" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Read more →</span> </a><a class="pan-guide-card" href="/guides/palacio-andaluz-the-room/" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-guide-kick" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The building</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The room: a palace-style theatre on Isla de la Cartuja</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A former Expo &#39;92 pavilion, built around Seville&#39;s largest flamenco stage and a Flamenco Dress Museum included with every ticket.</p> <span class="pan-guide-cta" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Read more →</span> </a><a class="pan-guide-card" href="/guides/palacio-andaluz-drink-tapas-dinner/" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-guide-kick" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Choosing your ticket</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Cava, tapas or a full sit-down meal at El Palacio Andaluz</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Show-only, a cava and a truffle, or a full three-course Andalusian dinner — what each tier actually adds, and who each one suits.</p> <span class="pan-guide-cta" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Read more →</span> </a><a class="pan-guide-card" href="/guides/palacio-andaluz-getting-there/" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-guide-kick" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Getting there</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Getting there and timing in Seville</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">El Palacio Andaluz sits on Isla de la Cartuja, across the river from the old town — how to reach it, and whether to choose the 19:00 or 21:30 sitting.</p> <span class="pan-guide-cta" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Read more →</span> </a><a class="pan-guide-card" href="/guides/palacio-andaluz-semana-santa-feria/" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <span class="pan-guide-kick" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Seville&#39;s busiest weeks</span> <h3 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Semana Santa and Feria weeks: booking the show in Seville&#39;s busiest season</h3> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">No extra sittings are added when the city fills for Easter and the Feria de Abril — what that means for booking El Palacio Andaluz.</p> <span class="pan-guide-cta" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Read more →</span> </a> </div> </section> <section class="pan-faq" aria-labelledby="pan-faq-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 id="pan-faq-h" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">El Palacio Andaluz questions</h2> <div class="pan-faq-list" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <details class="pan-faq-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <summary data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">What happens during the evening?</summary> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Doors open with time to see the Flamenco Dress Museum, included with every ticket, before the room is seated for a sixteen-piece programme — alegrías to bulería, about ninety minutes, with no interval. Show-only tickets sit to the side; the drink and dinner tiers are served at tables facing the stage.</p> </details><details class="pan-faq-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <summary data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">What dance styles are in the show?</summary> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The published running order moves through alegrías, soleá, fandango, tientos, guajira, a flamenco adaptation of scenes from Bizet&#39;s Carmen, two tangos, farruca, cantiñas, caracoles, martinete and seguiriyas, closing with the full cast on sevillanas and bulería.</p> </details><details class="pan-faq-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <summary data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Is dinner included?</summary> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Only on the dinner tier. Show-only gets you a side seat and the museum; the drink tier adds a cava and a chocolate truffle; the dinner tier adds a three-course Andalusian menu with wine at a table facing the stage.</p> </details><details class="pan-faq-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <summary data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Where exactly is El Palacio Andaluz?</summary> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">On Isla de la Cartuja, the island across the Guadalquivir from Seville&#39;s old town, in a converted pavilion from the 1992 Universal Expo — reachable on urban bus lines C2, C3, 03 or 06, with a hop-on-hop-off tourist bus stop nearby.</p> </details><details class="pan-faq-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <summary data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Should I book the 19:00 or the 21:30 show?</summary> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Both sittings run the identical sixteen-piece programme, so it comes down to the rest of your evening — an earlier finish if you choose 19:00, or dinner in town first if you choose 21:30.</p> </details><details class="pan-faq-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <summary data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Is the Flamenco Dress Museum worth the extra time?</summary> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">It&#39;s included with every ticket rather than sold separately, and it&#39;s built to be seen in the roughly half hour before the room is seated — arriving right at showtime means missing it rather than saving time.</p> </details><details class="pan-faq-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <summary data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Is it suitable for children?</summary> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">The venue doesn&#39;t publish a minimum age on its own booking pages; check the age guidance on the GetYourGuide listing at checkout before booking for young children.</p> </details><details class="pan-faq-item" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <summary data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Can I cancel if my plans change?</summary> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Plans change — a GetYourGuide booking here can be cancelled free of charge right up to 24 hours before curtain, and the currency-converted total shows at checkout rather than being left to guesswork.</p> </details> </div> </section> <section class="pan-cta-band" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <div class="pan-wrap" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <h2 data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">A cuadro of more than ten dancers, singers and guitarists, sixteen pieces long, under a horseshoe arch on Seville&#39;s largest flamenco stage.</h2> <a class="pan-btn-cta pan-btn-hero" href="/go/ga45199578d" target="_blank" rel="sponsored noopener" data-cta="bottom" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">See El Palacio Andaluz tickets on GetYourGuide ↗</a> </div> </section> </main> <footer class="pan-footer" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;"> <p data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">An independent guide to the flamenco show at El Palacio Andaluz, Seville.</p> <p class="pan-disclosure" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">This site is run independently of El Palacio Andaluz and of GetYourGuide. It exists to help you plan the evening and points you to GetYourGuide to actually book; the venue sets the programme, pricing and inclusions you&#39;ll see there.</p> <p class="pan-author" data-astro-cid-t5yhbfmd style="--panPrimary: #1D4E89;--panAccent: #D9A441;--panAccent2: #3F6E58;--panCta: #1D4E89;--panBg: #FBF5E9;--panInk: #1E1B16;--panInkSoft: #5B4F3F;--panLine: #E6D9BE;--panLinkText: #8A5A1E;--panCtaText: #FBF5E9;">Rocío Peláez — I grew up in La Macarena and have danced sevillanas at the Feria de Abril every year I can remember. I&#39;m not a flamenco dancer myself — what I write here about the palos on stage is what the programme notes and the cast&#39;s own material say, not a performer&#39;s insider account.</p> </footer> <a class="book-sticky" href="/go/g6094d09ba4" target="_blank" rel="sponsored noopener" data-cta="sticky" data-astro-cid-qff7fdmd> <span class="book-sticky-text" data-astro-cid-qff7fdmd><span class="book-sticky-label" data-astro-cid-qff7fdmd>See tonight&#39;s availability on GetYourGuide</span><span class="book-sticky-note" data-astro-cid-qff7fdmd>Free cancellation · Pay nothing today</span></span> <span class="book-sticky-arrow" aria-hidden="true" data-astro-cid-qff7fdmd>↗</span> </a>  <script>(function(){const E="6271313c347c62",a="17bfd87e32f5a4ac0e150f94c7a3dafc85a54b07";(function(){for(var R={US:"USD",GB:"GBP",AU:"AUD",NZ:"NZD",CA:"CAD",DE:"EUR",FR:"EUR",ES:"EUR",IT:"EUR",NL:"EUR",PT:"EUR",IE:"EUR",AT:"EUR",BE:"EUR",FI:"EUR",GR:"EUR",LU:"EUR",SK:"EUR",SI:"EUR",EE:"EUR",LV:"EUR",LT:"EUR",HR:"EUR",CY:"EUR",MT:"EUR",CH:"CHF",SE:"SEK",NO:"NOK",DK:"DKK",PL:"PLN",CZ:"CZK",JP:"JPY",KR:"KRW",TW:"TWD",HK:"HKD",SG:"SGD",TH:"THB",MY:"MYR",ID:"IDR",PH:"PHP",IN:"INR",CN:"CNY",BR:"BRL",MX:"MXN",ZA:"ZAR",AE:"AED"},o="",n=0;n<E.length;n+=2)o+=String.fromCharCode(parseInt(E.substr(n,2),16)^a.charCodeAt(n/2%a.length));for(var c=document.querySelectorAll("[data-gyg-widget]"),r=0;r<c.length;r++)c[r].setAttribute("data-gyg-partner-id",o);function U(){var t=document.createElement("script");t.async=!0,t.src="https://widget.getyourguide.com/dist/pa.umd.production.min.js",document.body.appendChild(t)}function d(t){for(var e=0;e<c.length;e++)c[e].setAttribute("data-gyg-currency",t)}fetch("/cdn-cgi/trace").then(function(t){return t.text()}).then(function(t){var e=t.match(/loc=([A-Z]{2})/);e&&R[e[1]]&&d(R[e[1]])}).catch(function(){}).then(U)})()})();</script>  <script>(function(){const c="A";(function(){var g=/(?:^|\.)(getyourguide|klook|viator)\./i;document.addEventListener("click",function(e){var i=e.target&&e.target.closest?e.target:null,a=i&&i.closest("a[href]");if(!(!a||typeof window.gtag!="function")){var t;try{t=new URL(a.href,location.href)}catch{return}var n={page_variant:c,page_locale:document.documentElement.lang,cta:a.getAttribute("data-cta")||"unmarked"},o=t.hostname.match(g),r=t.origin===location.origin&&t.pathname.match(/^\/go\/([gkvx])[0-9a-f]{10}$/);r&&(o=[null,{g:"getyourguide",k:"klook",v:"viator",x:"other"}[r[1]]]),o?(gtag("event","affiliate_click",Object.assign({affiliate_network:o[1].toLowerCase(),destination:r?t.pathname:t.hostname+t.pathname,transport_type:"beacon"},n)),gtag("event","gyg_cta_click",n)):(t.hash==="#book"||/(^|\s)(btn-cta|book-sticky)(\s|$)/.test(a.className||""))&&gtag("event","cta_internal",n)}},!0)})()})();</script> </body> </html> 