<script type="text/javascript">
 
 	//	Regla formato calendario y eventos
	function setDatesEvent(json) {

 		today = new Date();
 		var year = today.getFullYear(), month = today.getMonth(), day = today.getDate();
		
		var dateURL = parseDate('25/10/26');
 		var selectedMonth;
		if(dateURL != ""){
			selectedMonth= dateURL.getMonth();
		}

		var r = eval('(' + json + ')');
 		if(r[year] == null) {
 			r[year] = {};
 		}
 		if(r[year][month] == null) {
 			r[year][month] = {};
 			if(selectedMonth == month){
	 			r[year][month][day] = "today";
 			}
 		}
   		if(r[year][month][day] != "today") {
   			if(selectedMonth == month){
 				r[year][month][day] = "today";
   			}
 		}
   		
   		var showDay = 'false';
   		if(showDay == 'true' && dateURL != ""){
   			if(r[dateURL.getFullYear()][dateURL.getMonth()][dateURL.getDate()] != undefined){
   				r[dateURL.getFullYear()][dateURL.getMonth()][dateURL.getDate()] += ",selected";
   			}else{
   				r[dateURL.getFullYear()][dateURL.getMonth()][dateURL.getDate()] = "selected";
   			}
   			
   		}
   		
 		r["all"] = {};
 		r["all"]["all"]= {};
 		r["all"]["all"]["all"] = {};
 		r["all"]["all"]["all"]["0"] = "sundays";
 		r["all"]["all"]["all"]["0-6"] = "disabled";   	

 		return r;
 	}
 
 	function parseDate(input) {
 		var parts = input.split('/');
 		var date = new Date(20 + parts[2], parts[1]-1, parts[0]);
 		if('es' == 'en') {
 			date = new Date(20 + parts[2], parts[0] -1 , parts[1]);
		}
		
		return date;
	}

</script>

<script type="text/javascript">
	var dateCalendar = parseDate('25/10/26');

	AUI().use('aui-datepicker', function(A) {
		var rules = null;
		var calendar = new A.Calendar({
			contentBox: "#calendarEvents",
			width:'100%',
			showPrevMonth: false,
			showNextMonth: false,
			disabledDatesRule: "disabled",
			enabledDatesRule: "eventos",			
			date: new Date(dateCalendar.getFullYear(), dateCalendar.getMonth(), dateCalendar.getDate())
		}).render();

		rules = setDatesEvent('{"2026":{"9":{"26,26,28,30,19,23,24,23,2,20,1,6,22,8,3,14,2,3,5,19":"eventos"}}}');
		
		function filter (date, node, rules) {
			
			var rulesStr = rules + '';			
			var rulesSplit = rulesStr.split(",");	
			
			if (rulesSplit.includes("disabled")) {
				node.addClass("disabled");
 			}
			if (rulesSplit.includes("sundays")) {
				node.addClass("sunday");
			}
			if (rulesSplit.includes("today")) {
				node.addClass("hoy");
 			}
			if (rulesSplit.includes("eventos")) {
				node.addClass("evento");
			}
			if (rulesSplit.includes("selected")) {
				node.addClass("selected");
			}
		};
  
		calendar.set("customRenderer", {
			rules: rules,
			filterFunction: filter
		});
    
		var dtdate = A.DataType.Date;
		calendar.on("selectionChange", function (ev) {
			var newDate = ev.newSelection[0];			
			var sdate = dtdate.format(newDate, {format:"%x"});
			
									
					window.location.href = '/web/biblioteca-del-estado-publica-provincial-de-sevilla/inicio' + '?date=' + sdate + "&action=showDay";
				
				
			
		});		
		
				
		
			var prevMonthDate = null;
			if (dateCalendar.getMonth() == 0) {
		    	prevMonthDate = new Date(dateCalendar.getFullYear() - 1, 11, 1);
			} else {
				prevMonthDate = new Date(dateCalendar.getFullYear(), dateCalendar.getMonth() - 1, 1);
			}
			var prevMonthString = dtdate.format(prevMonthDate, {format:"%x"});			
			var prevMonthNodes = A.all("#calendarEvents .yui3-calendarnav-prevmonth");
			prevMonthNodes.each(function(node) {				
				node.detach("click");
				node.setStyle("display", "inline-block");
				node.on('click', function (event) {					
					window.location.href = 'https://www.bibliotecasdeandalucia.es/web/biblioteca-del-estado-publica-provincial-de-sevilla/inicio?p_p_id=eventosportlet_WAR_culturaportlet_INSTANCE_aMszywZtoJGg&p_p_lifecycle=0&p_p_state=normal&p_p_mode=view&p_p_col_id=_118_INSTANCE_BqMX9TrTHDrq__column-2&p_p_col_pos=1&p_p_col_count=3' + "&date=" + prevMonthString;
				});
			});
						
			var nextMonthDate = null;
			if (dateCalendar.getMonth() == 11) {
				nextMonthDate = new Date(dateCalendar.getFullYear() + 1, 0, 1);
			} else {
				nextMonthDate = new Date(dateCalendar.getFullYear(), dateCalendar.getMonth() + 1, 1);
			}
			var nextMonthString = dtdate.format(nextMonthDate, {format:"%x"});
			var nextMonthNodes = A.all("#calendarEvents .yui3-calendarnav-nextmonth");
			nextMonthNodes.each(function(node) {
				node.detach("click");
				node.setStyle("display", "inline-block");
				node.on('click', function (event) {					
					window.location.href = 'https://www.bibliotecasdeandalucia.es/web/biblioteca-del-estado-publica-provincial-de-sevilla/inicio?p_p_id=eventosportlet_WAR_culturaportlet_INSTANCE_aMszywZtoJGg&p_p_lifecycle=0&p_p_state=normal&p_p_mode=view&p_p_col_id=_118_INSTANCE_BqMX9TrTHDrq__column-2&p_p_col_pos=1&p_p_col_count=3' + "&date=" + nextMonthString;
				});
			});			
		
	});
		
</script>

