    <!-- ALL PLUGINS -->
	
	<script src="js/jquery.superslides.min.js"></script>
	<script src="js/images-loded.min.js"></script>
	<script src="js/isotope.min.js"></script>
	<script src="js/baguetteBox.min.js"></script>
	<script src="js/jquery.mapify.js"></script>
	<script src="js/form-validator.min.js"></script>
    <script src="js/contact-form-script.js"></script>
    <script src="js/custom.js"></script>
	<!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script>
        // Initialize the map
        var map = L.map('map').setView([37.3854186,-6.0046562], 19); // Coordenadas de Sevilla
        
        // Set up the OSM layer
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 22,
        }).addTo(map);
        
        // Add a marker
        var marker = L.marker([37.3854186,-6.0046562]).addTo(map)
            .bindPopup('Cerámica Santa Ana<br>Sevilla')
            .openPopup();
        
        // Function to redirect to Google Maps
        function redirectToGoogleMaps() {
            window.open('https://www.google.com/maps/place/Ceramica+Santa+Ana/@37.3854965,-6.0046635,20.25z/data=!4m12!1m5!3m4!2zMzfCsDIyJzU3LjQiTiA1wrA1OSc0Ni43Ilc!8m2!3d37.3826!4d-5.9963!3m5!1s0xd126dc731b7dedf:0xaedf7b225c8d4b8!8m2!3d37.385461!4d-6.0046469!16s%2Fg%2F11ldrlmmzx?entry=ttu', '_blank');
        }

        // Add event listeners for click on map and marker
        map.on('click', redirectToGoogleMaps);
        marker.on('click', redirectToGoogleMaps);
    </script>
</body>
