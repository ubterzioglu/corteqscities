   <!-- MENU -->
<script type="text/javascript">
	$.ready(function(){
	         var miga = $('.md-site-subtitle');
	         var elemento;
	         var array;
	         var nodo;
	         var icono;
	         for (i = 1; i < miga.length; i++) {	             
	             if(typeof(miga[i].outerText) === "undefined" ){
	             	//Funciona con Firefox y chrome pero no en ie
	             	elemento = miga[i].textContent.replace(/ /g,"")+'1';
	             }else{
	            	 //Funciona con ie y chrome
	             	elemento = miga[i].outerText.replace(/ /g,"")+'1'; 
	             }	             
	             if($('#'+elemento)){
	                 array = $('#'+elemento)[0].parentNode.children;
	                 for (j = 0; j < array.length; j++) {
	                     nodo = array[j];
	                     if(nodo.id == elemento){ 
	                     	$('#'+nodo.children[1].id).set('+md-js-menu_submenu--open');
				if($('#'+nodo.children[1].id)[0].parentNode.children[0].children.length == 1){
			         	icono = $('#'+nodo.children[1].id)[0].parentNode.children[0].children[0];
				 }else if($('#'+nodo.children[1].id)[0].parentNode.children[0].children.length == 2){
			         	icono = $('#'+nodo.children[1].id)[0].parentNode.children[0].children[1];
			         }
			         if(icono){
				 	icono.className = icono.className.replace('md-icon--expand_more', 'md-icon--expand_less');
				 }
	                     }else{
//	                         nodo.className = nodo.className + ' md-collapse';  //No se debe collpasar en web
	                     }
	                 }
	             }
	         }
	     });	     

</script> 

