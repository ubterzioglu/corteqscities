document.addEventListener('DOMContentLoaded', function () {

    function lowerFloatingElements() {

        const wootWidget = document.querySelector('.woot-widget-bubble');
        if (wootWidget) {
            wootWidget.style.setProperty('z-index', '2', 'important');
        }

        const cookieNotice = document.querySelector('#cookie-notice');
        if (cookieNotice) {
            cookieNotice.style.setProperty('z-index', '2', 'important');
        }
    }

    // Run immediately
    lowerFloatingElements();

    // Keep forcing it in case plugins overwrite styles
    setInterval(lowerFloatingElements, 1000);
});
</script>				</div>
