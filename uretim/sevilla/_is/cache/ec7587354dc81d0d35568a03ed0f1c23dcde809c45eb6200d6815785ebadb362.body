		<style id="wp-custom-css">
.emvisesa-licencia { max-width: 900px; margin: 0 auto 30px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif; color: #222; line-height: 1.6; }
.emvisesa-licencia h1 { font-size: 1.6rem; margin-bottom: 0.35rem; color: #0b4a6f; }
.emvisesa-licencia .lead { font-size: 1rem; margin-bottom: 1rem; color: #333; }
.emvisesa-licencia h2 { font-size: 1.05rem; margin-top: 1.1rem; color: #084c6b; }
.emvisesa-licencia ul { margin-left: 1.1rem; }
.emvisesa-licencia .box { border-left: 4px solid #0b7aa1; background: #f6fbfc; padding: 12px 14px; margin: 12px 0; border-radius: 6px; }
.emvisesa-licencia .highlight { display:inline-block; background:#0b7aa1; color:#fff; padding:6px 10px; border-radius:4px; font-weight:600; }
.emvisesa-licencia .dates { display:flex; gap:12px; flex-wrap:wrap; margin:10px 0; }
.emvisesa-licencia .date-card { background:#ffffff; border:1px solid #e6eef1; padding:10px 12px; border-radius:6px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); min-width:210px; }
.emvisesa-licencia .date-card strong { display:block; font-size:0.95rem; color:#0b4a6f; }
.emvisesa-licencia a.button { display:inline-block; text-decoration:none; background:#0b7aa1; color:#fff; padding:8px 14px; border-radius:6px; font-weight:600; margin-top:6px; }
.emvisesa-licencia .meta { font-size:0.925rem; color:#555; margin-bottom:8px; }
.emvisesa-licencia .small { font-size:0.88rem; color:#666; margin-top:8px; }
@media (max-width:600px){ .emvisesa-licencia .dates { flex-direction:column; } .emvisesa-licencia h1{ font-size:1.3rem; } }

</style>
</head>

