    require(['magentoStorefrontEvents'], function (magentoStorefrontEvents) {
        if(!magentoStorefrontEvents) return;
        
        magentoStorefrontEvents.context.setPage({
            pageType: "CMS"
        });
        magentoStorefrontEvents.context.setContext("pageExtended", {
            action: "view"
        });
    });</script><div id="newsletter-popup" class="container-newsletter" style="display: none;"></div><script>
    require([
        'jquery',
        'Magento_Ui/js/modal/modal',
        'jquery/ui',
        'mage/cookies',
        'jquery/jquery-storageapi'
    ], function($, modal) {
        let cookie = $.cookie("newsletter_subscription");
        if (cookie != "1") {
            $.ajax({
                    method: "GET",
                    url: "https://casacuesta.com/newsletterpopup/contents/index/",
                    dataType: "json"
                })
                .done(function(msg) {
                    if (msg.is_active) {
                        $('#newsletter-popup').html(msg.contents);
                        $("#newsletter-popup").show();
                        var popupOptions = {
                            type: "popup",
                            modalClass: "newsletter-popup",
                            autoOpen: true,
                            responsive: false,
                            bodyStateClass: 'modal-open',
                            innerScroll: false,
                            buttons: []
                        };
                        modal(popupOptions, $('#newsletter-popup'));
                        $.cookie("newsletter_subscription", 1, {
                            expires: msg.cookie_expires
                        });
                    }
                });
        }
    });</script> <!-- Meta Pixel Code --><script>
