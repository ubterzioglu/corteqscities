.catalog-product-view.page-layout-1column .column.main .product-info-main .product-add-form .box-tocart .fieldset .actions .action.primary.tocart,
.minicart-wrapper .action.showcart .counter.qty {
	background-color: #010101;
}
.abs-button-primary, .action.primary, [data-content-type=buttons] a.pagebuilder-button-primary, .ias-trigger a{
	background-color: #010101;
	border: 1px solid #010101;
}
.wrapper-header-help .help-link,
.page-header .header-account-link .account-container .link-account span,
.minicart-wrapper .action.showcart .text,
.wrapper-header-help .help-link:before,
.page-header .header-account-link .account-container .link-account:before,
.minicart-wrapper .action.showcart:before,
h1,
h2,
h3,
.breadcrumbs a,
.breadcrumbs .item:not(:last-child):after,
.page-products .toolbar-products .toolbar-amount,
.catalog-product-view.page-layout-1column .column.main .product-info-main .product-social-links .product-addto-links .action,
.page-footer .footer-middle .footer.content .footer-column .block.newsletter button.action.subscribe.primary {
	color: #010101;
}
@media (max-width: 767px) {
.navigation-extra-links-container .link-container a,
.navigation-extra-links-container .link-container a:before,
.header-account-link.navigation-account .account-container .link-account:after,
.page-header .header-account-link .account-container .link-account span,
.page-header .header-account-link .account-container .link-account:before {
	color: #FFF !important;
}
}
