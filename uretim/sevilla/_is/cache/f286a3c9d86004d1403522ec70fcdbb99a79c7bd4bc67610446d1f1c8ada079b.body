<style>


r {
  text-align: center;
  font-size: 24px;
  margin-top: 0px;
  font-family:lato;
  font-weight:900;
  color:#61D7FF;
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@900&display=swap');
  
}

l {
  text-align: center;
  font-size: 21px;
  margin-top: 0px;
  font-weight: bold;
  color:#010101;
  
