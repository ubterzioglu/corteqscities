				return evt;
			}

			var sub = jQuery(sub).find(".sub-menu").get(0);
			
			evt.preventDefault();

			if(jQuery(sub).css("visibility") == "visible"){
    			jQuery(sub).css("visibility","hidden");
    			jQuery(sub).hide();
    		}
		    else{
		    	jQuery(sub).show();
		    	jQuery(sub).css("visibility","visible");
		    }
		} 
    });

