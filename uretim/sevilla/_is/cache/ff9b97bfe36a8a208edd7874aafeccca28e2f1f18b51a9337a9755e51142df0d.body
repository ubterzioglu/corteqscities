	<style type="text/css">.sendit{
		padding:10px 5px 10px 5px;
	}
	.sendit h3, .sendit h4{
		font-size:1.5em;
	}
	.sendit label{
		color:#444;
		margin-right:10px;
		font-weight: bold;
		display:block;
	}
	/*DO NOT CHANGE THIS ID*/
	#sendit_subscribe_button{
    font-family: Arial,Helvetica,sans-serif;
    margin: 0;
    outline: medium none;
    padding: 0;
    vertical-align: middle;
    background: none repeat scroll 0 0 transparent;
    border: 0 none;
    cursor: pointer;
    font-size: 11px;
    font-weight: bold;
    height: 23px;
    position: relative;
    text-transform: uppercase;
    }

	.sendit input, .sendit textarea, .sendit select{

	}
	.short{
		width: 100px;
		margin-bottom: 5px;
	}

	.sendit textarea{
		width: 250px;
		height: 150px;
	}

	.boxes{
		width: 1em;
	}

	#submitbutton{
		margin-top: 5px;
		width: 180px;
	}

	.sendit br{
		clear: left;
	}

	.info, .success, .warning, .sendit_error, .validation {
	    margin: 5px 0px;
	    padding:10px;
	}
	.info, .notice{
	    color: #FFD324;
	}
	.success {
	    color: #4F8A10;
	}
	.warning {
	    color: #9F6000;
	}
	.sendit_error {
	    color: #D8000C;
	}
	.sendit small{
		font-size:80%;
    }
.newsletter-subscription #senditform label {
  color: #2B2B2B;
  float: none;
}

.newsletter-subscription #dati #message,
  .newsletter-subscription #dati > .message {
    margin-left: auto;
    margin-right: auto;
    max-height: 1em;
    max-width: 700px;
    text-align: center;
}

.newsletter-subscription #senditform #sendit_wait {
    height: 32px;
    width: 32px;
    float: right;
    margin-right: 6px;
