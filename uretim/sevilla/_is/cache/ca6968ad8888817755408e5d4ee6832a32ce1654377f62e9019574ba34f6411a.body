		var weburl, rawWeburl;
		if (data.weburl) {
			weburl = "";
			rawWeburl = data.weburl;
		}

		//This method is got from southernNorway git, and it handling change of language on a product detail pages.
		$("html").bind("localeSwitchListingEvent", function(e) {
			var destinationSite = e.site;
			var targetLocale = e.targetLocale;

			var destinationURL = "";
            data.locale_items.forEach((locale) => {
                if (locale.locale_code === targetLocale) {
					destinationURL = locale.genericUrl;
                }
            });
			if (destinationURL) {
				destinationSite = destinationSite.replace("/listing/", destinationURL);
				window.location.href = destinationSite;
			}
		});

		var tripbuilderTracking = "";
		var translations = JSON.parse($("#translations_2b8b5f17-dce7-4d3a-a6bd-d4c2e2c2fa32").html());

		var hoursOfOperation = [];
		if (data.amenityTree) {
			data.amenityTree.forEach(function(amenity) {
				amenity.groups.forEach(function(group) {
					group.fields.forEach(function(field) {
						if (field.tabshortname === 'hoursofoperation') {
							hoursOfOperation.push(field.doc)
						}
					});
				});
			});
		}
		
		var socialMap = {
			"serviceid_4" : { class : "fab fa-facebook-f", service : "facebook" },
			"serviceid_1" : { class : "fab fa-x-twitter", service : "twitter" },
			"serviceid_2" : { class : "fab fa-youtube", service : "youtube" },
			"serviceid_10" : { class : "fab fa-linkedin", service : "linkedin" },
			"serviceid_12" : { class : "fab fa-pinterest", service : "pinterest" },
			"serviceid_13" : { class : "fab fa-instagram", service : "instagram" },
			"serviceid_17" : { class : "fab fa-snapchat", service : "snapchat" }
		};

		// Initialize an empty array to store unique social items
		var social = [];

		// Helper object to avoid duplicates
		var addedServices = {}; 

		var openTable = false;
		// Check if there's data in the social array
		if (data.social) {
			// Iterate through each item in the data.social array
			data.social.forEach(function(val) {
				if (val.smserviceid === 23) data.viatorId = val.value;
				// Get the item from the socialMap corresponding to the current service ID
				var item = socialMap['serviceid_' + val.smserviceid];

				// If the item is not found in the socialMap or already added, skip to the next iteration
				if (item === undefined || addedServices[item.service]) { 
					return; 
				}

				// Generate a valid social URL using the value and service type
				item.url = listingsLib.getValidSocialUrl({ url : val.value, urlType : item.service });
				item.rawUrl = listingsLib.getValidSocialUrl({ url : val.value, urlType : item.service });

				// Push the item to the social array
				social.push(item);

				// Mark the service as added
				addedServices[item.service] = true;
			});

			openTable = data.social.filter(item => item.smserviceid === 6).length
				? data.social.filter(item => item.smserviceid === 6)[0].value
				: false;

			openTable = openTable ? `http://www.opentable.com/single.aspx?rid=${openTable}` : openTable;
		}
		

		var getOpenings = [];
		var openingsFormatted = [];
		var dayFormatted = [];
		var timesFormatted = [];	
		if (data.openings) {

			data.openings.forEach((opening) => {
				//Format start and end dates
				opening.startdate = clientMoment(opening.startdate).format('D MMM YYYY');
				opening.enddate = clientMoment(opening.enddate).format('D MMM YYYY');

				//Check if the end date is in the future
				const givenDate = clientMoment(opening.enddate, 'D MMM YYYY');
				const currentDate = clientMoment();
				if (givenDate.isSameOrAfter(currentDate, 'day')) {
					//Filter out days where open is false
					if (opening.days) {
						const hasProvisionalDay = opening.days.some((day) => day.isprovisional === true);

						if (hasProvisionalDay) {
							opening.isprovisionalopening = true;
						}
						
						// Filter days to include only Monday to Sunday and Bank Holiday
                		// opening.days = opening.days.filter((day) => day.open && (day.day >= 1 && day.day <= 7 || day.day === 8));

						// Translate day names
						var daynameslong = [];
						daynameslong["1"] = translations.calendar.monday;
						daynameslong["2"] = translations.calendar.tuesday;
						daynameslong["3"] = translations.calendar.wednesday;
						daynameslong["4"] = translations.calendar.thursday;
						daynameslong["5"] = translations.calendar.friday;
						daynameslong["6"] = translations.calendar.saturday;
						daynameslong["7"] = translations.calendar.sunday;

						// Assign dayname to days 1-7 (day 8 already has dayname from backend)
						opening.days.forEach((day) => {
							if (day.day >= 1 && day.day <= 7) {
								day.dayname = daynameslong[day.day];
							}
							// Format times
							if (day.times && day.times.length > 0) {
								day.times.forEach((time) => {
									if (time.timeopen) {
										time.timeopen = clientMoment(time.timeopen).add(2, 'minutes').format('HH:mm');
									}
									if (time.timeclose) {
										time.timeclose = clientMoment(time.timeclose).add(2, 'minutes').format('HH:mm');
									}
								});
							}
						});

						// Separate days: regular days (1-6), Sunday (7), and Bank Holiday (8)
						const regularDays = opening.days.filter(day => day.day >= 1 && day.day <= 6);
						const sunday = opening.days.find(day => day.day === 7);
						const bankHoliday = opening.days.find(day => day.day === 8);

						// Sort regular days by day value
						regularDays.sort((a, b) => a.day - b.day);

						// Group consecutive days with the same opening times
						let groupedDays = [];
						let i = 0;
						
						while (i < regularDays.length) {
							let startDay = regularDays[i];
							let endDay = startDay;
							let j = i + 1;
							
							// Check if next days are consecutive and have same times
							while (j < regularDays.length) {
								const currentTimes = JSON.stringify(regularDays[j - 1].times);
								const nextTimes = JSON.stringify(regularDays[j].times);
								
								// Check if consecutive and same times
								if (regularDays[j].day === regularDays[j - 1].day + 1 && currentTimes === nextTimes) {
									endDay = regularDays[j];
									j++;
								} else {
									break;
								}
							}
							
							// Add the group
							const dayname = startDay.day === endDay.day 
								? startDay.dayname 
								: `${startDay.dayname} - ${endDay.dayname}`;
							
							// Convert times array to comma-separated string for display
							let timesFormatted = [];
							if (startDay.times && startDay.times.length > 0) {
								startDay.times.forEach((time) => {
									if (time.timeopen && time.timeclose) {
										timesFormatted.push(`${time.timeopen} - ${time.timeclose}`);
									} else if (time.timeopen) {
										timesFormatted.push(time.timeopen);
									}
								});
							}
							
							groupedDays.push({
								dayname: dayname,
								times: timesFormatted.length > 0 ? [{ timeopen: timesFormatted.join(', '), timeclose: '' }] : [],
								sortOrder: startDay.day,
								open: startDay.open
							});
							
							i = j;
						}

						// Add Sunday at the end if exists
						if (sunday) {
							let sundayTimesFormatted = [];
							if (sunday.times && sunday.times.length > 0) {
								sunday.times.forEach((time) => {
									if (time.timeopen && time.timeclose) {
										sundayTimesFormatted.push(`${time.timeopen} - ${time.timeclose}`);
									} else if (time.timeopen) {
										sundayTimesFormatted.push(time.timeopen);
									}
								});
							}
							
							// If there are formatted times, use them; otherwise check if open or leave empty for "Cerrado"
							let sundayTimes;
							if (sundayTimesFormatted.length > 0) {
								sundayTimes = [{ timeopen: sundayTimesFormatted.join(', '), timeclose: '' }];
							} else if (sunday.open) {
								// If open is true but no times, keep times empty (will be handled by template)
								sundayTimes = [];
							} else {
								// If open is false or undefined, times will be empty and template shows "Cerrado"
								sundayTimes = [];
							}
							
							groupedDays.push({
								dayname: sunday.dayname,
								times: sundayTimes,
								sortOrder: 7,
								open: sunday.open
							});
						}

						// Add Bank Holiday at the very end if exists
						if (bankHoliday) {
							let bankHolidayTimesFormatted = [];
							if (bankHoliday.times && bankHoliday.times.length > 0) {
								bankHoliday.times.forEach((time) => {
									if (time.timeopen && time.timeclose) {
										bankHolidayTimesFormatted.push(`${time.timeopen} - ${time.timeclose}`);
									} else if (time.timeopen) {
										bankHolidayTimesFormatted.push(time.timeopen);
									}
								});
							}
							
							// If there are formatted times, use them; otherwise check if open or leave empty for "Cerrado"
							let bankHolidayTimes;
							if (bankHolidayTimesFormatted.length > 0) {
								bankHolidayTimes = [{ timeopen: bankHolidayTimesFormatted.join(', '), timeclose: '' }];
							} else if (bankHoliday.open) {
								// If open is true but no times, keep times empty (will be handled by template)
								bankHolidayTimes = [];
							} else {
								// If open is false or undefined, times will be empty and template shows "Cerrado"
								bankHolidayTimes = [];
							}
							
							groupedDays.push({
								dayname: bankHoliday.dayname,
								times: bankHolidayTimes,
								sortOrder: 8,
								open: bankHoliday.open
							});
						}

						// Update the opening days with the grouped days
						opening.days = groupedDays;
					}
				} else {
					//If the end date is in the past, clear the opening data
					delete opening.days;
					delete opening.opentype;
					delete opening.openingname;
					delete opening.startdate;
					delete opening.enddate;
  				}
			});
			
			// Keep openings when there is a valid date range, even if the API does not provide per-day hours.
			data.openings = data.openings.filter(opening => {
				const hasDateRange = !!(opening.startdate && opening.enddate);
				const hasOpeningDays = !!(opening.days && opening.days.length > 0);
				return hasDateRange || hasOpeningDays;
			});
		}

		var placemarks = [];
		if (data.latitude) {
			placemarks.push({
				recid : data.recid,
				title : data.title,
				latitude : data.latitude,
				longitude : data.longitude,
				address1 : streetAddress,
				detail : true
			});

		}
		
		var externalLinksFiltered = [];
		if (data.externallinks) {
			var checkType = data.externallinks.filter(link => link.linktypeid !== "VLINCOLNPARTNER" && link.linktypeid !== "LINCOLNSHIREGIRTCRD");
			if (checkType) { 
				externalLinksFiltered.push(checkType);
			}
		}

		var originsFiltered;
		if (data.origins) {
			var checkType = data.origins.filter(id => id.amenitygroupid == 285161);
			if (checkType) { 
				originsFiltered = checkType;
			}
			//console.log(originsFiltered)
		}

		// get blog post relations query
		if(1 === 1) {
			var query_related_posts = {
				filter : {
					custom_related_listings : data.recid.toString(),
					enabled : true
				},
				options : {
					limit : 10,
					fields : {
						id : 1,
						custom: 1,
						recid : 1,
						title : 1,
						image : 1,
						image_id : 1,
						description_raw : 1,
						author : 1,
						slug : 1,
						url : 1,
						categories : 1,
						custom_related_listings : 1
					},
					hooks : ["afterFind_image"],
					sort: {
						publish_start : -1
					}
				}
			} 
		}

		// Build blog endpoints dynamically from site.plugins.blog.apis when available
		function getBlogEndpoints() {
			var endpoints = [];
			try {
				if (site && site.plugins && site.plugins.blog && site.plugins.blog.apis) {
					Object.keys(site.plugins.blog.apis).forEach(function(blogName) {
						// if the key already is an endpoint-like name, use it; otherwise build the plugins_blog_* name
						var endpointKey = blogName;
						if (!endpointKey.startsWith('plugins_blog_')) {
							endpointKey = 'plugins_blog_' + blogName + '_posts';
						}
						endpoints.push('/includes/rest_v2/' + endpointKey + '/find/');
					});
				}
			} catch(e) {
				// ignore and fallback
			}

			// Fallback - ensure common expected endpoints are present
			['plugins_blog_leisure_blog_posts', 'plugins_blog_leisure_blog_en_posts', 'plugins_blog_leisure_blog_fr_posts', 'plugins_blog_leisure_blog_de_posts', 'plugins_blog_articles_posts', 'plugins_blog_articles_en_posts', 'plugins_blog_articles_fr_posts', 'plugins_blog_articles_de_posts']
				.forEach(function(p) { endpoints.push('/includes/rest_v2/' + p + '/find/'); });

			// Deduplicate
			endpoints = endpoints.filter(function(v, i) { return endpoints.indexOf(v) === i; });
			return endpoints;
		}

		var masterFlow = new asyncLib.Flow();
		masterFlow.series({
			data_blog: function(cb) {
				// Dynamically detect blog endpoints and query them
				var endpoints = getBlogEndpoints();

				var pending = endpoints.length;
				if (pending === 0) { return cb(null); }

				function doneOne() {
					pending--;
					if (pending <= 0) { return cb(null); }
				}

				endpoints.forEach(function(url) {
					$.get(url, { json : JSON.stringify(query_related_posts), token : core.simpleToken })
						.done(function(res) {
							if (res && res.docs && res.docs.length > 0) {
								data.posts = data.posts.concat(res.docs);
							}
						}).fail(function() {
							// ignore failures (endpoint may not exist)
						}).always(doneOne);
				});
			},
			data_articles: function(cb) {
				// No-op: posts already fetched by dynamic `data_blog` step
				return cb(null);
			},
			data_format: function(cb) {
				// format the blog post data
				if(data.posts) {
					data.posts.forEach(function(v,i) {
						let strippedDesc = v.description_raw.replace(/(&#xA0|&nbsp);/, '').replace(/(<([^>]+)>)/ig,'').replace(/(invalid widget)/g,'').replace(/(\[(.*)\])/g,'');
						let words = (strippedDesc.match(/[\w]+/g) || []).length+1;
						v.minutes = Math.max(1, Math.round(words / 200));
						v.category = v.categories ? v.categories[0] : undefined;
					});
				}
				return cb(null);
			},
		
	
		init: function(cb) {
		var vue = detail.getVue({
			data : { 
				type : 'Listings',
				title : data.title,
				crmc : data.primaryCategory.catname,
				crmsc : data.primaryCategory.subcatname,
				rawWeburl : rawWeburl,
				acctid : data.acctid,
				city : data.city,
				region : data.region,
				price : data.price,
				ga4Price : data.custom?.price,
				rankname : data.rankname ? data.rankname : data.isDTN ? 'Featured' : undefined,
				additional_opening_text : data.additional_opening_text,
				general_pricing_text : data.general_pricing_text,
				open_new_year : data.open_new_year,
				open_christmas : data.open_christmas,
				primaryCatId : data.primaryCategory.catid,
				udfs : data.udfs,
				locations : locations,
				phone : data.phone,
				altphone : data.altphone,
				tollfree : data.tollfree,
				media : data.media,
				email : data.email,
				// weburl : weburl,
				weburl: data.weburl,
				weburlCheck : data.weburlCheck,
				social : social,
				hasTripAdvisor : data.hasTripAdvisor,
				tripbuilder : tripbuilder,
				tripbuilderTracking : tripbuilderTracking,
				yelp : data.yelp,
				hasYelp : data.hasYelp,
				openTable : openTable,
				yelpHours : data.yelp ? data.yelp.hours : undefined,
				hoursOfOperation: hoursOfOperation,
				threshold360id : data.threshold360id,
				recid : data.recid,
				isDTN : data.isDTN,
				description : data.description,
				offers : data.offers,
				events : data.events,
				placemarks : placemarks,
				amenities : data.amenityTree,
				meetingfacility : data.meetingfacility,
				meetingrooms : data.meetingrooms,
				translations : translations,
				latitude: data.latitude,
				longitude: data.longitude,
				gtmVars : '{ "tClient_ga4" : {"interactionSource" : "detail"} }',
				hasFacebookFeed : hasFacebookFeed,
				listingudfs : data.listingudfs,
				awards : data.awards,
				gradings: data.gradings,
				units: data.units,
				unitPriceBasis: data.unitPriceBasis,
				unitTypes: data.unitTypes,
				openings: data.openings,
				externallinks: data.externallinks,
				rankid: data.rankid,
				relatedlistingids: data.relatedlistingids,
				relatedeventids: data.relatedeventids,
				primaryCat: data.primaryCat,
				polling_engine_id: data.polling_engine_id,
				coupons: data.coupons,
				routes: data.routes,
				routeTypes: data.routeTypes,
				downloads: data.downloads,
				channels: data.channels,
				externalLinksFiltered : externalLinksFiltered,
				registerno: data.registerno,
				locale: data.locale,
				posts : data.posts,
				originsFiltered: originsFiltered,
			},
			templates : {
				amenities_widget: amenities_widget,
				listing_ta_snippet : listing_ta_snippet,
				listing_detail_meeting_facilities : listing_detail_meeting_facilities,
				listing_detail_meeting_room : listing_detail_meeting_room,
				listing_detail_twitter_snippet : listing_detail_twitter_snippet,
				listing_detail_facebook_snippet : listing_detail_facebook_snippet,
				yelp_component : yelp_component,
				event_item_template : event_item_template,
				offer_item_template : offer_item_template,
				custom_li_items : custom_li_items,
				post_item_template : post_item_template
			},
			rootNode : $('[data-guid="2b8b5f17-dce7-4d3a-a6bd-d4c2e2c2fa32"]'),
			guid: `2b8b5f17-dce7-4d3a-a6bd-d4c2e2c2fa32`
		}); 		

		if (data?.crmtracking) {
			sv_crmLib.trackAjax(data.crmtracking.core_listing_view);
		}

			/* register available UI events for SEM tracking */
			var watcher = new UIWatcher(vue, $, document);
			var uid = clientLib.uuid().toString();
			var widgetEvents = ["item-click"];
			for (var i=0; i<widgetEvents.length; i++) {
				watcher.add("vue", widgetEvents[i], uid, { name: "Listings" });
			}

			}
		}, function(err, msg) {
			if (err) { return new Error(msg); }
		});

	});
</script>
