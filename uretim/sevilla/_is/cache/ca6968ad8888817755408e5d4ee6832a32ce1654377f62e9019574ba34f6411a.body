e":"Alemán","locale":"de","value":"Té de la tarde"},{"displayname":"Francés","locale":"fr","value":"Té de la tarde"}]},{"unittypekey":152151,"unittypeid":"ticket","unittypename":"General","altlabels":[{"displayname":"Inglés","locale":"en","value":"Ticket"},{"displayname":"Alemán","locale":"de","value":"General"},{"displayname":"Francés","locale":"fr","value":"General"}]},{"unittypekey":156081,"unittypeid":"rdytn","unittypename":"Tienda de campaña montada","altlabels":[{"displayname":"Inglés","locale":"en","value":"Ready erected tent"},{"displayname":"Alemán","locale":"de","value":"Tienda de campaña montada"},{"displayname":"Francés","locale":"fr","value":"Tienda de campaña montada"}]},{"unittypekey":163251,"unittypeid":"confunit","unittypename":"Unidad de Conferencias","altlabels":[{"displayname":"Inglés","locale":"en","value":"Conference Unit"},{"displayname":"Alemán","locale":"de","value":"Unidad de Conferencias"},{"displayname":"Francés","locale":"fr","value":"Unidad de Conferencias"}]},{"unittypekey":286971,"unittypeid":"casacomplete","unittypename":"Casa completa","altlabels":[{"displayname":"Inglés","locale":"en","value":"Casa completa"},{"displayname":"Alemán","locale":"de","value":"Casa completa"},{"displayname":"Francés","locale":"fr","value":"Casa completa"}]},{"unittypekey":286981,"unittypeid":"grupo","unittypename":"Grupo","altlabels":[{"displayname":"Inglés","locale":"en","value":"Grupo"},{"displayname":"Alemán","locale":"de","value":"Grupo"},{"displayname":"Francés","locale":"fr","value":"Grupo"}]}],"rankid":1,"relatedlistingids":[19141102,20001102,20002102,20012102,20066102],"primaryCat":{"catid":149181,"catname":"Rutas Turísticas","primary":true,"subcatid":7669,"subcatname":"Rutas Turísticas"},"routes":[{"points":[{"pointkey":43491,"pointlat":37.38864,"pointlong":-5.99464,"pointname":"Sevilla","imagefilename":"507994DE32F109B8A05BB07D4B2F0BCFE761749D.jpg","imageurl":"https://spaindmsmedia.newmindmedia.com/wsimgs/507994DE32F109B8A05BB07D4B2F0BCFE761749D.jpg"},{"pointkey":43471,"pointlat":37.38701,"pointlong":-6.05227,"pointname":"Castilleja de la Cuesta","imagefilename":"4FD14F3DF441CB6E6E79979E837DA984FEC6D6CC.jpg","imageurl":"https://spaindmsmedia.newmindmedia.com/wsimgs/4FD14F3DF441CB6E6E79979E837DA984FEC6D6CC.jpg"},{"pointkey":43461,"pointlat":37.40919,"pointlong":-6.05803,"pointname":"Castilleja de Guzmán","imagefilename":"EEEACF4B6A217E63AD5F6E702846500F884120F2.jpg","imageurl":"https://spaindmsmedia.newmindmedia.com/wsimgs/EEEACF4B6A217E63AD5F6E702846500F884120F2.jpg"},{"pointkey":43481,"pointlat":37.28318,"pointlong":-5.92224,"pointname":"Dos Hermanas","imagefilename":"41DC87EF39459C5B25F235E0781A0067D3AA017C.jpg","imageurl":"https://spaindmsmedia.newmindmedia.com/wsimgs/41DC87EF39459C5B25F235E0781A0067D3AA017C.jpg"}],"detaillevelkey":1,"typekey":158091,"gradekey":148481,"routename":"Itinerario 1 Jardines de Sevilla","routekey":10711}],"routeTypes":[{"routetypekey":148491,"routetypeid":"wfcycle","routetypename":"En bicicleta","altlabels":[{"displayname":"Inglés","locale":"en","value":"Cycle"},{"displayname":"Alemán","locale":"de","value":"En bicicleta"},{"displayname":"Francés","locale":"fr","value":"En bicicleta"}]},{"routetypekey":148501,"routetypeid":"wfdrive","routetypename":"En coche","altlabels":[{"displayname":"Inglés","locale":"en","value":"Drive"},{"displayname":"Alemán","locale":"de","value":"En coche"},{"displayname":"Francés","locale":"fr","value":"En coche"}]},{"routetypekey":148511,"routetypeid":"wfwalk","routetypename":"De senderismo","altlabels":[{"displayname":"Inglés","locale":"en","value":"Walk"},{"displayname":"Alemán","locale":"de","value":"De senderismo"},{"displayname":"Francés","locale":"fr","value":"De senderismo"}]},{"routetypekey":158091,"routetypeid":"wfroute","routetypename":"Ruta temática","altlabels":[{"displayname":"Inglés","locale":"en","value":"Route"},{"displayname":"Alemán","locale":"de","value":"Ruta temática"},{"displayname":"Francés","locale":"fr","value":"Ruta temática"}]},{"routetypekey":158101,"routetypeid":"wfhorse","routetypename":"Ecuestre","altlabels":[{"displayname":"Inglés","locale":"en","value":"Horse Riding"},{"displayname":"Alemán","locale":"de","value":"Ecuestre"},{"displayname":"Francés","locale":"fr","value":"Ecuestre"}]},{"routetypekey":163481,"routetypeid":"wfboating","routetypename":"En barco","altlabels":[{"displayname":"Inglés","locale":"en","value":"Boat"},{"displayname":"Alemán","locale":"de","value":"En barco"},{"displayname":"Francés","locale":"fr","value":"En barco"}]},{"routetypekey":163491,"routetypeid":"wfrail","routetypename":"En tren","altlabels":[{"displayname":"Inglés","locale":"en","value":"Rail"},{"displayname":"Alemán","locale":"de","value":"En tren"},{"displayname":"Francés","locale":"fr","value":"En tren"}]}],"channels":[{"channelkey":147411,"iskeyproduct":false,"donotindex":false},{"channelkey":284841,"iskeyproduct":false,"donotindex":false},{"channelkey":286321,"iskeyproduct":false,"donotindex":false}],"acctid":21440102,"city":"Sevilla","region":"Sevilla","rankname":"Nivel 1 (Bajo)","custom":{"rankid":1,"rankname":"Nivel 1 (Bajo)","rankorder":1,"open_new_year":"false","open_christmas":"false","relatedlistingids":[19141102,20001102,20002102,20012102,20066102],"subcatgroups":[286201],"awardScore":0,"routes":[{"points":[{"pointkey":43491,"pointlat":37.38864,"pointlong":-5.99464,"pointname":"Sevilla","imagefilename":"507994DE32F109B8A05BB07D4B2F0BCFE761749D.jpg","imageurl":"https://spaindmsmedia.newmindmedia.com/wsimgs/507994DE32F109B8A05BB07D4B2F0BCFE761749D.jpg"},{"pointkey":43471,"pointlat":37.38701,"pointlong":-6.05227,"pointname":"Castilleja de la Cuesta","imagefilename":"4FD14F3DF441CB6E6E79979E837DA984FEC6D6CC.jpg","imageurl":"https://spaindmsmedia.newmindmedia.com/wsimgs/4FD14F3DF441CB6E6E79979E837DA984FEC6D6CC.jpg"},{"pointkey":43461,"pointlat":37.40919,"pointlong":-6.05803,"pointname":"Castilleja de Guzmán","imagefilename":"EEEACF4B6A217E63AD5F6E702846500F884120F2.jpg","imageurl":"https://spaindmsmedia.newmindmedia.com/wsimgs/EEEACF4B6A217E63AD5F6E702846500F884120F2.jpg"},{"pointkey":43481,"pointlat":37.28318,"pointlong":-5.92224,"pointname":"Dos Hermanas","imagefilename":"41DC87EF39459C5B25F235E0781A0067D3AA017C.jpg","imageurl":"https://spaindmsmedia.newmindmedia.com/wsimgs/41DC87EF39459C5B25F235E0781A0067D3AA017C.jpg"}],"detaillevelkey":1,"typekey":158091,"gradekey":148481,"routename":"Itinerario 1 Jardines de Sevilla","routekey":10711}],"channels":[{"channelkey":147411,"iskeyproduct":false,"donotindex":false},{"channelkey":284841,"iskeyproduct":false,"donotindex":false},{"channelkey":286321,"iskeyproduct":false,"donotindex":false}]},"open_christmas":"false","open_new_year":"false","listingudfs_object":{"0":{"fieldid":0,"typeid":8,"name":"Main Long Description Rich Text","digits":0,"value":"<p>En Sevilla, el jard&#237;n m&#225;s antiguo que se conserva como tal es el Patio de los Naranjos, que perteneci&#243; a la antigua mezquita almohade sobre la que se asienta la actual catedral. De la misma &#233;poca (siglo XII) data el Jard&#237;n Almohade de la Casa de Contrataci&#243;n, en pleno centro de la ciudad, recientemente restaurado, con el anacronismo de incluir palmeras americanas.El conjunto de los jardines del Alc&#225;zar re&#250;ne la mayor variedad de estilos posible en un espacio reducido. All&#237; se encuentran jardines de tradici&#243;n mud&#233;jar como el Patio de Do&#241;a Mar&#237;a de Padilla, el Patio del Yeso o el Jard&#237;n de la Galera; renacentistas, especialmente el Jard&#237;n de la Danza, el de las Damas y alrededores del pabell&#243;n de Carlos V que incluye el laberinto de mirtos y cipreses; de estilo paisajista, el Jard&#237;n Ingl&#233;s; y de principios de siglo como el Jard&#237;n de los Poetas y el de Vega Incl&#225;n. Entre los muchos ejemplares notables de este conjunto destacan varios palos borracho rosados (Chorisia speciosa), con un gran ejemplar al lado del pabell&#243;n de Carlos V, y los Gingko biloba o la Tabebuia del Jard&#237;n Ingl&#233;s.Otro ejemplo de jard&#237;n cerrado, es el jard&#237;n de la Torre de Don Fadrique construido sobre antiguos huertos.Los jardines del per&#237;odo rom&#225;ntico est&#225;n representados por el Jard&#237;n de las Delicias, con un curioso ejemplar de la palmera Phoenix reclinata con numerosos brazos, y abundantes naranjos morunos (Citrus myrtifolia); as&#237; como por los Jardines de Cristina y los de la Casa Rosa, con un interesante paseo de Cycas revoluta.A principios del siglo XX hay una renovaci&#243;n del estilo y aparece un jard&#237;n de inspiraci&#243;n hispano-&#225;rabe del que son ejemplo el Parque de Mar&#237;a Luisa, dise&#241;ado en su mayor parte por Jean Nicolas Forestier con grandes ejemplares arb&#243;reos, los Jardines de Murillo y el Paseo de Catalina de Ribera.Tambi&#233;n datan de nuestro siglo los Jardines de la Lonja y los de la antigua F&#225;brica de Tabacos, as&#237; como el Paseo de la Palmera y los numerosos jardines privados de su entorno, algunos de ellos con especies muy interesantes.Entre los diversos jardines actuales se pueden citar el Parque de los Pr&#237;ncipes y el conjunto de la Isla de La Cartuja, que incluye el antiguo huerto del monasterio y su entorno, con un antiguo zapote, y los modernos jardines implantados con motivo de la Expo 92, sobre todo los del Guadalquivir, en los que se representa un resumen de la historia de la jardiner&#237;a, y el Americano, construido s&#243;lo a base de especies procedentes de Am&#233;rica.Un elemento importante del paisaje urbano de Sevilla lo constituyen las plazas y los patios. Entre las primeras destacan la plaza del Cristo de Burgos y la del Museo, con grandes ejemplares de Ficus dealbata, la plaza del Duque con una enorme Grevillea robusta (&#225;rbol del fuego), la plaza de San Leandro con su hermoso ejemplar de Ficus retusa (laurel de Indias) y la de Santa Cruz con un magn&#237;fico ejemplar de Feijoa sellowiana. Los mejores patios se encuentran en el barrio de Santa Cruz; uno de los que se puede visitar es el de los Venerables, interesante patio con fuente central. Tambi&#233;n son muy recomendables los jardines de los palacios, como el de la Casa de Pilatos o el de las Due&#241;as.En el Aljarafe sevillano hay que citar el jard&#237;n del Colegio Mayor Santa Mar&#237;a del Buen Aire dise&#241;ado por Forestier, en Castilleja de Guzm&#225;n y el Arboretum del Carambolo en Castilleja de la Cuesta.Dos Hermanas cuenta con la Alquer&#237;a del Pilar y la Hacienda de la Torre de Do&#241;a Mar&#237;a. Dentro de los numerosos cortijos y haciendas de olivar se puede visitar la Hacienda Benazuza de Sanl&#250;car la Mayor, transformada recientemente en hotel.En la provincia de Huelva destaca en Fuenteheridos el jard&#237;n de Villa Onuba con interesantes ejemplares de pinsapo y sequoia; y Riotinto resulta interesante por el barrio de los ingleses con casas ajardinadas de tipo ingl&#233;s.En La R&#225;bida destacan asimismo los complejos paisaj&#237;sticos y el jard&#237;n claustral del convento, El Parque de Celestino Mutis. En la cercana Moguer sobresalen los patios y jardines del antiguo convento de las clarisas as&#237; como los patios de la casa del escritor Juan Ram&#243;n Jim&#233;nez.</p>","type":"Text","value_raw":"<p>En Sevilla, el jard&#237;n m&#225;s antiguo que se conserva como tal es el Patio de los Naranjos, que perteneci&#243; a la antigua mezquita almohade sobre la que se asienta la actual catedral. De la misma &#233;poca (siglo XII) data el Jard&#237;n Almohade de la Casa de Contrataci&#243;n, en pleno centro de la ciudad, recientemente restaurado, con el anacronismo de incluir palmeras americanas.El conjunto de los jardines del Alc&#225;zar re&#250;ne la mayor variedad de estilos posible en un espacio reducido. All&#237; se encuentran jardines de tradici&#243;n mud&#233;jar como el Patio de Do&#241;a Mar&#237;a de Padilla, el Patio del Yeso o el Jard&#237;n de la Galera; renacentistas, especialmente el Jard&#237;n de la Danza, el de las Damas y alrededores del pabell&#243;n de Carlos V que incluye el laberinto de mirtos y cipreses; de estilo paisajista, el Jard&#237;n Ingl&#233;s; y de principios de siglo como el Jard&#237;n de los Poetas y el de Vega Incl&#225;n. Entre los muchos ejemplares notables de este conjunto destacan varios palos borracho rosados (Chorisia speciosa), con un gran ejemplar al lado del pabell&#243;n de Carlos V, y los Gingko biloba o la Tabebuia del Jard&#237;n Ingl&#233;s.Otro ejemplo de jard&#237;n cerrado, es el jard&#237;n de la Torre de Don Fadrique construido sobre antiguos huertos.Los jardines del per&#237;odo rom&#225;ntico est&#225;n representados por el Jard&#237;n de las Delicias, con un curioso ejemplar de la palmera Phoenix reclinata con numerosos brazos, y abundantes naranjos morunos (Citrus myrtifolia); as&#237; como por los Jardines de Cristina y los de la Casa Rosa, con un interesante paseo de Cycas revoluta.A principios del siglo XX hay una renovaci&#243;n del estilo y aparece un jard&#237;n de inspiraci&#243;n hispano-&#225;rabe del que son ejemplo el Parque de Mar&#237;a Luisa, dise&#241;ado en su mayor parte por Jean Nicolas Forestier con grandes ejemplares arb&#243;reos, los Jardines de Murillo y el Paseo de Catalina de Ribera.Tambi&#233;n datan de nuestro siglo los Jardines de la Lonja y los de la antigua F&#225;brica de Tabacos, as&#237; como el Paseo de la Palmera y los numerosos jardines privados de su entorno, algunos de ellos con especies muy interesantes.Entre los diversos jardines actuales se pueden citar el Parque de los Pr&#237;ncipes y el conjunto de la Isla de La Cartuja, que incluye el antiguo huerto del monasterio y su entorno, con un antiguo zapote, y los modernos jardines implantados con motivo de la Expo 92, sobre todo los del Guadalquivir, en los que se representa un resumen de la historia de la jardiner&#237;a, y el Americano, construido s&#243;lo a base de especies procedentes de Am&#233;rica.Un elemento importante del paisaje urbano de Sevilla lo constituyen las plazas y los patios. Entre las primeras destacan la plaza del Cristo de Burgos y la del Museo, con grandes ejemplares de Ficus dealbata, la plaza del Duque con una enorme Grevillea robusta (&#225;rbol del fuego), la plaza de San Leandro con su hermoso ejemplar de Ficus retusa (laurel de Indias) y la de Santa Cruz con un magn&#237;fico ejemplar de Feijoa sellowiana. Los mejores patios se encuentran en el barrio de Santa Cruz; uno de los que se puede visitar es el de los Venerables, interesante patio con fuente central. Tambi&#233;n son muy recomendables los jardines de los palacios, como el de la Casa de Pilatos o el de las Due&#241;as.En el Aljarafe sevillano hay que citar el jard&#237;n del Colegio Mayor Santa Mar&#237;a del Buen Aire dise&#241;ado por Forestier, en Castilleja de Guzm&#225;n y el Arboretum del Carambolo en Castilleja de la Cuesta.Dos Hermanas cuenta con la Alquer&#237;a del Pilar y la Hacienda de la Torre de Do&#241;a Mar&#237;a. Dentro de los numerosos cortijos y haciendas de olivar se puede visitar la Hacienda Benazuza de Sanl&#250;car la Mayor, transformada recientemente en hotel.En la provincia de Huelva destaca en Fuenteheridos el jard&#237;n de Villa Onuba con interesantes ejemplares de pinsapo y sequoia; y Riotinto resulta interesante por el barrio de los ingleses con casas ajardinadas de tipo ingl&#233;s.En La R&#225;bida destacan asimismo los complejos paisaj&#237;sticos y el jard&#237;n claustral del convento, El Parque de Celestino Mutis. En la cercana Moguer sobresalen los patios y jardines del antiguo convento de las clarisas as&#237; como los patios de la casa del escritor Juan Ram&#243;n Jim&#233;nez.</p>","value_string":"<p>En Sevilla, el jard&#237;n m&#225;s antiguo que se conserva como tal es el Patio de los Naranjos, que perteneci&#243; a la antigua mezquita almohade sobre la que se asienta la actual catedral. De la misma &#233;poca (siglo XII) data el Jard&#237;n Almohade de la Casa de Contrataci&#243;n, en pleno centro de la ciudad, recientemente restaurado, con el anacronismo de incluir palmeras americanas.El conjunto de los jardines del Alc&#225;zar re&#250;ne la mayor variedad de estilos posible en un espacio reducido. All&#237; se encuentran jardines de tradici&#243;n mud&#233;jar como el Patio de Do&#241;a Mar&#237;a de Padilla, el Patio del Yeso o el Jard&#237;n de la Galera; renacentistas, especialmente el Jard&#237;n de la Danza, el de las Damas y alrededores del pabell&#243;n de Carlos V que incluye el laberinto de mirtos y cipreses; de estilo paisajista, el Jard&#237;n Ingl&#233;s; y de principios de siglo como el Jard&#237;n de los Poetas y el de Vega Incl&#225;n. Entre los muchos ejemplares notables de este conjunto destacan varios palos borracho rosados (Chorisia speciosa), con un gran ejemplar al lado del pabell&#243;n de Carlos V, y los Gingko biloba o la Tabebuia del Jard&#237;n Ingl&#233;s.Otro ejemplo de jard&#237;n cerrado, es el jard&#237;n de la Torre de Don Fadrique construido sobre antiguos huertos.Los jardines del per&#237;odo rom&#225;ntico est&#225;n representados por el Jard&#237;n de las Delicias, con un curioso ejemplar de la palmera Phoenix reclinata con numerosos brazos, y abundantes naranjos morunos (Citrus myrtifolia); as&#237; como por los Jardines de Cristina y los de la Casa Rosa, con un interesante paseo de Cycas revoluta.A principios del siglo XX hay una renovaci&#243;n del estilo y aparece un jard&#237;n de inspiraci&#243;n hispano-&#225;rabe del que son ejemplo el Parque de Mar&#237;a Luisa, dise&#241;ado en su mayor parte por Jean Nicolas Forestier con grandes ejemplares arb&#243;reos, los Jardines de Murillo y el Paseo de Catalina de Ribera.Tambi&#233;n datan de nuestro siglo los Jardines de la Lonja y los de la antigua F&#225;brica de Tabacos, as&#237; como el Paseo de la Palmera y los numerosos jardines privados de su entorno, algunos de ellos con especies muy interesantes.Entre los diversos jardines actuales se pueden citar el Parque de los Pr&#237;ncipes y el conjunto de la Isla de La Cartuja, que incluye el antiguo huerto del monasterio y su entorno, con un antiguo zapote, y los modernos jardines implantados con motivo de la Expo 92, sobre todo los del Guadalquivir, en los que se representa un resumen de la historia de la jardiner&#237;a, y el Americano, construido s&#243;lo a base de especies procedentes de Am&#233;rica.Un elemento importante del paisaje urbano de Sevilla lo constituyen las plazas y los patios. Entre las primeras destacan la plaza del Cristo de Burgos y la del Museo, con grandes ejemplares de Ficus dealbata, la plaza del Duque con una enorme Grevillea robusta (&#225;rbol del fuego), la plaza de San Leandro con su hermoso ejemplar de Ficus retusa (laurel de Indias) y la de Santa Cruz con un magn&#237;fico ejemplar de Feijoa sellowiana. Los mejores patios se encuentran en el barrio de Santa Cruz; uno de los que se puede visitar es el de los Venerables, interesante patio con fuente central. Tambi&#233;n son muy recomendables los jardines de los palacios, como el de la Casa de Pilatos o el de las Due&#241;as.En el Aljarafe sevillano hay que citar el jard&#237;n del Colegio Mayor Santa Mar&#237;a del Buen Aire dise&#241;ado por Forestier, en Castilleja de Guzm&#225;n y el Arboretum del Carambolo en Castilleja de la Cuesta.Dos Hermanas cuenta con la Alquer&#237;a del Pilar y la Hacienda de la Torre de Do&#241;a Mar&#237;a. Dentro de los numerosos cortijos y haciendas de olivar se puede visitar la Hacienda Benazuza de Sanl&#250;car la Mayor, transformada recientemente en hotel.En la provincia de Huelva destaca en Fuenteheridos el jard&#237;n de Villa Onuba con interesantes ejemplares de pinsapo y sequoia; y Riotinto resulta interesante por el barrio de los ingleses con casas ajardinadas de tipo ingl&#233;s.En La R&#225;bida destacan asimismo los complejos paisaj&#237;sticos y el jard&#237;n claustral del convento, El Parque de Celestino Mutis. En la cercana Moguer sobresalen los patios y jardines del antiguo convento de las clarisas as&#237; como los patios de la casa del escritor Juan Ram&#243;n Jim&#233;nez.</p>"},"1":{"fieldid":1,"typeid":8,"name":"Main Long Description Plain Text","digits":0,"value":"En Sevilla, el jardín más antiguo que se conserva como tal es el Patio de los Naranjos, que perteneció a la antigua mezquita almohade sobre la que se asienta la actual catedral. De la misma época (siglo XII) data el Jardín Almohade de la Casa de Contratación, en pleno centro de la ciudad, recientemente restaurado, con el anacronismo de incluir palmeras americanas.El conjunto de los jardines del Alcázar reúne la mayor variedad de estilos posible en un espacio reducido. Allí se encuentran jardines de tradición mudéjar como el Patio de Doña María de Padilla, el Patio del Yeso o el Jardín de la Galera; renacentistas, especialmente el Jardín de la Danza, el de las Damas y alrededores del pabellón de Carlos V que incluye el laberinto de mirtos y cipreses; de estilo paisajista, el Jardín Inglés; y de principios de siglo como el Jardín de los Poetas y el de Vega Inclán. Entre los muchos ejemplares notables de este conjunto destacan varios palos borracho rosados (Chorisia speciosa), con un gran ejemplar al lado del pabellón de Carlos V, y los Gingko biloba o la Tabebuia del Jardín Inglés.Otro ejemplo de jardín cerrado, es el jardín de la Torre de Don Fadrique construido sobre antiguos huertos.Los jardines del período romántico están representados por el Jardín de las Delicias, con un curioso ejemplar de la palmera Phoenix reclinata con numerosos brazos, y abundantes naranjos morunos (Citrus myrtifolia); así como por los Jardines de Cristina y los de la Casa Rosa, con un interesante paseo de Cycas revoluta.A principios del siglo XX hay una renovación del estilo y aparece un jardín de inspiración hispano-árabe del que son ejemplo el Parque de María Luisa, diseñado en su mayor parte por Jean Nicolas Forestier con grandes ejemplares arbóreos, los Jardines de Murillo y el Paseo de Catalina de Ribera.También datan de nuestro siglo los Jardines de la Lonja y los de la antigua Fábrica de Tabacos, así como el Paseo de la Palmera y los numerosos jardines privados de su entorno, algunos de ellos con especies muy interesantes.Entre los diversos jardines actuales se pueden citar el Parque de los Príncipes y el conjunto de la Isla de La Cartuja, que incluye el antiguo huerto del monasterio y su entorno, con un antiguo zapote, y los modernos jardines implantados con motivo de la Expo 92, sobre todo los del Guadalquivir, en los que se representa un resumen de la historia de la jardinería, y el Americano, construido sólo a base de especies procedentes de América.Un elemento importante del paisaje urbano de Sevilla lo constituyen las plazas y los patios. Entre las primeras destacan la plaza del Cristo de Burgos y la del Museo, con grandes ejemplares de Ficus dealbata, la plaza del Duque con una enorme Grevillea robusta (árbol del fuego), la plaza de San Leandro con su hermoso ejemplar de Ficus retusa (laurel de Indias) y la de Santa Cruz con un magnífico ejemplar de Feijoa sellowiana. Los mejores patios se encuentran en el barrio de Santa Cruz; uno de los que se puede visitar es el de los Venerables, interesante patio con fuente central. También son muy recomendables los jardines de los palacios, como el de la Casa de Pilatos o el de las Dueñas.En el Aljarafe sevillano hay que citar el jardín del Colegio Mayor Santa María del Buen Aire diseñado por Forestier, en Castilleja de Guzmán y el Arboretum del Carambolo en Castilleja de la Cuesta.Dos Hermanas cuenta con la Alquería del Pilar y la Hacienda de la Torre de Doña María. Dentro de los numerosos cortijos y haciendas de olivar se puede visitar la Hacienda Benazuza de Sanlúcar la Mayor, transformada recientemente en hotel.En la provincia de Huelva destaca en Fuenteheridos el jardín de Villa Onuba con interesantes ejemplares de pinsapo y sequoia; y Riotinto resulta interesante por el barrio de los ingleses con casas ajardinadas de tipo inglés.En La Rábida destacan asimismo los complejos paisajísticos y el jardín claustral del convento, El Parque de Celestino Mutis. En la cercana Moguer sobresalen los patios y jardines del antiguo convento de las clarisas así como los patios de la casa del escritor Juan Ramón Jiménez.","type":"Text","value_raw":"En Sevilla, el jardín más antiguo que se conserva como tal es el Patio de los Naranjos, que perteneció a la antigua mezquita almohade sobre la que se asienta la actual catedral. De la misma época (siglo XII) data el Jardín Almohade de la Casa de Contratación, en pleno centro de la ciudad, recientemente restaurado, con el anacronismo de incluir palmeras americanas.El conjunto de los jardines del Alcázar reúne la mayor variedad de estilos posible en un espacio reducido. Allí se encuentran jardines de tradición mudéjar como el Patio de Doña María de Padilla, el Patio del Yeso o el Jardín de la Galera; renacentistas, especialmente el Jardín de la Danza, el de las Damas y alrededores del pabellón de Carlos V que incluye el laberinto de mirtos y cipreses; de estilo paisajista, el Jardín Inglés; y de principios de siglo como el Jardín de los Poetas y el de Vega Inclán. Entre los muchos ejemplares notables de este conjunto destacan varios palos borracho rosados (Chorisia speciosa), con un gran ejemplar al lado del pabellón de Carlos V, y los Gingko biloba o la Tabebuia del Jardín Inglés.Otro ejemplo de jardín cerrado, es el jardín de la Torre de Don Fadrique construido sobre antiguos huertos.Los jardines del período romántico están representados por el Jardín de las Delicias, con un curioso ejemplar de la palmera Phoenix reclinata con numerosos brazos, y abundantes naranjos morunos (Citrus myrtifolia); así como por los Jardines de Cristina y los de la Casa Rosa, con un interesante paseo de Cycas revoluta.A principios del siglo XX hay una renovación del estilo y aparece un jardín de inspiración hispano-árabe del que son ejemplo el Parque de María Luisa, diseñado en su mayor parte por Jean Nicolas Forestier con grandes ejemplares arbóreos, los Jardines de Murillo y el Paseo de Catalina de Ribera.También datan de nuestro siglo los Jardines de la Lonja y los de la antigua Fábrica de Tabacos, así como el Paseo de la Palmera y los numerosos jardines privados de su entorno, algunos de ellos con especies muy interesantes.Entre los diversos jardines actuales se pueden citar el Parque de los Príncipes y el conjunto de la Isla de La Cartuja, que incluye el antiguo huerto del monasterio y su entorno, con un antiguo zapote, y los modernos jardines implantados con motivo de la Expo 92, sobre todo los del Guadalquivir, en los que se representa un resumen de la historia de la jardinería, y el Americano, construido sólo a base de especies procedentes de América.Un elemento importante del paisaje urbano de Sevilla lo constituyen las plazas y los patios. Entre las primeras destacan la plaza del Cristo de Burgos y la del Museo, con grandes ejemplares de Ficus dealbata, la plaza del Duque con una enorme Grevillea robusta (árbol del fuego), la plaza de San Leandro con su hermoso ejemplar de Ficus retusa (laurel de Indias) y la de Santa Cruz con un magnífico ejemplar de Feijoa sellowiana. Los mejores patios se encuentran en el barrio de Santa Cruz; uno de los que se puede visitar es el de los Venerables, interesante patio con fuente central. También son muy recomendables los jardines de los palacios, como el de la Casa de Pilatos o el de las Dueñas.En el Aljarafe sevillano hay que citar el jardín del Colegio Mayor Santa María del Buen Aire diseñado por Forestier, en Castilleja de Guzmán y el Arboretum del Carambolo en Castilleja de la Cuesta.Dos Hermanas cuenta con la Alquería del Pilar y la Hacienda de la Torre de Doña María. Dentro de los numerosos cortijos y haciendas de olivar se puede visitar la Hacienda Benazuza de Sanlúcar la Mayor, transformada recientemente en hotel.En la provincia de Huelva destaca en Fuenteheridos el jardín de Villa Onuba con interesantes ejemplares de pinsapo y sequoia; y Riotinto resulta interesante por el barrio de los ingleses con casas ajardinadas de tipo inglés.En La Rábida destacan asimismo los complejos paisajísticos y el jardín claustral del convento, El Parque de Celestino Mutis. En la cercana Moguer sobresalen los patios y jardines del antiguo convento de las clarisas así como los patios de la casa del escritor Juan Ramón Jiménez.","value_string":"En Sevilla, el jardín más antiguo que se conserva como tal es el Patio de los Naranjos, que perteneció a la antigua mezquita almohade sobre la que se asienta la actual catedral. De la misma época (siglo XII) data el Jardín Almohade de la Casa de Contratación, en pleno centro de la ciudad, recientemente restaurado, con el anacronismo de incluir palmeras americanas.El conjunto de los jardines del Alcázar reúne la mayor variedad de estilos posible en un espacio reducido. Allí se encuentran jardines de tradición mudéjar como el Patio de Doña María de Padilla, el Patio del Yeso o el Jardín de la Galera; renacentistas, especialmente el Jardín de la Danza, el de las Damas y alrededores del pabellón de Carlos V que incluye el laberinto de mirtos y cipreses; de estilo paisajista, el Jardín Inglés; y de principios de siglo como el Jardín de los Poetas y el de Vega Inclán. Entre los muchos ejemplares notables de este conjunto destacan varios palos borracho rosados (Chorisia speciosa), con un gran ejemplar al lado del pabellón de Carlos V, y los Gingko biloba o la Tabebuia del Jardín Inglés.Otro ejemplo de jardín cerrado, es el jardín de la Torre de Don Fadrique construido sobre antiguos huertos.Los jardines del período romántico están representados por el Jardín de las Delicias, con un curioso ejemplar de la palmera Phoenix reclinata con numerosos brazos, y abundantes naranjos morunos (Citrus myrtifolia); así como por los Jardines de Cristina y los de la Casa Rosa, con un interesante paseo de Cycas revoluta.A principios del siglo XX hay una renovación del estilo y aparece un jardín de inspiración hispano-árabe del que son ejemplo el Parque de María Luisa, diseñado en su mayor parte por Jean Nicolas Forestier con grandes ejemplares arbóreos, los Jardines de Murillo y el Paseo de Catalina de Ribera.También datan de nuestro siglo los Jardines de la Lonja y los de la antigua Fábrica de Tabacos, así como el Paseo de la Palmera y los numerosos jardines privados de su entorno, algunos de ellos con especies muy interesantes.Entre los diversos jardines actuales se pueden citar el Parque de los Príncipes y el conjunto de la Isla de La Cartuja, que incluye el antiguo huerto del monasterio y su entorno, con un antiguo zapote, y los modernos jardines implantados con motivo de la Expo 92, sobre todo los del Guadalquivir, en los que se representa un resumen de la historia de la jardinería, y el Americano, construido sólo a base de especies procedentes de América.Un elemento importante del paisaje urbano de Sevilla lo constituyen las plazas y los patios. Entre las primeras destacan la plaza del Cristo de Burgos y la del Museo, con grandes ejemplares de Ficus dealbata, la plaza del Duque con una enorme Grevillea robusta (árbol del fuego), la plaza de San Leandro con su hermoso ejemplar de Ficus retusa (laurel de Indias) y la de Santa Cruz con un magnífico ejemplar de Feijoa sellowiana. Los mejores patios se encuentran en el barrio de Santa Cruz; uno de los que se puede visitar es el de los Venerables, interesante patio con fuente central. También son muy recomendables los jardines de los palacios, como el de la Casa de Pilatos o el de las Dueñas.En el Aljarafe sevillano hay que citar el jardín del Colegio Mayor Santa María del Buen Aire diseñado por Forestier, en Castilleja de Guzmán y el Arboretum del Carambolo en Castilleja de la Cuesta.Dos Hermanas cuenta con la Alquería del Pilar y la Hacienda de la Torre de Doña María. Dentro de los numerosos cortijos y haciendas de olivar se puede visitar la Hacienda Benazuza de Sanlúcar la Mayor, transformada recientemente en hotel.En la provincia de Huelva destaca en Fuenteheridos el jardín de Villa Onuba con interesantes ejemplares de pinsapo y sequoia; y Riotinto resulta interesante por el barrio de los ingleses con casas ajardinadas de tipo inglés.En La Rábida destacan asimismo los complejos paisajísticos y el jardín claustral del convento, El Parque de Celestino Mutis. En la cercana Moguer sobresalen los patios y jardines del antiguo convento de las clarisas así como los patios de la casa del escritor Juan Ramón Jiménez."},"13":{"fieldid":13,"typeid":4,"name":"Preferred Google Zoom Level","digits":0,"value":17,"type":"Number","value_raw":17,"value_string":"17"},"15":{"fieldid":15,"typeid":4,"name":"Random","digits":0,"value":1354935373,"type":"Number","value_raw":1354935373,"value_string":"1354935373"},"16":{"fieldid":16,"typeid":4,"name":"Random24","digits":0,"value":-823572216,"type":"Number","value_raw":-823572216,"value_string":"-823572216"},"30":{"fieldid":30,"typeid":12,"name":"Place Level 2","digits":0,"valuearray":[{"listid":62721,"value":"Sevilla"}],"type":"Multi-Select","value_raw":[{"listid":62721,"value":"Sevilla"}],"value_string":"Sevilla"},"31":{"fieldid":31,"typeid":12,"name":"Place Level 3","digits":0,"valuearray":[{"listid":63701,"value":"Sevilla"}],"type":"Multi-Select","value_raw":[{"listid":63701,"value":"Sevilla"}],"value_string":"Sevilla"}},"locale":"es-ES","locale_items":[{"_id":"69fc6511b22934a884391b52","recid":21440101,"locale_code":"en-GB","title":"Gardens of Sevilla","sites":["en"],"primary_site":"en","id":"69fc6511b22934a884391b52","detailURL":"/listing/gardens-of-sevilla/21440101/","genericUrl":"/listing/gardens-of-sevilla/21440101/","url":"/listing/gardens-of-sevilla/21440101/","absolute_url":"https://www.andalucia.org/listing/gardens-of-sevilla/21440101/","absolute_primary_url":"https://en.andalucia.org/listing/gardens-of-sevilla/21440101/","isListing":true,"hasTripAdvisor":false,"hasYelp":false},{"_id":"69fc6546b22934a884396df2","recid":21440103,"locale_code":"de-DE","title":"Sevilla","sites":["de"],"primary_site":"de","id":"69fc6546b22934a884396df2","detailURL":"/listing/sevilla/21440103/","genericUrl":"/listing/sevilla/21440103/","url":"/listing/sevilla/21440103/","absolute_url":"https://www.andalucia.org/listing/sevilla/21440103/","absolute_primary_url":"https://de.andalucia.org/listing/sevilla/21440103/","isListing":true,"hasTripAdvisor":false,"hasYelp":false},{"_id":"69fc657bb22934a88439c115","recid":21440104,"locale_code":"fr-FR","title":"Sévilla","sites":["fr"],"primary_site":"fr","id":"69fc657bb22934a88439c115","detailURL":"/listing/s%c3%a9villa/21440104/","genericUrl":"/listing/s%c3%a9villa/21440104/","url":"/listing/s%c3%a9villa/21440104/","absolute_url":"https://www.andalucia.org/listing/s%c3%a9villa/21440104/","absolute_primary_url":"https://fr.andalucia.org/listing/s%c3%a9villa/21440104/","isListing":true,"hasTripAdvisor":false,"hasYelp":false}],"posts":[],"origins":[{"fieldid":17891,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285201,"typeid":11,"digits":0,"label":"Rutas de jardines","shortname":"Rutas de jardines","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Rutas de jardines"},{"fieldid":19441,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285241,"typeid":11,"digits":0,"label":"Invierno","shortname":"Invierno","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Invierno"},{"fieldid":19471,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285241,"typeid":11,"digits":0,"label":"Otoño","shortname":"Otoño","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Otoño"},{"fieldid":19451,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285241,"typeid":11,"digits":0,"label":"Primavera","shortname":"Primavera","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Primavera"},{"fieldid":19461,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285241,"typeid":11,"digits":0,"label":"Verano","shortname":"Verano","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Verano"},{"fieldid":20131,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285301,"typeid":11,"digits":0,"label":"Amigos","shortname":"Amigos","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Amigos"},{"fieldid":20141,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285301,"typeid":11,"digits":0,"label":"Familiar","shortname":"Familiar","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Familiar"},{"fieldid":20151,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285301,"typeid":11,"digits":0,"label":"Jóvenes","shortname":"Jóvenes","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Jóvenes"},{"fieldid":20161,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285301,"typeid":11,"digits":0,"label":"LGTBI","shortname":"LGTBI","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_LGTBI"},{"fieldid":20171,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285301,"typeid":11,"digits":0,"label":"Mayores","shortname":"Mayores","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Mayores"},{"fieldid":20181,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285301,"typeid":11,"digits":0,"label":"Parejas","shortname":"Parejas","value":"true","type":"Yes/No","value_raw":true,"value_string":"Yes","uniquename":"Atributo_Parejas"},{"fieldid":20201,"amenitytabid":128,"tabshortname":"Atributo","amenitygroupid":285301,"typeid":1