<script>
	require(["jquery", 'plugins_core/main',"domReady!"], function($, core) {
		var root = $("#locale_selector_34b34bbe-3ee3-43ac-9a0c-67dd644677e2");

		function init(root){
			var isDetailPage = /\/(listing|event|coupon)[\-\/]/.test(window.location.pathname);
			root.find(".toggle").on("click", function(e) {
				e.preventDefault();
				$(this).parent().toggleClass("open");
				return(false);
			});

			root.find(".dropdown div").each(function( index ) {
				if($(this).hasClass("selected")) {
					$(this).insertBefore($(".dropdown div").first());
				}
			});
			root.find(".dropdown div a").on("click", function(e) {
				e.preventDefault();
				var href = $(this).attr("data-href");
				var targetLocale =  $(this).attr("locale-code");

				if(isDetailPage) {
					var localeSwitchListingEvent = { type: "localeSwitchListingEvent", targetLocale: targetLocale, site: href, href: href};
					$("html").trigger(localeSwitchListingEvent);
				} else {
					// not a detail page
					window.location.href = href;
				}

				return(false);
			});
		}

		if(root.find(".toggle").length) {	
			init(root);
		}

		$("html").on("blogLocaleData", function(){
			var root = $("#locale_selector_34b34bbe-3ee3-43ac-9a0c-67dd644677e2");
			init(root);
		});

	});
</script>
