<script>window.a2a_config=window.a2a_config||{};a2a_config.callbacks=[];a2a_config.overlays=[];a2a_config.templates={};a2a_config.callbacks.push({
    share: function(share_data) {
        var internal_host = 'www1.ccul.junta-andalucia.es';
        var external_host = 'www.juntadeandalucia.es';

        var old_url = share_data.url;
        var new_url = old_url;

        // Cambiar el dominio interno por el público
        if (old_url.indexOf(internal_host) !== -1) {
            new_url = old_url.replace(internal_host, external_host);
        }

        // Configuración UTM según el servicio
        var utm_source = share_data.serviceCode;
        var utm_medium = 'social';

        if (share_data.serviceCode === 'email') {
            utm_medium = 'email';
        }

        // Añadir los parámetros UTM
        var url = new URL(new_url);

        url.searchParams.set('utm_source', utm_source);
        url.searchParams.set('utm_medium', utm_medium);
        url.searchParams.set('utm_campaign', 'compartir_evento');

        // Usar el slug del evento como contenido
        var path_parts = url.pathname.split('/').filter(Boolean);
        var slug = path_parts[path_parts.length - 1];

        url.searchParams.set('utm_content', slug);

        return {
            url: url.toString()
        };
    }
});</script>

