    width: 62px; 
}

.avatar img { content: url("https://sevillagolf.com/wp-content/uploads/2023/12/img_club_golf.jpg") !important;
}

#header-outer.transparent #top nav > ul > li > a, #header-outer.transparent #top nav > .sf-menu > li > a, #header-outer.transparent .slide-out-widget-area-toggle a i.label, #header-outer.transparent #top .span_9 > .slide-out-widget-area-toggle a.using-label .label, #header-outer.transparent #top nav ul #search-btn a .icon-salient-search, #header-outer.transparent #top nav ul #nectar-user-account a span, #header-outer.transparent #top nav > ul > li > a > .sf-sub-indicator i, #header-outer.transparent .cart-menu .cart-icon-wrap .icon-salient-cart, .ascend #boxed #header-outer.transparent .cart-menu .cart-icon-wrap .icon-salient-cart, #header-outer.transparent #top .sf-menu > li.nectar-regular-menu-item > a > .nectar-menu-icon, #header-outer.transparent .nectar-header-text-content, #header-outer.transparent .nectar-mobile-only.mobile-header li:not([class*="menu-item-btn-style"]) a {
    color: #2a5135 !important;
    opacity: 1;
    will-change: opacity, color;
    transition: opacity 0.2s ease, color 0.2s ease;
	font-weight:600;
}

#header-outer #top nav > ul > li > a, #header-outer .slide-out-widget-area-toggle a i.label, #header-outer:not(.transparent) #top #logo, #header-outer #top .span_9 > .slide-out-widget-area-toggle i, #header-outer #top .sf-sub-indicator i, body[data-header-color="custom"].ascend #boxed #header-outer .cart-menu .cart-icon-wrap i, #header-outer #top nav ul #nectar-user-account a span, #header-outer #top #toggle-nav i, .material #header-outer:not([data-permanent-transparent="1"]) .mobile-search .icon-salient-search, #header-outer:not([data-permanent-transparent="1"]) .mobile-user-account .icon-salient-m-user, #header-outer:not([data-permanent-transparent="1"]) .mobile-search .icon-salient-search, #header-outer #top #mobile-cart-link i, #header-outer .cart-menu .cart-icon-wrap .icon-salient-cart, body[data-header-format="left-header"] #header-outer #social-in-menu a, #header-outer #top nav ul #search-btn a span, #search-outer #search input[type="text"], #search-outer #search #close a span, body.ascend #search-outer #search #close a span, body.ascend #search-outer #search input[type="text"], .material #search-outer #search .span_12 span, .style_slide_in_click .total, .style_slide_in_click .total strong, .nectar-slide-in-cart.style_slide_in_click h4, .nectar-slide-in-cart.style_slide_in_click .widget_shopping_cart, .nectar-slide-in-cart.style_slide_in_click .widget_shopping_cart .cart_list.woocommerce-mini-cart .mini_cart_item a, .style_slide_in_click .woocommerce-mini-cart__empty-message h3 {
    color: #2b5135 !important;
    opacity: 1 !important;
    font-weight: 600 !important;
}

.sub-menu.tracked-pos li {
  margin-bottom: 7px;
}

#header-outer .sf-menu li ul li a {
  line-height: 20px;
}

/*Tienda*/
/* Swatches de color redondos */
.woo-variation-swatches .variable-items-wrapper .variable-item.color-variable-item,
.woo-variation-swatches .variable-items-wrapper .variable-item.color-variable-item .variable-item-contents,
.woo-variation-swatches .variable-items-wrapper .variable-item.color-variable-item span {
  border-radius: 50% !important;
}

.woo-variation-swatches .variable-items-wrapper .variable-item.color-variable-item {
  width: 32px;
  height: 32px;
}

.single-product .product_title.entry-title {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 48px;
    line-height: 48px;
    letter-spacing: -1.2px;
}
.single-product .price {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-style: italic;
    font-size: 30px;
    line-height: 36px;
    color: #C0B460 !important;
    padding: 6px 12px;
    display: inline-block;
}

/* BOTONES DE VARIACIONES */
.woo-variation-swatches .variable-items-wrapper .variable-item.button-variable-item {
    width: 68.75px;
    height: 38px;
    border: 0.5px solid #2B5135;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    transition: all 0.2s ease;
}
/* BOTÓN ACTIVO */
.woo-variation-swatches .variable-items-wrapper .variable-item.button-variable-item.selected {
    
    background-color: #2B51350D;
    border-color: #2B5135;
}
/* HOVER */
.woo-variation-swatches .variable-items-wrapper .variable-item.button-variable-item:hover { 
    background-color: #2B51350D;
}

}
.woocommerce #ajax-content-wrap .woocommerce-tabs > div:not(.tab-container) {
  padding: 15px 0;
	width: 100%;
	max-width: 600px;
}
#tab-additional_information{
	width: 100% !important;
	max-width: 600px;
}

.single-product .woocommerce-tabs {
    display: flex;
    flex-direction: column;
    align-items: center;
}

li.description_tab { display:none !important; }


/* ======================================
   RCSG FORM (Contact Form 7 + Salient)
   ====================================== */

/* Contenedor */
.rcsg-form{
  max-width: 980px;
  margin: 0 auto;
}

.rcsg-header{
  text-align:center;
  margin-bottom:40px;
}

.rcsg-title{
  font-family:'Playfair Display', serif;
  font-weight:700;
  font-style:normal;
  font-size:32px;
  line-height:100%;
  letter-spacing:0;
  color:#2B5135;
  margin:0 0 18px 0;
}

.rcsg-subtitle{
  max-width:720px;
  margin:0 auto;
  font-size:15px;
  line-height:1.6;
  color:rgba(43,81,53,.85);
}

/* Tarjeta blanca */
.rcsg-card{
  background:#fff;
  border-radius:22px;
  padding:48px 52px;
  box-shadow:0 14px 40px rgba(0,0,0,.12);
}

/* Grid base */
.rcsg-grid{
  display:grid;
  gap:26px;
  margin-bottom:26px;
}

.rcsg-grid-1{ grid-template-columns:1fr; }

/* FILA 1: 3 columnas */
.rcsg-row1{
  grid-template-columns: repeat(3, minmax(0,1fr));
}

/* FILA 2: 3 columnas (col1/col2/col3) */
.rcsg-row2{
  grid-template-columns: repeat(3, minmax(0,1fr));
  align-items:start;
}

/* Columna 1 de fila 2: grid interno 2 columnas (tengo hijos + cuantos) */
.rcsg-row2-col1{
  grid-template-columns: 1fr 1fr;
  gap:16px;
  margin-bottom:0;
}

/* Labels */
.rcsg-field label{
  display:block;
  font-size:13px;
  line-height:1.2;
  margin:0 0 8px 0;
  color:#2B5135;
  font-weight:600;
}

/* Inputs + selects */
.rcsg-form input[type="text"],
.rcsg-form input[type="email"],
.rcsg-form input[type="tel"],
.rcsg-form input[type="number"],
.rcsg-form textarea,
.rcsg-form select{
  width:100%;
  box-sizing:border-box;
  border:1px solid #E6E8EB;
  background:#F4F6F7;
  border-radius:6px;
  padding:12px 14px;
  font-size:14px;
  line-height:1.2;
  color:#2B5135;
  transition:border-color .2s ease, background .2s ease, box-shadow .2s ease;
}

.rcsg-form input::placeholder,
.rcsg-form textarea::placeholder{
  color:rgba(43,81,53,.55);
}

.rcsg-form input:focus,
.rcsg-form textarea:focus,
.rcsg-form select:focus{
  outline:none;
  background:#fff;
  border-color:rgba(43,81,53,.55);
  box-shadow:0 0 0 3px rgba(43,81,53,.12);
}

/* Select arrow */
.rcsg-form select{
  -webkit-appearance:none;
  -moz-appearance:none;
  appearance:none;
  padding-right:42px;
  background-image:
    linear-gradient(45deg, transparent 50%, rgba(43,81,53,.75) 50%),
    linear-gradient(135deg, rgba(43,81,53,.75) 50%, transparent 50%);
  background-position:
    calc(100% - 18px) 50%,
    calc(100% - 12px) 50%;
  background-size:6px 6px, 6px 6px;
  background-repeat:no-repeat;
}

/* CF7 wraps */
.rcsg-form .wpcf7-form-control-wrap{ display:block; }

/* Checkbox Tengo hijo/s */
.rcsg-checkfield{
  display:flex;
  align-items:center;
  min-height:44px;
}
.rcsg-checkfield .wpcf7-list-item{ margin:0; }
.rcsg-checkfield label{
  margin:0;
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:600;
  color:rgba(43,81,53,.92);
}
.rcsg-form input[type="checkbox"],
.rcsg-form input[type="radio"]{
  width:16px; height:16px; margin:0;
  accent-color:#2B5135;
}

/* Footer */
.rcsg-foot{ margin-top:8px; }
.rcsg-accept{
  font-size:12px;
  color:rgba(43,81,53,.85);
  margin-bottom:18px;
}
.rcsg-accept a{ color:#2B5135; text-decoration:underline; }

/* Botón */
.rcsg-submit input[type="submit"]{
  background:#2B5135 !important;
  color:#fff !important;
  border:0 !important;
  border-radius:999px !important;
  padding:12px 30px !important;
  font-size:14px !important;
  font-weight:700 !important;
  cursor:pointer;
  transition:transform .15s ease, filter .2s ease;
  box-shadow:0 10px 24px rgba(0,0,0,.12);
}
.rcsg-submit input[type="submit"]:hover{
  filter:brightness(.92);
  transform:translateY(-1px);
}

/* Mensajes CF7 */
.rcsg-form .wpcf7-response-output{
  border-radius:8px;
  padding:12px 14px;
  margin:16px 0 0 0;
  font-size:13px;
}
.rcsg-form .wpcf7-not-valid-tip{
  font-size:12px;
  margin-top:6px;
}

/* Responsive */
@media (max-width: 999px){
  .rcsg-card{ padding:26px 18px; border-radius:16px; }
  .rcsg-row1, .rcsg-row2{ grid-template-columns:1fr; }
  .rcsg-row2-col1{ grid-template-columns:1fr; }
}

