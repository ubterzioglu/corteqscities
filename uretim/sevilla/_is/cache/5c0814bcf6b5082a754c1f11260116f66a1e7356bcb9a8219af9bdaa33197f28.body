/*Formualrio quiero conocer el club*/
/* Campos de texto */
.cgolf-field {
  margin-bottom: 24px;
}

.cgolf-label {
  display: block;
  font-family: 'Source Sans 3', sans-serif;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: 0.8px;
  color: #695f13;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.cgolf-field input[type="text"],
.cgolf-field input[type="email"],
.cgolf-field input[type="tel"] {
  width: 100%;
  border: none;
  border-bottom: 1px solid #cccccc;
  padding: 8px 0;
  font-family: 'Source Sans 3', sans-serif;
  font-size: 16px;
  color: #999999;
  background: transparent;
  outline: none;
  box-shadow: none;
}

.cgolf-field input[type="text"]:focus,
.cgolf-field input[type="email"]:focus,
.cgolf-field input[type="tel"]:focus {
  border-bottom: 1px solid #695f13;
}

/* Checkboxes en grid 2 columnas */
.cgolf-checkboxes .wpcf7-checkbox {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px 24px;
  margin-top: 8px;
}

.cgolf-checkboxes .wpcf7-list-item {
  margin: 0;
}

.cgolf-checkboxes .wpcf7-list-item label {
  font-family: 'Source Sans 3', sans-serif;
  font-size: 16px;
  color: #333333;
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
}

.cgolf-checkboxes input[type="checkbox"] {
  width: 16px;
  height: 16px;
  border: 1px solid #cccccc;
  border-radius: 2px;
  accent-color: #695f13;
  cursor: pointer;
  flex-shrink: 0;
}

/* Botón */
.wpcf7-submit {
  width: 100%;
  background-color: #C0B366 !important;
  color: #2C5136 !important;
  font-family: 'Source Sans 3', sans-serif;
  font-weight: 600;
  font-size: 16px;
  padding: 18px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  margin-top: 24px;
  letter-spacing: 0.3px;
  transition: background-color 0.2s ease;
	width: 100% !important;
}
@import url('https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@400;600&display=swap');

/* ── Estado normal ── */
.select2-container:has(#select2-product_cat-container) .select2-selection--single {
    border: 1px solid #3a5a2d;
    border-radius: 4px;
    height: auto;
    background-color: #ECECEC;
    padding: 8px 12px;
    font-family: 'Source Sans Pro', sans-serif;
}

.select2-container:has(#select2-product_cat-container) .select2-selection__rendered {
    color: #333;
    line-height: normal;
    padding-left: 0;
    font-family: 'Source Sans Pro', sans-serif;
}

.select2-container:has(#select2-product_cat-container) .select2-selection__placeholder {
    color: #777;
    font-family: 'Source Sans Pro', sans-serif;
}

.select2-container:has(#select2-product_cat-container) .select2-selection__arrow {
    top: 50%;
    transform: translateY(-50%);
}

/* ── Estado activo / abierto ── */
.select2-container--open:has(#select2-product_cat-container) .select2-selection--single {
    border-color: #3a5a2d;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    outline: none;
    box-shadow: none;
}

/* ── Dropdown desplegado ── */
.select2-dropdown:has(#select2-product_cat-results) {
    border: 1px solid #3a5a2d;
    border-top: none;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #fff;
    font-family: 'Source Sans Pro', sans-serif;
}

.select2-dropdown:has(#select2-product_cat-results) .select2-results__option {
    color: #333;
    font-family: 'Source Sans Pro', sans-serif;
    padding: 8px 12px;
    background-color: #fff;
}

.select2-dropdown:has(#select2-product_cat-results) .select2-results__option--highlighted {
    background-color: #555;
    color: #fff;
}

.select2-dropdown:has(#select2-product_cat-results) .select2-results__option[aria-selected="true"] {
    background-color: #ECECEC;
    color: #333;
}

.select2-dropdown:has(#select2-product_cat-results) {
  border: 1px solid #3a5a2d;
	border-radius: 5px !important;
  background-color: #fff;
  font-family: 'Source Sans Pro', sans-serif;
}

body h3, .row .col h3, .toggle > h3.toggle-title a, .ascend #respond h3, .ascend h3#comments, .woocommerce ul.products li.product.text_on_hover h3, .masonry.classic_enhanced .masonry-blog-item h3.title, .woocommerce ul.products li.product.material h3, .woocommerce-page ul.products li.product.material h3, .portfolio-items[data-ps="8"] .col h3, .nectar-hor-list-item[data-font-family="h3"], .woocommerce ul.products li.product h2, .nectar-quick-view-box h1, .nectar-ext-menu-item .inherit-h3 .menu-title-text, #slide-out-widget-area .nectar-ext-menu-item .inherit-h3, #mobile-menu .nectar-ext-menu-item .inherit-h3, #ajax-content-wrap .nectar-inherit-h3, #header-outer .nectar-inherit-h3, [data-inherit-heading-family="h3"], .nectar-quick-view-box div.product h1.product_title.nectar-inherit-h3, .nectar-quick-view-box div.product .summary p.price.nectar-inherit-h3, body.woocommerce div.product p.price.nectar-inherit-h3 ins {
  font-family: Playfair Display;
  font-size: 26px;
  line-height: 30px;
  font-weight: 600;
}

/*Ocultar carrito*/
body.material #header-outer #top nav > .buttons > li:first-child {
  margin-left: 0;
  display: none;
}

#top #mobile-cart-link, #top .mobile-search, #top .mobile-user-account {
  display: none !important;
  text-align: right;
  z-index: 10000;
}

/*CSS Para formulario Landing - Torneo*/
/* Contenedor general */
.golf-form {
  background: #ffffff;
  padding: 40px 36px;
  max-width: 520px;
  box-sizing: border-box;
}

/* Cada campo */
.golf-field {
  margin-bottom: 28px;
}

/* Labels */
.golf-field label {
  display: block;
  font-family: 'Source Sans Pro', sans-serif;
  font-weight: 700;
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #8a7d3a;
  margin-bottom: 8px;
}

/* Inputs, textarea y number */
.golf-form .wpcf7-form-control:not([type="submit"]) {
  width: 100%;
  border: none;
  border-bottom: 1.5px solid #cccccc;
  border-radius: 0;
  padding: 6px 0;
  font-family: 'Source Sans Pro', sans-serif;
  font-size: 16px;
  color: #333333;
  background: transparent;
  outline: none;
  box-shadow: none;
  box-sizing: border-box;
  -webkit-appearance: none;
  -moz-appearance: textfield;
}

.golf-form .wpcf7-form-control:not([type="submit"])::placeholder {
  color: #b0b0b0;
}

.golf-form .wpcf7-form-control:not([type="submit"]):focus {
  border-bottom-color: #8a7d3a;
}

/* Fix específico para number */
.golf-form input[type="number"] {
  display: block;
  width: 100%;
  border: none;
  border-bottom: 1.5px solid #cccccc;
  border-radius: 0;
  padding: 6px 0;
  font-family: 'Source Sans Pro', sans-serif;
  font-size: 16px;
  color: #333333;
  background: transparent;
  outline: none;
  box-shadow: none;
  box-sizing: border-box;
  -webkit-appearance: none;
  -moz-appearance: textfield;
}

.golf-form input[type="number"]::-webkit-outer-spin-button,
.golf-form input[type="number"]::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

/* Textarea */
.golf-form textarea.wpcf7-form-control {
  resize: none;
  height: 60px;
}

/* Botón */
.golf-form .wpcf7-submit {
  width: 100%;
  background-color: #9a8f3f;
  color: #ffffff;
  font-family: 'Source Sans Pro', sans-serif;
  font-weight: 700;
  font-size: 18px;
  letter-spacing: 0.5px;
  border: none;
  padding: 18px;
  cursor: pointer;
  margin-top: 12px;
  transition: background-color 0.3s ease;
}

.golf-form .wpcf7-submit:hover {
  background-color: #7d7230;
}

/* Mensajes CF7 */
.golf-form .wpcf7-not-valid-tip {
  font-size: 12px;
  color: #cc0000;
}

.golf-form .wpcf7-response-output {
  margin-top: 16px;
  padding: 10px;
  font-size: 14px;
  border-radius: 0;
}
.golf-form .wpcf7-select {
  width: 100%;
  border: none;
  border-bottom: 1.5px solid #cccccc;
  border-radius: 0;
  padding: 6px 0;
  font-family: 'Source Sans Pro', sans-serif;
  font-size: 16px;
  color: #333333;
  background: transparent;
  outline: none;
  box-shadow: none;
  box-sizing: border-box;
  -webkit-appearance: none;
  cursor: pointer;
}

.golf-form .wpcf7-select:focus {
  border-bottom-color: #8a7d3a;
}</style><style type="text/css" data-type="vc_shortcodes-default-css">.vc_do_custom_heading{margin-bottom:0.625rem;margin-top:0;}.vc_do_custom_heading{margin-bottom:0.625rem;margin-top:0;}.vc_do_custom_heading{margin-bottom:0.625rem;margin-top:0;}.vc_do_custom_heading{margin-bottom:0.625rem;margin-top:0;}.vc_do_custom_heading{margin-bottom:0.625rem;margin-top:0;}.vc_do_custom_heading{margin-bottom:0.625rem;margin-top:0;}</style><style type="text/css" data-type="vc_shortcodes-custom-css">.vc_custom_1658407249007{margin-top: -140px !important;margin-bottom: 140px !important;}.vc_custom_1659599728181{margin-top: 0px !important;margin-bottom: 160px !important;}.vc_custom_1694160386981{margin-bottom: 30px !important;}.vc_custom_1662648776935{margin-bottom: 30px !important;}.vc_custom_1662648842030{margin-bottom: 30px !important;}.vc_custom_1662648875074{margin-bottom: 30px !important;}.vc_custom_1659521448423{margin-bottom: 10px !important;padding-left: 70px !important;}.vc_custom_1662716698043{margin-top: 0px !important;padding-right: 70px !important;}.vc_custom_1659521272318{margin-top: 50px !important;}.vc_custom_1661163374396{margin-top: 25px !important;}.vc_custom_1661163368284{margin-top: 25px !important;}.vc_custom_1661163360205{margin-top: 25px !important;}.vc_custom_1658407249007{margin-top: -140px !important;margin-bottom: 140px !important;}.vc_custom_1659599728181{margin-top: 0px !important;margin-bottom: 160px !important;}.vc_custom_1694160745873{margin-bottom: 30px !important;}.vc_custom_1662648776935{margin-bottom: 30px !important;}.vc_custom_1662648842030{margin-bottom: 30px !important;}.vc_custom_1662648875074{margin-bottom: 30px !important;}.vc_custom_1781693321325{margin-bottom: 10px !important;padding-left: 70px !important;}.vc_custom_1781693332207{margin-top: -25px !important;padding-right: 70px !important;}.vc_custom_1659521272318{margin-top: 50px !important;}.vc_custom_1661163374396{margin-top: 25px !important;}.vc_custom_1661163368284{margin-top: 2