<script id="wp-emoji-settings" type="application/json">
{"baseUrl":"https://s.w.org/images/core/emoji/17.0.2/72x72/","ext":".png","svgUrl":"https://s.w.org/images/core/emoji/17.0.2/svg/","svgExt":".svg","source":{"wpemoji":"https://fundacioncajasol.com/wp-includes/js/wp-emoji.js?ver=1ac8a0c0d9811711ab429d86b581abbc","twemoji":"https://fundacioncajasol.com/wp-includes/js/twemoji.js?ver=1ac8a0c0d9811711ab429d86b581abbc"}}
