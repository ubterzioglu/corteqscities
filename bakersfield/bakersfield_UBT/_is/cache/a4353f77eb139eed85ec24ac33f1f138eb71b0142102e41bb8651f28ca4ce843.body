rich-text__text">Hours and Admissions</span></span></span></span></span><br class="wixui-rich-text__text">
&nbsp;</h2></div><div id="comp-l8nbp61z" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-l8nbp61z wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:38px; line-height:0.9em; text-align:center;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text">Thursday - Saturday: 10am - 4pm</span></span></span></span></span><br class="wixui-rich-text__text">
<span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text">Sunday: 12pm - 4pm</span></span></span></span></span><br class="wixui-rich-text__text">
<span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text">Monday-Wednesday: Closed</span></span></span></span></span></h2></div><div id="comp-k4ria060" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-k4ria060 wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="line-height:1em; text-align:center; font-size:25px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text">General Admission</span></span></span></span><br class="wixui-rich-text__text">
<br class="wixui-rich-text__text">
<span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text">Members: Free</span></span></span></span></span><br class="wixui-rich-text__text">
<span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text">Children 2 and under: Free</span></span></span></span></span><br class="wixui-rich-text__text">
<span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text">Adults: $10</span></span></span></span></span><br class="wixui-rich-text__text">
<span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text">Seniors (60+): $8</span></span></span></span></span><br class="wixui-rich-text__text">
<span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text">Students 12 years and older: $8</span></span></span></span></span><br class="wixui-rich-text__text">
<span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text">Children (3-11): $6</span></span></span></span></span></h2></div></div></div></div><div id="comp-k4ria08h" class="comp-k4ria08h FDI5TK wixui-column-strip__column"><div id="bgLayers_comp-k4ria08h" data-hook="bgLayers" data-motion-part="BG_LAYER comp-k4ria08h" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-k4ria08h" data-motion-part="BG_MEDIA comp-k4ria08h" class="ROWgFb"><wow-image id="img_comp-k4ria08h" class="Qh0lWW ayCf9D fO4mKs NgeJ4N bgImage" data-image-info="{&quot;containerId&quot;:&quot;comp-k4ria08h&quot;,&quot;alignType&quot;:&quot;center&quot;,&quot;displayMode&quot;:&quot;fill&quot;,&quot;targetWidth&quot;:559,&quot;targetHeight&quot;:871,&quot;isLQIP&quot;:true,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;width&quot;:1893,&quot;height&quot;:1403,&quot;uri&quot;:&quot;4d0263_4b68c6e8905d44619bbc6a815ce71f99~mv2.jpg&quot;,&quot;name&quot;:&quot;&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-k4ria08h" data-bg-effect-name="" data-has-ssr-src="true"><img src="https://static.wixstatic.com/media/4d0263_4b68c6e8905d44619bbc6a815ce71f99~mv2.jpg/v1/fill/w_101,h_75,al_c,q_80,usm_0.66_1.00_0.01,blur_2,enc_avif,quality_auto/4d0263_4b68c6e8905d44619bbc6a815ce71f99~mv2.jpg" alt="" style="width:100%;height:100%;object-fit:cover;object-position:50% 50%" width="559" height="871"/></wow-image></div></div><div data-mesh-id="comp-k4ria08hinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-k4ria08hinlineContent-gridContainer" data-testid="mesh-container-content"></div></div></div></div></section><div id="comp-k4ria0bg" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4ria0bg wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:37px; text-align:center;"><span style="color:#2F87D4;" class="wixui-rich-text__text"><span style="font-size:37px;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text"><span style="letter-spacing:0.2em;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text">More Ways to Visit</span></span></span></span></span></h2></div><div id="comp-k4riwhm9" class="e_a0EV comp-k4riwhm9"><div class="gyovE9 wixui-box" data-testid="container-bg"></div><div data-mesh-id="comp-k4riwhm9inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-k4riwhm9inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-k4riy38f" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4riy38f wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:14px; line-height:1.3em;"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">BVM is a Blue Star Museum which means we&nbsp;offer free admission to the nation&rsquo;s active duty military personnel including National Guard and Reserve and their families.</span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:14px; line-height:1.3em;"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text"><span class="wixGuard wixui-rich-text__text">​</span></span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:14px; line-height:1.3em;"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">Click <span style="text-decoration:underline;" class="wixui-rich-text__text"><a class="wixui-rich-text__text">here</a></span> for more information about Blue Star Museums.</span></span></span></span></p></div><div id="comp-k4riyu3y" class="W4V2qg comp-k4riyu3y wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="248px" srcSet="https://static.wixstatic.com/media/4d0263_7914c1d29d974c0b9c879fcde8d1ad05~mv2_d_2640_1691_s_2.png/v1/fill/w_248,h_155,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/BSM%20logo.png 1x, https://static.wixstatic.com/media/4d0263_7914c1d29d974c0b9c879fcde8d1ad05~mv2_d_2640_1691_s_2.png/v1/fill/w_496,h_310,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/BSM%20logo.png 2x" id="img_comp-k4riyu3y" src="https://static.wixstatic.com/media/4d0263_7914c1d29d974c0b9c879fcde8d1ad05~mv2_d_2640_1691_s_2.png/v1/fill/w_248,h_155,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/BSM%20logo.png" alt="BSM logo.png" style="object-fit:cover" class="gRkIq0 sFiSiq" width="248" height="155"/></div></div></div></div></div><div id="comp-k4rizlk1" class="e_a0EV comp-k4rizlk1"><div class="gyovE9 wixui-box" data-testid="container-bg"></div><div data-mesh-id="comp-k4rizlk1inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-k4rizlk1inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-k4rj0nw0" class="W4V2qg comp-k4rj0nw0 wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="208px" srcSet="https://static.wixstatic.com/media/4d0263_63b8c651a249480a848671da01f28dcf~mv2.png/v1/fill/w_208,h_102,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/museums-for-all-logo_rgb.png 1x, https://static.wixstatic.com/media/4d0263_63b8c651a249480a848671da01f28dcf~mv2.png/v1/fill/w_416,h_204,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/museums-for-all-logo_rgb.png 2x" id="img_comp-k4rj0nw0" src="https://static.wixstatic.com/media/4d0263_63b8c651a249480a848671da01f28dcf~mv2.png/v1/fill/w_208,h_102,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/museums-for-all-logo_rgb.png" alt="museums-for-all-logo_rgb.png" style="object-fit:cover" class="gRkIq0 sFiSiq" width="208" height="102"/></div></div><div id="comp-k4rizln4" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4rizln4 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:14px; line-height:1.3em;"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">BVM provides discounted admission for those currently receiving&nbsp;SNAP food assistance benefits. Simply present your valid EBT card and photo ID at the front desk for&nbsp;</span></span></span><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">$2 admission each for up to 4&nbsp;individuals per EBT card.</span></span></span><span style="font-size:6px;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">​</span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:14px; line-height:1.3em;"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-size:6px;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text"><span class="wixGuard wixui-rich-text__text">​</span></span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:14px; line-height:1.3em;"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">Click <span style="text-decoration:underline;" class="wixui-rich-text__text"><a href="https://museums4all.org" target="_blank" class="wixui-rich-text__text">here</a></span> for more information about Museums For All.</span></span></span></span></p></div></div></div></div><div id="comp-k4rj1d76" class="e_a0EV comp-k4rj1d76"><div class="gyovE9 wixui-box" data-testid="container-bg"></div><div data-mesh-id="comp-k4rj1d76inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-k4rj1d76inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-k4x15jhr" class="W4V2qg comp-k4x15jhr wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="210px" srcSet="https://static.wixstatic.com/media/4d0263_42dc99eb36bf4939899ea04d0046c3dc~mv2.png/v1/fill/w_210,h_88,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/vsa-and-astc-logos-vertical_edited_edite.png 1x, https://static.wixstatic.com/media/4d0263_42dc99eb36bf4939899ea04d0046c3dc~mv2.png/v1/fill/w_334,h_140,al_c,lg_1,q_85,enc_avif,quality_auto/vsa-and-astc-logos-vertical_edited_edite.png 2x" id="img_comp-k4x15jhr" src="https://static.wixstatic.com/media/4d0263_42dc99eb36bf4939899ea04d0046c3dc~mv2.png/v1/fill/w_210,h_88,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/vsa-and-astc-logos-vertical_edited_edite.png" alt="vsa-and-astc-logos-vertical_edited_edite" style="object-fit:cover" class="gRkIq0 sFiSiq" width="210" height="88"/></div></div><div id="comp-k4rj1d9l" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-k4rj1d9l wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:14px; line-height:1.7em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">BVM is a proud member of the ASTC Travel Passport Program.&nbsp; If you are member of one of the hundreds of science centers or museums participating in the ASTC Travel Passport Program, you may be eligible for free general admission to BVM. Some exclusions apply.</span></span></span><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">​</span></span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:14px; line-height:1.7em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">​</span></span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:14px; line-height:1.7em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text">Click <span style="text-decoration:underline;" class="wixui-rich-text__text"><a href="https://www.astc.org/passport/" target="_blank" rel="noreferrer noopener" class="wixui-rich-text__text">here</a></span> for more information about the ASTC Travel Passport Program.</span></span></span></span></span></p></div></div></div></div><div id="comp-k4rjjzh9" class="e_a0EV comp-k4rjjzh9"><div class="gyovE9 wixui-box" data-testid="container-bg"></div><div data-mesh-id="comp-k4rjjzh9inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-k4rjjzh9inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-k571c8bw" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k571c8bw wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:27px;"><span class="color_28 wixui-rich-text__text"><span style="font-size:27px;" class="wixui-rich-text__text"><span style="font-style:italic;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text">Members Visit Free!</span></span></span></span></span></h2></div><div class="comp-k571dwt6 mu5PoX" id="comp-k571dwt6" aria-disabled="false"><a data-testid="linkElement" href="https://www.buenavistamuseum.org/memberships" target="_self" class="twJknM wixui-button ZhVEJq" aria-disabled="false" aria-label="Learn More"><span class="OR4Nv8 wixui-button__label">Learn More</span></a></div><div id="comp-k4rjvfaw" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4rjvfaw wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:27px;"><span class="color_28 wixui-rich-text__text"><span style="font-size:27px;" class="wixui-rich-text__text"><span style="font-style:italic;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text">Reduced Price Days</span></span></span></span></span></h2></div><div id="comp-k4rjywpm" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4rjywpm wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:19px; line-height:1.3em;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:19px;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text">Family Days</span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:8px; line-height:1.3em;"><span style="font-size:8px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text"><span class="wixGuard wixui-rich-text__text">​</span></span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.3em;"><span style="font-size:16px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:brandon-grot-w01-light,sans-serif;" class="wixui-rich-text__text">The first&nbsp;Saturday of each month is Family Day!&nbsp; Admission for 2 adults and up to 6 children is&nbsp;only $20!</span></span></span></span></p></div><div id="comp-k4rk5585" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4rk5585 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:19px; line-height:1.3em;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:19px;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text">Senior Days</span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:8px; line-height:1.3em;"><span style="font-size:8px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text"><span class="wixGuard wixui-rich-text__text">​</span></span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.3em;"><span style="font-size:16px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:brandon-grot-w01-light,sans-serif;" class="wixui-rich-text__text">The second&nbsp;Saturday of each month is Seniors&nbsp;Day!&nbsp; Admission for Seniors (60+) is&nbsp;only $2!</span></span></span></span></p></div><div id="comp-k4rk7c8g" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4rk7c8g wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:19px; line-height:1.3em;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:19px;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text">$2 Days</span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:8px; line-height:1.3em;"><span style="font-size:8px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text"><span class="wixGuard wixui-rich-text__text">​</span></span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.3em;"><span style="font-size:16px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:brandon-grot-w01-light,sans-serif;" class="wixui-rich-text__text">The third Thursday day of each month is $2 Day!&nbsp; All day, all ages admission is only $2!</span></span></span></span></p></div><div id="comp-k4rkcdff" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4rkcdff wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:27px;"><span class="color_28 wixui-rich-text__text"><span style="font-size:27px;" class="wixui-rich-text__text"><span style="font-style:italic;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text">Group Rates</span></span></span></span></span></h2></div><div id="comp-k4rkev9u" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-k4rkev9u wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:19px; line-height:1.3em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:19px;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text">Student Group Rates</span></span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="line-height:1.4em; font-size:15px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text">Students: $4.00, c</span></span></span><span style="color:#242323;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text">haperones, teachers and parents: $7.00. For more information on school tours click <span style="text-decoration:underline;" class="wixui-rich-text__text"><a href="https://www.buenavistamuseum.org/school-tours" target="_self" class="wixui-rich-text__text">here</a></span></span></span></span></span></p></div><div id="comp-k4rkx72n" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-k4rkx72n wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:19px; line-height:1.3em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:19px;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text">Adult Group Rates</span></span></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="line-height:1.4em; font-size:15px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text">Groups of 20 or more adults: $7.00 each. Click <span style="text-decoration:underline;" class="wixui-rich-text__text"><a href="https://www.buenavistamuseum.org/school-tours" target="_self" class="wixui-rich-text__text">here</a></span> for more information on group tours.</span></span></span></span></p></div><div id="comp-k4rl83o7" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4rl83o7 wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:27px;"><span class="color_28 wixui-rich-text__text"><span style="font-size:27px;" class="wixui-rich-text__text"><span style="font-style:italic;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:raleway-semibold,raleway,sans-serif;" class="wixui-rich-text__text">Reciprocal Admission</span></span></span></span></span></h2></div><div id="comp-k4rl83pg" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-k4rl83pg wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:15px; line-height:1.3em;"><span style="font-size:15px;" class="wixui-rich-text__text"><span style="color:#242323;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text">Members of other local and reciprocal institutions may be eligible for free admission to BVM. Current partners include:</span></span></span></span></p></div><div id="comp-k4rlgue0" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-k4rlgue0 wixui-rich-text" data-testid="richTe