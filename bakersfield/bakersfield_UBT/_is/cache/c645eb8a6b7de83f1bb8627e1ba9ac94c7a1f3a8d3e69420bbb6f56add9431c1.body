    classToggler.init();
    tabNav.init();
    document.querySelectorAll("img[data-lazyload]").forEach((img) => {
        lazyInit(img, () => {
            img.srcset = img.dataset.lazyload;
        });
    });
    document.querySelectorAll("img[data-lazyload-src]").forEach((img) => {
        lazyInit(img, () => {
            img.src = img.dataset.lazyloadSrc;
        });
    });
</script>

 

