        <script type="text/javascript">
            jQuery(document).ready(function() {
                // Collapse events for every month except the first one
                jQuery('#bd833abf9406ce238ac4829bac39298c7469a9eaf0d47 ul.month-section li.gamebar-event').hide();
                jQuery('#bd833abf9406ce238ac4829bac39298c7469a9eaf0d47 ul.month-section li.monthly-header i').not(':first').attr('data-av_icon', '');
                jQuery('#bd833abf9406ce238ac4829bac39298c7469a9eaf0d47 ul.month-section:first li.gamebar-event').show();
                jQuery('#bd833abf9406ce238ac4829bac39298c7469a9eaf0d47 ul.month-section').on('click', function() {
                    jQuery(this).find('li.gamebar-event').toggle();

                    // Swap the caret icons
                    var icon = jQuery(this).find('li.monthly-header i');
                    if (jQuery(icon).attr('data-av_icon') === '') {
                        jQuery(icon).attr('data-av_icon', '');
                    } else {
                        jQuery(icon).attr('data-av_icon', '');
                    }
                });
            });
        </script>
        </div></div>
