: 991px) 728px, 794px" alt="" srcset="https://cdn.prod.website-files.com/661331a16ae219cdee2b9f4c/67523d7bdf277649a8fdbdce_new-fox-bakers-logo-p-500.png 500w, https://cdn.prod.website-files.com/661331a16ae219cdee2b9f4c/67523d7bdf277649a8fdbdce_new-fox-bakers-logo.png 794w" class="logo-top"/></a><nav role="navigation" class="nav-menu w-nav-menu"><a href="/event-calendar" class="links nav hide w-nav-link">Calendar</a><div data-hover="true" data-delay="0" class="dropdown w-dropdown"><div class="dropdown-toggle w-dropdown-toggle"><div class="icon w-icon-dropdown-toggle"></div><div class="links nav">Fox Theater</div></div><nav class="dropdown-list w-dropdown-list"><a href="/the-fox-theater" class="links nav menu w-dropdown-link">About</a><div class="w-dyn-list"><div role="list" class="w-dyn-items"><div role="listitem" class="w-dyn-item"><a href="https://cdn.prod.website-files.com/661331a16ae219cdee2b9f6e/69974d1af013ac2c51e7e3d4_2025%20Production%20Pack%20(1).pdf" class="links nav menu w-dropdown-link">Production Pack</a></div></div></div><a href="/fox-theater-seating-map" class="links nav menu w-dropdown-link">Seating Map</a><a href="/the-fox-experience" class="links nav menu w-dropdown-link">Experience</a><a href="/the-fox-theater-policies" class="links nav menu w-dropdown-link">Venue Policies</a></nav></div><div data-hover="true" data-delay="0" class="dropdown w-dropdown"><div class="dropdown-toggle w-dropdown-toggle"><div class="icon w-icon-dropdown-toggle"></div><div class="links nav">Nile Theater</div></div><nav class="dropdown-list w-dropdown-list"><a href="/the-nile-theater" class="links nav menu w-dropdown-link">About</a><div class="w-dyn-list"><div role="list" class="w-dyn-items"><div role="listitem" class="w-dyn-item"><a href="https://cdn.prod.website-files.com/661331a16ae219cdee2b9f6e/699c9c91f3b821178f1ba9ae_Nile%20production%20pack%202026%20(2).pdf" target="_blank" rel="www.bakersfieldlive.com/pdfs/nile-production-pack-pdf" class="links nav menu w-dropdown-link">Production Pack</a></div></div></div><a href="/the-nile-theater-policies" class="links nav menu w-dropdown-link">Venue Policies</a></nav></div><a href="/rental-information" class="links nav w-nav-link">venue Rental</a><div data-hover="false" data-delay="0" class="dropdown w-dropdown"><div class="dropdown-toggle w-dropdown-toggle"><div class="icon w-icon-dropdown-toggle"></div><div class="links nav">history</div></div><nav class="dropdown-list w-dropdown-list"><a href="/memories-on-h" class="links nav menu w-dropdown-link">Memories on H</a><a href="/edward-w-winslow" class="links nav menu w-dropdown-link">edward W. winslow collection</a></nav></div><a href="/the-foundation" class="links nav w-nav-link">the foundation</a><a href="#" class="links nav hide w-nav-link">live Streams</a><a href="#" class="links nav hide w-nav-link">gallery</a><a href="/contact" aria-current="page" class="links nav w-nav-link w--current">contact</a><a href="https://bakersfieldfoxtheater.networkforgood.com/" target="_blank" rel="https://bakersfieldfoxtheater.networkforgood.com/projects/190850-the-next-100-years" class="links nav w-nav-link">donate</a><a href="https://thebakersfieldfox.square.site/" target="_blank" class="links nav w-nav-link">merch</a><div class="socials hide"><a href="https://www.facebook.com/thefoxtheaterbakersfield" target="_blank" class="links nav social w-nav-link"></a><a href="https://www.instagram.com/historicbakersfieldfox/" target="_blank" class="links nav social w-nav-link"></a><a href="https://twitter.com/foxfndn" target="_blank" class="links nav social w-nav-link"></a></div></nav><a href="/event-calendar" class="button-main tickets w-inline-block"><div class="get-tix">EVENT CALENDAR</div></a></div><div data-w-id="d1d6146f-4b4e-cd09-d4cb-b4208628d98e" class="open-ham"></div></div><div class="page-header-section"><div class="content radial-grade"><h1 class="headline">contact us</h1></div><div class="parrallax-bg gallery"><div class="w-dyn-list"><div role="list" class="w-dyn-items"><div role="listitem" class="w-dyn-item"><img loading="lazy" width="797" alt="" src="https://cdn.prod.website-files.com/661331a16ae219cdee2b9f6e/66314aa201ac20cf66939b81_contact.jpg" sizes="(max-width: 991px) 100vw, 797px" srcset="https://cdn.prod.website-files.com/661331a16ae219cdee2b9f6e/66314aa201ac20cf66939b81_contact-p-500.jpg 500w, https://cdn.prod.website-files.com/661331a16ae219cdee2b9f6e/66314aa201ac20cf66939b81_contact-p-800.jpg 800w, https://cdn.prod.website-files.com/661331a16ae219cdee2b9f6e/66314aa201ac20cf66939b81_contact-p-1080.jpg 1080w, https://cdn.prod.website-files.com/661331a16ae219cdee2b9f6e/66314aa201ac20cf66939b81_contact-p-1600.jpg 1600w, https://cdn.prod.website-files.com/661331a16ae219cdee2b9f6e/66314aa201ac20cf66939b81_contact.jpg 1920w" class="header-img"/></div></div></div></div></div><div class="grade"></div><section id="contact-form" class="contact-form"><div class="white-container form w-container"><div class="header"><div class="headline-2 normal">fox &amp; nile theaters Box Office</div><div class="text-block-49"><br/>The Historic Bakersfield Fox Theater opened its doors in 1930 and since then has hosted a variety of community events, such as ballets, concerts, film festivals, school graduations, business conferences, church events, dance recitals, comedy shows, pageants, and more!<br/><br/>Ticket window located at: <strong>1700 20th Street Bakersfield, CA 93301</strong><br/>Or reach our box office via phone at <a href="tel:+1(661)324-1369">(661) 324-1369</a><br/><strong>Hours of operation: 10:00am – 1:00pm. </strong><br/><br/>For general questions or help with an order, please email us at <a href="mailto:info@thebakersfieldfox.com?subject=Tickets%20Questions">info@thebakersfieldfox.com</a>.<br/>‍<br/>Extended hours on show nights - Closed all major holidays<br/><a href="#">More Info</a></div></div><div class="header"><div class="headline-2 normal">event booking info</div><div class="text-block-49">2001 H Street<br/>Bakersfield, CA 93301<br/>‍<br/><a href="/rental-information">Click here for venue rental Information.</a></div></div><div id="contact-us" class="form-block-2 w-form"><form id="wf-form-Contact" name="wf-form-Contact-Form" data-name="Contact Form" method="get" data-wf-page-id="661331a16ae219cdee2b9f88" data-wf-element-id="5ddb5be1-f9ed-b07b-09f5-d77dc4e208d4" data-turnstile-sitekey="0x4AAAAAAAQTptj2So4dx43e"><div class="contact-form-grid"><div id="w-node-_9f737e6a-77ef-c101-67d8-22357714b4e4-ee2b9f88"><label id="contact-first-name" for="Reason" class="label left">Select your reason for contacting us:</label><select id="Reason" name="Reason" data-name="Reason" required="" class="select-field w-select"><option value="">* Select a Reason</option><option value="General Inquiries">General Inquiries</option><option value="Ticketing">Ticketing</option><option value="Rental">Rental Info</option><option value="Customer Service ">Customer Service </option><option value="Foundation">Contact Foundation</option></select></div><div id="w-node-_5ddb5be1-f9ed-b07b-09f5-d77dc4e208d6-ee2b9f88" class="form-div"><label id="contact-first-name" for="First-Name" class="label left">First name *</label><input class="field w-input" maxlength="256" name="First-Name" data-name="First Name" placeholder="" type="text" id="First-Name" required=""/></div><div id="w-node-_5ddb5be1-f9ed-b07b-09f5-d77dc4e208da-ee2b9f88" class="form-div"><label id="contact-last-name" for="Last-Name" class="label left">Last name *</label><input class="field w-input" maxlength="256" name="Last-Name" data-name="Last Name" placeholder="" type="text" id="Last-Name" required=""/></div><div id="w-node-_5ddb5be1-f9ed-b07b-09f5-d77dc4e208de-ee2b9f88" class="form-div"><label id="contact-email" for="Email" class="label left">Email *</label><input class="field w-input" maxlength="256" name="Email" data-name="Email" placeholder="" type="email" id="Email" required=""/></div><div id="w-node-_5ddb5be1-f9ed-b07b-09f5-d77dc4e20