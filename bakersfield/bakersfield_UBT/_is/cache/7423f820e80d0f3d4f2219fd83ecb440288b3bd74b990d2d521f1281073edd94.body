<div class='accordion-item' id='MortalityData' data-index='4'><div class='accordion-heading' tabindex='0' aria-expanded='true' role='button'><div class='title'>Mortality Data</div><div class='icon'><i class='arrow right' role='presentation'></i></div></div>
<div class='accordion-content' aria-hidden='true' visibility='hidden'><div class='inner-content'><iframe title="Kern County Mortality Dashboard" style="width: 100%; height: 600px; margin: 0; outline: none;" src="https://app.powerbigov.us/view?r=eyJrIjoiZDc5YTA1NmQtZjJjYi00OWJhLWFmNzgtYWJjZjViYmU1YzBlIiwidCI6ImUwZjJlNGI1LTA1MTUtNDAyOC05OWYyLTJlN2E0M2ZlNTM3OSJ9" allowfullscreen="" frameborder="0">Your browser does not support inline frames.<br />
