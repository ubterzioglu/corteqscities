    <script>
    // Function to handle scrolling to an element
    function scrollToElement(element) {
        $('html, body').animate({
            scrollTop: element.offset().top
        }, 500);
    }
    
    // Event handler for continuation links
    $('.continuation-link').click(function(e) {
        e.preventDefault();
        
        // Find the closest anchor tag and get its data
        var evTarget = $(e.target).closest('a');
        var continuationId = evTarget.attr('data-guid');
        var shouldScroll = evTarget.is('[data-scroll]');
        
        // Find the target continuation element
        var continuationObj = $('#' + continuationId);
        
        // Check if the target element exists
        if (continuationObj.length === 0) {
            console.error('Target continuation element not found');
            return;
        }
        
        // Handle inline display
        if (evTarget.hasClass('show-inline')) {
            continuationObj.css('display', 'inline');
            evTarget.hide();
            
            if (shouldScroll) {
                scrollToElement(continuationObj);
            }
        } 
        // Handle slide down display
        else {
            continuationObj.slideDown('slow', function() {
                evTarget.hide();
                
                if (shouldScroll) {
                    scrollToElement(continuationObj);
                }
            });
        }
    });
    </script>
