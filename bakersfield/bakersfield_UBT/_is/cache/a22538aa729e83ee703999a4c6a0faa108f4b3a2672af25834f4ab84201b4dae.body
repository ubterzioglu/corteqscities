<div class="cmp-teaser__content">
 
 
     


    <h2 class="cmp-teaser__title">
        Community organizations and advocates
    </h2>

  
 

	
    	
	
	
	
	



<div class="cmp-teaser__description"><p>Are you seeking information to support members of your community with their energy bills?</p>
<p> </p>
<p>Access tools and resources to aid your outreach efforts.</p>
</div>
 




<div class="cmp-teaser__action-container">


	
		
		
			<a href="/en/save-energy-and-money/energy-saving-programs/community-organizations-advocates.html" aria-label="Community organizations and advocates" class="cmp-teaser__action-link">Explore solutions 
	         	 
	    	</a>
		
		
	







    </div>

</div>
</div>

    

</div>
<div class="card-feature-tile-informational aem-GridColumn aem-GridColumn--default--12">
    <div class="column-tiles-wrapper column-tiles--card-feature">
        <div class="column-tiles__title-description">
            <h2 class="column-tiles__title">Financial assistance for your business</h2>
            
        </div>
        <div class="column-tiles__col-wrapper">
            
                <div class="column-tiles__column">
                    <div class="column-tiles__item">
                        <div class="column-tiles__item-title">
                            <h3 class="column-tiles__item-heading">Economic Development Rate (EDR)</h3>
                        </div>
                        <div class="column-tiles__item-text"><ul><li>Enroll your business in an EDR.</li><li>Get 12%, 18%, or 25% discounts on most of your electric costs for five years.</li></ul>
</div>
                        
                            
                                
                                    <div class="button button--link-primary">
                                        <a class="cmp-button" href="/en/business-resources/economic-development/economic-development-rate.html" target="_self" aria-label="Explore PG&amp;E&#39;s EDRs">
                                             <!-- <i data-sly-test="/content/pge/language-masters/en/business-resources/economic-development/economic-development-rate.html" class="icon icon--arrow-right" aria-hidden="true">
                              </i> -->
                                            <span class="cmp-button__text">Explore PG&amp;E&#39;s EDRs</span>
                                            
											<i class="icon icon--arrow-right sb-icon sb-icon--arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                
                            
                        
                        
                        
                    </div>
                </div>
            
                <div class="column-tiles__column">
                    <div class="column-tiles__item">
                        <div class="column-tiles__item-title">
                            <h3 class="column-tiles__item-heading">Energy management tips</h3>
                        </div>
                        <div class="column-tiles__item-text"><p>Find no-cost and low-cost tips to improve energy efficiency and save money.</p>
</div>
                        
                            
                                
                                    <div class="button button--link-primary">
                                        <a class="cmp-button" href="/assets/pge/docs/save-energy-and-money/energy-usage-tips/No-cost-and-low-cost-energy-management-tips.pdf" target="_blank" aria-label="Download your guide (PDF)">
                                             <!-- <i data-sly-test="/content/dam/pge/docs/save-energy-and-money/energy-usage-tips/No-cost-and-low-cost-energy-management-tips.pdf" class="icon icon--arrow-right" aria-hidden="true">
                              </i> -->
                                            <span class="cmp-button__text">Download your guide (PDF)</span>
                                            
											<i class="icon icon--arrow-right sb-icon sb-icon--arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                
                            
                        
                        
                        
                    </div>
                </div>
            
        </div>
    </div>


    

</div>
<div class="card-feature-tile-informational aem-GridColumn aem-GridColumn--default--12">
    <div class="column-tiles-wrapper column-tiles--informational" id="moreassistance">
        <div class="column-tiles__title-description">
            <h2 class="column-tiles__title">More financial assistance</h2>
            
        </div>
        <div class="column-tiles__col-wrapper">
            
                <div class="column-tiles__column">
                    <div class="column-tiles__item">
                        <div class="column-tiles__item-title">
                            <h3 class="column-tiles__item-heading">Discounted phone service</h3>
                        </div>
                        <div class="column-tiles__item-text"><p><a id="morefinanceresources"></a>You may qualify for discounted phone service. California LifeLine is based on your income level or program participation.</p>
</div>
                        
                            
                                
                                    <div class="button button--link-primary">
                                        <a class="cmp-button" href="https://www.californialifeline.com/en" target="_blank" aria-label="Visit California LifeLine">
                                             <!-- <i data-sly-test="https://www.californialifeline.com/en" class="icon icon--arrow-right" aria-hidden="true">
                              </i> -->
                                            <span class="cmp-button__text">Visit California LifeLine</span>
                                            
											<i class="icon icon--arrow-right sb-icon sb-icon--arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                
                            
                        
                        
                        
                    </div>
                </div>
            
                <div class="column-tiles__column">
                    <div class="column-tiles__item">
                        <div class="column-tiles__item-title">
                            <h3 class="column-tiles__item-heading">Low-Cost Home Internet</h3>
                        </div>
                        <div class="column-tiles__item-text"><p>Some Internet Service Providers (ISPs) offer discounted broadband plans for eligible customers, based on household income, participation in assistance programs, and more.</p>
<p> </p>
<p>Call <a href="tel:1-844-926-4106">1-844-926-4106</a> for more information about providers in your area.</p>
</div>
                        
                        
                        
                    </div>
                </div>
            
                <div class="column-tiles__column">
                    <div class="column-tiles__item">
                        <div class="column-tiles__item-title">
                            <h3 class="column-tiles__item-heading">Budget Billing</h3>
                        </div>
                        <div class="column-tiles__item-text"><p>Predictable monthly energy costs help budget your expenses. Budget Billing helps offset peak bills that result from:</p>
<ul><li>High winter heating</li><li>Summer air conditioning</li></ul>
</div>
                        
                            
                                
                                    <div class="button button--link-primary">
                                        <a class="cmp-button" href="/en/account/billing-and-assistance/financial-assistance/budget-billing-program.html" target="_self" aria-label="Go to Budget Billing">
                                             <!-- <i data-sly-test="/content/pge/language-masters/en/account/billing-and-assistance/financial-assistance/budget-billing-program.html" class="icon icon--arrow-right" aria-hidden="true">
                              </i> -->
                                            <span class="cmp-button__text">Go to Budget Billing</span>
                                            
											<i class="icon icon--arrow-right sb-icon sb-icon--arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                
                            
                        
                        
                        
                    </div>
                </div>
            
        </div>
    </div>


    

</div>
