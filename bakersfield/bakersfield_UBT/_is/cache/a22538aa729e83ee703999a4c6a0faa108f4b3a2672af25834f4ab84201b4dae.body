<div class="teaser-image teaser teaser-media-image--first background-gray-0 secondarybutton aem-GridColumn aem-GridColumn--default--12">
<div id="teaser-07052a2f9b" class="cmp-teaser" data-cmp-data-layer="{&#34;teaser-07052a2f9b&#34;:{&#34;@type&#34;:&#34;core/wcm/components/teaser/v1/teaser&#34;,&#34;repo:modifyDate&#34;:&#34;2025-10-23T23:38:30Z&#34;,&#34;dc:title&#34;:&#34;Community organizations and advocates&#34;,&#34;dc:description&#34;:&#34;&lt;p>Are you seeking information to support members of your community with their energy bills?&lt;/p>\r\n&lt;p>&amp;nbsp;&lt;/p>\r\n&lt;p>Access tools and resources to aid your outreach efforts.&lt;/p>\r\n&#34;}}">

    <div class="cmp-teaser__image">
