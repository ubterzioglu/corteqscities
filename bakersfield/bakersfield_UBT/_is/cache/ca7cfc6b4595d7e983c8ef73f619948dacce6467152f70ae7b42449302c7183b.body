                        break;
                    case "stumbleupon":
                        shareUrl = "http://www.stumbleupon.com/submit?url=https%3a%2f%2fwww.kernbhrs.org%2fservices%2fcrisis-services&title=" + shareTitle;
                        break;
                    case "digg":
