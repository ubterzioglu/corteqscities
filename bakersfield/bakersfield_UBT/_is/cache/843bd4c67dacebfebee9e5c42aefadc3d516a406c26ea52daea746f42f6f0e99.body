         <div class="hero image-bg-container-sm bg-white-color-1">
            <div class="bg-element-top-gradient"></div>
            <div class="image-bg-sm image-bg-overlay" style="background-image: url('https://www.csub.edu/art/_images/Todd-Madigan-Gallery-image.jpg'); background-size: cover; background-repeat: no-repeat"></div>
