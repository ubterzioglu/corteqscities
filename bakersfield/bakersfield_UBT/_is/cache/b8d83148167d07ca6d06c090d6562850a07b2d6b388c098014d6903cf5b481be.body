      .nuxt-progress {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        width: 0%;
        opacity: 1;
        transition: width .1s, opacity .4s;
        background-color: #666;
        z-index: 999999
      }
    
      .nuxt-progress.nuxt-progress-notransition {
        transition: none
      }
    
      .nuxt-progress-failed {
        background-color: red
      }
    
      .page-enter-active,
      .page-leave-active {
        transition: opacity .25s
      }
    
      .page-enter,
      .page-leave-to {
        opacity: 0
      }
    
      #skip-to-content {
        position: absolute;
        z-index: 999999999;
        top: .5rem;
        left: .5rem;
        transform: translateY(-200%)
      }
    
      #skip-to-content:focus {
        transform: none
      }
    
      .cta-button {
        background: var(--calfresh-red, var(--wireframe-4));
        text-transform: uppercase;
        border-radius: 1rem 0;
        color: #fff;
        padding: 1rem 2rem;
        text-decoration: none;
        font-weight: 700;
        position: relative;
        display: inline-flex;
        align-items: baseline;
        overflow: hidden
      }
    
      .cta-button[disabled] {
        background: #ddd;
        color: gray
      }
    
      .cta-button.light {
        background-color: #fff;
        color: var(--calfresh-dark-green)
      }
    
      .cta-button.light.outline {
        border-color: #fff !important;
        color: #fff !important
      }
    
      .cta-button.outline {
        background: rgba(0, 0, 0, 0);
        border-radius: .75rem 0;
        border: 3px solid var(--calfresh-dark-green);
        color: var(--calfresh-dark-green)
      }
    
      .cta-button span+i {
        margin-left: 1rem
      }
    
      [data-whatintent=keyboard] .cta-button:focus,
      [data-whatintent=mouse] .cta-button:hover,
      [data-whatintent=touch] .cta-button:active {
        text-decoration: none
      }
    
      .layout-header{position:sticky;z-index:9001;top:0;background-color:#fff;height:var(--base-header-height);display:flex;flex-direction:row;padding:0 2rem}
@media(min-width:48rem){.layout-header{gap:var(--base-gap);padding:1rem 5rem}}
.layout-header>div{align-items:center}
.layout-header__logo{display:flex}
.layout-header__logo a,.layout-header__logo img{width:12rem;height:calc(var(--base-header-height) - 1.5rem)}
@media(min-width:64rem){.layout-header__logo a,.layout-header__logo img{width:100%}}
.layout-header__nav{display:none}
@media(min-width:48rem){.layout-header__nav{margin-left:var(--base-large-gap);display:flex;flex-direction:row;gap:var(--base-large-gap)}.layout-header__nav .nuxt-link-exact-active{color:var(--calfresh-pine-green)}.layout-header__nav a,.layout-header__nav button{font-size:2.5rem;font-weight:700;color:var(--calfresh-dark-green);cursor:pointer}.layout-header__nav a:hover,.layout-header__nav button:hover{text-decoration:none}}
.layout-header__nav .nav-dropdown ul{left:0;width:30rem;border:2px solid #000}
.layout-header__nav .nav-dropdown ul li a{font-weight:700;color:var(--calfresh-dark-green)}
.layout-header__nav .nav-dropdown ul li a.nuxt-link-exact-active{color:var(--calfresh-pine-green)}
.layout-header__right{display:flex;flex:1;justify-content:flex-start;flex-direction:row-reverse;gap:var(--base-gap)}
@media(min-width:48rem){.layout-header__right{justify-content:flex-end;flex-direction:row;gap:var(--base-large-gap)}.layout-header__right .cta-button{text-align:center}}
.layout-header__right--mobile{display:flex}
.layout-header__right--mobile i{font-size:4rem;color:var(--calfresh-maroon)}
@media(min-width:48rem){.layout-header__right--mobile{display:none}}
.layout-header__right--lang{display:none}
@media(min-width:48rem){.layout-header__right--lang{display:flex}}
.nav{position:relative;text-align:center}
.nav__toggle{display:flex;flex-direction:column;justify-content:center;height:5rem;width:5rem;position:absolute;bottom:100%;right:-1.25rem}
@media(min-width:48rem){.nav__toggle{display:none}}
.nav__toggle span{background:var(--wireframe-4);display:block;width:2.5rem;height:2px;border-radius:1px;position:absolute;left:1.25rem;pointer-events:none}
.nav__toggle span.top-bar{top:calc(50% - 3px - .5rem)}
.nav__toggle span.bottom-bar{top:calc(50% + 1px + .5rem)}
.nav__toggle span.middle-bar{top:calc(50% - 1px)}
.nav__toggle--close-button span.top-bar{transform:translateY(calc(.5rem + 2px)) rotate(45deg)}
.nav__toggle--close-button span.bottom-bar{transform:translateY(calc(-.5rem - 2px)) rotate(-45deg)}
.nav__toggle--close-button span.middle-bar{opacity:0}
.nav__list{padding-bottom:0}
@media(max-width:47.98rem){.nav__list{padding-top:2rem}}
@media(min-width:48rem){.nav__list{display:flex}}
@media(min-width:48rem){.nav__list-item{position:relative}.nav__list-item:not(:first-child){margin-left:var(--base-gap)}}
.nav__list-item>*{font-size:2.5rem;font-weight:700;color:var(--base-text-color)}
@media(max-width:47.98rem){.nav__list-item>*{padding:1rem 0;display:block}}
[data-whatintent=keyboard] .nav__list-item>:focus,[data-whatintent=mouse] .nav__list-item>:hover,[data-whatintent=touch] .nav__list-item>:active{color:var(--aocs-magenta);text-decoration:none}
.nav__list-item>* i{margin-left:.25rem}
.nav .nuxt-link-active{color:var(--aocs-magenta)}
.nav-dropdown{display:inline-block; position: relative;}
.nav-dropdown button{color:var(--base-text-color)}
@media(max-width:47.98rem){.nav-dropdown button{width:100%;cursor:auto}}
@media(min-width:48rem){[data-whatintent=keyboard] .nav-dropdown button:focus,[data-whatintent=mouse] .nav-dropdown button:hover,[data-whatintent=touch] .nav-dropdown button:active{color:var(--aocs-magenta);text-decoration:none}}
.nav-dropdown button i{margin-left:.25rem}
@media(max-width:47.98rem){.nav-dropdown button i{display:none}}
@media(min-width:48rem){.nav-dropdown button i{transition:transform .125s}}
.nav-dropdown button i.icon-is-flipped{transform:rotate(-180deg)}
.nav-dropdown ul{margin-top:.5rem; display: none;}
@media(min-width:48rem){.nav-dropdown ul{position:absolute;top:calc(100% + 1rem);left:-2rem;z-index:9;width:25rem;background:#fff;padding:1.5rem;text-align:left;box-shadow:0 .5rem 1rem rgba(0,0,0,.18)}}
.nav-dropdown.is-open ul { display: block; }
.nav-dropdown li{padding:.5rem}
.nav-dropdown a{font-weight:400;color:var(--base-text-color);display:block}
@media(min-width:48rem){.slide-up-enter-active,.slide-up-leave-active{transition:transform .125s,opacity .125s}.slide-up-enter,.slide-up-leave-to{transform:translateY(1rem);opacity:0}}
.base-icon{color:inherit}
.site-language-select{border:none;font-size:3rem;text-align:center}
@media(min-width:48rem){.site-language-select{font-size:2rem}}
body.menu-open{overflow:hidden}
.layout-mobile-menu{ display:none;position:fixed;overflow-y:scroll;top:0;bottom:0;right:0;left:0;width:90vw;background-color:#fff;box-shadow:-3px 0 10px -3px rgba(0,0,0,.55);padding:var(--base-gap);z-index:9002}
.layout-mobile-menu.open{ display:flex;}
.layout-mobile-menu__control i{font-size:5rem}
.layout-mobile-menu__navigation{display:flex;flex-direction:column;align-self:flex-start}
.layout-mobile-menu__navigation ul li{margin-bottom:4rem}
.layout-mobile-menu__navigation ul li a{color:var(--calfresh-dark-green);font-size:3rem;font-weight:700}
.layout-mobile-menu__navigation ul li a.nuxt-link-exact-active{color:var(--calfresh-pine-green)}
.layout-mobile-menu__navigation ul li:first-of-type{margin-top:4rem}
.layout-mobile-menu__bottom{display:flex;flex-direction:column;flex:1;width:100%;justify-content:flex-end}
.layout-mobile-menu__bottom--cta{display:flex;width:100%;gap:var(--base-gap);align-self:center}
.layout-mobile-menu__bottom--cta .cta-button{width:100%;justify-content:center}
.layout-mobile-menu__bottom--lang{display:flex;align-self:center}
.layout-mobile-menu__bottom--cta,.layout-mobile-menu__bottom--lang{padding-top:1rem;padding-bottom:1rem}
    
      .site-video-hero {
        position: relative;
        min-height: calc(100vh - var(--base-header-height))
      }
    
      .site-video-hero video,
      .site-video-hero__copy,
      .site-video-hero__overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        aspect-ratio: 16/9
      }
    
      .site-video-hero__overlay {
        background: linear-gradient(180deg, rgba(0, 0, 0, 0) 18.3%, rgba(0, 0, 0, .8) 100%);
        mix-blend-mode: multiply
      }
    
      .site-video-hero__copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--base-gap);
        padding: 0 3rem;
        text-align: center
      }
    
      @media(min-width:75rem) {
        .site-video-hero__copy {
          padding: 0 20rem
        }
      }
    
      .site-video-hero__copy h1 {
        font-weight: 900;
        color: #fff;
        font-size: 5rem;
        text-transform: uppercase
      }
    
      @media(min-width:48rem) {
        .site-video-hero__copy h1 {
          font-size: 6rem
        }
      }
    
      @media(min-width:90rem) {
        .site-video-hero__copy h1 {
          font-size: 10rem
        }
      }
    
      .site-video-hero__copy div {
        border-radius: 2rem 0;
        padding: 2rem
      }
    
      .site-video-hero__copy div.green {
        background-color: var(--calfresh-pine-green)
      }
    
      .site-video-hero__copy div.red {
        background-color: var(--calfresh-red)
      }
    
      @media(min-width:64rem) {
        .site-video-hero__copy div {
          padding: 2rem 5rem
        }
      }
    
      .site-video-hero__copy div h2 {
        color: #fff;
        font-size: var(--h3-font-size)
      }
    
      .site-video-hero__copy--disclaimer {
        color: #fff;
        font-weight: 400;
        font-size: 1.6rem;
        margin-top: var(--base-small-gap);
        padding-bottom: 0
      }
    
      .site-video-hero video {
        object-fit: cover
      }
    
      .include-gaps .container {
        display: flex;
        flex-direction: column;
        gap: var(--section-row-gap)
      }
    
      section[data-section-background=dark] {
        background: var(--dark-bg-color, var(--wireframe-8))
      }
    
      section[data-section-background=off-white] {
        background: var(--off-white-bg-color, var(--wireframe-1))
      }
    
      .eligibility-citizenship-section__questions>div {
        padding: var(--base-gap) 0;
        border-top: 1px solid var(--calfresh-light-green)
      }
    
      .eligibility-citizenship-section__questions>div:first-of-type {
        margin-top: var(--base-gap)
      }
    
      .site-citizenship-section {
        background-color: var(--calfresh-pine-green)
      }
    
      .site-citizenship-section .container {
        display: flex;
        flex-direction: column
      }
    
      .site-citizenship-section p {
        font-size: 2rem;
        font-weight: 500;
        color: #fff
      }
    
      .site-citizenship-section a {
        color: #fff
      }
    
      .site-citizenship-section__status {
        display: flex;
        flex-direction: column-reverse
      }
    
      @media(min-width:48rem) {
        .site-citizenship-section__status {
          flex-direction: row;
          gap: var(--base-gap)
        }
      }
    
      .site-citizenship-section__status--carousel .base-carousel-dot {
        background: var(--calfresh-dark-green);
        width: 1.5rem;
        height: 1.5rem
      }
    
      .site-citizenship-section__status--carousel .base-carousel-dot.active-base-carousel-dot {
        background: #fff
      }
    
      .site-citizenship-section__status--copy {
        display: flex;
        flex-direction: column;
        color: #fff;
        justify-content: center
      }
    
      .site-citizenship-section__status--disclaimer {
        background-color: var(--calfresh-dark-green);
        font-style: italic
      }
    
      .site-citizenship-section__status--disclaimer p {
        padding: 2rem
      }
    
      .site-citizenship-section__status--disclaimer a {
        text-decoration: underline
      }
    
      .site-citizenship-section__status>div {
        display: flex;
        flex: 1
      }
    
      .container {
        position: relative;
        margin: 0 var(--base-container-margin);
        padding: var(--base-container-padding) 0
      }
    
      .base-carousel[data-v-0fe04001] {
        --max-per-row: 0;
        --card-min-width: 0;
        --max-adjustment-scale: 0;
        --minimum-viable-column: min(var(--base-container-width), calc((var(--base-container-max-width) - calc((var(--max-per-row) - 1) * var(--carousel-column-gap))) / calc(var(--max-per-row) + var(--max-adjustment-scale))));
        --centered-grid-margin: calc((100vw - min(var(--base-container-width), var(--card-min-width))) / 2);
        --assigned-column-count: 1
      }
    
      .base-carousel>span {
        display: block;
        width: var(--minimum-viable-column);
        height: 0
      }
    
      .carousel-container {
        column-gap: var(--carousel-column-gap);
        row-gap: var(--carousel-row-gap)
      }
    
      .base-carousel-grid .carousel-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(var(--minimum-viable-column), 1fr))
      }
    
      .uses-assigned-columns .carousel-container {
        grid-template-columns: repeat(var(--assigned-column-count), 1fr)
      }
    
      .x-axis-overflow {
        margin: 0 calc(var(--base-container-margin)*-1)
      }
    
      .x-axis-overflow .carousel-x-axis-controls {
        position: relative
      }
    
      .x-axis-overflow .carousel-x-axis-controls::after,
      .x-axis-overflow .carousel-x-axis-controls::before {
        content: "";
        display: block;
        width: 2rem;
        position: absolute;
        top: 0;
        bottom: 0;
        z-index: 2;
        opacity: 0
      }
    
      .x-axis-overflow .carousel-x-axis-controls::before {
        left: 0;
        background: linear-gradient(to right, var(--wireframe-1) 0, transparent 100%)
      }
    
      .x-axis-overflow .carousel-x-axis-controls::after {
        right: 0;
        background: linear-gradient(to left, var(--wireframe-1) 0, transparent 100%)
      }
    
      .x-axis-overflow .carousel-container {
        overflow-x: scroll;
        display: flex;
        padding-left: var(--base-container-margin);
        min-width: 100%;
        width: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
        position: relative
      }
    
      .x-axis-overflow .carousel-container::after {
        content: "";
        min-width: calc(var(--base-container-margin) - var(--carousel-column-gap))
      }
    
      .x-axis-overflow .carousel-container::-webkit-scrollbar {
        display: none
      }
    
      .x-axis-overflow .carousel-container>* {
        min-width: min(var(--base-container-width), var(--card-min-width));
        flex-grow: 1
      }
    
      .extends-beyond-left-viewport-edge .carousel-x-axis-controls::before {
        opacity: 0
      }
    
      .extends-beyond-right-viewport-edge .carousel-x-axis-controls::after {
        opacity: 0
      }
    
      .uses-scroll-snap .carousel-container {
        scroll-snap-type: x mandatory;
        padding-left: var(--centered-grid-margin)
      }
    
      .uses-scroll-snap .carousel-container::after {
        content: "";
        min-width: calc(var(--centered-grid-margin) - var(--carousel-column-gap))
      }
    
      .uses-scroll-snap .carousel-container>* {
        scroll-snap-align: start;
        scroll-margin-left: var(--centered-grid-margin)
      }
    
      .uses-buttons .carousel-container>* {
        scroll-snap-stop: always
      }
    
      .base-carousel-next-button,
      .base-carousel-prev-button {
        position: absolute;
        top: 0;
        bottom: 0;
        z-index: 10;
        display: flex;
        align-items: center
      }
    
      .base-carousel-prev-button {
        left: 0
      }
    
      .base-carousel-next-button {
        right: 0
      }
    
      .base-carousel-dots {
        display: flex;
        justify-content: center;
        gap: .5rem
      }
    
      .base-carousel-dots[data-dot-position=below] {
        padding-top: var(--base-small-gap)
      }
    
      .base-carousel-dots[data-dot-position=above] {
        padding-bottom: var(--base-small-gap)
      }
    
      .left-aligned-scroll-snap .carousel-container::after {
        content: "";
        min-width: calc(100vw - min(var(--base-container-width), var(--card-min-width)) - var(--base-container-margin) - var(--carousel-column-gap))
      }
    
      .left-aligned-scroll-snap .carousel-container>* {
        scroll-margin-left: var(--base-container-margin);
        scroll-snap-align: start
      }
    
      .eligibility-carousel-card__question {
        text-align: left;
        font-size: 2rem;
        margin: var(--base-gap) 0
      }
    
      .base-carousel-dot {
        border-radius: 50%;
        width: 1rem;
        height: 1rem;
        background: var(--wireframe-8);
        transition: background .25s
      }
    
      [data-section-background=dark] .base-carousel-dot {
        background: #fff
      }
    
      .base-carousel-dot.active-base-carousel-dot {
        background: var(--wireframe-4)
      }
    
      [data-whatintent=keyboard] .base-carousel-dot:focus,
      [data-whatintent=mouse] .base-carousel-dot:hover,
      [data-whatintent=touch] .base-carousel-dot:active {
        background: var(--wireframe-6)
      }
    
      .eligibility-income-section {
        background-color: var(--calfresh-maroon);
        color: #fff
      }
    
      .eligibility-income-section .container {
        display: flex;
        flex-direction: column;
        gap: var(--base-gap)
      }
    
      .eligibility-income-section .container img {
        align-self: center
      }
    
      @media(min-width:48rem) {
        .eligibility-income-section .container img {
          margin-top: 0;
          max-height: 20rem
        }
      }
    
      .eligibility-income-section__copy {
        display: flex;
        flex-direction: column;
        gap: var(--base-gap)
      }
    
      @media(min-width:48rem) {
        .eligibility-income-section__copy {
          flex-direction: row
        }
      }
    
      .eligibility-income-section__copy--disclaimer {
        margin-top: 1rem;
        font-style: italic
      }
    
      .eligibility-income-section__copy--disclaimer a {
        color: #fff;
        text-decoration: underline
      }
    
      .eligibility-income-section__copy ul {
        margin-top: var(--base-gap)
      }
    
      .eligibility-income-section__copy ul li a {
        color: var(--calfresh-light-green);
        font-weight: 800
      }
    
      .eligibility-income-section__copy table {
        font-size: 2rem
      }
    
      .eligibility-income-section__copy table td,
      .eligibility-income-section__copy table th {
        padding: .2rem 1rem
      }
    
      .eligibility-income-section__copy table th {
        text-align: left
      }
    
      .eligibility-income-section__copy table td {
        font-weight: 500
      }
    
      @media(min-width:48rem) {
        .eligibility-income-section__copy table td:first-child {
          width: 40%
        }
      }
    
      .eligibility-income-section__copy table tbody tr:nth-child(odd) {
        background-color: var(--calfresh-red)
      }
    
      .eligibility-income-section__copy table tbody tr:last-child>td:last-child {
        font-weight: 700
      }
    
      .eligibility-income-section__copy>div {
        flex: 1
      }
    
      .eligibility-college-section {
        background-color: var(--calfresh-red);
        color: #fff
      }
    
      .eligibility-college-section .container {
        display: flex;
        flex-direction: column;
        text-align: center
      }
    
      @media(min-width:48rem) {
        .eligibility-college-section .container {
          flex-direction: row;
          gap: var(--base-gap)
        }
    
        .eligibility-college-section .container h2,
        .eligibility-college-section .container p {
          text-align: left
        }
    
        .eligibility-college-section .container>div {
          flex: 1
        }
      }
    
      .eligibility-college-section__image img {
        padding: var(--base-gap);
        padding-top: 0
      }
    
      .eligibility-college-section__copy {
        display: flex;
        flex-direction: column;
        justify-content: center
      }
    
      .eligibility-college-section__copy p {
        font-size: 2rem
      }
    
      .eligibility-college-section__copy>div {
        display: flex
      }
    
      @media(max-width:47.98rem) {
        .eligibility-college-section__copy>div .cta-button {
          justify-content: center;
          flex: 1
        }
      }
    
      @media(min-width:48rem) {
        .eligibility-college-section__copy>div .cta-button {
          display: inline-block
        }
      }
    
      .layout-footer .container {
        display: flex;
        flex-direction: column
      }
    
      .layout-footer__bottom,
      .layout-footer__top {
        padding: 0 var(--base-container-margin)
      }
    
      .layout-footer__top {
        display: flex;
        flex-direction: column;
        border-bottom: 1px solid var(--light-gray)
      }
    
      @media(min-width:48rem) {
        .layout-footer__top {
          flex-direction: row
        }
      }
    
      @media(max-width:47.98rem) {
        .layout-footer__top {
          align-items: center
        }
    
        .layout-footer__top .cta-button {
          padding-left: 10rem;
          padding-right: 10rem
        }
    
        .layout-footer__top--links i {
          margin: 0 2.5rem
        }
      }
    
      .layout-footer__top--logo {
        margin-top: 1rem
      }
    
      .layout-footer__top--logo img {
        height: 7rem
      }
    
      @media(min-width:48rem) {
        .layout-footer__top--logo {
          height: auto;
          margin-top: 0;
          padding: .5rem 0
        }
      }
    
      .layout-footer__top--links {
        padding: 2rem 0;
        display: flex;
        flex-direction: column-reverse;
        justify-content: flex-end;
        align-items: center;
        gap: var(--base-gap)
      }
    
      @media(min-width:48rem) {
        .layout-footer__top--links {
          flex-direction: row;
          gap: var(--base-large-gap)
        }
      }
    
      .layout-footer__top--links>div {
        display: flex;
        gap: var(--base-large-gap)
      }
    
      .layout-footer__top--links i {
        color: var(--dark-gray);
        font-size: 3rem
      }
    
      .layout-footer__top>div {
        display: flex;
        flex: 1
      }
    
      .layout-footer__bottom {
        padding-top: 2rem;
        padding-bottom: 2rem;
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        text-align: center
      }
    
      @media(max-width:47.98rem) {
        .layout-footer__bottom {
          padding: 0
        }
    
        .layout-footer__bottom p {
          padding: 1rem var(--base-container-margin)
        }
      }
    
      @media(min-width:48rem) {
        .layout-footer__bottom {
          text-align: left;
          grid-template-columns: repeat(3, 1fr)
        }
      }
    
      .layout-footer__bottom--links {
        gap: var(--base-small-gap)
      }
    
      @media(max-width:47.98rem) {
        .layout-footer__bottom--links {
          gap: var(--base-gap);
          border-bottom: 1px solid var(--light-gray)
        }
    
        .layout-footer__bottom--links a {
          margin: 2rem 0
        }
      }
    
      .layout-footer__bottom--links a {
        font-size: 2rem;
        color: var(--dark-gray);
        font-weight: 600
      }
    
      .layout-footer__bottom>div {
        display: flex;
        flex-direction: column;
        padding: 1rem 0
      }
    
      .layout-footer__bottom p {
        font-weight: 400
      }
    
      .layout-footer__bottom p a {
        color: var(--calfresh-red)
      }
    
      .modal:not(:empty) {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        place-items: center;
        background-color: rgba(0, 0, 0, .75)
      }

      @media (max-width: 47.98rem) {
  .x-axis-overflow .carousel-container {
    display: flex;
    flex-direction: column; /* stack cards vertically */
    gap: 1.5rem; /* space between cards */
  }

  .x-axis-overflow .carousel-container > * {
    flex: 1 1 auto; /* allow cards to expand naturally */
    margin: 0 auto; /* center cards */
    max-width: 95%; /* keep cards from stretching full width */
    padding: 1.5rem; /* internal padding for text */
    box-sizing: border-box; /* ensure padding doesn’t break width */
    position: relative; /* for pseudo-element separator */
  }

  /* Add line between cards using the same light green as other sections */
  .x-axis-overflow .carousel-container > *:not(:last-child)::after {
    content: '';
    display: block;
    height: 2px; /* thicker line for visibility */
    background-color: var(--calfresh-light-green); /* default border color */
    margin: 5rem 0 -3rem 0; /* 5rem above and -3rem below the line for spacing */
  }
}
