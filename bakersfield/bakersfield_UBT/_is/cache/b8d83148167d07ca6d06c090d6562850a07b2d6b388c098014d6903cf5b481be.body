    <style
      data-vue-ssr-id="79e3410a:0 79e3410a:1 929c2452:0 d0126f3e:0 c2f28b4a:0 bb8bf742:0 d36b31be:0 c3a9893e:0 3a659416:0 0c755fb2:0 0519c864:0 6227e866:0 00fb9dcd:0 3c7c95c7:0 d9d487ac:0 5d3819e6:0 4676ed1c:0 3791f870:0 54d69638:0 087cc06e:0 230b4eda:0 6daa9250:0 4496a311:0 7b582ef8:0 a9bc4fbc:0 3f53e200:0">
      @import url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css);
    
      :root {
        --calfresh-red: #af2a30;
        --calfresh-maroon: #661a1f;
        --calfresh-dark-green: #12401f;
        --calfresh-light-green: #8ac440;
        --calfresh-pine-green: #00944c;
        --calfresh-lime-green: #9cc136;
        --dark-gray: #232323;
        --light-gray: #d4d4d4;
        --primary-site-color: #661a1f;
        --wireframe-1: #12401f;
        --wireframe-2: #243b53;
        --wireframe-3: #3e4750;
        --wireframe-4: #486581;
        --wireframe-5: #627d98;
        --wireframe-6: #829ab1;
        --wireframe-7: #9fb3c8;
        --wireframe-8: #bcccdc;
        --wireframe-9: #d9e2ec;
        --wireframe-10: #f0f4f8;
        --base-header-height: 10rem;
        --base-footer-height: 5rem;
        --base-heading-color: var(--wireframe-1);
        --base-text-color: var(--wireframe-1);
        --base-link-color: var(--wireframe-4);
        --base-link-hover-color: var(--wireframe-1);
        --root-font-size: 62.5%;
        --base-font-size: 1.6rem;
        --base-line-height: 1.4;
        --base-heading-line-height: 1.1;
        --base-heading-font-weight: 700;
        --base-gap: 2rem;
        --base-small-gap: 1rem;
        --base-large-gap: 3rem;
        --base-container-padding: 2rem;
        --base-container-width: 85vw;
        --base-container-max-width: 100rem;
        --base-container-margin: max(calc((100vw - var(--base-container-width)) / 2), calc((100vw - var(--base-container-max-width)) / 2))
      }
    
      @media(min-width:48rem) {
        :root {
          --base-container-padding: 5rem;
          --base-gap: 2.5rem;
          --base-small-gap: 1.5rem;
          --base-large-gap: 4rem
        }
      }
    
      @media(min-width:64rem) {
        :root {
          --base-gap: 3rem;
          --base-large-gap: 6rem
        }
      }
    
      *,
      ::after,
      ::before {
        margin: 0;
        padding: 0;
        box-sizing: border-box
      }
    
      html {
        font-size: var(--root-font-size, 62.5%);
        -webkit-text-size-adjust: 100%;
        -webkit-tap-highlight-color: transparent;
        scroll-behavior: smooth
      }
    
      @media(min-width:100rem) {
        html {
          font-size: .625vw
        }
      }
    
      body {
        font: var(--base-font-size, 1.6rem)/var(--base-line-height, 1.4) var(--primary-font-family);
        background: var(--base-background-color, #fff);
        color: var(--base-text-color, #111);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale
      }
    
      main {
        overflow: hidden
      }
    
      ul {
        list-style: none
      }
    
      img,
      picture,
      video {
        display: block;
        max-width: 100%;
        height: auto
      }
    
      svg {
        display: block
      }
    
      ol,
      p,
      ul {
        padding-bottom: 1em
      }
    
      ol:empty,
      p:empty,
      ul:empty {
        padding: 0
      }
    
      address {
        font-style: normal
      }
    
      sub,
      sup {
        line-height: 0
      }
    
      button,
      input,
      textarea {
        font: inherit
      }
    
      button {
        appearance: none;
        background: 0 0;
        border: none;
        cursor: pointer;
        color: inherit
      }
    
      table {
        width: 100%;
        border-collapse: collapse
      }
    
      [disabled] {
        cursor: not-allowed
      }
    
      pre {
        page-break-inside: avoid;
        font-family: monospace;
        overflow: auto;
        display: block;
        word-wrap: break-word;
        text-align: left
      }
    
      a {
        text-decoration: none
      }
    
      [data-whatintent=keyboard] a:focus,
      [data-whatintent=mouse] a:hover,
      [data-whatintent=touch] a:active {
        text-decoration: underline
      }
    
      a[href^=mailto] {
        word-wrap: break-word
      }
    
      #__layout>div {
        display: flex;
        flex-direction: column;
        min-height: 100vh
      }
    
      #__layout>div main {
        flex: 1
      }
    
      .sr-only {
        position: absolute !important;
        clip: rect(1px, 1px, 1px, 1px) !important;
        padding: 0 !important;
        border: 0 !important;
        height: 1px !important;
        width: 1px !important;
        overflow: hidden !important
      }
    
      :focus {
        outline-color: var(--primary-site-color);
        outline-offset: .5rem;
        -webkit-focus-ring-color: var(--primary-site-color)
      }
    
      [data-whatinput=mouse] :focus,
      [data-whatinput=touch] :focus {
        outline: 0
      }
    
      @media(prefers-reduced-motion:reduce) {
    
        *,
        ::after,
        ::before {
          animation-delay: -1ms !important;
          animation-duration: 1ms !important;
          animation-iteration-count: 1 !important;
          background-attachment: initial !important;
          scroll-behavior: auto !important;
          transition-duration: 0s !important;
          transition-delay: 0s !important
        }
      }
    
      :root {
        --primary-font-family: "Raleway", system, -apple-system, ".SFNSText-Regular", "San Francisco", "Roboto", "Segoe UI", "Helvetica Neue", "Lucida Grande", sans-serif;
        --h1-font-size: 4.2rem;
        --h2-font-size: 1.8rem;
        --h3-font-size: 1.6rem
      }
    
      @media(min-width:25rem) {
        :root {
          --h1-font-size: 5rem;
          --h2-font-size: 2.2rem;
          --h3-font-size: 1.8rem
        }
      }
    
      @media(min-width:48rem) {
        :root {
          --h1-font-size: 5.5rem;
          --h2-font-size: 2.6rem;
          --h3-font-size: 2rem
        }
      }
    
      @media(min-width:64rem) {
        :root {
          --h1-font-size: 7rem;
          --h2-font-size: 3rem;
          --h3-font-size: 2.2rem
        }
      }
    
      h1,
      h2,
      h3 {
        font-weight: var(--base-heading-font-weight);
        line-height: var(--base-heading-line-height);
        color: var(--base-heading-color)
      }
    
      h1 {
        font-size: var(--h1-font-size)
      }
    
      h2 {
        font-size: var(--h2-font-size)
      }
    
      h3 {
        font-size: var(--h3-font-size)
      }
    
      p {
        font-weight: 500
      }
    
      p.light {
        font-weight: 400
      }
    
      h2.section-title {
        text-align: center;
        font-size: var(--h1-font-size);
        font-weight: 300;
        margin-bottom: var(--base-gap)
      }
    
      h2.section-title.dark-green {
        color: var(--calfresh-dark-green)
      }
    
      h4.section-subtitle {
        font-size: 2.5rem;
        font-weight: 800
      }
    
      @media(max-width:47.98rem) {
        h4.section-subtitle {
          font-size: 2rem
        }
      }
    
      h2.section-title,
      h4.section-subtitle {
        color: #fff;
        text-transform: uppercase
      }
    
      ul.calfresh-list {
        margin-left: 2rem
      }
    
      ul.calfresh-list li {
        font-size: 2rem;
        font-weight: 500;
        padding-left: 1rem;
        margin-bottom: var(--base-small-gap);
        color: #fff
      }
    
      ul.calfresh-list li::marker {
        content: url("/eligibility/check-green.svg")
      }
    
      ul.calfresh-list.red-checks li::marker {
        content: url("/eligibility/check.svg")
      }
    
      @keyframes bounce {
        0% {
          bottom: 5px
        }
    
        25%,
        75% {
          bottom: 15px
        }
    
        50% {
          bottom: 20px
        }
    
        100% {
          bottom: 0
        }
      }
    
      @keyframes fadein {
        0% {
          opacity: 0
        }
    
        100% {
          opacity: 1
        }
      }
    
      @keyframes fadeinout {
    
        0%,
        100% {
          opacity: 0
        }
    
        50% {
          opacity: 1
        }
      }
    
      .display-mobile {
        display: block !important
      }
    
      @media(min-width:48rem) {
        .display-mobile {
          display: none !important
        }
      }
    
      .display-desktop {
        display: none !important
      }
    
      @media(min-width:48rem) {
        .display-desktop {
          display: block !important
        }
      }
    
      @media(max-width:47.98rem) {
        .mobile-image-padding {
          padding: 3rem
        }
      }
    
