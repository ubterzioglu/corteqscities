          Privacy Policy
        </a></div></div> <div><p>This program is funded by USDA, an equal opportunity provider, employer, and lender.</p> <p>CalFresh is a program of the <a href="https://cdss.ca.gov/inforesources/calfresh-outreach" target="_blank">California Department of Social Services</a>.</p></div></div></footer> 
<!-- SCRIPT FOR INTERACTIVITY -->
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        
        // --- ACCESSIBLE ACCORDION FUNCTIONALITY ---
        const accordionItems = document.querySelectorAll('.base-accordion-item');

        accordionItems.forEach(item => {
          const button = item.querySelector('.accordion-item__handle button');
          const content = item.querySelector('.accordion-item__content');
          
          if (button && content) {
            button.addEventListener('click', () => {
              const isOpened = item.classList.toggle('is-open');
              button.setAttribute('aria-expanded', isOpened);
            });
          }
        });

        // --- ACCESSIBLE NAVIGATION DROPDOWN FUNCTIONALITY ---
        const dropdown = document.querySelector('.nav-dropdown');
        const dropdownButton = document.getElementById('eligibility-menu-button');
        const menu = document.getElementById('eligibility-menu');
        const menuItems = menu ? menu.querySelectorAll('[role="menuitem"]') : [];

        function toggleMenu(open) {
            if (!dropdown || !dropdownButton) return;
            const isOpened = dropdown.classList.toggle('is-open', open);
            dropdownButton.setAttribute('aria-expanded', isOpened);
            if(isOpened && menuItems.length > 0) {
                menuItems[0].focus();
            }
        }

        if (dropdownButton) {
            dropdownButton.addEventListener('click', (event) => {
                event.stopPropagation();
                toggleMenu();
            });
        }

        document.addEventListener('click', (event) => {
            if (dropdown && !dropdown.contains(event.target)) {
                toggleMenu(false);
            }
        });

        // Keyboard navigation for the dropdown
        document.addEventListener('keydown', (event) => {
            if (dropdown && dropdown.classList.contains('is-open') && event.key === 'Escape') {
                toggleMenu(false);
                if (dropdownButton) dropdownButton.focus();
            }
        });
        
        if (menu) {
            menu.addEventListener('keydown', (e) => {
                const currentItem = document.activeElement;
                let currentIndex = Array.from(menuItems).indexOf(currentItem);

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    const nextIndex = (currentIndex + 1) % menuItems.length;
                    menuItems[nextIndex].focus();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    const prevIndex = (currentIndex - 1 + menuItems.length) % menuItems.length;
                    menuItems[prevIndex].focus();
                }
            });
        }

        // --- MOBILE MENU TOGGLE FUNCTIONALITY ---
        const mobileToggle = document.querySelector('.layout-header__right--mobile button');
        const mobileMenu = document.getElementById('mobileMenu');
        const bodyEl = document.body;

        console.log('mobileToggle element:', mobileToggle);
        console.log('mobileMenu element:', mobileMenu);

        if (mobileToggle && mobileMenu) {
            mobileToggle.addEventListener('click', () => {
                console.log('hamburger clicked');
                console.log('before toggle classList:', mobileMenu.classList.toString());
                const isOpen = mobileMenu.classList.toggle('open');
                console.log('after toggle classList:', mobileMenu.classList.toString());
                console.log('menu open state after toggle:', isOpen);
                bodyEl.classList.toggle('menu-open', isOpen);
                mobileMenu.setAttribute('aria-hidden', !isOpen);
                const comp = window.getComputedStyle(mobileMenu);
                console.log('computed display:', comp.display, 'opacity:', comp.opacity, 'visibility:', comp.visibility, 'height:', comp.height);
                console.log('mobileMenu rect', mobileMenu.getBoundingClientRect());
            });

            const closeBtn = mobileMenu.querySelector('.layout-mobile-menu__control button');
            console.log('close button element:', closeBtn);
            closeBtn.addEventListener('click', () => {
                console.log('close button clicked');
                mobileMenu.classList.remove('open');
                bodyEl.classList.remove('menu-open');
                mobileMenu.setAttribute('aria-hidden', 'true');
                mobileToggle.focus();
            });
        } else {
            console.warn('Mobile toggle/menu elements missing');
        }

      });
    </script> 
  </body>
</html>
