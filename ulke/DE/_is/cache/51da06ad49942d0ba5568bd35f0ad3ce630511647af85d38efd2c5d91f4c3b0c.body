003cstrong\u003eDigitaler Assistent:\u003c/strong\u003e\u003cbr\u003e \u003cbutton id=\"cb-toggle\" class=\"ba-link-right\" style=\"background-color: transparent; border: none; text-align: justify; text-decoration: underline; color: #3f4859;\" title=\"Fragen rund ums Arbeitslosengeld stellen - Link öffnet Chatbot\"\u003eFragen rund ums Arbeitslosengeld stellen?\u003c/button\u003e \u003c/p\u003e\r\n\u003c/div\u003e\r\n\u003c/article\u003e\r\n\r\n\u003c/section\u003e\r\n\u003cscript\u003e\r\ndocument.getElementById(\"cb-toggle\").setAttribute(\"onclick\", \"chatbot.toggle()\");\r\n\u003c/script\u003e\r\n\u003cscript\u003edocument.querySelector(\"#main \u003e header\").setAttribute(\"class\", \"ba-content-header ba-with-overlay ba-with-image ba-with-addon\")\u003c/script\u003e2b:[[\"$\",\"$L32\",null,{\"content_type\":\"article\",\"contextInfoHeader\":{\"background_alignment\":\"center\",\"breadcrumb\":{\"ariaLabel\":\"Du befindest Dich hier\",\"targets\":[{\"title\":\"Startseite\",\"url\":\"https://www.arbeitsagentur.de\"},{\"title\":\"Arbeitslos und Arbeit finden\",\"url\":\"/arbeitslos-arbeit-finden\"},{\"title\":\"Arbeitslosengeld\",\"url\":\"/arbeitslos-arbeit-finden/arbeitslosengeld\"}]},\"contextInfoHeader_type\":\"content_with_image\",\"button\":[],\"headerContent\":{\"headline\":\"Arbeitsuchend melden und Arbeits­losengeld erhalten\",\"subtext\":\"\u003cp\u003eSie werden bald arbeitslos oder sind es schon. Hier finden Sie Informationen zur Arbeitsuchend-Meldung und zum Arbeitslosengeld, alle nötigen Services sowie die Jobsuche.\u003c/p\u003e\"},\"media\":{\"image\":{\"alt\":\"Frau legt ihre Hand auf die Schulter einer anderen Frau in Gruppensituation\",\"isInfografik\":false,\"author\":\"Halfpoint\",\"source\":\"Adobe Stock\",\"title\":null,\"url\":\"https://web.arbeitsagentur.de/cms-zentrales-portal-prod-media/prod/s3fs-public/styles/webp/public/2022-05/AdobeStock_250064219.jpg.webp\",\"x_coordinate\":49,\"y_coordinate\":48}}},\"rows\":[{\"content\":\"$33\",\"row_type\":\"custom_element\"},{\"row_headline\":\"Schnell \u0026 direkt: Anträge und weitere Anliegen online erledigen\",\"row_type\":\"tiles\",\"tiles\":[{\"badges\":\"$undefined\",\"grid_type\":\"25\",\"headline\":\"Arbeitsuchend melden\",\"interactive_block\":{\"buttons\":[],\"interactive_content\":\"$undefined\",\"list_type\":\"linklist\"},\"link\":{\"target\":\"$undefined\",\"title\":\"\",\"url\":\"https://web.arbeitsagentur.de/vermittlung/oalo-ui/pd/arbeitsuchendmeldung?reglevel=pin\",\"linkSrText\":\"Öffnet in neuem Tab\"},\"subtext\":\"\u003cp\u003eInformieren Sie uns umgehend, wenn Ihr Arbeitsverhältnis bald endet.\u003c/p\u003e\",\"tile_media\":{\"icon\":\"ba-icon-search\",\"image\":\"$undefined\",\"tile_media_type\":\"large\"},\"tile_type\":\"quickstart\",\"quickstartSubline\":\"Schnelleinstieg\",\"badgeIdentifier\":\"Kennzeichnungen\"},{\"badges\":\"$undefined\",\"grid_type\":\"25\",\"headline\":\"Arbeitslos melden\",\"interactive_block\":{\"buttons\":[],\"interactive_content\":\"$undefined\",\"list_type\":\"linklist\"},\"link\":{\"target\":\"$undefined\",\"title\":\"\",\"url\":\"https://web.arbeitsagentur.de/vermittlung/oalo-ui/pd?reglevel=pin\",\"linkSrText\":\"Öffnet in neuem Tab\"},\"subtext\":\"\u003cp\u003eMelden Sie sich spätestens am ersten Tag Ihrer Arbeitslosigkeit arbeitslos.\u003c/p\u003e\",\"tile_media\":{\"icon\":\"ba-icon-person-paper\",\"image\":\"$undefined\",\"tile_media_type\":\"large\"},\"tile_type\":\"quickstart\",\"quickstartSubline\":\"Schnelleinstieg\",\"badgeIdentifier\":\"Kennzeichnungen\"},{\"badges\":\"$undefined\",\"grid_type\":\"25\",\"headline\":\"Arbeitslosengeld beantragen\",\"interactive_block\":{\"buttons\":[],\"interactive_content\":\"$undefined\",\"list_type\":\"linklist\"},\"link\":{\"target\":\"$undefined\",\"title\":\"\",\"url\":\"https://web.arbeitsagentur.de/alg-prod/ui/pd\",\"linkSrText\":\"Öffnet in neuem Tab\"},\"subtext\":\"\u003cp\u003eStellen Sie den Antrag, nachdem Sie sich arbeitslos gemeldet haben.\u003c/p\u003e\",\"tile_media\":{\"icon\":\"ba-icon-apply\",\"image\":\"$undefined\",\"tile_media_type\":\"large\"},\"tile_type\":\"quickstart\",\"quickstartSubline\":\"Schnelleinstieg\",\"badgeIdentifier\":\"Kennzeichnungen\"},{\"badges\":\"$undefined\",\"grid_type\":\"25\",\"headline\":\"Änderungen mitteilen\",\"interactive_block\":{\"buttons\":[],\"interactive_content\":\"$undefined\",\"list_type\":\"linklist\"},\"link\":{\"target\":\"$undefined\",\"title\":\"\",\"url\":\"https://web.arbeitsagentur.de/veronline/ver-ui/pd/\",\"linkSrText\":\"Öffnet in neuem Tab\"},\"subtext\":\"\u003cp\u003eInformieren Sie uns, falls\u0026nbsp;Sie etwa\u0026nbsp;eine Arbeit aufnehmen oder umziehen.\u003c/p\u003e\",\"tile_media\":{\"icon\":\"ba-icon-career-change\",\"image\":\"$undefined\",\"tile_media_type\":\"large\"},\"tile_type\":\"quickstart\",\"quickstartSubline\":\"Schnelleinstieg\",\"badgeIdentifier\":\"Kennzeichnungen\"}]},{\"row_headline\":\"Arbeitslosengeld und weitere finanzielle Hilfen\",\"row_type\":\"tiles\",\"tiles\":[{\"badges\":\"$undefined\",\"grid_type\":\"50\",\"headline\":\"Schritt für Schritt: Arbeitslos melden und Arbeitslosengeld beantragen\",\"interactive_block\":{\"buttons\":[],\"interactive_content\":\"$undefined\",\"list_type\":\"linklist\"},\"link\":{\"target\":\"$undefined\",\"title\":\"\",\"url\":\"/arbeitslos-arbeit-finden/arbeitslosengeld/ihre-schritte-wenn-sie-arbeitslos-werden\",\"linkSrText\":\"Öffnet in neuem Tab\"},\"subtext\":\"\u003cp\u003eWenn Sie bald arbeitslos werden oder es schon sind: Das sind die Schritte, mit denen Sie sich arbeitslos melden und Arbeitslosengeld beantragen können.\u003c/p\u003e\",\"tile_media\":{\"icon\":\"ba-icon-todo2\",\"image\":\"$undefined\",\"tile_media_type\":\"large\"},\"tile_type\":\"clickable\",\"quickstartSubline\":\"Schnelleinstieg\",\"badgeIdentifier\":\"Kennzeichnungen\"},{\"badges\":\"$undefined\",\"grid_type\":\"50\",\"headline\":\"Anspruch, Höhe und Dauer bei Arbeitslosengeld und weiteren finanziellen Hilfen\",\"interactive_block\":{\"buttons\":[],\"interactive_content\":\"$undefined\",\"list_type\":\"linklist\"},\"link\":{\"target\":\"$undefined\",\"title\":\"\",\"url\":\"/arbeitslos-arbeit-finden/arbeitslosengeld/finanzielle-hilfen\",\"linkSrText\":\"Öffnet in neuem Tab\"},\"subtext\":\"\u003cp\u003eJetzt informieren: Was Sie über\u0026nbsp;Arbeitslosengeld oder andere Hilfen wie Kurzarbeitergeld und Insolvenzgeld wissen sollten.\u003c/p\u003e\",\"tile_media\":{\"icon\":\"ba-icon-calculation\",\"image\":\"$undefined\",\"tile_media_type\":\"large\"},\"tile_type\":\"clickable\",\"quickstartSubline\":\"Schnelleinstieg\",\"badgeIdentifier\":\"Kennzeichnungen\"},{\"badges\":\"$undefined\",\"grid_type\":\"33\",\"headline\":\"Das müssen Sie beachten, wenn Sie Arbeitslosengeld bekommen\",\"interactive_block\":{\"buttons\":[],\"interactive_content\":\"$undefined\",\"list_type\":\"linklist\"},\"link\":{\"target\":\"$undefined\",\"title\":\"\",\"url\":\"/arbeitslos-arbeit-finden/arbeitslosengeld/das-muessen-sie-beachten\",\"linkSrText\":\"Öffnet in neuem Tab\"},\"subtext\":\"\u003cp\u003eWas gilt, wenn Sie krank werden,\u0026nbsp;einen Umzug planen\u0026nbsp;oder einen Nebenjob annehmen.\u003c/p\u003e\",\"tile_media\":{\"icon\":null,\"image\":\"$undefined\",\"tile_media_type\":\"large\"},\"tile_type\":\"clickable\",\"quickstartSubline\":\"Schnelleinstieg\",\"badgeIdentifier\":\"Kennzeichnungen\"},{\"badges\":\"$undefined\",\"grid_type\":\"33\",\"headline\":\"Arbeitslosengeld reicht nicht für den Lebensunterhalt\",\"interactive_block\":{\"buttons\":[],\"interactive_content\":\"$undefined\",\"list_type\":\"linklist\"},\"link\":{\"target\":\"$undefined\",\"title\":\"\",\"url\":\"/arbeitslos-arbeit-finden/arbeitslosengeld/arbeitslosengeld-reicht-nicht\",\"linkSrText\":\"Öffnet in neuem Tab\"},\"subtext\":\"\u003cp\u003eWelche finanzielle Hilfen infrage kommen, wenn Ihr Arbeitslosengeld nicht zum Leben reicht.\u003c/p\u003e\",\"tile_media\":{\"icon\":null,\"image\":\"$undefined\