small":687},{"href":399,"width":365,"height":366},{"id":689,"name":690,"template":691,"data":692,"lazy":18,"ssr":19},"teaser_term_list_100_11","Teaser Term List","term_teaser_list",{"headline":145,"hideHeadline":19,"tabs":693},[694,735],{"headline":695,"teasers":696,"link":732},"Stipendien ins Ausland",[697,711,723],{"type":698,"headline":699,"text":700,"persons":701,"deadline":702,"status":703,"statusText":704,"links":705},"term","DAAD-Lektorate","Sie arbeiten gern im internationalen Umfeld? Sie lehren gern an einer Hochschule und interessieren sich für die Förderung der deutschen Sprache und Kultur im Ausland? Dann werden Sie Teil des Netzwerks der DAAD-Lektorinnen und -Lektoren weltweit!\n\n\n ","Graduierte, Promovierte, Hochschullehrer","10.11.2026","opened","Bewerbungen jetzt möglich",[706],{"text":707,"type":95,"url":708,"srText":709,"additionalText":8,"tracking":710},"zur Bewerbung","https:\u002F\u002Fwww.daad.de\u002Fde\u002Fim-ausland-studieren-forschen-lehren\u002Flehren-im-ausland\u002Ffreie-lektorate-und-dozenturen\u002F","zur Bewerbung DAAD-Lektorate",{"title":196},{"type":698,"headline":712,"text":713,"persons":714,"deadline":715,"status":716,"statusText":717,"links":718},"Zukunftsnetzwerk Weimarer Dreieck:  Wissenschaft für Europa - Doktorandinnen und Doktoranden (aus Deutschland)","Auf Stipendien für Forschungsaufenthalte können sich Doktorandinnen und Doktoranden aller Fachbereiche bewerben, die sich im Netzwerk Weimarer Dreieck engagieren möchten und zu einem der in der Ausschreibung genannten Forschungsthemen arbeiten.","Doktoranden","02.11.2026","short_term","Frist endet bald",[719],{"text":707,"type":95,"url":720,"srText":721,"additionalText":8,"tracking":722},"https:\u002F\u002Fwww2.daad.de\u002Fausland\u002Fstudieren\u002Fstipendium\u002Fde\u002F70-stipendien-finden-und-bewerben\u002F?status=&target=&subjectGrps=&intention=&daad=&q=weimarer&page=1&detail=57871373","zur Bewerbung Zukunftsnetzwerk Weimarer Dreieck:  Wissenschaft für Europa - Doktorandinnen und Doktoranden (aus Deutschland)",{"title":196},{"type":698,"headline":724,"text":725,"persons":726,"deadline":715,"status":716,"statusText":717,"links":727},"Zukunftsnetzwerk Weimarer Dreieck:  Wissenschaft für Europa - Postdoktorandinnen und Postdoktoranden (aus Deutschland)","Auf Stipendien für Forschungsaufenthalte können sich überdurchschnittlich qualifizierte Wissenschaftlerinnen und Wissenschaftler aller Fachbereiche bewerben, die in Deutschland zu einem der in der Ausschreibung \naufgeführten Zukunftsthemen forschen und sich vorstellen können, die fachliche Koordination einer der fünf Arbeitsgruppen des Stipendienprogramms zu übernehmen","Promovierte",[728],{"text":707,"type":95,"url":729,"srText":730,"additionalText":8,"tracking":731},"https:\u002F\u002Fwww2.daad.de\u002Fausland\u002Fstudieren\u002Fstipendium\u002Fde\u002F70-stipendien-finden-und-bewerben\u002F?status=&target=&subjectGrps=&intention=&daad=&q=weimarer&page=1&detail=57871711","zur Bewerbung Zukunftsnetzwerk Weimarer Dreieck:  Wissenschaft für Europa - Postdoktorandinnen und Postdoktoranden (aus Deutschland)",{"title":196},{"text":733,"type":95,"url":154,"srText":8,"additionalText":8,"tracking":734},"Alle Bewerbungsfristen",{"title":196},{"headline":736,"teasers":737},"Projekte",[738],{"type":739,"headline":740,"text":741,"links":742,"image":746},"term-image","Programme der Projektförderung","In der Projektförderung des DAAD erfolgt die Ausschreibung der Programme an drei zentralen Terminen im Jahr – April, Juni und Oktober. Finden Sie die aktuell ausgeschriebenen DAAD-Programme und die bereits laufenden DAAD-Programme der Projektförderung auf unserer Ausschreibungsseite. \u003Cbr \u002F>\nDer nächste zentrale Ausschreibungstermin in der Projektförderung ist der 06. April 2027.",[743],{"text":744,"type":95,"url":158,"srText":8,"additionalText":8,"tracking":745},"Alle Förderprogramme",{"title":196},{"src":747,"alt":756,"copyright":757},{"large":748,"medium":752,"small":754},{"href"