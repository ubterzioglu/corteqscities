</div></div></div></section><section class="testimonials-block hidden-print"><div class="container"><div class="row"><div class="testimonials"><div class="mask">

<div class="slide">
    <div class="col-lg-4 col-md-5 col-sm-6">
        <div class="image">
            <picture>
                <!--[if IE 9]><video style="display: none;"><![endif]-->
                <source srcset="/fileadmin/_processed_/f/0/csm_TUD-Biologie-Gebaeude-_c_Crispin-I.-Mokry_0c36633422.jpg, /fileadmin/_processed_/f/0/csm_TUD-Biologie-Gebaeude-_c_Crispin-I.-Mokry_6ada0ec940.jpg 2x" media="(max-width: 749px)">
